  "data": {
    "hg-selected-days": "[0,1,2,3,4,5,6]",
    "hg-recipes-v271": "[{\"id\":\"epaule-d-agneau-en-cocotte-mrryzeyxg6l\",\"title\":\"Épaule d'agneau en cocotte\",\"category\":\"Plat principal\",\"time\":105,\"servings\":4,\"ingredients\":[[\"épaule d'agneau\",1,\"u\"],[\"oignon rouge\",2,\"u\"],[\"tomate\",2,\"u\"],[\"huile d'olive\",3,\"c. à soupe\"],[\"concentré de tomate\",1,\"c. à soupe\"],[\"thym\",4,\"branche\"],[\"4 épices\",1,\"c. à café\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Dans une grande cocotte, versez 1 cuil. à soupe d'huile d'olive et faites-la chauffer.\",\"Déposez-y l'épaule d'agneau, saisissez-la de chaque côté.\",\"Pelez et émincez les oignons.\",\"Lavez les tomates puis coupez-les en dés.\",\"Versez ce mélange dans la cocotte, remuez 3 min.\",\"Ajoutez les 4 épices, du sel et du poivre.\",\"Couvrez d'environ 40 cl d'eau.\",\"Délayez le concentré de tomate.\",\"Ajoutez le thym et portez à frémissements.\",\"Couvrez la cocotte et laissez mijoter 1 h 30 en surveillant régulièrement.\",\"Servez chaud.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Cocotte\",\"Agneau\",\"modifié\"],\"source\":\"https://www.cuisineactuelle.fr/recettes/epaule-d-agneau-en-cocotte-209317?_gl=1*1mf9bik*_gcl_aw*R0NMLjE3NjY4NjczNjAuRUFJYUlRb2JDaE1JeXNDMzM4emVrUU1WS1pPREJ4MTNCeUY2RUFBWUFTQUFFZ0l0V19EX0J3RQ..*_ga*MTAyNDA0ODM1MS4xNzY2ODY3MDc4*_ga_5NSPQRQDQY*czE3NjY4NjcwNzgkbzEkZzEkdDE3NjY4NjczNjUkajYwJGwwJGgw\",\"notes\":\"\",\"paprikaUid\":\"3091CF83-7C86-4139-A5CF-F21A86FF33F0\"},{\"id\":\"emince-de-poulet-a-l-aigre-doux-mrryzeywd7c\",\"title\":\"Émincé de poulet à l'aigre-doux\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"poitrine de poulet\",600,\"g\"],[\"sauce de soja\",4,\"c. à soupe\"],[\"fécule de maïs\",1,\"c. à soupe\"],[\"huile\",4,\"c. à soupe\"],[\"noix de cajou\",80,\"g\"],[\"oignon nouveau\",1,\"botte\"],[\"gousses d'ail\",2,\"u\"],[\"poivron rouge\",2,\"u\"],[\"ananas en tranches ou en morceaux\",1,\"boîte\"],[\"concentré de tomates\",2,\"c. à soupe\"],[\"sauce douce aux piments\",4,\"c. à soupe\"],[\"poivre\",0,\"\"],[\"citron vert\",1,\"u\"]],\"steps\":[\"Couper les poitrines de poulet en lanières.\",\"Les mélanger avec la sauce soja, la fécule de maïs et la moitié de l'huile.\",\"Laisser mariner env. 15 min.\",\"Entre-temps, hacher grossièrement les noix de cajou.\",\"Les faire griller à sec dans une poêle antiadhésive.\",\"Couper les oignons nouveaux en rouelles et réserver un peu de fanes pour la finition.\",\"Hacher finement l'ail.\",\"Partager les piments en quatre, les épépiner et les couper en lanières.\",\"Couper les tranches d'ananas en quatre et réserver le jus.\",\"Faire chauffer le reste de l'huile dans une grande poêle ou un wok.\",\"Saisir la viande à feu vif.\",\"Ajouter les poivrons et les oignons et faire revenir brièvement.\",\"Ajouter l'ail.\",\"Ajouter le concentré de tomates, le jus d'ananas et la sauce aux piments.\",\"Laisser mijoter 5 min.\",\"Incorporer les morceaux d'ananas, poivrer.\",\"Presser la moitié du citron vert et ajouter le jus.\",\"Assaisonner avec un peu de sauce soja si nécessaire.\",\"Dresser l'émincé de poulet.\",\"Parsemer de noix de cajou et de fanes d'oignons, couper le reste du citron vert en quartiers et présenter à part.\",\"Accompagner de riz.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Asie\",\"Poulet\",\"Wok\",\"modifié\"],\"source\":\"https://migusto.migros.ch/fr/recettes/emince-de-poulet-a-laigre-doux\",\"notes\":\"\",\"paprikaUid\":\"22CD3471-B997-413E-8D67-557C9748F072\"},{\"id\":\"zuppa-di-funghi-mrryzeyvcin\",\"title\":\"Zuppa di funghi\",\"category\":\"Soupe\",\"time\":60,\"servings\":4,\"ingredients\":[[\"échalote\",1,\"u\"],[\"champignons\",300,\"g\"],[\"beurre\",1,\"c. à soupe\"],[\"jus de citron\",1,\"c. à soupe\"],[\"bouillon de légumes\",5,\"dl\"],[\"demi-crème\",2,\"dl\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"cerfeuil\",1,\"c. à soupe\"]],\"steps\":[\"Peler l'échalote et la hacher finement.\",\"Couper les champignons en deux ou en quatre.\",\"Faire fondre le beurre dans une poêle antiadhésive.\",\"Faire revenir l'échalote, ajouter les champignons, faire revenir env. 3 minutes.\",\"Verser le jus de citron et le bouillon, porter à ébullition, baisser le feu, laisser mijoter env. 10 min à couvert, mixer.\",\"Battre légèrement la demi-crème, incorporer, le temps de bien faire chauffer, saler, poivrer.\",\"Ciseler les pluches de cerfeuil, parsemer.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"modifié\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/zuppa-di-funghi-soupe-aux-champignons-10004151/\",\"notes\":\"\",\"paprikaUid\":\"6E0FEA03-0B41-465F-869E-569211803F6E\"},{\"id\":\"zoggla-a-la-mode-de-glaris-mrryzeyvufw\",\"title\":\"Zogglä à la mode de Glaris\",\"category\":\"Plat principal\",\"time\":40,\"servings\":4,\"ingredients\":[[\"farine\",350,\"g\"],[\"seĺ\",0,\"\"],[\"poivre\",0,\"\"],[\"muscade\",0,\"\"],[\"pommes de terre\",200,\"g\"],[\"œuf\",4,\"u\"],[\"lait\",1.5,\"dl\"],[\"oignon\",1,\"u\"],[\"beurre\",0,\"\"],[\"légume diver, p. ex. bettes à tondre, épinards, courge, carottes\",600,\"g\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"sbrinz ou Schabziger\",100,\"g\"],[\"chapelure\",3,\"c. à soupe\"],[\"beurre\",50,\"g\"]],\"steps\":[\"Zogglä:\",\"Peler et râper les pommes de terre.\",\"Mélanger la farine, les pommes de terre, le sel le poivre et la muscade.\",\"Battre les œufs avec le lait, les ajouter au mélange farine-pommes de terre.\",\"Amalgamer la pâte et la battre jusqu'à formation de bulles d'air.\",\"Réserver 1-2 heures à couvert.\",\"Prélever une cuillère à café de pâte et la laisser tomber dans de l'eau salée frémissante, répéter l'opération.\",\"Quand les Zogglä remontent à la surface, les pêcher à l'aide d'une écumoire.\",\"Les égoutter, puis les disposer dans le plat beurré.\",\"Réserver au chaud.\",\"Continuer jusqu'à ce qu'il n'y ait plus de pâte.\",\"Légumes:\",\"Couper les légumes en bâtonnets.\",\"Hacher finement l'oignon et le faire suer dans le beurre.\",\"Ajouter les légumes et les cuire \\\"al dente\\\", en ajoutant un peu d'eau si nécessaire.\",\"Assaisonner et répartir sur les Zogglä.\",\"Parsemer les légumes de fromage râpé.\",\"Dorer la chapelure au beurre.\",\"Répandre sur les légumes et servir tout de suite.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Suisse\",\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM201311_13/zogglae-a-la-mode-de-glaris/\",\"notes\":\"\",\"paprikaUid\":\"A01035D8-83E5-40B2-99C1-00F36CDDC580\"},{\"id\":\"yukgaejang-ragout-de-b-uf-epice-mrryzeyuovs\",\"title\":\"Yukgaejang (Ragoût de bœuf épicé)\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"vermicelles de patate\",2,\"portion\"],[\"boeuf\",4,\"tranche\"],[\"champignon parfumé réhydraté\",12,\"u\"],[\"oignon\",1,\"u\"],[\"gousses d’ail\",8,\"u\"],[\"cive\",6,\"branche\"],[\"algue de Kombu\",1,\"morceau\"],[\"grain de poivre\",10,\"graine\"],[\"Shiitakés frais\",12,\"u\"],[\"champignon de Enoki\",1,\"paquet\"],[\"sauce de soja\",3,\"c. à soupe\"],[\"gousses d’ail\",3,\"\"],[\"sucre\",1,\"c. à soupe\"],[\"huile de sésame\",1,\"c. à soupe\"],[\"Gochugaru\",2,\"c. à soupe\"],[\"graine de sésame\",0,\"\"]],\"steps\":[\"Couper l'oignon en quartiers.\",\"Hacher l'ail.\",\"Couper les branches de cive en morceaux d'env. 3 cm.\",\"Couper le Shiitaké en tranches.\",\"Mijoter les plats-de-côtes, les oignons, les gousses d’ail, les branches de cives, l’algue kombu, les grains de poivre et les champignons parfumés dans 1,5 l d’eau pendant 2 h sur feu moyen.\",\"Mélanger l’ail haché, la sauce de soja, le sucre, l’huile de sésame et la poudre de piment gochugaru.\",\"Verser cette marinade au mélange de champignons shiitaké, de champignons enoki et de cives ciselées puis réserver au frais.\",\"Après cuisson, retirer les plats-de-côtes du bouillon puis effilocher la viande avec une fourchette.\",\"L’ajouter au mélange de champignons marinés.\",\"Cuire les portions de nouilles de patate douce, égoutter puis réserver.\",\"Dans un pot coréen ou une marmite, placer les nouilles de patate douce au fond puis verser du bouillon de bœuf et ajouter la viande effilochée et les champignons marinés.\",\"Parsemer de cives ciselées et de graine de sésame.\",\"Démarrer sur feu doux et laisser mijoter 5-10 min avant de servir.\",\"Attention à ne pas vous brûler !\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Corée\",\"Asie\",\"modifié\"],\"source\":\"https://www.tang-freres.fr/recettes-asiatiques/coree/ragout-de-boeuf-epice-yukgaejang-%ec%9c%a1%ea%b0%9c%ec%9e%a5/\",\"notes\":\"\",\"paprikaUid\":\"ECD1D471-0602-4BAC-97BD-319F2C3B785B\"},{\"id\":\"wok-vegetarien-mrryzeytxre\",\"title\":\"Wok végétarien\",\"category\":\"Plat principal\",\"time\":90,\"servings\":4,\"ingredients\":[[\"nouilles de riz\",400,\"g\"],[\"mélange de légumes Asia\",500,\"g\"],[\"oeuf\",3,\"u\"],[\"oignon\",1,\"u\"],[\"gousse d'ail\",3,\"u\"],[\"huile de soja + huile de sésame\",3,\"c. à soupe\"],[\"huile d'olive\",4,\"c. à soupe\"],[\"épice asiatique\",2,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Faire chauffer de l’huile d’olive dans le wok et y ajouter l’ail et l’oignon.\",\"Quand l’oignon est translucide, ajouter le mélange de légumes pour wok.\",\"Laisser revenir.\",\"Porter de l’eau à ébullition dans une casserole.\",\"Cuire les nouilles suivant les instructions sur le paquet.\",\"Quand les nouilles sont cuites, égouttez-les, rincez-les à l’eau froide et réservez-les.\",\"Assaisonner les légumes dans le wok avec du sel et du poivre.\",\"Ajouter du mélange d‘épices asiatiques à votre convenance.\",\"Faire cuire les oeufs dans une petite poêle en tournant tout le temps de la cuisson de manière à obtenir des oeufs brouillés.\",\"Assaisonner et réserver.\",\"Une fois que les légumes ont atteint la cuisson de votre convenance, ajouter les nouilles et les oeufs brouillés.\",\"Bien mélanger et assaisonner le tout.\",\"Ajouter de l’huile spéciale wok (mélange d’huile de sésame et d’huile de soja).\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Asie\",\"Wok\",\"modifié\"],\"source\":\"https://www.marmiton.org/recettes/recette_wok-vegetarien_339575.aspx\",\"notes\":\"\",\"paprikaUid\":\"1FA4DB98-5DA0-4B34-976B-E679133EE897\"},{\"id\":\"wok-tomate-aux-des-de-poulet-mrryzeysg32\",\"title\":\"Wok tomaté aux dés de poulet\",\"category\":\"Plat principal\",\"time\":90,\"servings\":2,\"ingredients\":[[\"oignons\",1,\"u\"],[\"gousse d'ail\",3,\"u\"],[\"poivre\",0,\"\"],[\"sel\",0,\"\"],[\"beurre et huile d'olive\",0,\"\"],[\"poulet\",500,\"g\"],[\"poivron (vert, rouge, jaune, orange)\",4,\"u\"],[\"brocoli\",1,\"u\"],[\"tomate\",4,\"u\"],[\"champignon\",6,\"u\"],[\"crème fraîche\",25,\"cl\"],[\"concentré de tomates\",70,\"g\"]],\"steps\":[\"Dans un wok, faire fondre un peu de beurre (ou margarine) additionné à 2 cuillères d'huile d'olive.\",\"Y incorporer l'oignon coupé en demi-rondelles et le faire dorer.\",\"Ajouter les dés de poulet.\",\"Saler et poivrer.\",\"Quand les dés de poulet sont pris de tous les côtés, y ajouter l'ail écrasé.\",\"Bien mélanger le tout.\",\"Ensuite, ajouter les poivrons coupés en lanières ainsi que les fleurs du brocoli.\",\"Ajouter les tomates dont on n'aura gardé que la chair (sans les avoir épluchées) ainsi que les champignons coupés en lamelles.\",\"Bien mélanger le tout et laisser cuire 10 à 15 minutes.\",\"Incorporer la crème fraîche et laisser encore cuire 10 à 15 minutes.\",\"Ajouter le concentré de tomates et laisser cuire à feu doux.\",\"Rectifier l'assaisonnement et servir chaud.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Asie\",\"Poulet\",\"Wok\",\"modifié\"],\"source\":\"https://www.marmiton.org/recettes/recette_wok-tomate-aux-des-de-poulet_66757.aspx\",\"notes\":\"\",\"paprikaUid\":\"8601B419-8A7A-4F16-8046-02D912B76495\"},{\"id\":\"wok-de-porc-croustillant-a-l-ananas-mrryzeyrp79\",\"title\":\"Wok de porc croustillant à l’ananas\",\"category\":\"Plat principal\",\"time\":45,\"servings\":4,\"ingredients\":[[\"filet mignon de porc\",400,\"g\"],[\"basmati\",200,\"g riz\"],[\"petit pois surgelé\",150,\"g\"],[\"ananas\",1,\"boîte\"],[\"oignon perle\",1,\"botte\"],[\"poivron rouge\",2,\"u\"],[\"pois gourmand\",250,\"g\"],[\"gousses d’ail\",2,\"u\"],[\"gingembre frais\",2,\"cm\"],[\"maïzena\",2,\"c. à soupe\"],[\"huile de sésame\",4,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Détaillez la viande en tranches de 1/2 cm d’épaisseur.\",\"Pelez et émincez les oignons en laissant la moitié des tiges.\",\"Pelez et hachez l’ail.\",\"Épluchez et râpez le gingembre.\",\"Égouttez l’ananas, détaillez-le en éventails.\",\"Rincez les poivrons, coupez-les en dés.\",\"Éboutez les pois gourmands.\",\"Plongez les petits pois dans de l’eau bouillante salée 5 min et les pois gourmands 2 min, égouttez.\",\"Poudrez les tranches de porc de Maïzena des deux côtés.\",\"Faites chauffer un wok.\",\"Ajoutez l’huile.\",\"Quand elle est chaude, saisissez la viande 3 min à feu vif en remuant pour qu’elle soit croustillante.\",\"Égouttez-la à l’écumoire et réservez (dans une assiette ou sur la grille du wok).\",\"A leur place, faites sauter 5 min les poivrons\",\"Ajoutez l’ail, le gingembre et l’ananas.\",\"Faites-les revenir 2 min.\",\"Versez le riz, les petits pois et les pois gourmands, remuez bien 2 min.\",\"Posez la viande sur le riz.\",\"Salez, poivrez, réchauffez 2 min.\",\"Parsemez de rondelles d’oignon et servez.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Asie\",\"Wok\",\"modifié\"],\"source\":\"https://www.marieclaire.fr/cuisine/porc-croustillant-a-l-ananas,1195827.asp\",\"notes\":\"\",\"paprikaUid\":\"4A6BC3DE-5863-44B3-BF8B-3BFDEF1AE528\"},{\"id\":\"wok-de-nouilles-chinoises-aux-legumes-mrryzeyhhfj\",\"title\":\"Wok de nouilles chinoises aux légumes\",\"category\":\"Plat principal\",\"time\":15,\"servings\":3,\"ingredients\":[[\"nouilles chinoises\",2,\"bloc\"],[\"courgettes\",1,\"u\"],[\"brocolis\",1,\"u\"],[\"poivron rouge\",0.25,\"u\"],[\"gingembre\",0,\"\"],[\"gousse d'ail\",1,\"u\"],[\"échalote\",1,\"u\"],[\"sauce soja\",0,\"\"],[\"huile de sésame\",0,\"\"]],\"steps\":[\"Faire chauffer l'eau pour les pâtes.\",\"Commencer par préparer les ingrédients:\",\"Couper l'ail et le gingembre en petits morceaux ainsi que l'échalote.\",\"Découper en petits cubes la courgette, le poivron et le brocolis en morceaux.\",\"Lorsque l'eau boue, y mettre les nouilles et laisser cuire 5 minutes ou selon le temps habituel de cuisson de vos nouilles.\",\"Il ne faut pas qu'elles soient trop molles.\",\"Faire chauffer de l'huile dans un wok.\",\"Lorsqu'elle est très chaude, y faire revenir le gingembre rapidement.\",\"Ajouter l'ail et l'échalote.\",\"Ajouter immédiatement les morceaux de courgette et couvrir 3 minutes en remuant de temps en temps.\",\"Si le mélange à tendance à brûler, rajouter un peu d'eau.\",\"Retirer les nouilles de l'eau.\",\"Les égoutter légèrement et les ajouter au mélange dans le wok.\",\"Y jeter les morceaux de poivron et de brocolis avec 3 cuillères à soupe de sauce Soja.\",\"Couvrir 3 minutes à feu moyen.\",\"Ajouter de la sauce pour sashimi ou sauce classique à wok et remuer l'ensemble.\",\"Faire cuire jusqu'à ce que l'eau ait presque disparu.\",\"Servir chaud dans des bols avec des baguettes.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Asie\",\"Wok\",\"modifié\"],\"source\":\"https://www.marmiton.org/recettes/recette_wok-de-nouilles-chinoises-aux-legumes_95262.aspx\",\"notes\":\"\",\"paprikaUid\":\"D6DB99C8-39CA-4316-8628-0EEC9B8035B0\"},{\"id\":\"wok-de-legumes-printaniers-pu-parmesan-mrryzeygt5j\",\"title\":\"Wok de légumes printaniers au parmesan\",\"category\":\"Plat principal\",\"time\":30,\"servings\":6,\"ingredients\":[[\"parmesan\",60,\"g\"],[\"asperge verte\",1,\"botte\"],[\"oignon\",4,\"u\"],[\"gousse d’ail\",1,\"u\"],[\"petit pois écossé\",250,\"g\"],[\"pois gourmand\",250,\"g\"],[\"huile d’olive\",2,\"c. à soupe\"],[\"sauce de soja\",2,\"c. à soupe\"],[\"basilic\",10,\"feuille\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Découpez le parmesan en lamelles puis recoupez-les pour former des bâtonnets.\",\"Lavez les asperges, coupez les queues puis fendez-les en deux dans le sens de la longueur.\",\"Éboutez les pois gourmands.\",\"Pelez l’ail et les oignons et émincez-les.\",\"Lavez les légumes verts rapidement sous l’eau froide et égouttez-les.\",\"Faites revenir les oignons et l’ail avec 1 cuillerée à soupe d’huile d’olive dans un wok en les faisant juste blondir.\",\"Ajoutez alors tous les légumes verts et 1 demi-verre d’eau.\",\"Faites cuire sur feu vif en remuant constamment pendant 5 à 10 min.\",\"Les légumes doivent rester un peu croquants.\",\"Rajoutez 1 cuillerée d’huile d’olive, la sauce soja, du sel, du poivre, et les feuilles de basilic ciselées.\",\"Servez aussitôt en parsemant chaque assiette avec les bâtonnets de parmesan.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Asie\",\"Asperges\",\"Wok\",\"modifié\"],\"source\":\"https://www.marieclaire.fr/cuisine/wok-de-legumes-verts-au-parmesan,1194403.asp\",\"notes\":\"\",\"paprikaUid\":\"1695CAE0-1EF5-45C4-8CD4-31368FE915D0\"},{\"id\":\"wok-de-legumes-et-sauce-soja-miel-mrryzeygt3f\",\"title\":\"Wok de légumes et sauce soja/miel\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"échalote\",2,\"u\"],[\"gousse d'ail\",1,\"u\"],[\"piment rouge\",1,\"u\"],[\"crème à rôtir\",3,\"c. à soupe\"],[\"carottes\",400,\"g\"],[\"courge\",400,\"g\"],[\"chou frisé\",5,\"feuille\"],[\"eau\",1,\"dl\"],[\"fécule de maïs\",1,\"c. à soupe\"],[\"sauce de soja\",2,\"c. à soupe\"],[\"vinaigre de pommes\",2,\"c. à soupe\"],[\"miel\",1,\"c. à café\"],[\"cannelle\",0,\"\"],[\"sel\",0,\"\"]],\"steps\":[\"Hacher l'échalote et l'ail.\",\"Epépiner et couper en rondelles le piment.\",\"Couper les carottes en rondelles de 2 mm d'épaisseur.\",\"Couper la courge en morceaux de 2 mm d'épaisseur.\",\"Couper le chou en lanières de 2 cm de largeur.\",\"Faire revenir brièvement dans un wok les échalotes, l'ail et le piment dans le beurre à rôtir.\",\"Ajouter tous les légumes et cuire à feu vif en remuant constamment.\",\"Mélanger l'eau, la fécule de maïs, la sauce soja, le vinaigre de pommes, le miel et la cannelle.\",\"Verser sur les légumes et porter à ébullition.\",\"Rectifier l'assaisonnement.\",\"Servir immédiatement.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Asie\",\"Wok\",\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM199802_31_CAS802B030A/wok-de-legumes-et-sauce-soja-miel/\",\"notes\":\"\",\"paprikaUid\":\"1E6DB678-7019-4B8A-8DD9-ADD3662F3C6E\"},{\"id\":\"wok-de-legumes-et-nouilles-de-riz-mrryzeyfbjz\",\"title\":\"Wok de légumes et nouilles de riz\",\"category\":\"Plat principal\",\"time\":30,\"servings\":2,\"ingredients\":[[\"bouillon de légumes\",1,\"l\"],[\"graine de tournesol nature\",1,\"paquet\"],[\"nouilles de riz\",80,\"g\"],[\"carotte\",400,\"g\"],[\"oignon fanes\",1,\"u\"],[\"huile de sésame grillé\",1,\"c. à soupe\"],[\"sel\",0,\"\"],[\"maïzena\",1,\"c. à café\"],[\"eau\",1,\"dl\"],[\"sauce de soja\",2,\"c. à soupe\"],[\"jus de citron vert\",1,\"c. à soupe\"],[\"persil plat\",3,\"brin\"]],\"steps\":[\"Porter le bouillon à ébullition avec le hachis de tournesol.\",\"Éloigner la casserole du feu.\",\"Ajouter les nouilles.\",\"Laisser reposer env. 10 min.\",\"Égoutter.\",\"Peler les carottes, partager dans la longueur, couper en tranches d’env. 3 mm d’épaisseur.\",\"Tailler l’oignon fanes en rouelles.\",\"Bien faire chauffer l’huile dans le wok.\",\"Faire sauter les carottes env. 5 min en remuant.\",\"Ajouter l’oignon, saler, faire sauter env. 1 min en remuant.\",\"Incorporer les nouilles et le hachis de tournesol, faire sauter encore env. 3 min en remuant.\",\"Dresser.\",\"Délayer la maïzena avec l’eau.\",\"Incorporer la sauce soja et le jus de citron vert.\",\"Verser dans le wok.\",\"Porter à ébullition en remuant.\",\"Laisser cuire env. 1 minute.\",\"Verser la sauce sur les nouilles.\",\"Effeuiller le persil.\",\"Parsemer.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Asie\",\"Wok\",\"modifié\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/wok-de-legumes-et-nouilles-de-riz-10009869/\",\"notes\":\"\",\"paprikaUid\":\"B04AA0A0-59E5-4E7C-8DD9-8A36CE4EBED2\"},{\"id\":\"wok-de-legumes-au-b-uf-mrryzeyedac\",\"title\":\"Wok de légumes au bœuf\",\"category\":\"Plat principal\",\"time\":25,\"servings\":4,\"ingredients\":[[\"carotte\",400,\"g\"],[\"oignon fane\",6,\"u\"],[\"escalope de bœuf\",500,\"g\"],[\"huile d’arachide\",2,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"bouillon de bœuf\",6,\"dl\"],[\"sauce soja claire\",2,\"c. à soupe\"],[\"nouillette chinoise\",240,\"g\"],[\"germe de haricots mungo\",100,\"g\"],[\"persil plat\",2,\"c. à soupe\"]],\"steps\":[\"Couper les carottes et les oignons fanes en rondelles d’env. 5 mm d’épaisseur.\",\"Tailler la viande en lanières d’env. 1 cm d’épaisseur.\",\"Faire sauter env. 1 min dans l’huile très chaude en remuant.\",\"Retirer, saler, poivrer.\",\"Faire sauter les carottes en remuant env. 5 min dans la même poêle.\",\"Ajouter les oignons fanes.\",\"Faire sauter encore env. 2 min.\",\"Retirer.\",\"Verser le bouillon et la sauce soja dans la poêle.\",\"Porter à ébullition.\",\"Baisser le feu.\",\"Ajouter les nouillettes.\",\"Cuire al dente.\",\"Ajouter les germes et remettre la viande et les légumes, le temps de bien faire chauffer.\",\"Parsemer de persil.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Asie\",\"Wok\",\"modifié\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/wok-de-legumes-au-buf-10005225/\",\"notes\":\"\",\"paprikaUid\":\"003E8606-AF96-4116-9C6A-E3D81885849A\"},{\"id\":\"wok-de-filet-mignon-aux-legumes-mrryzeyd6li\",\"title\":\"Wok de filet mignon aux légumes\",\"category\":\"Plat principal\",\"time\":40,\"servings\":5,\"ingredients\":[[\"filet mignon\",500,\"g\"],[\"légume surgelé pour wok\",600,\"g\"],[\"bouillon de volaille\",1,\"cube\"],[\"huile d'olive\",2,\"c. à soupe\"],[\"eau\",15,\"cl\"],[\"romarin\",2,\"pincée\"],[\"cumin\",2,\"pincée\"],[\"sel\",1,\"c. à soupe\"],[\"poivre\",1,\"c. à soupe\"],[\"persil frais\",1,\"botte\"]],\"steps\":[\"Dégraisser le filet mignon si nécessaire.\",\"Faire chauffer l'huile d'olive.\",\"Couper le filet mignon en morceaux.\",\"Les mettre dans le Wok sur l'huile chaude.\",\"Saisir les morceaux et les faire dorer de chaque côté sur feu vif\",\"Saler et poivrer à votre convenance.\",\"Retirer les morceaux de viande et les mettre en attente.\",\"Mettre les légumes surgelés dans le Wok encore chaud.\",\"Cuire environ 8 à 9 minutes en remuant doucement de temps en temps à feu moyen.\",\"Ajouter le romarin feuilles et le cumin.\",\"Saler et poivrer à votre convenance.\",\"Faire un petit trou au milieu des légumes.\",\"Y déposer le cube de bouillon, laisser fondre.\",\"Ajouter l'eau et baisser le feu.\",\"Ajouter les morceaux de viande.\",\"Couvrir et laisser mijoter 5 à 10 minutes.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Asie\",\"Wok\",\"modifié\"],\"source\":\"https://www.marmiton.org/recettes/recette_wok-de-filet-mignon-aux-legumes_343975.aspx\",\"notes\":\"\",\"paprikaUid\":\"5363C915-3D01-4E22-807C-D02380117083\"},{\"id\":\"wok-de-b-uf-au-fenouil-et-au-chevre-mrryzeycnbx\",\"title\":\"Wok de bœuf au fenouil et au chèvre\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"rumsteck\",350,\"g\"],[\"fenouil\",1,\"bulbe\"],[\"chèvre sec\",1,\"u\"],[\"oignon rouge\",2,\"u\"],[\"vinaigre balsamique\",2,\"c. à soupe\"],[\"huile d’olive\",2,\"c. à soupe\"],[\"ciboulette\",8,\"brin\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Détaillez le morceau de viande en lamelles d’environ 2 mm d’épaisseur.\",\"Pelez les oignons, coupez-les en quatre puis recoupez-les en tranches.\",\"Épluchez le fenouil, coupez-le en fines lamelles.\",\"Émiettez le fromage.\",\"Ciselez la ciboulette.\",\"Faites chauffer l’huile dans un wok sur feu vif.\",\"Versez le fenouil et les oignons, salez, poivrez.\",\"Remuez sans cesse pendant 3 min.\",\"Mettez la viande dans le wok et continuez à remuer sur feu vif pendant 2 min.\",\"Ôtez le wok du feu.\",\"Versez-y le vinaigre balsamique.\",\"Mélangez.\",\"Répartissez la préparation dans des assiettes de service chaudes.\",\"Parsemez de chèvre émietté et de ciboulette.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Asie\",\"Wok\",\"modifié\"],\"source\":\"https://www.marieclaire.fr/cuisine/wok-de-boeuf-au-fenouil-et-au-chevre,1196854.asp\",\"notes\":\"\",\"paprikaUid\":\"FB957584-8814-4705-973B-863D1485178F\"},{\"id\":\"wok-de-boeuf-aux-petits-legumes-mrryzeyc9qu\",\"title\":\"Wok de boeuf aux petits légumes\",\"category\":\"Plat principal\",\"time\":40,\"servings\":4,\"ingredients\":[[\"steak haché\",4,\"u\"],[\"pâte chinoise\",400,\"g\"],[\"poivron rouge\",1,\"u\"],[\"maïs\",150,\"g\"],[\"oignon rouge\",2,\"u\"],[\"gousse d'ail\",4,\"u\"],[\"miel\",2,\"c. à soupe\"],[\"sauce de soja\",4,\"c. à soupe\"],[\"huile de sésame\",0,\"\"],[\"sésame\",0,\"\"],[\"poivre\",0,\"\"],[\"piment\",0,\"\"]],\"steps\":[\"Commencez par faire cuire vos pâtes comme indiqué sur le paquet.\",\"Dès la fin de la cuisson les passer sous l'eau froide pour stopper la cuisson et ainsi éviter qu'elles ne deviennent collantes.\",\"Dans le wok faites chauffer un peu d'huile de sésame.\",\"Faites-y revenir sur feu vif les oignons émincés finement.\",\"Ajoutez les poivrons coupés en lanières et l'ail pilé.\",\"Ne cessez pas de remuer votre wok pour éviter que la préparation n'attache.\",\"Quand les poivrons deviennent un peu plus tendre ajoutez le maïs, le miel et la sauce soja.\",\"Poivrez (ou ajoutez le piment de votre choix).\",\"Cuire les steaks hachés à part à la poêle.\",\"Cuire les pâtes selon instructions.\",\"Couper les steak en tranche et les incorporer aux légumes pour bien les enrober de la sauce.\",\"Dresser les assiettes avec des pâtes.\",\"Ajouter la garniture\",\"Saupoudrer de graines de sésame.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Asie\",\"Pâtes\",\"Wok\",\"modifié\"],\"source\":\"https://www.marmiton.org/recettes/recette_wok-de-boeuf-aux-petits-legumes_324937.aspx\",\"notes\":\"\",\"paprikaUid\":\"6C637B8C-3980-4E52-92A1-F87B1FF81479\"},{\"id\":\"whipped-lemonade-mrryzeybhl4\",\"title\":\"Whipped lemonade\",\"category\":\"Boisson\",\"time\":45,\"servings\":4,\"ingredients\":[[\"citron\",3,\"u\"],[\"sucre\",200,\"g\"],[\"eau\",2,\"dl\"],[\"glace pilée\",600,\"g\"],[\"jus de citron\",1,\"dl\"],[\"crème acidulé\",200,\"g\"]],\"steps\":[\"Prélever finement le zeste des citrons (réserver 1 pour la déco) à l'aide d'un économe, mettre dans une casserole.\",\"Ajouter le sucre et l'eau, mélanger, porter à ébullition, laisser bouillonner env. 1 min en remuant.\",\"Éloigner la casserole du feu.\",\"Laisser refroidir le sirop et le mettre env. 30 min au frais.\",\"Mettre la glace pilée, le jus de citron et le lait acidulé dans le blender.\",\"Ajouter le sirop de citron passé au tamis, mixer finement le tout.\",\"Verser la limonade dans les verres, couper le citron réservé en rondelles, en décorer les verres, déguster aussitôt.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"modifié\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/whipped-lemonade-10009278/\",\"notes\":\"\",\"paprikaUid\":\"FA5CD258-302F-4795-8982-FE6F967C3F4D\"},{\"id\":\"vols-au-vent-aux-champignons-mrryzeyam3c\",\"title\":\"Vols-au-vent aux champignons\",\"category\":\"Plat principal\",\"time\":40,\"servings\":4,\"ingredients\":[[\"échalote\",1,\"u\"],[\"gousse d'ail\",1,\"\"],[\"beurre\",0,\"\"],[\"carotte\",2,\"u\"],[\"céleri\",75,\"g\"],[\"champignon mélangé\",600,\"g\"],[\"farine\",2,\"c. à soupe\"],[\"vin blanc\",1,\"dl\"],[\"bouillon de légumes\",1,\"dl\"],[\"demi-crème pour sauces\",2,\"dl\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"ciboulette\",4,\"c. à soupe\"],[\"vols-au-vent\",8,\"u\"]],\"steps\":[\"Farce:\",\"Hacher finement l'échalote et la ciboulette.\",\"Presser l'ail.\",\"Couper les carottes et le céleri en petits dés.\",\"Couper les champignons en 2 ou en lamelles selon les goûts.\",\"Faire suer l'ail et l'échalote dans le beurre.\",\"Ajouter les légumes et étuver.\",\"Ajouter les champignons, saisir brièvement. Saupoudrer de farine.\",\"Mouiller avec le vin ou le bouillon, réduire légèrement.\",\"Incorporer le Bouillon et la crème, réduire jusqu'à l'obtention d'une consistance onctueuse.\",\"Saler, poivrer.\",\"Incorporer la moitié de la ciboulette.\",\"Disposer les vols-au-vent sur une plaque, chauffer 10-15 min dans le four préchauffé à 120°C.\",\"Dresser les vols-au-vent sur des assiettes chaudes.\",\"Garnir de farce.\",\"Parsemer du reste de ciboulette.\",\"Recouvrir avec le chapeau et servir immédiatement.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Saison Autumne\",\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM201209_17/vols-au-vent-aux-champignons/\",\"notes\":\"\",\"paprikaUid\":\"7BB12B99-7FE9-418C-8763-F159B4E865BF\"},{\"id\":\"vol-au-vent-lucernois-mrryzey95mh\",\"title\":\"Vol-au-vent lucernois\",\"category\":\"Plat principal\",\"time\":70,\"servings\":4,\"ingredients\":[[\"pâte feuilletée ronde\",2,\"u\"],[\"œuf\",1,\"u\"],[\"raisins secs\",2,\"c. à soupe\"],[\"cognac\",3,\"c. à soupe\"],[\"viande de veau\",300,\"g\"],[\"beurre à rôtir\",0,\"\"],[\"oignon\",1,\"u\"],[\"clou de girofle\",2,\"u\"],[\"laurier\",1,\"u feuille\"],[\"beurre\",0,\"\"],[\"Paris\",250,\"g champignons de\"],[\"farine\",3,\"c. à soupe\"],[\"blanc\",1,\"dl vin\"],[\"bouillon\",2,\"dl\"],[\"1¼ dl crème\",0,\"\"],[\"veau\",200,\"g quenelles de\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Préchauffer le four à 160°C.\",\"Croûte:\",\"Dérouler les pâtes.\",\"À l'aide d'une assiette, découper un rond de 22 cm de Ø dans une pâte directement sur la plaque chemisée de papier sulfurisé.\",\"Placer au centre une montagne de feuilles de papier ménage froissées, év. les recouvrir d'une feuille pour qu'elles tiennent ensemble.\",\"Badigeonner les bords de la pâte d'œuf.\",\"Découper un rond de 30 cm de Ø dans la deuxième pâte.\",\"À l'aide d'un couteau pointu, tracer un cercle d'env. 6 cm de Ø au centre et faire un petit trou de 1,5-2 cm de Ø au milieu pour laisser passer l'air.\",\"Placer le grand rond de pâte sur le papier ménage.\",\"Réunir les bords et bien appuyer avec une fourchette.\",\"Badigeonner la pâte d'œuf.\",\"Faire des décorations avec les restes de pâte.\",\"Cuire env. 30 min dans le bas du four chaud.\",\"Sortir du four, découper le rond de pâte de 6 cm de Ø (couvercle).\",\"Retirer délicatement le papier ménage.\",\"Farce:\",\"Faire macérer les raisins secs dans le cognac (évt. la veille).\",\"Couper la viande en petits dés (env. 1 cm).\",\"Saisir la viande brièvement dans le beurre à rôtir chaud, réserver.\",\"Réchauffer la croûte env. 15 min. à 100°C sans préchauffer le four.\",\"Dans la même poêle, faire revenir l'oignon hâché et les épices dans le beurre.\",\"Faire revenir les champignons un instant.\",\"Saupoudrer de farine, faire revenir.\",\"Ajouter le vin et le bouillon, porter à ébullition en remuant, ajouter la crème.\",\"Ajouter les quenelles et la viande, chauffer, assaisonner.\",\"Si la sauce est trop liquide, mélanger un peu de farine avec de l'eau, ajouter à la sauce et laisser mijoter.\",\"Déposer la croûte sur un plat, verser délicatement la farce.\",\"Poser le couvercle de pâte, servir immédiatement.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Suisse\",\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM200303_63/vol-au-vent-lucernois/?collection=97824\",\"notes\":\"\",\"paprikaUid\":\"5E407BE7-AF35-4F2C-98F6-945000983C21\"},{\"id\":\"vol-au-vent-d-ete-mrryzey8ona\",\"title\":\"Vol-au-vent d'été\",\"category\":\"Plat principal\",\"time\":40,\"servings\":4,\"ingredients\":[[\"saucisse à rôtir paysannes aux herbes de montagne\",2,\"u\"],[\"échalote\",1,\"u\"],[\"courgette\",200,\"g\"],[\"tomate cerise\",200,\"g\"],[\"huile d'olive\",2,\"c. à soupe\"],[\"pâte feuilletée rectangulaire\",1,\"u\"],[\"concentré de tomate\",2,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"mélange d'herbes italiennes séchées\",2,\"c. à café\"]],\"steps\":[\"Dérouler la pâte, la couper à la roulette en 8 rectangles de taille égale.\",\"Entailler la pâte avec la pointe du couteau, sans la couper, en ménageant un bord d'env. 1½ cm.\",\"Poser les morceaux de pâte sur une plaque chemisée de papier cuisson.\",\"Faire cuire env. 15 min dans le bas du four préchauffé à 220 °C.\",\"Laisser tiédir hors du four.\",\"Faire chauffer l'huile dans une poêle.\",\"Y faire cuire les saucisses pendant 2 min des deux côtés, les sortir de la poêle, laisser tiédir, couper en rondelles, réserver.\",\"Peler l'échalote, la hacher menu.\",\"Couper les courgettes en dés et les tomates cerises en deux.\",\"Faire chauffer l'huile dans la même poêle.\",\"Y faire revenir l'échalote, les courgettes et la purée de tomates pendant env. 5 min.\",\"Mouiller avec l'eau et laisser mijoter env. 10 min, assaisonner.\",\"Ajouter le mélange d'herbes, les tomates cerises et les rondelles de saucisses, poursuivre la cuisson env. 5 min.\",\"Détacher délicatement les chapeaux des vol-au-vent.\",\"Mettre la farce dans les vol-au-vent puis poser les chapeaux dessus.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Saison Été\",\"modifié\"],\"source\":\"https://little.fooby.ch/fr/recettes/23590/vol-au-vent-d-ete\",\"notes\":\"\",\"paprikaUid\":\"83144BEF-1F91-4D7D-9A65-1CED6E854A16\"},{\"id\":\"vol-au-vent-aux-quenelles-mrryzey7fym\",\"title\":\"Vol-au-vent aux quenelles\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"champignons de Paris\",300,\"g\"],[\"oignon\",1,\"u\"],[\"ciboulette\",1,\"botte\"],[\"vol-au-vent en pâte feuilletée\",8,\"u\"],[\"huile de colza\",2,\"c. à soupe\"],[\"vin blanc\",1,\"dl\"],[\"crème\",2,\"dl\"],[\"fécule de maïs\",1,\"c. à soupe\"],[\"quenelles de chair à saucisse\",400,\"g\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Parer les champignons et les couper en menus morceaux.\",\"Émincer l'oignon et ciseler la ciboulette.\",\"Détacher la calotte de pâte des coques de vol-au-vent.\",\"Disposer les coques et les calottes sur une plaque chemisée de papier sulfurisé.\",\"Glisser dans le four encore froid, régler la température sur 180 °C et cuire env. 10 min à chaleur montante.\",\"Entre-temps, faire suer l'oignon env. 2 min dans l'huile.\",\"Ajouter les champignons et les saisir brièvement.\",\"Mouiller avec le vin.\",\"Délayer la fécule de maïs dans la crème et verser dans la casserole avec les quenelles.\",\"Porter à ébullition, puis laisser mijoter env. 5 min à feu doux jusqu'à liaison.\",\"Saler, poivrer.\",\"Dresser les quenelles en sauce dans les vol-au-vent et parsemer de ciboulette. Idéal avec des carottes à la vapeur.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Suisse\",\"modifié\"],\"source\":\"https://migusto.migros.ch/fr/recettes/vol-au-vent-aux-quenelles\",\"notes\":\"\",\"paprikaUid\":\"1BD4326C-1F97-4F88-8D00-B0BE36FA82B7\"},{\"id\":\"vol-au-vent-aux-legumes-et-aux-champignons-mrryzey7gw9\",\"title\":\"Vol-au-vent aux légumes et aux champignons\",\"category\":\"Plat principal\",\"time\":25,\"servings\":4,\"ingredients\":[[\"légumes de saison\",500,\"g\"],[\"champignons de Paris\",200,\"g\"],[\"oignon\",0.5,\"u\"],[\"farine\",2,\"c. à soupe\"],[\"beurre\",3,\"c. à soupe\"],[\"vin blanc\",0.5,\"dl\"],[\"noix de muscade\",0,\"\"],[\"poivre\",0,\"\"],[\"sel\",0,\"\"],[\"crème\",2,\"dl\"],[\"vol-au-vent\",8,\"u\"]],\"steps\":[\"Légumes:\",\"Couper les légumes en morceaux.\",\"Cuire al dente dans une grande quantité d'eau salée.\",\"Retirer les légumes, récupérer l'eau de cuisson.\",\"Champignons:\",\"Couper les champignons en lamelles.\",\"Hacher l'oignon.\",\"Faire revenir l'oignon dans le beurre.\",\"Ajouter les champignons et faire revenir.\",\"Sauce:\",\"Faire revenir la farine dans le beurre.\",\"Ajouter le vin et l'eau de cuisson des légumes en remuant.\",\"Porter à ébullition.\",\"Rectifier l'assaisonnement.\",\"Ajouter de la crème.\",\"Incorporer les légumes.\",\"Dressage:\",\"Remplir les vol-au-vent de sauce aux légumes.\",\"Répartir les champignons par-dessus.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Saison Autumne\",\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/KO2022_SBLV_29/vol-au-vent-aux-legumes-et-aux-champignons/\",\"notes\":\"\",\"paprikaUid\":\"79420088-7E10-4A43-83A1-5FC30A04382D\"},{\"id\":\"vol-au-vent-aux-legumes-et-au-sere-mrryzey6gvz\",\"title\":\"Vol-au-vent aux légumes et au séré\",\"category\":\"Plat principal\",\"time\":70,\"servings\":4,\"ingredients\":[[\"vol-au-vents\",8,\"u\"],[\"séré\",300,\"g\"],[\"Gruyère\",100,\"g\"],[\"oignon\",1,\"u\"],[\"maïs\",2,\"boîte\"],[\"poireau\",1,\"u\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"tomate cerise\",150,\"g\"],[\"crème à rôtir\",0,\"\"]],\"steps\":[\"Préchauffer le four à 180°.\",\"Disposer les vol-au-vent sur la plaque préparée.\",\"Râper le fromage, hacher l'oignon et couper le poireauen fines rondelles.\",\"Mélanger le séré avec le Gruyère, l'oignon, le maïs et la moitié du poireau.\",\"Saler, poivrer.\",\"Répartir sur les vol-au-vent et cuire 20-25 min au milieu du four.\",\"Disposer les tomates sur la plaque.\",\"Arroser de crème à rôtir.\",\"Saler et enfourner pour les 5-10 dernières minutes de cuisson.\",\"Dresser les vol-au-vent et les tomates cerises sur des assiettes chaudes.\",\"Décorer avec le reste du poireau.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Saison Autumne\",\"Saison Été\",\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM201309_17/vol-au-vent-vegetarien-aux-legumes-et-au-sere/\",\"notes\":\"\",\"paprikaUid\":\"5B436A82-5AE6-41B9-B29A-56F3A6DFB155\"},{\"id\":\"vinaigrette-du-jardin-mrryzey5tfk\",\"title\":\"Vinaigrette du jardin\",\"category\":\"Sauce\",\"time\":10,\"servings\":2,\"ingredients\":[[\"radis rouge\",5,\"u\"],[\"persil\",2,\"c. à soupe\"],[\"ciboulette\",2,\"c. à soupe\"],[\"vinaigre aux herbes\",0.75,\"dl\"],[\"huile d'olive\",1,\"dl\"],[\"bouillon de légumes\",0.5,\"dl\"],[\"aneth\",2,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Mélanger le vinaigre, l'huile et le bouillon.\",\"Ajouter les petits radis et les herbes, mélanger et assaisonner.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Salade\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/15927/vinaigrette-du-jardin\",\"notes\":\"\",\"paprikaUid\":\"2BDE3CFD-97D1-4A28-A23E-6C436DD31E9A\"},{\"id\":\"verdure-alla-griglia-mrryzey4z3j\",\"title\":\"Verdure alla griglia\",\"category\":\"Accompagnement\",\"time\":90,\"servings\":4,\"ingredients\":[[\"fenouil\",1,\"u\"],[\"aubergine\",1,\"u\"],[\"courgette\",2,\"u\"],[\"poivron\",2,\"u\"],[\"citron\",1,\"u\"],[\"huile d’olive\",1,\"dl\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Tailler le fenouil en quartiers, blanchir env. 2 min dans l'eau bouillante, rincer sous l'eau froide, égoutter, déposer sur un grand plat.\",\"Couper l'aubergine et les courgettes dans la longueur en rondelles d'env. 5 mm d'épaisseur.\",\"Tailler les poivrons en huit, disposer tous les légumes sur le plat.\",\"Râper le zeste du citron et presser le jus, mélanger avec l'huile, saler, poivrer.\",\"Arroser les légumes avec la moitié de la marinade, laisser mariner env. 15 minutes.\",\"Gril à charbon de bois, à gaz ou électrique: faire griller les légumes par portions env. 5 min sur chaque face au-dessus de braises moyennes ou à chaleur moyenne (env. 200°C).\",\"Déposer sur un plat, arroser avec le reste de la marinade, laisser mariner jusqu'au moment de servir.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Saison Été\",\"modifié\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/verdure-alla-griglia-10004159/\",\"notes\":\"\",\"paprikaUid\":\"A4B08F28-432A-4725-A332-AC06D53D9561\"},{\"id\":\"veloute-d-asperges-au-saumon-mrryzey4uzg\",\"title\":\"Velouté d’asperges au saumon\",\"category\":\"Soupe\",\"time\":30,\"servings\":4,\"ingredients\":[[\"pignons de pin\",2,\"c. à soupe\"],[\"basilic\",1,\"bouquet\"],[\"asperge verte\",500,\"g\"],[\"oignons\",1,\"u\"],[\"lait\",1,\"l\"],[\"saumon fumé\",4,\"tranche\"],[\"bouillon de légumes\",2,\"dl\"],[\"poivre\",0,\"\"],[\"sel\",0,\"\"]],\"steps\":[\"Peler le tiers inférieur des asperges, les couper en tronçons, couper l’oignon en quatre et faire cuire env. 20 min avec les asperges, le lait et le bouillon, en remuant de temps en temps.\",\"Ajouter les feuilles de basilic, mixer, rectifier l’assaisonnement.\",\"Partager les tranches de saumon en deux.\",\"Les enrouler deux par deux en les faisant légèrement se chevaucher, poser dans des assiettes, verser la soupe autour des roses de saumon.\",\"Décorer selon goût avec des feuilles de basilic.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Asperges\",\"Saison Printemps\",\"Poisson\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/10440/veloute-dasperges-au-basilic\",\"notes\":\"\",\"paprikaUid\":\"238CDDE5-8BF9-4785-A793-9E02E5E046E8\"},{\"id\":\"veloute-de-topinambour-carotte-et-poireau-mrryzey3wwn\",\"title\":\"Velouté de topinambour, carotte et poireau\",\"category\":\"Plat principal\",\"time\":40,\"servings\":5,\"ingredients\":[[\"oignon\",1,\"u\"],[\"gousse d'ail\",1,\"u\"],[\"poireau\",0.5,\"u\"],[\"carotte\",1,\"u\"],[\"topinambour\",400,\"g\"],[\"beurre\",0,\"\"],[\"vin blanc\",1,\"dl\"],[\"bouillon de légumes\",1.5,\"l\"],[\"crème entière\",3,\"dl\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"noix de muscade\",0,\"\"]],\"steps\":[\"Hacher finement les oignons.\",\"Presser l'ail.\",\"Couper le poireau en morceaux.\",\"Couper les carottes en rondelles.\",\"Couper les topinambours en morceaux.\",\"Faire revenir tous les légumes dans le beurre.\",\"Mouiller avec le vin.\",\"Verser le bouillon, laisser mijoter 20-25 min à feu doux à couvert.\",\"Fouetter 1 dl de crème.\",\"Réduire en purée, passer éventuellement au tamis.\",\"Incorporer le reste de la crème.\",\"Rectifier l'assaisonnement.\",\"Verser le velouté dans des bols préalablement chauffés.\",\"Décorer d'une étoile de carotte et de persil.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Saison Autumne\",\"Saison Hiver\",\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM200312_06_A/veloute-de-topinambour-carotte-et-poireau/\",\"notes\":\"\",\"paprikaUid\":\"265F60E9-4BFE-44C8-982A-014D015C37D6\"},{\"id\":\"veloute-de-poireaux-et-de-marrons-lanieres-de-jambon-glacees-mrryzey210a\",\"title\":\"Velouté de poireaux et de marrons, lanières de jambon glacées\",\"category\":\"Soupe\",\"time\":40,\"servings\":1,\"ingredients\":[[\"marrons pelés surgelés\",200,\"g\"],[\"poireau\",250,\"g\"],[\"huile d'olive\",2,\"c. à soupe\"],[\"crème entière\",1,\"dl\"],[\"sirop d'érable\",1,\"c. à soupe\"],[\"jambon arrière\",60,\"g\"],[\"vin blanc\",1,\"dl\"],[\"sel\",1,\"c. à café\"],[\"poivre\",0,\"\"]],\"steps\":[\"Faire chauffer l’huile, y étuver les marrons et les blancs de poireau pendant env. 4 minutes, mouiller avec le vin et laisser réduire de moitié.\",\"Ajouter l’eau, porter à ébullition, baisser le feu et laisser mijoter à couvert pendant env. 15 min.\",\"Mixer le velouté et rectifier l’assaisonnement.\",\"Faire chauffer l’huile dans une poêle antiadhésive, y faire griller lentement le jambon, ajouter les feuilles de poireau et le sirop d’érable puis poursuivre la cuisson pendant env. 3 min.\",\"Garnir le velouté de lanières de jambon et de crème fouettée.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Saison Autumne\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/9400/veloute-de-poireaux-et-de-marrons--lanieres-de-jambon-glacees\",\"notes\":\"\",\"paprikaUid\":\"1D4EE171-A260-446B-9E78-E036B1ADCDF5\"},{\"id\":\"veloute-de-parmesan-au-jambon-cru-mrryzey14n4\",\"title\":\"Velouté de parmesan au jambon cru\",\"category\":\"Soupe\",\"time\":30,\"servings\":2,\"ingredients\":[[\"grissini al gusto di tartufo\",2,\"bâton\"],[\"échalotes\",1,\"u\"],[\"gousse d’ail\",1,\"u\"],[\"citrons\",1,\"u\"],[\"cerfeuil\",2,\"brin\"],[\"Maïzena\",1,\"c. à café\"],[\"beurre\",2,\"c. à soupe\"],[\"crème entière\",2,\"dl\"],[\"parmesan râpé\",80,\"g\"],[\"bouillon de légumes\",2,\"dl\"],[\"vermouth blanc sec\",0.5,\"dl\"],[\"jambon cru\",4,\"tranche\"],[\"vin blanc\",1,\"dl\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Faire fondre le beurre dans une casserole.\",\"Y faire revenir l'ail et l'échalote pendant 2 min.\",\"Mouiller avec le vin et le vermouth, laisser réduire de moitié.\",\"Bien mélanger le bouillon, la crème et la maïzena, ajouter le tout dans la casserole, couvrir et laisser mijoter env. 10 min en remuant de temps en temps.\",\"Ajouter le parmesan, mélanger, faire chauffer brièvement.\",\"Ajouter le zeste de citron, assaisonner.\",\"Émulsionner le velouté juste avant de le servir, le verser dans 2 bols, le garnir de cerfeuil.\",\"Enrouler 2 tranches de jambon cru autour des gressins, les servir avec.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Saison Été\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/28083/veloute-de-parmesan-au-jambon-cru-\",\"notes\":\"\",\"paprikaUid\":\"2D266009-FE59-4C94-9091-6771AB35BDF3\"},{\"id\":\"veloute-de-marrons-aux-champignons-mrryzey0c9q\",\"title\":\"Velouté de marrons aux champignons\",\"category\":\"Soupe\",\"time\":45,\"servings\":4,\"ingredients\":[[\"marron pelé surgelé\",300,\"g\"],[\"échalote\",2,\"u\"],[\"gousse d’ail\",1,\"u\"],[\"pomme de terre farineuse\",200,\"g\"],[\"pleurotes du panicaut\",150,\"g\"],[\"huile d'olive\",2,\"c. à soupe\"],[\"demi-crème acidulée\",200,\"g\"],[\"thym\",6,\"brin\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Faire chauffer l'huile dans une casserole.\",\"Y faire suer l'échalote et l'ail pendant 3 min.\",\"Ajouter les marrons, les pommes de terre et le thym, poursuivre brièvement la cuisson.\",\"Ajouter l'eau, porter à ébullition, assaisonner.\",\"Baisser le feu, couvrir et laisser mijoter env. 20 min.\",\"Ajouter la demi-crème acidulée, mixer la soupe.\",\"Faire chauffer l'huile dans une poêle antiadhésive.\",\"Y mettre les champignons, baisser le feu et faire revenir pendant env. 5 min.\",\"Ajouter le thym, assaisonner.\",\"Dresser le velouté, répartir la demi-crème acidulée et les champignons dessus.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Saison Autumne\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/25829/veloute-de-marrons-aux-champignons\",\"notes\":\"\",\"paprikaUid\":\"0A2B70A2-AEED-45B7-9266-95135793F854\"},{\"id\":\"veloute-de-courge-mrryzexzkbt\",\"title\":\"Velouté de courge\",\"category\":\"Soupe\",\"time\":30,\"servings\":4,\"ingredients\":[[\"graines de courge\",1,\"c. à soupe\"],[\"oignons\",1,\"u\"],[\"pomme de terre farineuse\",250,\"g\"],[\"pommes\",1,\"u\"],[\"huile d'olive\",1,\"c. à soupe\"],[\"crème\",1,\"dl\"],[\"dés de courge\",400,\"g\"],[\"bouillon de légumes\",6,\"dl\"],[\"curry doux\",1,\"c. à café\"],[\"laurier\",1,\"feuilles\"],[\"sel\",0,\"\"]],\"steps\":[\"Faire chauffer l'huile dans une casserole.\",\"Faire revenir l'oignon, la courge, la pomme de terre, la pomme et le curry pendant env. 3 min.\",\"Mouiller avec le bouillon, ajouter la feuille de laurier et laisser mijoter à couvert pendant env. 20 min.\",\"Retirer la feuille de laurier, verser la crème.\",\"Mixer le velouté, puis saler.\",\"Dresser le velouté, parsemer de graines de courge.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Saison Autumne\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/16973/veloute-de-courge\",\"notes\":\"\",\"paprikaUid\":\"23A23CF7-EEA1-41BF-8D1E-2C5F0BECF7D6\"},{\"id\":\"veloute-de-chou-fleur-mrryzexyl9f\",\"title\":\"Velouté de chou-fleur\",\"category\":\"Soupe\",\"time\":25,\"servings\":4,\"ingredients\":[[\"beurre\",0,\"\"],[\"oignon\",1,\"u\"],[\"chou-fleur\",600,\"g\"],[\"pomme de terre\",1,\"u\"],[\"bouillon\",8,\"dl\"],[\"jus de citron\",1,\"c. à soupe\"],[\"crème\",2,\"dl\"],[\"noix de muscade\",0,\"\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"crème à rôtir\",0,\"\"],[\"crème\",0.5,\"dl\"]],\"steps\":[\"Soupe:\",\"Hacher l'oignon.\",\"Détailler le chou-fleur en bouquets. Réserver 3 bouquets.\",\"Peler la pomme de terre en dés.\",\"Faire revenir l'oignon dans le beurre.\",\"Ajouter le chou-fleur et la pomme de terre.\",\"Mouiller avec le bouillon.\",\"Cuire 15-25 min.\",\"Mixer la soupe.\",\"Ajouter la crème légèrement fouettée, assaisonner.\",\"Décoration:\",\"Saisir brièvement les tranches de chou-fleur dans le beurre à rôtir, assaisonner.\",\"Dresser la soupe.\",\"Ajouter le chou-fleur grillé et la crème par-dessus.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Saison Autumne\",\"Saison Hiver\",\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM200910_60_A/veloute-de-chou-fleur/\",\"notes\":\"\",\"paprikaUid\":\"24557981-77CD-4D55-B0AC-22C722EAD393\"},{\"id\":\"tresse-au-beurre-mrryzexxmw8\",\"title\":\"Tresse au beurre\",\"category\":\"Déjeuner\",\"time\":210,\"servings\":6,\"ingredients\":[[\"farine\",1.5,\"kg\"],[\"levure fraîche\",60,\"g\"],[\"lait\",60,\"cl\"],[\"sucre\",1.5,\"c. à café\"],[\"oeuf\",3,\"u\"],[\"beurre\",300,\"g\"],[\"sel\",1.5,\"c. à café\"],[\"oeuf\",1.5,\"u\"],[\"jaune d'oeuf\",1.5,\"u\"],[\"sucre\",20,\"g\"]],\"steps\":[\"La veille, mélanger les ingrédients pour la couverture.\",\"Couvrir et réserver.\",\"Diluer la levure dans un peu de lait tiède.\",\"Ajouter le sucre et bien mélanger.\",\"Laisser reposer pendant 10 minutes.\",\"Préparer le robot, préchauffer un récipient et tamiser la farine dedans.\",\"Ajouter le sel autour.\",\"Verser la levure dans un creux au milieu.\",\"Commencer à pétrir en ajoutant au fur et à mesure le lait tiède.\",\"Ajouter les œufs.\",\"Ajouter le beurre fondu.\",\"Continuer à pétrir jusqu'à l'obtention d'une pâte lisse.\",\"Couvrir avec un linge et laisser reposer au chaud pendant 1h30.\",\"Diviser la pâte en deux parts et former deux saucisses égales.\",\"Former la tresse et laisser reposer au chaud pendant 15 minutes.\",\"Par la suite, la reposer au frais pendant 30 à 60 minutes.\",\"Pendant ce temps, préchauffer le four à 220°.\",\"Badigeonner, à l'aide d'un pinceau, la tresse avec la couverture.\",\"Enfourner dans le bas du four.\",\"Après 5 minutes, verser une tasse d'eau froide sur le bas du four.\",\"Cuire la tresse pendant 40 à 60 minutes.\",\"Taper le fond de la tresse pour contrôler la cuisson.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Pain\",\"Suisse\",\"modifié\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"7CF9BE07-0FF0-4603-9FF1-C667D352D084\"},{\"id\":\"tranches-de-veau-panees-mrryzextqar\",\"title\":\"Tranches de veau panées\",\"category\":\"Plat principal\",\"time\":25,\"servings\":4,\"ingredients\":[[\"tranche de veau\",4,\"u\"],[\"chapelure\",200,\"g\"],[\"œuf\",2,\"u\"],[\"farine\",70,\"g\"],[\"sel\",0,\"\"],[\"huile de friture\",0,\"\"],[\"citron\",1,\"u\"]],\"steps\":[\"Applatir et sécher les tranches de veau avec du papier absorbant.\",\"Préparer les ingrédients pour la panure :\",\"Saler et battre les œufs dans un plat.\",\"Verser la farine et la chapelure dans 2 autres récipients plats.\",\"Fariner les tranches des deux côtés.\",\"Ensuite, les passer dans l’œuf battu.\",\"Enfin, les recouvrir uniformment de chapelure.\",\"Déposer sur un plat.\",\"Chauffer l'huile de friture dans une grande pole jusqu'à 170°.\",\"Plonger une tranche à la fois et frire pendant environ 3 minutes, en utilisant une louche pour arroser d'huile bouillante dessus, afin d'assurer une dorure uniforme.\",\"Quand la tranche sera bien dorée, goutter sur du papier absorbant.\",\"Procéder de la même manière pour frire les autres tranches.\",\"Saler au goût et servir immédiatement, accompagné de quelques quartiers de citron.\",\"Servir avec salade de pommes de terre, frites ou spaghetti napolitaine.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"modifié\"],\"source\":\"https://www.giallozafferano.fr/recettes/cotelettes.html\",\"notes\":\"\",\"paprikaUid\":\"7AC344A6-DCD5-404B-A24F-AEF7358314E5\"},{\"id\":\"tranche-de-b-uf-avec-sauce-a-la-creme-au-poivre-mrryzexsmmf\",\"title\":\"Tranche de bœuf avec sauce à la crème au poivre\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"échalote\",1,\"u\"],[\"gousse d´ail\",2,\"u\"],[\"grains de poivre mélangés\",1,\"c. à soupe\"],[\"nouille\",400,\"g\"],[\"sel\",0,\"\"],[\"tranches bœuf à la minute d'env. 120 g\",4,\"u\"],[\"huile d'arachide\",4,\"c. à soupe\"],[\"sauce pour rôti liée\",2,\"dl\"],[\"crème\",1,\"dl\"],[\"origan\",2,\"brin\"]],\"steps\":[\"Émincer l'échalote et l'ail.\",\"Broyer grossièrement les grains de poivre dans un mortier.\",\"Cuire les nouilles al dente dans un grand volume d'eau salée.\",\"Entre-temps, saler les tranches de bœuf.\",\"Chauffer l'huile dans une poêle et saisir la viande env. 2 min des deux côtés.\",\"La retirer de la poêle, l'emballer dans une feuille d'aluminium et la laisser reposer.\",\"Faire brièvement revenir l'échalote, l'ail et le poivre dans les sucs de cuisson.\",\"Ajouter la sauce pour rôti et la crème et faire un peu réduire.\",\"Déballer la viande.\",\"Verser le jus dans la sauce et saler.\",\"Dresser les nouilles avec la viande et la sauce.\",\"Effeuiller l'origan par-dessus et servir.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Suisse\",\"modifié\"],\"source\":\"https://migusto.migros.ch/fr/recettes/tranche-de-boeuf-avec-sauce-a-la-creme-au-poivre\",\"notes\":\"\",\"paprikaUid\":\"F3F451F3-A5EE-4CB5-98C2-281CCE21A208\"},{\"id\":\"tonkatsu-escalope-de-porc-panee-a-la-japonaise-mrryzexrcdr\",\"title\":\"Tonkatsu (Escalope de porc panée à la japonaise)\",\"category\":\"Plat principal\",\"time\":60,\"servings\":4,\"ingredients\":[[\"escalopes de porc\",4,\"u\"],[\"farine de blé\",90,\"g\"],[\"œuf\",2,\"u\"],[\"panko\",0,\"\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"huile de cuisson\",0,\"\"],[\"Worcestershire\",3,\"c. à soupe\"],[\"ketchup\",3,\"c. à soupe\"],[\"sucre (blanc ou cassonnade)\",1,\"c. à soupe\"],[\"sauce soja\",1,\"c. à soupe\"],[\"saké (ou mirin ou vin blanc)\",3,\"c. à soupe\"],[\"moutarde\",1,\"c. à café\"],[\"ail en purée\",1,\"c. à café\"]],\"steps\":[\"Préparer la sauce en mélangeant tous les ingrédients.\",\"Vous pouvez faire chauffer le tout dans une casserole à feu doux ou les mélanger sans les chauffer.\",\"Ici, elle a été chauffée pour faciliter la dissolution du sucre.\",\"Quel que soit le mode de préparation, la sauce sera servie froide sur l'escalope.\",\"Préparer la viande.\",\"Attendrir chaque morceau à l'aide d'un maillet ou la lame d'un couteau.\",\"Disposer farine, œufs battus en omelette et chapelure dans trois assiettes creuses.\",\"Saler et poivrer les escalopes de chaque côté.\",\"Déposer successivement chacune des escalopes dans la farine, les œufs battus et enfin la chapelure.\",\"La chapelure doit recouvrir entièrement chaque morceau.\",\"Faire chauffer une bonne quantité d'huile dans une poêle et y mettre les escalopes à cuire jusqu'à ce qu'elles soient bien dorées.\",\"Mettre les escalopes sur un papier absorbant.\",\"Pour plus de croustillant, remettre les escalopes à chauffer dans une poêle juste avant de servir.\",\"Servir les escalopes bien chaudes nappées de sauce accompagnées d'une salade de chou et d'un bol de riz.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Asie\",\"modifié\"],\"source\":\"https://cookpad.com/fr/recipe/images/4a93977ef9e9cae4?image_region_id=27\",\"notes\":\"\",\"paprikaUid\":\"CD20859F-7650-433C-ACF4-4EAB55BAB84D\"},{\"id\":\"tomates-gratinees-aux-olives-et-aux-pignons-de-pin-mrryzexroe6\",\"title\":\"Tomates gratinées aux olives et aux pignons de pin\",\"category\":\"Accompagnement\",\"time\":40,\"servings\":4,\"ingredients\":[[\"pignon de pin\",2,\"c. à soupe\"],[\"tomate en grappe\",1,\"kg\"],[\"gousse d’ail\",3,\"u\"],[\"basilic\",0.5,\"bouquet\"],[\"huile d'olive\",2,\"c. à soupe\"],[\"mozzarella\",1,\"billes\"],[\"olives kalamata\",60,\"g\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Poser les tomates sur une plaque chemisée de papier cuisson.\",\"Mélanger l'huile avec l'ail, le sel et le poivre, napper les tomates de ce mélange.\",\"Garnir de mozzarella, d'olives et de pignons de pin.\",\"Faire cuire env. 25 min. au milieu du four préchauffé à 200 °C.\",\"Sortir du four et décorer avec des feuilles de basilic.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Gratin\",\"Italie\",\"Saison Été\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/18498/tomates-gratinees-aux-olives-et-aux-pignons-de-pin\",\"notes\":\"\",\"paprikaUid\":\"34816735-9795-4E67-BE4A-0E2E6036C3B7\"},{\"id\":\"tomates-farcies-au-riz-mrryzexqtyi\",\"title\":\"Tomates farcies au riz\",\"category\":\"Plat principal\",\"time\":40,\"servings\":4,\"ingredients\":[[\"tomates à chair ferme\",8,\"u\"],[\"risotto\",75,\"g\"],[\"gousse d'ail\",1,\"\"],[\"basilic\",2,\"brin\"],[\"persil\",2,\"brin\"],[\"mascarpone ou Sbrinz\",75,\"g\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"beurre\",0,\"\"]],\"steps\":[\"Découper un chapeau dans le tiers supérieur des tomates.\",\"Réserver.\",\"Évider les tomates avec une cuillère au-dessus d'un bol et les disposer dans le plat beurré.\",\"Mixer la chair des tomates.\",\"Hacher finement l'ail, le persil et le basilic.\",\"Râper le fromage.\",\"Ajouter le riz, l'ail, les herbes et le mascarpone ou le Sbrinz.\",\"Assaisonner.\",\"Farcir les tomates et remettre les chapeaux.\",\"Parsemer de flocons de beurre.\",\"Cuire 20 min au milieu du four préchauffé à 210° C.\",\"Laisser reposer 15 min dans le four éteint.\",\"Servir chaud ou froid.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/RB_FF2004_06/tomates-farcies-au-riz/\",\"notes\":\"\",\"paprikaUid\":\"94BF04FC-E6A8-4961-9D55-8C7C61A0BF34\"},{\"id\":\"tomates-d-ete-farcies-mrryzexpi1q\",\"title\":\"Tomates d'été farcies\",\"category\":\"Accompagnement\",\"time\":60,\"servings\":4,\"ingredients\":[[\"tomates\",1.5,\"kg\"],[\"oignon\",1,\"u\"],[\"gousse d’ail\",2,\"u\"],[\"origan frais\",1,\"botte\"],[\"boulgour\",200,\"g\"],[\"noix\",100,\"g\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"huile d’olive\",4,\"c. à soupe\"]],\"steps\":[\"PRÉPARATION :\",\"Couper le tiers supérieur des tomates et le mettre de côté.\",\"Extraire la chair avec une cuillère, hacher, et mettre dans un saladier.\",\"Hacher l'oignon, origan, les noix et l'ail.\",\"Ajouter les oignons et tous les ingrédients jusqu’aux noix, mélanger et assaisonner.\",\"Verser la masse dans les tomates et poser le couvercle mis de côté dessus.\",\"Placer les tomates dans le moule.\",\"CUISSON :\",\"Faire cuire pendant env. 40 minutes au milieu du four préchauffé à 200 °C.\",\"Verser quelques gouttes d’huile dessus.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Saison Été\",\"modifié\"],\"source\":\"https://www.gemuese.ch/fr/recettes/tomates-farcies-d-ete?_gl=1*wzlj9f*_up*MQ..&gclid=EAIaIQobChMItdK7sbK4kQMVepKDBx0SyAWNEAAYASABEgL9oPD_BwE&gbraid=0AAAAA-NhTE5iAnPHfalM4KcSHGDur_dvT\",\"notes\":\"\",\"paprikaUid\":\"A8212068-BC49-4CA6-9BE3-5957CD609CBC\"},{\"id\":\"tomates-au-four-a-la-burrata-mrryzexosvf\",\"title\":\"Tomates au four à la Burrata\",\"category\":\"Accompagnement\",\"time\":80,\"servings\":4,\"ingredients\":[[\"tomate de différente couleur\",1,\"kg\"],[\"oignon rouge\",3,\"u\"],[\"ail entier\",1,\"tête\"],[\"basilic\",3,\"branche\"],[\"origan\",3,\"branche\"],[\"sel\",2,\"c. à café\"],[\"poivre\",0,\"\"],[\"sucre en poudre\",1,\"c. à soupe\"],[\"huile de colza\",3,\"c. à soupe\"],[\"burrata\",250,\"g\"]],\"steps\":[\"PRÉPARATION:\",\"Mettre les tomates, les oignons et l’ail sur la plaque de cuisson préparée.\",\"Répartir les herbes dessus et assaisonner.\",\"Saupoudrer de sucre et verser de l’huile sur les tomates.\",\"Couper l'oignon en quartiers.\",\"Couper l’ail en deux dans le sens de la largeur.\",\"Couper le basilic et l'origan en lamelles.\",\"CUISSON:\",\"Faire cuire pendant 50 à 60 minutes au milieu du four préchauffé à 150 °C (chaleur supérieure et inférieure) en laissant la porte du four légèrement ouverte.\",\"Sortir les tomates, répartir la burrata sur les légumes chauds et saupoudrer d’herbes.\",\"Les tomates au four accompagnent parfaitement les grillades ou les patates douces au four.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Saison Été\",\"modifié\"],\"source\":\"https://www.gemuese.ch/fr/recettes/tomates-au-four-a-la-burrata?_gl=1*16hsagt*_up*MQ..&gclid=EAIaIQobChMItdK7sbK4kQMVepKDBx0SyAWNEAAYASABEgL9oPD_BwE&gbraid=0AAAAA-NhTE5iAnPHfalM4KcSHGDur_dvT\",\"notes\":\"\",\"paprikaUid\":\"266DABAE-FD4C-4ACD-8056-BA80C16B8BBE\"},{\"id\":\"tomates-au-four-et-creme-a-la-feta-mrryzexnuup\",\"title\":\"Tomates au four et crème à la féta\",\"category\":\"Accompagnement\",\"time\":25,\"servings\":4,\"ingredients\":[[\"tomate cerise\",500,\"g\"],[\"miel liquide\",2,\"c. à soupe\"],[\"huile de colza\",2,\"c. à soupe\"],[\"gousse d'ail\",2,\"u\"],[\"pain\",4,\"tranche\"],[\"féta\",200,\"g\"],[\"yogourt grecque\",100,\"g\"],[\"jus de citron\",2,\"c. à café\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Mettre les tomates dans le plat à gratin.\",\"Ajouter le miel, l'huile et le sel, mélanger.\",\"Enfourner dans le haut du four froid et cuire 15-20 min à 180°C chaleur tournante (chaleur traditionnelle: 200°C).\",\"Avec la fonction gril, le temps de cuisson est réduit d'env. 5 min.\",\"Remuer de temps en temps.\",\"Mélanger l'ail pressé et l'huile.\",\"En tartiner les tranches de pain d'une fine couche.\",\"Ajouter les tranches de pain dans le four, à côté des tomates.\",\"Cuire 5-10 min.\",\"Crème à la féta:\",\"Émietter la feta.\",\"Mettre tous les ingrédients dans un récipient à bord haut.\",\"Mixer et rectifier l'assaisonnement.\",\"Ajouter de l'eau selon la consistance désirée.\",\"Dressage:\",\"Étaler la crème à la féta sur une assiette.\",\"Ajouter les tomates et le jus de cuisson par-dessus.\",\"Servir avec le pain grillé.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Grecque\",\"Saison d'éte\",\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2024_DIVE_04/tomates-au-four-et-creme-a-la-feta/\",\"notes\":\"\",\"paprikaUid\":\"8519BB7B-708E-49E6-95B4-741DEE40F9B3\"},{\"id\":\"tokkebi-mrryzexm607\",\"title\":\"Tokkebi\",\"category\":\"Snack\",\"time\":30,\"servings\":12,\"ingredients\":[[\"Knacki\",12,\"u\"],[\"chapelure\",100,\"g\"],[\"pâte à beignet\",1,\"u\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"farine\",150,\"g\"],[\"lait\",150,\"g\"],[\"œuf\",1,\"u\"],[\"levure chimique\",5,\"g\"],[\"Emmental\",50,\"g\"]],\"steps\":[\"Mélanger la farine avec le lait, l'œuf, sel et poivre, et la levure chimique.\",\"Une fois que votre préparation est bien homogène, ajouter le fromage râpée.\",\"Découper le Knacki en deux et les planter avec des piques à brochette.\",\"Les essuyer avec de l'essuie tout\",\"Déposer la chapelure dans une assiette plate\",\"Tremper les Knacki dans la pâte à beignet, puis les rouler immédiatement dans la chapelure.\",\"Les déposer dans un bain d'huile et laisser cuire jusqu'à obtenir des tokkebi bien doré.\",\"Déposer sur du papier absorbant et laisser refroidir 2 minutes avant de retirer le pique.\",\"Servir nature ou accompagné de la sauce de votre choix.\"],\"avecViande\":true,\"temperature\":\"les-deux\",\"tags\":[\"Corée\",\"modifié\"],\"source\":\"https://cookpad.com/fr/recettes/17100517?ref=search&search_term=cor%C3%A9enne\",\"notes\":\"\",\"paprikaUid\":\"6D0FFA72-5CA3-4DE4-8393-A80E053CD19B\"},{\"id\":\"toast-aux-asperges-avec-sauce-moutarde-a-l-estragon-mrryzexlxpc\",\"title\":\"Toast aux asperges avec sauce moutarde à l’estragon\",\"category\":\"Plat principal\",\"time\":40,\"servings\":4,\"ingredients\":[[\"asperge blanche\",500,\"g\"],[\"moutarde à gros grains\",1,\"c. à soupe\"],[\"fécule de maïs\",1,\"c. à café\"],[\"demi-crème\",2,\"dl\"],[\"bouquet d’estragon\",0.5,\"u\"],[\"poivre\",0,\"\"],[\"pain toast\",8,\"tranche\"],[\"gousse d’ail\",1,\"u\"]],\"steps\":[\"Éplucher les asperges depuis la pointe et trancher la base.\",\"Dans une grande casserole, porter à ébullition 4 dl d’eau avec un peu d'huile, une tranche de citron et sel.\",\"Y plonger les asperges durant 20-25 min.\",\"Les retirer et les réserver au chaud.\",\"Réduire de moitié l’eau de cuisson des asperges à feu vif.\",\"Mélanger la moutarde, la fécule de maïs et la crème.\",\"Délayer cette préparation dans le liquide de cuisson des asperges.\",\"Faire réduire quelques minutes jusqu’à obtention d’une sauce onctueuse.\",\"Hacher l’estragon et l’ajouter.\",\"Assaisonner de sel et de poivre.\",\"Faire griller le pain de mie.\",\"Partager l’ail en deux et en frotter les tranches de pain.\",\"Couper les asperges en morceaux et les déposer sur les toasts.\",\"Arroser de sauce.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asperges\",\"Saison Printemps\",\"modifié\"],\"source\":\"https://migusto.migros.ch/fr/recettes/toast-aux-asperges-avec-sauce-moutarde-a-l-estragon\",\"notes\":\"\",\"paprikaUid\":\"CA8F3FBC-924D-4D58-AD6E-194E15756920\"},{\"id\":\"tiramisu-a-l-orange-et-au-panettone-mrryzexk4k9\",\"title\":\"Tiramisu à l'orange et au Panettone\",\"category\":\"Dessert\",\"time\":270,\"servings\":6,\"ingredients\":[[\"oranges\",3,\"u\"],[\"sucre glace\",6,\"c. à soupe\"],[\"mascarpone\",250,\"g\"],[\"séré à la crème\",250,\"g\"],[\"lait\",4,\"c. à soupe\"],[\"cacao en poudre\",1,\"c. à soupe\"],[\"panettone\",350,\"g\"],[\"liqueur d'orange\",2,\"c. à soupe\"]],\"steps\":[\"Mélanger le jus d'orange avec la liqueur et le sucre glace.\",\"Mélanger le mascarpone, le séré, le lait et le sucre glace.\",\"Répartir la moitié des tranches de panettone dans le moule.\",\"Arroser avec la moitié du jus.\",\"Poser les oranges dessus.\",\"Répartir la moitié de la masse de mascarpone sur les oranges.\",\"Poser le reste des morceaux de panettone dessus, arroser avec le reste de jus.\",\"Répartir le reste de masse de mascarpone dessus.\",\"Mettre au frais env. 4 heures à couvert.\",\"Saupoudrer le tiramisu de cacao en poudre juste avant de servir.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Italie\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/8355/tiramisu-a-l-orange-et-au-panettone\",\"notes\":\"\",\"paprikaUid\":\"7E885D4D-8E29-4B47-8168-0F74BF070EA2\"},{\"id\":\"tiramisu-au-gingembre-confit-mrryzexjdlc\",\"title\":\"Tiramisu au gingembre confit\",\"category\":\"Dessert\",\"time\":30,\"servings\":4,\"ingredients\":[[\"mascarpone\",160,\"g\"],[\"oeufs\",2,\"u\"],[\"sucre\",150,\"g\"],[\"brut\",30,\"g sucre\"],[\"glace\",20,\"g sucre\"],[\"biscuits cuillère\",6,\"u\"],[\"gingembre confit\",2,\"c. à café\"],[\"sirop tchaï\",4,\"c. à café\"],[\"grains de sésame\",0,\"\"],[\"poudre de cacao\",0,\"\"]],\"steps\":[\"Faire cuire pendant 2 minutes 3dl d'eau avec 150g de sucre et 1 cuillère à café de mélange Tchaï.\",\"Passer ce sirop dans une passoire fine.\",\"Mettre à tremper les biscuits à la cuillère dans le sirop\",\"Battre les jaunes d’œufs avec le sucre brut, le mascarpone et le gingembre confit coupé en petits cubes.\",\"Monter les blancs d’œufs en neige.\",\"Ajouter le sucre glace pour les figer.\",\"Ajouter délicatement les blancs d’œufs à la masse mascarpone.\",\"Tapisser le fond de vos récipients des biscuits imbibés.\",\"Remplir de la masse tiramisu.\",\"Saupoudrer de graines de sésame grillées ou de poudre de cacao.\",\"Mettre au réfrigérateur environ 1 heure.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Italie\",\"modifié\"],\"source\":\"https://www.poivre.ch/recette/tiramisu-au-gingembre-confit/\",\"notes\":\"\",\"paprikaUid\":\"C83320CB-5B64-412E-9C1F-725D887A65ED\"},{\"id\":\"the-glace-au-rooibos-mrryzexjzov\",\"title\":\"Thé glacé au Rooibos\",\"category\":\"Boisson\",\"time\":130,\"servings\":8,\"ingredients\":[[\"glaçons\",0,\"\"],[\"sirop d’agave\",2.5,\"c. à soupe\"],[\"gousse de vanille\",1,\"u\"],[\"infusion de Rooibos\",4,\"sachet\"],[\"lemon grass\",3,\"tige\"],[\"thym\",6,\"brin\"]],\"steps\":[\"Porter l'eau à ébullition avec le sirop d'agave, le lemon grass, le thym, la gousse de vanille et les graines de vanille.\",\"Ajouter les sachets de thé.\",\"Retirer la casserole du feu.\",\"Couvrir et laisser infuser pendant env. 10 min.\",\"Retirer le thym, la gousse de vanille et les sachets de thé.\",\"Laisser refroidir.\",\"Réserver au frais pendant au moins 2h.\",\"Répartir les glaçons dans les verres.\",\"Y verser le thé avec une passoire.\",\"Ajouter le lemon grass et le thym.\",\"Servir.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/25108/the-glace-au-rooibos\",\"notes\":\"\",\"paprikaUid\":\"756AE4E5-91DE-44F0-AAB1-AC832E910978\"},{\"id\":\"the-glace-au-gingembre-mrryzexftzs\",\"title\":\"Thé glacé au gingembre\",\"category\":\"Boisson\",\"time\":20,\"servings\":2,\"ingredients\":[[\"glaçons\",0,\"\"],[\"gingembre\",40,\"g\"],[\"citrons\",1,\"u\"],[\"gousses de vanille\",1,\"u\"],[\"sucre brut gros cristaux\",3,\"c. à soupe\"],[\"thé noir\",3,\"sachet\"]],\"steps\":[\"Porter l'eau à ébullition avec le gingembre et la vanille.\",\"Retirer la casserole du feu.\",\"Ajouter les sachets de thé.\",\"Couvrir et laisser infuser env. 10 min.\",\"Retirer les sachets de thé.\",\"Ajouter du sucre.\",\"Remuer et laisser refroidir.\",\"Mélanger le jus de citron avec le thé.\",\"Verser le tout dans une carafe.\",\"Ajouter des glaçons et servir.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/20836/the-glace-au-gingembre\",\"notes\":\"\",\"paprikaUid\":\"B2D5DA4B-2DEE-4745-819C-66010B2CE02D\"},{\"id\":\"the-glace-mrryzexc04n\",\"title\":\"Thé glacé\",\"category\":\"Boisson\",\"time\":135,\"servings\":4,\"ingredients\":[[\"eau\",1,\"l\"],[\"Earl Grey\",2,\"sachets\"],[\"sucre brut\",2,\"c. à soupe\"],[\"citron\",4,\"u\"],[\"glaçons\",0,\"\"]],\"steps\":[\"Porter l'eau à ébullition dans une casserole.\",\"Éloigner du feu.\",\"Ajouter les sachets de thé et le sucre, laisser infuser env. 5 minutes.\",\"Retirer les sachets.\",\"Ajouter le jus pressé des trois citrons, remuer un instant, laisser refroidir l'infusion, mettre env. 2 h à couvert au frais.\",\"Couper le citron en quartiers, les répartir dans des verres avec les glaçons.\",\"Remplir de thé glacé.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"modifié\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/the-glace-10011489/\",\"notes\":\"\",\"paprikaUid\":\"4B3EE2CB-6921-47BE-B943-3E2FAC9DCCE0\"},{\"id\":\"tarte-salee-au-speck-et-aux-pommes-de-terre-mrryzexbkuc\",\"title\":\"Tarte salée au Speck et aux pommes de terre\",\"category\":\"Plat principal\",\"time\":60,\"servings\":4,\"ingredients\":[[\"pâte feuilletée ronde\",1,\"u\"],[\"pommes de terre\",3,\"u\"],[\"lard\",100,\"g\"],[\"mozzarella\",120,\"g\"],[\"œuf\",2,\"u\"],[\"parmesan\",2,\"c. à soupe\"],[\"romarin\",1,\"brin\"],[\"huile d'olive\",1,\"c. à soupe\"],[\"sel fin\",0,\"\"],[\"poivre noir\",0,\"\"]],\"steps\":[\"Eplucher les pommes de terre et couper en fines tranches d'environ un demi-centimètre d'épaisseur.\",\"Cuire dans de l'eau chaude légèrement salée pendant environ 10 minutes.\",\"Égoutter et assaisonner d'un filet d'huile.\",\"Mélanger et laisser tiédir quelques minutes.\",\"Préchauffer le four à 190°.\",\"Pendant ce temps, couper la mozzarella en dés.\",\"Casser les œufs dans un bol.\",\"Ajoutez le parmesan râpé, une pincée de sel et un peu de poivre.\",\"Ajouter la mozzarella coupée.\",\"Couper le speck en fines lanières et ajouter dans le bol.\",\"Hacher finement le romarin, ajouter au reste des ingrédients et incorporer enfin les pommes de terre.\",\"Mélanger délicatement pour ne pas casser les tranches.\",\"Étaler la pâte feuilletée dans un moule de 24 cm de diamètre, en la laissant sur son papier cuisson.\",\"Verser la préparation à l'intérieur et égaliser la surface.\",\"Replier les bords de la pâte vers l'intérieur et badigeonner d'un filet d'huile.\",\"Faire cuire dans un four pendant environ 40 minutes, jusqu'à ce que la surface soit bien dorée.\",\"Une fois prête, sortir du four et laisser tiédir quelques minutes avant de servir.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Tarte\",\"modifié\"],\"source\":\"https://www.giallozafferano.fr/recettes/tarte-salee-au-speck-et-aux-pommes-de-terre.html\",\"notes\":\"\",\"paprikaUid\":\"B72F957F-900D-4B3B-99C1-7DAB30FC00C6\"},{\"id\":\"tarte-pasqualine-facile-mrryzewu1yf\",\"title\":\"Tarte Pasqualine Facile\",\"category\":\"Plat principal\",\"time\":115,\"servings\":8,\"ingredients\":[[\"pâte feuilletée rond\",2,\"u\"],[\"œuf\",8,\"u\"],[\"blette 1\",\"kg\",\"\"],[\"ricotta\",500,\"g\"],[\"parmesan\",100,\"g\"],[\"noix de muscade\",0,\"\"],[\"huile d'olive\",0,\"\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"jaune d'œufs\",1,\"u\"],[\"Lait entier\",1,\"c. à soupe\"]],\"steps\":[\"Pour préparer la tarte pasqualine facile, commencez par les blettes :\",\"Chauffez un filet d'huile dans une grande poêle antiadhésive.\",\"Ajoutez les blettes et couvrez avec un couvercle.\",\"Faites cuire à feu moyen pendant environ 10-15 minutes, juste le temps de les faire tomber.\",\"Versez les blettes dans une passoire et pressez-les bien pour éliminer l'eau en excès; ainsi la pâte restera croustillante.\",\"Enfin, hachez-les finement au couteau.\",\"Pour la garniture verte :\",\"Transférez les blettes hachées dans un saladier, puis ajoutez la ricotta, le fromage râpé et les œufs.\",\"Assaisonnez avec de la muscade, du sel et du poivre.\",\"Mélangez bien pour obtenir une préparation homogène.\",\"Réservez.\",\"Passez à la garniture blanche :\",\"Dans un autre saladier, versez la ricotta, les œufs et le fromage râpé.\",\"Ajoutez la muscade, le sel et le poivre, puis mélangez le tout.\",\"Vous êtes prêt à assembler la tarte :\",\"Déroulez la pâte feuilletée et placez-la, avec son papier cuisson, dans un moule de 20 cm de diamètre à la base et 24 cm en surface.\",\"Piquez le fond avec une fourchette, puis répartissez uniformément la garniture verte.\",\"Avec le dos d'une cuillère, créez 4 creux, puis versez un œuf entier dans chacun ; pour éviter qu'ils ne se cassent, nous recommandons de casser les œufs dans un bol à part.\",\"Ajoutez maintenant la garniture blanche.\",\"Nivelez délicatement la crème, puis recouvrez avec le deuxième rouleau de pâte feuilletée et retirez l'excédent à l'aide d'une paire de ciseaux.\",\"Scellez les bords en torsadant la pâte sur elle-même.\",\"Dans un petit bol, mélangez le jaune d'œuf avec le lait.\",\"Badigeonnez la surface et les bords de la tarte avec le mélange obtenu.\",\"Faites cuire dans un four statique préchauffé à 200° pendant environ 50 minutes.\",\"Une fois dorée, sortez-la du four et laissez tiédir. Votre tarte pasqualine facile est prête à être servie !\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Tarte\",\"modifié\"],\"source\":\"https://www.giallozafferano.fr/recettes/tarte-pasqualine-facile.html\",\"notes\":\"\",\"paprikaUid\":\"FDD85DEB-4686-4AA6-96E5-D938F792A110\"},{\"id\":\"tarte-aux-oignons-mrryzewubrq\",\"title\":\"Tarte aux oignons\",\"category\":\"Plat principal\",\"time\":80,\"servings\":4,\"ingredients\":[[\"pâte à gâteau\",350,\"g\"],[\"farine\",2,\"c. à soupe\"],[\"oignons\",800,\"g\"],[\"huile d'arachide\",2,\"c. à soupe\"],[\"fromage râpé\",50,\"g\"],[\"thym\",3,\"brins\"],[\"lait\",2.5,\"dl\"],[\"œuf\",2,\"u\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"noix de muscade\",0,\"\"]],\"steps\":[\"Chemiser le moule de papier sulfurisé.\",\"Abaisser la pâte à 3 mm sur un peu de farine et foncer le moule.\",\"Tasser le bord et placer au réfrigérateur.\",\"Couper les oignons en deux puis en tranches de 3 mm d'épaisseur, ou les trancher à la mandoline.\",\"Chauffer l'huile et les faire dorer légèrement à feu moyen.\",\"Saupoudrer du reste de la farine et laisser tiédir.\",\"Préchauffer le four à 180 °C, chaleur de voûte et de sole.\",\"Mélanger le fromage et les oignons puis y effeuiller le thym.\",\"Répartir sur la pâte.\",\"Pour la liaison, battre les œufs dans le lait.\",\"Saler, poivrer et muscader.\",\"Verser sur les oignons.\",\"Glisser la tarte dans la moitié inférieure du four et faire cuire env. 40 min.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Tarte\",\"Suisse\",\"modifié\"],\"source\":\"https://migusto.migros.ch/fr/recettes/tarte-aux-oignons\",\"notes\":\"\",\"paprikaUid\":\"951978D1-1F8F-4BEF-8FD7-BF1942B764A5\"},{\"id\":\"tarte-aux-asperges-mrryzewt2ez\",\"title\":\"Tarte aux asperges\",\"category\":\"Plat principal\",\"time\":45,\"servings\":4,\"ingredients\":[[\"pâte feuilletée rectangulaire\",1,\"u\"],[\"jaune d’œuf\",1,\"u\"],[\"fromage à râpé\",3,\"c. à soupe\"],[\"asperge verte\",700,\"g\"],[\"fromage frais\",250,\"g\"],[\"graines de courge\",4,\"c. à soupe\"],[\"ciboulette ou ail des ours\",2,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"miel\",1,\"c. à soupe\"],[\"huile de colza\",1,\"c. à soupe\"]],\"steps\":[\"Mettre la pâte avec le papier sulfurisé sur la plaque. Entailler un bord d’env. 1 cm de large, mais pas le découper.\",\"Badigeonner le bord de jaune d’œuf et saupoudrer de fromage à râper.\",\"Placer la pâte au froid.\",\"Éplucher le tiers inférieur des asperges et couper 1 à 2 cm du bout.\",\"Mélanger le fromage frais, les graines de courge et la ciboulette finement hachée et assaisonner.\",\"Verser la masse sur la pâte et répatir les asperges dessus.\",\"Mélanger le miel et l’huile et enduire les asperges avec.\",\"Saupoudrer de graines de courge grossièrement hachées et assaisonner.\",\"Faire cuire pendant env. 25 min. sur la glissière inférieure du four préchauffé à 200 °C (chaleur supérieure et inférieure).\",\"Servir avec une salade mélée.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Tarte\",\"Asperges\",\"Saison Printemps\",\"modifié\"],\"source\":\"https://www.gemuese.ch/fr/recettes/tarte-aux-asperges?_gl=1*vndmv2*_up*MQ..&gclid=EAIaIQobChMItdK7sbK4kQMVepKDBx0SyAWNEAAYASABEgL9oPD_BwE&gbraid=0AAAAA-NhTE5iAnPHfalM4KcSHGDur_dvT\",\"notes\":\"\",\"paprikaUid\":\"6270E684-573E-46B0-AFBD-70799F4C2A34\"},{\"id\":\"tangsuyuk-porc-frit-aigre-doux-mrryzewsp3d\",\"title\":\"Tangsuyuk (Porc frit aigre doux)\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"filet de porc\",450,\"g\"],[\"fécule de pomme de terre\",250,\"g\"],[\"eau\",750,\"ml\"],[\"blanc d'œuf\",1,\"u\"],[\"huile neutre\",1,\"l\"],[\"gingembre\",0.5,\"c. à café\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"gousses d’ail\",4,\"u\"],[\"gingembre\",15,\"g\"],[\"jeune oignon\",2,\"tige\"],[\"vinaigre de riz\",4,\"c. à soupe\"],[\"sucre en poudre\",6,\"c. à soupe\"],[\"sel\",2,\"pincée\"],[\"sauce soja light\",2,\"c. à café\"]],\"steps\":[\"Couper finement l'oignon (garder le vert), l'oignon et l'ail.\",\"Mélanger le porc coupé en lanières avec la marinade.\",\"Bien mélanger, couvrir et réfrigérer\",\"Mélanger la fécule de pomme de terre avec l'eau dans un bol en utilisant une cuillère.\",\"Laisser reposer sur le comptoir jusqu'à ce que la fécule se dépose au fond du bol et se solidifie (environ 1h30)\",\"Retirer le porc du frigo et le mélanger avec la fécule de pomme de terre gardée séparée\",\"Se débarrasser de l'eau du bol de fécule qui reposait (en gardant la fécule du fond).\",\"Y ajouter le blanc d'œuf et bien mélanger\",\"Ajouter le mélange de fécule/blanc d’oeuf au porc et mélanger délicatement avec la main\",\"Remplir une casserole profonde ou une friteuse avec l’huile et faire chauffer jusqu’à atteindre 165 degrés celsius\",\"Tester la température en plongeant un morceau de porc dans l'huile ; s'il grésille, l'huile est prête\",\"Déposer les morceaux de porc dans l'huile chaude, en les séparant à l'aide de pinces s'ils collent entre eux.\",\"Frire par lots si nécessaire, jusqu'à ce qu'ils soient croustillants et dorés (environ 5 à 7 minutes)\",\"Transférer les morceaux de porc dans une passoire placée au-dessus d'un bol pour les égoutter\",\"Chauffer de nouveau l'huile et frire le porc une seconde fois, jusqu'à ce qu'il soit très croustillant et bien doré (environ 3 à 4 minutes)\",\"Égoutter et transférer sur une assiette\",\"Sauce:\",\"Dans un bol, mélanger le sucre, la sauce soja light, le sel et le vinaigre de riz jusqu’à ce que le sucre soit presque dissous\",\"Dans un grand wok, chauffer un peu d’huile à feu vif.\",\"Ajouter les jeunes oignons, le gingembre et l’ail et faire sauter 1-2 minutes\",\"Rajouter le mélange de sauce et mélanger jusqu’à ce que la sauce réduise et fasse beaucoup de bulles (presque caramélisée)\",\"Ajouter la viande et faire sauter rapidement pour tout enduire de sauce\",\"Servir immédiatement.\",\"Ajouter quelques oignons verts en fines tranches par dessus\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Corée\",\"Asie\",\"modifié\"],\"source\":\"https://marcwiner.com/tangsuyuk/\",\"notes\":\"\",\"paprikaUid\":\"F67B6552-E4D2-4B20-A565-CE65AB26CD30\"},{\"id\":\"tagliatelles-aux-champignons-a-la-sauge-et-aux-noix-mrryzewrdj3\",\"title\":\"Tagliatelles aux champignons, à la sauge et aux noix\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"cerneaux de noix\",80,\"g\"],[\"chanterelle\",200,\"g\"],[\"sauge\",1,\"bouquet\"],[\"échalote\",1,\"\"],[\"bolet\",200,\"g\"],[\"huile d'olive\",3,\"c. à soupe\"],[\"pecorino\",80,\"g\"],[\"tagliatelle\",500,\"g\"],[\"vin blanc\",0.5,\"dl\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Faire cuire les pâtes al dente dans de l'eau bouillante salée puis les égoutter en récupérant 1½ dl de l'eau de cuisson.\",\"Faire dorer les noix dans une poêle sans ajouter de matière grasse, les sortir et les réserver.\",\"Faire chauffer l'huile dans la même poêle.\",\"Y faire revenir les feuilles de sauge pendant env. 30 sec., les sortir puis les réserver.\",\"Faire cuire les champignons par portions pendant env. 5 min., saler, réserver.\",\"Baisser le feu, ajouter l'échalote, puis laisser mijoter env. 5 min.\",\"Mouiller avec le vin, laisser réduire entièrement.\",\"Ajouter les pâtes, l'eau de cuisson et les champignons et faire chauffer brièvement.\",\"Parsemer de fromage, de noix et de feuilles de sauge.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/18288/tagliatelles-aux-champignons--a-la-sauge-et-aux-noix-\",\"notes\":\"\",\"paprikaUid\":\"94C78A6A-E6B0-40AA-BDC8-3BA536F247A7\"},{\"id\":\"tagliatelle-au-ragout-bolognese-mrryzewqi2k\",\"title\":\"Tagliatelle au ragout bolognese\",\"category\":\"Plat principal\",\"time\":120,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"u\"],[\"gousse d’ail\",1,\"u\"],[\"carotte\",1,\"u\"],[\"céleri branche\",100,\"g\"],[\"persil plat\",0.5,\"bouquet\"],[\"jambon cru en tranches\",50,\"g\"],[\"huile\",0,\"\"],[\"viande hachée\",500,\"g\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"vin rouge\",1,\"dl\"],[\"bouillon de bœuf\",5,\"dl\"],[\"tagliatelle\",500,\"g\"]],\"steps\":[\"Peler l'oignon et l'ail et les hacher finement.\",\"Peler la carotte, la tailler en petits dés avec le céleri-branche.\",\"Ciseler le persil et le jambon cru.\",\"Bien faire chauffer l'huile dans une cocotte.\",\"Saisir la viande hachée env. 5 min par portion.\",\"Retirer, saler, poivrer.\",\"Faire revenir le jambon cru un instant, remettre la viande hachée.\",\"Baisser le feu, ajouter oignon, ail, carotte, céleri-branche et persil, faire revenir env. 5 minutes.\",\"Mouiller avec le vin.\",\"Verser la moitié du bouillon, porter à ébullition.\",\"Baisser le feu, laisser mijoter env. 1½ h à couvert sur feu doux en versant peu à peu le reste du bouillon.\",\"Cuire les pâtes al dente dans l'eau salée bouillante, égoutter, mélanger avec la sauce.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Pâtes\",\"modifié\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/tagliatelle-al-rag-bolognese-10004143/\",\"notes\":\"\",\"paprikaUid\":\"92499DEE-14B9-470D-B533-D34201C623E0\"},{\"id\":\"tagliata-d-agneau-et-risotto-d-automne-mrryzewpctd\",\"title\":\"Tagliata d'agneau et risotto d'automne\",\"category\":\"Plat principal\",\"time\":50,\"servings\":4,\"ingredients\":[[\"chanterelle\",200,\"g\"],[\"raisin noir et blanc sans pépins\",200,\"g\"],[\"huile d'olive\",2,\"c. à soupe\"],[\"huile\",0,\"\"],[\"parmesan\",50,\"g\"],[\"beurre\",3,\"c. à soupe\"],[\"risotto\",200,\"g\"],[\"bouillon de légumes\",7,\"dl\"],[\"filet d'agneau\",4,\"u\"],[\"fond de veau\",1,\"dl\"],[\"vin blanc\",1.5,\"dl\"],[\"feuille de thym\",4,\"c. à soupe\"],[\"feuille de marjolaine\",2,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Faire chauffer l'huile dans une casserole.\",\"Etuver le riz tout en remuant jusqu'à ce qu'il devienne translucide.\",\"Mouiller avec le vin, laisser réduire entièrement.\",\"Verser le bouillon au fur et à mesure de la cuisson, en remuant souvent et en veillant à ce que le riz soit toujours recouvert de liquide.\",\"Laisser mijoter env. 20 min. jusqu'à ce que le riz soit crémeux mais al dente. Incorporer le thym, le fromage et le beurre.\",\"Faire chauffer l'huile dans une poêle.\",\"Y faire sauter les champignons et les raisins pendant env. 5 min., les saler et les poivrer, puis les incorporer au risotto.\",\"Faire chauffer l'huile dans la même poêle.\",\"Y saisir la viande pendant env. 3 min. de chaque côté.\",\"La sortir de la poêle, la saler et la poivrer puis la réserver au chaud.\",\"Déglacer la poêle avec le fond de veau, porter à ébullition.\",\"Retirer la poêle du feu. Incorporer le beurre et les herbes aromatiques, saler et poivrer.\",\"Couper la viande en tranches, dresser avec le risotto et arroser de sauce.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Agneau\",\"Risotto\",\"Saison Automne\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/18516/tagliata-d-agneau-et-risotto-d-automne\",\"notes\":\"\",\"paprikaUid\":\"CDFB8766-E00E-4CDE-A5C6-EB2907DB29D9\"},{\"id\":\"taboule-mrryzewogle\",\"title\":\"Taboulé\",\"category\":\"Salade\",\"time\":80,\"servings\":4,\"ingredients\":[[\"semoule à couscous\",150,\"g\"],[\"jus de citron\",3,\"c. à soupe\"],[\"oignon nouveau\",4,\"u\"],[\"herbes fraîches\",1,\"tasse\"],[\"courgette\",1,\"u\"],[\"tomate\",2,\"u\"],[\"concombre\",1,\"u\"],[\"huile de colza\",4,\"c. à soupe\"],[\"sel\",0,\"\"],[\"feta\",200,\"g\"]],\"steps\":[\"Laisser gonfler la semoule 30 min dans le jus de citron et de l'eau bouillante, à couvert.\",\"Passer au chinois, bien presser.\",\"Couper l'oignon en fines rondelles.\",\"Hacher les herbes.\",\"Râper la courgette.\",\"Couper la feta, les tomates et la concombre en petits dés.\",\"Ajouter les oignons, les herbes, la courgette, les tomates, le concombre et l'huile, assaisonner.\",\"Dresser le taboulé dans une assiette.\",\"Parsemer de fromage frais.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"Salade\",\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/RB_FF2004_09/taboule/\",\"notes\":\"\",\"paprikaUid\":\"777ABC84-734D-4205-B336-A64D8ED6CC5D\"},{\"id\":\"supremes-de-poulet-mrryzewn179\",\"title\":\"Suprêmes de poulet\",\"category\":\"Plat principal\",\"time\":45,\"servings\":4,\"ingredients\":[[\"morille séchée\",20,\"g de\"],[\"échalote\",1,\"u\"],[\"pak-choï\",200,\"g\"],[\"petits radis\",1,\"bouquet\"],[\"oignon nouveau\",3,\"u\"],[\"farine blanche\",0.5,\"c. à soupe\"],[\"beurre\",2.5,\"c. à soupe\"],[\"crème entière\",1.5,\"dl\"],[\"blancs de poulet\",4,\"u\"],[\"vin blanc\",5,\"dl\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Mettre les morilles à tremper pendant env. 5 min., les retirer, bien les laver et les égoutter.\",\"Faire fondre le beurre dans une poêle.\",\"Y faire revenir l'échalote et les morilles pendant env. 2 min, les retirer et les réserver.\",\"Verser le vin dans la poêle, le porter à ébullition et baisser le feu.\",\"Ajouter les blancs de poulet, les laisser frémir pendant env. 10 min. en les retournant de temps à autre.\",\"Les sortir, les couvrir puis les réserver au chaud.\",\"Laisser réduire le liquide jusqu'à ce qu'il ne reste plus qu'env. 2 dl.\",\"Mélanger le beurre et la farine avec une fourchette, les ajouter au liquide tout en remuant.\",\"Ajouter la crème et les morilles réservées et laisser mijoter env. 10 min. jusqu'à ce que la sauce soit légèrement crémeuse.\",\"Saler et poivrer.\",\"Faire fondre le beurre dans une casserole.\",\"Y faire revenir brièvement le pak-choï.\",\"Ajouter les radis, couvrir et laisser mijoter à petit feu pendant env. 3 min.\",\"Ajouter ensuite les oignons botte.\",\"Saler, poivrer et dresser avec le poulet et la sauce aux morilles.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Poulet\",\"Asie\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/14447/supremes-de-poulet\",\"notes\":\"\",\"paprikaUid\":\"70842788-EE30-4C90-8EFA-AF7D258771E9\"},{\"id\":\"stroganov-de-veau-mrryzewm0y0\",\"title\":\"Stroganov de veau\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"oignons\",1,\"u\"],[\"poivron rouge\",1,\"u\"],[\"champignon de Paris\",200,\"g\"],[\"paprika\",1,\"c. à café\"],[\"concombres au vinaigre\",3,\"u\"],[\"farine blanche\",0,\"\"],[\"beurre à rôtir\",0,\"\"],[\"beurre\",1,\"c. à soupe\"],[\"demi-crème acidulée\",180,\"g\"],[\"moutarde douce\",3,\"c. à soupe\"],[\"bouillon de viande\",1.5,\"dl\"],[\"escalope de veau à la minute\",400,\"g\"],[\"vin blanc\",1.5,\"dl\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Préchauffer le four à 60° C pour y chauffer le plat et les assiettes.\",\"Faire chauffer le beurre à rôtir dans une poêle, ajouter la viande par portions, saupoudrer de farine, saisir env. 1 min, sortir, assaisonner, réserver au chaud.\",\"Baisser le feu, enlever la graisse de cuisson avec du papier absorbant.\",\"Faire chauffer le beurre dans la même poêle, faire suer les oignons et le poivron, ajouter les champignons de Paris, faire suer env. 1 min, ajouter le paprika, mélanger.\",\"Verser le vin et le bouillon, porter à ébullition, laisser réduire le liquide de moitié.\",\"Baisser le feu, ajouter la crème et la moutarde, mélanger, ajouter les concombres et la viande, chauffer brièvement, assaisonner.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Veau\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/5121/stroganov-de-veau\",\"notes\":\"\",\"paprikaUid\":\"2A31E682-D4E3-4DCA-B854-E1A79037101B\"},{\"id\":\"strangolapreti-quenelles-aux-epinards-mrryzewl08p\",\"title\":\"Strangolapreti (Quenelles aux épinards)\",\"category\":\"Accompagnement\",\"time\":70,\"servings\":4,\"ingredients\":[[\"épinards en branches surgelés\",250,\"g\"],[\"oignons\",1,\"u\"],[\"gousses d’ail\",2,\"u\"],[\"sauge hachée\",5,\"c. à soupe\"],[\"farine blanche\",50,\"g\"],[\"lait\",2,\"dl\"],[\"beurre\",1,\"c. à soupe\"],[\"œuf\",2,\"u\"],[\"ricotta\",125,\"g\"],[\"pecorino\",150,\"g\"],[\"beurre\",50,\"g\"],[\"pain mi-blanc de la veille\",250,\"g\"],[\"chapelure\",50,\"g\"],[\"noix de muscade\",0.25,\"c. à café\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Mettre le pain dans un récipient, ajouter le lait et laisser tremper env. 15 min.\",\"Faire fondre le beurre dans une casserole.\",\"Y faire revenir l'oignon et l'ail pendant env. 5 min.\",\"Ajouter les épinards, les laisser suer brièvement, assaisonner et laisser tiédir.\",\"Verser les épinards, les œufs et tous les ingrédients jusqu'à la sauge comprise sur le pain, mélanger et travailler le tout à la main en une pâte compacte.\",\"Laisser reposer à couvert pendant env. 15 min.\",\"Avec les mains mouillées, former env. 24 boules.\",\"Faire cuire les boules en plusieurs portions dans de l'eau salée frémissante pendant 8 min, jusqu'à ce qu'elles remontent à la surface.\",\"Les sortir avec une écumoire et les égoutter.\",\"Faire fondre le beurre dans une poêle jusqu'à ce qu'il se mette à mousser et diffuse une légère odeur de noisette, ajouter la sauge et les strangolapreti, remuer et dresser sur des assiettes.\",\"Parsemer de fromage.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/23517/strangolapreti\",\"notes\":\"\",\"paprikaUid\":\"92494BE7-AEA0-402A-BEA3-0D3818DC12CE\"},{\"id\":\"sticky-balls-mrryzewk7mg\",\"title\":\"Sticky balls\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"viande hachée\",600,\"g\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"curry\",2,\"c. à soupe\"],[\"gousse d'ail\",4,\"u\"],[\"oignon\",2,\"u\"],[\"persil plat\",1,\"bouquet\"],[\"piments mi-forts\",2,\"u\"],[\"poireau\",300,\"g\"],[\"margarine\",4,\"c. à soupe\"],[\"sauce soja\",8,\"c. à soupe\"],[\"sirop d’agave\",4,\"c. à soupe\"]],\"steps\":[\"Relever le hachis de sel et de poivre.\",\"Ajouter le curry, puis y presser l'ail.\",\"Hacher les oignons et la moitié du persil, les incorporer.\",\"Former des boulettes de hachis de la taille d'une noix.\",\"Hacher grossièrement les piments.\",\"Couper le poireau en fines lanières.\",\"Saisir les boulettes env. 5 min dans la margarine.\",\"Ajouter le poireau et les piments.\",\"Poursuivre brièvement la cuisson.\",\"Incorporer la sauce soja ainsi que le sirop d'agave et faire mijoter jusqu'à obtention d'une sauce sirupeuse.\",\"Servir avec le reste du persil.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Asie\",\"Wok\",\"modifié\"],\"source\":\"https://migusto.migros.ch/fr/recettes/sticky-balls-vegans\",\"notes\":\"\",\"paprikaUid\":\"9A6E13BE-1901-4B3D-9D46-4F041CC31A16\"},{\"id\":\"stecchini-de-veau-au-vinaigre-balsamique-mrryzewjwl4\",\"title\":\"Stecchini de veau au vinaigre balsamique\",\"category\":\"Plat principal\",\"time\":70,\"servings\":4,\"ingredients\":[[\"asperge verte\",250,\"g\"],[\"vinaigre balsamique\",1,\"c. à soupe\"],[\"beurre à rôtir\",0,\"\"],[\"beurre\",1,\"c. à soupe\"],[\"bouillon de viande\",2,\"dl\"],[\"escalope de veau fine\",8,\"u\"],[\"jambon cru\",8,\"tranche\"],[\"poivre\",0,\"\"],[\"sel\",0,\"\"]],\"steps\":[\"Préchauffer le four à 80 °C pour y chauffer le plat et les assiettes.\",\"Etaler les escalopes, les assaisonner et garnir chacune d’une tranche de jambon cru et de 3 asperges.\",\"Rouler les escalopes et les fixer avec un cure-dents.\",\"Réserver le reste des asperges.\",\"Faire chauffer le beurre à rôtir dans une poêle.\",\"Saisir les stecchini par portions pendant env. 5 min, les sortir et les disposer sur le plat préchauffé.\",\"Enlever la graisse de cuisson avec du papier absorbant.\",\"Mettre les asperges réservées à côté des stecchini et les badigeonner de beurre.\",\"Cuire à basse température: env. 40 min au milieu du four préchauffé.\",\"Les stecchini peuvent ensuite être gardés au chaud à 60 °C jusqu’à 30 min.\",\"Dans la même poêle, porter à ébullition le bouillon et le vinaigre, baisser le feu.\",\"Laisser réduire le liquidede moitié.\",\"Ajouter le beurre par portions en remuant.\",\"Remettre de temps en temps la poêle sur le feu pour chauffer légèrement le jus tout en évitant le point d’ébullition, assaisonner.\",\"Dresser la viande et les asperges sur les assiettes préchauffées et servir avec le jus.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Asperges\",\"Italie\",\"Veau\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/4803/stecchini-de-veau-au-vinaigre-balsamique\",\"notes\":\"\",\"paprikaUid\":\"248EDCF0-0C96-454D-87F5-8135D40446D6\"},{\"id\":\"spatzle-aux-asperges-vertes-mrryzewify9\",\"title\":\"Spätzle aux asperges vertes\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"spätzle frais\",400,\"g\"],[\"asperge verte\",400,\"g\"],[\"tomate cerise\",150,\"g\"],[\"crème entière\",1,\"dl\"],[\"mascarpone\",100,\"g\"],[\"beurre\",0,\"\"],[\"huile d'olive\",0,\"\"],[\"poivre\",0,\"\"],[\"sel\",0,\"\"],[\"estragon\",0,\"\"],[\"piment d'espelette\",0,\"\"],[\"basilic frais\",0,\"\"],[\"ciboulette fraîche\",0,\"\"]],\"steps\":[\"Préparer les asperges et les couper en bouts d'env. 2 cm.\",\"Couper les tomates en deux.\",\"Chauffer le beurre avec l'huile dans une poêle profonde.\",\"Glacer les bouts d'asperges de tous les côtés.\",\"Ajouter les tomates et bien mélanger.\",\"Ajouter les spätzli et bien mélanger.\",\"Assaisonner avec toutes les épices.\",\"Bien mélanger.\",\"Ajouter le mascarpone et la crème.\",\"Bien mélanger.\",\"Couper le basilic et la ciboulette.\",\"Ajouter aux spätzli et bien mélanger.\",\"Servir avec une salade et du parmesan râpé.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Asperges\",\"Pâtes\",\"Saison Printemps\",\"modifié\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"2A81712D-6875-43BB-99E5-AD8854D59B65\"},{\"id\":\"spaghettis-a-l-ail-des-ours-et-burrata-mrryzew7gtg\",\"title\":\"Spaghettis à l’ail des ours et Burrata\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"spaghetti\",350,\"g\"],[\"crème entière\",5,\"dl\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"ail des ours\",100,\"g\"],[\"burrata\",4,\"u\"],[\"citron\",1,\"u\"]],\"steps\":[\"Cuire les spaghettis al dente dans l’eau salée bouillante.\",\"Réserver env. 1 dl d’eau de cuisson.\",\"Egoutter les spaghettis.\",\"Dans la même casserole, porter à ébullition la moitié de la crème avec l’eau de cuisson réservée.\",\"Baisser le feu, laisser bouillonner env. 10 min, saler, poivrer.\",\"Bien laver l’ail des ours, égoutter, effeuiller dans un bol.\",\"Mixer avec le reste de la crème.\",\"Incorporer à la sauce à la crème.\",\"Ajouter les spaghettis et mélanger délicatement.\",\"Dresser les spaghettis.\",\"Répartir les burratas sur les spaghettis.\",\"Râper le zeste du citron par-dessus.\",\"Poivrer.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Saison Printemps\",\"Pâtes\",\"modifié\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/spaghettis-a-lail-des-ours-et-burrata-10009167/\",\"notes\":\"\",\"paprikaUid\":\"1B7D4713-275C-46F0-85B5-665D1FF7596B\"},{\"id\":\"spaghettis-printaniers-mrryzew6lw7\",\"title\":\"Spaghettis printaniers\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"choux-rave\",350,\"g\"],[\"oignon fane\",3,\"u\"],[\"bâtonnet d’amande\",40,\"g\"],[\"beurre\",0,\"\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"crème à sauce\",2,\"dl\"],[\"spaghetti\",400,\"g\"],[\"pousses d’épinards\",100,\"g\"],[\"Sbrinz\",50,\"g\"]],\"steps\":[\"Peler les choux-raves et tailler en petits dés.\",\"Couper les oignons en fines rouelles biseautées, réserver les fanes.\",\"Faire griller les bâtonnets d’amandes à sec dans une casserole et réserver.\",\"Faire fondre le beurre dans la même casserole.\",\"Faire revenir les légumes env. 5 min, saler, poivrer.\",\"Verser la crème à sauce.\",\"Laisser mijoter env. 5 minutes.\",\"Cuire les spaghettis al dente dans l’eau salée bouillante.\",\"Réserver env. 2 dl d’eau de cuisson.\",\"Egoutter les spaghettis par-dessus les épinards.\",\"Ajouter aux légumes les spaghettis et l’eau de cuisson réservée.\",\"Mélanger.\",\"Tailler le Sbrinz en copeaux, en parsemer les spaghettis.\",\"Ajouter les fanes d’oignons réservées et les bâtonnets d’amandes.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Pâtes\",\"modifié\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/spaghettis-printaniers-10006487/\",\"notes\":\"\",\"paprikaUid\":\"957D41A9-1B48-498D-B1AA-3B8BBC631734\"},{\"id\":\"spaghettis-au-curry-et-quenelles-mrryzew5mps\",\"title\":\"Spaghettis au curry et quenelles\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"carotte\",500,\"g\"],[\"spaghetti\",400,\"g\"],[\"curry\",1,\"c. à café\"],[\"crème à sauce\",2,\"dl\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"quenelles de veau de chair à saucisse\",400,\"g\"],[\"persil plat\",0.5,\"botte\"]],\"steps\":[\"Peler les carottes, partager dans la longueur et couper en tranches.\",\"Cuire les spaghettis juste al dente dans l’eau salée bouillante.\",\"Ajouter les carottes et le curry juste avant la fin de cuisson.\",\"Réserver env. 2 dl d’eau de cuisson.\",\"Egoutter les spaghettis avec les carottes.\",\"Porter l’eau de cuisson réservée et la crème à sauce à ébullition dans la même casserole.\",\"Baisser le feu, laisser bouillonner env. 5 minutes.\",\"Remettre les spaghettis et les carottes.\",\"Mélanger et rectifier l’assaisonnement.\",\"Bien faire chauffer l’huile dans une poêle antiadhésive.\",\"Faire revenir les quenelles env. 5 min.\",\"Répartir sur les spaghettis.\",\"Couper grossièrement le persil, parsemer.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Pâtes\",\"modifié\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/spaghettis-au-curry-et-quenelles-10006928/\",\"notes\":\"\",\"paprikaUid\":\"9BD2E6A3-8982-4599-9707-E0CF90EF4FF4\"},{\"id\":\"spaghetti-a-la-creme-et-aux-lardons-au-wok-mrryzew42h0\",\"title\":\"Spaghetti à la crème et aux lardons au Wok\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"spaghetti\",250,\"g\"],[\"gousses d'ail\",2,\"u\"],[\"oignons ou échalote\",1,\"u\"],[\"crème\",1,\"pots\"],[\"huile d'olive\",3,\"c. à soupe\"],[\"lardons ou jambon en dés\",125,\"g\"],[\"poivre cayenne\",0,\"\"],[\"curry\",0,\"\"],[\"herbes de Provence\",0,\"\"],[\"bouillon de légumes\",1,\"cubes\"],[\"parmesan\",0,\"\"],[\"jaune d'oeuf\",2,\"u\"],[\"muscade\",0,\"\"],[\"poivre aux 5 baies\",0,\"\"],[\"tomate cerise\",8,\"u\"],[\"basilic\",0,\"\"]],\"steps\":[\"Faire revenir l'ail râpé ou émincé finement avec l'oignon dans l'huile d'olive.\",\"Laisser légèrement blondir.\",\"Y ajouter les lardons ou le jambon de pays fumé.\",\"Remuer jusqu'à ce qu'ils soient bien dorés.\",\"Ajouter les épices selon votre goût (piment de cayenne, curry, poivre aux cinq baies, herbes de provence ou herbes fraîches).\",\"Mélanger pour bien imprégner les lardons des épices.\",\"Faire cuire les pâtes al dente, une minute de moins que le temps indiqué, dans une grande marmite avec le bouillon de légumes.\",\"Garder une tasse d'eau de cuisson et égoutter les spaghetti.\",\"Ensuite, dans un bol, mélanger les jaunes d'oeuf à la crème et un soupçon de noix de muscade.\",\"Verser la préparation sur les lardons à feu très doux.\",\"Y ajouter les spaghettis et l'eau de cuisson et mélanger 2 à 3 min pour obtenir l'ontuosité désirée.\",\"Il doit rester de la sauce au service !\",\"Servir avec du parmesan et pour décorer quelques petites tomates cerise découpées en quatre et des feuilles de basilic pour la couleur.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Wok\",\"Pâtes\",\"modifié\"],\"source\":\"https://www.marmiton.org/recettes/recette_spaghetti-wok-carbonara_52203.aspx\",\"notes\":\"\",\"paprikaUid\":\"8F5A0B7E-D3BA-43BB-AA4A-113FA58F0987\"},{\"id\":\"spaghetti-facon-salerno-mrryzew39eo\",\"title\":\"Spaghetti façon Salerno\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"persil\",0.5,\"bouquet\"],[\"gousse d’ail\",2,\"u\"],[\"huile d'olive\",4,\"c. à soupe\"],[\"parmesan râpé\",160,\"g\"],[\"œuf\",4,\"u\"],[\"chapelure\",3,\"c. à soupe\"],[\"spaghetti\",500,\"g\"],[\"flocons de chili\",0.5,\"c. à café\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Faire griller la chapelure à sec dans une poêle antiadhésive, la verser dans un bol.\",\"Ajouter le persil et 3 cs de fromage râpé, mélanger.\",\"Faire chauffer l'huile dans la même poêle, ajouter l'ail et les flocons de chili, les faire dorer pendant 4 min, réserver.\",\"Faire cuire les spaghettis al dente dans l'eau salée.\",\"Réserver env. 2 dl d'eau de cuisson, égoutter les spaghettis.\",\"Remettre les spaghettis dans la poêle.\",\"Ajouter l'eau des pâtes avec l'huile à l'ail et le reste de fromage râpé.\",\"Faire chauffer les spaghettis à petit feu en mélangeant, jusqu’à ce que la sauce soit crémeuse.\",\"Faire chauffer l'huile dans la même poêle.\",\"Casser les œufs un par un, les faire glisser dans la poêle et les faire cuire à feu doux pendant 3 min.\",\"Servir les spaghettis avec les œufs au plat, parsemer de frisure, assaisonner.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Pâtes\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/25531/spaghettis-facon-salerno\",\"notes\":\"\",\"paprikaUid\":\"CCF85E5C-0228-47D6-97F2-BA68FE9E3B12\"},{\"id\":\"spaghetti-d-epeautre-pur-au-citron-et-a-la-ricotta-mrryzew28du\",\"title\":\"Spaghetti d'épeautre pur au citron et à la Ricotta\",\"category\":\"Plat principal\",\"time\":20,\"servings\":4,\"ingredients\":[[\"citron\",1,\"u\"],[\"figue séchée\",4,\"\"],[\"ricotta\",250,\"g\"],[\"parmesan râpé\",40,\"g\"],[\"spaghetti\",500,\"g\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Faire cuire les pâtes al dente dans l'eau frémissante salée.\",\"Réserver env. 2 dl d'eau de cuisson, égoutter les spaghettis.\",\"Dans la même casserole, faire réchauffer l'eau de cuisson réservée, la ricotta, le zeste et le jus de citron et le fromage tout en remuant, assaisonner.\",\"Ajouter les figues et les pâtes, mélanger et servir.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Pâtes\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/17372/spaghettis-d-epeautre-pur-au-citron-et-a-la-ricotta\",\"notes\":\"\",\"paprikaUid\":\"2DCF30D6-F924-4750-8CFA-EDF502F27E5E\"},{\"id\":\"spaghetti-cacio-e-pepe-mrryzew1inc\",\"title\":\"Spaghetti \\\"cacio e pepe\\\"\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"pecorino\",200,\"g\"],[\"spaghetti\",350,\"g\"],[\"grain de poivre\",0.5,\"c. à café\"]],\"steps\":[\"Faire cuire les spaghettis al dente dans l'eau salée, réserver env. 2 ½ dl de l'eau de cuisson.\",\"Egoutter les spaghettis.\",\"Ecraser les grains de poivre au mortier ou avec le dos d'un couteau, les faire griller env. 2 min dans une poêle sans matière grasse.\",\"Ajouter les spaghettis et env. 1 dl d'eau de cuisson.\",\"Terminer la cuisson en remuant les spaghettis de temps en temps.\",\"Dans un récipient, mélanger le reste d'eau de cuisson avec le fromage.\",\"Ajouter aux spaghettis et mélanger jusqu'à ce que le fromage soit fondu.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Pâtes\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/17499/spaghettis-cacio-e-pepe\",\"notes\":\"\",\"paprikaUid\":\"37A5039B-147A-41D6-9C43-17F5A074DA8E\"},{\"id\":\"spaghetti-bolognaise-mrryzew1kab\",\"title\":\"Spaghetti bolognaise\",\"category\":\"Plat principal\",\"time\":70,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"u\"],[\"gousse d’ail\",1,\"\"],[\"poireau\",150,\"g\"],[\"carotte\",200,\"g\"],[\"céleri branche\",150,\"g\"],[\"chili rouge\",1,\"u\"],[\"origan\",1,\"c. à soupe\"],[\"huile d'olive\",1,\"c. à soupe\"],[\"farine blanche\",1,\"c. à café\"],[\"spaghetti\",400,\"g\"],[\"concentré de tomates\",2,\"c. à soupe\"],[\"tomate concassée\",1,\"boîte\"],[\"bouillon de viande\",2,\"dl\"],[\"viande hachée\",400,\"g\"],[\"vin rouge\",1,\"dl\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Faire revenir la viande dans l'huile env. 2 min, la saupoudrer de farine puis la sortir.\",\"Faire revenir l'oignon, l'ail, le poireau, la carotte, le céleri et le chili dans la même casserole pendant env. 5 min.\",\"Ajouter la purée de tomates et faire revenir brièvement.\",\"Mouiller avec le vin, laisser réduire entièrement.\",\"Ajouter les tomates, la viande et le bouillon, porter à ébullition puis laisser mijoter pendant env. 30 min.\",\"Avant de servir, ajouter l'origan et assaisonner.\",\"Faire cuire les spaghettis al dente dans de l'eau salée, les égoutter et les servir avec la sauce.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Pâtes\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/16042/spaghetti-bolognaise\",\"notes\":\"\",\"paprikaUid\":\"08D861CA-3572-45F6-B127-2D5C7F045739\"},{\"id\":\"spaghetti-aux-tomates-et-a-la-mozzarella-mrryzew0dhg\",\"title\":\"Spaghetti aux tomates et à la mozzarella\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"u\"],[\"gousse d’ail\",1,\"\"],[\"basilic\",0.25,\"bouquet\"],[\"tomate cerise\",125,\"g\"],[\"basilic\",1,\"brin\"],[\"huile d'olive\",1,\"c. à soupe\"],[\"sucre\",1,\"pincée\"],[\"billes de mozzarella\",150,\"g\"],[\"spaghetti\",500,\"g\"],[\"concentré de tomates\",2,\"c. à soupe\"],[\"tomates cerises pelées\",1,\"boîte\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Faire chauffer l'huile dans une casserole.\",\"Y faire suer l'ail et l'oignon.\",\"Ajouter la purée de tomates et faire revenir brièvement.\",\"Ajouter les tomates et tous les ingrédients jusqu'au poivre compris, laisser mijoter à découvert pendant env. 10 min.\",\"Ajouter le basilic.\",\"Faire cuire les spaghettis al dente dans l'eau salée frémissante.\",\"Réserver 1 dl d'eau de cuisson.\",\"Égoutter les spaghettis, les ajouter à la sauce, verser l'eau de cuisson réservée, mélanger.\",\"Former des nids sur un plat.\",\"Répartir les tomates et la mozzarella sur les spaghettis.\",\"Garnir de basilic.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Pâtes\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/21000/spaghettis-a-la-sauce-tomate-et-a-la-mozzarella\",\"notes\":\"\",\"paprikaUid\":\"EA6CB3A2-5427-4D1B-A93E-EF6E4745EB30\"},{\"id\":\"spaghetti-aux-tomates-mrryzevzbv6\",\"title\":\"Spaghetti aux tomates\",\"category\":\"Plat principal\",\"time\":60,\"servings\":4,\"ingredients\":[[\"spaghetti\",350,\"g\"],[\"huile d’olive\",1,\"c. à soupe\"],[\"oignon\",1,\"u\"],[\"gousse d’ail\",1,\"\"],[\"tomates en dés\",3,\"boîte\"],[\"aubergine\",1,\"u\"],[\"courgette\",1,\"u\"],[\"concentré de tomate\",2,\"c. à soupe\"],[\"bouillon de légumes\",1,\"dl\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Cuire les spaghettis al dente dans l’eau salée, égoutter.\",\"Faire chauffer l’huile dans la même casserole.\",\"Hacher l'oignon et presser l'ail et les aire revenir.\",\"Couper l'aubergine et la courgette en petits dés.\",\"Ajouter les légumes et le concentré de tomate, faire revenir env. 3 minutes.\",\"Mouiller avec le bouillon, laisser mijoter env. 10 min à couvert.\",\"Ajouter les spaghettis, mélanger.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Pâtes\",\"modifié\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/spaghettis-aux-tomates-10004414/\",\"notes\":\"\",\"paprikaUid\":\"3BE96123-9DC1-43DB-8B13-B92E3DF87ABC\"},{\"id\":\"spaghetti-au-vin-rouge-et-aux-pleurotes-du-panicaut-mrryzevymb3\",\"title\":\"Spaghetti au vin rouge et aux pleurotes\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"oignon rouge\",2,\"u\"],[\"gousse d’ail\",1,\"u\"],[\"pleurotes\",300,\"g\"],[\"vinaigre balsamique\",1,\"dl\"],[\"huile d'olive\",2,\"c. à soupe\"],[\"beurre\",1,\"c. à soupe\"],[\"ricotta\",125,\"g\"],[\"miel liquide\",1,\"c. à soupe\"],[\"spaghetti\",300,\"g\"],[\"vin rouge italien\",7.5,\"dl\"],[\"thym\",6,\"brin\"],[\"bouillon de bolets\",3,\"dl\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Faire fondre le beurre dans une grande poêle antiadhésive.\",\"Y faire revenir les oignons, l'ail et le thym pendant env. 5 min.\",\"Mouiller avec le vinaigre et laisser réduire de moitié.\",\"Ajouter le bouillon et le vin, porter à ébullition, baisser le feu, saler.\",\"Plonger les spaghettis dans le bouillon, faire cuire al dente en remuant de temps en temps jusqu'à absorption complète du liquide.\",\"Faire chauffer l'huile dans une poêle antiadhésive.\",\"Baisser le feu et faire cuire les champignons pendant env. 5 min de chaque côté.\",\"Mélanger l'eau et le miel, les ajouter puis laisser réduire complètement tout en remuant, assaisonner.\",\"Dresser les spaghettis dans des assiettes creuses, ajouter la ricotta et les champignons et parsemer de thym.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Pâtes\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/24095/spaghettis-au-vin-rouge-et-aux-pleurotes-du-panicaut\",\"notes\":\"\",\"paprikaUid\":\"09E99B91-AD26-4E86-9DDB-53D1AB9099EC\"},{\"id\":\"spaghetti-au-fromage-de-chevre-mrryzevxp3y\",\"title\":\"Spaghetti au fromage de chèvre\",\"category\":\"Plat principal\",\"time\":40,\"servings\":4,\"ingredients\":[[\"gousse d’ail\",1,\"u\"],[\"nouille\",400,\"g\"],[\"huile d'olive\",3,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"chèvre frais\",200,\"g\"],[\"crème fraîche\",200,\"g\"],[\"fond de légumes\",2.5,\"dl\"],[\"citron\",1,\"c. à soupe\"],[\"sucre\",0,\"\"],[\"épinard jeune\",100,\"g\"]],\"steps\":[\"Spargel waschen, trocken tupfen und die Enden abschneiden.\",\"Die Spargelstangen im unteren Drittel schälen und schräg in Stücke schneiden.\",\"Knoblauch schälen und hacken.\",\"Spaghetti in Salzwasser nach Packungsanweisung garen.\",\"Öl in einer großen Pfanne erhitzen und den Spargel darin anbraten, Deckel auflegen und das Gemüse ca. 8 Min. weiterbraten.\",\"Mit Salz und Pfeffer würzen.\",\"Frischkäse, Crème fraîche und Fond verrühren und zum Spargel geben.\",\"Ca. 3 Min. offen köcheln lassen und mit Salz, Pfeffer, Zitronensaft und Zucker abschmecken.\",\"Den Spinat waschen und trocken schleudern.\",\"Harte Stiele entfernen.\",\"Nudeln abgießen und mit der Sauce und dem Spinat anrichten.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Pâtes\",\"modifié\"],\"source\":\"https://www.kuechengoetter.de/rezepte/spaghetti-mit-spargel-ziegenkaese-sauce-94206\",\"notes\":\"\",\"paprikaUid\":\"D9BC1055-9CA6-4F5E-BBFC-7DC11A4204FC\"},{\"id\":\"spaghetti-au-b-uf-coreen-catelli-mrryzevwcrv\",\"title\":\"Spaghetti au bœuf coréen\",\"category\":\"Plat principal\",\"time\":15,\"servings\":4,\"ingredients\":[[\"spaghetti\",375,\"g\"],[\"pomme\",1,\"u\"],[\"sauce soya\",75,\"ml\"],[\"cassonade\",30,\"ml\"],[\"saké ou xérès\",30,\"ml\"],[\"huile de sésame\",1,\"c. à soupe\"],[\"ail émincé\",1,\"c. à soupe\"],[\"gingembre frais émincé\",1,\"c. à café\"],[\"flocons de piment fort\",1,\"pincée\"],[\"tranche fine de bœuf\",250,\"g\"],[\"oignon\",1,\"u\"],[\"huile végétale\",2,\"c. à soupe\"],[\"têtes de brocoli\",150,\"g\"],[\"chou râpé\",150,\"g\"],[\"carotte\",150,\"g\"],[\"graine de sésame grillées\",0,\"\"],[\"persil plat\",0,\"\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"huile d'olive\",2,\"c. à soupe\"],[\"gousse d'ail\",5,\"u\"],[\"échalote\",50,\"g\"],[\"lentille cuite\",1,\"boîte\"],[\"concentré de tomates\",1.5,\"c. à soupe\"],[\"œuf\",2,\"u\"],[\"basilic frais\",0.5,\"paquet\"],[\"estragon fraîche\",1,\"c. à soupe\"],[\"origan séché\",0.5,\"c. à soupe\"],[\"persil plat\",0.5,\"c. à soupe\"],[\"fromage asiago\",50,\"g\"]],\"steps\":[\"Râper la pomme avec une râpe au-dessus d’un grand bol.\",\"Incorporer la sauce soya, la cassonade, le saké, l’huile de sésame, l’ail, le gingembre et les flocons de piment fort et mélanger jusqu’à homogénéité.\",\"Ajouter le bifteck (coupé en fines lamelles) et l’oignon tranché finement et mélanger.\",\"Laisser mariner pendant au moins 30 minutes ou jusqu’à 1 journée complète.\",\"Faire cuire les spaghetti selon les instructions sur l’emballage.\",\"Entre-temps, réchauffer la moitié de l’huile à feu moyen-vif dans un grand wok ou une grande poêle à frire.\",\"Ajouter le brocoli, le chou et les carottes (tout coupé en fines tranches) et faire revenir jusqu’à ce qu’ils soient tendres, mais encore croquants.\",\"Déposer dans un bol.\",\"Ajouter le reste de l’huile dans le wok.\",\"Utiliser des pinces pour retirer le bœuf et l’oignon de la marinade et les déposer dans le wok (en laissant la marinade dans le bol).\",\"Faire revenir pendant 2 minutes ou jusqu’à ce que le tout commence à dorer.\",\"Ajouter les spaghetti chauds, les légumes sautés et la marinade réservée.\",\"Faire cuire, en mélangeant, pendant 2 à 3 minutes ou jusqu’à ce que le mélange ait la texture d’une sauce et qu’il soit bien chaud.\",\"Garnir de graines de sésame grillées.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Asie\",\"Pâtes\",\"Bœuf\",\"modifié\"],\"source\":\"https://www.catelli.ca/fr/recettes/spaghetti-au-boeuf-coreen/\",\"notes\":\"\",\"paprikaUid\":\"EEE61536-8D77-4BDC-9FCB-6721071B2C83\"},{\"id\":\"spaghetti-alla-chitarra-a-la-sauce-tomate-a-l-agneau-mrryzevv0y3\",\"title\":\"Spaghetti alla chitarra à la sauce tomate à l’agneau\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"spaghetti alle chitarra\",400,\"g\"],[\"sauce tomate\",400,\"g\"],[\"huile d'olive\",4,\"c. à soupe\"],[\"gousse d'ail\",2,\"u\"],[\"oignon\",1,\"u\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"pecorino\",0,\"\"],[\"basilic frais\",4,\"u\"],[\"piment\",1,\"u\"],[\"agneau\",250,\"g\"],[\"laurier\",2,\"u\"],[\"poivron\",2,\"u\"],[\"vin blanc\",5,\"ml\"]],\"steps\":[\"Pelez et émincez l'oignon et l'ail.\",\"Hachez au couteau la viande d'agneau.\",\"Épépinez et coupez en petits dés les poivrons.\",\"Hacher le piment.\",\"Faire chauffer l'huile d'olive dans une sauteuse.\",\"Versez l'oignon, l'ail et la viande et faites dorer le tout.\",\"Arrosez du vin blanc et laissez le s'évaporer.\",\"Ajoutez la sauce tomate, le piment haché et les feuilles de laurier et laisser mijoter pendant 45 minutes.\",\"Pendant ce temps, faites revenir vos poivrons dans un peu d'huile d'olive et les réserver.\",\"Chauffer l'eau pour les pâtes et les cuires selon les instructions du paquet.\",\"A la fin des 45 minutes, incorporer dans la sauce une petite louche d'eau de cuisson des pâtes, les poivrons et laisser mijoter encore un peu.\",\"Juste avant la fin de cuisson des pâtes, retirer les feuilles de laurier.\",\"Ajouter à la sauce 2 à 3 feuilles de basilic et éteindre le feu.\",\"Egouter vos pâtes, les verser dans la sauce et bien mélanger.\",\"Servir avec du pecorino rappé selon goût.\",\"Parsemer avec les poivrons.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Pâtes\",\"Agneau\",\"modifié\"],\"source\":\"https://cuisineitalienne.org/recette/maccheroni-alla-chitarra-a-la-sauce-tomate/\",\"notes\":\"\",\"paprikaUid\":\"EF4C808B-797D-4EE0-8D33-199C950AAFDC\"},{\"id\":\"spaghetti-alla-chitarra-alla-cima-di-rapa-mrryzevujbs\",\"title\":\"Spaghetti alla chitarra alla cima di rapa\",\"category\":\"Plat principal\",\"time\":90,\"servings\":4,\"ingredients\":[[\"cima di rapa ou brocoli\",500,\"g\"],[\"huile d’olive\",0,\"\"],[\"bouillon de légumes\",1,\"dl\"],[\"tomate\",2,\"u\"],[\"piment\",1,\"u\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Ôter les feuilles coriaces de la cima di rapa.\",\"Couper les tiges en tronçons d’env. 2 cm de long, les feuilles en lanières d’env. 1 cm de large, couper évent. en deux les bourgeons fermés.\",\"Faire chauffer l’huile dans un grand faitout.\",\"Faire revenir la cima di rapa.\",\"Verser le bouillon et laisser mijoter env. 8 minutes.\",\"Épépiner les tomates et le piment, tailler en fines lanières.\",\"Incorporer, rectifier l’assaisonnement, réserver à couvert.\",\"Cuire les pâtes al dente dans l’eau salée bouillante.\",\"Egoutter, mélanger avec les légumes et arroser d’un filet d’huile.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Pâtes\",\"modifié\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/spaghetti-alla-chitarra-10004165/\",\"notes\":\"\",\"paprikaUid\":\"F2EBCAAD-BE54-4CCA-9770-4C4CFEBB3C48\"},{\"id\":\"spaghetti-alla-carbonara-a-la-creme-mrryzevtdoo\",\"title\":\"Spaghetti alla carbonara à la crème\",\"category\":\"Plat principal\",\"time\":60,\"servings\":4,\"ingredients\":[[\"spaghetti\",500,\"g\"],[\"oignon\",1,\"u\"],[\"lard à rôtir ou gianciale\",150,\"g\"],[\"crème\",3,\"dl\"],[\"œuf\",4,\"u\"],[\"parmesan\",100,\"g\"],[\"muscade\",0,\"\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Cuire les spaghettis al dente dans l’eau salée frémissante, égoutter.\",\"Peler et hacher finement l’oignon.\",\"Couper le lard en fines lanières et le faire rissoler à sec dans une poêle antiadhésive, retirer.\",\"Baisser le feu, faire revenir l’oignon env. 5 min dans la même poêle.\",\"Ajouter les spaghettis et le lard et bien réchauffer.\",\"Retirer du feu.\",\"Bien mélanger crème, œufs et parmesan râpé.\",\"Assaisonner et verser sur les spaghettis.\",\"Mélanger délicatement avec deux fourchettes, le temps de bien faire chauffer (les œufs ne doivent pas coaguler).\",\"Servir aussitôt.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Pâtes\",\"modifié\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/spaghetti-alla-carbonara-a-la-creme-10001323/\",\"notes\":\"\",\"paprikaUid\":\"DB99FE2E-04C6-4A65-B63A-1AE865B136AB\"},{\"id\":\"spaghetti-alla-carbonara-mrryzevs6bh\",\"title\":\"Spaghetti alla carbonara\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"jaune d'œufs\",4,\"u\"],[\"pecorino\",80,\"g\"],[\"spaghetti\",500,\"g\"],[\"lard à rôtir ou gianviale\",150,\"g\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Faire cuire les spaghettis al dente dans l'eau salée, réserver env. 1 dl de l'eau de cuisson.\",\"Egoutter les pâtes, les couvrir et les réserver.\",\"Couper le lard (ou la pancetta) en lanières.\",\"Faire dorer le lard dans une poêle antiadhésive sans matière grasse puis ajouter les spaghettis.\",\"Mélanger les jaunes d'œufs avec le pecorino et l'eau de cuisson, assaisonner.\",\"Ajouter le tout aux spaghettis et retirer la poêle du feu.\",\"Bien mélanger et servir aussitôt.\",\"Parsemer de pecorino romano.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Pâtes\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/14241/spaghetti-alla-carbonara\",\"notes\":\"\",\"paprikaUid\":\"A4EAA032-E312-44F0-87E8-CDA25CA4110A\"},{\"id\":\"spaghetti-all-assassina-mrryzevscsr\",\"title\":\"Spaghetti all'assassina\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"gousse d’ail\",3,\"u\"],[\"piment rouge\",1,\"u\"],[\"tomate en grappe\",800,\"g\"],[\"basilic\",2,\"brin\"],[\"huile d'olive\",2,\"c. à soupe\"],[\"sucre\",1,\"c. à café\"],[\"parmesan\",50,\"g\"],[\"spaghetti\",300,\"g\"],[\"concentré de tomates\",3,\"c. à soupe\"],[\"sel\",0,\"\"]],\"steps\":[\"Faire chauffer l'huile dans une grande poêle antiadhésive.\",\"Y faire suer brièvement l'ail, le piment et la purée de tomates.\",\"Ajouter les tomates et le sucre, saler.\",\"Laisser mijoter env. 10 min.\",\"Ajouter les spaghettis à la sauce, verser petit à petit l'eau salée tout en remuant et en veillant à ce que les spaghettis soient toujours recouverts de sauce.\",\"Poursuivre jusqu'à ce que les spaghettis soient al dente, saler.\",\"Dresser les spaghettis, les parsemer de fromage et de basilic.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Pâtes\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/23737/spaghettis-all-assassina\",\"notes\":\"\",\"paprikaUid\":\"FD2D55ED-B0A5-4195-840C-5E5EB58C7CF8\"},{\"id\":\"spaghetti-all-amatriciana-mrryzevrozq\",\"title\":\"Spaghetti all'amatriciana\",\"category\":\"Plat principal\",\"time\":25,\"servings\":4,\"ingredients\":[[\"tomate concassée\",2,\"boîte\"],[\"pecorino\",60,\"g\"],[\"spaghetti\",320,\"g\"],[\"lard à rôtir ou guanciale\",120,\"g\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Faire dorer le guanciale lentement dans une grande poêle antiadhésive.\",\"Retirer le guanciale, le réserver. Laisser env. 3 cs d'huile dans la poêle, jeter le reste.\",\"Écraser les tomates entre les doigts, les mettre dans la même poêle, laisser mijoter env. 15 min.\",\"Saler et poivrer.\",\"Faire cuire les spaghettis tout juste al dente dans l'eau salée frémissante.\",\"Les égoutter en réservant env. 1 dl d'eau de cuisson.\",\"Ajouter les spaghettis et l'eau de cuisson réservée à la sauce, poursuivre la cuisson en remuant jusqu'à ce que les pâtes soient al dente.\",\"Incorporer le guanciale réservé et le pecorino juste avant de servir.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Pâtes\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/28652/spaghettis-all-amatriciana\",\"notes\":\"\",\"paprikaUid\":\"2A29B4A2-B79B-41C4-BB77-47DEE9917DD0\"},{\"id\":\"spaghetti-aglio-olio-e-peperoncino-mrryzevqjsr\",\"title\":\"Spaghetti aglio, olio e peperoncino\",\"category\":\"Plat principal\",\"time\":40,\"servings\":4,\"ingredients\":[[\"spaghetti\",500,\"g\"],[\"gousse d’ail\",5,\"u\"],[\"piment rouge\",1,\"u\"],[\"huile d’olive\",4,\"c. à soupe\"],[\"persil plat\",1,\"bouquet\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Cuire les spaghettis al dente dans l'eau salée bouillante, égoutter.\",\"Peler l'ail et le couper en lamelles.\",\"Épépiner le piment et le tailler en rouelles.\",\"Faire chauffer l'huile dans la casserole.\",\"Faire revenir l'ail et le piment jusqu'à ce que l'ail soit doré.\",\"Couper grossièrement le persil, ajouter avec les spaghettis, rectifier l'assaisonnement.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Pâtes\",\"modifié\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/spaghetti-aglio-olio-e-peperoncino-10004162/\",\"notes\":\"\",\"paprikaUid\":\"B564D30F-5C61-4EF5-9B2F-7C135A9288A5\"},{\"id\":\"soupe-a-l-ail-des-ours-mrryzevpabo\",\"title\":\"Soupe à l’ail des ours\",\"category\":\"Soupe\",\"time\":35,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"u\"],[\"pomme de terre farineuse\",500,\"g\"],[\"huile d’olive\",1,\"c. à soupe\"],[\"bouillon de légumes\",9,\"dl\"],[\"ail des ours\",50,\"g\"],[\"crème entière\",2,\"dl\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Peler l'oignon, le hacher grossièrement.\",\"Peler les pommes de terre, les couper en dès d'env. 1½ cm.\",\"Faire chauffer légèrement l'huile dans une casserole.\",\"Faire revenir l'oignon.\",\"Faire revenir les pommes de terre.\",\"Ajouter le bouillon et porter à ébullition.\",\"Baisser le feu et laisser mijoter à couvert pendant 10 minutes.\",\"Retirer env. 4 cuillères de pommes de terre.\",\"Egoutter sur du papier ménage et réserver.\",\"Poursuivre la cuisson du reste des pommes de terre pendant env. 10 min, jusqu'à ce qu'elles soient molles.\",\"Ajouter l'ail des ours.\",\"Mixer la soupe.\",\"Faire chauffer l'huile dans une poêle antiadhésive.\",\"Faire rôtir les pommes de terre réservées env. 10 min jusqu'à ce qu'ils soient bien rissolés.\",\"Battre légèrement la crème.\",\"Couper finement l'ail des ours et l'incorporer.\",\"En incorporer la moitié à la soupe et remuer.\",\"Bien faire réchauffer et servir.\",\"Servir à part le reste de la crème à l'ail des ours.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Saison Printemps\",\"Ail des ours\",\"modifié\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/soupe-a-lail-des-ours-10001238/\",\"notes\":\"\",\"paprikaUid\":\"68D02621-62CC-4B86-B0FF-35244A0E0083\"},{\"id\":\"soupe-a-la-tomate-et-a-la-cannelle-mrryzevovbr\",\"title\":\"Soupe à la tomate et à la cannelle\",\"category\":\"Soupe\",\"time\":20,\"servings\":2,\"ingredients\":[[\"oignon\",1,\"u\"],[\"gousse d’ail\",2,\"\"],[\"tomates pelées\",1,\"boîte\"],[\"huile d'olive\",1,\"c. à soupe\"],[\"sucre\",0.5,\"c. à soupe\"],[\"crème\",50,\"ml\"],[\"pois chiches\",1,\"boîte\"],[\"cannelle\",0.5,\"c. à café\"],[\"sel\",0,\"\"]],\"steps\":[\"Faire chauffer l'huile dans une casserole.\",\"Y faire revenir l'oignon et l'ail pendant 3 min.\",\"Ajouter les tomates, l'eau et le sucre, laisser mijoter env. 10 min.\",\"Ajouter la cannelle et le sel, mixer le tout.\",\"Dresser la soupe, répartir les pois chiches et la crème dessus.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Soupe\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/24277/soupe-a-la-tomate-et-a-la-cannelle\",\"notes\":\"\",\"paprikaUid\":\"4C8E598A-CF04-473A-91D3-15F2BA82E77C\"},{\"id\":\"soupe-a-la-tomate-et-mouillettes-au-fromage-mrryzevnloq\",\"title\":\"Soupe à la tomate et mouillettes au fromage\",\"category\":\"Soupe\",\"time\":20,\"servings\":2,\"ingredients\":[[\"Gruyère\",80,\"g\"],[\"beurre\",2,\"c. à soupe\"],[\"tresse\",4,\"tranche\"],[\"potage à la tomate\",4,\"dl\"]],\"steps\":[\"Répartir le fromage sur la moitié des tranches de tresse.\",\"Recouvrir des tranches restantes et appuyer un peu.\",\"Beurrer les faces extérieures des tranches de tresse.\",\"Les faire revenir dans le gril ou dans une poêle antiadhésive pendant env. 2 ½ min. de chaque côté.\",\"Les couper en bâtonnets d'env. 2 cm de large.\",\"Faire chauffer le potage dans une casserole.\",\"Servir avec les mouillettes au fromage.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Soupe\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/19238/potage-a-la-tomate-et-mouillettes-au-fromage\",\"notes\":\"\",\"paprikaUid\":\"69F2D9CD-C415-4313-A06C-DE05A7EBDDDB\"},{\"id\":\"soupe-a-la-tomate-et-au-gingembre-mrryzevmooh\",\"title\":\"Soupe à la tomate et au gingembre\",\"category\":\"Soupe\",\"time\":30,\"servings\":4,\"ingredients\":[[\"gingembre confit\",1,\"c. à soupe\"],[\"oignon\",1,\"u\"],[\"gousse d’ail\",2,\"\"],[\"tomate en grappe\",1,\"kg\"],[\"gingembre\",30,\"g\"],[\"huile d'olive\",1,\"c. à soupe\"],[\"sucre\",1,\"c. à café de\"],[\"lard à rôtir\",100,\"g\"],[\"vin blanc\",1,\"dl\"],[\"sel\",0,\"\"]],\"steps\":[\"Faire dorer les tranches de lard lentement dans une poêle antiadhésive sans ajouter de matière grasse.\",\"Les sortir, les égoutter sur une feuille de papier absorbant, réserver.\",\"Faire chauffer l'huile dans une casserole.\",\"Y faire revenir l'ail et l'oignon pendant 3 min.\",\"Ajouter les tomates, le gingembre, le sucre et le sel, poursuivre la cuisson pendant 2 min.\",\"Mouiller avec le vin et l'eau, couvrir, faire cuire pendant env. 10 min puis mixer.\",\"Dresser la soupe, parsemer de gingembre confit et poser le lard réservé dessus.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Soupe\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/25659/soupe-a-la-tomate-et-au-gingembre\",\"notes\":\"\",\"paprikaUid\":\"7C9E7930-3DD3-4DCB-A164-BF67BF217485\"},{\"id\":\"soupe-a-la-racin-de-persil-mrryzevlng0\",\"title\":\"Soupe à la racin de persil\",\"category\":\"Soupe\",\"time\":45,\"servings\":4,\"ingredients\":[[\"gousse d’ail\",1,\"\"],[\"beurre à rôtir\",2,\"c. à soupe\"],[\"racine de persil\",450,\"g\"],[\"céleri-rave\",100,\"g\"],[\"vin blanc\",1,\"dl\"],[\"bouillon de légumes\",7,\"dl\"],[\"vermouth\",2,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"crème fraîche\",2,\"c. à soupe\"],[\"persil plat\",2,\"c. à soupe\"]],\"steps\":[\"Couper les racines de persil en morceaux (réserver 50 g en fines rondelles).\",\"Couper le céleri en morceaux.\",\"Faire revenir l’ail finement hâché dans le beurre à rôtir chaud.\",\"Ajouter les racines de persil et le céleri et faire revenir.\",\"Déglacer avec le vin et le bouillon et laisser mijoter pendant env. 20 minutes.\",\"Mixer, ajouter le vermouth, assaisonner et mettre au chaud.\",\"Faire chauffer le beurre à rôtir dans une poêle antiadhésive et faire dorer les rondelles de racine de persil des deux côtés.\",\"Servir la soupe et garnir avec un peu de crème fraîche, de racines de persil rôties et de persil finement haché.\",\"Saupoudrer de poivre.\",\"Servir avec du pain grillé.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Saison Hiver\",\"modifié\"],\"source\":\"https://www.gemuese.ch/fr/recettes/soupe-a-la-racin-de-persil?_gl=1*2jr1c6*_up*MQ..&gclid=EAIaIQobChMItdK7sbK4kQMVepKDBx0SyAWNEAAYASABEgL9oPD_BwE&gbraid=0AAAAA-NhTE5iAnPHfalM4KcSHGDur_dvT\",\"notes\":\"\",\"paprikaUid\":\"81203F5B-133B-408F-B8FA-075EA94EFA9B\"},{\"id\":\"soupe-a-la-choucroute-a-l-autocuiseur-mrryzevlwgq\",\"title\":\"Soupe à la choucroute à la cocotte\",\"category\":\"Soupe\",\"time\":65,\"servings\":8,\"ingredients\":[[\"bacon\",225,\"g\"],[\"oignon\",1,\"u\"],[\"gousse d’ail\",2,\"u\"],[\"huile végétale\",1,\"c. à soupe\"],[\"chou vert\",680,\"g\"],[\"pomme de terre rouge\",680,\"g\"],[\"bouillon de poulet\",2,\"l\"],[\"moutarde à l’ancienne\",2,\"c. à soupe\"],[\"vinaigre de vin blanc\",2,\"c. à soupe\"]],\"steps\":[\"Préchauffer le récipient de l’autocuiseur à la fonction sauté 2 minutes.\",\"Hacher le bacon.\",\"Ciseler l'oignon et l'ail.\",\"Couper le chou et les pommes de terre (non-pelée) en cubes.\",\"Dorer le bacon, l’oignon et l’ail dans l’huile.\",\"Ajouter le reste des ingrédients et mélanger.\",\"Saler et poivrer.\",\"Couvrir et sélectionner la fonction soupe.\",\"Régler le temps de cuisson à 15 minutes.\",\"Dépressuriser l'appareil manuellement.\",\"Retirer le couvercle.\",\"Rectifier l’assaisonnement.\",\"Servir avec une tranche de pain de campagne ou des saucisses grillées et tranchées, si désiré.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Cocotte\",\"modifié\"],\"source\":\"https://www.ricardocuisine.com/recettes/8322-soupe-choucroute-a-l-autocuiseur\",\"notes\":\"\",\"paprikaUid\":\"6390F968-0246-4290-B688-06B2D2855089\"},{\"id\":\"soupe-a-l-orge-des-grisons-mrryzevk37p\",\"title\":\"Soupe à l'orge des Grisons\",\"category\":\"Soupe\",\"time\":90,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"u\"],[\"poireau\",200,\"g\"],[\"carotte\",200,\"g\"],[\"céleri-rave\",150,\"g\"],[\"ciboulette\",3,\"c. à soupe\"],[\"beurre\",1,\"c. à soupe\"],[\"crème entière\",2,\"dl\"],[\"orge perlé\",80,\"g\"],[\"bouillon de viande\",1,\"l\"],[\"viande des Grisons\",50,\"g\"],[\"feuilles de laurier\",1,\"u\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Faire fondre le beurre dans une casserole.\",\"Y faire suer l'oignon, les légumes et la viande des Grisons.\",\"Ajouter l'orge perlé, étuver brièvement le tout.\",\"Ajouter le laurier, mouiller avec le bouillon et porter à ébullition, baisser le feu, couvrir et laisser mijoter à petit feu pendant env. 1 heure.\",\"Assaisonner, ajouter la crème, faire chauffer le potage et décorer de ciboulette.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Saison Autumne\",\"Saison Hiver\",\"Suisse\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/17674/potage-a-l-orge-des-grisons\",\"notes\":\"\",\"paprikaUid\":\"D583F5BD-5009-4768-871C-1DEE0BEC74C6\"},{\"id\":\"soupe-a-l-orge-aux-saucisses-de-vienne-mrryzevjpeu\",\"title\":\"Soupe à l'orge aux saucisses de Vienne\",\"category\":\"Soupe\",\"time\":65,\"servings\":4,\"ingredients\":[[\"poireau\",200,\"g\"],[\"céleri-rave\",150,\"g\"],[\"carotte\",2,\"u\"],[\"ciboulette\",0.5,\"bouquet\"],[\"beurre\",1,\"c. à soupe\"],[\"demi-crème\",1,\"dl\"],[\"orge perlé\",100,\"g\"],[\"bouillon de viande\",1,\"l\"],[\"saucisses de Vienne\",8,\"u\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Emincer finement le poireau, couper en dés le céleri et les carottes.\",\"Faire fondre le beurre dans une casserole.\",\"Y faire revenir les légumes pendant env. 3 min.\",\"Ajouter l’orge et étuver brièvement.\",\"Mouiller avec le bouillon, porter à ébullition puis couvrir et laisser mijoter env. 45 min. à petit feu.\",\"Saler et poivrer.\",\"Ajouter les saucisses de Vienne coupées en biais en rondelles et la demi-crème, faire chauffer brièvement.\",\"Parsemer de ciboulette ciselée au moment de servir.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Saison Automne\",\"Saison Hiver\",\"Suisse\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/10720/potage-a-l-orge-aux-saucisses-de-vienne\",\"notes\":\"\",\"paprikaUid\":\"BCF159C6-F726-4FD7-BB7B-C9C5D6DEDAC4\"},{\"id\":\"soupe-a-l-oignon-mrryzevi7kv\",\"title\":\"Soupe à l'oignon\",\"category\":\"Soupe\",\"time\":55,\"servings\":4,\"ingredients\":[[\"oignon\",800,\"g\"],[\"vinaigre de xérès\",1,\"c. à soupe\"],[\"farine blanche\",1,\"c. à soupe\"],[\"beurre\",40,\"g\"],[\"Gruyère corsé\",150,\"g\"],[\"pain\",8,\"tranche\"],[\"bouillon de poule\",1,\"lt\"],[\"vinblanc\",0.5,\"dl\"],[\"thym\",7,\"brin\"],[\"laurier\",1,\"feuilles\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Faire fondre le beurre dans une casserole.\",\"Y faire suer les oignons pendant env. 20 min en remuant de temps en temps, jusqu'à ce qu'ils soient bruns et fondants.\",\"Ajouter la farine, poursuivre brièvement la cuisson.\",\"Verser le bouillon et le vin dans la casserole, ajouter le thym et le laurier, porter le tout à ébullition.\",\"Couvrir et laisser mijoter à feu moyen env. 20 min.\",\"Ajouter le vinaigre, assaisonner.\",\"Poser les tranches de pain sur une plaque recouverte de papier cuisson, les parsemer de fromage et de thym.\",\"Faire cuire env. 10 min. au milieu du four préchauffé à 220 °C.\",\"Dresser la soupe, poser les tartines à la surface.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Saison Autumne\",\"Saison Hiver\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/20995/soupe-a-l-oignon\",\"notes\":\"\",\"paprikaUid\":\"45D4EBB5-C9CF-4A86-9652-785787730F37\"},{\"id\":\"soupe-vichysoise-creme-de-poireau-et-de-pomme-de-terre-mrryzevhzs4\",\"title\":\"Soupe vichysoise (Crème de poireau et de pomme de terre)\",\"category\":\"Soupe\",\"time\":70,\"servings\":4,\"ingredients\":[[\"blanc de poireaux\",4,\"gros\"],[\"pommes de terre farineuse\",3,\"\"],[\"sel\",0,\"\"],[\"beurre\",0,\"\"],[\"bouillon de légumes\",7,\"dl\"],[\"lait\",1,\"dl\"],[\"laurier\",2,\"feuille\"],[\"crème entière ou de double\",2,\"dl\"],[\"poivre blanc\",0,\"\"],[\"noix de muscade\",0,\"\"],[\"ciboulette\",0.5,\"bouquet\"]],\"steps\":[\"Couper le blanc des poireaux en rondelles.\",\"Peler les pommes de terre et les couper en dés.\",\"Préparer le bouillon.\",\"Ciseler la ciboulette.\",\"Étuver les poireaux dans le beurre avec le sel 20 min à feu doux.\",\"Ajouter les pommes de terre, le bouillon, le lait et le laurier.\",\"Couvrir et laisser mijoter 30 min.\",\"Sortir le laurier et réduire la soupe en purée.\",\"Ajouter la crème ou la double crème.\",\"Rectifier l'assaisonnement à l'aide de sel, de poivre et de muscade.\",\"Pour servir, verser la soupe dans des assiettes creuses et parsemer de ciboulette.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Saison Automne\",\"Saison Hiver\",\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/KB_SP2004_116/vichyssoise-creme-de-poireau-et-de-pomme-de-terre/\",\"notes\":\"\",\"paprikaUid\":\"67B85530-A2DC-469F-A00B-07691FA8CFDF\"},{\"id\":\"soupe-tomates-peches-et-grissini-au-basilic-mrryzevhsng\",\"title\":\"Soupe tomates/pêches et Grissini au basilic\",\"category\":\"Soupe\",\"time\":120,\"servings\":4,\"ingredients\":[[\"grisini\",1,\"paquet\"],[\"basilic frais\",15,\"g\"],[\"sel\",0,\"\"],[\"huile de colza\",1,\"c. à soupe\"],[\"tomates, coupées en dés\",400,\"g\"],[\"pêches\",200,\"g\"],[\"oignon\",1,\"u\"],[\"beurre\",0,\"\"],[\"concentré de tomates\",1,\"c. à soupe\"],[\"bouillon de légumes\",6,\"dl\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"brut\",0.5,\"c. à café sucre\"],[\"basilic pour décorer\",0,\"\"],[\"crème, fouettée\",1,\"dl\"]],\"steps\":[\"Couper le basilic en petits morceaux.\",\"Couper les pêches en morceaux.\",\"Hacher l'oignon.\",\"Mélanger avec le sel et l'huile dans un mortier et travailler jusqu'à la dissolution du sel et la formation d'une pâte.\",\"Faire revenir les tomates, les pêches et l'oignon dans le beurre.\",\"Ajouter le concentré de tomates, étuver, mouiller avec le bouillon.\",\"Ajouter le sel, le poivre et le sucre, couvrir et mijoter 15-20 min.\",\"Selon les goûts, réduire en purée et passer au chinois.\",\"Verser la soupe dans des assiettes ou des tasses.\",\"Servir avec la crème et les Grissini.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM201107_30/soupe-tomates-peches-et-grissini-au-basilic/\",\"notes\":\"\",\"paprikaUid\":\"941BD43C-D31E-4456-AF62-0EAF67D4FFD0\"},{\"id\":\"soupe-piquante-a-la-pasteque-mrryzevgw1j\",\"title\":\"Soupe piquante à la pastèque\",\"category\":\"Soupe\",\"time\":80,\"servings\":10,\"ingredients\":[[\"pastèque\",500,\"g\"],[\"concombre à salade\",220,\"g\"],[\"gousse d'ail\",1,\"u\"],[\"citron\",0.5,\"u\"],[\"jus de tomate\",2,\"dl\"],[\"vinaigre balsamique blanc\",3,\"c. à soupe\"],[\"huile d'olive\",1,\"c. à soupe\"],[\"poivre de Cayenne\",1,\"c. à café\"],[\"sel\",1,\"c. à café\"],[\"poivre\",0,\"\"],[\"tomate cerise\",8,\"u\"],[\"thym\",4,\"brin\"]],\"steps\":[\"Couper la pastèque en morceaux grossiers.\",\"Peler le concombre et le détailler en morceaux, en réserver un peu pour la finition.\",\"Mettre le reste dans un mixeur avec la pastèque et y presser l'ail.\",\"Râper fin le zeste du citron puis exprimer le jus.\",\"Les ajouter tous les deux avec le jus de tomate, le vinaigre balsamique, l'huile, le poivre de Cayenne et le sel.\",\"Réduire le tout en fine purée et réserver au moins 1 h au réfrigérateur.\",\"Rectifier l'assaisonnement avec du poivre.\",\"Partager les tomates cerises en quatre.\",\"Dresser la soupe avec le concombre réservé et les tomates cerises, garnir de thym et servir aussitôt.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Italie\",\"Saison Eté\",\"modifié\"],\"source\":\"https://migusto.migros.ch/fr/recettes/soupe-piquante-a-la-pasteque\",\"notes\":\"\",\"paprikaUid\":\"DB8858D4-AF35-4290-81A9-694A162E704D\"},{\"id\":\"soupe-mousseux-aux-herbes-et-au-vin-mrryzevfehz\",\"title\":\"Soupe mousseux aux herbes et au vin\",\"category\":\"Soupe\",\"time\":40,\"servings\":2,\"ingredients\":[[\"échalote\",1,\"u\"],[\"farine blanche\",1,\"c. à soupe\"],[\"beurre\",20,\"g\"],[\"crème pour sauces\",3,\"c. à soupe\"],[\"bouillon de légumes\",2,\"dl\"],[\"vin blanc\",3,\"dl\"],[\"thym\",3,\"brin\"],[\"romarin\",2,\"brin\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Faire fondre le beurre dans une casserole.\",\"Y faire suer l'échalote.\",\"Ajouter la farine et faire cuire en remuant avec un fouet pendant 1 min.\",\"Mouiller avec le vin et le bouillon.\",\"Porter à ébullition tout en remuant.\",\"Baisser le feu, ajouter les herbes puis laisser mijoter env. 10 min. en remuant de temps en temps.\",\"Incorporer la demi-crème pour sauces.\",\"Faire mousser au mixeur plongeant.\",\"Saler et poivrer.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Saison Automne\",\"Saison Été\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/24708/petit-potage-mousseux-aux-herbes-et-au-vin\",\"notes\":\"\",\"paprikaUid\":\"350DD4DC-9E68-429B-B909-226ECF41C65E\"},{\"id\":\"soupe-glacee-celeri-rave-gratine-mrryzevev4u\",\"title\":\"Soupe glacée céleri-rave gratiné\",\"category\":\"Soupe\",\"time\":60,\"servings\":4,\"ingredients\":[[\"céleri-rave\",550,\"g\"],[\"poire\",2,\"u\"],[\"pomme acidulée\",1,\"u\"],[\"fromage toast\",8,\"tranche\"],[\"lait\",45,\"cl\"],[\"oignon nouveau\",0.25,\"u\"],[\"bouillon de légumes\",0.5,\"cube\"],[\"eau\",60,\"cl\"],[\"huile d’olive\",2,\"c. à soupe\"],[\"fleur de sel\",0,\"\"],[\"poivre\",0,\"\"],[\"thym\",1,\"u branche\"]],\"steps\":[\"Faites suer et blondir l’oignon ciselé dans une casserole avec l’huile d’olive.\",\"Ajoutez le céleri et la moitié des poires, épluchés et coupés en cubes.\",\"Couvrez de lait et cuire environ 30 min couvert à feu doux.\",\"Mixez, ajoutez l'eau et le ½ cube de bouillon de légumes.\",\"Salez et poivrez.\",\"Vérifiez l'assaisonnement.\",\"Laissez la soupe refroidir 1 heure au réfrigérateur.\",\"Chauffez votre four position gril.\",\"Versez la soupe de céleri glacée dans des bols passant au four.\",\"Disposez quelques fines tranches de fromage à la surface.\",\"Glissez les bols sur la plaque de cuisson sur le niveau le plus haut pour faire gratiner le fromage.\",\"Au moment de servir, coupez le reste des poires en fines tranches sans l’éplucher et le vert des oignons.\",\"Ajoutez-les dans la soupe glacée.\",\"Parsemez un peu de thym frais.\",\"Dégustez aussitôt.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Automne\",\"Saison Eté\",\"modifié\"],\"source\":\"https://www.marieclaire.fr/cuisine/soupe-glacee-celeri-poire-et-saint-marcellin-gratine,200429,1146002.asp\",\"notes\":\"\",\"paprikaUid\":\"CEF66969-0108-44E8-8C1F-7AB9F9DF5000\"},{\"id\":\"soupe-glacee-betterave-et-cerises-mrryzeve43t\",\"title\":\"Soupe glacée betterave et cerises\",\"category\":\"Soupe\",\"time\":20,\"servings\":6,\"ingredients\":[[\"betterave cuite\",350,\"g\"],[\"cerise dénoyautée\",250,\"g\"],[\"concombre\",1,\"u\"],[\"oignon nouveau\",3,\"u\"],[\"vinaigre de xérès\",6,\"c. à soupe\"],[\"ricotta\",70,\"g\"],[\"cerfeuil frais\",0,\"\"],[\"sel\",0,\"\"],[\"baies roses\",0,\"\"]],\"steps\":[\"Épluchez les betteraves et coupez-les en petits morceaux.\",\"Faites de même avec le concombre.\",\"Ôtez les radicelles et hachez grossièrement les oignons et leurs tiges vertes.\",\"Mixez dans le bol d’un blender les morceaux de betteraves et de concombre, les oignons hachés, les cerises (réserver quelques-une).\",\"Puis ajoutez 1/2 l d’eau très froide et le vinaigre.\",\"Salez et poivrez selon votre goût.\",\"La consistance doit s’approcher de celle d’un velouté.\",\"Ajoutez un peu d’eau froide si besoin, rectifiez l’assaisonnement.\",\"Réservez 1 h au frais.\",\"Dénoyautez le reste des cerises et coupez-les en deux.\",\"Lorsque la soupe est bien fraîche, dressez dans une grande soupière ou des bols individuels.\",\"Ajoutez les cerises et des quenelles de ricotta.\",\"Versez quelques gouttes de vinaigre de Xérès, parsemez de pluches de cerfeuil et de quelques baies roses.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"modifié\"],\"source\":\"https://www.elle.fr/Elle-a-Table/Recettes-de-cuisine/Soupe-glacee-betterave-et-cerises-4036581\",\"notes\":\"\",\"paprikaUid\":\"C2C29D61-BE33-4ADA-B9BF-D3804FF9FC2F\"},{\"id\":\"soupe-froide-a-l-ail-au-concombre-et-au-yaourt-mrryzevddf3\",\"title\":\"Soupe froide à l’ail, à la concombre et au yaourt\",\"category\":\"Soupe\",\"time\":10,\"servings\":4,\"ingredients\":[[\"concombre\",250,\"g\"],[\"yaourt grecque\",500,\"g\"],[\"gousse d'ail\",2,\"u\"],[\"aneth frais\",0.5,\"bouquet\"],[\"persil frais\",0.5,\"bouquet\"],[\"cerneaux de noix\",30,\"g\"],[\"huile d'olive\",2,\"c. à soupe\"],[\"menthe fraîche\",2,\"branche\"],[\"huile d'olive\",0,\"\"]],\"steps\":[\"Émincez grossièrement le concombre. Réservez 50 g pour le service.\",\"Mixez 200 g de concombre, le yaourt grec, les gousses d’ail, l’aneth et le persil ciselés, les noix, l’huile d’olive, du sel et du poivre, jusqu’à l’obtention d’une texture lisse.\",\"Réservez au frais pendant au moins 2 heures.\",\"Ciselez les feuilles de menthe et mélangez-les avec quelques feuilles de persil et d’aneth.\",\"Servez la soupe bien fraîche, parsemée d’herbes ciselées, de noix concassées et du reste de concombre coupé en très petits dés, le tout assaisonné d’huile d’olive, de sel et de poivre.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Grecque\",\"modifié\"],\"source\":\"https://www.elle.fr/Elle-a-Table/Recettes-de-cuisine/Soupe-froide-a-l-ail-au-concombre-et-au-yaourt-4469755\",\"notes\":\"\",\"paprikaUid\":\"18CD44B8-3A02-44C4-BDA8-4981CC13803B\"},{\"id\":\"soupe-froide-tomate-melon-mrryzevcdae\",\"title\":\"Soupe froide tomate/melon\",\"category\":\"Soupe\",\"time\":80,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"u\"],[\"gousse d’ail\",2,\"u\"],[\"melon charentais\",0.5,\"u\"],[\"tomate\",500,\"g\"],[\"basilic\",1,\"c. à soupe\"],[\"huile d'olive\",2,\"c. à soupe\"],[\"vinaigre de pomme\",2,\"c. à café\"],[\"bouillon de légumes\",2,\"dl\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Faire chauffer l’huile.\",\"Y faire suer l’oignon et l’ail pendant env. 5 min.\",\"Mettre le tout dans un récipient haut et laisser refroidir un peu.\",\"Avec une cuillère parisienne, lever 12 boules dans le melon et les réserver au frais à couvert pour la garniture.\",\"Couper le reste du melon et les tomates en morceaux et ajouter ceux-ci aux oignons.\",\"Ajouter le bouillon.\",\"Mixer le tout.\",\"Tamiser, assaisonner et mettre au frais pendant env. 1 h.\",\"Dresser la soupe, garnir avec les boules de melon et le basilic.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/7106/soupe-froide-tomate-melon\",\"notes\":\"\",\"paprikaUid\":\"FB2E0BDA-2051-4A93-8E13-B46736C3C5E2\"},{\"id\":\"soupe-froide-de-tomates-avec-sorbet-au-basilic-mrryzevbr29\",\"title\":\"Soupe froide de tomates avec sorbet au basilic\",\"category\":\"Soupe\",\"time\":660,\"servings\":4,\"ingredients\":[[\"sucre\",200,\"g\"],[\"eau\",3,\"dl\"],[\"limette\",1,\"u\"],[\"basilic\",1,\"botte\"],[\"prosecco\",1,\"dl\"],[\"œuf\",1,\"u\"],[\"tomate rouge très mûre\",2,\"kg\"],[\"sel\",1,\"c. à soupe\"],[\"basilic\",2,\"branche\"],[\"huile d’olive\",3,\"c. à soupe\"],[\"fleur de sel\",0,\"\"]],\"steps\":[\"SORBET\",\"Porter à ébullition le sucre, l’eau, le zeste et le jus de limette et laisser refroidir.\",\"Ajouter le basilic, réduire finement en purée avec le mixeur et incorporer le prosecco.\",\"Verser la masse dans un moule plat et faire congeler pendant 1½ heure.\",\"Mélanger la masse avec le blanc d’œuf battu et faire congeler pendant env. 6 heures de plus, en mélangeant avec une fourchette toutes les 2 heures.\",\"Ou faire congeler dans la sorbetière en ajoutant le blanc d’œuf battu après quelques minutes.\",\"SOUPE\",\"Couper les tomates en morceaux.\",\"Saler les tomates, mélanger et laisser infuser pendant 1 heure.\",\"Faire passer à travers le disque le plus fin du passe-vite.\",\"Placer la soupe au frais.\",\"Verser la soupe dans un bol refroidi au préalable et ajouter 1 boule de sorbet dans chaque bol.\",\"Garnir avec le basilic, l’huile d’olive et la fleur de sel.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"Italie\",\"modifié\"],\"source\":\"https://www.gemuese.ch/fr/recettes/soupe-de-tomates-froide-avec-sorbet-au-basilic?_gl=1*1tgugan*_up*MQ..&gclid=EAIaIQobChMItdK7sbK4kQMVepKDBx0SyAWNEAAYASABEgL9oPD_BwE&gbraid=0AAAAA-NhTE5iAnPHfalM4KcSHGDur_dvT\",\"notes\":\"\",\"paprikaUid\":\"8702B252-9809-4516-AA41-038101E71645\"},{\"id\":\"soupe-froide-de-pommes-de-terre-et-de-poireaux-mrryzevb6lw\",\"title\":\"Soupe froide de pommes de terre et de poireaux\",\"category\":\"Soupe\",\"time\":95,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"u\"],[\"gousse d’ail\",1,\"u\"],[\"pomme de terre farineuse\",500,\"g\"],[\"poireau\",300,\"g\"],[\"ciboulette\",0.5,\"bouquet\"],[\"citron\",1,\"u\"],[\"graine d'oignon germée\",1,\"2\"],[\"huile d'olive\",1,\"c. à soupe\"],[\"crème\",1,\"dl\"],[\"lait\",1,\"dl\"],[\"bouillon de légumes\",1,\"l\"],[\"curry jaune\",0,\"\"],[\"curcuma\",0,\"\"],[\"tabasco\",0,\"\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"crouton provençale\",0,\"\"]],\"steps\":[\"Faire chauffer l'huile dans une casserole.\",\"Y faire revenir l'oignon et l'ail pendant 2 min.\",\"Ajouter les pommes de terre et le poireau, poursuivre la cuisson pendant 3 min.\",\"Ajouter le bouillon, porter à ébullition.\",\"Baisser le feu, couvrir et laisser mijoter env. 20 min.\",\"Ajouter la crème diluée avec le lait\",\"Mixer la soupe, assaisonner avec sel, poivre, un peu de Tabasco et la passer au tamis.\",\"Laisser refroidir, couvrir et mettre au réfrigérateur pendant env. 1 h.\",\"Ajouter le curry, le curcuma et les graines d'oignon germées.\",\"Ajouter des glaçon et mixer encore une fois.\",\"Dresser la soupe, arroser d'huile d'olive, parsemer de ciboulette et de zeste de citron.\",\"Quelques croutons à l'ail et aux herbes provençales arrondi cette soupe.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"modifié\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"soupe-froide-de-fraises-mrryzevah1v\",\"title\":\"Soupe froide aux fraises\",\"category\":\"Soupe\",\"time\":440,\"servings\":4,\"ingredients\":[[\"fraise\",700,\"g\"],[\"menthe poivrée\",1,\"brin\"],[\"sucre\",3,\"c. à soupe\"],[\"sucre vanillé\",1,\"sachet\"],[\"crème\",1,\"dl\"],[\"yogourt grecque\",100,\"g\"],[\"verveine\",1,\"sachet\"],[\"jus de citron\",2,\"c. à soupe\"],[\"poivre\",0,\"\"]],\"steps\":[\"Mettre le sachet de thé dans la crème.\",\"Couvrir et mettre au réfrigérateur pendant au moins 6 h.\",\"Verser le sucre et l'eau dans une petite casserole, porter à ébullition.\",\"Laisser frémir jusqu'à ce que le sucre soit dissous, laisser refroidir le sirop.\",\"Verser le sirop dans un blender.\",\"Ajouter les fraises et le jus de citron, mixer le tout.\",\"Mettre au frais pendant env. 1 h.\",\"Retirer le sachet de thé de la crème, bien presser.\",\"Fouetter la crème avec le sucre vanillé et le yogourt en chantilly ferme.\",\"Dresser la soupe de fraises avec les fraises et la crème, parsemer de menthe et de poivre.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/26924/soupe-de-fraises\",\"notes\":\"\",\"paprikaUid\":\"5515F3E9-A0A5-4818-87E7-E0504DA18281\"},{\"id\":\"soupe-froide-de-concombre-mrryzev9nxi\",\"title\":\"Soupe froide de concombre\",\"category\":\"Soupe\",\"time\":10,\"servings\":4,\"ingredients\":[[\"concombre\",1,\"u\"],[\"échalote\",1,\"u\"],[\"gousse d'ail\",2,\"u\"],[\"bouillon de légumes\",3.5,\"dl\"],[\"sel\",0,\"\"],[\"poivre rose\",0,\"\"],[\"menthe\",4,\"brin\"],[\"yogourt nature\",180,\"g\"]],\"steps\":[\"Préparer le bouillon et laisser froidir.\",\"Couper la concombre, l'échalote et l'ail en morceaux.\",\"Mettre la concombre, l'échalote/l'oignon, l'ail, le bouillon, le sel, le poivre, la menthe et le yogourt dans un récipient.\",\"Mixer finement.\",\"Rectifier l'assaisonnement selon les goûts.\",\"Verser la soupe dans de petits bocaux.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM200406_66_B/soupe-froide-de-concombre/\",\"notes\":\"\",\"paprikaUid\":\"C6CA9541-C26A-4948-9782-3C794BE4F0E3\"},{\"id\":\"soupe-froide-d-ete-et-toasts-au-fromage-de-chevre-frais-mrryzev881n\",\"title\":\"Soupe froide d'été et toasts au fromage de chèvre frais\",\"category\":\"Soupe\",\"time\":150,\"servings\":4,\"ingredients\":[[\"vinaigre de vin de Xérès\",2,\"c. à soupe\"],[\"concombre\",1,\"u\"],[\"poivron rouge\",2,\"u\"],[\"tomate en grappe\",400,\"g\"],[\"gousse d’ail\",1,\"u\"],[\"germes d'oignon\",20,\"g\"],[\"huile d'olive\",0,\"\"],[\"fromage de chèvre frais\",150,\"g\"],[\"baguette\",150,\"g\"],[\"concentré de tomates\",2,\"c. à soupe\"],[\"tabasco rouge\",0,\"\"],[\"sel\",0,\"\"]],\"steps\":[\"Mixer le concombre et tous les ingrédients jusqu’à l’eau comprise dans un grand bol à bec doseur.\",\"Assaisonner la soupe, couvrir et mettre au frais env. 2 heures.\",\"Dresser la soupe dans des tasses ou des verres mis au frais, arroser avec un filet de vinaigre et d’huile d’olive.\",\"Disposer les tranches de pain sur une plaque chemisée de papier cuisson.\",\"Griller: env. 5 min au milieu du four préchauffé à 220° C.\",\"Répartir le fromage frais sur les tranches de baguette, parsemer de germes.\",\"Servir les toasts de chèvre frais avec la soupe d’été froide.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/7846/soupe-d-ete-froide-et-toasts-au-fromage-de-chevre-frais\",\"notes\":\"\",\"paprikaUid\":\"99D532CD-CD8B-4C72-A69D-15468DD8E18F\"},{\"id\":\"soupe-froide-d-asperges-a-l-aneth-mrryzev7ehi\",\"title\":\"Soupe froide d'asperges à l'aneth\",\"category\":\"Soupe\",\"time\":140,\"servings\":4,\"ingredients\":[[\"petits pois surgelé\",150,\"g\"],[\"asperge verte\",500,\"g\"],[\"huile d'olive\",1,\"c. à soupe\"],[\"pistache salée grillée\",3,\"c. à soupe\"],[\"parmesan\",50,\"g\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"aneth\",1,\"bouquet\"]],\"steps\":[\"Préparer les asperges et réserver les pointes.\",\"Faire chauffer l'huile dans une poêle, ajouter les asperges et les petits pois pendant 2 min.\",\"Ajouter l'eau, porter à ébullition, assaisonner.\",\"Baisser le feu, couvrir et laisser mijoter env. 10 min.\",\"Réserver 3 c. à café de petits pois.\",\"Ajouter le parmesan, mixer la soupe, laisser refroidir, mettre au réfrigérateur pendant au moins 2 h.\",\"Ajouter l'aneth à la soupe, mixer brièvement.\",\"Servir dans des assiettes creuses.\",\"Couper les pointes d'asperges réservées en quatre, les répartir sur la soupe avec les petits pois réservés, l'aneth et les pistaches.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Asperges\",\"Saison Printemps\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/25945/soupe-froide-d-asperges-a-l-aneth\",\"notes\":\"\",\"paprikaUid\":\"160537CE-0CB5-4CEB-BFE1-009BA4892EC7\"},{\"id\":\"soupe-froide-aux-asperges-et-aux-radis-mrryzev6el8\",\"title\":\"Soupe froide aux asperges et aux radis\",\"category\":\"Soupe\",\"time\":155,\"servings\":4,\"ingredients\":[[\"eau\",2,\"dl\"],[\"échalote\",1,\"u\"],[\"gousse d’ail\",2,\"u\"],[\"asperge blanche\",250,\"g\"],[\"petit radis\",3,\"botte\"],[\"huile d'olive\",3.5,\"c. à soupe\"],[\"vinaigre balsamique blanc\",1.5,\"c. à soupe\"],[\"yogourt grecque\",300,\"g\"],[\"pain de mie\",1,\"tranche\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Faire chauffer l'huile dans une casserole.\",\"Y faire revenir brièvement l'échalote et l'ail.\",\"Préparer les asperges et réserver les pointes.\",\"Ajouter les asperges, poursuivre brièvement la cuisson.\",\"Ajouter l'eau, donner un bouillon, assaisonner.\",\"Laisser cuire pendant env. 25 min., jusqu'à ce que les asperges soient tendres.\",\"Ajouter le pain de mie, les radis et le yogourt.\",\"Mixer puis laisser refroidir.\",\"Couvrir et mettre au frais pendant au moins 2 h.\",\"Faire chauffer l'huile dans une poêle.\",\"Y faire revenir les pointes d'asperges réservées pendant env. 5 min.\",\"Les sortir, les mélanger avec les radis coupés en fines tranches, la verdure de radis grossièrement hachée, le vinaigre balsamique et l'huile, assaisonner.\",\"Garnir la soupe de ce topping.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Asperges\",\"Saison Printemps\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/19376/soupe-froide-aux-asperges-et-aux-radis\",\"notes\":\"\",\"paprikaUid\":\"E73DC94E-E2C1-4B00-9F1C-9CF536289135\"},{\"id\":\"soupe-froide-au-celeri-rave-mrryzev5mza\",\"title\":\"Soupe froide au céleri rave\",\"category\":\"Soupe\",\"time\":68,\"servings\":4,\"ingredients\":[[\"céleri-rave\",4,\"u\"],[\"crème fraîche\",1.5,\"dl\"],[\"ail confit\",1,\"u\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"poivre rose\",1,\"c. à soupe\"],[\"vinaigre balsamique blanc\",3,\"c. à soupe\"],[\"sirop d'érable\",3,\"c. à soupe\"],[\"noisette\",150,\"g\"],[\"noisette\",60,\"g beurre\"],[\"cresson\",2,\"bottes\"],[\"huile de colza\",250,\"ml\"],[\"romarin\",1,\"brin\"],[\"ail\",0.5,\"u\"],[\"pignon\",1,\"c. à soupe\"],[\"huile d’olive\",75,\"ml\"]],\"steps\":[\"Pour le jus de céleri :\",\"Passez 3/4 des céleris raves épluchés à l’extracteur à jus.\",\"Dans un mélangeur, pulsez le jus de céleri rave, la crème fraîche et les gousses d’ail confites.\",\"Assaisonnez le liquide et réservez-le au réfrigérateur jusqu’à ce qu’il soit bien froid.\",\"Pour la marinade de céleri rave :\",\"Couper le reste de céleri-rave en deux et réserver la moitié.\",\"À la mandoline, faites de fines tranches de céleri rave.\",\"À l’aide d’un emporte-pièce, coupez des ronds d’un diamètre de 4 cm.\",\"À l’aide d’un petit couteau, faites une incision du centre vers un côté, afin de pouvoir réaliser de petites coupoles.\",\"Dans un contenant, mettez les rondelles de céleri rave, le poivre rose, le vinaigre, le sirop d’érable et le sel.\",\"Laissez mariner le céleri rave au moins 2 heures.\",\"Pour la purée de noisette au beurre noisette :\",\"Préchauffez le four à 175 °C.\",\"Mettez les noisettes sur une plaque et faites-les torréfier au four environ 8 minutes, jusqu’à ce qu’elles soient dorées.\",\"Dans un robot culinaire ou dans un moulin, broyez les noisettes et le beurre jusqu’à obtention d’un beurre de noix lisse.\",\"Ajoutez du sel au goût.\",\"Pour l’huile de cresson :\",\"Dans un mélangeur, broyez le cresson et l’huile à puissance maximale jusqu’à ce que l’huile devienne verte.\",\"Filtrez le liquide au tamis fin avec filtre à café.\",\"Laissez l’huile décanter au froid au moins 2 heures.\",\"Récupérez l’huile verte tout en laissant les sédiments.\",\"Pour les cubes de céleri rave rôtis :\",\"À feu doux, faites cuire les cubes de céleri rave dans le beurre, le romarin et l’ail jusqu’à ce qu’ils soient tendres et dorés.\",\"Rectifiez l’assaisonnement et réservez.\",\"Pour le pesto de fleurs :\",\"Dans un mortier, mettez tous les ingrédients.\",\"Broyez-les au pilon jusqu’à l'obtention d'un pesto lisse et homogène.\",\"Pour le dressage :\",\"Faites 5 points de beurre de noisette au fond de l’assiette.\",\"Ajoutez des coupoles de pickles de céleri rave garnies de pesto de fleurs.\",\"Dispersez une dizaine de cubes de céleri rave dans l’assiette et ajoutez trois bonnes cuillères d’huile de cresson.\",\"Au moment de servir, versez la soupe bien froide au fond du bol afin de faire perler l’huile verte.\",\"Garnissez la soupe de fleurs et servez-la.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"modifié\"],\"source\":\"https://ici.radio-canada.ca/mordu/recettes/9722/soupe-froide-celeri-rave\",\"notes\":\"\",\"paprikaUid\":\"1E338354-E570-4325-90A3-7A114886A9CF\"},{\"id\":\"soupe-froide-au-concombre-et-a-l-avocat-avec-torsades-mrryzev4aa5\",\"title\":\"Soupe froide au concombre et à l'avocat avec torsades\",\"category\":\"Soupe\",\"time\":115,\"servings\":4,\"ingredients\":[[\"avocat\",2,\"u\"],[\"basilic\",1,\"bouquet\"],[\"persil\",1,\"bouquet\"],[\"concombre\",2,\"u\"],[\"ciboulette\",1,\"bouquet\"],[\"citron\",1,\"u\"],[\"yogourt grecque\",600,\"g\"],[\"parmesan\",40,\"g\"],[\"pâte à pizza\",0.5,\"u\"],[\"poivre\",0,\"\"],[\"tapenade rouge\",4,\"c. à soupe\"],[\"sel\",0,\"\"]],\"steps\":[\"Mixer le concombre, l'avocat et les fines herbes jusqu'à obtention d'une masse homogène.\",\"Incorporer le yogourt et le jus de citron, assaisonner.\",\"Couvrir et mettre au frais pendant env. 1 h.\",\"Couper la pâte, d'abord en deux dans le sens de la longueur, puis en bandes d'env. 6 cm de large.\",\"Badigeonner ces dernières de tapenade et les parsemer de parmesan râpé.\",\"Prendre chaque bande par ses extrémités et la torsader délicatement, puis la déposer sur une plaque recouverte de papier cuisson.\",\"Faire cuire 15-20 min. au milieu du four préchauffé à 180 °C.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/13949/soupe-froide-au-concombre-et-a-l-avocat-avec-torsades-facon-pizz\",\"notes\":\"\",\"paprikaUid\":\"40E9D879-93AB-438F-90FE-BAFE8C26965C\"},{\"id\":\"soupe-du-chalet-mrryzev21n2\",\"title\":\"Soupe du chalet\",\"category\":\"Soupe\",\"time\":30,\"servings\":4,\"ingredients\":[[\"échalote\",1,\"u\"],[\"carotte\",100,\"g\"],[\"poireau\",150,\"g\"],[\"pommes de terre ferme\",200,\"g\"],[\"persil\",0.5,\"bouquet\"],[\"h iled'olive\",1,\"c. à soupe\"],[\"crème entière\",2,\"dl\"],[\"cornette moyenne\",100,\"g\"],[\"bouillon de légumes\",1.5,\"l\"]],\"steps\":[\"Peler l'échalote, la hacher menu.\",\"Éplucher la carotte, la couper en fines rondelles, de même que le poireau.\",\"Couper les pommes de terre en dés.\",\"Faire chauffer l'huile dans une casserole.\",\"Y faire suer l'échalote, les carottes, le poireau et les pommes de terre pendant env. 5 min.\",\"Ajouter le bouillon, porter à ébullition.\",\"Baisser le feu, couvrir et laisser mijoter pendant env. 10 min.\",\"Ajouter les cornettes, laisser frémir pendant encore env. 10 min, ajouter la crème, faire chauffer, dresser.\",\"Parsemer le tout de persil haché.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Saison Automne\",\"Saison Hiver\",\"Suisse\",\"modifié\"],\"source\":\"https://little.fooby.ch/fr/recettes/26072/soupe-du-chalet\",\"notes\":\"\",\"paprikaUid\":\"7A1A669B-4C6A-455A-8CB0-6BC9E4DB58E7\"},{\"id\":\"soupe-de-volaille-aux-legumes-mrryzev1jch\",\"title\":\"Soupe de volaille aux légumes\",\"category\":\"Soupe\",\"time\":135,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"u\"],[\"céleri-rave\",200,\"g\"],[\"poireau\",300,\"g\"],[\"carotte\",150,\"g\"],[\"gingembre\",20,\"g\"],[\"persil\",5,\"brin\"],[\"épinard en branches\",200,\"g\"],[\"piment rouge\",1,\"u\"],[\"plat\",1,\"bouquet persil\"],[\"citron\",1,\"u\"],[\"gousse d’ail\",1,\"\"],[\"huile d'olive\",2,\"c. à soupe\"],[\"pâtes\",120,\"g\"],[\"poule à bouillir\",1,\"u\"],[\"laurier\",2,\"feuille\"],[\"grain de poivre\",7,\"graine\"],[\"sel\",2,\"c. à café\"],[\"fleur de sel\",0,\"\"]],\"steps\":[\"Vider la poule à bouillir, rincer l'intérieur et l'extérieur à l'eau froide, la sécher avec de l'essuie-tout puis la mettre dans une grande casserole.\",\"Dans une poêle, faire dorer les deux moitiés d'oignon face coupée vers le bas pendant env. 10 min. à feu moyen.\",\"Mettre les oignons et tous les ingrédients dans la casserole jusqu'au sel compris, recouvrir d'eau froide (env. 4 litres) et faire chauffer lentement jusqu'à ce qu'elle frémisse.\",\"Laisser mijoter pendant env. 1 h 30 sans couvrir, en évitant l'ébullition, retirer l'écume à l'aide d'une écumoire.\",\"Sortir la poule à brouillir du bouillon, laisser refroidir un peu.\",\"Filtrer le bouillon, en verser env. 1½ litre dans une casserole, le laisser cuire à gros bouillons pendant env. 10 min.\",\"Réserver le reste.\",\"Emietter le poulet à la main, le remettre dans le bouillon, ajouter les légumes et les pâtes.\",\"Laisser mijoter env. 10 min. jusqu'à ce que les pâtes soient al dente.\",\"Mélanger le persil, le zeste et le jus de citron, l'huile, l'ail et la fleur de sel.\",\"Dresser le potage dans des assiettes creuses, garnir de gremolata.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Saison Automne\",\"Saison Hiver\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/20894/soupe-de-volaille-aux-legumes\",\"notes\":\"\",\"paprikaUid\":\"94536C00-1FFB-4F17-847B-D4D6502CF84A\"},{\"id\":\"soupe-de-topinambours-au-safran-mrryzev09nm\",\"title\":\"Soupe de topinambours au safran\",\"category\":\"Soupe\",\"time\":50,\"servings\":4,\"ingredients\":[[\"gousse d’ail\",1,\"u\"],[\"poireau\",200,\"g\"],[\"topinambour\",500,\"g\"],[\"huile d'olive\",1,\"c. à soupe\"],[\"yogourt grecque\",150,\"g\"],[\"bouillon de légumes\",2,\"l\"],[\"safran\",1,\"pochette\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"filament de safran\",0,\"\"]],\"steps\":[\"Faire chauffer l'huile dans une poêle.\",\"Y faire suer l'ail et le poireau pendant env. 3 min.\",\"Ajouter les topinambours, poursuivre brièvement la cuisson, puis mouiller avec le bouillon et porter à ébullition.\",\"Ajouter le safran, laisser mijoter la soupe à feu moyen pendant env. 30 min., laisser tiédir, mixer et assaisonner.\",\"Dresser la soupe, répartir le yogourt par-dessus, garnir de safran.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Saison Automne\",\"Saison Hiver\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/17201/soupe-de-topinambours-au-safran\",\"notes\":\"\",\"paprikaUid\":\"17657559-117A-4C63-AC32-F2D0B48EA3E6\"},{\"id\":\"soupe-de-tomates-aux-poireaux-et-a-l-ail-roti-mrryzeuzjn5\",\"title\":\"Soupe de tomates aux poireaux et à l'ail rôti\",\"category\":\"Soupe\",\"time\":60,\"servings\":4,\"ingredients\":[[\"ail\",1,\"u\"],[\"poireau\",150,\"g\"],[\"patate douce\",150,\"g\"],[\"huile d'olive\",1,\"c. à soupe\"],[\"vin blanc\",1,\"dl\"],[\"lait de coco\",2,\"dl\"],[\"bouillon de légumes\",1,\"l\"],[\"tomate concassée\",1,\"boîte\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"curry\",0.5,\"c. à café\"],[\"chili en poudre\",0.5,\"c. à café\"],[\"curcuma\",0.25,\"c. à café\"],[\"cardamome en poudre\",0.25,\"c. à café\"],[\"cresson\",0,\"\"],[\"flocon de chili\",0,\"\"]],\"steps\":[\"Préchauffer le four à 180°.\",\"Couper le tiers supérieur de la tête d'ail et la placer sur une plaque ou dans un plat allant au four, partie coupée vers le haut.\",\"Arroser d'huile et assaisonner.\",\"Faire cuire env. 30 minutes au milieu du four.\",\"Couper le poireau en fines lanières.\",\"Peler les patates et les couper en petits dés.\",\"Faire chauffer l'huile dans une grande casserole.\",\"Y faire suer le poireau 2 à 3 minutes.\",\"Ajouter les patates douces et faire revenir.\",\"Déglacer avec le vin et assaisonner.\",\"Ajouter le bouillon et les tomates et laisser mijoter env. 30 min. à feu doux.\",\"Entre temps, sortir l'ail du four et laisser refroidir un peu.\",\"Evider les gousses avec la pointe d'un couteau et les réserver.\",\"min. avant la fin de la cuisson de la soupe, ajouter l'ail rôti.\",\"Mixer et évt. ajouter du liquide (lait de coco, eau).\",\"Verser dans des bols ou des assiettes creuses.\",\"Arroser de lait de coco, garnir de flocons de chili et de cresson.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Saison Autumne\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/13607/potage-aux-tomates--aux-poireaux-et-a-l-ail-roti\",\"notes\":\"\",\"paprikaUid\":\"C9ACF24C-C592-429E-8A78-00C5793F659F\"},{\"id\":\"soupe-de-tomates-mrryzeuy1l6\",\"title\":\"Soupe de tomates\",\"category\":\"Soupe\",\"time\":50,\"servings\":4,\"ingredients\":[[\"gousse d'ail\",1,\"u\"],[\"oignon\",1,\"u\"],[\"beurre\",2,\"c. à soupe\"],[\"tomate\",600,\"g\"],[\"concentré de tomates\",3,\"c. à soupe\"],[\"miel\",1,\"c. à soupe\"],[\"bouillon de légumes\",3,\"dl\"],[\"crème entière\",2,\"dl\"],[\"origan ou basilic\",1,\"c. à café\"],[\"jus de citron\",0,\"\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"crème entière\",1,\"dl\"],[\"origan ou basilic frais\",0,\"\"]],\"steps\":[\"Hacher l'oignon et l'ail.\",\"Couper les tomates en dés.\",\"Fouetter légèrement la crème.\",\"Ciseler l'origan ou le basilic.\",\"Faire revenir l'ail et l'oignon dans le beurre.\",\"Ajouter les tomates et le concentré de tomates et faire revenir.\",\"Ajouter le sucre ou le miel et le bouillon.\",\"Laisser mijoter 15-20 min.\",\"Réduire en purée fine, év. passer au tamis et reverser le tout dans la casserole.\",\"Ajouter la crème et l'origan ou le basilic.\",\"Porter à ébullition.\",\"Affiner avec le jus de citron et assaisonner.\",\"Servir la soupe dans des assiettes creuses ou des bols chauffés.\",\"Agrémenter de crème, d'origan ou de basilic, de dés de tomates et de poivre.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2018_DIVE_68/soupe-de-tomates/\",\"notes\":\"\",\"paprikaUid\":\"5A94B51B-F297-45FF-972F-A0BD1BCB0F7C\"},{\"id\":\"soupe-de-riz-a-la-tomate-mrryzeuvfrh\",\"title\":\"Soupe de riz à la tomate\",\"category\":\"Italie\",\"time\":40,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"u\"],[\"gousse d’ail\",1,\"\"],[\"courgette\",200,\"g\"],[\"origan\",2,\"brin\"],[\"huile d'olive\",2,\"c. à soupe\"],[\"mozzarella\",150,\"g\"],[\"riz long grain\",80,\"g\"],[\"tomates séchées à l'huile\",60,\"g\"],[\"concentrée de tomates\",2,\"c. à café\"],[\"tomate cerise pelée\",2,\"boîte\"],[\"bouillon de légumes\",5,\"dl\"],[\"vin rouge\",1,\"dl\"],[\"thym\",2,\"brin\"],[\"graine de fenouil\",0.5,\"c. à café\"],[\"sel\",0,\"\"]],\"steps\":[\"Faire chauffer l'huile dans une casserole.\",\"Y faire suer l'ail et l'oignon.\",\"Ajouter le riz et le faire cuire en remuant jusqu'à ce qu'il devienne translucide.\",\"Ajouter les courgettes, les tomates séchées, la purée de tomates, l'origan, le thym et les graines de fenouil, poursuivre la cuisson pendant 2 min.\",\"Mouiller avec le vin, laisser réduire entièrement.\",\"Ajouter les tomates et le bouillon.\",\"Laisser mijoter env. 20 min. en remuant de temps en temps, jusqu'à ce que le riz soit al dente.\",\"Retirer le thym et l'origan, assaisonner la soupe.\",\"Dresser la soupe et la garnir de mozzarella.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/23236/soupe-de-riz-a-la-tomate-\",\"notes\":\"\",\"paprikaUid\":\"BC2FA63E-A50C-406B-B6C9-719A617465CE\"},{\"id\":\"soupe-de-ramen-a-la-courge-mrryzeuq6et\",\"title\":\"Soupe de Ramen à la courge\",\"category\":\"Soupe\",\"time\":45,\"servings\":4,\"ingredients\":[[\"edamame\",80,\"g\"],[\"oignon\",0.5,\"u\"],[\"courge\",200,\"g\"],[\"carotte\",2,\"u\"],[\"poireau\",80,\"g\"],[\"menthe poivrée\",0.5,\"bouquet\"],[\"lait de coco\",5,\"dl\"],[\"nouille ramen\",120,\"g\"],[\"huile de noix de coco\",1,\"c. à soupe\"],[\"bouillon de légumes\",5,\"dl\"],[\"pâte de curry jaune\",1.5,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Éplucher l'oignon et le couper en dés.\",\"Éplucher la courge, la couper en deux,  retirer les graines avec une cuillère, couper la chair en dés.\",\"Mettre la graisse de coco, la pâte de curry, l'oignon et la courge dans une poêle, faire revenir le tout.\",\"Mouiller avec le bouillon et le lait de coco , laisser mijoter à feu moyen pendant env. 25 min. puis mixer.\",\"Éplucher les carottes, couper le poireau en fines lanières.\",\"Ajouter les légumes et les edamames dans la soupe.\",\"Laisser mijoter pendant env. 5 min.\",\"Faire cuire les nouilles dans l'eau frémissante pendant 3 min., puis les égoutter.\",\"Ciseler la menthe.\",\"Mettre les nouilles dans la soupe,  assaisonner la soupe, la dresser dans des bowls,  la parsemer de menthe.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Asie\",\"Saison Autumne\",\"modifié\"],\"source\":\"https://little.fooby.ch/fr/recettes/22164/soupe-de-ramen-a-la-courge\",\"notes\":\"\",\"paprikaUid\":\"0D77614E-19EC-43CE-95EF-123523C092A5\"},{\"id\":\"soupe-de-quenelles-tyroliennes-mrryzeup3b7\",\"title\":\"Soupe de quenelles tyroliennes\",\"category\":\"Soupe\",\"time\":60,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"u\"],[\"lardon\",100,\"g\"],[\"beurre\",1,\"c. à soupe\"],[\"persil\",2,\"c. à soupe\"],[\"petit-pain\",4,\"u\"],[\"farine\",2,\"c. à soupe\"],[\"lait\",1.5,\"dl\"],[\"œuf\",2,\"u\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"poireau\",1,\"u\"],[\"carotte\",100,\"g\"],[\"bouillon de bœuf\",1.2,\"l\"],[\"ciboulette fraîche\",1,\"paquet\"]],\"steps\":[\"Die Zwiebel schälen und fein würfeln.\",\"Den Speck fein würfeln und in der Butter anbraten.\",\"Die Zwiebeln hinzufügen und glasig dünsten.\",\"Die Petersilie dazugeben und kurz mitdünsten.\",\"Dann die Zwiebel-Speck-Mischung etwas abkühlen lassen.\",\"Die Brötchen klein würfeln und mit der Speck-Zwiebel-Mischung und dem Mehl in eine Schüssel geben.\",\"Die Milch erwärmen und mit den Eiern verquirlen.\",\"In die Schüssel geben und etwas salzen.\",\"Die Masse etwas vermengen und 20 Min. ziehen lassen.\",\"Inzwischen für die Suppe den Lauch putzen, in Ringe schneiden, waschen und abtropfen lassen.\",\"Die Möhren schälen und in dünne Scheiben schneiden.\",\"Die Knödelmasse gut durchkneten.\",\"Mit angefeuchteten Händen Knödel daraus formen.\",\"In leicht siedendes Salzwasser geben, einmal aufkochen, die Hitze wieder reduzieren und ca. 20 Min. gar ziehen lassen.\",\"Inzwischen die Brühe erhitzen und das Gemüse darin bei schwacher Hitze ca. 10 Min. garen.\",\"Die Speckknödel noch 5 Min. in der Brühe ziehen lassen, dann auf tiefe Teller setzen.\",\"Die Suppe mit Salz und Pfeffer abschmecken und dazugießen.\",\"Mit Schnittlauch garnieren und servieren.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Saison Autumne\",\"Saison Hiver\",\"modifié\"],\"source\":\"https://www.kuechengoetter.de/rezepte/suedtiroler-speckknoedelsuppe-67947\",\"notes\":\"\",\"paprikaUid\":\"D4B4EFDB-A19B-4355-BB7A-0818F99126D1\"},{\"id\":\"soupe-de-pommes-de-terre-avec-creme-au-paprika-mrryzeuo8if\",\"title\":\"Soupe de pommes de terre avec crème au paprika\",\"category\":\"Soupe\",\"time\":40,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"u\"],[\"pomme de terre farineuse\",300,\"g\"],[\"céleri-rave\",300,\"g\"],[\"persil\",2,\"c. à soupe\"],[\"beurre\",1,\"c. à soupe\"],[\"crème fraîche\",100,\"g\"],[\"bouillon de légumes\",1,\"l\"],[\"persil frisé\",1,\"bouquet\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"paprika doux\",1,\"c. à café\"]],\"steps\":[\"Faire fondre le beurre.\",\"Y faire suer l’oignon, les pommes de terre et le céleri pendant env. 5 min.\",\"Mouiller avec le bouillon et porter à ébullition.\",\"Baisser le feu et laisser mijoter à couvert pendant env. 20 min.\",\"Mixer.\",\"Mélanger la crème fraîche, le paprika et le sel et en napper le potage.\",\"Parsemer de persil ciselé.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Suisse\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/8395/potage-de-pommes-de-terre-avec-creme-au-paprika\",\"notes\":\"\",\"paprikaUid\":\"58DFE779-9BA7-46E8-ACA1-5755A4FA26E2\"},{\"id\":\"soupe-de-melon-a-la-menthe-mrryzeuog9b\",\"title\":\"Soupe de melon à la menthe\",\"category\":\"Soupe\",\"time\":130,\"servings\":4,\"ingredients\":[[\"melon charentais\",1,\"u\"],[\"concombre\",1,\"u\"],[\"menthe\",2,\"brin\"],[\"citron\",0.5,\"u\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"yogourt nature\",250,\"g\"],[\"menthe fraîche\",0,\"\"]],\"steps\":[\"Couper le melon en quatre, enlever les pépins avec une cuiller.\",\"Dégager la pulpe de l'écorce et la tailler en dés.\",\"Peler le concombre.\",\"Partager longitudinalement en deux.\",\"L'épépiner et le couper également en dés.\",\"Mixer le melon, le concombre, la menthe, le jus et le zeste de citron.\",\"Passer à travers un chinois.\",\"Saler et poivrer généreusement.\",\"Entreposer à couvert au frais pendant quelques heures ou durant la nuit.\",\"Pour servir, mélanger la purée de melon avec le yogourt et la transvaser dans des verres ou des bols.\",\"Garnir de perles de melon et de menthe.\",\"Poivrer généreusement et servir immédiatement.\"],\"avecViande\":true,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/KB_SP2004_088/soupe-de-melon-a-la-menthe/\",\"notes\":\"\",\"paprikaUid\":\"461C1A30-4991-4E40-A03C-246338E383E7\"},{\"id\":\"soupe-de-legumes-d-hiver-avec-des-dumplings-aux-herbes-mrryzeundv3\",\"title\":\"Soupe de légumes d'hiver avec des dumplings aux herbes\",\"category\":\"Soupe\",\"time\":30,\"servings\":4,\"ingredients\":[[\"céleri-branche\",2,\"tige\"],[\"carotte\",1,\"u\"],[\"poireau\",1,\"u\"],[\"oignon\",1,\"u\"],[\"gousse d’ail\",2,\"\"],[\"courge\",900,\"g\"],[\"chou kale, prêt à l'emploi\",100,\"g\"],[\"persil\",30,\"g\"],[\"huile d'olive\",3,\"c. à soupe\"],[\"farine blanche\",120,\"g\"],[\"poudre à lever\",1,\"c. à café\"],[\"bouillon de légumes\",1.5,\"l\"],[\"mélange d'herbes italiennes séchées\",2.5,\"c. à café\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"fleur de sel\",0,\"\"]],\"steps\":[\"Dans un saladier, mélanger la farine, la levure chimique, les herbes et le sel.\",\"Ajouter l'eau et l'huile.\",\"Mélanger jusqu'à obtenir une pâte collante.\",\"Couvrir d'un linge de cuisine propre et réserver.\",\"Faire chauffer l'huile dans une grande casserole.\",\"Faire suer l'ail, l'oignon, le céleri, la carotte et le poireau pendant env. 5 min.\",\"Ajouter les dés de courge et les herbes et poursuivre la cuisson pendant env. 5 min.\",\"Mouiller avec le bouillon, assaisonner, porter à ébullition, baisser le feu, couvrir et laisser mijoter 8 min.\",\"Former des quenelles avec la pâte à dumplings à l'aide de deux cuillers à soupe, les ajouter au potage, couvrir et laisser frémir pendant 8 min.\",\"Ajouter le chou kale et le persil, poursuivre brièvement la cuisson.\",\"Dresser le potage et parsemer d'un peu de fleur de sel.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Saison Hiver\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/24474/potage-de-legumes-d-hiver-avec-des-dumplings-aux-herbes\",\"notes\":\"\",\"paprikaUid\":\"4DE742CC-3BEB-4B75-813A-BE41B2969B02\"},{\"id\":\"soupe-de-fenouil-mrryzeumivk\",\"title\":\"Soupe de fenouil\",\"category\":\"Soupe\",\"time\":30,\"servings\":4,\"ingredients\":[[\"fenouil\",400,\"g\"],[\"pomme de terre farineuse\",1,\"kg\"],[\"oignon\",1,\"u\"],[\"beurre\",0,\"\"],[\"vin blanc\",1,\"dl\"],[\"bouillon de légumes\",7,\"dl\"],[\"crème\",1,\"dl\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Parer le fenouil et le couper en fines tranches, réserver les fanes.\",\"Peler les pommes de terre et les couper en dés.\",\"Hacher finement l'oignon.\",\"Faire revenir le fenouil, la pomme de terre et l'oignon dans le beurre.\",\"Mouiller avec le vin et le bouillon.\",\"Laisser mijoter 20-25 min à couvert jusqu'à ce que les légumes soient tendres.\",\"Mixer le tout, ajouter la crème, porter à ébullition.\",\"Rectifier l'assaisonnement.\",\"Dresser et décorer.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Saison Automne\",\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM200501_53_A/soupe-de-fenouil/\",\"notes\":\"\",\"paprikaUid\":\"A5F8941F-860A-484B-B41C-3D4CF30093BF\"},{\"id\":\"soupe-de-celeri-a-la-pomme-mrryzeul88u\",\"title\":\"Soupe de céleri à la pomme\",\"category\":\"Soupe\",\"time\":40,\"servings\":2,\"ingredients\":[[\"échalote\",1,\"u\"],[\"beurre\",0,\"\"],[\"pomme\",100,\"g\"],[\"céleri-rave\",100,\"g\"],[\"bouillon de légumes\",4,\"dl\"],[\"crème entière\",1,\"dl\"],[\"sucre\",2,\"pincée\"],[\"curry en poudre\",0.25,\"c. à café\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"noix de muscade\",0,\"\"],[\"cerneaux de noix\",2,\"c. à soupe\"]],\"steps\":[\"Hacher l'échalote.\",\"Peler la pomme (réserver quelques fines lamelles) et le céleri-rave et les couper en petits dés.\",\"Faire revenir l'échalote dans le beurre écumant.\",\"Ajouter les petits dés de céleri et de pomme.\",\"Poursuivre brièvement la cuisson.\",\"Arroser de bouillon jusqu'à affleurement et poursuivre la cuisson à couvert sur feu modéré jusqu'à ramollissement complet.\",\"Laisser légèrement refroidir.\",\"Mixer.\",\"Remettre dans la casserole et ajouter autant de bouillon que nécessaire pour parvenir à une consistance onctueuse.\",\"Porter au seuil d'ébullition sans laisser bouillir.\",\"Ajouter la crème et assaisonner.\",\"Verser dans des assiettes creuses chaudes.\",\"Garnir de lamelles de pomme et parsemer de cerneaux de noix grossièrement hachés.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Saison Automne\",\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/KB_EFZ1998_187/soupe-de-celeri-a-la-pomme/\",\"notes\":\"\",\"paprikaUid\":\"1753403A-ACA8-48CA-AACE-12987EC022B0\"},{\"id\":\"soupe-de-concombres-froid-mrryzeul1xm\",\"title\":\"Soupe de concombres froid\",\"category\":\"Soupe\",\"time\":130,\"servings\":4,\"ingredients\":[[\"concombre\",2,\"u\"],[\"gousse d’ail\",1,\"u\"],[\"citrons\",0.5,\"u\"],[\"yogourt nature\",500,\"g\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"aneth\",3,\"brin\"]],\"steps\":[\"Couper les concombres en morceaux.\",\"En réserver quelques-uns pour la décoration et mixer le reste avec le yogourt.\",\"Ajouter l’ail écrasé, le zeste et le jus de citron.\",\"Saler, poivrer, ajouter le jus de citron et les deux tiers des pointes d’aneth.\",\"Couvrir et mettre env. 2 h au frais.\",\"Verser le potage dans un grand bocal à conserve.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/7639/soupe-de-concombres-froid\",\"notes\":\"\",\"paprikaUid\":\"5A7CC4B1-5314-46AD-A07C-A771205D4A23\"},{\"id\":\"soupe-de-carotte-froide-recette-swissmilk-mrryzeukldu\",\"title\":\"Soupe de carotte froide\",\"category\":\"Soupe\",\"time\":105,\"servings\":6,\"ingredients\":[[\"carottes\",350,\"g\"],[\"tomate rouge ou jaunes\",350,\"g\"],[\"beurre\",0,\"\"],[\"sel\",0,\"\"],[\"bouillon de poule\",4,\"dl\"],[\"poivre\",0,\"\"],[\"paprika\",0,\"\"],[\"miel\",1,\"c. à café\"],[\"beurre glacé\",5,\"dl\"],[\"persil\",2,\"c. à soupe\"]],\"steps\":[\"Peler les carottes et les râper sur la râpe Bircher.\",\"Monder les tomates et les concasser en petits morceaux.\",\"Etuver au beurre durant 2 minutes les carottes avec le sel.\",\"Ajouter les tomates et poursuivre la cuisson durant 3 minutes.\",\"Arroser de bouillon.\",\"Saler et poivrer, saupoudrer de paprika et affiner avec le miel.\",\"Laisser frémir à couvert durant 30-40 minutes à petit feu.\",\"Laisser refroidir la soupe et la réduire en purée.\",\"Incorporer le beurre glacé et rectifier au besoin l'assaisonnement.\",\"Pour servir, verser la soupe dans des verres ou des bols.\",\"Parsemer de persil.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/KB_SP2004_077/soupe-de-carotte-froide/\",\"notes\":\"\",\"paprikaUid\":\"C7A3E34E-C0CA-4BB4-B0D9-2E078CAFDBBF\"},{\"id\":\"soupe-d-ete-pasteque-et-feta-mrryzeujyh4\",\"title\":\"Soupe d'été pastèque et feta\",\"category\":\"Soupe\",\"time\":10,\"servings\":4,\"ingredients\":[[\"pastèque\",0.5,\"u\"],[\"tomate\",300,\"g\"],[\"menthe fraîche\",1,\"bouquet\"],[\"huile d'olive\",2,\"c. à soupe\"],[\"feta\",100,\"g\"],[\"sel de céleri\",0,\"\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Taillez la pastèque et les tomates en gros dés.\",\"Dans le blender, réunissez les tomates, la pastèque, la menthe, et l’huile d’olive.\",\"Salez et poivrez.\",\"Mixez le tout pendant 2 à 3 minutes.\",\"Passez la soupe à la passoire fine pour en retirer les résidus.\",\"Versez la soupe dans les bols.\",\"Râpez la feta sur la soupe.\",\"Assaisonnez de sel de céleri et d’un filet d’huile d’olive avant de servir.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison d'été\",\"modifié\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"soupe-d-hiver-cremeux-au-curry-mrryzeui1d9\",\"title\":\"Soupe d'hiver crémeux au curry\",\"category\":\"Soupe\",\"time\":840,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"u\"],[\"gousse d’ail\",2,\"\"],[\"courge\",300,\"g\"],[\"chou kale, prêt à l'emploi\",200,\"g\"],[\"huile d'olive\",2,\"c. à soupe\"],[\"lait de coco\",2.5,\"dl\"],[\"haricot blanc sec\",200,\"g\"],[\"pâte de curry rouge\",2,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Mettre les haricots secs dans un récipient et les recouvrir d'eau.\",\"Laisser tremper pendant env. 12 h.\",\"Faire chauffer l'huile dans une sauteuse, y faire suer l'ail et l'oignon.\",\"Egoutter les haricots, les ajouter et les faire revenir brièvement.\",\"Ajouter l'eau, porter le tout à ébullition puis baisser le feu et laisser mijoter à couvert pendant env. 1 h.\",\"Ajouter la courge, le chou kale, le lait de coco et la pâte de curry.\",\"Laisser mijoter à découvert pendant env. 30 min., assaisonner.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Saison Hiver\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/20744/potage-d-hiver-cremeux-au-curry\",\"notes\":\"\",\"paprikaUid\":\"D0F775C5-AD5F-4A0E-94A8-548F30E788B7\"},{\"id\":\"soupe-d-hiver-mrryzeuhzhx\",\"title\":\"Soupe d'hiver\",\"category\":\"Soupe\",\"time\":25,\"servings\":2,\"ingredients\":[[\"pomme de terre ferme\",200,\"g\"],[\"chou frisé\",200,\"g\"],[\"huile d'olive\",1,\"c. à soupe\"],[\"Sbrinz\",30,\"g\"],[\"haricot blanc\",1,\"boîte\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Faire chauffer l'huile dans une casserole.\",\"Y faire revenir les pommes de terre env. 3 min.\",\"Ajouter le chou frisé, mouiller avec l'eau, saler et poivrer.\",\"Porter à ébullition puis baisser le feu et laisser mijoter env. 10 min.\",\"Ajouter les haricots blancs et poursuivre la cuisson env. 3 min.\",\"Garnir le potage de copeaux de Sbrinz.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Saison Hiver\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/14382/potage-d-hiver\",\"notes\":\"\",\"paprikaUid\":\"C64E7D6A-A1C2-4FC4-9A92-C0A2534A9F65\"},{\"id\":\"soupe-d-automne-a-l-orge-mrryzeugf8n\",\"title\":\"Soupe d'automne à l'orge\",\"category\":\"Soupe\",\"time\":95,\"servings\":4,\"ingredients\":[[\"bolet séché\",30,\"g\"],[\"oignon rouge\",1,\"u\"],[\"champignon de Paris\",200,\"g\"],[\"carotte\",200,\"g\"],[\"panais\",200,\"g\"],[\"épinard en branche\",200,\"g\"],[\"beurre\",1,\"c. à soupe\"],[\"crème pour sauces\",2,\"dl\"],[\"orge perlé\",80,\"g\"],[\"bouillon de légumes\",7,\"dl\"],[\"laurier\",1,\"feuille\"],[\"jus de citron\",1,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Metter les bolets dans un saladier.\",\"Verser l'eau frémissante par-dessus et tremper les bolets pendant env. 15 min.\",\"Égoutter les bolets et récupérer l'eau.\",\"Faire fondre le beurre dans une casserole.\",\"Y faire suer l'oignon. Mettre les champignons, les carottes et les panais dans la casserole, poursuivre la cuisson pendant env. 5 min.\",\"Ajouter l'orge perlé, étuver brièvement le tout.\",\"Ajouter la feuille de laurier, le bouillon, les bolets et l'eau des bolets réservée, porter à ébullition.\",\"Réduire le feu, couvrir et laisser mijoter à petit feu pendant env. 45 min.\",\"Ajouter les épinards et la demi-crème pour sauces, laisser mijoter pendant encore 15 min. env.\",\"Ajouter le jus de citron et assaisonner.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Saison Automne\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/21842/potage-d-automne-a-l-orge\",\"notes\":\"\",\"paprikaUid\":\"193BFA6A-C42D-48E3-A1B5-099F1EADD69B\"},{\"id\":\"soupe-d-asperges-et-de-pommes-de-terre-a-la-pomme-mrryzeuf3f1\",\"title\":\"Soupe d'asperges et de pommes de terre à la pomme\",\"category\":\"Soupe\",\"time\":25,\"servings\":4,\"ingredients\":[[\"asperge blanche\",250,\"g\"],[\"pomme\",150,\"g\"],[\"pomme de terre\",250,\"g\"],[\"beurre\",0,\"\"],[\"bouillon de légumes\",1,\"l\"],[\"demi-crème\",1,\"dl\"],[\"crème\",1,\"dl\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"cerfeuil\",0,\"\"]],\"steps\":[\"Préparer les asperges et les couper en morceaux.\",\"Peler les pommes et les pommes de terre et les couper en dés.\",\"Préparer le bouillon.\",\"Faire revenir les asperges, la pomme et les pommes de terre dans le beurre.\",\"Déglacer avec le bouillon et laisser mijoter 15-20 min.\",\"Passer au mixeur.\",\"Incorporer la crème.\",\"Porter à ébullition.\",\"Assaisonner.\",\"Préparer la crème fouettée.\",\"Répartir la soupe dans des bols chauds.\",\"Décorer avec la crème et des feuilles de cerfeuil.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Asperges\",\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM200405_08/soupe-dasperges-et-de-pommes-de-terre-a-la-pomme/\",\"notes\":\"\",\"paprikaUid\":\"A1E07136-E3B3-442F-8EA7-511766FF3BC7\"},{\"id\":\"soupe-courge-orange-aux-graines-et-aux-noix-epicees-mrryzeueen3\",\"title\":\"Soupe courge/orange aux graines et aux noix épicées\",\"category\":\"Soupe\",\"time\":45,\"servings\":4,\"ingredients\":[[\"mélange de graines et de noix\",30,\"g\"],[\"échalote\",1,\"u\"],[\"courge\",800,\"g\"],[\"orange blonde\",1,\"u\"],[\"sucre\",0.5,\"c. à café\"],[\"beurre\",1,\"c. à soupe\"],[\"bouillon de légumes\",6,\"dl\"],[\"cannelle\",0.25,\"c. à café\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Dans une casserole, mélanger le sucre et tous les ingrédients jusqu’au mélange de graines et de noix compris.\",\"Porter à ébullition en remuant, baisser le feu et laisser frémir pendant env. 5 minutes en donnant un mouvement de va-et-vient à la casserole jusqu’à ce que les graines et les noix prennent une jolie couleur noisette.\",\"Répartir celles-ci sur du papier sulfurisé et les laisser refroidir.\",\"Faire fondre le beurre dans une poêle et y étuver l’échalote et la courge pendant env. 5 min.\",\"Mouiller avec le bouillon, porter à ébullition, baisser le feu puis laisser mijoter à couvert pendant env. 20 minutes\",\"Mixer le potage et rectifier l’assaisonnement.\",\"Peler l’orange à vif et détacher les suprêmes à l’aide d’un couteau bien aiguisé.\",\"Presser le jus (env. 1∕2 dl) et l’ajouter au potage avec les suprêmes d’orange.\",\"Faire chauffer.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Saison Automne\",\"Saison Hiver\",\"Asperges\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/9386/potage-courge-orange-aux-graines-et-aux-noix-epicees\",\"notes\":\"\",\"paprikaUid\":\"54404716-3547-410E-9951-C280B964E31A\"},{\"id\":\"soupe-aux-pommes-et-aux-poivrons-mrryzeuet61\",\"title\":\"Soupe aux pommes et aux poivrons\",\"category\":\"Soupe\",\"time\":45,\"servings\":4,\"ingredients\":[[\"poivron rouge\",1,\"u\"],[\"pomme de terre farineuse\",60,\"g\"],[\"pomme\",1,\"u\"],[\"poireau\",0.5,\"\"],[\"huile\",0,\"\"],[\"bouillon de légumes\",5,\"dl\"],[\"yogourt\",2,\"c. à soupe\"],[\"crème entière\",0,\"\"],[\"chili frais\",0.5,\"u\"],[\"curry\",0,\"\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"cresson\",0,\"\"]],\"steps\":[\"Das Obst und Gemüse waschen.\",\"Die Paprika in große Stücke schneiden.\",\"Die Kartoffeln schälen und würfeln.\",\"Auch den Apfel schälen und in Würfel schneiden.\",\"Den Lauch in Ringe schneiden und in einem Topf mit Öl dünsten.\",\"Die Paprika-, Kartoffel- und Apfelstücke dazugeben und kurz anbraten.\",\"Mit der heißen Gemüsebrühe aufgießen.\",\"Die kleingeschnittene Chilischote hinzugeben und ca. 20 Minuten köcheln lassen.\",\"Parallel dazu die Sahne steifschlagen.\",\"Wenn das Gemüse gar ist, die Suppe pürieren und mit Salz, Pfeffer und Curry würzen.\",\"Den Naturjoghurt unterrühren.\",\"Die Suppe auf Schüsseln verteilen.\",\"Die Sahne als Haube darauf geben, mit der Kresse garnieren und servieren.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"modifié\"],\"source\":\"https://www.suedtirol.info/de/de/essen-und-trinken/plp-rezept/pdp-rezept.7AW7WN1Z-TM4Y-22R0-T6AE-M8BOR5LKJ3DK.apfel-paprika-suppe\",\"notes\":\"\",\"paprikaUid\":\"F1DB7D10-2E21-4149-98BD-0FE1D726B3AD\"},{\"id\":\"soupe-aux-poireaux-et-aux-pommes-mrryzeudajj\",\"title\":\"Soupe aux poireaux et aux pommes\",\"category\":\"Soupe\",\"time\":35,\"servings\":4,\"ingredients\":[[\"graine de tournesol\",2,\"c. à soupe\"],[\"oignon\",1,\"u\"],[\"poireau\",500,\"g\"],[\"pomme de terre farineuse\",300,\"g\"],[\"pomme\",2,\"u\"],[\"beurre\",1,\"c. à soupe\"],[\"demi-crème\",1,\"dl\"],[\"bouillon de légumes\",1,\"l\"],[\"lardons\",80,\"g\"],[\"curry doux\",0.5,\"c. à café\"],[\"sel\",0,\"\"]],\"steps\":[\"Faire fondre le beurre dans une casserole.\",\"Y faire suer l'oignon pendant 3 min.\",\"Ajouter le curry et poursuivre la cuisson brièvement.\",\"Ajouter le poireau, les pommes de terre et la pomme, poursuivre la cuisson pendant 2 min.\",\"Ajouter le bouillon, porter à ébullition.\",\"Baisser le feu et laisser mijoter env. 20 min.\",\"Mixer le potage.\",\"Faire mousser la crème.\",\"Incorporer les 2/3 au potage.\",\"Assaisonner le potage.\",\"Faire dorer les lardons lentement dans une poêle antiadhésive sans ajouter de matière grasse.\",\"Y faire sauter les dés de pomme et les graines pendant 3 min.\",\"Dresser le potage et le garnir du reste de crème fouettée et du mélange de lardons et de pommes.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Saison Autumne\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/26510/potage-aux-poireaux-et-aux-pommes\",\"notes\":\"\",\"paprikaUid\":\"A7CA95A0-DB08-47B3-AAC9-46DEF9F75074\"},{\"id\":\"soupe-aux-legumes-et-aux-saucisses-de-vienne-mrryzeubhag\",\"title\":\"Soupe aux légumes et aux saucisses de Vienne\",\"category\":\"Soupe\",\"time\":15,\"servings\":4,\"ingredients\":[[\"poireau\",150,\"g\"],[\"carotte\",200,\"g\"],[\"chou frisé\",350,\"g\"],[\"pâtes\",100,\"g\"],[\"pois chiche\",1,\"boîte\"],[\"bouillon de légumes\",1.5,\"l\"],[\"lardon\",75,\"g\"],[\"saucisses de Vienne\",4,\"u\"]],\"steps\":[\"Les lardons dans une grande casserole.\",\"Ajouter les légumes, poursuivre la cuisson pendant env. 2 min.\",\"Verser le bouillon, porter à ébullition.\",\"Ajouter les pâtes, faire cuire jusqu'à ce que les pâtes soient al dente.\",\"Ajouter les pois chiches et les saucisses de Vienne.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Saison Automne\",\"Saison Hiver\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/13996/soupe-aux-legumes-et-aux-saucisses-de-vienne\",\"notes\":\"\",\"paprikaUid\":\"5115A08F-DA70-4627-B3EF-C53B5FD2D3AE\"},{\"id\":\"soupe-aux-flocons-d-avoine-mrryzeuacyt\",\"title\":\"Soupe aux flocons d'avoine\",\"category\":\"Soupe\",\"time\":35,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"u\"],[\"beurre\",0,\"\"],[\"flocon d'avoine\",4,\"c. à soupe\"],[\"carotte\",1,\"u\"],[\"poireau\",50,\"g\"],[\"racine de persil\",1,\"u\"],[\"eau\",7,\"dl\"],[\"bouillon en pâte\",2,\"c. à café\"],[\"marjolaine fraîche\",0.5,\"c. à café\"],[\"livèche\",0.5,\"c. à café\"],[\"persil\",1,\"c. à soupe\"],[\"poivre\",0,\"\"]],\"steps\":[\"Hacher finement l'oignon et les herbes.\",\"Peler les carottes et les racines de persil et les couper en petits morceaux.\",\"Parer le poireau et le couper en fines lanières.\",\"Faire revenir l'oignon dans le beurre, ajouter les flocons d'avoine, faire revenir.\",\"Ajouter la carotte, le poireau et la racine de persil, faire revenir.\",\"Mouiller avec l'eau.\",\"Ajouter le bouillon, la marjolaine et la livèche.\",\"Laisser mijoter 20 min à couvert à feu doux en remuant régulièrement.\",\"Incorporer le persil.\",\"Rectifier l'assaisonnement.\",\"Dresser la soupe dans des assiettes creuses chaudes.\",\"Décorer.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM200707_50/soupe-aux-flocons-davoine/\",\"notes\":\"\",\"paprikaUid\":\"1293B24E-FBC9-45B8-91A1-27CA1B38588E\"},{\"id\":\"soupe-au-vin-blanc-et-saucisses-de-vienne-mrryzeu96im\",\"title\":\"Soupe au vin blanc et saucisses de Vienne\",\"category\":\"Soupe\",\"time\":30,\"servings\":4,\"ingredients\":[[\"oignon\",2,\"u\"],[\"carotte\",2,\"u\"],[\"farine\",1.5,\"c. à soupe\"],[\"beurre\",1,\"c. à soupe\"],[\"crème entière\",2,\"dl\"],[\"bouillon de légumes\",6,\"dl\"],[\"pois chiche\",2,\"boîte\"],[\"saucisse de Vienne\",4,\"u\"],[\"vin blanc\",3,\"dl\"],[\"paprika\",0.25,\"c. à café\"],[\"sel\",0,\"\"]],\"steps\":[\"Hâcher l'oignon et couper les carottes en juliennes.\",\"Faire fondre le beurre dans une casserole.\",\"Y faire revenir les oignons pendant 2 min.\",\"Les saupoudrer de farine.\",\"Ajouter les carottes et le paprika.\",\"Faire cuire le tout pendant 3 min.\",\"Mouiller avec le vin et laisser réduire de moitié.\",\"Ajouter le bouillon et porter à ébullition.\",\"Baisser le feu, couvrir et laisser mijoter env. 10 min.\",\"Ajouter la crème, les saucisses de Vienne et les pois chiches.\",\"Poursuivre la cuisson pendant env. 5 min, saler.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Saison Autumne\",\"Saison Hiver\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/24475/soupe-au-vin-blanc-et-saucisses-de-vienne\",\"notes\":\"\",\"paprikaUid\":\"3A395DAA-28F9-4A81-A494-4DA8F7289964\"},{\"id\":\"soupe-au-vin-blanc-et-au-gorgonzola-mrryzeu8235\",\"title\":\"Soupe au vin blanc et au Gorgonzola\",\"category\":\"Soupe\",\"time\":25,\"servings\":4,\"ingredients\":[[\"échalote\",2,\"u\"],[\"raisin rouge\",200,\"g\"],[\"amande\",50,\"g\"],[\"farine\",2,\"c. à soupe\"],[\"beurre\",1,\"c. à soupe\"],[\"crème pour sauce\",2.5,\"dl\"],[\"Gorgonzola\",75,\"g\"],[\"bouillon de légumes\",6,\"dl\"],[\"vin blanc\",4,\"dl\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Faire fondre le beurre dans une casserole.\",\"Y faire revenir les échalotes pendant env. 5 min.\",\"Ajouter la farine et faire revenir brièvement le tout.\",\"Mouiller avec le vin et porter à ébullition, tout en remuant avec le fouet.\",\"Ajouter le bouillon et porter à ébullition.\",\"Baisser le feu et laisser mijoter env. 10 min.\",\"Ajouter la crème et le Gorgonzola.\",\"Mélanger jusqu'à ce que le fromage soit fondu.\",\"Assaisonner.\",\"Dresser la soupe.\",\"Parsemer de raisins, d'amandes et de Gorgonzola.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Saison Autumne\",\"Italie\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/24103/soupe-au-vin-blanc-et-au-gorgonzola\",\"notes\":\"\",\"paprikaUid\":\"C1648944-660C-4FF9-92E0-A2C65F7C0F00\"},{\"id\":\"soupe-au-vin-au-jambon-cru-des-grisons-mrryzeu74n4\",\"title\":\"Soupe au vin au jambon cru des Grisons\",\"category\":\"Soupe\",\"time\":30,\"servings\":4,\"ingredients\":[[\"gousse d’ail\",1,\"u\"],[\"ciboulette\",2,\"c. à soupe\"],[\"farine blanche\",2,\"c. à soupe\"],[\"beurre\",2,\"c. à soupe\"],[\"crème entière\",1.5,\"dl\"],[\"jaune d'œuf\",2,\"u\"],[\"bouillon de viande\",6,\"dl\"],[\"jambon cru des Grisons\",80,\"g\"],[\"vin blanc\",2,\"dl\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Frotter une casserole avec l'ail.\",\"Faire fondre le beurre dans la même casserole, ajouter la farine et la faire cuire à feu moyen en remuant avec un fouet; elle ne doit pas se colorer.\",\"Retirer la casserole du feu et verser en une fois le bouillon et le vin, puis porter à ébullition en remuant.\",\"Baisser le feu puis laisser mijoter env. 10 min. en remuant de temps en temps.\",\"Dans un saladier, mélanger la crème et les jaunes d'œuf.\",\"Ajouter 3 cs de potage chaud sans cesser de remuer, puis reverser le tout dans la casserole en remuant toujours.\",\"Laisser simplement chauffer le potage et assaisonner.\",\"Verser le potage dans les assiettes et le parsemer de jambon cru et de ciboulette.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Saison Automne\",\"Suisse\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/15293/potage-au-vin-au-jambon-cru-des-grisons\",\"notes\":\"\",\"paprikaUid\":\"A4D14678-EB65-4837-9772-7DCBA89B2253\"},{\"id\":\"soupe-au-radis-long-mrryzeu6kt5\",\"title\":\"Soupe au radis long\",\"category\":\"Soupe\",\"time\":35,\"servings\":4,\"ingredients\":[[\"jus de pomme\",1,\"dl\"],[\"grissini\",30,\"g\"],[\"oignon\",1,\"u\"],[\"radi long\",600,\"g\"],[\"pomme de terre farineuse\",300,\"g\"],[\"raifort\",2,\"cm\"],[\"huile d'olive\",1,\"c. à soupe\"],[\"crème entière\",1,\"dl\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Éplucher et couper les radis longs et les pommes de terre en dés.\",\"Faire chauffer l'huile dans une grande casserole.\",\"Y faire suer l'oignon pendant 3 min.\",\"Ajouter les radis et les pommes de terre.\",\"Les faire revenir brièvement.\",\"Ajouter le mélange de jus de pomme et eau.\",\"Porter à ébullition.\",\"Baisser le feu.\",\"Saler et laisser mijoter env. 20 min.\",\"Mixer le potage, saler et poivrer.\",\"Fouetter la crème et ajouter le raifort râpé.\",\"Dresser la soupe dans des bols ou des assiettes creuses.\",\"Ajouter la crème et les grissinis.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Saison Automne\",\"Saison Hiver\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/24659/potage-au-radis-long\",\"notes\":\"\",\"paprikaUid\":\"EFA462D9-FE07-4BD8-8663-A704E07FEEEC\"},{\"id\":\"soupe-au-poireau-mrryzeu62sp\",\"title\":\"Soupe au poireau\",\"category\":\"Soupe\",\"time\":50,\"servings\":4,\"ingredients\":[[\"poireau\",500,\"g\"],[\"pomme de terre farineuse\",300,\"g\"],[\"huile\",2,\"c. à soupe\"],[\"beurre\",1,\"c. à soupe\"],[\"crème\",2.5,\"dl\"],[\"bouillon de légumes\",1,\"l\"],[\"noix de muscade\",3,\"pincée\"],[\"cannelle\",1,\"pincée\"],[\"sel\",1,\"pincée\"]],\"steps\":[\"Faire fondre le beurre dans une sauteuse.\",\"Y faire suer le poireau et les pommes de terre pendant env. 3 min.\",\"Mouiller avec le bouillon, porter à ébullition.\",\"Baisser le feu, laisser mijoter env. 20 min.\",\"Ajouter la crème, poursuivre la cuisson pendant env. 10 min.\",\"Mixer et assaisonner.\",\"Faire chauffer l'huile dans une poêle antiadhésive.\",\"Y faire dorer le poireau pendant env. 5 min. en remuant de temps en temps, assaisonner.\",\"Verser la garniture sur le potage.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Saison Autumne\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/17327/potage-au-poireau\",\"notes\":\"\",\"paprikaUid\":\"3A1C76C3-E3B1-45BD-9543-40C4B7A92800\"},{\"id\":\"soupe-au-panais-et-aux-marrons-mrryzeu5p1e\",\"title\":\"Soupe au panais et aux marrons\",\"category\":\"Soupe\",\"time\":40,\"servings\":4,\"ingredients\":[[\"marron\",250,\"g\"],[\"oignon\",1,\"u\"],[\"panais\",150,\"g\"],[\"orange\",1,\"u\"],[\"beurre\",1,\"c. à soupe\"],[\"crème fraîche\",2,\"c. à soupe\"],[\"bouillon de légumes\",1.25,\"l\"],[\"lard à rôtir\",80,\"g\"],[\"thym\",5,\"brin\"],[\"sel\",0,\"\"]],\"steps\":[\"Couper les panais en petits morceaux.\",\"Couper les oignons finement.\",\"Faire fondre le beurre dans une casserole.\",\"Y faire revenir l'oignon et le panais pendant 3 min.\",\"Ajouter les marrons (garder une poignée).\",\"Poursuivre brièvement la cuisson.\",\"Ajouter le bouillon et porter le tout à ébullition.\",\"Baisser le feu, couvrir et laisser mijoter env. 25 min.\",\"Mixer le potage.\",\"Faire dorer lentement le lard et le reste des marrons dans une poêle sans ajouter de matière grasse.\",\"Ajouter le zeste d'orange et le thym.\",\"Saler et mélanger.\",\"Dresser le potage.\",\"Garnir de crème fraîche et de lard aux marrons.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Saison Autumne\",\"Saison Hiver\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/22361/potage-au-panais-et-aux-marrons\",\"notes\":\"\",\"paprikaUid\":\"D7DCB70E-0C74-4F53-A901-956985C6B629\"},{\"id\":\"soupe-au-panais-avec-croutons-a-la-cannelle-mrryzeu4btc\",\"title\":\"Soupe au panais avec croûtons à la cannelle\",\"category\":\"Soupe\",\"time\":35,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"u\"],[\"panais\",500,\"g\"],[\"gousse d’ail\",1,\"u\"],[\"huile d'olive\",2.5,\"c. à soupe\"],[\"crème de soja\",1,\"dl\"],[\"pain bis\",60,\"g\"],[\"bouillon de légumes\",9,\"dl\"],[\"thym\",5,\"brin\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"cannelle\",0.25,\"c. à café\"]],\"steps\":[\"Faire chauffer l'huile dans une casserole.\",\"Y faire suer l'oignon pendant 2 min.\",\"Ajouter les panais et le thym, poursuivre la cuisson pendant 4 min.\",\"Ajouter le bouillon, porter à ébullition.\",\"Baisser le feu, couvrir et laisser mijoter env. 25 min.\",\"Mixer le potage, incorporer la crème de soja, faire chauffer, assaisonner.\",\"Faire chauffer l'huile dans une poêle.\",\"Ajouter les dés de pain, le thym, l'ail et la cannelle.\",\"Faire dorer pendant 4 min, saler.\",\"Dresser le potage, le garnir de croûtons et le saupoudrer de cannelle.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Saison Autumne\",\"Saison Hiver\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/24127/potage-au-panais-avec-croutons-a-la-cannelle\",\"notes\":\"\",\"paprikaUid\":\"FB288A5F-E59F-4B6C-9351-2D84B54081B8\"},{\"id\":\"soupe-au-jus-de-pomme-et-a-la-choucroute-mrryzeu3cj8\",\"title\":\"Soupe au jus de pomme et à la choucroute\",\"category\":\"Soupe\",\"time\":145,\"servings\":4,\"ingredients\":[[\"jus de pomme\",4,\"dl\"],[\"échalote\",1,\"u\"],[\"pomme de terre farineuse\",150,\"g\"],[\"choucroute crue\",250,\"g\"],[\"paprika\",0,\"\"],[\"farine blanche\",220,\"g\"],[\"levure sèche\",2,\"c. à café\"],[\"beurre\",2,\"c. à soupe\"],[\"crème\",1.5,\"dl\"],[\"bouillon de légumes\",5,\"dl\"],[\"carvi\",1,\"c. à café\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Mélanger la farine, le sel, le cumin et la levure dans un récipient.\",\"Ajouter l’eau.\",\"Pétrir en une pâte souple.\",\"Laisser lever à température ambiante à couvert env. 1 h jusqu’à ce que la pâte double de volume.\",\"Façonnage: abaisser la pâte sur un peu de farine sur env. 2 mm d’épaisseur, plier deux fois, couper en lanières d’env. 1 cm d’épaisseur.\",\"Poser les lanières sur une plaque chemisée de papier cuisson, badigeonner avec un peu de beurre.\",\"Cuisson: env. 15 min au milieu du four préchauffé à 200° C.\",\"Tourner les bâtonnets au cumin, poursuivre la cuisson env. 5 minutes.\",\"Retirer, laisser refroidir sur une grille.\",\"Chauffer le beurre, y faire revenir l’échalote, ajouter la pomme de terre et la choucroute, faire revenir env. 5 minutes.\",\"Verser le jus de pomme et le bouillon, porter à ébullition.\",\"Baisser le feu, laisser cuire à couvert env. 40 minutes.\",\"Mixer le tout, passer à travers une passoire si nécessaire. Incorporer 2 ⁄3 de la crème, assaisonner.\",\"Décorer la soupe avec le reste de crème et un peu de paprika.\",\"Servir les bâtonnets au cumin en accompagnement.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Suisse\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/8377/soupe-au-jus-de-pomme-et-a-la-choucroute\",\"notes\":\"\",\"paprikaUid\":\"37A86DC6-6C95-465F-867E-98D6E7BB86B0\"},{\"id\":\"soupe-au-fenouil-et-aux-amandes-avec-croutons-mrryzeu2lk9\",\"title\":\"Soupe au fenouil et aux amandes avec croûtons\",\"category\":\"Soupe\",\"time\":35,\"servings\":4,\"ingredients\":[[\"fenouil\",250,\"g\"],[\"oignon\",1,\"u\"],[\"huile de colza\",1,\"c. à soupe\"],[\"graine de fenouil\",0.5,\"c. à café\"],[\"amande moulue\",80,\"g\"],[\"bouillon de légumes\",7,\"dl\"],[\"lait soja\",4,\"dl\"],[\"vermouth\",0.5,\"dl\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"pain\",2,\"tranche\"],[\"beurre à rôtir\",1,\"c. à soupe\"],[\"gousse d'ail\",1,\"u\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Couper le fenouil en petits dés, en réservant le vert et un bout ferme.\",\"Ciseler l'oignon.\",\"Écraser les graines de fenouil dans le mortier.\",\"Couper le pain en dés.\",\"SOUPE:\",\"Faire revenir l’oignon dans l’huile chaude.\",\"Ajouter les graines de fenouil, le fenouil et les amandes.\",\"Faire revenir.\",\"Déglacer avec le bouillon et porter à ébullition.\",\"Ajouter le lait de soja et laisser mijoter pendant env. 20 minutes, jusqu’à ce que le fenouil soit tendre.\",\"Mixer la soupe finement.\",\"Ajouter le vermouth et assaisonner.\",\"Râper finement le bout de fenouil mis de côté.\",\"CROÛTONS:\",\"Faire dorer les dés de pain dans le beurre à rôtir chaud.\",\"Ajouter l’ail pressé et faire dorer brièvement.\",\"Assaisonner.\",\"Répartir la soupe dans les assiettes.\",\"Répartir les croûtons, le fenouil râpé et le vert du fenouil dessus.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"modifié\"],\"source\":\"https://www.gemuese.ch/fr/recettes/soupe-de-fenouil-aux-amandes-avec-des-croutons?_gl=1*109yged*_up*MQ..*_gs*MQ..&gclid=EAIaIQobChMItdK7sbK4kQMVepKDBx0SyAWNEAAYASABEgL9oPD_BwE&gbraid=0AAAAA-NhTE5iAnPHfalM4KcSHGDur_dvT\",\"notes\":\"\",\"paprikaUid\":\"0AE8F1D8-41AE-422B-95AF-FFE39967CB23\"},{\"id\":\"soupe-au-cresson-mrryzeu1tpi\",\"title\":\"Soupe au cresson\",\"category\":\"Soupe\",\"time\":30,\"servings\":2,\"ingredients\":[[\"chip de légumes\",20,\"g\"],[\"échalote\",1,\"u\"],[\"pomme de terre farineuse\",100,\"g\"],[\"cresson\",50,\"g\"],[\"huile d'olive\",1,\"c. à soupe\"],[\"crème entière\",1,\"dl\"],[\"bouillon de légumes\",4,\"dl\"],[\"vermouth blanc\",1,\"dl\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Faire chauffer l'huile dans une casserole.\",\"Ajouter l'échalote et la faire suer pendant env. 1 min.\",\"Ajouter les pommes de terre.\",\"Verser le bouillon et le vermouth, porter à ébullition.\",\"Baisser le feu et poursuivre la cuisson à couvert pendant env. 15 min.\",\"Ajouter le cresson, mixer et assaisonner.\",\"Fouetter la crème bien ferme et l'incorporer à la soupe.\",\"Garnir la soupe avec les chips de légumes et le cresson réservé.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/10023/potage-au-cresson\",\"notes\":\"\",\"paprikaUid\":\"F3CC86AE-80DD-494F-A410-F507BC6A9131\"},{\"id\":\"soupe-au-chou-blanc-et-a-la-moutarde-mrryzeu0jsu\",\"title\":\"Soupe au chou blanc et à la moutarde\",\"category\":\"Soupe\",\"time\":40,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"u\"],[\"chou blanc\",600,\"g\"],[\"pomme de terre farineuse\",200,\"g\"],[\"huile d'olive\",2,\"c. à soupe\"],[\"moutarde à l’ancienne\",4,\"c. à soupe\"],[\"sirop d'érable\",2,\"c. à soupe\"],[\"bouillon de légumes\",9,\"dl\"],[\"vin blanc\",1,\"dl\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Peler les pommes de terre.\",\"Réserver ⅛ du chou.\",\"Couper le reste et les pommes de terre en morceaux.\",\"Faire chauffer l'huile dans une casserole.\",\"Y faire suer l'oignon pendant env. 5 min.\",\"Ajouter le chou et les pommes de terre coupés en morceaux.\",\"Faire revenir brièvement le tout.\",\"Mouiller avec le vin et faire réduire un peu.\",\"Ajouter le bouillon et porter à ébullition.\",\"Baisser le feu, couvrir et laisser mijoter env. 20 min.\",\"Mixer le tout.\",\"Ajouter la moutarde et assaisonner.\",\"Couper la partie du chou réservée en fines lanières.\",\"Faire chauffer l'huile dans une poêle antiadhésive.\",\"Y faire revenir le chou pendant 2 min.\",\"Ajouter le sirop d'érable et poursuivre la cuisson pendant 3 min.\",\"Répartir le chou sur le potage.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Saison Autumne\",\"Saison Hiver\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/22506/potage-au-chou-blanc-et-a-la-moutarde\",\"notes\":\"\",\"paprikaUid\":\"82ADC4A1-B68E-475F-9F97-B7E2163D5FAE\"},{\"id\":\"soupe-asiatique-aux-nouilles-mrryzetyevr\",\"title\":\"Soupe asiatique aux nouilles\",\"category\":\"Soupe\",\"time\":20,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"u\"],[\"gousse d’ail\",1,\"u\"],[\"shii-také\",100,\"g\"],[\"chili rouge\",1,\"u\"],[\"limette (Thai-Kit)\",4,\"feuille\"],[\"chou chinois\",100,\"g\"],[\"coriandre\",1,\"bouquet\"],[\"huile d'olive\",1,\"c. à soupe\"],[\"œuf\",4,\"u\"],[\"nouille chinoise\",150,\"g\"],[\"bouillon de légumes\",1.5,\"l\"],[\"lemon grass\",1,\"tige\"],[\"sauce de soja\",3,\"c. à soupe\"]],\"steps\":[\"Cuire les œufs durs.\",\"Chauffer l'huile dans une casserole.\",\"Y faire revenir env. 3 min l'oignon et le reste des ingrédients, feuilles de limette kaffir comprises.\",\"Verser le bouillon et la sauce soja, porter à ébullition.\",\"Ajouter les nouilles et le chou chinois, cuire env. 5 min al dente.\",\"Servir la soupe, répartir les œufs et la coriandre dessus.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Saison Autumne\",\"Asie\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/13847/soupe-asiatique-aux-nouilles\",\"notes\":\"\",\"paprikaUid\":\"79163086-97AA-4EF9-98BA-C21C40D50F19\"},{\"id\":\"soupe-asiatique-au-bouilli-mrryzetxq7a\",\"title\":\"Soupe asiatique au bouilli\",\"category\":\"Soupe\",\"time\":135,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"u\"],[\"gousse d’ail\",4,\"u\"],[\"gingembre\",40,\"g\"],[\"pak-choi\",2,\"u\"],[\"coriandre\",1,\"bouquet\"],[\"huile\",0,\"\"],[\"sucre brut gros cristaux\",1,\"c. à soupe\"],[\"nouille chinoise\",250,\"g\"],[\"concentré de tomates\",1,\"c. à soupe\"],[\"bouillon de viande\",1.5,\"l\"],[\"bouilli de bœuf\",800,\"g\"],[\"sel\",0,\"\"],[\"étoilé d'anis\",3,\"u\"],[\"clous de girofle\",2,\"u\"],[\"poivre\",10,\"grain\"],[\"cannelle\",1,\"bâtonnet\"],[\"sauce de soja\",0.5,\"dl\"],[\"oignon grillé\",2,\"c. à soupe\"]],\"steps\":[\"Faire chauffer l'huile dans une cocotte.\",\"Saler la viande, la faire revenir par portions pendant env. 5 min., réserver.\",\"Faire chauffer un peu d'huile dans la cocotte.\",\"Y faire revenir l'oignon, l'ail et le gingembre pendant env. 5 min.\",\"Ajouter le sucre et tous les autres ingrédients jusqu'au bâton de cannelle compris, poursuivre brièvement la cuisson.\",\"Ajouter le bouillon et la sauce au soja, porter à ébullition, puis baisser le feu.\",\"Ajouter la viande et laisser frémir pendant env. 1 h 30 en évitant l'ébullition.\",\"Sortir la viande.\",\"Passer le jus de cuisson au tamis, le verser dans la cocotte, puis y remettre la viande.\",\"Mettre le pak choï et les nouilles dans la soupe.\",\"Laisser mijoter pendant env. 3 min. en remuant de temps en temps.\",\"Saler le potage et le dresser.\",\"Parsemer de coriandre et d'oignons grillés.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Asie\",\"Saison Autumne\",\"Saison Été\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/19197/potage-asiatique-au-bouilli\",\"notes\":\"\",\"paprikaUid\":\"3C005864-485F-41F9-8E9B-5547333FE557\"},{\"id\":\"soupe-alphabet-d-automne-mrryzetwspq\",\"title\":\"Soupe alphabet d'automne\",\"category\":\"Soupe\",\"time\":30,\"servings\":4,\"ingredients\":[[\"carotte\",150,\"g\"],[\"poireau\",150,\"g\"],[\"chou frisé\",150,\"g\"],[\"chanterelle\",150,\"g\"],[\"persil plat\",2,\"c. à soupe\"],[\"pâtes alphabet\",100,\"g\"],[\"bouillon de bœuf\",1.5,\"l\"],[\"saucisses de Vienne\",4,\"u\"],[\"laurier\",1,\"feuille\"],[\"oignon grillé\",2,\"c. à soupe\"]],\"steps\":[\"Porter le bouillon à ébullition dans une casserole.\",\"Baisser le feu, ajouter les carottes, les poireaux et le laurier, faire cuire à petit feu pendant env. 10 min.\",\"Ajouter le chou frisé, les chanterelles, les pâtes et les saucisses de Vienne, laisser mijoter le tout pendant env. 7 min.\",\"Sortir les saucisses de Vienne, les couper en fines rondelles puis les remettre dans le potage.\",\"Dresser le potage, parsemer de persil et d'oignons grillés.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Saison Autumne\",\"Asie\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/20236/soupe-alphabet-d-automne\",\"notes\":\"\",\"paprikaUid\":\"B289A43D-CDFF-414D-AE7B-D15E3958DF87\"},{\"id\":\"soledurner-wysuppli-soupe-soleurois-au-vin-mrryzetve57\",\"title\":\"Soledurner Wysüppli (Soupe soleurois au vin)\",\"category\":\"Soupe\",\"time\":30,\"servings\":2,\"ingredients\":[[\"échalote\",1,\"u\"],[\"carotte\",1,\"u\"],[\"poireau\",150,\"g\"],[\"ciboulette\",0,\"\"],[\"beurre\",1,\"c. à soupe\"],[\"demi-crème pour sauces\",1,\"dl\"],[\"jaune d'œuf\",2,\"u\"],[\"bouillon de poule\",4,\"dl\"],[\"vin blanc\",3,\"dl\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Ciseler l'échalote.\",\"Râper les carottes.\",\"Couper le poireau en fines lanières.\",\"Faire fondre le beurre dans une casserole.\",\"Y faire revenir l'échalote, la carotte et le poireau pendant env. 5 min.\",\"Mouiller avec le bouillon et le vin blanc.\",\"Porter à ébullition et laisser mijoter env. 10 min.\",\"Mélanger la demi-crème pour sauces et les jaunes d'œuf.\",\"Retirer la casserole du feu.\",\"Verser lentement la crème dans le potage, tout en remuant.\",\"Reposer la casserole sur la plaque et faire chauffer jusqu'au point d'ébullition.\",\"Saler et poivrer\",\"Dresser le potage.\",\"Parsemer de ciboulette.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Saison Automne\",\"Saison Hiver\",\"Suisse\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/16971/potage-soleurois-au-vin--soledurner-wysueppli-\",\"notes\":\"\",\"paprikaUid\":\"E79C38A9-82AC-4D25-9372-449B39768264\"},{\"id\":\"sirop-rafraichissante-a-la-pasteque-mrryzetug8p\",\"title\":\"Sirop rafraîchissante à la pastèque\",\"category\":\"Boisson\",\"time\":160,\"servings\":4,\"ingredients\":[[\"eau minérale gazeuse\",5,\"dl\"],[\"pastèque\",600,\"g\"],[\"menthe poivrée\",5,\"brin\"],[\"limette\",2,\"u\"],[\"sucre\",200,\"g\"]],\"steps\":[\"Presser la limette.\",\"Couper la pastèque en dés.\",\"Porter à ébullition l'eau, le jus de limette et la pastèque.\",\"Baisser le feu et laisser mijoter à couvert pendant 30 min.\",\"Laisser reposer 10 min. à feu éteint.\",\"Mixer.\",\"Passer le liquide au tamis (cela donne env. 8 dl de jus).\",\"Porter à ébullition le jus mélangé au sucre tout en remuant.\",\"Laisser cuire 20 min.\",\"Enlever la mousse (il reste env. 7 dl de liquide).\",\"Verser le sirop chaud dans la bouteille.\",\"Bien la remplir et la fermer aussitôt.\",\"Laisser refroidir.\",\"Verser 1,5 cs de sirop dans chaque verre.\",\"Remplir d'eau.\",\"Rincer la limette à l'eau chaude.\",\"La couper en deux puis en rondelles.\",\"Ajouter 3 glaçons par verre.\",\"Décorer avec de la limette et de la menthe.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/13774/boisson-rafraichissante-a-la-pasteque\",\"notes\":\"\",\"paprikaUid\":\"C7899A3F-682D-4536-8619-C95B3010EB8F\"},{\"id\":\"sel-a-l-ail-des-ours-mrryzettrns\",\"title\":\"Sel à l’ail des ours\",\"category\":\"Assaisonnement\",\"time\":1450,\"servings\":4,\"ingredients\":[[\"ours\",100,\"g ail des\"],[\"marin\",200,\"g sel\"]],\"steps\":[\"Bien laver les feuilles d’ail des ours.\",\"Eponger et couper grossièrement.\",\"Broyer grossièrement par portions avec le sel marin dans un hachoir électrique.\",\"Répartir sur une plaque chemisée de papier cuisson.\",\"Laisser sécher env. 24 heures.\",\"Répartir le sel à l’ail des ours dans des bocaux propres et secs.\",\"Bien fermer.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Assaisonnement\",\"Saison Printemps\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/sel-a-lail-des-ours-10009158/\",\"notes\":\"\",\"paprikaUid\":\"7E7B6F4B-86F1-43AD-AEE6-7D455F17BECA\"},{\"id\":\"scaloppine-al-limone-mrryzetrzq1\",\"title\":\"Scaloppine al limone\",\"category\":\"Plat principal\",\"time\":40,\"servings\":4,\"ingredients\":[[\"escalopes de veau\",12,\"u\"],[\"huile d’olive\",0,\"\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"citron\",1,\"u\"],[\"bouillon de légumes\",3,\"dl\"],[\"beurre\",1,\"c. à soupe\"],[\"farine\",1,\"c. à soupe\"]],\"steps\":[\"Préchauffer le four à 60°C, y glisser un plat et des assiettes.\",\"Aplatir un peu les escalopes.\",\"Bien faire chauffer un peu d’huile dans une poêle.\",\"Saisir les escalopes par portions env. 1 min sur chaque face.\",\"Saler, poivrer.\",\"Réserver au chaud.\",\"Éponger le fond de la poêle.\",\"Râper le zeste d’un citron, presser tout le jus (soit env. 1½ dl).\",\"Verser le tout dans la poêle avec le bouillon.\",\"Porter à ébullition, baisser le feu.\",\"Mélanger le beurre et la farine.\",\"Incorporer en remuant.\",\"Laisser mijoter env. 5 minutes.\",\"Ajouter les escalopes avec le jus rendu, le temps de bien faire chauffer.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Veau\",\"modifié\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/scaloppine-al-limone-10004149/\",\"notes\":\"\",\"paprikaUid\":\"8517D809-E3A5-47F8-9572-DA8FACAF7251\"},{\"id\":\"saucisses-et-legumes-au-four-mrryzetpf8f\",\"title\":\"Saucisses et légumes au four\",\"category\":\"Plat principal\",\"time\":55,\"servings\":4,\"ingredients\":[[\"carotte\",250,\"g\"],[\"betterave crue\",250,\"g\"],[\"pomme de terre bleue\",250,\"g\"],[\"brocoli\",300,\"g\"],[\"pomme\",2,\"u\"],[\"huile d'olive\",2,\"c. à soupe\"],[\"chipolata\",6,\"u\"],[\"porc\",2,\"saucisses à rôtir de\"],[\"lard à rôtir\",6,\"tranche\"],[\"mélange d'herbes à l'italienne\",0.5,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Répartir les légumes et les pommes sur une plaque recouverte de papier cuisson, puis les mélanger avec l'huile.\",\"Saler et poivrer.\",\"Faire cuire env. 20 min. au milieu du four préchauffé à 220 °C.\",\"Barder chaque morceau de saucisse d'une tranche de lard.\",\"Sortir la plaque du four, répartir les morceaux de saucisse dessus et terminer la cuisson pendant env. 20 min. dans le haut du four.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/18525/saucisses-et-legumes-au-four\",\"notes\":\"\",\"paprikaUid\":\"77A308B4-2942-4712-B1E0-442A05A1FEE0\"},{\"id\":\"saucisse-en-croute-a-l-ail-des-ours-mrryzeto0v0\",\"title\":\"Saucisse en croûte à l’ail des ours\",\"category\":\"Plat principal\",\"time\":10,\"servings\":4,\"ingredients\":[[\"pâte feuilletée ronde\",1,\"u\"],[\"concentré de tomate\",2,\"c. à soupe\"],[\"ail des ours\",1,\"u botte\"],[\"saucisses de veau\",4,\"u\"],[\"jaune d’œuf\",1,\"u\"]],\"steps\":[\"Préchauffer le four à 200°.\",\"Dérouler la pâte feuilletée.\",\"Badigeonner de concentré de tomates.\",\"Couper en quatre.\",\"Répartir les feuilles d’ail des ours.\",\"Poser les saucisses dessus.\",\"Enrouler les saucisses dans la pâte.\",\"Dorer à l’oeuf.\",\"Faire cuire env. 25 min dans la moitié inférieure du four.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Saison Printemps\",\"modifié\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/saucisse-en-crote-a-lail-des-ours-10003641/\",\"notes\":\"\",\"paprikaUid\":\"033B3282-153F-418F-997E-4834962A1A94\"},{\"id\":\"sauce-a-salade-asiatique-mrryzetmh71\",\"title\":\"Sauce à salade asiatique\",\"category\":\"Sauce\",\"time\":30,\"servings\":4,\"ingredients\":[[\"vinaigre de riz\",80,\"g\"],[\"sauce de soja\",80,\"g\"],[\"huile de colza\",60,\"g\"],[\"échalote\",50,\"g\"],[\"carotte\",50,\"g\"],[\"gousse d'ail\",20,\"g\"],[\"sucre\",10,\"g\"],[\"orange\",1,\"u\"],[\"pomme\",1,\"u\"],[\"sésame blanc\",30,\"g\"]],\"steps\":[\"Mettre tous les ingrédients dans un bol.\",\"Mixer bien jusqu'à l'obtention d'une crème.\",\"Peut-être conserver 2-3 jours au frigo.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Salade\",\"modifié\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"004970BA-AB01-48B1-A1B8-4D2CE1289249\"},{\"id\":\"sashimi-de-pasteque-mrryzetiui4\",\"title\":\"Sashimi de pastèque\",\"category\":\"Salade\",\"time\":495,\"servings\":4,\"ingredients\":[[\"pastèque\",500,\"g\"],[\"sel\",2,\"c. à café\"],[\"vinaigre\",3,\"c. à soupe\"],[\"huile de lin\",3,\"c. à soupe\"],[\"sauce de soja\",2,\"c. à soupe\"],[\"sauce Liquid Smoke\",0.25,\"c. à café\"],[\"Nori\",0.5,\"feuille\"],[\"riz pour sushi\",100,\"g\"],[\"salades asiatiques (carottes, kimchi, betteraves rouges)\",0,\"\"]],\"steps\":[\"Couper la pastèque en tranches d'un cm d'épaisseur d'env. 2x6 cm.\",\"Saler légèrement et laisser rôtir env. 10 min. dans une poêle, jusqu'à ce que le max. de liquide s'est évaporé.\",\"Tourner de temps en temps.\",\"Pendant ce temps, dans un bol, mélanger le vinaigre, l'huile, la sauce soja et le Liquid Smoke.\",\"Couper la feuille de noria en petits morceaux et ajouter à la marinade.\",\"Sortir les tranches de pastèque du poêle et sécher à l'aide de papier ménage.\",\"Ajouter encore chaudes à la marinade.\",\"Laisser mariner au moins 30 min. (idéalement une nuit) bien fermé au frigo.\",\"Préparer du riz pour sushi.\",\"Chauffer une poêle et y faire rôtir des graines de sésame.\",\"Verser dans une assiette.\",\"Former à la main des rouleaux d'env. 6 cm et déposer sur les plats allongés.\",\"Tremper les tranches de pastèque dans les graines de sésame et déposer sur les rouleaux de riz.\",\"Servir avec des salades asiatiques.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Asie\",\"Saison Été\",\"modifié\"],\"source\":\"https://www.eat-this.org/veganer-wassermelonen-thunfisch/\",\"notes\":\"\",\"paprikaUid\":\"70B9806F-3DDC-4875-91AE-A2EF0FD3A681\"},{\"id\":\"sangria-a-la-grenade-mrryzetibl5\",\"title\":\"Sangria à la grenade (sans alcool)\",\"category\":\"Boisson\",\"time\":30,\"servings\":1,\"ingredients\":[[\"pomme\",300,\"g\"],[\"jus de pomme\",240,\"ml\"],[\"jus de grenade\",240,\"ml\"],[\"eau\",240,\"ml\"]],\"steps\":[\"Verser tous les ingrédients, à l’exception des pommes, dans la machine à soda.\",\"Gazéifier la boisson avec une capsule à soda.\",\"Patienter 1 minute avant l’ouverture.\",\"Répartir les pommes coupées en dés dans 3 verres.\",\"Remplir de glaçons et verser la boisson.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"modifié\"],\"source\":\"https://www.kisag.ch/fr/recettes/sangria-a-la-grenade\",\"notes\":\"\",\"paprikaUid\":\"36934A47-7937-4B4A-9E0F-80BD0842F35A\"},{\"id\":\"sangria-aux-jus-sans-alcool-mrryzethr84\",\"title\":\"Sangria aux jus (sans alcool)\",\"category\":\"Boisson\",\"time\":10,\"servings\":2,\"ingredients\":[[\"jus de raisin rouge\",1.5,\"l\"],[\"jus de citron\",1,\"u\"],[\"jus et le zeste orange\",1,\"u\"],[\"cannelle\",2,\"bâton\"],[\"feuille de menthe\",0,\"\"],[\"fruit\",0,\"\"],[\"eau gazéifiée\",5,\"dl\"]],\"steps\":[\"Mélangez les jus, le zeste d'orange, la cannelle, la menthe, les fruits et laissez macérer le tout au réfrigérateur au moins 2 heures.\",\"Ajoutez l’eau gazeuse et servez la sangria dans des verres remplis de glaçons.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"modifié\"],\"source\":\"https://ici.radio-canada.ca/mordu/recettes/1035/sangria-jus-enfants-sans-alcool\",\"notes\":\"\",\"paprikaUid\":\"D97C4270-B013-4E5E-BD28-45D043A45E17\"},{\"id\":\"sangria-sans-alcool-mrryzetfyhj\",\"title\":\"Sangria (sans alcool)\",\"category\":\"Boisson\",\"time\":15,\"servings\":8,\"ingredients\":[[\"citron\",1,\"u\"],[\"Sanbittèr\",3,\"dl\"],[\"jus de raisin\",3,\"dl\"],[\"jus de pomme pétillant\",5,\"dl\"],[\"orange\",2,\"u\"],[\"fraise\",250,\"g\"],[\"glaçon\",0,\"\"]],\"steps\":[\"Exprimer le jus du citron.\",\"Verser dans un pichet avec le Sanbittèr, le jus de raisin et le jus de pomme.\",\"Couper les oranges en quatre puis en tranches.\",\"Partager les fraises en deux.\",\"Ajouter les fruits et les glaçons à la Sangria.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"modifié\"],\"source\":\"https://migusto.migros.ch/fr/recettes/sangria-sans-alcool\",\"notes\":\"\",\"paprikaUid\":\"F65A181A-4E72-4EC8-A3EC-27AF36B9253B\"},{\"id\":\"samgyeopsal-porc-grille-coreen-mrryzete50s\",\"title\":\"Samgyeopsal (porc grillé coréen)\",\"category\":\"Plat principal\",\"time\":25,\"servings\":4,\"ingredients\":[[\"poitrine de porc\",750,\"g\"],[\"oignon\",1,\"\"],[\"oignon vert\",3,\"tiges\"],[\"gousse d'ail\",4,\"u\"],[\"gingembre en poudre\",0.25,\"c. à café\"],[\"Gochujang\",120,\"g\"],[\"soja light\",60,\"g sauce\"],[\"Gochugaru\",2,\"c. à café\"],[\"mirin\",3,\"c. à soupe\"],[\"huile de sésame\",1,\"c. à soupe\"],[\"graine de sésame\",1,\"c. à soupe\"],[\"sucre\",1,\"c. à soupe\"],[\"poivre\",0,\"\"],[\"Doenjang\",60,\"g\"],[\"sucre\",1,\"c. à café\"],[\"sésame, grillées\",0.5,\"c. à soupe graines de\"],[\"Shiso\",1,\"salade feuilles de\"]],\"steps\":[\"Salade d'oignons verts:\",\"Trancher finement une partie des oignons verts et l'autre partie en tranches d'env. 5 cm.\",\"Couper l'ail en fines tranches.\",\"Faire tremper les oignons verts émincés dans de l'eau froide pendant 5 minutes\",\"Rincer et égoutter\",\"Rassembler les ingrédients de l'assaisonnement dans un bol\",\"Bien mélanger\",\"Répartir les oignons verts dans des petits bols de service.\",\"Ajouter un peu de sauce sur chaque portion.\",\"Réserver\",\"Ssamjang:\",\"Rassembler tous les ingrédients dans un bol\",\"Bien mélanger\",\"Transférer dans un bol de service et réserver\",\"Poitrine de porc:\",\"Couper la viande en longues tranches fines.\",\"Dans un grand bol, mélanger les éléments de la marinade\",\"Mariner les tranches de poitrine de porc avec la marinade\",\"Réfrigérer pendant au moins deux heures\",\"Griller la poitrine de porc à feu moyen sur une poêle, un barbecue ou une plancha.\",\"Ne pas les retourner trop rapidement et ne pas trop en mettre sur la poêle d’un coup\",\"Servir avec le Ssamjang et le Pajeori\",\"Déguster en mettant du Pajeori et du Ssamjang dans une feuille de laitue ou de perille.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Corée\",\"Asie\",\"modifié\"],\"source\":\"https://marcwiner.com/samgyeopsal/\",\"notes\":\"\",\"paprikaUid\":\"11C5FC79-A440-4BA4-A52F-F3B1276F57C6\"},{\"id\":\"saltimboccas-aux-courgettes-et-aux-champignons-mrryzetd5pp\",\"title\":\"Saltimboccas aux courgettes et aux champignons\",\"category\":\"Plat principal\",\"time\":25,\"servings\":4,\"ingredients\":[[\"sauge\",8,\"feuille\"],[\"courgette\",400,\"g\"],[\"champignon de Paris\",150,\"g\"],[\"huile\",0,\"\"],[\"beurre\",15,\"g\"],[\"jambon cru\",4,\"tranche\"],[\"escalope de veau\",8,\"u\"],[\"prosecco\",1,\"dl\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Poser le jambon cru et la sauge sur les escalopes de veau et fixer avec des cure-dents.\",\"Faire chauffer l'huile dans une poêle et y saisir les saltimboccas par portions du côté du jambon pendant env. 1 min., les saler et les poivrer, les retourner.\",\"Poursuivre la cuisson pendant env. 2 min., puis les retirer de la poêle et les réserver au chaud.\",\"Faire chauffer un peu d'huile dans la même poêle et y faire revenir par portions les rondelles de courgettes et les morceaux de champignons env. 2 min de chaque côté.\",\"Saler et poivrer.\",\"Retirer du feu et réserver au chaud.\",\"Déglacer avec le prosecco et laisser réduire jusqu'à ce qu'il ne reste plus qu'env. 2 cs de liquide.\",\"Baisser le feu, retirer la poêle du feu puis ajouter le beurre par portions tout en remuant avec le fouet.\",\"Remettre de temps en temps la poêle sur le feu pour réchauffer légèrement la sauce.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Veau\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/16828/saltimboccas-aux-courgettes-et-aux-champignons\",\"notes\":\"\",\"paprikaUid\":\"C3A7C0B5-5DDB-4D78-B8A8-2C30004172FE\"},{\"id\":\"salade-a-la-patate-douce-mrryzetcwco\",\"title\":\"Salade à la patate douce\",\"category\":\"Salade\",\"time\":30,\"servings\":4,\"ingredients\":[[\"patate douce\",1,\"u\"],[\"salade jeunes pousses\",1,\"sachet\"],[\"oignon rouge\",1,\"u\"],[\"concombre\",1,\"u\"],[\"cranberry\",60,\"g\"],[\"huile\",4,\"c. à soupe\"],[\"paprika\",0.5,\"c. à café\"],[\"miel\",2,\"c. à soupe\"],[\"jus de citron\",2,\"c. à soupe\"],[\"moutarde\",2,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"cumin moulu\",0,\"\"],[\"graine grenade\",0,\"\"]],\"steps\":[\"Préchaufer le four à 200°.\",\"Couper la patate en dés et les déposer dans un bol.\",\"Ajouter l'huile, le sel, le poivre, la paprika et le cumin.\",\"Bien mélanger.\",\"Cuire au four pendant 15 min.\",\"Après 8 min brasser pour dorer de tous les côtés.\",\"Laisser refroidir.\",\"Entre temps, mélanger tous les ingrédients pour la sauce.\",\"Couper l'oignon en fines tranches.\",\"Couper la concombre en deux sur sa longueur et couper en tranches de 2-3 mm.\",\"Verser la salade dans un grand bol.\",\"Ajouter l'oignon et la concombre.\",\"Ajouter les cranberry.\",\"Bien mélanger.\",\"Ajouter les dés de patate et bien mélanger.\",\"Ajouter la sauce et bien mélanger.\",\"Parsemer des grains de grenade et servir.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"modifié\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"9F38C09F-0AE2-4268-9B8A-BB3025D69024\"},{\"id\":\"salade-waldorf-mrryzet2inm\",\"title\":\"Salade Waldorf\",\"category\":\"Salade\",\"time\":50,\"servings\":4,\"ingredients\":[[\"yogourt\",180,\"g\"],[\"mayonnaise\",3,\"c. à soupe\"],[\"vinaigre de pomme\",2,\"c. à soupe\"],[\"moutarde\",0.5,\"c. à café\"],[\"piment de Cayenne ou piment en poudre\",0.25,\"c. à café\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"céleri-rave\",500,\"g\"],[\"pomme acidulée\",2,\"u\"],[\"noix hachée\",2,\"c. à soupe\"]],\"steps\":[\"Râper le céleri-rave et la pomme et  avec la râpe à rösti.\",\"Sauce:\",\"Mélanger tous les ingrédients.\",\"Mélanger le céleri et le reste des ingrédients avec la sauce. Laisser reposer 10 min.\",\"Décorer de noix et servir.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2021_DIVE_17/salade-waldorf-salade-de-celeri/\",\"notes\":\"\",\"paprikaUid\":\"CB6E912A-DDBE-45C1-8026-7604D1418B4D\"},{\"id\":\"salade-tomates-melon-mrryzet2cds\",\"title\":\"Salade tomates/melon\",\"category\":\"Salade\",\"time\":80,\"servings\":4,\"ingredients\":[[\"tomate\",500,\"g\"],[\"gousse d’ail\",1,\"u\"],[\"sucre glace\",40,\"g\"],[\"grains de poivre noir\",1,\"c. à café\"],[\"fleur de sel\",1,\"c. à café\"],[\"melon de Cavaillon\",1,\"u\"],[\"feuilles de marjolaine\",1,\"c. à soupe\"],[\"citron\",0.5,\"u\"],[\"huile d’olive\",1,\"c. à soupe\"]],\"steps\":[\"Préchauffer le four à 120° C.\",\"Couper les tomates en tranches d'env. 5 mm d'épaisseur.\",\"Peler l'ail et le couper en lamelles.\",\"Répartir les deux sur une plaque chemisée de papier cuisson.\",\"Saupoudrer de sucre glace.\",\"Ecraser les grains de poivre, parsemer avec la fleur de sel.\",\"Cuisson: env. 1 h au four.\",\"Sortir les tomates du four, laisser refroidir sur un plat.\",\"Couper le melon en deux, épépiner.\",\"Couper en petits dés.\",\"Répartir sur les tomates.\",\"Parsemer de marjolaine.\",\"Presser le jus du citron et en arroser la salade avec l'huile.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"modifié\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/salade-tomates-melon-10004374/\",\"notes\":\"\",\"paprikaUid\":\"4840E6F6-0885-424D-ACE9-9BF10F5F3EB2\"},{\"id\":\"salade-tomates-fenouil-et-burrata-mrryzet1ten\",\"title\":\"Salade tomates/fenouil et Burrata\",\"category\":\"Salade\",\"time\":35,\"servings\":4,\"ingredients\":[[\"fenouil\",400,\"g\"],[\"citron\",1,\"u\"],[\"huile d’olive\",3,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"pignon\",2,\"c. à soupe\"],[\"tomates\",300,\"g\"],[\"burrata\",1,\"u\"],[\"huile d’olive\",1,\"c. à soupe\"],[\"fleur de sel\",2,\"pincée\"]],\"steps\":[\"Émincer le fenouil à la mandoline en tranches d’env. 2mm d’épaisseur.\",\"Dresser sur un plat.\",\"Râper le zeste du citron et presser 2 c. s. de jus.\",\"Mélanger les deux avec l’huile.\",\"Saler, poivrer.\",\"Verser en filet sur le fenouil.\",\"Laisser reposer env. 20 minutes.\",\"Faire griller les pignons à sec dans une poêle.\",\"Retirer et laisser refroidir.\",\"Couper les tomates en tranches.\",\"Répartir sur le fenouil avec les pignons.\",\"Déposer la burrata dans un petit bol.\",\"Arroser d’un filet d’huile.\",\"Saler, poivrer et présenter avec la salade.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"Italie\",\"modifié\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/salade-tomates-fenouil-et-burrata-10008023/\",\"notes\":\"\",\"paprikaUid\":\"242A776E-A369-4CB4-8EC4-A69A5C1EF606\"},{\"id\":\"salade-shirazi-mrryzet0jvi\",\"title\":\"Salade Shirazi\",\"category\":\"Salade\",\"time\":20,\"servings\":6,\"ingredients\":[[\"concombre long\",2,\"u\"],[\"tomate\",6,\"u\"],[\"oignon rouge\",2,\"u\"],[\"persil\",2,\"c. à soupe\"],[\"basilic\",10,\"feuille\"],[\"menthe sèche\",1,\"c. à café\"],[\"jus de citron\",2,\"c. à soupe\"],[\"huile d'olive\",4,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre noir\",0,\"\"]],\"steps\":[\"Pour préparer la salade Shirazi, commencez par les légumes :\",\"Equeutez les concombres, puis pelez-les en alternance avec un économe.\",\"Coupez-les en deux dans le sens de la longueur et enlevez les graines centrales.\",\"Puis coupez-les en petits cubes.\",\"Coupez également les tomates en deux et coupez-les en cubes après avoir enlevé les graines.\",\"Épluchez et coupez l'oignon en cubes.\",\"Transférez les concombres dans un plat de service avec les tomates et les oignons , puis mélangez bien.\",\"Passez à l'assaisonnement :\",\"Versez l'huile dans un petit bol, salez et poivrez.\",\"Ajoutez le jus de citron.\",\"Hachez le persil et le basilic.\",\"Ajoutez les herbes hachées et la menthe sèche et émulsionnez le tout.\",\"Répartissez l'assaisonnement sur la salade et mélangez bien.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Asie\",\"modifié\"],\"source\":\"https://www.giallozafferano.fr/recettes/salade-shirazi.html\",\"notes\":\"\",\"paprikaUid\":\"927E746D-E493-4334-8394-2F88E27BB400\"},{\"id\":\"salade-printaniere-de-fruits-et-legumes-mrryzeszut7\",\"title\":\"Salade printanière de fruits et légumes\",\"category\":\"Salade\",\"time\":15,\"servings\":2,\"ingredients\":[[\"roquette et\",\"ou jeunes épinards\",\"200\"],[\"pomme  Granny Smith\",1,\"u\"],[\"fraise gariguette\",250,\"g\"],[\"avocat mûr\",1,\"u\"],[\"fromage de brebis\",100,\"g de\"],[\"noisette entière\",40,\"g\"],[\"huile de colza\",4,\"tbsp\"],[\"vinaigre de cidre\",1.5,\"c. à soupe\"],[\"céleri moulu\",1,\"c. à café\"],[\"tomate en flocons\",1,\"c. à soupe\"],[\"grain de poivre rouge\",12,\"u\"],[\"baies de poivre de cassis\",1,\"c. à café\"],[\"poivre noir\",0,\"\"]],\"steps\":[\"Préparer l'assaisonnement en mélangeant l'huile, le vinaigre, le céleri et les flocons de tomate.\",\"Laisser infuser 10 minutes.\",\"Laver la salade.\",\"Trancher la pomme, les fraises et l'avocat.\",\"Passer les grains de poivre rouge et les baies de poivre de cassis au mortier pour obtenir une mouture grossière.\",\"Mélanger les végétaux et les fruits avec la sauce préparée.\",\"Parsemer le fromage en miettes et les noisettes sur le dessus de l'assiette.\",\"Finir par les poivres concassés et un dernier tour de moulin de poivre noir juste avant de servir.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Printemps\",\"modifié\"],\"source\":\"https://www.poivre.ch/recette/salade-printaniere-de-fruits-et-legumes-aux-poivres-fruites/\",\"notes\":\"\",\"paprikaUid\":\"ABE61B37-E498-4D4C-BC78-522D43F1DF4D\"},{\"id\":\"salade-parmentier-automnale-mrryzesym7e\",\"title\":\"Salade parmentier automnale\",\"category\":\"Salade\",\"time\":50,\"servings\":4,\"ingredients\":[[\"noisette entière\",50,\"g\"],[\"pommes de terre ferme\",400,\"g\"],[\"beurre à rôtir\",0,\"\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"vinaigre balsamique blanc\",3,\"c. à soupe\"],[\"huile d’olive\",4,\"c. à soupe\"],[\"eau\",3,\"c. à soupe\"],[\"Gorgonzola\",50,\"g\"],[\"salade frisée\",1,\"u\"],[\"figues\",4,\"u\"]],\"steps\":[\"Hacher grossièrement les noisettes.\",\"Faire griller à sec dans une poêle, retirer.\",\"Couper les pommes de terre en quartiers.\",\"Faire revenir env. 15 min dans le beurre à rôtir bien chaud.\",\"Saler, poivrer.\",\"Mixer vinaigre balsamique, huile, eau et masgonzola, poivrer.\",\"Couper la frisée en morceaux.\",\"Mélanger avec la sauce.\",\"Dresser sur les pommes de terre.\",\"Couper les figues en quartiers, en décorer la salade avec les noisettes.\"],\"avecViande\":true,\"temperature\":\"froid\",\"tags\":[\"Saison Autumne\",\"modifié\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/salade-parmentier-automnale-10005083/\",\"notes\":\"\",\"paprikaUid\":\"E51C75F5-846F-4EF2-A578-13F392759D43\"},{\"id\":\"salade-nouilles-asperges-a-l-epinard-mrryzesypha\",\"title\":\"Salade nouilles-asperges à l'épinard\",\"category\":\"Salade\",\"time\":60,\"servings\":4,\"ingredients\":[[\"nouille\",250,\"g\"],[\"sel\",0,\"\"],[\"asperge verte\",150,\"g\"],[\"asperge blanche\",150,\"g\"],[\"beurre\",25,\"g\"],[\"sucre\",1,\"c. à soupe\"],[\"limette\",1,\"u\"],[\"tomate cerise\",150,\"g\"],[\"oignon nouveau\",3,\"u\"],[\"épinard jeune\",125,\"g\"],[\"huile\",25,\"ml\"],[\"vinaigre\",4,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Für den Salat die Nudeln in reichlich Salzwasser bissfest kochen.\",\"In ein Sieb abgießen, mit heißem Wasser abbrausen und gut abtropfen lassen.\",\"Weißen Spargel mit dem Sparschäler schälen und holzige Enden abschneiden.\",\"Grünen Spargel waschen, das untere Drittel schälen und die Enden abschneiden.\",\"In einem flachen Topf 1 l Wasser erhitzen.\",\"Butter, Zucker und ½ TL Salz zugeben.\",\"Limette heiß abwaschen und abtrocknen.\",\"Ein Drittel der Frucht abschneiden und mit ins Wasser geben.\",\"Sobald das Wasser kocht, den weißen Spargel hineingeben und ca. 8 Min. kochen.\",\"Dann den grünen Spargel zufügen und beide Sorten bissfest kochen.\",\"Die Stangen aus dem Topf nehmen und in 3 cm lange Stücke schneiden.\",\"Den Spargelsud für die Sauce beiseitestellen.\",\"Tomaten waschen und vierteln.\",\"Frühlingszwiebeln putzen, waschen und in feine Ringe schneiden.\",\"Nudeln, Spargel, Tomaten und Frühlingszwiebeln in eine große Schüssel geben.\",\"Für die Sauce den Spinat waschen und gut abtropfen lassen.\",\"Dicke Stiele entfernen und die Blätter grob hacken.\",\"Spinat, 150 ml Spargelsud und Öl in einen hohen Rührbecher geben und mit dem Pürierstab fein mixen.\",\"Die Sauce mit Essig, Salz und Pfeffer kräftig abschmecken.\",\"Über den Salat gießen und alles locker durchmischen.\",\"Den Salat mindestens 1 Std. durchziehen lassen, dann servieren.\"],\"avecViande\":true,\"temperature\":\"froid\",\"tags\":[\"Asperges\",\"Saison Printemps\",\"modifié\"],\"source\":\"https://www.kuechengoetter.de/rezepte/nudel-spargel-salat-mit-spinatmarinade-100877\",\"notes\":\"Prévoir AU MOINS 1h de repos avant de servir :\",\"paprikaUid\":\"9244CE12-2089-4994-8C32-8B4D9A3A7A70\"},{\"id\":\"salade-haricots-fraises-lentilles-mrryzesx81j\",\"title\":\"Salade haricots/fraises/lentilles\",\"category\":\"Salade\",\"time\":45,\"servings\":4,\"ingredients\":[[\"oignon botte avec les fanes\",2,\"u\"],[\"haricot vert\",250,\"g\"],[\"fraise\",500,\"g\"],[\"basilic frais\",0.5,\"bouquet\"],[\"huile d'olive\",4,\"c. à soupe\"],[\"vinaigre balsamique\",4,\"c. à soupe\"],[\"miel liquide\",0.5,\"c. à soupe\"],[\"lentille noire\",100,\"g\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Faire chauffer l'huile dans une casserole.\",\"Ajouter les oignons botte et les faire revenir pendant 1 min.\",\"Ajouter les lentilles, les faire revenir brièvement, ajouter l'eau et porter le tout à ébullition.\",\"Baisser le feu, saler, couvrir et laisser mijoter pendant env. 20 min, égoutter les lentilles, saler.\",\"Faire cuire les haricots pendant env. 10 min dans l'eau salée frémissante, les égoutter puis les passer sous l'eau froide.\",\"Dans un saladier, mélanger le vinaigre balsamique avec tous les ingrédients jusqu'au poivre compris.\",\"Ajouter les haricots et les lentilles, mélanger.\",\"Ajouter les fraises avec les fanes d'oignon botte réservés, mélanger et dresser.\",\"Parsemer de basilic.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"Suisse\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/25054/salade-haricotsfraises-lentilles\",\"notes\":\"\",\"paprikaUid\":\"FFEF9D96-C45A-4828-8125-8A98E78D85C4\"},{\"id\":\"salade-green-goddess-mrryzeswdg0\",\"title\":\"Salade Green Goddess\",\"category\":\"Salade\",\"time\":40,\"servings\":4,\"ingredients\":[[\"haricot vert surgelé\",150,\"g\"],[\"pommes de terre nouvelles\",500,\"g\"],[\"persil plat\",1,\"bouquet\"],[\"ciboulette\",1,\"bouquet\"],[\"concombre snack\",4,\"u\"],[\"céleri-branche\",150,\"g\"],[\"vinaigre balsamique blanc\",1,\"c. à soupe\"],[\"œuf\",4,\"u\"],[\"séré demi-gras\",250,\"g\"],[\"mayonnaise\",3,\"c. à soupe\"],[\"câpre\",16,\"u\"],[\"aneth\",0.5,\"bouquet\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Faire cuire les pommes de terre dans l'eau salée frémissante pendant env. 25 min.\",\"Ajouter les haricots pendant les 5 dernières minutes.\",\"Égoutter les pommes de terre et les haricots verts, laisser tiédir et couper les pommes de terre en deux.\",\"Faire cuire les œufs dans l'eau frémissante pendant 7 min, les passer sous l'eau froide puis les écaler.\",\"Réserver env. 2 cs de fines herbes pour la décoration.\",\"Mettre le reste des fines herbes avec la moitié du séré, la mayonnaise, le vinaigre, le sel et poivre dans un verre doseur haut et mixer fin.\",\"Ajouter le reste du séré et mélanger.\",\"Répartir la moitié de la sauce dans des assiettes creuses.\",\"Couper l'œuf en deux, le répartir sur la sauce avec les pommes de terre, les haricots verts, les concombres, le céleri et les fruits du câprier.\",\"Répartir le reste de sauce et les herbes réservées.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"Suisse\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/26705/salade-green-goddess\",\"notes\":\"\",\"paprikaUid\":\"2A1FED01-B7D7-409A-8EE6-DE59299605B3\"},{\"id\":\"salade-grecque-mrryzesvlhc\",\"title\":\"Salade grecque\",\"category\":\"Salade\",\"time\":50,\"servings\":4,\"ingredients\":[[\"vinaigre de vin blanc\",3,\"c. à soupe\"],[\"huile de colza\",4,\"c. à soupe\"],[\"jus de citron\",1,\"c. à café\"],[\"gousse d'ail\",2,\"u\"],[\"origan séché\",1,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"féta\",200,\"g\"],[\"oignon rouge\",2,\"u\"],[\"tomate\",3,\"u\"],[\"concombre\",1,\"u\"],[\"poivron rouge\",1,\"u\"],[\"poivron jaune\",1,\"u\"],[\"olive noire\",100,\"g\"],[\"basilic frais\",1,\"bouquet\"]],\"steps\":[\"Presser l'ail.\",\"Couper la feta en petits dés.\",\"Couper l'oignon en fines rondelles.\",\"Couper les tomates en quartiers.\",\"Couper les concombres en petits dés.\",\"Couper les poivrons en fines lamelles.\",\"Hacher le basilic.\",\"Sauce:  Bien mélanger tous les ingrédients.\",\"Salade:  Mélanger tous les ingrédients dans un saladier.\",\"Incorporer délicatement la sauce.\",\"Selon les goûts, servir avec du basilic.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Grecque\",\"modifié\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"salade-d-ete-bigarree-mrryzesu7k0\",\"title\":\"Salade d’été bigarrée\",\"category\":\"Salade\",\"time\":45,\"servings\":4,\"ingredients\":[[\"fenouil\",3,\"u\"],[\"huile d’olive\",2,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"vinaigre balsamique blanc\",2,\"c. à soupe\"],[\"huile d’olive\",3,\"c. à soupe\"],[\"melon charentais\",1,\"\"],[\"framboises\",100,\"g\"],[\"bleuets\",125,\"g\"],[\"groseille rouge\",125,\"g\"],[\"mini-mozzarellas\",2,\"sachet\"],[\"menthe\",2,\"brin\"],[\"fleur de sel\",0,\"\"]],\"steps\":[\"Préchauffer le four à 220° C.\",\"Couper les fenouils en petits quartiers, répartir sur une plaque chemisée de papier cuisson.\",\"Arroser d’un filet d’huile, saler, poivrer.\",\"Cuisson: env. 30 min au milieu du four.\",\"Retirer, laisser tiédir un peu.\",\"Mélanger le vinaigre balsamique et l’huile dans un saladier, saler, poivrer.\",\"Couper le melon en deux, détacher la chair de l’écorce, épépiner.\",\"Tailler en quartiers, puis en tranches.\",\"Mettre dans le saladier les morceaux de melon, fenouil, baies et mozzarella, mélanger.\",\"Couper grossièrement la menthe, répartir sur la salade, saler, poivrer\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"modifié\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/salade-dete-bigarree-10008018/\",\"notes\":\"\",\"paprikaUid\":\"37CC0F64-7DBE-48CB-B52F-59608D9DEE32\"},{\"id\":\"salade-d-orange-et-fenouil-vinaigrette-au-xeres-et-a-l-origan-mrryzestu9t\",\"title\":\"Salade d’orange et fenouil, vinaigrette au Xérès et à l’origan\",\"category\":\"Salade\",\"time\":10,\"servings\":4,\"ingredients\":[[\"orange\",2,\"u\"],[\"fenouil\",1,\"u\"],[\"oignon rouge\",1,\"u\"],[\"huile d'olive\",4,\"c. à soupe\"],[\"vinaigre de Xérès\",2,\"c. à soupe\"],[\"origan séché\",2,\"pincée\"]],\"steps\":[\"Pelez à vif les oranges et coupez-les en fines tranches.\",\"Lavez et émincez finement le fenouil à l’aide d’une mandoline.\",\"Pelez et émincez finement l’oignon rouge.\",\"Mettez le tout dans un saladier, arrosez d’huile d’olive, de vinaigre, assaisonnez de sel et d’origan séché.\",\"Mélangez bien et laissez mariner au frais 1h minimum.\",\"Donnez un tour de moulin à poivre sur la salade juste avant de passer à table.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"modifié\"],\"source\":\"https://www.elle.fr/Elle-a-Table/Recettes-de-cuisine/Salade-d-orange-et-Fenouil-vinaigrette-au-Xeres-et-a-l-origan-3896193\",\"notes\":\"\",\"paprikaUid\":\"72AFA108-F0F0-4A44-90E7-E41364688515\"},{\"id\":\"salade-d-asperges-avec-petits-pois-et-fraises-mrryzesse3c\",\"title\":\"Salade d’asperges avec petits pois et fraises\",\"category\":\"Salade\",\"time\":30,\"servings\":4,\"ingredients\":[[\"petit pois\",250,\"g\"],[\"asperge verte\",1,\"kg\"],[\"beurre à rôtir\",3,\"c. à soupe\"],[\"oignon\",1,\"u\"],[\"jus de citron\",4,\"c. à soupe\"],[\"moutarde gros grains\",1,\"c. à soupe\"],[\"miel liquide\",1,\"c. à café\"],[\"estragon frais\",3,\"branche\"],[\"huile de colza\",3,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"fraise\",150,\"g\"],[\"feta\",150,\"g\"]],\"steps\":[\"Faire cuire les petits poids pendant 2 à 3 minutes dans l’eau salée bouillante, déverser l’eau et laisser refroidir.\",\"Parer les asperges et les couper en morceaux d'env. 5cm.\",\"Hacher l'oignon finement.\",\"Couper les fraises en fines tranches.\",\"Couper la feta en morceaux.\",\"Faire revenir les asperges pendant env. 5 minutes dans le beurre à rôtir chaud dans une pôle anti-adhésive, ajouter l’oignon, assaisonner et faire revenir pendant encore env. 5 minutes.\",\"Laisser refroidir.\",\"Pour la vinaigrette, réduire en purée le jus de citron avec tous les ingrédients jusqu’à et avec l’huile, assisonner.\",\"Mettre les petits pois et les asperges sur les assiettes et verser la vinaigrette dessus.\",\"Répartir les fraises et la feta dessus.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Asperges\",\"Saison Printemps\",\"modifié\"],\"source\":\"https://www.gemuese.ch/fr/recettes/salade-d-asperges-avec-petits-pois-et-fraises?_gl=1*1ubkczm*_up*MQ..&gclid=EAIaIQobChMItdK7sbK4kQMVepKDBx0SyAWNEAAYASABEgL9oPD_BwE&gbraid=0AAAAA-NhTE5iAnPHfalM4KcSHGDur_dvT\",\"notes\":\"\",\"paprikaUid\":\"F44AA6FB-1DF0-4FD5-94CB-EE81089BE4BA\"},{\"id\":\"salade-de-tortellini-et-sauce-au-yogourt-mrryzesr6sq\",\"title\":\"Salade de tortellini et sauce au yogourt\",\"category\":\"Salade\",\"time\":40,\"servings\":4,\"ingredients\":[[\"tortellini frais\",500,\"g\"],[\"yogourt\",3,\"c. à soupe\"],[\"demi-crème\",3,\"c. à soupe\"],[\"huile de colza\",3,\"c. à soupe\"],[\"vinaigre de vin blanc\",2,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"carotte\",2,\"u\"],[\"concombre\",0.5,\"u\"],[\"tomate\",2,\"u\"],[\"grains de maïs égouttés\",140,\"g\"],[\"fromage à pâte molle\",100,\"g\"]],\"steps\":[\"Préparer les tortellini selon les indications de l'emballage.\",\"Égoutter.\",\"Couper les carottes en fines rondelles (ou les râper grossièrement).\",\"Peler les concombres et les couper en deux et en fines demi-rondelles.\",\"Couper les tomates en petits dés.\",\"Couper le fromage en petits dés.\",\"Pour la sauce, mélanger tous les ingrédients.\",\"Saler et poivrer.\",\"Mélanger les tortellini avec la sauce.\",\"Laisser légèrement refroidir.\",\"Mélanger les carottes, le concombre, les tomates, le maïs et les dés de fromage avec les tortellini.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"Pâtes\",\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2024_FAMI_04/salade-de-tortellini-et-sauce-au-yogourt/\",\"notes\":\"\",\"paprikaUid\":\"A974361C-D9FB-4F2D-89A5-B6F1512A0A2A\"},{\"id\":\"salade-de-tomates-grillees-mrryzesqeju\",\"title\":\"Salade de tomates grillées\",\"category\":\"Salade\",\"time\":60,\"servings\":4,\"ingredients\":[[\"olive noire dénoyautée\",40,\"g\"],[\"pignon\",2,\"c. à soupe\"],[\"persil plat\",2,\"c. à soupe\"],[\"huile d’olive\",2,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"oignon fane\",4,\"u\"],[\"huile d’olive\",6,\"c. à soupe\"],[\"tomate\",800,\"g\"],[\"vinaigre balsamique blanc\",2,\"c. à soupe\"]],\"steps\":[\"Hacher grossièrement les olives et les pignons.\",\"Couper grossièrement le persil.\",\"Mélanger avec l’huile dans un saladier.\",\"Saler, poivrer.\",\"Partager les oignons fanes dans la longueur.\",\"Bien faire chauffer une poêle-gril.\",\"Badigeonner les oignons fanes d’huile, faire griller env. 2 min sur chaque face, retirer.\",\"Couper les tomates en tranches d’env. 1cm d’épaisseur.\",\"Badigeonner d’huile sur chaque face.\",\"Faire griller par portions dans la même poêle, env. 2 min sur chaque face.\",\"Saler, poivrer.\",\"Dresser les tomates et les oignons fanes sur un plat, arroser d’un filet de vinaigre balsamique, répartir dessus la sauce aux olives.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Italie\",\"Saison Été\",\"modifié\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/salade-de-tomates-grillees-10008019/\",\"notes\":\"\",\"paprikaUid\":\"047E128F-91CF-4CEC-B7CB-B1859CA5D5DE\"},{\"id\":\"salade-de-tomates-cerises-poelees-mrryzespm7t\",\"title\":\"Salade de tomates cerises poêlées\",\"category\":\"Salade\",\"time\":40,\"servings\":4,\"ingredients\":[[\"pignon\",3,\"c. à soupe\"],[\"huile d’olive\",2,\"c. à soupe\"],[\"tomate cerise\",600,\"g\"],[\"vinaigre balsamique\",1.5,\"c. à soupe\"],[\"miel liquide\",0.5,\"c. à soupe\"],[\"fleur de sel\",1,\"c. à café\"],[\"poivre\",0,\"\"],[\"mozzarella di bufala\",125,\"g\"],[\"basilic\",0.5,\"bouquet\"]],\"steps\":[\"Faire griller les pignons à sec dans une poêle antiadhésive, retirer.\",\"Bien faire chauffer l’huile dans la poêle.\",\"Faire sauter les tomates env. 3 min en remuant.\",\"Éloigner la poêle du feu, arroser les tomates d’un filet de vinaigre et de miel, saler, poivrer, laisser tiédir un peu, dresser.\",\"Effilocher la mozzarella, effeuiller le basilic, répartir les deux sur la salade avec les pignons.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Italie\",\"Saison Été\",\"modifié\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/salade-de-tomates-cerises-polees-10007955/\",\"notes\":\"\",\"paprikaUid\":\"C64492DC-CE79-4131-B964-E072A951FDD2\"},{\"id\":\"salade-de-smashed-potatoes-recette-swissmilk-mrryzeso9le\",\"title\":\"Salade de smashed potatoes\",\"category\":\"Salade\",\"time\":75,\"servings\":4,\"ingredients\":[[\"pomme de terre nouvelle\",500,\"g\"],[\"beurre\",50,\"g\"],[\"mayonnaise\",2,\"c. à soupe\"],[\"yogourt grecque\",150,\"g\"],[\"jus de citron\",0.5,\"u\"],[\"moutarde\",2,\"cc de\"],[\"gousse d'ail\",2,\"u\"],[\"aneth frais\",0.5,\"bouquet\"],[\"persil\",0.5,\"bouquet\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"concombre\",1,\"u\"],[\"oignon nouveau\",1,\"u\"]],\"steps\":[\"Cuire les pommes de terre à cœur 20-30 min dans de l'eau salée.\",\"Test de cuisson: piquer une pomme de terre avec un couteau. Lever le couteau. Si la pomme de terre tombe sans résistance, elle est cuite.\",\"Verser l'eau.\",\"Mettre les pommes de terre sur la plaque chemisée de papier sulfurisé.\",\"Couper les grandes pommes de terre en deux ou en quatre.\",\"Les aplatir avec un presse-purée ou une tasse.\",\"Répartir les flocons de beurre par-dessus, saler généreusement.\",\"Enfourner dans le milieu du four froid et cuire 40-50 min à 180°C chaleur tournante (chaleur traditionnelle: 200°C) jusqu'à ce qu'elles soient croustillantes.\",\"Sauce: mélanger la mayonnaise, le yogourt, le jus de citron, la moutarde, l'ail, l'aneth, le persil, le sel et le poivre.\",\"Incorporer le concombre coupé en petits dés et l'oignon finement coupé.\",\"Ajouter les pommes de terre à la salade à l'aide du papier sulfurisé.\",\"Mélanger et servir aussitôt.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2024_DIVE_09/salade-de-smashed-potatoes/\",\"notes\":\"\",\"paprikaUid\":\"4F31D524-9C60-4329-85AE-DD5ED4090A6C\"},{\"id\":\"salade-de-saucisse-et-pain-a-l-avoine-mrryzesnx24\",\"title\":\"Salade de saucisse et pain à l'avoine\",\"category\":\"Salade\",\"time\":220,\"servings\":4,\"ingredients\":[[\"oignon\",0.5,\"u\"],[\"paprika\",0.25,\"c. à café\"],[\"ciboulette\",2,\"c. à soupe\"],[\"concombre au vinaigre\",4,\"u\"],[\"vinaigre de vin aux herbes\",2,\"c. à soupe\"],[\"huile de tournesol\",4,\"c. à soupe\"],[\"farine rustique\",400,\"g\"],[\"sucre\",0.5,\"c. à café\"],[\"levure\",0.5,\"sachet\"],[\"lait coupé d'eau (½ lait et ½ eau)\",3,\"dl\"],[\"Gruyère corsé\",75,\"g\"],[\"œuf dur\",3,\"u\"],[\"moutarde\",0.5,\"c. à soupe\"],[\"mayonnaise\",0.5,\"c. à soupe\"],[\"flocons d'avoine complète\",100,\"g\"],[\"cervelas\",4,\"u\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Faire griller les flocons d’avoine dans une poêle, laisser refroidir dans un grand saladier.\",\"Ajouter la farine, le sel, le sucre et la levure, mélanger.\",\"Verser le lait coupé d’eau, pétrir en une pâte molle et lisse.\",\"Laisser lever à couvert et à température ambiante env. 1 h ½ du double de volume.\",\"Disposer la pâte dans le moule préparé, badigeonner avec un peu d’eau, saupoudrer avec les flocons d’avoine, laisser lever une nouvelle fois env. 30 minutes.\",\"Enfourner env. 50 min dans la moitié inférieure du four préchauffé à 180° C.\",\"Sortir, laisser refroidir un peu, démouler le pain à l’avoine, laisser refroidir sur une grille.\",\"Bien mélanger la moutarde et tous les ingrédients jusque et y compris la ciboulette dans un récipient, assaisonner.\",\"Mélanger les cervelas et tous les ingrédients jusque et y compris le gruyère avec la sauce.\",\"Dresser la salade, répartir les oeufs par-dessus.\",\"Servir avec le pain à l’avoine.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"Suisse\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/5614/salade-de-saucisse-et-pain-a-l-avoine\",\"notes\":\"\",\"paprikaUid\":\"EF5238CF-DE3B-4CA5-AFF2-7F3DB1649B18\"},{\"id\":\"salade-de-roquette-aux-poires-et-a-la-ricotta-mrryzesmhdq\",\"title\":\"Salade de roquette aux poires et à la ricotta\",\"category\":\"Salade\",\"time\":10,\"servings\":4,\"ingredients\":[[\"roquette\",200,\"g\"],[\"poire\",2,\"u\"],[\"citron\",1,\"u\"],[\"vinaigre balsamique blanc\",2,\"c. à soupe\"],[\"huile d'olive\",4,\"c. à soupe\"],[\"ricotta\",100,\"g\"],[\"moutarde au miel\",2,\"c. à soupe\"],[\"miel liquide\",1,\"c. à soupe\"],[\"câpre\",4,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"thym\",4,\"brin\"]],\"steps\":[\"Bien mélanger la ricotta et le miel à l'aide d'un fouet, assaisonner.\",\"Dresser la roquette et les poires.\",\"Bien mélanger la moutarde, le vinaigre et l'huile.\",\"Assaisonner, verser sur la salade, garnir de ricotta.\",\"Parsemer de câpres, de thym et de zeste de citron.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Italie\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/27196/salade-de-roquette-aux-poires-et-a-la-ricotta\",\"notes\":\"\",\"paprikaUid\":\"1F04A651-DBAE-4604-9B8F-D9D0C3A95673\"},{\"id\":\"salade-de-riz-au-curry-mrryzesll1i\",\"title\":\"Salade de riz au curry\",\"category\":\"Salade\",\"time\":60,\"servings\":4,\"ingredients\":[[\"eau\",6,\"dl\"],[\"sel\",0,\"\"],[\"riz\",250,\"g\"],[\"pomme rouge\",2,\"u\"],[\"yogourt nature\",180,\"g\"],[\"mayonnaise\",50,\"g\"],[\"jus d’orange\",1,\"dl\"],[\"curry doux\",2,\"c. à soupe\"],[\"poivre\",0,\"\"],[\"gingembre\",1,\"cm\"],[\"mélange de fruits secs et de noix\",100,\"g\"]],\"steps\":[\"Porter l'eau à ébullition, saler.\",\"Ajouter le riz en remuant et porter à ébullition.\",\"Baisser le feu, laisser mijoter env. 20 min à couvert sur feu doux jusqu'à ce que le riz ait absorbé toute l'eau et soit al dente.\",\"Démêler les grains à la fourchette.\",\"Couper les pommes en quatre.\",\"Retirer le cœur et couper en lamelles.\",\"Mélanger dans un saladier yogourt, mayonnaise, jus d’orange et curry.\",\"Saler, poivrer.\",\"Peler et râper finement le gingembre, ajouter.\",\"Ajouter riz, pommes et noix.\",\"Mélanger.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"modifié\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/salade-de-riz-au-curry-10008017/\",\"notes\":\"\",\"paprikaUid\":\"EB3456F6-174B-4917-949E-DF5E7480F6BF\"},{\"id\":\"salade-de-riz-mrryzeslffj\",\"title\":\"Salade de riz au thon\",\"category\":\"Salade\",\"time\":30,\"servings\":4,\"ingredients\":[[\"poivron de couleur\",2,\"u\"],[\"tomate cerise\",150,\"g\"],[\"persil plat\",1,\"bouquet\"],[\"noix de cajou\",3,\"c. à soupe\"],[\"vinaigre de vin blanc\",3,\"c. à soupe\"],[\"huile de colza\",3,\"c. à soupe\"],[\"moutarde à l’ancienne\",1,\"c. à soupe\"],[\"thon rosé à l'huile\",1,\"boîte\"],[\"riz long grain\",100,\"g\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Faire cuire le riz al dente dans l'eau salée frémissante, l'égoutter.\",\"Ajouter les poivrons.\",\"Mélanger la moutarde, le vinaigre et l'huile, assaisonner.\",\"Mélanger le thon et les tomates avec le riz, parsemer de persil et de noix de cajou.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Poisson\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/14327/salade-de-riz\",\"notes\":\"\",\"paprikaUid\":\"199DF7B7-A193-4412-B22D-7C8C4980D1A3\"},{\"id\":\"salade-de-ratatouille-a-la-feta-mrryzeskl9s\",\"title\":\"Salade de ratatouille à la feta\",\"category\":\"Salade\",\"time\":60,\"servings\":2,\"ingredients\":[[\"aubergine\",300,\"g\"],[\"courgette\",200,\"g\"],[\"poivron\",1,\"u\"],[\"échalote\",1,\"u\"],[\"gousse d'ail\",2,\"u\"],[\"huile d’olive\",0.5,\"c. à soupe\"],[\"baguette\",1,\"u\"],[\"moutarde\",1,\"c. à café\"],[\"vinaigre balsamique\",1,\"c. à soupe\"],[\"huile d’olive\",0.5,\"c. à soupe\"],[\"tomate\",200,\"g\"],[\"feta\",100,\"g\"],[\"basilic\",2,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Peler les tomates, les aubergines et les courgettes et les couper en petits dés.\",\"Peler le poivron et la couper en morceaux.\",\"Couper l'échalote en quartiers.\",\"Couper un ail en lamelles et l'autre pressé.\",\"Emietter la féta.\",\"Hacher grossièrement le basilic.\",\"Couper la baguette en deux dans la longueur.\",\"Mélanger dans un saladier les aubergines et tous les ingrédients jusqu’au poivre compris.\",\"Répartir sur une plaque chemisée de papier cuisson.\",\"Cuisson: env. 20 min au milieu du four préchauffé à 200° C.\",\"Retirer les légumes.\",\"Poser la baguette sur la grille.\",\"Faire dorer env. 5 min au milieu du four.\",\"Retirer la baguette, répartir l’ail dessus.\",\"Mélanger moutarde, vinaigre et huile.\",\"Ajouter légumes, tomates, feta et basilic.\",\"Mélanger et rectifier l’assaisonnement.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Automne\",\"Saison Été\",\"modifié\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/salade-de-ratatouille-a-la-feta-10004719/\",\"notes\":\"\",\"paprikaUid\":\"1FB26D96-FB7F-43CA-9D53-04C0CCA508C0\"},{\"id\":\"salade-de-peches-et-mozzarella-avec-pommes-de-terre-et-sauce-mojo-mrryzesj2vw\",\"title\":\"Salade de pêches et mozzarella avec pommes de terre et sauce Mojo\",\"category\":\"Salade\",\"time\":30,\"servings\":4,\"ingredients\":[[\"mozzarella\",2,\"paquet\"],[\"pêche\",3,\"u\"],[\"pommes de terre ferme\",600,\"g\"],[\"huile d’olive\",2,\"c. à soupe\"],[\"cumin\",0.5,\"c. à soupe\"],[\"persil plat\",1,\"botte\"],[\"gousse d’ail\",1,\"u\"],[\"huile d’olive\",1,\"dl\"],[\"citron\",1,\"u\"],[\"piment\",0.5,\"\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"noix de cajou\",40,\"g\"]],\"steps\":[\"Griller les noix.\",\"Déchirer la mozzarella en gros morceaux.\",\"Couper la pêche en tranches.\",\"Râper le zeste du citron et presser son jus.\",\"Répartir la mozzarella et la pêche sur un plat.\",\"Laver les pommes de terre et les couper en tranches avec la peau.\",\"Mélanger l'huile d'olive, le sel, le paprika et le cumin dans un plat résistant à la chaleur.\",\"Mélanger les tranches de pommes de terre avec l'huile épicée et les faire dorer au four à 180 °C pendant 25 à 35 minutes, en les retournant une fois et en les badigeonnant du reste de l'huile épicée.\",\"Mojo :\",\"Effeuiller le persil.\",\"Préparer l'ail et le réduire en purée avec l'huile.\",\"Couper le piment en quatre, l'épépiner et le hacher très finement.\",\"L'incorporer au mojo avec le jus et le zeste de citron.\",\"Assaisonner avec du sel et du poivre.\",\"Verser la moitié de la sauce sur la salade de pêches et de mozzarella.\",\"Parsemer de noix de cajou.\",\"Servir le reste du mojo avec les pommes de terre.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"modifié\"],\"source\":\"https://www.patate.ch/fr/recettes/lentree/salade-de-peches-et-de-mozzarella-avec-pommes-de-terre.html\",\"notes\":\"\",\"paprikaUid\":\"C6B0B35E-62BC-4E02-917A-261D4DE187C4\"},{\"id\":\"salade-de-pates-aux-legumes-d-ete-mrryzesg2ug\",\"title\":\"Salade de pâtes aux légumes d'été\",\"category\":\"Salade\",\"time\":40,\"servings\":4,\"ingredients\":[[\"aubergine\",500,\"g\"],[\"courgette\",400,\"g\"],[\"oignon rouge\",1,\"u\"],[\"basilic\",0.5,\"bouquet\"],[\"huile d'olive\",5,\"c. à soupe\"],[\"vinaigre balsamique blanc\",5,\"c. à soupe\"],[\"fromage de chèvre\",150,\"g\"],[\"pâtes\",250,\"g\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Mélanger les aubergines et tous les ingrédients jusqu’au poivre compris sur une plaque chemisée de papier cuisson.\",\"Faire cuire env. 15 min au milieu du four préchauffé à 200° C.\",\"Retirer la plaque, mettre les légumes dans un grand saladier.\",\"Cuire les pâtes al dente dans l’eau salée bouillante, égoutter.\",\"Ajouter les pâtes aux légumes, mélanger.\",\"Verser le vinaigre et l’huile, assaisonner.\",\"Laisser reposer la salade à couvert env. 15 minutes.\",\"Incorporer le fromage et le basilic à la salade de pâtes.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Italie\",\"Pâtes\",\"Saison Été\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/7565/salade-de-pates-aux-legumes-d-ete\",\"notes\":\"\",\"paprikaUid\":\"2964BCC1-8AEF-4988-9B1C-E413E21A3BE2\"},{\"id\":\"salade-de-pates-aux-concombres-et-aux-tomates-mrryzesddkq\",\"title\":\"Salade de pâtes aux concombres et aux tomates\",\"category\":\"Salade\",\"time\":25,\"servings\":4,\"ingredients\":[[\"concombre\",1,\"u\"],[\"oignon rouge\",1,\"u\"],[\"tomate cerise\",200,\"g\"],[\"parmesan\",100,\"g\"],[\"pâtes\",300,\"g\"],[\"sauce à salade italienne\",2,\"dl\"],[\"mélange d'épices pour salades\",2,\"c. à soupe\"]],\"steps\":[\"Faire cuire les pâtes al dente dans l'eau salée frémissante.\",\"Les égoutter, les laisser refroidir un peu puis les mettre dans un saladier.\",\"Mélanger les concombres et tous les autres ingrédients avec les pâtes.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Italie\",\"Pâtes\",\"Saison Été\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/26841/salade-de-pates-aux-concombres-et-aux-tomates\",\"notes\":\"\",\"paprikaUid\":\"7B618371-ED4A-450F-A116-C6D0BF8B7536\"},{\"id\":\"salade-de-pates-au-pesto-mrryzesccam\",\"title\":\"Salade de pâtes au pesto\",\"category\":\"Salade\",\"time\":35,\"servings\":4,\"ingredients\":[[\"pignon de pin\",2,\"c. à soupe\"],[\"basilic\",1,\"bouquet\"],[\"gousse d’ail\",1,\"u\"],[\"piment rouge\",0.5,\"u\"],[\"tomate cerise\",250,\"g\"],[\"huile d'olive\",3,\"c. à soupe\"],[\"vinaigre balsamique blanc\",3,\"c. à soupe\"],[\"mozzarella\",150,\"g\"],[\"pâtes\",250,\"g\"],[\"mortadelle\",70,\"g\"],[\"sel\",0,\"\"]],\"steps\":[\"Piler ensemble le basilic, l’ail et les pignons de pin dans le mortier ou les mixer, saler.\",\"Incorporer l’huile d’olive peu à peu.\",\"Ajouter le vinaigre, mélanger.\",\"Ajouter le piment,mélanger.\",\"Cuire les pâtes al dente dans l’eau salée bouillante, égoutter, laisser tiédir un peu.\",\"Mélanger les pâtes vec la sauce, laisser macérer env. 15 minutes.\",\"Incorporer les tomates et la mozzarella.\",\"Faire rissoler les nières de mortadelle dans une poêle antiadhésive env. 2 min sans ajouter de graisse.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Italie\",\"Pâtes\",\"Saison Été\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/6228/salade-de-pates-au-pesto\",\"notes\":\"\",\"paprikaUid\":\"3AA21EF3-3732-41E9-B381-97D7673CA75C\"},{\"id\":\"salade-de-printemps-mrryzesabxm\",\"title\":\"Salade de printemps\",\"category\":\"Salade\",\"time\":30,\"servings\":4,\"ingredients\":[[\"beurre à rôtir\",1,\"c. à soupe\"],[\"asperge verte\",500,\"g\"],[\"petit poid\",150,\"g\"],[\"radis, en rondelles\",1,\"botte\"],[\"concombre\",0.5,\"u\"],[\"roquette\",50,\"g\"],[\"salade Batavia\",300,\"g\"],[\"vinaigre de pomme\",0.5,\"dl\"],[\"huile de colza\",0.5,\"dl\"],[\"échalote\",1,\"u\"],[\"moutarde à gros grains\",1,\"c. à café\"],[\"miel\",1,\"c. à café\"],[\"roquette\",50,\"g\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Parer les asperges et les couper en morceaux d'env. 5cm de long.\",\"Couper les radis en rondelles.\",\"Hacher grossièrement l'échalote.\",\"Eplucher la concombre et la couper en demi-rondelles.\",\"Faire chauffer le beurre à rôtir dans une poêle antiadhérente.\",\"Faire revenir les asperges et les petits poids pendant 5 à 8 min. en remuant, assaisonner et laisser refroidir complètement.\",\"Mettre les radis et tous les ingrédients jusqu’à et y compris la salade Batavia dans un saladier, ajouter les asperges et les fèves grillées et mélanger.\",\"Verser le vinaigre et tous les ingrédients jusqu’à et y compris la roquette dans le mixeur, réduire brièvement en purée et assaisonner.\",\"Mélanger la salade avec la sauce et servir.\",\"Servir avec du fromage frit, de la feta ou du camembert.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Asperges\",\"Saison Printemps\",\"modifié\"],\"source\":\"https://www.gemuese.ch/fr/recettes/salade-de-printemps?_gl=1*wzlj9f*_up*MQ..&gclid=EAIaIQobChMItdK7sbK4kQMVepKDBx0SyAWNEAAYASABEgL9oPD_BwE&gbraid=0AAAAA-NhTE5iAnPHfalM4KcSHGDur_dvT\",\"notes\":\"\",\"paprikaUid\":\"6B0013F9-9F69-4DE1-A09C-589A3A80EF6E\"},{\"id\":\"salade-de-poulet-epicee-mrryzes9x27\",\"title\":\"Salade de poulet épicée\",\"category\":\"Salade\",\"time\":60,\"servings\":4,\"ingredients\":[[\"bouillon de poule\",5,\"dl\"],[\"blanc de poulet\",600,\"g\"],[\"mayonnaise\",8,\"c. à soupe\"],[\"curry doux\",2,\"c. à soupe\"],[\"paprika doux\",1,\"c. à soupe\"],[\"orange\",2,\"u\"],[\"lard à rôtir\",50,\"g\"],[\"beurre\",1,\"c. à soupe\"],[\"champignon de Paris\",200,\"g\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"iceberg\",0.5,\"u\"],[\"noix\",60,\"g\"]],\"steps\":[\"Porter le bouillon à ébullition.\",\"Réduire le feu juste avant qu'il ne frémisse.\",\"Ajouter les blancs de poulet et pocher 10-12 min.\",\"Sortir le poulet du bouillon et laisser refroidir légèrement.\",\"Couper en dés d'env. 2 cm.\",\"Fileter l'orange, presser le jus et réserver.\",\"Couper les champignons en tranches.\",\"Hacher les noix.\",\"Mélanger la mayonnaise avec le curry, le paprika, le sel et le jus d'orange.\",\"Ajouter les filets d'orange et les dés de poulet, mélanger.\",\"Saisir le lard 2-3 min des deux côtés.\",\"Placer sur du papier ménage.\",\"Chauffer le beurre dans la même poêle.\",\"Saisir les champignons à feu vif env. 3 min, assaisonner.\",\"Placer les feuilles de salade sur des assiettes.\",\"Dresser la salade de poulet, ajouter les champignons et le lard.\",\"Répartir le reste de la sauce de la salade de poulet par-dessus.\",\"Parsemer de noix.\"],\"avecViande\":true,\"temperature\":\"froid\",\"tags\":[\"Poulet\",\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/KO2025_SBLV_08/salade-de-poulet-epicee/\",\"notes\":\"\",\"paprikaUid\":\"A7615A54-C1FA-475B-ACD8-197867804236\"},{\"id\":\"salade-de-poulet-et-pasteque-mrryzes7bt5\",\"title\":\"Salade de poulet et pastèque\",\"category\":\"Salade\",\"time\":20,\"servings\":4,\"ingredients\":[[\"poulet rôti\",1000,\"g\"],[\"pastèque\",500,\"g\"],[\"parmesan\",60,\"g\"],[\"noisette\",60,\"g\"],[\"citron\",1,\"u\"],[\"salade composée\",60,\"g\"],[\"sel\",0,\"\"],[\"poivre noir\",0,\"\"],[\"huile d'olive\",0,\"\"]],\"steps\":[\"Couper la pastèque en morceaux de 2 cm et déposer dans un bol.\",\"Détacher le poulet en filaments pas trop fins et ajouter au bol.\",\"Peler le citron et couper la pulpe en morceaux et ajouter au bol.\",\"Couper des copeaux de fromage.\",\"Hacher grossièrement les noisettes et ajouter au bol.\",\"Ajouter le thym et l'huile d'olive.\",\"Assaisonner avec sel et poivre.\",\"Mélanger bien.\",\"Parsemer des copeaux de fromage.\"],\"avecViande\":true,\"temperature\":\"froid\",\"tags\":[\"Poulet\",\"modifié\"],\"source\":\"https://www.giallozafferano.fr/recettes/salade-de-poulet-et-pasteque.html\",\"notes\":\"\",\"paprikaUid\":\"224A9485-47F5-414F-B3D9-95D32FE731C2\"},{\"id\":\"salade-de-pommes-de-terre-a-la-chicoree-rouge-mrryzes7dv3\",\"title\":\"Salade de pommes de terre à la chicorée rouge\",\"category\":\"Salade\",\"time\":40,\"servings\":4,\"ingredients\":[[\"pomme de terre ferme\",400,\"g\"],[\"pomme de terre bleue\",400,\"g\"],[\"patate douce\",400,\"g\"],[\"échalote\",1,\"u\"],[\"chicorée rouge\",200,\"g\"],[\"huile d'olive\",1,\"c. à soupe\"],[\"vinaigre balsamique blanc\",5,\"c. à soupe\"],[\"huile de tournesol\",4,\"c. à soupe\"],[\"sirop d'érable\",1,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"sauce de soja\",3,\"c. à soupe\"]],\"steps\":[\"Mélanger les pommes de terre et tous les ingrédients jusqu'au poivre compris dans un saladier.\",\"Répartir le tout sur une plaque recouverte de papier cuisson.\",\"Env. 25 min au milieu du four préchauffé à 220 °C.\",\"Laisser tiédir hors du four.\",\"Mélanger le vinaigre et tous les ingrédients jusqu'à l'échalote comprise.\",\"Ajouter les pommes de terre tièdes et la chicorée rouge, mélanger.\",\"Dresser.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Poulet\",\"Suisse\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/27460/salade-de-pommes-de-terre-a-la-chicoree-rouge\",\"notes\":\"\",\"paprikaUid\":\"7E70DD57-5A42-450F-9693-4B32F6267356\"},{\"id\":\"salade-de-pommes-de-terre-aux-choux-de-bruxelles-mrryzes6svo\",\"title\":\"Salade de pommes de terre aux choux de Bruxelles\",\"category\":\"Salade\",\"time\":25,\"servings\":2,\"ingredients\":[[\"oignon\",1,\"u\"],[\"gousse d’ail\",1,\"u\"],[\"chou de Bruxelles\",250,\"g\"],[\"pomme de terre ferme\",250,\"g\"],[\"huile d'olive\",2,\"c. à soupe\"],[\"vinaigre de vin rouge\",1,\"c. à soupe\"],[\"Gorgonzola\",100,\"g\"],[\"bouillon de légumes\",1,\"dl\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Cuire les pommes de terre à la veille.\",\"Préparer les choux de Bruxelles.\",\"Peler les pommes de terre et les couper en morceaux.\",\"Faire chauffer l'huile dans une casserole.\",\"Y faire suer l'oignon pendant 3 min.\",\"Ajouter l'ail et poursuivre brièvement la cuisson.\",\"Retirer et mettre dans un récipient pour mixeur.\",\"Ajouter l'eau, le vinaigre et le fromage.\",\"Mixer.\",\"Faire chauffer l'huile dans la même casserole.\",\"Y faire revenir les choux de Bruxelles pendant env. 5 min.\",\"Ajouter le bouillon et porter à ébullition.\",\"Baisser le feu, couvrir et laisser mijoter env. 5 min.\",\"Mettre les choux de Bruxelles dans un récipient et les laisser tiédir.\",\"Ajouter les pommes de terre aux choux de Bruxelles.\",\"Verser la sauce, mélanger et assaisonner.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Hiver\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/28398/salade-de-pommes-de-terre-aux-choux-de-bruxelles\",\"notes\":\"\",\"paprikaUid\":\"DBE5E18F-EC18-448F-A814-4A3DABF4EA23\"},{\"id\":\"salade-de-pommes-de-terre-aux-champignons-de-paris-mrryzes4v3t\",\"title\":\"Salade de pommes de terre aux champignons de Paris\",\"category\":\"Salade\",\"time\":35,\"servings\":4,\"ingredients\":[[\"pommes de terre nouvelle\",1,\"kg\"],[\"champignons de Paris bruns\",250,\"g\"],[\"oignon nouveau\",2,\"botte\"],[\"petit radis\",1,\"bouquet\"],[\"vinaigre de vin aux herbes\",3,\"c. à soupe\"],[\"huile de colza\",1,\"dl\"],[\"beurre\",0,\"\"],[\"moutarde à l’ancienne\",2,\"c. à café\"],[\"poivre\",0,\"\"],[\"sel\",0,\"\"]],\"steps\":[\"Pour la sauce, mélanger la moutarde avec le vinaigre et l’huile, puis rectifier l’assaisonnement.\",\"Couper les pommes de terre dans la longueur en deux ou en trois selon leur taille, les faire cuire à couvert dans un peu d’eau bouillante salée pendant env. 15 min.\",\"Les égoutter et les laisser refroidir un peu.\",\"Couper les radis et les oignons botte en rondelles, les ajouter à la sauce avec les pommes de terre et mélanger le tout.\",\"Faire fondre le beurre dans une poêle antiadhésive.\",\"Y faire suer les champignons de Paris coupés en morceaux pendant env. 3 min.\",\"Les assaisonner, les laisser refroidir un peu et les incorporer à la salade.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Suisse\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/8415/salade-de-pommes-de-terre-aux-champignons-de-paris\",\"notes\":\"\",\"paprikaUid\":\"4C4521A4-009D-4432-AAE1-8A4186A429AE\"},{\"id\":\"salade-de-pommes-de-terre-mrryzes3x1b\",\"title\":\"Salade de pommes de terre\",\"category\":\"Salade\",\"time\":80,\"servings\":4,\"ingredients\":[[\"pommes de terre ferme\",1,\"kg\"],[\"bouillon\",1.5,\"dl\"],[\"oignon\",1,\"u\"],[\"vinaigre de vin blanc\",4,\"c. à soupe\"],[\"moutarde\",1,\"c. à soupe\"],[\"mayonnaise\",2,\"c. à soupe\"],[\"yogourt\",3,\"c. à soupe\"],[\"huile de colza\",2,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"ciboulette\",3,\"c. à soupe\"]],\"steps\":[\"Faire cuire les pommes de terre en robe des champs 20-30 min.\",\"Les rincer brièvement à l'eau froide et les peler encore chaudes, les couper en rondelles et les mettre dans un grand saladier.\",\"Hacher finement l'oignon et la ciboulette.\",\"Porter le bouillon à ébullition avec l'oignon.\",\"Ajouter le vinaigre et verser sur les rondelles de pomme de terre.\",\"Laisser reposer env. 30 min en remuant de temps en temps.\",\"Mélanger la moutarde, la mayonnaise, le yogourt et l'huile de colza, saler, poivrer.\",\"Ajouter aux pommes de terre, mélanger.\",\"Rectifier l'assaisonnement, dresser et parsemer de ciboulette.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Suisse\",\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM_div_1013_01/salade-de-pommes-de-terre/\",\"notes\":\"\",\"paprikaUid\":\"9A701628-F70D-4DBE-AAF9-A785F189E565\"},{\"id\":\"salade-de-pasteque-epicee-mrryzes3vn8\",\"title\":\"Salade de pastèque épicée\",\"category\":\"Salade\",\"time\":10,\"servings\":6,\"ingredients\":[[\"pastèque\",1,\"u\"],[\"feta\",90,\"g\"],[\"sauce mexicaine\",7,\"ml\"],[\"estragon\",2,\"brin\"],[\"lime\",1,\"u\"],[\"pistache\",125,\"ml\"]],\"steps\":[\"Dans un grand bol, déposez la pastèque, le feta, l’assaisonnement Tajín et l’estragon, si désiré.\",\"Zestez la lime au-dessus du bol, puis pressez-la.\",\"Mélangez le tout.\",\"Répartissez les pistaches sur la salade et servez.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"modifié\"],\"source\":\"https://ici.radio-canada.ca/mordu/recettes/7976/salade-melon-eau-epicee\",\"notes\":\"\",\"paprikaUid\":\"861451BF-0B09-4CBE-ADA9-A86FA91B04C5\"},{\"id\":\"salade-de-pasteque-et-de-feta-mrryzes1abl\",\"title\":\"Salade de pastèque et de féta\",\"category\":\"Saison Été\",\"time\":30,\"servings\":4,\"ingredients\":[[\"parée, coupée en dés\",800,\"g pastèque\"],[\"dés\",300,\"g féta coupé en\"],[\"ciselée\",1,\"bottes menthe ou de coriandre\"],[\"blanc\",3,\"c. à soupe vinaigre balsamique\"],[\"huile\",3,\"c. à soupe\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"rondelles\",1,\"oignon rouge coupé en\"],[\"menthe pour décorer\",\"\",\"\"]],\"steps\":[\"Salade:\",\"Mélanger la pastèque, le fromage et la menthe/coriandre.\",\"Incorporer l'huile, le sel et le poivre dans le vinaigre balsamique.\",\"Arroser la salade d'un filet de vinaigrette.\",\"Mélanger brièvement.\",\"Décorer avec les rondelles d'oignon et la menthe/coriandre.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Saison Été\",\"Salade\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM201507_22/salade-de-pasteque-et-de-feta/\",\"notes\":\"\",\"paprikaUid\":\"080533BC-F66E-4BBB-BE74-38E92B3C5709\"},{\"id\":\"salade-de-pasteque-mrryzes06ki\",\"title\":\"Salade De Pastèque\",\"category\":\"A\",\"time\":25,\"servings\":4,\"ingredients\":[[\"Pastèque (pastèque) 1,7 kg\",\"\",\"\"],[\"Laitue iceberg 180 g\",\"\",\"\"],[\"Speck 70 g\",\"\",\"\"],[\"Amandes mondées 80 g\",\"\",\"\"],[\"Graines de citrouille décortiqués 40 g\",\"\",\"\"],[\"Huile d'olive extra vierge 30 g\",\"\",\"\"],[\"Menthe à volonté\",\"\",\"\"],[\"Sel fin à volonté\",\"\",\"\"],[\"Poivre noir à volonté\",\"\",\"\"],[\"Vinaigre balsamique 20 g\",\"\",\"\"]],\"steps\":[\"Pour réaliser la salade de pastèque, prenez le speck et retirez la partie grasse avec un couteau 1 , puis réduisez-le d'abord en lanières puis en cubes 2 et mettez-le de côté. Occupez-vous de la laitue iceberg : coupez-la en deux, retirez le trognon central 3\",\"et coupez-la en fines lanières 4 , rincez la laitue coupée sous l'eau courante puis séchez-la avec un chiffon et mettez-la de côté. Maintenant, faites griller dans une poêle bien chaude d'abord les amandes : environ 3 minutes à feu moyen, en les retournant souvent suffiront 5 . Faites de même, dans une autre poêle, avec les graines de courge mais réduisez le temps : 1 minute suffira 6 . Mettez de côté.\",\"Prenez la pastèque et coupez-la en deux 7 , pour obtenir la quantité indiquée dans la recette ; découpez des tranches d'environ 2 cm d'épaisseur 8 , retirez la peau et la partie la plus claire de la pastèque qui est amère et dure 9 : vous obtiendrez environ 700 g de pulpe.\",\"Découpez des cubes de 2 cm dans chaque tranche 10 , enfin retirez les pépins 11 . Tout est prêt pour composer la salade de pastèque : dans un grand bol, versez la laitue iceberg, les amandes grillées 12\",\"et les graines de courge grillées, ajoutez le speck en dés 13 , salez 14 et poivrez à votre goût et assaisonnez avec l'huile d'olive 15 .\",\"Mélangez, puis ajoutez en dernier les cubes de pastèque, assaisonnez avec le vinaigre balsamique 16 et mélangez à nouveau pour amalgamer toutes les saveurs. Enfin, parfumez avec des feuilles de menthe fraîche 17 . Votre fraîche salade de pastèque est prête à être servie 18 !\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"A\"],\"source\":\"https://www.giallozafferano.fr/recettes/salade-de-pasteque.html\",\"notes\":\"\",\"paprikaUid\":\"C01EEC77-0A3E-41FF-B31F-AB4193F6807D\"},{\"id\":\"salade-de-melon-et-de-concombre-mrryzerz4l2\",\"title\":\"Salade de melon et de concombre\",\"category\":\"Plat principal\",\"time\":20,\"servings\":4,\"ingredients\":[[\"pastéques, en morceaux\",800,\"g\"],[\"charentais, en morceaux\",500,\"g melons\"],[\"concombre, coupé en deux dans le sens de la longueur et en tranches d’env. 3 mm d’épaisseur\",1,\"\"],[\"feta, en morceaux\",200,\"g\"],[\"menthe, éffeuillées, coupées grossièrement\",5,\"branches\"],[\"citron, zeste râpé et jus\",1,\"\"],[\"d’olive\",4,\"c. à soupe huile\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Mélanger les melons et le concombre.\",\"Saupoudrer de feta et de menthe.\",\"Mélanger le jus de citron, le zeste râpé et l’huile avec le sel et verser sur la salade.\",\"Poivrer et servir.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Saison Été\",\"Salade\"],\"source\":\"https://www.gemuese.ch/fr/recettes/salade-de-melon-et-de-concombre?_gl=1*1mfrnbc*_up*MQ..&gclid=EAIaIQobChMItdK7sbK4kQMVepKDBx0SyAWNEAAYASABEgL9oPD_BwE&gbraid=0AAAAA-NhTE5iAnPHfalM4KcSHGDur_dvT\",\"notes\":\"\",\"paprikaUid\":\"CDB8BDF0-1213-488A-890C-F1554382330F\"},{\"id\":\"salade-de-melon-au-jambon-cru-et-a-la-ricotta-mrryzerzwbu\",\"title\":\"Salade de melon au jambon cru et à la Ricotta\",\"category\":\"Italie\",\"time\":20,\"servings\":4,\"ingredients\":[[\"citrons\",1,\"\"],[\"charentais\",1,\"melons\"],[\"Galia\",1,\"melon\"],[\"basilic\",2,\"brin\"],[\"ricotta\",125,\"g\"],[\"liquide\",2,\"c. à soupe miel\"],[\"tranches\",100,\"g jambon cru en\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"thym\",2,\"brin\"]],\"steps\":[\"Lisser la ricotta au fouet.\",\"La répartir sur les assiettes.\",\"Arroser de miel et assaisonner.\",\"Parsemer de zeste de citron.\",\"Répartir les billes de melon dessus.\",\"Former des rosettes avec le jambon cru, le dresser à côté.\",\"Parsemer d'herbes aromatiques.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Saison Été\",\"Salade\"],\"source\":\"https://fooby.ch/fr/recettes/27073/salade-de-melon-au-jambon-cru-et-a-la-ricotta\",\"notes\":\"\",\"paprikaUid\":\"9FA97061-7182-4778-B7D0-0F49FEC0B7DD\"},{\"id\":\"salade-de-legumes-racines-a-la-viande-de-b-uf-mrryzerysaj\",\"title\":\"Salade de légumes-racines à la viande de bœuf\",\"category\":\"Plat principal\",\"time\":70,\"servings\":4,\"ingredients\":[[\"coriandre\",1,\"bouquet\"],[\"limettes\",2,\"\"],[\"passion\",2,\"fruits de la\"],[\"panais\",300,\"g\"],[\"poivrée\",1,\"bouquet menthe\"],[\"salsifis\",500,\"g\"],[\"sésame\",5,\"c. à soupe huile de\"],[\"Teriyaki\",4,\"c. à soupe sauce\"],[\"(à la minute)\",400,\"g steaks de bœuf\"],[\"sel\",\"\",\"\"]],\"steps\":[\"Bien brosser les salsifis et les panais sous un filet d'eau froide à l'aide d'une paille de fer.\",\"Couper les salsifis en quatre dans la longueur et les panais en rondelles.\",\"Placer les légumes sur une plaque chemisée de papier cuisson.\",\"Mélanger l'huile, le jus de limette et le sel, arroser les légumes.\",\"Faire cuire env. 40 min. au milieu du four préchauffé à 200 °C.\",\"Sortir les légumes du four et les réserver au chaud et à couvert.\",\"Mélanger la pulpe des fruits de la passion, le jus de limette, l'huile, la sauce Teriyaki et le sel.\",\"Ajouter les fines herbes et mélanger le tout.\",\"Faire chauffer l’huile dans une poêle.\",\"Saler la viande, la saisir pendant env. 1½ min. de chaque côté, la laisser reposer brièvement.\",\"Couper la viande en tranches.\",\"Mélanger les légumes, les tranches de boeuf et la sauce, servir.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Salade\"],\"source\":\"https://fooby.ch/fr/recettes/18909/salade-de-legumes-racines-a-la-viande-de-buf\",\"notes\":\"\",\"paprikaUid\":\"873C1645-8673-4971-AF8C-14E3A2C1B103\"},{\"id\":\"salade-de-lentilles-aux-poires-et-aux-carottes-mrryzerxqm3\",\"title\":\"Salade de lentilles aux poires et aux carottes\",\"category\":\"Salade\",\"time\":55,\"servings\":2,\"ingredients\":[[\"vertes\",125,\"g lentilles\"],[\"sel\",\"\",\"\"],[\"Vinaigrette:\",\"\",\"\"],[\"huile\",4,\"c. à soupe\"],[\"demi-crème acidulée\",3,\"c. à soupe\"],[\"vinaigre\",3,\"c. à soupe\"],[\"hachée\",1,\"échalote\"],[\"moutarde\",0.5,\"c. à café\"],[\"sucre\",2,\"pincées\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"dés\",100,\"g carotte parée et taillée en petits\"],[\"céleri-branche paré et taillé en petits dés\",50,\"g\"],[\"lamelles\",100,\"g poire coupée en\"],[\"persil plates haché\",\"\",\"\"]],\"steps\":[\"Cuire les lentilles durant 20 - 25 minutes dans une grande quantité d'eau bouillante.\",\"Saler peu avant la fin de la cuisson.\",\"Pour la vinaigrette, prélever 4 cs d'eau de cuisson des lentilles (jeter le reste).\",\"Ajouter aux ingredients restants en mélangeant.\",\"Incorporer les lentilles tièdes en soulevant.\",\"Ajouter les petits dés de carotte et de céleri ainsi que les lamelles de poire.\",\"Laisser reposer à température ambiante au moins durant 30 minutes.\",\"Dresser la salade sur des assiettes.\",\"Parsemer de persil et servir.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Salade\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/KB_EFZ1998_139/salade-de-lentilles-aux-poires-et-aux-carottes/\",\"notes\":\"\",\"paprikaUid\":\"172AE6B1-EC50-419D-857B-6EBFA8BDFA1E\"},{\"id\":\"salade-de-haricots-italienne-mrryzervj91\",\"title\":\"Salade de haricots italienne\",\"category\":\"Italie\",\"time\":15,\"servings\":4,\"ingredients\":[[\"rouges\",1,\"oignons\"],[\"d’ail\",1,\"gousses\"],[\"cerises\",500,\"g tomates\"],[\"origan\",0.5,\"bouquet\"],[\"rouge\",5,\"c. à soupe vinaigre de vin\"],[\"d'olive\",4,\"c. à soupe huile\"],[\"Dijon\",1,\"c. à café moutarde de\"],[\"d'anchois\",1,\"boîte filets\"],[\"blancs\",2,\"boîte haricots\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Mélanger la moutarde, le vinaigre et l'huile dans un saladier.\",\"Ajouter l'oignon, l'ail et les anchois, mélanger, assaisonner.\",\"Ajouter les haricots, les tomates et l'origan dans la sauce, mélanger et dresser.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Salade\"],\"source\":\"https://fooby.ch/fr/recettes/25532/salade-de-haricots-italienne\",\"notes\":\"\",\"paprikaUid\":\"7FEF33CB-3DD9-47CA-8546-E4078FC9346F\"},{\"id\":\"salade-de-haricots-et-de-pommes-de-terre-mrryzeruv9w\",\"title\":\"Salade de haricots et de pommes de terre\",\"category\":\"Salade\",\"time\":55,\"servings\":7,\"ingredients\":[[\"pomme de terre nouvelle\",800,\"g\"],[\"haricots\",500,\"g\"],[\"bouillon de légumes\",2,\"dl\"],[\"féta\",200,\"g\"],[\"moutarde\",1,\"c. à café\"],[\"vinaigre de vin blanc\",2,\"c. à soupe\"],[\"vinaigre balsamique\",2,\"c. à soupe\"],[\"huile de colza\",6,\"c. à soupe\"],[\"oignon\",1,\"u\"],[\"gousse d'ail\",1,\"\"],[\"thym\",2,\"c. à café\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Salade:\",\"Effiler les haricots.\",\"Emietter la féta.\",\"Hacher finement l'oignon.\",\"Presser l'ail.\",\"Effeuiller le thym, garder qqes feuilles pour la déco.\",\"Cuire les haricots et les pommes de terre (coupées en deux ou en quatre) al dente, à la vapeur ou dans l'eau frémissante.\",\"Mélanger les pommes de terre et les haricots.\",\"Les arroser encore chauds de bouillon.\",\"Laisser reposer env. 30 minutes.\",\"Vinaigrette:\",\"Mélanger tous les ingrédients.\",\"Assaisonner.\",\"Verser sur la salade.\",\"Ajouter le fromages frais et mélanger le tout soigneusement.\",\"Laisser reposer encore env. 30 minutes.\",\"Dresser dans un plat et décorer.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM200003_31_MEN003B031C/salade-de-haricots-et-de-pommes-de-terre/\",\"notes\":\"\",\"paprikaUid\":\"D5CBF22D-4A72-4436-AB2D-1DE2B897A3F0\"},{\"id\":\"salade-de-gnocchis-au-citron-mrryzert5hn\",\"title\":\"Salade de gnocchis au citron\",\"category\":\"Italie\",\"time\":15,\"servings\":4,\"ingredients\":[[\"citrons\",1,\"u\"],[\"roquette\",100,\"g\"],[\"cerise\",300,\"g tomate\"],[\"d'olive\",2,\"tbsp huile\"],[\"râpé\",50,\"g parmesan\"],[\"rôtir\",1,\"tbsp beurre à\"],[\"d'érable\",1,\"tbsp sirop\"],[\"gnocchi\",800,\"g\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Bien mélanger le zeste et le jus de citron avec tous les ingrédients jusqu'au parmesan compris, saler et poivrer.\",\"Faire fondre un peu de beurre à rôtir dans une grande poêle antiadhésive.\",\"Baisser le feu et faire dorer les gnocchis pendant env. 5 min.\",\"Mélanger les gnocchis, les tomates et la roquette avec le dressing.\",\"Servir la salade chaude ou froide.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Saison Été\",\"Salade\"],\"source\":\"https://fooby.ch/fr/recettes/28430/salade-de-gnocchis-au-citron\",\"notes\":\"\",\"paprikaUid\":\"AE1DDE3D-544F-430B-BDF8-2F34356082F3\"},{\"id\":\"salade-de-fruits-hivernale-mrryzertovr\",\"title\":\"Salade de fruits hivernale\",\"category\":\"Dessert\",\"time\":15,\"servings\":4,\"ingredients\":[[\"orange\",1,\"\"],[\"kiwis\",2,\"\"],[\"pommes\",1,\"\"],[\"mangue\",2,\"tranches\"],[\"bananes\",1,\"\"],[\"cannelle\",0.5,\"c. à café\"],[\"jus d'orange\",\"\",\"\"]],\"steps\":[\"Couper les fruits en fines lamelles ou en petits dés (selon votre choix esthétique !).\",\"Ajouter le tout dans un grand saladier.\",\"Presser ensuite les oranges et ajouter le jus dans la salade.\",\"Enfin, prendre une toute petite cuillère de cannelle (car la cannelle apporte beaucoup de goût!) et l'ajouter dans le saladier.\",\"Mettre au frais 10 min.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Dessert\"],\"source\":\"https://www.marmiton.org/recettes/recette_salade-de-fruits-hivernale_86644.aspx\",\"notes\":\"\",\"paprikaUid\":\"2B5E7E95-5476-4F38-BAC5-702C888BD6AF\"},{\"id\":\"salade-de-fenouil-et-oranges-mrryzersdxw\",\"title\":\"Salade de fenouil et oranges\",\"category\":\"Salade\",\"time\":23,\"servings\":6,\"ingredients\":[[\"fenouil\",840,\"g\"],[\"orange\",2,\"u\"],[\"pin\",60,\"g pignon de\"],[\"sec\",30,\"g raisin\"],[\"sel\",\"\",\"\"],[\"d'olive\",45,\"g huile\"],[\"pommes\",1,\"tbsp vinaigre de\"],[\"citrouille\",12,\"g graines de\"]],\"steps\":[\"Presser le jus d'une orange et y tremper les raisins secs.\",\"Les laisser se réhydrater pendant au moins 10 minutes.\",\"Eplucher l'autre orange et enlever les deux extrémités. Veiller à éliminer la partie blanche amère de la peau.\",\"Couper en fines tranches et les mettre de côté.\",\"Laver et en sécher le fenouil.\",\"Couper nette les tiges et les petites feuilles vertes.\",\"Retirer également la base et les feuilles extérieures plus dures et ligneuses.\",\"Enlever les cœurs en julienne très fine à l'aide d'une mandoline.\",\"Déposer dans un bol avec de l'eau acidulée.\",\"Verser les pignons de pin dans une poêle antiadhésive et les faire griller quelques minutes.\",\"Mettre de côté.\",\"Égoutter les raisins secs et mettre de côté.\",\"Verser le jus dans un récipient à bords hauts.\",\"Ajouter le vinaigre.\",\"Ajouter l'huile et ajuster en sel.\",\"Mixer tous les ingrédients avec un mixeur plongeant jusqu'à l'obtention d'une émulsion homogène.\",\"Egoutter les fenouils et verser dans un grand bol.\",\"Ajouter les raisins secs.\",\"Ajoutez les oranges.\",\"Assaisonner avec l'émulsion et les pignons de pin.\",\"Ajouter les graines de courge et bien mélanger.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Salade\"],\"source\":\"https://www.giallozafferano.fr/recettes/salade-de-fenouil-et-oranges.html\",\"notes\":\"\",\"paprikaUid\":\"3232EB8E-29D9-406A-9DFF-5C54777A5054\"},{\"id\":\"salade-de-couscous-mrryzerrxyr\",\"title\":\"Salade de Couscous\",\"category\":\"Saison Été\",\"time\":40,\"servings\":4,\"ingredients\":[[\"couscous\",200,\"g\"],[\"tomates\",1,\"c. à soupe concentré de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"bouillon\",2,\"dl\"],[\"épices au choix, p. ex. ras-el-hanout, piment en poudre\",\"\",\"\"],[\"dés\",2,\"tomates coupées en\"],[\"dés\",0.5,\"concombre coupé en\"],[\"(ou autres légumes de saison)\",1,\"poivron coupé en dés\"],[\"nouveaux, oignon haché et tiges coupées en rondelles\",2,\"oignons\"],[\"dés\",200,\"g féta coupé en\"],[\"hachées\",0.5,\"bouquet herbes aromatiques\"],[\"vinaigre\",2,\"c. à soupe\"],[\"colza\",3,\"c. à soupe huile de\"]],\"steps\":[\"Mettre le couscous, le concentré de tomates et les épices dans un grand saladier.\",\"Recouvrir de bouillon chaud, couvrir et laisser gonfler 5-15 min.\",\"Incorporer les légumes et le fromage.\",\"Ajouter les herbes aromatiques, le vinaigre et l'huile.\",\"Rectifier l'assaisonnement.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Saison Été\",\"Salade\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM200705_56_B/salade-de-couscous/\",\"notes\":\"\",\"paprikaUid\":\"C778C6FA-627B-4C75-BF43-26FF28C0553E\"},{\"id\":\"salade-de-courgettes-mrryzerqgm9\",\"title\":\"Salade de courgettes\",\"category\":\"Salade\",\"time\":15,\"servings\":4,\"ingredients\":[[\"huile de colza\",4,\"c. à soupe\"],[\"vinaigre aux herbes\",2,\"c. à soupe\"],[\"moutarde\",1,\"c. à café\"],[\"gousse d'ail\",1,\"u\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"courgettes\",600,\"g\"]],\"steps\":[\"Râper grossièrement les courgettes.\",\"Mélanger l'huile, le vinaigre, la moutarde et l'ail pressé.\",\"Assaisonner.\",\"Ajouter aux courgettes.\",\"Rectifier l'assaisonnement.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Salade\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"salade-de-cornettes-garnie-mrryzerqxls\",\"title\":\"Salade de cornettes garnie\",\"category\":\"Salade\",\"time\":30,\"servings\":4,\"ingredients\":[[\"cornettes\",300,\"g\"],[\"œufs\",2,\"u\"],[\"herbes\",5,\"tbsp vinaigre aux\"],[\"colza\",8,\"tbsp huile de\"],[\"acidulée\",100,\"g crème\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"haché\",2,\"tbsp persil\"],[\"hachée\",2,\"tbsp ciboulette\"],[\"nouveau\",2,\"u oignon\"],[\"cornichon\",8,\"u\"],[\"cerise\",250,\"g tomate\"],[\"jambon\",150,\"g dés de\"]],\"steps\":[\"Cuire les cornettes al dente avec les œufs entiers dans de l'eau bouillante salée.\",\"Égoutter les cornettes et plonger les œufs dans de l'eau froide.\",\"Mélanger le vinaigre, l'huile de colza et la crème acidulée dans un saladier.\",\"Assaisonner.\",\"Ajouter les fines herbes.\",\"Ajouter les cornettes chaudes.\",\"Mélanger.\",\"Incorporer les oignons nouveaux coupés en rondelles, les cornichons coupées en rondelles, les tomates cerises coupées en deux et les dés de jambon.\",\"Peler les œufs, les couper en quatre, les disposer en forme d'étoile sur la salade de cornettes et servir.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Salade\",\"Suisse\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2018_DIVE_36/salade-de-cornettes-garnie/\",\"notes\":\"\",\"paprikaUid\":\"4368678D-3090-4D33-84BF-7943A5567665\"},{\"id\":\"salade-de-concombre-mrryzerpote\",\"title\":\"Salade de concombre\",\"category\":\"Salade\",\"time\":30,\"servings\":4,\"ingredients\":[[\"rondelles\",2,\"concombres coupés en dés ou en fines\"],[\"nature\",4,\"c. à soupe yogourt\"],[\"miel\",1,\"c. à café\"],[\"1½ c. à soupe vinaigre\",\"\",\"\"],[\"moutarde\",0.5,\"c. à soupe\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"aneth (facultatif)\",\"\",\"\"]],\"steps\":[\"Sauce: mélanger tous les ingrédients.\",\"Assaisonner.\",\"Incorporer les concombres.\",\"Servir aussitôt.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Salade\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2021_DIVE_48/salade-de-concombre/\",\"notes\":\"\",\"paprikaUid\":\"63EF113F-6C05-48A3-A02F-4359474FCD7B\"},{\"id\":\"salade-de-chou-fleur-roti-mrryzerozc9\",\"title\":\"Salade de chou-fleur rôti\",\"category\":\"Salade\",\"time\":45,\"servings\":4,\"ingredients\":[[\"chou-fleur\",600,\"g\"],[\"précuits\",240,\"g pois chiches\"],[\"roquette\",80,\"g\"],[\"grenade\",1,\"u\"],[\"effilées\",20,\"g amandes\"],[\"d'olive\",40,\"g huile\"],[\"citron\",50,\"g jus de\"],[\"sel\",\"\",\"\"],[\"poivre noir\",\"\",\"\"],[\"cumin en poudre\",\"\",\"\"]],\"steps\":[\"Préchauffer le four à 200°.\",\"Nettoyer le chou-fleur en éliminant les feuilles extérieures et les parties les plus coriaces.\",\"Récupérer les fleurettes les plus petites et les laver.\",\"Placer sur une plaque de cuisson, arroser avec la moitié de l'huile, du sel, du poivre et le cumin.\",\"Cuire dans le four pendant environ 30 minutes.\",\"Sortir et laisser refroidir.\",\"En attendant, égrener la grenade.\",\"Rincer les pois chiches et mettre dans un grand bol avec la roquette.\",\"Ajouter les graines de grenade.\",\"Mélanger et ajouter le chou-fleur froid.\",\"Presser le jus de citron sur la salade.\",\"Ajouter le reste de l'huile et mélanger.\",\"Faire griller brièvement les amandes effilées dans une poêle chaude, en veillant à remuer constamment pour ne pas brûler.\",\"Garnir en surface de la salade.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Salade\"],\"source\":\"https://www.giallozafferano.fr/recettes/salade-de-chou-fleur-roti.html\",\"notes\":\"\",\"paprikaUid\":\"F4F5B11F-E76E-4337-B751-094A4DD898CB\"},{\"id\":\"salade-de-chou-fleur-mrryzeromcd\",\"title\":\"Salade de chou-fleur\",\"category\":\"Salade\",\"time\":35,\"servings\":4,\"ingredients\":[[\"choux-fleurs détaillés en rosettes\",1,\"\"],[\"surgelés\",200,\"g petits pois\"],[\"sésame\",2,\"c. à café\"],[\"colza\",2,\"c. à soupe huile de\"],[\"poudre\",2,\"c. à café curry en\"],[\"yogourt\",100,\"g\"],[\"citron, zeste râpé et jus\",1,\"\"],[\"poudre\",1,\"c. à café curry en\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"mêlée\",100,\"g salade\"]],\"steps\":[\"Préchauffer le four à 180°C chaleur tournante (chaleur traditionnelle: 200°C).\",\"Mélanger les choux-fleurs et les petits pois avec le sésame, l'huile et les épices, cuire env. 15 min au milieu du four.\",\"Mélanger le yogourt, le zeste et jus de citron, le curry, le sel et le poivre, rectifier l'assaisonnement.\",\"Mettre les ingrédients dans un saladier, napper de sauce.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Salade\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2025_DIVE_11/salade-de-chou-fleur/\",\"notes\":\"\",\"paprikaUid\":\"A3486334-44D8-417E-B53F-495AD6D2DD1A\"},{\"id\":\"salade-de-chou-pointu-mrryzern2g5\",\"title\":\"Salade de chou pointu\",\"category\":\"Salade\",\"time\":40,\"servings\":4,\"ingredients\":[[\"acidulée\",75,\"g crème\"],[\"pomme\",3,\"c. à soupe vinaigre de\"],[\"colza\",3,\"c. à soupe huile de\"],[\"hachée\",1,\"échalote finement\"],[\"haché\",2,\"c. à soupe persil finement\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"coupé\",400,\"g chou pointu finement\"],[\"hachées\",4,\"c. à soupe noix ou noisettes\"],[\"herbes aromatiques pour décorer\",\"\",\"\"]],\"steps\":[\"Sauce: mixer brièvement tous les ingrédients ou bien mélanger avec un fouet.\",\"Salade: mélanger le chou pointu avec les noix ou noisettes et la sauce.\",\"Disposer dans une assiette, décorer et servir frais.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Salade\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2022_DIVE_67/salade-de-chou-pointu/\",\"notes\":\"\",\"paprikaUid\":\"86F47E0C-15E4-4F14-89EE-41F9EE3A6275\"},{\"id\":\"salade-de-cervelas-aux-legumes-et-aux-ufs-mrryzerm1bm\",\"title\":\"Salade de cervelas aux légumes et aux œufs\",\"category\":\"Plat principal\",\"time\":25,\"servings\":4,\"ingredients\":[[\"carottes\",300,\"g\"],[\"(chou-pomme)\",1,\"colrave\"],[\"nouveaux\",3,\"oignons\"],[\"1½ c. à café moutarde à gros grains\",\"\",\"\"],[\"vinaigre\",3,\"c. à soupe\"],[\"colza\",4,\"c. à soupe huile de\"],[\"sel aux herbes\",\"\",\"\"],[\"cervelas\",4,\"\"],[\"durs\",2,\"œufs\"],[\"ciboulette\",1,\"botte\"]],\"steps\":[\"Râper les carottes et le colrave sur une râpe à rösti.\",\"Débiter les oignons en fines rouelles.\",\"Mélanger le tout.\",\"Pour la sauce, mélanger la moutarde avec le vinaigre et l’huile.\",\"Assaisonner avec le sel aux herbes.\",\"Mélanger les légumes avec la moitié de la vinaigrette.\",\"Dresser dans les assiettes.\",\"Peler les cervelas, les couper en deux dans la longueur puis en fines tranches.\",\"Répartir sur la salade de légumes.\",\"Hacher les œufs.\",\"Ciseler la ciboulette.\",\"Arroser les cervelas du reste de vinaigrette.\",\"Parsemer d’œufs et de ciboulette.\",\"Selon les goûts, servir avec des feuilles de salade.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Salade\",\"Suisse\"],\"source\":\"https://migusto.migros.ch/fr/recettes/salade-de-cervelas-aux-legumes-et-aux-oeufs\",\"notes\":\"\",\"paprikaUid\":\"43EBBBA0-DC22-4448-9936-72FA9B8332DF\"},{\"id\":\"salade-de-carotte-mrryzerlim1\",\"title\":\"Salade de carotte\",\"category\":\"Salade\",\"time\":40,\"servings\":4,\"ingredients\":[[\"nature\",6,\"c. à soupe yogourt\"],[\"citron\",2,\"c. à soupe jus de\"],[\"sucre\",1,\"pincée\"],[\"sel\",\"\",\"\"],[\"rösti\",500,\"g carottes râpées à la râpe à bircher ou à\"]],\"steps\":[\"Mélanger tous les ingrédients.\",\"Ajouter les carottes, mélanger.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Salade\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/KO2021_SBLV_35/salade-de-carotte-low-carb/\",\"notes\":\"\",\"paprikaUid\":\"719D90A3-3E50-4DBF-B9AC-3CE25F47C235\"},{\"id\":\"salade-de-b-uf-epice-et-grana-padano-mrryzerkwnb\",\"title\":\"Salade De Bœuf Épicé Et Grana Padano\",\"category\":\"A\",\"time\":23,\"servings\":2,\"ingredients\":[[\"Filet de bœuf 250 g\",\"\",\"\"],[\"Concombres 300 g\",\"\",\"\"],[\"Tomates datterini 250 g\",\"\",\"\"],[\"Grana Padano AOP Réserve de plus de 20 mois 40 g\",\"\",\"\"],[\"Menthe à volonté\",\"\",\"\"],[\"Huile d'olive extra vierge à volonté\",\"\",\"\"],[\"Sel fin à volonté\",\"\",\"\"],[\"Poivre noir à volonté\",\"\",\"\"],[\"Huile d'olive extra vierge 60 g\",\"\",\"\"],[\"Menthe 3 feuilles\",\"\",\"\"],[\"Thym 1 brin\",\"\",\"\"],[\"poivre rose à volonté\",\"\",\"\"],[\"Poivre noir à volonté\",\"\",\"\"]],\"steps\":[\"Pour préparer la salade de bœuf épicé et Grana Padano, commencez par préparer la marinade pour la viande : versez l'huile d'olive dans un verre haut et étroit 1 , ajoutez les feuilles de menthe 2 , le thym 3 ,\",\"le poivre rose 4 et le poivre noir 5 et mixez avec un mixeur plongeant 6 jusqu'à obtenir une consistance homogène.\",\"Nettoyez le filet de bœuf en éliminant les parties de graisse ou de tissu conjonctif, puis transférez-le dans un récipient 7 et versez l'émulsion d'huile et d'herbes aromatiques à l'intérieur 8 . Couvrez avec un film plastique et laissez mariner à température ambiante pendant environ 15 minutes 9 . Vous pouvez retourner la viande après 6-7 minutes afin de bien tremper l'autre côté de la viande dans la marinade.\",\"En attendant, occupez-vous du reste du plat : lavez et puis divisez les tomates cerises en 4 parties 10 , épluchez le concombre et coupez-le en fines tranches à l'aide d'un éplucheur 11 . Disposez les concombres dans un bol et ajoutez les tomates cerises coupées 12 .\",\"Maintenant, vous pouvez cuire la viande : une fois le temps de marinade écoulé, cuisez le filet sur une plaque bien chaude pendant environ 3-4 minutes de chaque côté (13-14). Transférez le filet sur une planche à découper, laissez-le reposer quelques secondes et coupez-le en fines tranches transversales 15 .\",\"Maintenant, vous pouvez compléter la salade : disposez les tranches de viande sur les concombres et tomates 16 , ajoutez les copeaux de Grana Padano AOP 17 , assaisonnez avec un filet d'huile, du sel et du poivre et, enfin, garnissez avec quelques feuilles de menthe fraîche. Votre salade de bœuf épicé et Grana Padano est prête à être dégustée 18 !\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"A\"],\"source\":\"https://www.giallozafferano.fr/recettes/salade-de-boeuf-epice-et-grana-padano.html\",\"notes\":\"\",\"paprikaUid\":\"540A63FC-FFC5-401C-9319-EA1F05494C69\"},{\"id\":\"salade-de-bouilli-mrryzerjj37\",\"title\":\"Salade de bouilli\",\"category\":\"Salade\",\"time\":160,\"servings\":4,\"ingredients\":[[\"oignons\",1,\"\"],[\"carottes\",200,\"g\"],[\"poireau\",100,\"g\"],[\"vinaigre\",100,\"g concombres au\"],[\"ciboulette\",1,\"bouquet\"],[\"radis\",1,\"bouquet petits\"],[\"d'olive\",1,\"c. à soupe huile\"],[\"douce\",1,\"c. à soupe moutarde\"],[\"câpres\",30,\"g\"],[\"bouilli\",800,\"g viande de bœuf maigre pour\"],[\"laurier\",2,\"feuilles\"],[\"poivre\",1,\"c. à café grains de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Couper l'oignon en deux avec la peau, le placer dans la cocotte face coupée vers le bas et le faire rôtir à sec pendant env. 5 min jusqu'à ce qu'il soit bien foncé.\",\"Éplucher les carottes, les couper en morceaux avec le poireau.\",\"Mettre les carottes et le poireau avec l'eau dans la cocotte et tous les ingrédients jusqu'aux grains de poivre compris, porter à ébullition.\",\"Baisser le feu, ajouter la viande, laisser frémir à petit feu pendant env. 2 h (sans faire bouillir).\",\"Retirer les légumes avec une écumoire.\",\"Retirer la cocotte de la plaque, laisser refroidir la viande dans le bouillon.\",\"Retirer la viande du bouillon, la couper en cubes d'env. 1 cm, réserver le bouillon.\",\"Mettre la moutarde dans un récipient.\",\"Égoutter les concombres au vinaigre, les réserver.\",\"Ajouter 1 dl de vinaigre de concombre et l'huile à la moutarde.\",\"Ajouter 1 dl du bouillon réservé, bien mélanger.\",\"Ciseler la ciboulette, l'ajouter et assaisonner.\",\"Couper les radis en 4, couper les concombres au vinaigre réservés en dés.\",\"Égoutter les câpres, ajouter le tout avec le bouilli à la sauce, mélanger.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Salade\",\"Suisse\"],\"source\":\"https://fooby.ch/fr/recettes/28209/salade-de-bouilli\",\"notes\":\"\",\"paprikaUid\":\"A98B216D-DB77-4D93-BE43-018925C93392\"},{\"id\":\"salade-de-betteraves-rouges-a-l-orange-mrryzeri6hk\",\"title\":\"Salade de betteraves rouges à l'orange\",\"category\":\"Salade\",\"time\":25,\"servings\":4,\"ingredients\":[[\"SALADE:\",\"\",\"\"],[\"rouges\",200,\"g betteraves\"],[\"sanguines, filetées, jus récupéré\",2,\"oranges\"],[\"sauge, feuilles, grillées dans un peu de graisse\",0.5,\"bouquet\"],[\"SAUCE:\",\"\",\"\"],[\"citron, un peu de zeste râpé\",1,\"\"],[\"citron\",3,\"c. à soupe jus de\"],[\"colza\",4,\"c. à soupe huile de\"],[\"soja\",2,\"c. à soupe sauce\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"SALADE:\",\"Faire cuire les betteraves et les couper en fines tranches.\",\"Poser en alternance avec les filets d’orange sur les assiettes et répartir la sauge dessus.\",\"SAUCE:\",\"Bien mélanger le zeste de citron et le jus d’orange récupéré avec les autres ingrédients et verser sur la salade.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Salade\"],\"source\":\"https://www.gemuese.ch/fr/recettes/salade-de-betteraves-rouges-et-d-oranges?_gl=1*1s2nm48*_up*MQ..&gclid=EAIaIQobChMItdK7sbK4kQMVepKDBx0SyAWNEAAYASABEgL9oPD_BwE&gbraid=0AAAAA-NhTE5iAnPHfalM4KcSHGDur_dvT\",\"notes\":\"\",\"paprikaUid\":\"F4CD661D-4956-438C-B81C-986D5482D0FD\"},{\"id\":\"salade-de-betteraves-rouges-et-d-epinards-a-la-tomme-mrryzerh3w0\",\"title\":\"Salade de betteraves rouges et d'épinards à la tomme\",\"category\":\"Salade\",\"time\":50,\"servings\":4,\"ingredients\":[[\"raifort\",1,\"c. à soupe\"],[\"poires\",2,\"\"],[\"betteraves\",400,\"g\"],[\"d’ail\",1,\"gousses\"],[\"d'épinards\",100,\"g pousses\"],[\"balsamique\",4,\"c. à soupe vinaigre\"],[\"d'olive\",4,\"c. à soupe huile\"],[\"tomme\",5,\"\"],[\"sel\",\"\",\"\"],[\"sel\",1,\"c. à café fleur de\"]],\"steps\":[\"Dans un saladier, mélanger le vinaigre, l'huile, le raifort et le sel.\",\"Ajouter les poires, mélanger.\",\"Dans un autre saladier, mélanger les betteraves rouges et l'ail avec l'huile et la fleur de sel.\",\"Répartir le tout sur une plaque recouverte de papier cuisson.\",\"Faire cuire env. 30 min au milieu du four préchauffé à 200 °C.\",\"Retirer du four, poser le fromage sur la plaque et poursuivre la cuisson env. 5 min.\",\"Mélanger les épinards avec les poires, dresser avec les betteraves rouges et le fromage.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Salade\",\"Suisse\"],\"source\":\"https://fooby.ch/fr/recettes/23933/salade-de-betteraves-rouges-et-d-epinards-a-la-tomme\",\"notes\":\"\",\"paprikaUid\":\"49D8F2B6-F64F-406F-86BD-E7279BF1784D\"},{\"id\":\"salade-d-ete-a-la-feta-croustillante-mrryzerfhf6\",\"title\":\"Salade d'été à la feta croustillante\",\"category\":\"Saison Été\",\"time\":30,\"servings\":4,\"ingredients\":[[\"framboises\",200,\"g\"],[\"d’ail\",2,\"gousses\"],[\"basilic\",0.5,\"bouquet\"],[\"mini-laitues romaines\",4,\"\"],[\"concombres\",1,\"\"],[\"fanes\",1,\"oignons botte avec les\"],[\"pomme\",2,\"c. à soupe vinaigre de\"],[\"d'olive\",4,\"c. à soupe huile\"],[\"tournesol\",3,\"c. à soupe huile de\"],[\"panko\",60,\"g\"],[\"blanche\",1,\"c. à soupe farine\"],[\"œufs\",1,\"\"],[\"feta\",200,\"g\"],[\"liquide\",1,\"c. à café miel\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Mettre les framboises et tous les ingrédients jusqu'au poivre compris dans un verre doseur et mixer.\",\"Incorporer le basilic à la sauce.\",\"Couvrir et la mettre au frais.\",\"Battre l'œuf dans une assiette creuse.\",\"Verser le panko dans une autre assiette creuse et la farine dans une assiette plate.\",\"Passer la feta dans la farine (la secouer un peu pour faire tomber le surplus), ensuite dans l'œuf, puis dans le panko en appuyant légèrement.\",\"Faire chauffer l'huile dans une poêle antiadhésive.\",\"Baisser le feu.\",\"Faire dorer la feta à chaleur moyenne pendant env. 5 min.\",\"Sortir, la mettre à égoutter sur du papier absorbant.\",\"Dresser les mini-laitues et l'oignon botte sur un plat.\",\"Arroser de sauce.\",\"Répartir la feta et les framboises dessus.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Saison Été\",\"Salade\"],\"source\":\"https://fooby.ch/fr/recettes/26147/salade-d-ete-a-la-feta-croustillante\",\"notes\":\"\",\"paprikaUid\":\"FC6D0E92-9061-4719-A30F-1197498B90A2\"},{\"id\":\"salade-d-ete-aux-cornettes-mrryzereee9\",\"title\":\"Salade d'été aux cornettes\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"foncés\",50,\"g raisins sultanines\"],[\"couleur\",500,\"g poivrons de\"],[\"olivettes\",250,\"g tomates\"],[\"d'olive\",4,\"c. à soupe huile\"],[\"rouge\",4,\"c. à soupe vinaigre de vin\"],[\"liquide\",1,\"c. à soupe miel\"],[\"pâtes\",250,\"g\"],[\"cervelas\",2,\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Faire cuire les pâtes al dente dans l'eau salée frémissante.\",\"Les rincer à l'eau froide et les égoutter.\",\"Faire chauffer l'huile dans une poêle.\",\"Y faire sauter les poivrons et les lamelles de cervelas pendant 8 min.\",\"Baisser le feu, ajouter les tomates et les raisins sultanines, poursuivre la cuisson env. 5 min.\",\"Incorporer le miel.\",\"Assaisonner.\",\"Mélanger le vinaigre et l'huile.\",\"Saler et poivrer.\",\"Ajouter les légumes et les pâtes.\",\"Mélanger.\",\"Dresser la salade.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Pâtes\",\"Saison Été\",\"Salade\"],\"source\":\"https://fooby.ch/fr/recettes/26549/salade-d-ete-aux-cornettes\",\"notes\":\"\",\"paprikaUid\":\"551EE4AC-9709-4E0D-95D7-0988ABC65125\"},{\"id\":\"salade-d-ete-appenzelloise-mrryzerdze9\",\"title\":\"Salade d'été appenzelloise\",\"category\":\"Pâtes\",\"time\":30,\"servings\":4,\"ingredients\":[[\"branches\",100,\"g épinards en\"],[\"jaunes\",1,\"poivrons rouges et poivrons\"],[\"pleurotes\",100,\"g\"],[\"ciboulette\",1,\"c. à soupe\"],[\"pomme\",1,\"dl vinaigre de\"],[\"colza\",1,\"dl huile de\"],[\"mi-salé\",200,\"g Appenzeller\"],[\"beurre\",1,\"c. à soupe\"],[\"(p. ex. penne)\",350,\"g pâtes\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Cuire les pâtes al dente dans de l’eau bouillante salée puis les égoutter.\",\"Mélanger l’huile et le vinaigre, les ajouter aux pâtes.\",\"Incorporer les épinards et le fromage.\",\"Faire fondre le beurre, faire revenir les poivrons et les champignons env. 4 min., assaisonner, mélanger aux pâtes.\",\"Parsemer de ciboulette.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Pâtes\",\"Saison Été\",\"Salade\",\"Suisse\"],\"source\":\"https://fooby.ch/fr/recettes/7793/salade-d-ete-appenzelloise\",\"notes\":\"\",\"paprikaUid\":\"D22D7F2F-D280-43D0-9381-A9C7885A8CD0\"},{\"id\":\"salade-d-ete-au-camembert-et-au-melon-mrryzercr1l\",\"title\":\"Salade d'éte au Camembert et au melon\",\"category\":\"Plat principal\",\"time\":40,\"servings\":4,\"ingredients\":[[\"melons\",1,\"\"],[\"noix\",50,\"g cerneaux de\"],[\"verte\",100,\"g salade\"],[\"plat\",1,\"bouquet persil\"],[\"basilic\",1,\"bouquet\"],[\"d'olive\",5,\"c. à soupe huile\"],[\"panko\",3,\"c. à soupe\"],[\"camembert\",1,\"\"],[\"œufs\",1,\"\"],[\"moutarde\",0.5,\"c. à soupe\"],[\"blancs\",1,\"boîte haricots\"],[\"cru\",8,\"tranche jambon\"],[\"citron\",2,\"c. à soupe jus de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Préchauffer le plat dans le four à 60° C.\",\"Envelopper les quartiers de melon de jambon cru.\",\"Faire chauffer l'huile dans une poêle antiadhésive.\",\"Y saisir les quartiers de melon env. 1 min. de chaque côté.\",\"Réserver au chaud.\",\"Hacher fin les graines et le panko et les mettre dans une assiette plate.\",\"Passer chaque morceau de fromage dans l'œuf puis dans la panure en appuyant bien.\",\"Faire chauffer l'huile dans la même poêle.\",\"Y saisir les morceaux de fromage pendant env. 1 min. de chaque côté.\",\"Réserver au chaud.\",\"Dans un saladier, mélanger la moutarde avec tous les ingrédients jusqu'au poivre compris.\",\"Ajouter les haricots, la salade et les herbes au dressing.\",\"Mélanger.\",\"Dresser la salade avec le melon et le fromage.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Salade\"],\"source\":\"https://fooby.ch/fr/recettes/16151/salade-d-ete-au-camembert-et-au-melon\",\"notes\":\"\",\"paprikaUid\":\"73BC06A8-4888-4813-9BCC-DD2D3FBC7C36\"},{\"id\":\"salade-d-hiver-au-cottage-cheese-et-aux-poires-mrryzerbisw\",\"title\":\"Salade d'hiver au cottage cheese et aux poires\",\"category\":\"Saison Hiver\",\"time\":25,\"servings\":4,\"ingredients\":[[\"noix\",30,\"g cerneaux de\"],[\"demi-poires\",1,\"boîte\"],[\"rouges\",2,\"endives\"],[\"ciboulette\",0.5,\"bouquet\"],[\"blanches\",2,\"endives\"],[\"blanc\",3,\"c. à soupe vinaigre balsamique\"],[\"colza\",4,\"c. à soupe huile de\"],[\"nature\",200,\"g cottage cheese\"],[\"l’ancienne\",2,\"c. à café moutarde à\"],[\"liquide\",1,\"c. à café miel\"],[\"poivre\",\"\",\"\"],[\"sel\",\"\",\"\"]],\"steps\":[\"Bien mélanger tous les ingrédients, assaisonner.\",\"Couper 2 demi-poires en tranches dans le sens de la longueur, réserver.\",\"Couper le reste des poires en dés, les mélanger avec les cerneaux de noix, la ciboulette et le cottage cheese.\",\"Ajouter la moitié de la sauce et mélanger.\",\"Dresser les feuilles d'endive et les tranches de poire sur le bord des assiettes, arroser du reste de sauce et placer le cottage cheese au milieu.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Saison Hiver\",\"Salade\"],\"source\":\"https://fooby.ch/fr/recettes/14954/salade-d-hiver-au-cottage-cheese-et-aux-poires\",\"notes\":\"\",\"paprikaUid\":\"87DB2478-668D-4D46-9465-620488C2B129\"},{\"id\":\"salade-d-endives-a-l-orange-mrryzeraqvu\",\"title\":\"Salade d'endives à l'orange\",\"category\":\"Salade\",\"time\":15,\"servings\":2,\"ingredients\":[[\"oranges\",2,\"\"],[\"rouges\",250,\"g endives\"],[\"noisettes\",40,\"g\"],[\"d'olive\",3,\"c. à soupe huile\"],[\"moutarde\",1,\"c. à café\"],[\"thym\",4,\"brin\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Dans un petit saladier, mélanger la moutarde avec tous les ingrédients jusqu'au poivre compris.\",\"Faire chauffer l'huile dans une poêle antiadhésive.\",\"Ajouter les endives, faire cuire 2 min, saler.\",\"Dresser sur une assiette avec les tranches d'orange.\",\"Arroser de sauce et parsemer de noix.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Salade\"],\"source\":\"https://fooby.ch/fr/recettes/25547/salade-d-endives-a-l-orange\",\"notes\":\"\",\"paprikaUid\":\"F0665D2C-2AE4-45FC-B3A3-B0EA3EB170AB\"},{\"id\":\"salade-d-endives-de-ma-grand-mere-mrryzer97qc\",\"title\":\"Salade d'endives de ma grand-mère\",\"category\":\"Salade\",\"time\":50,\"servings\":2,\"ingredients\":[[\"cornichon\",100,\"g\"],[\"rouge\",1,\"u oignon\"],[\"jaune\",1,\"u poivron\"],[\"rouges\",2,\"u endives\"],[\"jaunes\",2,\"u endives\"],[\"conférence\",1,\"u poire\"],[\"campagne\",100,\"g pain de\"],[\"noix\",30,\"g cerneaux de\"],[\"roquefort\",60,\"g\"],[\"huile d'olive\",\"\",\"\"],[\"beurre clarifié\",\"\",\"\"],[\"blanc\",200,\"g vin\"],[\"blanc\",100,\"g vinaigre\"],[\"poivre\",\"\",\"\"],[\"moutarde\",100,\"g graines de\"],[\"ancienne\",25,\"g moutarde\"],[\"doux\",15,\"g moutarde\"],[\"sel\",\"\",\"\"],[\"cumin en poudre\",\"\",\"\"],[\"rouge\",15,\"g vinaigre de vin\"],[\"d'olive\",25,\"g huile\"]],\"steps\":[\"La veille, préparez les pickles:\",\"Couper les cornichons, l'oignon et le poivron en petits dés.\",\"Portez le vin, le vinaigre et le poivre à ébullition.\",\"Versez sur les graines de moutarde et les dés de légumes.\",\"Laisser reposer une journée.\",\"Le jour même:\",\"Préchauffez le four à 180 °C.\",\"Effeuillez les endives et lavez-les.\",\"Épluchez et évidez la poire, puis taillez-la en lamelles de 2 mm d’épaisseur à l’aide d’une mandoline.\",\"Faites-les mariner dans de l’huile d’olive additionnée de sel pendant une dizaine de minutes.\",\"Coupez de fines tranches de pain de campagne (2 mm d’épaisseur).\",\"Badigeonnez-les des deux côtés de beurre clarifié et enfournez-les pour 10 min.\",\"Posez-les sur du papier absorbant.\",\"Faites torréfier les cerneaux de noix 10 min au four.\",\"Taillez des cubes de roquefort de 2 cm.\",\"Préparez la vinaigrette:\",\"Mélangez les moutardes, le sel et le cumin à l’aide d’un fouet.\",\"Ajoutez le vinaigre, puis montez à l’huile d’olive.\",\"Placez les tranches de poire entre les feuilles d’endive.\",\"Surmontez de noix, de roquefort et de pickles.\",\"Versez la vinaigrette sur la salade avant de servir.\",\"Déposez le pain détaillé en croûtons.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Salade\"],\"source\":\"https://www.elle.fr/Elle-a-Table/Recettes-de-cuisine/Salade-d-endives-de-ma-grand-mere-4235606\",\"notes\":\"\",\"paprikaUid\":\"078521B5-F673-4C55-A2D2-483BE46A5B64\"},{\"id\":\"salade-d-endives-avec-orange-et-burrata-mrryzer8qez\",\"title\":\"Salade d'endives avec orange et Burrata\",\"category\":\"Italie\",\"time\":30,\"servings\":4,\"ingredients\":[[\"soufflé\",10,\"g quinoa\"],[\"sucre\",2,\"c. à soupe\"],[\"poivre de Cayenne concassé\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"oranges\",2,\"\"],[\"d'olive\",4,\"c. à soupe huile\"],[\"poivre\",\"\",\"\"],[\"endives\",4,\"petites\"],[\"mini-burratas de 50 g\",4,\"\"],[\"herbes\",0.5,\"bouquet fines\"]],\"steps\":[\"Caraméliser le quinoa avec le sucre dans une poêle antiadhésive.\",\"Relever de poivre de Cayenne et de sel.\",\"Répartir sur une feuille de papier sulfurisé et laisser refroidir.\",\"Râper finement le zeste des oranges.\",\"Les peler et les couper en tranches en recueillant le jus qui s'écoule.\",\"Pour la sauce à salade, mélanger le jus recueilli au zeste râpé avec les trois quarts de l'huile d'olive.\",\"Saler et poivrer.\",\"Partager les endives en deux, dans la longueur.\",\"Les rissoler de toutes parts dans le reste de l'huile.\",\"Assaisonner.\",\"Les dresser avec les tranches d'orange et la burrata.\",\"Garnir de fines herbes effeuillées.\",\"Arroser de sauce et parsemer de quinoa caramélisé.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Salade\"],\"source\":\"https://migusto.migros.ch/fr/recettes/endives-avec-orange-et-burrata\",\"notes\":\"\",\"paprikaUid\":\"311F1DE5-13E0-42BA-BE0F-8AD4DC7B057D\"},{\"id\":\"salade-d-endives-au-pamplemousse-rose-mrryzer7dve\",\"title\":\"Salade d'endives au pamplemousse rose\",\"category\":\"Saison Été\",\"time\":60,\"servings\":1,\"ingredients\":[[\"endive\",2,\"u\"],[\"pamplemousse rose\",1,\"u\"],[\"crème acidulée\",100,\"g\"],[\"sel\",0,\"\"],[\"tabasco\",0,\"\"]],\"steps\":[\"Couper les endives en quarts dans le sens de la longueur.\",\"Fileter le pamplemousse.\",\"Disposer les endives et le pamplemousse dans des coupelles.\",\"Assaisonner la crème acidulée, en garnir la salade.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Saison Été\",\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM200201_24_a/salade-dendives-au-pamplemousse-rose/\",\"notes\":\"\",\"paprikaUid\":\"AB78CF33-327F-4840-B580-8F4DC42E3910\"},{\"id\":\"salade-d-asperges-a-la-sauce-au-liqueur-aux-ufs-mrryzer6kio\",\"title\":\"Salade d'asperges à la sauce au liqueur aux œufs\",\"category\":\"Asperges\",\"time\":0,\"servings\":2,\"ingredients\":[[\"blanche\",1,\"u asperge\"],[\"beurre\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"sucre\",\"\",\"\"],[\"Sauce :\",\"\",\"\"],[\"œuf\",1,\"u\"],[\"oignon\",1,\"u\"],[\"citron\",1,\"u\"],[\"œufs\",1,\"dl liqueur aux\"],[\"ciboulette\",0.5,\"u\"],[\"rucola\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Cuire un œuf dur.\",\"Chauffer l'eau de cuisson salée et sucrée pour les asperges.\",\"Parer les asperges.\",\"Ajouter la découpe à l'eau de cuisson.\",\"Râper les zestes de citron et presser le jus.\",\"Ajouter un peu à l'eau de cuisson.\",\"Hacher l'oignon et la ciboulette.\",\"Cuire les asperges 5-10 minutes avec un peu de beurre.\",\"Les sortir et refroidir.\",\"Dans un grand bol, mélanger tous les ingrédients pour la sauce.\",\"Couper les asperges en tranches diagonales de 5-10 mm.\",\"Les ajouter à la sauce avec la rucola déchiqueté.\",\"Mélanger et servir.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asperges\",\"Salade\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"D6DA4A45-B76F-47BE-8890-A1D377815109\"},{\"id\":\"salade-d-asperges-aux-pommes-de-terre-mrryzeqz0zi\",\"title\":\"Salade d'asperges aux pommes de terre\",\"category\":\"Asperges\",\"time\":0,\"servings\":4,\"ingredients\":[[\"verte\",1,\"u asperge\"],[\"nouvelles\",400,\"g pommes de terre\"],[\"rouge\",1,\"u oignon\"],[\"cherry\",10,\"u tomate\"],[\"d'olive\",4,\"tbsp huile\"],[\"balsamique\",1,\"tbsp crème de\"],[\"basilic\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Préchauffer le four à 200°.\",\"Parer les asperges.\",\"Les couper en morceaux d'une longueur de 2-3 cm et les déposer sur une plaque.\",\"Couper les pommes de terre en morceaux et les ajouter sur la plaque.\",\"Saler, poivrer et arroser d'huile d'olive.\",\"Enfourner pendant 15 minutes.\",\"Couper les tomates en deux et l'oignon en fines demi-cercles.\",\"Déposer dans un grand bol.\",\"Ajouter les asperges et les pommes de terre.\",\"Arroser d'huile et du balsamico.\",\"Saler, poivrer et bien mélanger.\",\"Parsemer du basilic coupé en lanières.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asperges\",\"Salade\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"CA8912D5-C07C-4F1D-B222-927054326EE3\"},{\"id\":\"salade-d-asperges-mrryzeqngkh\",\"title\":\"Salade d'asperges\",\"category\":\"Asperges\",\"time\":60,\"servings\":4,\"ingredients\":[[\"5 cm\",1,\"kg asperges vertes coupées en morceaux de\"],[\"beurre ou crème à rôtir\",\"\",\"\"],[\"émietté\",200,\"g Féta\"],[\"colza\",5,\"c. à soupe huile de\"],[\"citron\",3,\"c. à soupe jus de\"],[\"moutarde\",0.5,\"c. à café\"],[\"sel\",\"\",\"\"],[\"miel\",1,\"pincée sucre ou un peu de\"],[\"poivre\",\"\",\"\"],[\"noisettes hachées ou effilées\",\"\",\"\"]],\"steps\":[\"Cuire les asperges dans un peu de beurre/crème à rôtir 8-10 min à feu moyen en remuant de temps en temps.\",\"Réserver.\",\"Mélanger l'huile, le jus de citron, la moutarde et les épices, rectifier l'assaisonnement.\",\"Verser la sauce sur les asperges, parsemer de fromage et de noisettes.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asperges\",\"Saison Printemps\",\"Salade\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2025_DIVE_33/salade-dasperges/\",\"notes\":\"\",\"paprikaUid\":\"42E326C5-3AC4-4509-916E-99A49D4A5899\"},{\"id\":\"salade-cesar-au-poulet-et-au-lard-mrryzeqmpmd\",\"title\":\"Salade César au poulet et au lard\",\"category\":\"Plat principal\",\"time\":50,\"servings\":4,\"ingredients\":[[\"battu\",1,\"œuf\"],[\"lait\",2,\"c. à soupe de\"],[\"râpé\",5,\"c. à soupe de Sbrinz\"],[\"chapelure\",5,\"c. à soupe de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"d'aiguillettes de poulet ou de poitrine de poulet coupée en lanières\",400,\"g\"],[\"rôti\",150,\"g de lard à rôtir coupé en lanières et\"],[\"lamelles\",1,\"grande laitue romaine coupée en\"],[\"deux\",2,\"poignées de tomates cerises coupées en\"],[\"quelques copeaux de Sbrinz\",\"\",\"\"],[\"lait\",6,\"c. à soupe de\"],[\"mayonnaise\",4,\"c. à soupe de\"],[\"moutarde\",1,\"c. à café de\"],[\"anchois\",1,\"\"],[\"râpé\",2,\"c. à soupe de Sbrinz\"],[\"pressé\",0.5,\"citron\"],[\"Maggi\",1,\"giclée de\"],[\"d'ail en poudre\",0.5,\"c. à café\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Préchauffer le four à 180°C (air chaud/chaleur tournante: 160°C).\",\"Battre l'œuf et le lait dans une assiette creuse.\",\"Dans une autre assiette, mélanger le Sbrinz râpé et la chapelure.\",\"Saler, poivrer.\",\"Passer les morceaux de poulet dans le mélange œuf-lait et les rouler immédiatement dans la chapelure au Sbrinz.\",\"Disposer le poulet pané sur une plaque chemisée de papier sulfurisé.\",\"Cuire env. 25 min au milieu du four chaud jusqu'à ce que les morceaux soient dorés.\",\"Retourner à mi-cuisson pour qu'ils soient croustillants de toute part.\",\"Préparer la laitue, les tomates cerises et le Sbrinz, réserver.\",\"Mettre tous les ingrédients jusqu'au Maggi inclus dans un mixeur et mixer.\",\"Ajouter l'ail en poudre, saler, poivrer.\",\"Disposer la laitue et les tomates dans un bol, arroser de sauce et mélanger.\",\"Ajouter le poulet, les copeaux de Sbrinz et le lard.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Poulet\",\"Salade\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/CHDO201701_18/salade-cesar-au-poulet-et-au-lard/\",\"notes\":\"\",\"paprikaUid\":\"47E241B0-F620-4057-9FFF-E900B309FFA8\"},{\"id\":\"salade-cesar-au-poulet-mrryzeqlz1l\",\"title\":\"Salade César au poulet\",\"category\":\"Plat principal\",\"time\":40,\"servings\":4,\"ingredients\":[[\"SALADE:\",\"\",\"\"],[\"iceberg, coupée en bouchées\",1,\"laitue\"],[\"radis, coupés en rondelles\",0.5,\"bouquet\"],[\"poulet\",400,\"g blancs de\"],[\"rôtir\",8,\"tranches lard à\"],[\"toasts, coupés en cubes\",2,\"tranches pain ou\"],[\"oeufs, cuits, hachés grossièrement\",2,\"\"],[\"Sbrinz, coupé en fines lamelles avec un éplucheur\",50,\"g\"],[\"cresson\",1,\"poignée\"],[\"rôtir\",2,\"c. à soupe beurre ou de crème à\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"SAUCE:\",\"\",\"\"],[\"herbes\",3,\"c. à soupe vinaigre aux\"],[\"colza\",3,\"c. à soupe huile de\"],[\"fraîche\",2,\"c. à soupe crème\"],[\"mayonnaise\",2,\"c. à soupe\"],[\"Sbrinz, râpé\",2,\"c. à soupe\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"SAUCE DE SALADE:\",\"Réduire tous les ingrédients finement en purée et mettre au froid.\",\"SALADE:\",\"Faire rôtir le poulet de tous les côtés pendant 8 à 12 minutes dans le beurre à rôtir, assaisonner, sortir et mettre au chaud.\",\"Couper le lard en morceaux et faire rôtir dans la même poêle jusqu’à ce qu’il devienne croustillant, sortir et mettre au chaud.\",\"Faire griller le pain dans le reste de la graisse à rôtir et sortir.\",\"Dresser la salade sur l’assiette ou dans un saladier.\",\"Couper les radis finement et les répartir dessus.\",\"Verser la sauce dessus.\",\"Découper le poulet et le poser sur la salade avec le lard, l’œuf et le fromage.\",\"Garnir de cresson.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Poulet\",\"Saison Été\",\"Salade\"],\"source\":\"https://www.gemuese.ch/fr/recettes/salade-cesar-au-poulet?_gl=1*15v9hd*_up*MQ..&gclid=EAIaIQobChMItdK7sbK4kQMVepKDBx0SyAWNEAAYASABEgL9oPD_BwE&gbraid=0AAAAA-NhTE5iAnPHfalM4KcSHGDur_dvT\",\"notes\":\"\",\"paprikaUid\":\"A0808E58-B3BE-4606-898B-243A0DF549DC\"},{\"id\":\"salade-cesar-mrryzeqku0y\",\"title\":\"Salade César\",\"category\":\"Plat principal\",\"time\":40,\"servings\":4,\"ingredients\":[[\"d'œuf\",1,\"jaune\"],[\"d'ail\",1,\"gousse\"],[\"moutarde\",0.5,\"c. à café\"],[\"Worcestershire\",1,\"c. à café sauce\"],[\"d'anchois ou d'anchois égouttés\",1,\"c. à café pâte\"],[\"citron\",2,\"c. à soupe jus de\"],[\"colza\",0.5,\"dl huile de\"],[\"poivre\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"griller\",8,\"tranches lard à\"],[\"dés\",2,\"tranches pain blanc coupé en petits\"],[\"d'ail écrasée\",1,\"gousse\"],[\"morceaux\",1,\"laitues coupées en\"],[\"Sbrinz en copeaux, pour décorer\",\"\",\"\"]],\"steps\":[\"Sauce: passer tous les ingrédients au mixeur jusqu'à l'obtention d'une consistance homogène.\",\"Salade: griller le lard à la poêle, laisser égoutter sur du papier ménage.\",\"Casser en morceaux.\",\"Dans la même poêle, griller les dés de pain et saisir brièvement l'ail.\",\"Mettre la salade sur des assiettes ou dans un saladier, garnir de lard et de croûtons.\",\"Arroser d'un filet de sauce, parsemer de Sbrinz.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Salade\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM200704_72/salade-cesar/\",\"notes\":\"\",\"paprikaUid\":\"1770A3B0-753C-4A22-AE78-F7EED07CE4AA\"},{\"id\":\"salade-cervelas-et-fromage-mrryzeqj2vm\",\"title\":\"Salade cervelas et fromage\",\"category\":\"Saison Été\",\"time\":45,\"servings\":4,\"ingredients\":[[\"moutarde\",1,\"c. à soupe\"],[\"blanc\",3,\"c. à soupe vinaigre de vin\"],[\"colza\",4,\"c. à soupe huile de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"cervelas\",4,\"\"],[\"gruyère\",300,\"g\"],[\"vinaigre\",6,\"concombres au\"],[\"oignon\",1,\"petit\"],[\"ciboulette\",1,\"botte\"]],\"steps\":[\"Bien mélanger la moutarde, le vinaigre et l'huile dans un grand bol, assaisonner la sauce.\",\"Couper\",\"- les cervelas en deux, en tranches d'env. 5 mm d'épaisseur,\",\"- le fromage en cubes d'env. 1 cm,\",\"- les cornichons en tranches d'env. 5 mm d'épaisseur.\",\"Hacher finement l'oignon.\",\"Couper finement la ciboulette.\",\"Ajouter le tout à la sauce.\",\"Mélanger, laisser reposer env. 30 minutes à température ambiante.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Saison Été\",\"Salade\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/salade-cervelas-et-fromage-10002795/\",\"notes\":\"\",\"paprikaUid\":\"80756706-8669-4340-911D-C4D471F744BE\"},{\"id\":\"salade-caprese-aux-peches-mrryzeqi7ds\",\"title\":\"Salade caprese aux pêches\",\"category\":\"Saison Été\",\"time\":40,\"servings\":4,\"ingredients\":[[\"tomates\",800,\"g\"],[\"pêches\",600,\"g\"],[\"mozzarella\",300,\"g\"],[\"dénoyautées\",85,\"g olives noires\"],[\"pomme\",4,\"c. à soupe vinaigre aux herbes ou de\"],[\"colza\",3,\"c. à soupe huile de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"basilic\",\"\",\"\"]],\"steps\":[\"Couper les tomates et les pêches en quartiers, la mozzarella en tranches.\",\"Dresser le tout sur des assiettes avec les olives.\",\"Mélanger vinaigre, huile, sel et poivre, arroser en filet.\",\"Parsemer de feuilles de basilic.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Saison Été\",\"Salade\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/salade-caprese-aux-pches-10008020/\",\"notes\":\"\",\"paprikaUid\":\"A2CEFB5B-0088-415A-9E80-AAEB012FD814\"},{\"id\":\"salade-brocoli-tomates-et-feta-mrryzeqhqk0\",\"title\":\"Salade brocoli, tomates et feta\",\"category\":\"Saison Été\",\"time\":50,\"servings\":4,\"ingredients\":[[\"brocoli\",600,\"g\"],[\"d’amandes\",2,\"c. à soupe bâtonnets\"],[\"blanc\",3,\"c. à soupe vinaigre balsamique\"],[\"d’olive\",2,\"c. à soupe huile\"],[\"légumes\",1,\"dl bouillon de\"],[\"sel\",\"\",\"\"],[\"poivre , selon goût\",\"\",\"\"],[\"persil\",1,\"bouquet\"],[\"cerises\",500,\"g tomates\"],[\"feta\",200,\"g\"]],\"steps\":[\"Séparer le brocoli en petits bouquets.\",\"Cuire al dente env. 5 min dans l’eau salée bouillante, égoutter, plonger un instant dans de l’eau glacée, bien égoutter.\",\"Faire griller les bâtonnets d’amandes à sec dans une poêle, retirer.\",\"Mélanger dans un saladier vinaigre balsamique, huile et bouillon, rectifier l’assaisonnement.\",\"Ciseler le persil, couper les tomates en deux.\",\"Ajouter les deux dans le saladier avec le brocoli, mélanger.\",\"Émietter la feta, répartir sur la salade avec les bâtonnets d’amandes.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Saison Été\",\"Salade\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/salade-brocoli-tomates-et-feta-10008025/\",\"notes\":\"\",\"paprikaUid\":\"1945D834-6DD7-45C1-8629-68F9C99B011B\"},{\"id\":\"salade-betteraves-rouges-poires-mrryzeqgkt1\",\"title\":\"Salade betteraves rouges/poires\",\"category\":\"Saison Été\",\"time\":70,\"servings\":4,\"ingredients\":[[\"rouge\",3,\"dl vin\"],[\"badiane\",1,\"étoile de\"],[\"d’acacia\",2,\"c. à soupe miel\"],[\"sel\",\"\",\"\"],[\"cuites, en rondelles d’env. 1 cm d’épaisseur\",2,\"betteraves rouges\"],[\"poires, partagées dans la largeur, épépinées, en tranches d’env. 1 cm d’épaisseur\",2,\"\"],[\"molle, émietté\",150,\"g fromages à pâte\"],[\", grillés, hachés grossièrement\",30,\"g cerneaux de noix\"],[\"un peu de cresson de fontaine\",\"\",\"\"],[\"colza\",2,\"c. à soupe huile de\"],[\"fleur de sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Porter le vin à ébullition avec badiane, miel et sel.\",\"Ajouter les betteraves, laisser mijoter env. 15 min à couvert sur feu doux.\",\"Ajouter les poires, poursuivre la cuisson env. 5 minutes.\",\"Retirer les betteraves et les poires.\",\"Répartir sur des assiettes.\",\"Répartir dessus fromage, noix et cresson.\",\"Faire réduire le vin à env. 1 dl à consistance de sirop, laisser tiédir un peu.\",\"Arroser la salade d’un filet de réduction et d’huile, saler, poivrer.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Saison Été\",\"Salade\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/salade-betteraves-rouges-poires-10005387/\",\"notes\":\"\",\"paprikaUid\":\"533F2F2D-EA0D-44A8-98D8-4E7F99C820D6\"},{\"id\":\"salade-aux-abricots-et-aux-graines-mrryzeqfs1z\",\"title\":\"Salade aux abricots et aux graines\",\"category\":\"Salade\",\"time\":10,\"servings\":2,\"ingredients\":[[\"(Iceberg ou cœurs)\",1,\"salade\"],[\"tournesol\",2,\"c. à soupe graines de\"],[\"abricots\",100,\"g\"],[\"blanc\",0.5,\"dl vinaigre balsamique\"],[\"colza\",1,\"dl huile de\"],[\"l’ancienne\",1,\"c. à soupe moutarde à\"],[\"liquide\",1,\"c. à café miel\"],[\"sel\",\"\",\"\"],[\"thym\",2,\"c. à café\"]],\"steps\":[\"Dans une poêle, faire dorer les graines de tournesol puis les laisser refroidir.\",\"Mixer les abricots avec le miel, l'huile, le vinaigre balsamique et le sel.\",\"Ajouter la moutarde, le thym et les graines de tournesol.\",\"Mélanger et verser sur la salade.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Salade\",\"Sauce\"],\"source\":\"https://fooby.ch/fr/recettes/15914/dressing-aux-abricots-et-aux-graines\",\"notes\":\"\",\"paprikaUid\":\"ADDDBB2E-24B4-4863-8CF0-B1E56253F20B\"},{\"id\":\"salade-au-dressing-asiatique-mrryzeqf6ad\",\"title\":\"Salade au dressing asiatique\",\"category\":\"Asie\",\"time\":10,\"servings\":2,\"ingredients\":[[\"choix\",1,\"salade à\"],[\"salées\",1,\"c. à soupe cacahuètes\"],[\"gingembre\",2,\"c. à café\"],[\"rouges\",1,\"chilis\"],[\"limettes\",2,\"\"],[\"d'arachide\",1,\"dl huile\"],[\"sésame\",2,\"c. à soupe huile de\"],[\"1½ c. à soupe sucre brut\",\"\",\"\"],[\"noir\",0.5,\"c. à soupe graines de sésame\"],[\"poudre\",0.5,\"c. à café coriandre en\"],[\"soja\",2,\"c. à soupe sauce au\"]],\"steps\":[\"Dans une poêle, faire griller les cacahuètes et le sésame sans matière grasse pendant env. 2 min.\",\"Mettre dans un petit saladier.\",\"Ajouter le sucre brut, la coriandre, le gingembre et le chili.\",\"Bien mélanger.\",\"Mélanger le jus de limette, l'huile d'arachide, l'huile de sésame et la sauce au soja.\",\"Ajouter les épices et mélanger.\",\"Verser sur la salade.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Salade\",\"Sauce\"],\"source\":\"https://fooby.ch/fr/recettes/15913/dressing-asiatique-\",\"notes\":\"\",\"paprikaUid\":\"DFE9244A-4257-4207-BEC9-096EA7315255\"},{\"id\":\"rostis-de-legumes-sauce-aux-champignons-mrryzeqepb7\",\"title\":\"Röstis De Légumes, Sauce Aux Champignons\",\"category\":\"A\",\"time\":55,\"servings\":2,\"ingredients\":[[\", râpées grossièrement\",400,\"g de carottes\"],[\", râpées grossièrement\",200,\"g de courgettes\"],[\"d’alpage , râpé finement\",80,\"g de fromage\"],[\"sel\",0.5,\"c.c. de\"],[\"un peu de poivre\",\"\",\"\"],[\"d' huile d’olive\",1,\"c.s.\"],[\", en tranches\",200,\"g de pleurotes du panicaut\"],[\", haché finement\",1,\"oignon\"],[\"d’ail , pressée\",1,\"gousse\"],[\"(p.ex. Noilly Prat)\",1,\"c.s. de vermouth blanc sec\"],[\"légumes\",1,\"dl de bouillon de\"],[\"bio\",125,\"g de fromage frais nature\"],[\"sel , selon goût\",\"\",\"\"],[\"poivre , selon goût\",\"\",\"\"],[\"coriandre, ciselés\",2,\"c.s. de persil plat ou de\"]],\"steps\":[\"Mélanger dans un grand bol carottes, courgettes et fromage, saler, poivrer, répartir sur une plaque chemisée de papier cuisson, façonner une galette ronde.\",\"Cuisson: env. 25 min au milieu du four préchauffé à 220°C.\",\"Bien faire chauffer l’huile dans une poêle antiadhésive. Faire revenir les pleurotes env. 4 min, ajouter l’oignon et l’ail, faire revenir un instant. Mouiller avec le vermouth, faire réduire complètement. Verser le bouillon, mijoter env. 1 minute. Ajouter le fromage frais, le temps de bien faire chauffer, rectifier l’assaisonnement. Incorporer le persil, dresser avec les röstis.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"A\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/rostis-de-legumes-sauce-aux-champignons-10006384/\",\"notes\":\"\",\"paprikaUid\":\"8F44015D-5884-4365-A12F-A97A0B63D5A8\"},{\"id\":\"rosti-de-patate-douce-et-uf-au-plat-mrryzeqdhsq\",\"title\":\"Rösti de patate douce et œuf au plat\",\"category\":\"Plat principal\",\"time\":50,\"servings\":4,\"ingredients\":[[\"rösti\",1,\"kg patates douces râpées à la râpe à\"],[\"haché\",1,\"oignon rouge finement\"],[\"râpé\",100,\"g fromage à raclette\"],[\"hachés\",4,\"brins persil plat\"],[\"œufs\",2,\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"noix de muscade\",\"\",\"\"],[\"paprika\",\"\",\"\"],[\"beurre à rôtir\",\"\",\"\"],[\"œufs\",4,\"\"],[\"persil haché\",\"\",\"\"]],\"steps\":[\"Préparation\",\"Cuire les patates la veille, réserver.\",\"Mélanger les patates douces, l'oignon, le fromage, le persil et les œufs dans un saladier, assaisonner.\",\"Diviser le mélange en quatre portions, les rôtir l'une après l'autre des deux côtés dans le beurre à rôtir.\",\"Réserver les rösti dans le four chauffé à 80°C (air chaud/chaleur tournante: 60°C).\",\"Préparer quatre œufs au plat dans une autre poêle.\",\"Dresser les quatre portions de rösti sur des assiettes et poser à chaque fois un œuf par-dessus.\",\"Saler, poivrer et parsemer de persil.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Saison Hiver\",\"Saison Printemps\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2019_SUKA_06/roesti-de-patate-douce-et-oeuf-au-plat/\",\"notes\":\"\",\"paprikaUid\":\"F8F070D2-FD39-45E7-B75B-0F426A03950B\"},{\"id\":\"roti-hache-au-four-mrryzeqcrvn\",\"title\":\"Rôti haché au four\",\"category\":\"Plat principal\",\"time\":80,\"servings\":4,\"ingredients\":[[\"morceaux\",1,\"petit pain rassis coupé en petits\"],[\"lait\",0.5,\"dl\"],[\"hachée\",500,\"g viande\"],[\"veau\",100,\"g chair à saucisse de\"],[\"œuf\",1,\"\"],[\"oignon, haché fin\",1,\"\"],[\"persil, ciselé fin\",1,\"bouquet\"],[\"d'ail, pressée\",1,\"gousse\"],[\"acidulée\",3,\"c. à soupe séré ou de crème\"],[\"sel\",2,\"c. à café\"],[\"poivre\",\"\",\"\"],[\"paprika\",\"\",\"\"]],\"steps\":[\"Arroser le petit pain d'un filet de lait, laisser gonfler.\",\"Réduire en petits morceaux.\",\"Mélanger tous les ingrédients jusqu'aux épices incluses, pétrir à la main jusqu'à l'obtention d'une masse homogène.\",\"Chemiser le moule à cake en repliant les extrémités par-dessus les bords.\",\"Badigeonner les petits bords de crème à rôtir et saupoudrer de chapelure.\",\"Transvaser la masse dans le moule et cuire 50 min au milieu du four préchauffé à 180°C.\",\"Laisser reposer 10 min dans le four éteint.\",\"Démouler avec le papier.\",\"Trancher, servir.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Suisse\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM_div_0913_06/roti-hache-au-four/?collection=97824\",\"notes\":\"\",\"paprikaUid\":\"F0358494-5752-4F4C-915A-0F00375E324C\"},{\"id\":\"roti-de-veau-a-la-cocotte-mrryzeq9i5y\",\"title\":\"Rôti de veau à la cocotte\",\"category\":\"Cocotte\",\"time\":120,\"servings\":4,\"ingredients\":[[\"veau\",1,\"kg noix de\"],[\"oignons\",2,\"\"],[\"cerise\",1,\"grappe tomates\"],[\"carotte\",1,\"\"],[\"d'ail\",1,\"gousse\"],[\"garni\",1,\"bouquet\"],[\"sauge\",4,\"brins\"],[\"huile\",1,\"c. à soupe\"],[\"beurre\",20,\"g\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Pelez et émincez les oignons, l’ail et la carotte.\",\"Préchauffez le four à 180 °C.\",\"Chauffez l'huile et le beurre dans une cocotte.\",\"Ajoutez les oignons, la carotte, l'ail écrasé, les tomates, la sauge et le bouquet garni.\",\"Déposez le rôti par-dessus, salez, poivrez.\",\"Faites cuire 10 min en retournant le rôti sur toutes ses faces.\",\"Couvrez.\",\"Mettez la cocotte au four.\",\"Laissez cuire 1 h 15.\",\"Au terme de la cuisson, réservez le rôti au chaud.\",\"Versez 10 cl d'eau dans la cocotte.\",\"Faites bouillir et réduire 5 min en grattant les sucs.\",\"Filtrez ce jus.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Cocotte\",\"Plat principal\"],\"source\":\"https://www.cuisineactuelle.fr/recettes/roti-de-veau-cocotte-209181?_gl=1*1a2ncfn*_gcl_aw*R0NMLjE3NjY4Njc1MzkuRUFJYUlRb2JDaE1JeXNDMzM4emVrUU1WS1pPREJ4MTNCeUY2RUFBWUFTQUFFZ0l0V19EX0J3RQ..*_ga*MTAyNDA0ODM1MS4xNzY2ODY3MDc4*_ga_5NSPQRQDQY*czE3NjY4NjcwNzgkbzEkZzEkdDE3NjY4Njc1MzgkajkkbDAkaDA.\",\"notes\":\"\",\"paprikaUid\":\"37C5C0F0-7DAD-4729-B49C-43C43204E1AE\"},{\"id\":\"roti-de-porc-a-la-sauge-en-cocotte-mrryzeq6xyt\",\"title\":\"Rôti de porc à la sauge en cocotte\",\"category\":\"Cocotte\",\"time\":140,\"servings\":6,\"ingredients\":[[\"porc\",1,\"kg rôti de\"],[\"ferme\",1,\"kg pommes de terre à chair\"],[\"sec\",50,\"cl vin blanc\"],[\"sauge\",12,\"feuilles\"],[\"d'olive\",2,\"c. à soupe huile\"],[\"laurier\",2,\"feuilles\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Préchauffez le four à 180°.\",\"Faites chauffer l'huile d'olive dans une cocotte.\",\"Y faites-y dorer le rôti sur chaque face à feu vif.\",\"Arrosez le rôti de 15 cl d’eau.\",\"Couvrez et enfournez 1 h en arrosant de temps en temps.\",\"Pendant ce temps, épluchez les pommes de terre.\",\"Coupez-les en rondelles un peu épaisses.\",\"Ajoutez les pommes de terre autour du rôti.\",\"Déposez les feuilles de sauge et de laurier.\",\"Arrosez de vin blanc.\",\"Salez et poivrez.\",\"Poursuivez la cuisson au four, toujours à couvert, durant 45 min à 1 h, en arrosant de temps en temps.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Cocotte\",\"Plat principal\"],\"source\":\"https://www.cuisineactuelle.fr/recettes/roti-de-porc-en-cocotte-a-la-sauge-209755?_gl=1*mht4t1*_gcl_aw*R0NMLjE3NjY4NjcyNzQuRUFJYUlRb2JDaE1JeXNDMzM4emVrUU1WS1pPREJ4MTNCeUY2RUFBWUFTQUFFZ0l0V19EX0J3RQ..*_ga*MTAyNDA0ODM1MS4xNzY2ODY3MDc4*_ga_5NSPQRQDQY*czE3NjY4NjcwNzgkbzEkZzEkdDE3NjY4NjcyNzMkajIzJGwwJGgw\",\"notes\":\"\",\"paprikaUid\":\"D1C4A034-0B71-4D04-A197-83422ADF833C\"},{\"id\":\"roti-de-b-uf-a-la-baloise-mrryzeq5dmr\",\"title\":\"Rôti de bœuf à la bâloise\",\"category\":\"Plat principal\",\"time\":60,\"servings\":4,\"ingredients\":[[\"carottes\",200,\"g\"],[\"céleri-rave\",350,\"g\"],[\"poireau\",250,\"g\"],[\"beurre à rôtir\",\"\",\"\"],[\"Emmentaler\",100,\"g\"],[\"viande\",1,\"dl bouillon de\"],[\"bœuf\",800,\"g filet de\"],[\"blanc\",1,\"dl vin\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Faire fondre le beurre dans une cocotte.\",\"Saler et poivrer la viande, la saisir env. 5 min (attendre qu’une croûte se soit formée pour la retourner) puis la retirer du feu et la réserver.\",\"Remettre un peu de beurre dans le même récipient.\",\"Y faire revenir les légumes et tous les autres ingrédients jusqu’à l’oignon inclus pendant env. 5 min.\",\"Ajouter a viande, mouiller avec le vin et le bouillon.\",\"Piquer le thermomètre à viande à l’endroit le plus épais.\",\"Faire cuire le rôti env. 25 min dans le bas du four préchauffé à 180° C.\",\"Le retirer du four, le saupoudrer de fromage et poursuivre la cuisson env. 10 min. La température à coeur doit atteindre 60° C.\",\"Retirer le rôti du four, le couvrir et le laisser reposer env. 10 min avant de le couper en tranches.\",\"Filtrer le jus de cuisson et le servir avec le rôti et les légumes.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Suisse\"],\"source\":\"https://fooby.ch/fr/recettes/9127/roti-de-boeuf-a-la-baloise\",\"notes\":\"\",\"paprikaUid\":\"2FB1C12E-E8BC-49EE-8AD1-2577637D4EA4\"},{\"id\":\"rouleaux-de-poireau-et-de-jambon-mrryzeq3tf7\",\"title\":\"Rouleaux de poireau et de jambon\",\"category\":\"Plat principal\",\"time\":45,\"servings\":4,\"ingredients\":[[\"d'env. 6 cm de long\",600,\"g poireau en lamelles\"],[\"ciboulette, finement coupée\",0.5,\"bouquet\"],[\"blanc\",1,\"dl vin\"],[\"légumes\",1,\"dl bouillon de\"],[\"demi-crème à sauces\",2,\"dl\"],[\"cuit\",200,\"g tranches de jambon\"],[\"Gruyère, râpé grossièrement\",150,\"g\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"noix de muscade\",\"\",\"\"]],\"steps\":[\"Porter à ébullition le vin et le bouillon et y faire cuire le poireau pendant env. 10 minutes en veillant à ce qu’il reste ferme.\",\"Sortir le poireau et le laisser refroidir un peu.\",\"Lier la sauce avec la demi-crème, laisser brièvement mijoter et assaisonner.\",\"Enrouler le poireau dans les tranches de jambon et les placer par couches dans le moule à gratin.\",\"Verser la sauce dessus et saupoudrer de fromage.\",\"Faire gratiner pendant 20 à 25 minutes au milieu du four préchauffé à 200° C.\",\"Garnir avec la ciboulette et le poivre.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Saison Hiver\"],\"source\":\"https://www.gemuese.ch/fr/recettes/rouleaux-au-poireau-et-au-jambon?_gl=1*1y5cks6*_up*MQ..&gclid=EAIaIQobChMItdK7sbK4kQMVepKDBx0SyAWNEAAYASABEgL9oPD_BwE&gbraid=0AAAAA-NhTE5iAnPHfalM4KcSHGDur_dvT\",\"notes\":\"\",\"paprikaUid\":\"5B775172-1C24-41A8-B0A5-6096CA14A177\"},{\"id\":\"rouleaux-de-chou-farcis-mrryzeq2eui\",\"title\":\"Rouleaux de chou farcis\",\"category\":\"Plat principal\",\"time\":90,\"servings\":4,\"ingredients\":[[\"blanc\",600,\"g chou\"],[\"carotte\",150,\"g\"],[\"d’ail\",1,\"gousse\"],[\"beurre\",1,\"c. à soupe\"],[\"Sbrinz\",120,\"g\"],[\"demi-crème pour sauces\",2,\"dl\"],[\"perlé\",250,\"g orge\"],[\"champignons\",5,\"dl bouillon de\"],[\"blanc\",1,\"dl vin\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Entailler le trognon du chou en croix.\",\"Faire cuire doucement dans l'eau salée pendant env. 10 min.\",\"Le sortir et le plonger brièvement dans l'eau froide.\",\"Détacher délicatement 12 feuilles de chou et les sécher.\",\"Préchauffer le four à 200°.\",\"Préparation de la farce :\",\"Éplucher les carottes et les râper grossièrement.\",\"Hacher l'ail.\",\"Faire fondre le beurre dans une poêle antiadhésive.\",\"Y faire suer l'ail et les carottes pendant 3 min.\",\"Ajouter l'orge perlé et le faire revenir pendant 1 min en remuant.\",\"Mouiller avec le vin blanc et laisser réduire presque entièrement.\",\"Ajouter le bouillon, couvrir et laisser mijoter env. 30 min à feu moyen.\",\"Retirer la poêle du feu.\",\"Ajouter le fromage.\",\"Mélanger et assaisonner.\",\"Répartir la farce sur les feuilles de chou à raison d'env. 3 cs par feuille.\",\"Rabattre les bords et enrouler les feuilles en serrant bien.\",\"Poser les rouleaux dans le moule, fermeture vers le bas.\",\"Préparation de la liaison :\",\"Mélanger la demi-crème pour sauces avec de l'eau, assaisonner.\",\"Verser la liaison sur les rouleaux.\",\"Parsemer de fromage râpé.\",\"Faire cuire env. 30 min au milieu du four.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Saison Autumne\",\"Saison Hiver\",\"Suisse\",\"Végétarien\"],\"source\":\"https://fooby.ch/fr/recettes/26116/rouleaux-de-chou-farcis\",\"notes\":\"\",\"paprikaUid\":\"E4376D5F-CACD-43A3-A806-6DDD19994BEF\"},{\"id\":\"roulades-de-viande-hachee-mrryzeq0h02\",\"title\":\"Roulades De Viande Hachée\",\"category\":\"A\",\"time\":60,\"servings\":4,\"ingredients\":[[\"échalotes\",2,\"\"],[\"poivrée\",0.25,\"bouquet de menthe\"],[\"plat\",0.25,\"bouquet de persil\"],[\"œufs\",1,\"\"],[\"rôtir\",1,\"cs de beurre à\"],[\"entière\",1,\"dl de crème\"],[\"viande\",3,\"dl de bouillon de\"],[\"tomates\",1,\"cs de purée de\"],[\"(bœuf)\",400,\"g de viande hachée\"],[\"rôtir\",16,\"tranche de lard à\"],[\"sel\",0.75,\"de cc de\"],[\"un peu de poivre\",\"\",\"\"]],\"steps\":[\"Mettre la viande hachée dans un saladier. Ajouter les échalotes hachées menu, les fines herbes ciselées et l'œuf, assaisonner. Bien pétrir jusqu'à ce que la masse devienne compacte et ne colle plus aux mains. Diviser la masse en 8 et façonner chaque portion en une baguette de 10 cm de longueur. Barder chaque roulade de viande de 2 tranches de lard. Faire fondre le beurre dans une cocotte. Y déposer les roulades, côtés soudé vers le bas, les saisir de toutes parts pendant env. 5 min. et les sortir.\",\"Essuyer la graisse de cuisson. Verser le bouillon, ajouter la purée de tomates, déglacer le fond de cuisson et remettre les roulades. Porter à ébullition, baisser le feu, couvrir et laisser mijoter pendant env. 30 min. Ajouter la crème.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"A\"],\"source\":\"https://fooby.ch/fr/recettes/9727/roulades-de-viande-hachee\",\"notes\":\"\",\"paprikaUid\":\"CCED27CC-A837-4695-A3EC-A746CB3C708C\"},{\"id\":\"roulades-de-cotes-de-bettes-avec-pommes-de-terre-au-romarin-mrryzepzq38\",\"title\":\"Roulades de côtes de bettes avec pommes de terre au romarin\",\"category\":\"Plat principal\",\"time\":70,\"servings\":4,\"ingredients\":[[\"FARCE:\",\"\",\"\"],[\"terre, chair farineuse\",800,\"g pommes de\"],[\"salée, bouillante\",2,\"l eau\"],[\"feta, émiéttée grossièrement\",200,\"g\"],[\"plat, haché grossièrement\",1,\"botte persil\"],[\"noix de muscade\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"couleurs\",16,\"feuilles côtes de bettes de différentes\"],[\"rôtir\",1,\"c. à soupe beurre à\"],[\"sel\",\"\",\"\"],[\"SAUCE:\",\"\",\"\"],[\"rôtir\",1,\"c. à soupe beurre à\"],[\"oignon, haché grossièrement\",1,\"\"],[\"rouges, en petits cubes\",2,\"poivrons\"],[\"légumes\",1,\"dl bouillon de\"],[\"fraîche\",1,\"dl crème\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"ACCOMPAGNEMENT:\",\"\",\"\"],[\"fermes\",500,\"g pommes de terre\"],[\"romarin\",1,\"bouquet\"],[\"persil\",1,\"bouquet\"]],\"steps\":[\"Plonger les pommes de terre dans de l'eau froide salée et les cuire.\",\"Plonger dans de l'eau glacée.\",\"Couper en quartiers.\",\"Chauffer du beurre dans une poêle.\",\"Ajouter les pommes de terre, saler.\",\"Ajouter le romarin et le persil.\",\"Faire cuire les pommes de terre avec la peau dans l’eau bouillante jusqu’à ce qu’elles deviennent tendres (pendant 20 à 30 min. selon la taille).\",\"Déverser l’eau, laisser refroidir les pommes de terre, les éplucher et les couper en morceaux.\",\"Mettre les pommes de terre, la feta et le persil dans un saladier, écraser grossièrement avec un pilon à purée et assaisonner.\",\"Couper les tiges des feuilles de côtes de bettes et couper celles-ci en fines lamelles.\",\"Faire revenir pendant env. 5 min. dans le beurre à rôtir chaud, saler, laisser refroidir un peu et incorporer à la farce.\",\"Blanchir les côtes de bettes pendant 30 à 60 secondes dans l’eau salée bouillante, sortir de l’eau, laisser égoutter et sécher en tapotant avec un torchon propre.\",\"Répartir une grande cuillière à soupe de farce sur les feuilles de côtes de bettes.\",\"Replier les bords latéraux et enrouler les feuilles.\",\"Faire chauffer le beurre à rôtir dans une poêle et faire revenir l’oignon et les poivrons pendant env. 10 min., mouiller avec le bouillon.\",\"Laisser mijoter pendant env. 5 min. et réduire finement en purée.\",\"Ajouter la crème fraîche, mélanger et assaisonner.\",\"Mettre les roulades dans la sauce, couvrir et faire mijoter pendant 10 à 12 min.\",\"Servir avec les pommes de terre au romarin.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Saison Hiver\",\"Saison Printemps\"],\"source\":\"https://www.gemuese.ch/fr/recettes/roulades-de-cotes-de-bettes?_gl=1*7oikc*_up*MQ..&gclid=EAIaIQobChMItdK7sbK4kQMVepKDBx0SyAWNEAAYASABEgL9oPD_BwE&gbraid=0AAAAA-NhTE5iAnPHfalM4KcSHGDur_dvT\",\"notes\":\"\",\"paprikaUid\":\"4B04BCC5-C786-46CB-B11C-6BED2C6C39DE\"},{\"id\":\"roulade-au-chou-frise-avec-pommes-de-terre-au-romarin-mrryzepyx8b\",\"title\":\"Roulade au chou frisé avec pommes de terre au romarin\",\"category\":\"Plat principal\",\"time\":80,\"servings\":4,\"ingredients\":[[\"CHOU FRISÉ:\",\"\",\"\"],[\"frisé, 8 feuilles séparées\",800,\"g chou\"],[\"FARCE:\",\"\",\"\"],[\"séchés\",20,\"g bolets\"],[\"eau, froide\",2,\"dl\"],[\"couscous\",150,\"g\"],[\"1½ dl bouillon de légumes, chaud\",\"\",\"\"],[\"rôtir\",1,\"c. à soupe beurre à\"],[\"oignon, haché finement\",1,\"\"],[\"d’ail, hachées finement\",2,\"gousses\"],[\"carottes, râpées finement\",150,\"g\"],[\"thym, effeuillées\",3,\"tiges\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"œuf\",1,\"\"],[\"rôtir\",2,\"c. à soupe beurre à\"],[\"légumes, chaud\",0.5,\"dl bouillon de\"],[\"SAUCE:\",\"\",\"\"],[\"entière\",2,\"dl crème\"],[\"maïzena\",1,\"c. à café\"],[\"dure, râpé\",50,\"g fromage à pâte\"],[\"ACCOMPAGNEMENT:\",\"\",\"\"],[\"fermes\",300,\"g pommes de terre\"],[\"romarin\",1,\"bouquet\"],[\"persil, hâché\",1,\"bouquet\"]],\"steps\":[\"POMMES DE TERRE:\",\"Plonger les pommes de terre dans de l'eau froide salée et les cuire.\",\"Plonger dans de l'eau glacée.\",\"Couper en quartiers.\",\"Chauffer du beurre dans une poêle.\",\"Ajouter les pommes de terre, saler.\",\"Ajouter le romarin et le persil.\",\"CHOU FRISÉ:\",\"Couper la partie saillante de la nervure centrale des feuilles de chou.\",\"Faire blanchir les feuilles de chou par portion pendant env. 3 min. chacune dans l’eau salée bouillante, tremper dans l’eau froide, sécher en tapotant et disposer à plat.\",\"FARCE:\",\"Faire tremper les champignons pendant env. 20 min. dans l’eau.\",\"Déverser l’eau en gardant 1 dl.\",\"Hacher grossièrement les champignons.\",\"Verser le couscous dans un saladier, verser le bouillon dessus, mélanger, couvrir et laisser gonfler pendant env. 5 min.\",\"Faire chauffer le beurre à rôtir dans une poêle et faire revenir l’oignon et l’ail.\",\"Ajouter les carottes et le thym, faire revenir pendant env. 4 min. et assaisonner.\",\"Mélanger la masse, les champignons et l’œuf avec le couscous et assaisonner éventuellement une nouvelle fois.\",\"FINITION:\",\"Répartir la farce au milieu des feuilles de chou.\",\"Replier les bords, enrouler bien serré du bout du trognon jusqu’au bord supérieur de la feuille et attacher avec la ficelle de cuisine.\",\"Faire dorer les roulades de tous les côtés pendant env. 5 min. dans le beurre à rôtir chaud.\",\"Verser le bouillon et l’eau de trempage, couvrir et faire mijoter à petit feu pendant env. 45 min.\",\"Sortir les roulades.\",\"SAUCE:\",\"Mélanger 2 cs de crème avec l’amidon de maïs, verser avec le reste de la crème dans la sauce, porter brièvement à ébullition en remuant, râper le fromage au-dessus et servir.\",\"Servir avec des pommes de terre au romarin.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Saison Hiver\",\"Saison Printemps\"],\"source\":\"https://www.gemuese.ch/fr/recettes/roulade-au-chou-frise?_gl=1*1qqf0cl*_up*MQ..&gclid=EAIaIQobChMItdK7sbK4kQMVepKDBx0SyAWNEAAYASABEgL9oPD_BwE&gbraid=0AAAAA-NhTE5iAnPHfalM4KcSHGDur_dvT\",\"notes\":\"\",\"paprikaUid\":\"941D8C42-CE72-401F-A8D1-EE6600E7410A\"},{\"id\":\"riz-saute-aux-legumes-saucisse-et-curry-mrryzepy157\",\"title\":\"Riz sauté aux légumes, saucisse et curry\",\"category\":\"Corée\",\"time\":40,\"servings\":4,\"ingredients\":[[\"rond, cuit et froid\",350,\"g riz\"],[\"moyen\",2,\"pommes de terre de calibre\"],[\"oignon\",1,\"\"],[\"carotte\",1,\"\"],[\"rouge\",0.5,\"poivron\"],[\"courgette\",0.5,\"\"],[\"(ou japonais)\",20,\"g curry coréen\"],[\"beurre\",30,\"g\"],[\"maïs\",50,\"g\"],[\"knackis\",4,\"\"],[\"sel\",\"\",\"\"]],\"steps\":[\"Coupez les pommes de terre, l’oignon, la carotte, le poivron et la courgette en cubes de 1 cm.\",\"Coupez les knackis en rondelles d’un demi-centimètre d’épaisseur.\",\"Délayez le curry dans 3 cuillières à soupe d’eau.\",\"Faites chauffer le beurre à feu vif dans une sauteuse.\",\"Faites sauter l’oignon jusqu’à ce qu’il commence à devenir translucide.\",\"Ajoutez le maïs et faites sauter 3 mn.\",\"Ajoutez les pommes de terre et la carotte, puis assaisonnez.\",\"Versez-y 5 cl d’eau et laissez cuire 10 mn environ.\",\"Quand l’eau s’est évaporée, ajoutez la courgette, les knackis et le poivron.\",\"Faire sauter 5 mn.\",\"Vérifiez l’assaisonnement si besoin.\",\"Ajoutez le riz et le curry.\",\"Mélangez bien jusqu’à ce que le riz prenne uniformément la couleur du curry.\",\"Servez en portions individuelles en décorant si vous voulez avec des tomates cerises, une asperge…\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Corée\",\"Plat principal\"],\"source\":\"https://www.elle.fr/Elle-a-Table/Recettes-de-cuisine/Riz-saute-aux-legumes-saucisse-et-curry-4084630\",\"notes\":\"\",\"paprikaUid\":\"E411AD79-800C-4AEE-A7C9-C839D3080E51\"},{\"id\":\"riz-saute-au-poulet-avec-uf-au-plat-mrryzepxxzg\",\"title\":\"Riz sauté au poulet avec œuf au plat\",\"category\":\"Asie\",\"time\":80,\"servings\":4,\"ingredients\":[[\"complet\",300,\"g riz\"],[\"sel\",\"\",\"\"],[\"nouveaux\",1,\"botte oignons\"],[\"shiitakés\",80,\"g\"],[\"cuite\",250,\"g poulet\"],[\"frais\",6,\"œufs\"],[\"1½ citron vert\",\"\",\"\"],[\"cuire\",4,\"c. à soupe huile pour\"],[\"soja\",5,\"c. à soupe sauce\"],[\"tabasco\",\"\",\"\"],[\"plat\",0.25,\"bouquet persil\"]],\"steps\":[\"Cuire le riz 30-40 min à l’eau salée puis l’égoutter.\",\"Hacher grossièrement les oignons nouveaux, les champignons et le poulet.\",\"Battre un tiers des œufs.\",\"Exprimer le jus du citron vert.\",\"Chauffer la moitié de l’huile dans un wok.\",\"Y verser les œufs battus et laisser prendre en remuant.\",\"Ajouter les oignons nouveaux, les shiitakés et le poulet.\",\"Faire sauter le tout à feu vif durant env. 3 min.\",\"Ajouter le riz et poursuivre la cuisson.\",\"Assaisonner avec la sauce soja, le Tabasco et le jus de citron vert.\",\"Avec le restant d’huile, cuire le reste des œufs au plat.\",\"Les dresser sur le riz sauté. Effeuiller le persil par-dessus.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Poulet\",\"Wok\"],\"source\":\"https://migusto.migros.ch/fr/recettes/riz-saute-au-poulet-avec-oeuf-au-plat\",\"notes\":\"\",\"paprikaUid\":\"5FB1A2E5-6991-486C-AC8C-FF9666898D3F\"},{\"id\":\"riz-casimir-mrryzepw658\",\"title\":\"Riz Casimir\",\"category\":\"Asie\",\"time\":30,\"servings\":4,\"ingredients\":[[\"échalote\",1,\"u\"],[\"d'ail\",2,\"u gousse\"],[\"gingembre\",10,\"g\"],[\"fruits\",1,\"boîte cocktail de\"],[\"rôtir\",4,\"tbsp beurre à\"],[\"mild\",2,\"tbsp curry\"],[\"farine\",3,\"c. à café\"],[\"poule\",2,\"dl bouillon de\"],[\"crème\",1,\"dl\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"banane\",1,\"u\"],[\"poulet\",500,\"g minifilet de\"],[\"persil\",0.5,\"u bouquet\"]],\"steps\":[\"Hacher l'échalote, l'ail et le gingembre.\",\"Égoutter les fruits dans une passoire en veillant à recueillir le jus.\",\"Faire fondre la moitié du beurre dans une casserole et y saisir l'échalote, l'ail, le gingembre et le curry env. 1 min.\",\"Ajouter la farine et faire brièvement revenir.\",\"Mouiller avec le bouillon et le jus de fruits recueilli.\",\"Laisser mijoter la sauce jusqu'à légère liaison puis incorporer la crème et le cocktail de fruits.\",\"Assaisonner de sel et de poivre.\",\"À feu doux, maintenir la sauce au seuil du point d'ébullition.\",\"Couper le poulet en morceaux d'env. 2 cm et les bananes en rondelles.\",\"Faire fondre le reste du beurre dans une poêle.\",\"Y saisir la viande env. 2 min puis la saler et la poivrer.\",\"Ajouter le poulet à la sauce et laisser prendre env. 5 min.\",\"Dorer les rondelles de banane dans la poêle du poulet.\",\"Dresser la sauce, les fruits et le poulet avec les bananes et, selon les goûts, parsemer de coriandre.\",\"Idéal avec du riz.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Plat principal\",\"Poulet\",\"Suisse\"],\"source\":\"https://migusto.migros.ch/fr/recettes/riz-casimir\",\"notes\":\"\",\"paprikaUid\":\"23627D02-D607-4EC6-824B-7097FEA47A3F\"},{\"id\":\"riz-aux-legumes-coreen-et-uf-au-plat-mrryzepvyzq\",\"title\":\"Riz aux légumes coréen et œuf au plat\",\"category\":\"Corée\",\"time\":45,\"servings\":4,\"ingredients\":[[\"sushi\",300,\"g riz pour\"],[\"eau\",4,\"dl\"],[\"riz\",8,\"c. à soupe vinaigre de\"],[\"sucre\",2,\"c. à soupe\"],[\"sel\",\"\",\"\"],[\"carottes\",2,\"\"],[\"pak-choï\",100,\"g\"],[\"Paris\",100,\"g champignons de\"],[\"huile\",4,\"c. à soupe\"],[\"d'ail\",1,\"gousse\"],[\"gochujang\",1,\"c. à café\"],[\"soja\",2,\"c. à soupe sauce\"],[\"long\",100,\"g radis\"],[\"concombre\",100,\"g\"],[\"œufs\",4,\"petits\"],[\"mungo\",80,\"g pousses de haricots\"],[\"gochujang\",40,\"g pâte\"],[\"eau\",40,\"g\"]],\"steps\":[\"Bien rincer le riz sous l'eau courante froide.\",\"Amener l'eau à ébullition avec le riz.\",\"Couvrir et faire mijoter 10 min.\",\"Retirer la casserole du feu et laisser le riz gonfler 15 min à couvert.\",\"Ne pas soulever le couvercle!\",\"Entre-temps, chauffer le vinaigre avec le sucre et le sel jusqu'à dissolution des cristaux de sucre.\",\"Verser sur le riz et mélanger à la fourchette.\",\"Mélanger la pâte gochujang et l’eau pour obtenir une sauce, réserver.\",\"Tailler les carottes en fins bâtonnets et le pak-choï en quartiers.\",\"Couper les champignons en quatre puis les saisir brièvement à feu vif dans la moitié de l’huile avec les carottes et le pak-choï.\",\"Y presser l’ail puis incorporer la pâte pimentée.\",\"Mouiller avec la moitié de la sauce soja.\",\"Retirer les légumes de la poêle et les réserver au chaud.\",\"Couper le radis long et le concombre en tranches.\",\"Chauffer le reste de l'huile dans une poêle et y faire cuire les œufs au plat.\",\"Répartir le riz dans des bols puis y dresser tous les ingrédients ainsi que les pousses de haricots mungo.\",\"Servir avec la sauce gochujang.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Corée\",\"Plat principal\"],\"source\":\"https://migusto.migros.ch/fr/recettes/riz-aux-legumes-coreen-et-oeuf-au-plat\",\"notes\":\"\",\"paprikaUid\":\"8FE3233F-EA42-436D-ACF7-93D16A6451DF\"},{\"id\":\"riz-au-lait-cremeux-mrryzepvuoa\",\"title\":\"Riz au lait crémeux\",\"category\":\"Dessert\",\"time\":45,\"servings\":2,\"ingredients\":[[\"rond\",100,\"g riz\"],[\"entier\",1,\"lt lait\"],[\"poudre\",100,\"g sucre en\"],[\"vanille\",1,\"u gousse de\"],[\"sel\",\"\",\"\"],[\"cannelle\",\"\",\"\"]],\"steps\":[\"Porter le lait à ébullition.\",\"Couper en deux sur la longueur la gousse de vanille et gratter-en les graines avec la pointe d'un couteau.\",\"Une fois le lait frémissant, ajouter les graines de vanille ainsi que la gousse elle-même.\",\"Incorporer le sucre et une pincée de sel.\",\"Ajouter le riz rond préalablement rincé sous l'eau froide.\",\"Mélanger délicatement avec une cuillère en bois.\",\"Laisser le tout cuire à feu très doux pendant environ 45 minutes.\",\"Remuer régulièrement afin que le riz n'accroche pas au fond et pour obtenir une texture crémeuse du riz au lait parfait.\",\"Lorsque le mélange devient onctueux et que le riz est tendre, retirer du feu.\",\"Ôter la gousse de vanille.\",\"Verser la préparation dans des coupelles.\",\"Avant de servir, saupoudrer de cannelle.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Dessert\",\"Plat principal\"],\"source\":\"https://www.lescocottesmoelleuses.fr/riz-au-lait-cremeux-recette-traditionnelle-simplifiee-grace-a-la-cuisson-en-cocotte\",\"notes\":\"\",\"paprikaUid\":\"90B37737-9FE4-4E41-80BA-DE1903181781\"},{\"id\":\"risotto-a-l-ail-des-ours-mrryzeputrc\",\"title\":\"Risotto à l’ail des ours\",\"category\":\"Risotto\",\"time\":25,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"u\"],[\"huile\",1,\"c. à soupe\"],[\"risotto\",300,\"g\"],[\"blanc\",2.5,\"dl vin\"],[\"légumes\",9,\"dl bouillon de\"],[\"d’ail des ours\",1,\"u bouquet\"],[\"beurre\",50,\"g\"],[\"Sbrinz\",50,\"g\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Peler l’oignon et le hacher finement.\",\"Faire chauffer l’huile dans une casserole.\",\"Faire revenir l’oignon.\",\"Ajouter le riz, nacrer en remuant.\",\"Mouiller avec la moitié du vin.\",\"Faire réduire complètement.\",\"Verser le reste du vin.\",\"Faire réduire complètement.\",\"Verser peu à peu le bouillon en remuant souvent pour juste mouiller le riz à hauteur.\",\"Laisser mijoter env. 20 min jusqu’à ce qu’il soit crémeux et al dente.\",\"Couper grossièrement l’ail des ours.\",\"Incorporer au risotto avec le beurre et le Sbrinz.\",\"Rectifier l’assaisonnement.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Risotto\",\"Saison Printemps\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/risotto-a-lail-des-ours-10008188/\",\"notes\":\"\",\"paprikaUid\":\"F1023208-4313-456D-93EA-D897F0962936\"},{\"id\":\"risotto-a-la-tomate-et-chips-de-jambon-cru-mrryzeprsaw\",\"title\":\"Risotto à la tomate et chips de jambon cru\",\"category\":\"Italie\",\"time\":30,\"servings\":2,\"ingredients\":[[\"oignons\",1,\"\"],[\"tomates\",2,\"\"],[\"d'olive\",2,\"c. à soupe huile\"],[\"beurre\",50,\"g\"],[\"râpé\",80,\"g parmesan\"],[\"risotto\",200,\"g riz pour\"],[\"légumes\",4,\"dl bouillon de\"],[\"cru\",90,\"g jambon\"],[\"blanc\",2,\"dl vin\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Faire chauffer l'huile dans une casserole.\",\"Y faire suer l'oignon, ; ajouter le riz et et le faire revenir tout en remuant jusqu'à ce qu'il devienne translucide.\",\"Mouiller avec le vin, laisser réduire entièrement.\",\"Verser le bouillon au fur et à mesure de la cuisson, en remuant souvent et en veillant à ce que le riz soit toujours recouvert de liquide.\",\"Laisser mijoter env. 10 min., ajouter les tomates et poursuivre la cuisson env. 5 min. jusqu'à ce que le riz soit crémeux mais toujours al dente.\",\"Ajouter le beurre et le fromage, saler et poivrer.\",\"Faire griller le jambon cru pendant env. 4 min. dans une poêle antiadhésive, sans ajouter de matière grasse.\",\"Servir avec le risotto.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Risotto\"],\"source\":\"https://fooby.ch/fr/recettes/16231/risotto-a-la-tomate-et-chips-de-jambon-cru\",\"notes\":\"\",\"paprikaUid\":\"3467470B-BBC0-44A0-8458-1CA130A2BABE\"},{\"id\":\"risotto-a-la-tomate-mrryzeppig3\",\"title\":\"Risotto à la tomate\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"u\"],[\"d’ail\",1,\"u gousse\"],[\"beurre\",1,\"c. à soupe\"],[\"d’olive\",1,\"tbsp huile\"],[\"risotto\",250,\"g riz à\"],[\"tomates\",2,\"tbsp concentré de\"],[\"cerises\",300,\"g tomates\"],[\"blanc\",1,\"dl vin\"],[\"légumes\",8,\"dl bouillon de\"],[\"parmesan\",50,\"g\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"d’ail\",6,\"u gousses\"],[\"d’olive\",1,\"tbsp huile\"],[\"Sbrinz\",30,\"g\"]],\"steps\":[\"Faire revenir l’oignon et l’ail dans le beurre et dans l’huile.\",\"Ajouter le riz et faire revenir brièvement.\",\"Ajouter la purée de tomates et les tomates et faire revenir brièvement.\",\"Déglacer avec le vin et faire réduire entièrement le liquide.\",\"Ajouter ensuite petit à petit le bouillon pendant 15 à 20 minutes en remuant de temps en temps jusqu’à ce que le riz soit encore légèrement ferme sous la dent et présente une consistance visqueuse.\",\"Ajouter le fromage râpé et assaisonner.\",\"Faire dorer l’ail dans l’huile chaude.\",\"Verser sur le risotto et garnir de copeaux de Sbrinz.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Risotto\",\"Saison Hiver\",\"Saison Printemps\"],\"source\":\"https://www.gemuese.ch/fr/recettes/risotto-aux-tomates?_gl=1*109yged*_up*MQ..*_gs*MQ..&gclid=EAIaIQobChMItdK7sbK4kQMVepKDBx0SyAWNEAAYASABEgL9oPD_BwE&gbraid=0AAAAA-NhTE5iAnPHfalM4KcSHGDur_dvT\",\"notes\":\"\",\"paprikaUid\":\"271888A8-96E4-4F91-96DB-24033B2D0555\"},{\"id\":\"risotto-a-la-courge-et-aux-graines-de-courge-mrryzepobkd\",\"title\":\"Risotto à la courge et aux graines de courge\",\"category\":\"Italie\",\"time\":40,\"servings\":4,\"ingredients\":[[\"courge\",30,\"g graines de\"],[\"oignons\",1,\"\"],[\"courge\",500,\"g\"],[\"beurre\",1,\"c. à soupe\"],[\"double-crème\",100,\"g fromage frais\"],[\"râpé\",150,\"g parmesan\"],[\"risotto\",300,\"g riz pour\"],[\"1⅕ l bouillon de légumes\",\"\",\"\"],[\"safran\",1,\"pochette\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Peler l'oignon, le hacher.\",\"Peler la courge, la couper en deux et retirer les graines avec une cuillère.\",\"Couper la courge en dés d'env. 1 cm.\",\"Faire griller les graines de courge dans une poêle.\",\"Faire chauffer le beurre dans une casserole et y faire suer l'oignon.\",\"Ajouter le riz et le faire cuire en remuant jusqu'à ce qu'il devienne translucide.\",\"Mélanger le bouillon et le safran.\",\"Verser ce mélange au fur et à mesure de la cuisson, en remuant souvent et en veillant à ce que le riz soit toujours recouvert de liquide.\",\"Ajouter la courge au bout d'env. 10 min.\",\"Laisser mijoter env. 10 min. de plus, jusqu'à ce que le riz soit crémeux et al dente.\",\"Ajouter le fromage et le fromage frais,  mélanger, assaisonner puis dresser le risotto.\",\"Parsemer de graines de courge.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Risotto\"],\"source\":\"https://little.fooby.ch/fr/recettes/20199/risotto-a-la-courge-et-aux-graines-de-courge\",\"notes\":\"\",\"paprikaUid\":\"528AEE7C-9CA8-456C-905F-757EFBABAF7C\"},{\"id\":\"risotto-verde-et-gremolata-mrryzepnznz\",\"title\":\"Risotto verde et Gremolata\",\"category\":\"Italie\",\"time\":30,\"servings\":4,\"ingredients\":[[\"plat\",1,\"bouquet persil\"],[\"fanes\",3,\"oignons botte avec les\"],[\"basilic\",1,\"bouquet\"],[\"poivrée\",2,\"brin menthe\"],[\"d’ail\",1,\"gousses\"],[\"citrons\",0.5,\"\"],[\"d'épinards\",100,\"g pousses\"],[\"beurre\",3,\"c. à soupe\"],[\"râpé\",80,\"g parmesan\"],[\"risotto\",300,\"g riz pour\"],[\"blanc\",1,\"dl vin\"],[\"fleur de sel\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Mixer le persil avec l'eau.\",\"Faire fondre le beurre dans une casserole.\",\"Y faire suer les oignons botte.\",\"Ajouter le riz et le faire cuire en remuant jusqu'à ce qu'il devienne translucide.\",\"Mouiller avec le vin, laisser réduire presque entièrement.\",\"Porter à ébullition l'eau avec le persil, saler.\",\"La verser petit à petit dans le riz au fur et à mesure de la cuisson, en remuant souvent et en veillant à ce que le riz soit toujours recouvert de liquide.\",\"Laisser mijoter pendant env. 20 min. jusqu'à ce que le riz soit onctueux mais al dente.\",\"Mélanger les fines herbes, l'ail, le zeste de citron et le sel, réserver.\",\"Ajouter les épinards, le fromage et le beurre au risotto, mélanger puis assaisonner.\",\"Dresser le risotto sur des assiettes.\",\"Y répartir la gremolata et la verdure des oignons réservée.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Risotto\"],\"source\":\"https://fooby.ch/fr/recettes/19727/risotto-verde-et-gremolata\",\"notes\":\"\",\"paprikaUid\":\"E8EAD400-F079-44D5-BE07-F6FD1C818FD8\"},{\"id\":\"risotto-de-saison-aux-asperges-et-cafe-mrryzepmypp\",\"title\":\"Risotto de saison aux asperges et café\",\"category\":\"Asperges\",\"time\":0,\"servings\":4,\"ingredients\":[[\"risotto\",200,\"g\"],[\"échalote\",1,\"u\"],[\"ail\",1,\"u gousse\"],[\"verte\",1,\"kg asperge\"],[\"blanc\",1,\"dl vin\"],[\"poulet\",3,\"dl bouillon de\"],[\"espresso\",2,\"tsp café soluble ou un\"],[\"beurre\",\"\",\"\"],[\"poivre blanc\",\"\",\"\"]],\"steps\":[\"Préparer les asperges et les couper en bouts de 2 cm.\",\"Hacher l'échalote et l'ail.\",\"Faire revenir l'échalote et l'ail.\",\"Ajouter le riz, remuer environ 2 min.\",\"Déglacer au vin blanc, laisser évaporer\",\"Mouiller avec le bouillon de poulet et le café.\",\"Ajouter les asperges (garder les pointes et les ajouter après 10 min de cuisson).\",\"Ajouter une noix de beurre et du poivre blanc juste avant de servir.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asperges\",\"Saison Printemps\"],\"source\":\"https://www.poivre.ch/recette/risotto-aux-asperges-et-cafe/\",\"notes\":\"\",\"paprikaUid\":\"640932D8-A929-4C5F-8A6B-924A5EC16819\"},{\"id\":\"risotto-cremeux-a-la-courge-et-graines-de-courge-croustillantes-mrryzepmcqf\",\"title\":\"Risotto Crémeux À La Courge Et Graines De Courge Croustillantes\",\"category\":\"A\",\"time\":175,\"servings\":4,\"ingredients\":[[\"Riz Carnaroli 320 g\",\"\",\"\"],[\"Courge (à nettoyer) 600 g\",\"\",\"\"],[\"Graines de citrouille 25 g\",\"\",\"\"],[\"Céleri 50 g\",\"\",\"\"],[\"Oignons blancs 50 g\",\"\",\"\"],[\"Carottes 50 g\",\"\",\"\"],[\"Vinaigre de cidre 18 g\",\"\",\"\"],[\"Eau 750 g\",\"\",\"\"],[\"Romarin 1 brin\",\"\",\"\"],[\"Sage 1 brin\",\"\",\"\"],[\"Zeste de citron à volonté\",\"\",\"\"],[\"Sel fin à volonté\",\"\",\"\"],[\"Poivre noir à volonté\",\"\",\"\"],[\"Parmigiano Reggiano AOP 30 g\",\"\",\"\"],[\"Vinaigre 1 cuillère à soupe\",\"\",\"\"],[\"Huile d'olive extra vierge à volonté\",\"\",\"\"]],\"steps\":[\"Pour préparer le risotto à la courge, commencez par couper la courge en deux : prélevez une tranche de 100 g et mettez-la de côté, puis retirez la chair et les graines du reste 1 . Assaisonnez avec du sel 2 , du poivre, du romarin et de la sauge 3 .\",\"Déposez la courge sur une plaque de cuisson 4 et enfournez à 140 C pendant environ 2 heures, jusqu'à ce qu'elle soit très tendre. Entre-temps, épluchez la tranche de courge de 100 g que vous avez conservée 5 ; ne jetez pas la peau, elle servira pour le bouillon. Dans une casserole, faites griller l'oignon coupé en deux à sec, puis ajoutez les carottes et le céleri coupés en gros morceaux 6 .\",\"Ajoutez également la peau de la courge 7 , puis couvrez avec 750 g d'eau 8 et faites cuire pendant 30 minutes 9 .\",\"Une fois prêt 10 , filtrez le bouillon en le versant dans une petite casserole 11 . Coupez maintenant la tranche de courge en petits dés d'environ un demi-centimètre 12 .\",\"Blanchissez brièvement les dés dans le bouillon chaud, pendant environ 25 secondes 13 . Égouttez 14 et séchez délicatement 15 .\",\"Assaisonnez la courge avec le vinaigre de cidre 16 et mélangez pour parfumer 17 . Faites griller les graines de courge à la poêle à feu moyen-doux pendant 7-8 minutes ou au four à 170 C pendant environ 5 minutes, jusqu'à ce qu'elles soient croustillantes.\",\"Réservez 19 . Occupez-vous de la courge cuite au four 20 : prélevez la chair à l'aide d'une cuillère 21 , mettez-la dans un bol et écrasez-la à la fourchette jusqu'à obtenir une purée rustique.\",\"Rectifiez l'assaisonnement en sel 22 et en poivre 23 et parfumez avec le zeste de citron râpé 24 .\",\"Mélangez et réservez 25 . Faites dorer le riz à sec dans une casserole à fond épais 26 27 .\",\"Commencez la cuisson en ajoutant le bouillon de légumes chaud peu à peu 28 . Après 5-6 minutes, incorporez la purée de courge 29 et poursuivez la cuisson en remuant, jusqu'à ce que le risotto soit à point. Retirez du feu et parfumez encore avec du zeste de citron 30 .\",\"Poivrez selon votre goût 31 et montez le risotto avec le fromage râpé, le vinaigre et l'huile d'olive extra vierge 32 , en mélangeant pour obtenir une texture crémeuse. Répartissez le risotto dans les assiettes 33 .\",\"Terminez avec les dés de courge au vinaigre 34 et les graines de courge grillées 35 . Votre risotto à la courge et aux graines est prêt à être servi 36 !\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"A\"],\"source\":\"https://www.giallozafferano.fr/recettes/risotto-cremeux-a-la-courge-et-graines-de-courge-croustillantes.html\",\"notes\":\"\",\"paprikaUid\":\"5F4178E2-B46D-41B6-B7BE-AE7D4D7992FF\"},{\"id\":\"risotto-aux-epinards-mrryzeplsf4\",\"title\":\"Risotto aux épinards\",\"category\":\"Italie\",\"time\":30,\"servings\":4,\"ingredients\":[[\"haché\",1,\"oignon finement\"],[\"beurre\",\"\",\"\"],[\"d'ail pressées\",2,\"gousses\"],[\"risotto\",300,\"g riz à\"],[\"chaud\",9,\"dl bouillon\"],[\"surgelés, décongelés\",300,\"g épinards frais ou\"],[\"2½ dl crème\",\"\",\"\"],[\"râpé\",120,\"g Sbrinz\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Faire revenir l'oignon dans le beurre.\",\"Ajouter l'ail et le riz, faire revenir.\",\"Mouiller avec un peu de bouillon.\",\"Ajouter le bouillon chaud peu à peu.\",\"Laisser mijoter 15-20 min à feu doux en remuant souvent.\",\"Mixer les épinards et la crème.\",\"Incorporer au risotto.\",\"Ajouter le fromage.\",\"Assaisonner.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Risotto\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2024_DIVE_07/risotto-aux-epinards/\",\"notes\":\"\",\"paprikaUid\":\"6DF48C3C-9B35-4066-84F6-14714A2BA4D0\"},{\"id\":\"risotto-aux-morilles-et-aux-epinards-mrryzepke0z\",\"title\":\"Risotto aux morilles et aux épinards\",\"category\":\"Italie\",\"time\":30,\"servings\":4,\"ingredients\":[[\"séchées\",20,\"g morilles\"],[\"oignons\",2,\"u\"],[\"d’ail\",1,\"u gousses\"],[\"séchées\",6,\"u tomates\"],[\"d'épinards\",300,\"g pousses\"],[\"raisinets\",2,\"tbsp gelée de\"],[\"d'olive\",1,\"tbsp huile\"],[\"Sbrinz\",50,\"g\"],[\"Roquefort\",100,\"g\"],[\"risotto\",300,\"g\"],[\"légumes\",1,\"l bouillon de\"],[\"1½ dl vin blanc\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Couper les morilles en deux.\",\"Bien les laver et les égoutter.\",\"Râper le Sbrinz.\",\"Couper le Roquefort en morceaux.\",\"Préparer le bouillon.\",\"Faire chauffer l'huile dans une poêle.\",\"Y faire revenir les oignons, l'ail, les tomates et les morilles.\",\"Ajouter le riz et le faire cuire en remuant jusqu'à ce qu'il devienne translucide.\",\"Mouiller avec le vin.\",\"Laisser réduire entièrement.\",\"Verser le bouillon petit à petit tout en remuant, de façon à ce que le riz soit toujours recouvert de liquide.\",\"Laisser frémir env. 15 min.\",\"Ajouter les épinards petit à petit.\",\"Lorsqu'ils ont complètement réduit, laisser mijoter 5 min. jusqu'à ce que le riz devienne al dente.\",\"Incorporer le fromage, assaisonner.\",\"Servir avec de la gelée.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Risotto\"],\"source\":\"https://fooby.ch/fr/recettes/16673/risotto-aux-morilles-et-aux-epinards\",\"notes\":\"\",\"paprikaUid\":\"EBBB033D-BA9B-4E55-8FCA-79D642D82E44\"},{\"id\":\"risotto-aux-fines-herbes-mrryzepjjod\",\"title\":\"Risotto aux fines herbes\",\"category\":\"Italie\",\"time\":30,\"servings\":4,\"ingredients\":[[\"échalotes\",1,\"\"],[\"origan\",2,\"c. à soupe\"],[\"citrons\",0.5,\"\"],[\"d'olive\",1,\"c. à soupe huile\"],[\"mascarpone\",4,\"c. à soupe\"],[\"râpé\",2,\"c. à soupe parmesan\"],[\"risotto\",240,\"g riz pour\"],[\"légumes\",5,\"dl bouillon de\"],[\"blanc\",1,\"dl vin\"],[\"thym\",2,\"c. à soupe\"]],\"steps\":[\"Faire chauffer l'huile dans une casserole et y faire suer l'échalote pendant env. 2 min.\",\"Ajouter le riz et le faire cuire en remuant jusqu'à ce qu'il devienne translucide.\",\"Mouiller avec le vin, laisser réduire presque entièrement.\",\"Ajouter les fines herbes et le zeste de citron.\",\"Verser le bouillon petit à petit tout en remuant, de façon à ce que le riz soit toujours recouvert de liquide.\",\"Laisser mijoter pendant env. 20 min. jusqu'à ce que le riz soit onctueux et al dente.\",\"Incorporer le mascarpone et le parmesan.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Risotto\"],\"source\":\"https://fooby.ch/fr/recettes/13225/risotto-aux-fines-herbes\",\"notes\":\"\",\"paprikaUid\":\"C66B413B-831D-419A-AA39-A8E3275F6F8A\"},{\"id\":\"risotto-aux-courgettes-et-a-la-pancetta-mrryzepia1r\",\"title\":\"Risotto Aux Courgettes Et À La Pancetta\",\"category\":\"A\",\"time\":45,\"servings\":4,\"ingredients\":[[\"Riz Carnaroli 320 g\",\"\",\"\"],[\"Courgettes (à nettoyer) 500 g\",\"\",\"\"],[\"Pancetta 150 g\",\"\",\"\"],[\"Bouillon de légumes chaud 1 l\",\"\",\"\"],[\"Vin blanc 50 g\",\"\",\"\"],[\"Sel fin à volonté\",\"\",\"\"],[\"Parmigiano Reggiano AOP 100 g\",\"\",\"\"],[\"Beurre froid 50 g\",\"\",\"\"],[\"Poivre noir à volonté\",\"\",\"\"]],\"steps\":[\"Pour préparer le risotto aux courgettes et à la pancetta, commencez par couper la pancetta en dés 1 . Lavez les courgettes et coupez-les d'abord en tranches 2 , puis en bâtonnets et enfin en dés 3 .\",\"Versez la pancetta dans une grande casserole 4 . Faites-la revenir à feu moyen-doux pendant environ 6-7 minutes, jusqu'à ce qu'elle soit bien dorée et légèrement croustillante 5 , puis prélevez-en une poignée et réservez-la pour la décoration finale. Ajoutez les courgettes à la pancetta 6 .\",\"Mélangez 7 et faites cuire encore 6-7 minutes à feu moyen, en remuant de temps en temps, jusqu'à ce qu'elles deviennent tendres 8 . À ce stade, ajoutez le riz 9 .\",\"Faites griller le riz pendant 5-6 minutes en remuant souvent 10 . Déglacez avec le vin blanc 11 et laissez complètement s'évaporer l'alcool. Poursuivez la cuisson en ajoutant le bouillon de légumes chaud peu à peu 12 .\",\"Remuez et attendez qu'il soit absorbé avant d'en ajouter. Rectifiez l'assaisonnement en sel 13 et portez le risotto à cuisson, cela prendra environ 12-15 minutes 14 . Une fois cuit, liez le risotto hors du feu : ajoutez le beurre en morceaux 15 .\",\"Ajoutez également le Parmigiano râpé 16 , un tour de moulin de poivre 17 et mélangez avec une cuillère en bois 18 .\",\"Vous devez obtenir une consistance crémeuse 19 . Dressez en assiette en complétant avec la pancetta croustillante réservée 20 et servez immédiatement votre risotto aux courgettes et à la pancetta 21 .\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"A\"],\"source\":\"https://www.giallozafferano.fr/recettes/risotto-aux-courgettes-et-a-la-pancetta.html\",\"notes\":\"\",\"paprikaUid\":\"4977D272-A6C6-4129-89B4-C381B7F90289\"},{\"id\":\"risotto-aux-champignons-a-l-autocuiseur-mrryzepicqi\",\"title\":\"Risotto aux champignons à l’autocuiseur\",\"category\":\"Cocotte\",\"time\":25,\"servings\":4,\"ingredients\":[[\"hachées\",60,\"g échalotes françaises\"],[\"beurre\",55,\"g\"],[\"arborio\",210,\"g riz\"],[\"blanc\",125,\"ml vin\"],[\"poulet\",500,\"ml bouillon de\"],[\"variés, émincés\",340,\"g champignons\"],[\"d’olive\",60,\"ml huile\"],[\"râpé, et plus pour le service\",55,\"g fromage parmesan frais\"]],\"steps\":[\"Préchauffer l’autocuiseur à la fonction sauté 2 minutes.\",\"Dorer l’échalote dans le beurre 2 minutes.\",\"Ajouter le riz et cuire 1 minute en remuant à la cuillère de bois pour bien enrober les grains de riz.\",\"Déglacer avec le vin.\",\"Cuire en remuant jusqu’à ce que le liquide soit presque absorbé.\",\"Ajouter le bouillon et bien mélanger.\",\"Couvrir et sélectionner la fonction soupe.\",\"Régler le temps de cuisson à 6 minutes.\",\"Entre-temps, dans une grande poêle antiadhésive à feu élevé, cuire les champignons dans l’huile jusqu’à ce qu’ils soient dorés, soit environ 10 minutes.\",\"Saler et poivrer.\",\"Dépressuriser l’appareil manuellement, puis retirer le couvercle.\",\"Ajouter le parmesan et les champignons cuits.\",\"Remuer pour avoir une consistance crémeuse.\",\"Ajouter du bouillon au besoin.\",\"Saler et poivrer.\",\"Servir dans des assiette creuses et garnir de parmesan, si désiré.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Cocotte\",\"Plat principal\",\"Poulet\",\"Risotto\"],\"source\":\"https://www.ricardocuisine.com/recettes/8723-risotto-aux-champignons-a-l-autocuiseur\",\"notes\":\"\",\"paprikaUid\":\"C9456C94-D744-4586-B73A-12A8F01A89E4\"},{\"id\":\"risotto-aux-carottes-et-aux-petits-pois-mrryzepg7ea\",\"title\":\"Risotto aux carottes et aux petits pois\",\"category\":\"Plat principal\",\"time\":45,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"\"],[\"beurre\",2,\"c. à soupe\"],[\"carotte\",400,\"g\"],[\"risotto\",200,\"g riz à\"],[\"légumes\",5,\"dl bouillon de\"],[\"pois, surgelés\",200,\"g petits\"],[\"carottes\",4,\"dl jus de\"],[\"beurre\",2,\"c. à soupe\"],[\"Sbrinz\",80,\"g\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Hacher l'oignon et râper les carottes à l'aide de la râpe à rösti.\",\"Préparer le bouillon.\",\"Dans une casserole, faire revenir les oignons dans le beurre chaud.\",\"Ajouter les carottes et faire revenir brièvement.\",\"Ajouter le riz et faire revenir brièvement.\",\"Ajouter petit à petit le bouillon, en remuant souvent, de sorte à ce que le riz soit toujours tout juste couvert de liquide.\",\"Laisser mijoter pendant 15 à 18 minutes.\",\"Ajouter les petits pois.\",\"Verser petit à petit le jus de carotte et laisser mijoter encore pendant 5 à 7 minutes.\",\"Affiner avec du beurre et du fromage râpé.\",\"Assaisonner.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Risotto\",\"Saison Hiver\",\"Saison Printemps\"],\"source\":\"https://www.gemuese.ch/fr/recettes/risotto-aux-carottes-et-aux-petits-pois?_gl=1*7oikc*_up*MQ..&gclid=EAIaIQobChMItdK7sbK4kQMVepKDBx0SyAWNEAAYASABEgL9oPD_BwE&gbraid=0AAAAA-NhTE5iAnPHfalM4KcSHGDur_dvT\",\"notes\":\"\",\"paprikaUid\":\"0CF9119C-C38E-4B5A-AFC8-E29F82BF7BD5\"},{\"id\":\"risotto-aux-bolets-mrryzepg75m\",\"title\":\"Risotto aux bolets\",\"category\":\"Italie\",\"time\":35,\"servings\":4,\"ingredients\":[[\"séchés\",25,\"g bolets\"],[\"oignons\",1,\"\"],[\"beurre\",3,\"c. à soupe\"],[\"râpé\",40,\"g parmesan\"],[\"risotto\",300,\"g riz pour\"],[\"légumes\",9,\"dl bouillon de\"],[\"blanc\",1,\"dl vin\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Faire tremper les bolets dans l'eau, les sortir et les réserver.\",\"Passer l'eau des bolets à travers un filtre à café et la réserver.\",\"Faire fondre le beurre dans une casserole et y faire suer l'oignon.\",\"Ajouter le riz et le faire cuire en remuant jusqu'à ce qu'il devienne translucide.\",\"Mouiller avec le vin blanc et laisser réduire presque entièrement.\",\"Ajouter les champignons, verser le bouillon et l'eau des bolets petit à petit tout en remuant, de façon à ce que le riz soit toujours recouvert de liquide.\",\"Laisser mijoter pendant env. 20 min. jusqu'à ce que le riz soit onctueux et al dente.\",\"Incorporer le parmesan et le beurre, assaisonner.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Risotto\"],\"source\":\"https://fooby.ch/fr/recettes/18192/risotto-aux-bolets\",\"notes\":\"\",\"paprikaUid\":\"C7A2BB65-A2F2-4A1F-9386-A7D93C808A7C\"},{\"id\":\"risotto-aux-asperges-a-l-autocuiseur-mrryzepfxe6\",\"title\":\"Risotto aux asperges à l'autocuiseur\",\"category\":\"Asperges\",\"time\":25,\"servings\":2,\"ingredients\":[[\"d’olive\",2,\"c. à soupe huile\"],[\"beurre\",50,\"g\"],[\"4 cm\",300,\"g asperges coupées en tronçons de\"],[\"dés\",1,\"petit oignon coupé en petits\"],[\"d’ail hachées finement\",2,\"gousses\"],[\"arborio\",2,\"tasses riz\"],[\"sec\",0.5,\"tasse vin blanc\"],[\"légumes\",4,\"tasses bouillon de\"],[\"jus d’un demi citron\",\"\",\"\"],[\"râpé\",0.75,\"tasse parmesan\"],[\"sel\",\"\",\"\"],[\"poivre au goût\",\"\",\"\"]],\"steps\":[\"Appuyer la fonction « Sauté » de l’autocuiseur.\",\"Y chauffer l’huile.\",\"Y faire cuire les asperges en remuant délicatement de 3 à 5 minutes, jusqu’à ce qu’elles soient tendres mais toujours légèrement croquantes.\",\"Retirer du contenant et réserver.\",\"Ajouter le beurre et faire fondre ce dernier.\",\"Incorporer les oignons et faire sauter de 3 à 5 minutes jusqu’à ce qu’ils deviennent translucides en remuant de temps à autre.\",\"Ajouter l’ail et cuire une minute de plus.\",\"Incorporer le riz et bien enrober les grains du beurre.\",\"Faire cuire en remuant 2 minutes.\",\"Déglacer avec le vin blanc et remuer jusqu’à ce qu’il soit presque tout évaporé.\",\"Ajouter le bouillon ainsi que le jus de citron et bien mélanger.\",\"Passer l’autocuiseur à la fonction « Soupe » pour 6 minutes et couvrir.\",\"Procéder à une dépressurisation manuelle et retirer le couvercle.\",\"Saler et poivrer au gout.\",\"Incorporer les asperges ainsi que le fromage parmesan.\",\"Mélanger délicatement afin de ne pas briser les têtes.\",\"Servir immédiatement et garnir de zeste de citron si désiré.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asperges\",\"Cocotte\",\"Plat principal\",\"Risotto\"],\"source\":\"https://chefsimon.com/gourmets/pierre-andre-denis/recettes/risotto-aux-asperges-a-l-autocuiseur\",\"notes\":\"\",\"paprikaUid\":\"09F44501-3A6D-4100-9FF5-7867F9E4708E\"},{\"id\":\"risotto-au-poivre-et-legumes-caramelises-mrryzepekfg\",\"title\":\"Risotto au poivre et légumes caramélisés\",\"category\":\"Italie\",\"time\":40,\"servings\":4,\"ingredients\":[[\"Légumes:\",\"\",\"\"],[\"sucre\",2,\"c. à soupe\"],[\"eau\",1,\"c. à soupe\"],[\"beurre\",2,\"c. à soupe\"],[\"(carottes jaunes, panais et topinambours) pelés ou bien nettoyés, coupés en bâtonnets\",250,\"g carottes\"],[\"légumes\",1,\"dl bouillon de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"Risotto:\",\"\",\"\"],[\"échalote, finement hachée\",1,\"\"],[\"d'ail, pressées\",2,\"gousses\"],[\"beurre pour faire suer\",\"\",\"\"],[\"risotto\",400,\"g riz à\"],[\"1½ dl vin blanc ou de bouillon de légumes\",\"\",\"\"],[\"légumes, chaud\",8,\"dl bouillon de\"],[\"crème\",1,\"dl\"],[\"concassés\",2,\"c. à café mélange de poivres grossièrement\"],[\"Décoration:\",\"\",\"\"],[\"lanières\",4,\"c. à soupe poireau détaillé en fines\"],[\"Sbrinz, râpé\",75,\"g\"]],\"steps\":[\"min\",\"Légumes: caraméliser le sucre avec l'eau. Ajouter le beurre. Etuver brièvement les légumes, mouiller avec le bouillon, cuire al dente à couvert. Oter le couvercle, réduire légèrement le liquide, saler, poivrer.\",\"Risotto: faire suer l'échalote et l'ail dans le beurre. Ajouter le riz, étuver jusqu'à ce que les grains soient translucides. Mouiller avec le vin et le bouillon, réduire le liquide en remuant. Verser progressivement le bouillon chaud, remuer fréquemment jusqu'à ce que le riz soit al dente. Incorporer la crème et le poivre.\",\"Répartir le risotto dans des bols ou des assiettes chaudes, garnir de légumes, décorer et servir sans attendre.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Risotto\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM201201_14/risotto-au-poivre-et-legumes-caramelises/\",\"notes\":\"\",\"paprikaUid\":\"DE94CF96-A73E-4D66-A680-C6F697AA1A4F\"},{\"id\":\"risotto-au-parmesan-mrryzepdyzf\",\"title\":\"Risotto au parmesan\",\"category\":\"Italie\",\"time\":40,\"servings\":4,\"ingredients\":[[\"oignons\",1,\"\"],[\"d'olive\",1,\"c. à soupe huile\"],[\"entier\",2,\"dl lait\"],[\"(morceau)\",200,\"g parmesan\"],[\"beurre\",1,\"c. à soupe\"],[\"risotto\",300,\"g riz pour\"],[\"blanc\",2,\"dl vin\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Faire bouillir le lait. Retirer la casserole du feu.\",\"Ajouter le fromage, mélanger, couvrir et laisser reposer pendant env. 30 min en remuant de temps en temps.\",\"Faire fondre le beurre dans une sauteuse.\",\"Y faire suer l'oignon pendant 2 min.\",\"Ajouter le riz, faire cuire en remuant jusqu'à ce que le riz devienne translucide.\",\"Mouiller avec le vin, laisser réduire presque entièrement, saler.\",\"Verser l'eau au fur et à mesure de la cuisson, en remuant souvent et en veillant à ce que le riz soit toujours recouvert de liquide.\",\"Laisser mijoter pendant env. 20 min jusqu'à ce que le riz soit al dente.\",\"Retirer la sauteuse du feu.\",\"Verser le lait au parmesan dans le risotto à travers une passoire tout en remuant, mélanger, laisser reposer pendant 2 min.\",\"Dresser le risotto, arroser d'huile d'olive, répartir le fromage, assaisonner.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Risotto\"],\"source\":\"https://fooby.ch/fr/recettes/26820/risotto-au-parmesan\",\"notes\":\"\",\"paprikaUid\":\"B9F770C3-2D31-43CB-9ECE-B02F5E5C73CE\"},{\"id\":\"risotto-au-citron-et-tomates-cerises-caramelisees-mrryzepdjvr\",\"title\":\"Risotto au citron et tomates cerises caramélisées\",\"category\":\"Italie\",\"time\":35,\"servings\":2,\"ingredients\":[[\"noix\",20,\"g\"],[\"cerises\",100,\"g tomates\"],[\"ail\",1,\"\"],[\"citrons\",1,\"\"],[\"oignons\",1,\"\"],[\"d'olive\",1,\"c. à soupe huile\"],[\"sucre\",20,\"g\"],[\"beurre\",20,\"g\"],[\"râpé\",40,\"g grana padano\"],[\"risotto\",150,\"g riz pour\"],[\"légumes\",4,\"dl bouillon de\"],[\"poivre\",\"\",\"\"],[\"sel\",\"\",\"\"]],\"steps\":[\"Faire chauffer l'huile dans une casserole.\",\"Y faire suer l'oignon et l'ail.\",\"Ajouter le riz et le faire cuire en remuant jusqu'à ce qu'il devienne translucide.\",\"Verser le bouillon au fur et à mesure de la cuisson, en remuant souvent et en veillant à ce que le riz soit toujours recouvert de liquide.\",\"Laisser mijoter env. 20 min. jusqu'à ce que le riz soit crémeux mais al dente.\",\"Ajouter le fromage, le zeste et le jus de citron, mélanger.\",\"Faire fondre le beurre dans une grande poêle.\",\"Ajouter le sucre et laisser frémir en donnant un mouvement de va-et-vient à la casserole jusqu'à obtenir un caramel doré.\",\"Déposer sur le beurre caramélisé les tomates face coupée vers le bas, les étuver brièvement.\",\"Ajouter le jus de citron et les noix, rectifier l'assaisonnement.\",\"Faire cuire à feu moyen pendant env. 2 min. en retournant une fois les tomates cerises.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Risotto\"],\"source\":\"https://fooby.ch/fr/recettes/13736/risotto-au-citron-et-tomates-cerises-caramelisees\",\"notes\":\"\",\"paprikaUid\":\"E90D3C2F-9BC6-4B43-BF43-BDFB7D3AA60E\"},{\"id\":\"risotto-mrryzepc9nu\",\"title\":\"Risotto\",\"category\":\"Italie\",\"time\":40,\"servings\":4,\"ingredients\":[[\"parmesan\",90,\"g\"],[\"échalotes\",1,\"\"],[\"citrons\",2,\"\"],[\"noisettes\",40,\"g\"],[\"plat\",2,\"brin persil\"],[\"d'olive\",3,\"c. à soupe huile\"],[\"chanvre\",4,\"c. à soupe graines de\"],[\"risotto\",300,\"g riz pour\"],[\"légumes\",8,\"dl bouillon de\"],[\"blanc\",2,\"dl vin\"]],\"steps\":[\"Faire chauffer l'huile dans une grande casserole.\",\"Y faire revenir les échalotes pendant 2 min.\",\"Ajouter le riz et le faire cuire en le remuant jusqu'à ce qu'il devienne translucide (env. 5 min).\",\"Mouiller avec le vin, laisser réduire presque entièrement.\",\"Verser le bouillon au fur et à mesure de la cuisson, en remuant souvent et en veillant à ce que le riz soit toujours recouvert de liquide.\",\"Laisser mijoter pendant env. 20 min jusqu'à ce que le riz soit al dente.\",\"Ajouter le fromage râpé, ainsi que le zeste et le jus de citron.\",\"Mélanger.\",\"Mélanger l'huile, les noisettes, les graines de chanvre et le zeste de citron.\",\"Répartir ce mélange sur le risotto et parsemer de persil.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Risotto\"],\"source\":\"https://fooby.ch/fr/recettes/25107/risotto-vegane\",\"notes\":\"\",\"paprikaUid\":\"12FECB4A-6EDF-428F-B873-30EF31BED5BC\"},{\"id\":\"rigatoni-alla-vignarola-mrryzepay8f\",\"title\":\"Rigatoni alla vignarola\",\"category\":\"Asperges\",\"time\":45,\"servings\":4,\"ingredients\":[[\"fanes\",2,\"oignons botte avec les\"],[\"pois\",100,\"g petits\"],[\"vertes\",6,\"asperges\"],[\"citrons\",0.5,\"\"],[\"plat\",0.5,\"bouquet persil\"],[\"d'olive\",2,\"c. à soupe huile\"],[\"mozzarella\",125,\"g\"],[\"pâtes\",300,\"g\"],[\"fève\",450,\"g\"],[\"d'artichaut à l'huile\",280,\"g cœurs\"],[\"tranches\",80,\"g jambon cru en\"],[\"blanc\",1,\"dl vin\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Blanchir les fèves dans l'eau salée pendant env. 3 min.\",\"Les sortir, les rincer à l'eau froide, les égoutter, les peler.\",\"Faire chauffer l'huile dans une poêle, ajouter les oignons et les faire suer pendant env. 2 min.\",\"Ajouter les artichauts, les petits pois, les fèves et les asperges, faire sauter pendant env. 4 min.\",\"Mouiller avec le vin, ajouter le zeste de citron, rectifier l'assaisonnement et laisser mijoter env. 2 min.\",\"Faire griller le jambon cru dans une poêle antiadhésive pendant env. 4 min., puis l'égoutter sur du papier absorbant.\",\"Faire cuire les rigatoni al dente dans de l'eau salée, les égoutter, réserver 1/2 dl de l'eau de cuisson.\",\"Ajouter les pâtes avec l'eau de cuisson réservée à la vignarola et mélanger.\",\"Ajouter la mozzarella, les chips de jambon cru et le persil, mélanger.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asperges\",\"Italie\",\"Plat principal\",\"Pâtes\",\"Saison Printemps\"],\"source\":\"https://fooby.ch/fr/recettes/13221/rigatoni-alla-vignarola\",\"notes\":\"\",\"paprikaUid\":\"43483177-DBCA-47D6-A377-5B0A750B76E4\"},{\"id\":\"raviolis-au-fenouil-et-aux-pistaches-mrryzep9vfi\",\"title\":\"Raviolis au fenouil et aux pistaches\",\"category\":\"Italie\",\"time\":120,\"servings\":4,\"ingredients\":[[\"échalotes\",2,\"\"],[\"fenouils\",500,\"g\"],[\"citrons\",1,\"\"],[\"d'olive\",1,\"c. à soupe huile\"],[\"grillées\",50,\"g pistaches salées\"],[\"fraîche\",100,\"g crème\"],[\"nouilles\",4,\"rouleaux pâte à\"],[\"tranches\",100,\"g mortadelle en\"],[\"blanc\",0.75,\"dl porto\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Faire chauffer l'huile dans une poêle.\",\"Ajouter les échalotes et le fenouil, faire revenir env. 5 min, assaisonner.\",\"Ajouter le porto, couvrir et laisser mijoter env. 10 min.\",\"Retirer le couvercle, faire réduire entièrement le liquide.\",\"Mettre le tout dans un verre doseur, mixer et laisser refroidir.\",\"Mélanger les pistaches et la mortadelle avec le fenouil, diviser en 4 portions égales.\",\"Dérouler un rouleau de pâte et le badigeonner d'un peu d'eau.\",\"Répartir à intervalles réguliers 10 petits tas de farce sur la moitié inférieure de la pâte.\",\"Rabattre la partie libre sur la farce.\",\"Bien appuyer sur les bords pour chasser l'air, découper des raviolis avec un emporte-pièce ovale à bord ondulé (d'env. 7 cm de Ø), les poser sur du papier cuisson.\",\"Faire de même avec le reste de la pâte et de la farce pour façonner d'autres raviolis.\",\"Préchauffer le four à 60 °C, y glisser le plat et les assiettes.\",\"Faire cuire les raviolis par portions dans l'eau salée frémissante pendant env. 5 min.\",\"Les sortir avec une écumoire, bien les égoutter et les réserver au chaud.\",\"Mélanger la crème fraîche avec tous les ingrédients jusqu'au poivre compris, porter à ébullition.\",\"Retirer la casserole du feu, faire mousser avec le pied mixeur.\",\"Dresser les raviolis, arroser de mousse au porto, parsemer de pistaches.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\"],\"source\":\"https://fooby.ch/fr/recettes/26817/raviolis-au-fenouil-et-aux-pistaches\",\"notes\":\"\",\"paprikaUid\":\"B4B8B7CB-69EE-4523-A2E5-C8570EC5B5A9\"},{\"id\":\"ravioli-ricotta-epinards-mrryzep8qg7\",\"title\":\"Ravioli ricotta/épinards\",\"category\":\"Italie\",\"time\":90,\"servings\":4,\"ingredients\":[[\"Pâte:\",\"\",\"\"],[\"farine\",200,\"g\"],[\"œuf\",2,\"u\"],[\"colza\",1,\"tbsp huile de\"],[\"Farce:\",\"\",\"\"],[\"échalote\",1,\"u\"],[\"d'ail\",1,\"u gousse\"],[\"beurre\",1,\"c. à soupe\"],[\"branches\",150,\"g épinards en\"],[\"thym\",1,\"c. à café\"],[\"ricotta\",250,\"g\"],[\"Sbrinz\",50,\"g\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"noix de muscade\",\"\",\"\"],[\"Beurre au citron:\",\"\",\"\"],[\"beurre\",100,\"g\"],[\"sel\",\"\",\"\"],[\"citron\",1,\"u\"],[\"citron\",1,\"tbsp jus de\"],[\"thym\",\"\",\"\"],[\"noix\",2,\"c. à soupe\"],[\"Sbrinz\",\"\",\"\"]],\"steps\":[\"Pâte:\",\"Mettre la farine dans un saladier, former un puits.\",\"Ajouter les œufs et l'huile, mélanger et pétrir 5-8 min jusqu'à l'obtention d'une pâte souple et élastique.\",\"Ajouter un peu d'eau si nécessaire.\",\"Couvrir et laisser reposer 30 min à température ambiante.\",\"Farce:\",\"Faire revenir l'échalotte et l'ail dans le beurre.\",\"Ajouter les épinards, faire revenir brièvement.\",\"Laisser évaporer le liquide.\",\"Laisser refroidir.\",\"Ajouter le reste des ingrédients, assaisonner.\",\"Abaisser la pâte très finement au rouleau à pâtisserie sur un peu de farine ou à l'aide d'une machine à pâtes.\",\"Découper des carrés de 3×3 cm.\",\"Déposer 1/2 cc de farce sur la moitié des carrés.\",\"Recouvrir d'un autre carré.\",\"Bien presser les bords.\",\"Rassembler les chutes et le reste de pâte, pétrir de nouveau et abaisser.\",\"Répéter l'opération jusqu'à ce qu'il n'y ait plus de pâte ni de farce.\",\"Poser les ravioli sur un linge de cuisine saupoudré de farine en attendant la cuisson pour éviter qu'ils ne collent.\",\"Sauce:\",\"Chauffer le beurre, saler.\",\"Ajouter le zeste et le jus de citron ainsi que le thym.\",\"Chauffer encore un peu.\",\"Juste avant de servir, plonger les ravioli par portions dans de l'eau salée à peine frémissante.\",\"Lorsqu'ils remontent à la surface, les sortir avec une écumoire.\",\"Bien les égoutter et les répartir dans des assiettes chaudes.\",\"Verser le beurre au citron par-dessus.\",\"Parsemer de noix et de Sbrinz.\",\"Servir chaud.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Végétarien\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2021_DIVE_87/ravioli-ricotta-epinards/\",\"notes\":\"\",\"paprikaUid\":\"6D527A2C-9166-44BE-A59D-0BDC5328E5EE\"},{\"id\":\"ratatouille-mrryzep7tfl\",\"title\":\"Ratatouille\",\"category\":\"Italie\",\"time\":35,\"servings\":4,\"ingredients\":[[\"oignons\",1,\"\"],[\"d’ail\",2,\"gousses\"],[\"courgettes\",1,\"\"],[\"rouges\",1,\"poivrons\"],[\"aubergines\",1,\"\"],[\"tomates\",400,\"g\"],[\"origan\",2,\"brin\"],[\"1½ c. à soupe huile d'olive\",\"\",\"\"],[\"balsamique\",2,\"c. à soupe vinaigre\"],[\"tomates\",2,\"c. à soupe purée de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Faire chauffer l'huile dans une casserole.\",\"Y faire revenir l'ail et l'oignon pendant 2 min.\",\"Ajouter l'aubergine, la courgette et le poivron, faire cuire pendant env. 5 min.\",\"Ajouter la purée de tomates et les tomates, poursuivre la cuisson pendant env. 5 min.\",\"Ajouter le vinaigre, laisser mijoter pendant 2 min.\",\"Assaisonner, couvrir et laisser mijoter pendant env. 10 min.\",\"Ajouter l'origan, mélanger, dresser sur des assiettes.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Saison Été\"],\"source\":\"https://fooby.ch/fr/recettes/27851/ratatouille\",\"notes\":\"\",\"paprikaUid\":\"78243287-F504-4F4E-9C4C-A2CBF20984ED\"},{\"id\":\"raisin-braise-a-la-burrata-et-au-jambon-cru-mrryzep6b9x\",\"title\":\"Raisin braisé à la Burrata et au jambon cru\",\"category\":\"Italie\",\"time\":20,\"servings\":4,\"ingredients\":[[\"rouge\",350,\"g raisin\"],[\"citron\",1,\"\"],[\"origan\",2,\"brin\"],[\"d'olive\",4,\"c. à soupe huile\"],[\"balsamique\",2,\"c. à soupe crème de\"],[\"burrata\",4,\"petite\"],[\"cru\",100,\"g jambon\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"thym\",2,\"brin\"]],\"steps\":[\"Préchauffer le four à 180°.\",\"Mettre les grains de raisin dans le moule préparé.\",\"Arroser d'huile et de crème balsamique.\",\"Assaisonner.\",\"Enfourner env. 20 min au milieu du four.\",\"Sortir le moule du four.\",\"Dresser le jambon cru et la burrata avec le raisin sur les assiettes.\",\"Parsemer de zeste de citron, d'origan et de thym.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Saison Autumne\",\"Salade\"],\"source\":\"https://fooby.ch/fr/recettes/27271/raisin-braise-a-la-burrata-et-au-jambon-cru\",\"notes\":\"\",\"paprikaUid\":\"167CBC15-C2E2-4353-B81F-AA7165EA0458\"},{\"id\":\"ragout-de-champignons-au-paprika-mrryzep5tm7\",\"title\":\"Ragoût de champignons au paprika\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"champignons\",800,\"g\"],[\"échalotes\",2,\"\"],[\"beurre\",1,\"c. à soupe\"],[\"colza\",1,\"c. à soupe huile de\"],[\"1½ c. à café paprika doux\",\"\",\"\"],[\"carvi\",0.5,\"c. à café\"],[\"farine\",1,\"c. à soupe\"],[\"légumes\",3,\"dl bouillon de\"],[\"demi-crème acidulée\",100,\"g\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"cornichons\",4,\"\"],[\"persil\",0.5,\"bouquet\"]],\"steps\":[\"Nettoyer les champignons et les couper en menus morceaux.\",\"Hacher les échalotes.\",\"Faire revenir le tout dans le beurre et l’huile.\",\"Ajouter le paprika et le carvi.\",\"Saupoudrer la farine par-dessus.\",\"Poursuivre brièvement la cuisson.\",\"Mouiller avec le bouillon et faire cuire 10 min à petit feu.\",\"Incorporer la crème par cuillerée.\",\"Assaisonner de sel, de poivre et de paprika.\",\"Couper fin les cornichons et hacher le persil.\",\"Répartir le tout sur le ragoût et servir avec du riz.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Saison Autumne\",\"Suisse\",\"Végétarien\"],\"source\":\"https://migusto.migros.ch/fr/recettes/ragout-de-champignons-au-paprika\",\"notes\":\"\",\"paprikaUid\":\"6BD982E7-E3E7-4E54-8E3A-132D46342CD9\"},{\"id\":\"ragout-de-b-uf-mrryzep45r7\",\"title\":\"Ragoût de bœuf\",\"category\":\"Cocotte\",\"time\":155,\"servings\":4,\"ingredients\":[[\"carottes\",250,\"g\"],[\"céleri-rave\",200,\"g\"],[\"oignon\",1,\"gros\"],[\"rôtir\",2,\"c. à soupe beurre à\"],[\"bœuf\",1,\"kg ragoût de\"],[\"moelle, selon les goûts\",2,\"os à\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"farine\",2,\"c. à soupe\"],[\"rouge\",2,\"dl vin\"],[\"bœuf\",8,\"dl bouillon de\"],[\"laurier\",2,\"feuilles de\"],[\"girofle\",2,\"clous de\"],[\"persil\",0.5,\"bouquet\"]],\"steps\":[\"Couper les carottes en rondelles de 1 cm d'épaisseur, et le céleri en dés de 1 cm.\",\"Hacher l'oignon.\",\"Faire chauffer le beurre à rôtir dans une cocotte.\",\"Saisir la viande et l'os à moelle par portions de tous les côtés.\",\"Saler et poivrer.\",\"Ajouter les légumes et les faire revenir brièvement.\",\"Saupoudrer de farine et déglacer au vin rouge.\",\"Ajouter le bouillon, le laurier et les clous de girofle.\",\"Laisser mijoter env. 2 h à couvert à feu doux.\",\"Rectifier l'assaisonnement en sel et en poivre.\",\"Effeuiller le persil et en parsemer le ragoût avant de servir.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Cocotte\",\"Plat principal\"],\"source\":\"https://migusto.migros.ch/fr/recettes/ragout-de-boeuf\",\"notes\":\"\",\"paprikaUid\":\"16ED7B27-C4C3-4070-987F-3B33860D71F5\"},{\"id\":\"quiche-pommes-de-terre-et-poireau-mrryzep4r71\",\"title\":\"Quiche pommes de terre et poireau\",\"category\":\"Gâteau\",\"time\":90,\"servings\":8,\"ingredients\":[[\"½ dl bouillon de légumes\",1,\"\"],[\"poireau\",300,\"g\"],[\"(chaire ferme)\",600,\"g pommes de terre en robe\"],[\"gluten\",200,\"g farine sans\"],[\"beurre\",100,\"g\"],[\"nature\",80,\"g séré maigre\"],[\"œufs\",4,\"\"],[\"Appenzeller\",80,\"g\"],[\"fraîche\",400,\"g crème\"],[\"jambon\",50,\"g dés de\"],[\"sel\",\"\",\"\"],[\"thym\",6,\"brin\"],[\"poivre\",\"\",\"\"],[\"noix de muscade\",\"\",\"\"]],\"steps\":[\"Dans un saladier, mélanger la farine et le sel.\",\"Couper le beurre en morceaux et le travailler du bout des doigts avec la farine afin d'obtenir une pâte grumeleuse.\",\"Ajouter le séré et un œuf battu puis mélanger jusqu'à obtenir une pâte souple.\",\"Former une boule avec la pâte, l'aplatir, l'emballer dans du film alimentaire et la réserver au frais.\",\"Couper le poireau en fines rondelles, avec le bouillon de légumes et les feuilles de thym tige, dans une poêle.\",\"Couper les pommes de terre en robe des champs en rondelles et le fromage en dés.\",\"Les ajouter les dés de jambon, mélanger délicatement, saler poivrerajouter un peu de noix de muscade.\",\"Ajouter la crème fraîche et les œufs, mélanger avec pommes de terre-poireau, rectifier l'assaisonnement.\",\"Beurrer légèrement un moule à charnière et le chemiser de papier cuisson.\",\"Abaisser trois quarts de la pâte entre deux feuilles de film alimentaire et chemiser le fond du moule avec le disque de pâte ainsi formé.\",\"Former un fin rouleau avec le dernier quart et le déposer tout autour de la pâte en l'étirant pour former un bord régulier.\",\"Verser la masse dans le moule.\",\"Faire cuire env. 50 minutes dans le four préchauffé à 200°C.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Gâteau\",\"Végétarien\"],\"source\":\"https://fooby.ch/fr/recettes/10868/quiche-pommes-de-terre-poireau\",\"notes\":\"\",\"paprikaUid\":\"7FCBD5A2-BC5D-498D-91A8-D538E1E89A62\"},{\"id\":\"quenelles-de-chair-a-saucisse-en-sauce-mrryzep3e1i\",\"title\":\"Quenelles de chair à saucisse en sauce\",\"category\":\"Plat principal\",\"time\":25,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"u\"],[\"carotte\",300,\"g\"],[\"beurre à rôtir\",2,\"c. à soupe\"],[\"quenelle de chair à saucisse\",350,\"g\"],[\"vin blanc\",1,\"dl\"],[\"sauce de bœuf\",4,\"dl\"],[\"stocki\",2,\"sachet\"],[\"eau\",1,\"l\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"persil\",2,\"brins\"]],\"steps\":[\"Hacher l'oignon.\",\"Partager les carottes en deux dans la longueur puis en menus morceaux.\",\"Chauffer le beurre à rôtir.\",\"Y dorer les quenelles puis les retirer de la casserole.\",\"Faire revenir l'oignon et les carottes dans les sucs de cuisson.\",\"Mouiller avec le vin et la sauce pour rôti.\",\"Remettre les quenelles dans la casserole.\",\"Mijoter env. 10 min, jusqu'à ce que les carottes soient juste tendres.\",\"Entre-temps, préparer la purée tel qu'indiqué sur l'emballage et la relever de sel.\",\"Rectifier l'assaisonnement des quenelles avec du sel et du poivre.\",\"Les dresser avec la purée.\",\"Hacher le persil et en parsemer le plat.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Suisse\",\"modifié\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"quenelles-aux-epinards-a-la-sauce-au-fromage-mrryzep2yre\",\"title\":\"Quenelles aux épinards à la sauce au fromage\",\"category\":\"Saison Autumne\",\"time\":50,\"servings\":4,\"ingredients\":[[\"lait\",1.5,\"dl\"],[\"tessinois\",300,\"g pain\"],[\"œuf\",4,\"u\"],[\"oignon\",150,\"g\"],[\"jeune\",200,\"g épinard\"],[\"beurre\",2,\"c. à soupe\"],[\"panure\",2,\"c. à soupe\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"noix de muscade\",\"\",\"\"],[\"blanc\",2,\"dl vin\"],[\"Gruyère\",100,\"g\"],[\"Emmental\",100,\"g\"],[\"maïzena\",1,\"c. à soupe\"],[\"crème\",200,\"g\"],[\"kirsch\",1,\"c. à soupe\"],[\"cumin moulu\",\"\",\"\"]],\"steps\":[\"Die Milch lauwarm erhitzen.\",\"Das Brot in Würfel schneiden und in einer Schüssel mit der Milch übergießen und 5 Min. quellen lassen.\",\"Die Eier darüberschlagen ‒ aber noch nicht unterrühren, sondern so stehen lassen.\",\"Die Zwiebel schälen und fein würfeln.\",\"Den Blattspinat von den Stielen befreien, gründlich waschen, in einem Sieb abtropfen lassen und gut trocknen lassen.\",\"Die Butter in einem Topf (24 cm Ø) aufschäumen lassen und die Zwiebelwürfel darin bei mittlerer Hitze in 3 Min. glasig dünsten.\",\"Den Spinat dazugeben und 2 Min. unter ständigem Rühren garen.\",\"Herausnehmen, auskühlen lassen und grob durchhacken.\",\"Jetzt die Knödelmasse mit den Händen vermengen, gehackten Spinat und 1 EL Semmelbrösel dazugeben, mit Salz, Pfeffer und Muskat würzen.\",\"Die Masse kräftig mischen und 10 Min. quellen lassen.\",\"Mit angefeuchteten Händen daraus Knödel formen.\",\"In einem großen, breiten Topf reichlich Salzwasser aufkochen.\",\"Die Knödel hineinlegen, aufkochen und 5 Min. siedend kochen lassen.\",\"Dann zugedeckt bei schwacher Hitze ca. 20 Min. ziehen lassen.\",\"In der Zwischenzeit für die Sauce den Weißwein in einem Stieltopf (24 cm Ø) aufkochen lassen.\",\"Die beiden Käsesorten in feine Streifen schneiden oder reiben.\",\"Die Stärke mit einem Schuss kaltem Wasser glatt rühren.\",\"Käse zum Wein geben, die Stärke einrühren und die Sauce bei kleiner Hitze 12 Min. köcheln lassen, dabei mit einem Kochlöffel ständig rühren.\",\"Der Käse soll sich dabei mit der Flüssigkeit verbinden (emulgieren).\",\"Die Sahne nach und nach dazugießen.\",\"Nochmals aufkochen lassen, das Kirschwasser dazugeben und die Sauce mit Pfeffer und Kümmel abschmecken. Je nach Geschmack noch salzen, aber Vorsicht, denn der Käse ist bereits sehr würzig.\",\"Die Spinatknödel aus dem Wasser heben und mit der cremigen Sauce servieren.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Saison Autumne\",\"Saison Hiver\",\"Végétarien\"],\"source\":\"https://www.kuechengoetter.de/rezepte/schweizer-kaesesauce-mit-kirschwasser-zu-spinat-semmelknoedeln-36792\",\"notes\":\"\",\"paprikaUid\":\"E5596A67-E3F2-454B-A9B5-D979B39C2155\"},{\"id\":\"quenelles-au-chou-frise-et-au-fromage-d-alpage-mrryzep1xi5\",\"title\":\"Quenelles au chou frisé et au fromage d’alpage\",\"category\":\"Plat principal\",\"time\":90,\"servings\":4,\"ingredients\":[[\"farine\",300,\"g\"],[\"sel\",\"\",\"\"],[\"eau\",2,\"dl\"],[\"œufs\",2,\"\"],[\"montagne\",150,\"g fromages de\"],[\"frisé\",1,\"gros chou\"],[\"légumes\",3,\"dl bouillon de\"],[\"salsiz\",100,\"g\"],[\"herbes\",2,\"c. à soupe fromage frais aux\"],[\"poivre\",\"\",\"\"],[\"noix de muscade\",\"\",\"\"]],\"steps\":[\"Pour la farce, mettre dans une jatte la farine et env. 1/2 cc de sel.\",\"Ajouter l'eau et les œufs puis mélanger.\",\"Travailler ensuite la pâte à l'aide d'une spatule jusqu'à ce que des bulles se forment.\",\"Râper grossièrement le fromage et en incorporer env. 100 g.\",\"Laisser reposer 20-30 min.\",\"Détacher 12 grosses feuilles du chou frisé.\",\"Les blanchir env. 1 min dans de l’eau salée frémissante.\",\"Les retirer, les rafraîchir sous l'eau froide et les égoutter.\",\"Retirer la nervure centrale des feuilles en la découpant en forme de cône.\",\"Déposer les feuilles sur un torchon.\",\"Disposer 2 cs de farce au milieu de chaque feuille.\",\"Rabattre les deux longs côtés de la feuille sur la farce, puis enrouler ou plier en forme de petit paquet.\",\"Poser les quenelles dans une grande casserole et les arroser du bouillon.\",\"Couvrir et cuire env. 15 min à petit ou moyen feu.\",\"Verser le liquide de cuisson dans une casserole.\",\"Couper la salsiz en petits dés et les faire légèrement griller dans une casserole.\",\"Ajouter le fromage frais au liquide de cuisson.\",\"Travailler en une masse homogène et amener à ébullition.\",\"Assaisonner de sel, de poivre et de muscade.\",\"En arroser les quenelles puis répartir dessus le reste du fromage râpé et les dés de salsiz.\",\"Faire cuire encore 4-5 min à couvert jusqu'à ce que le fromage fonde.\",\"Selon les goûts, parsemer de persil.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Saison Autumne\",\"Saison Hiver\",\"Suisse\",\"Végétarien\"],\"source\":\"https://migusto.migros.ch/fr/recettes/quenelles-au-chou-frise-et-au-fromage-d-alpage\",\"notes\":\"\",\"paprikaUid\":\"B1311716-E89E-41BD-9BAC-A52BCDF42703\"},{\"id\":\"peches-marinees-avec-feta-au-pesto-mrryzep0nil\",\"title\":\"Pêches marinées avec Feta au pesto\",\"category\":\"A\",\"time\":0,\"servings\":4,\"ingredients\":[[\"pêche, bien mûre\",5,\"u\"],[\"d'olive\",500,\"ml huile\"],[\"thym\",1,\"u branche de\"],[\"plat\",200,\"g persil\"],[\"colza\",200,\"g huile de\"],[\"vert\",2,\"u poivron\"],[\"Feta\",100,\"g\"],[\"sucre\",\"\",\"\"],[\"sel\",\"\",\"\"]],\"steps\":[\"Eingelegte Pfirsiche:\",\"Die Pfirsiche waschen, entkernen und vierteln.\",\"Anschließend den Pfirsich scharf in einer Pfanne trocken anbraten.\",\"Die Pfirsiche in Öl einlegen und den Thymian hinzugeben.\",\"Pesto:\",\"Die Kräuter waschen und trocken schütteln.\",\"Petersilie, Rapsöl und entkernte Peperoni mixen und mit Salz und Zucker abschmecken.\",\"Anrichten:\",\"Pfirsiche aus dem Öl nehmen und in mundgerechte Stücke schneiden.\",\"Ebenso den Feta in mundgerechte Stücke schneiden.\",\"Pesto unten auf den Tellern verstreichen.\",\"Feta sowie Pfirsiche oben drauf legen.\",\"Alternativ gerne Pfirsiche und Feta mit dem Pesto marinieren und in einer Schüssel anrichten.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"A\",\"froid\",\"Saison Été\",\"Salade\"],\"source\":\"https://www.genussguide-hamburg.com/magazin/rezepte/pfirsiche-mit-pesto-maurizio-oster/\",\"notes\":\"\",\"paprikaUid\":\"021B3CFC-2592-4B91-9D13-196F0AE24A81\"},{\"id\":\"pates-a-la-sauce-aux-courgettes-mrryzeot8q2\",\"title\":\"Pâtes à la sauce aux courgettes\",\"category\":\"Italie\",\"time\":90,\"servings\":4,\"ingredients\":[[\"oignons\",2,\"\"],[\"d’ail\",4,\"gousses\"],[\"courgettes\",6,\"\"],[\"basilic\",100,\"g pesto au\"],[\"d'olive\",2,\"c. à soupe huile\"],[\"pâtes\",350,\"g\"],[\"légumes\",1,\"dé bouillon de\"],[\"d'herbes italiennes séchées\",2,\"c. à café mélange\"],[\"marin\",1,\"c. à café sel\"],[\"citron\",2,\"c. à soupe jus de\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Faire chauffer l'huile dans une grande casserole.\",\"Ajouter l'ail et les oignons et les faire revenir pendant env. 5 min.\",\"Ajouter les courgettes, les assaisonner et les faire cuire à la vapeur pendant env. 1 heure tout en remuant et en les écrasant légèrement toutes les 10 min avec une louche.\",\"Ajouter du pesto et du jus de citron, assaisonner et faire mijoter brièvement.\",\"Faire cuire les pâtes al dente dans l'eau bouillante salée puis les égoutter et récupérer env. ½ dl de l'eau de cuisson.\",\"Ajouter les pâtes et l'eau de cuisson à la sauce, mélanger et terminer la cuisson.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Pâtes\"],\"source\":\"https://fooby.ch/fr/recettes/25845/pates-a-la-sauce-aux-courgettes\",\"notes\":\"\",\"paprikaUid\":\"B61DA366-001F-43D8-BDE5-1AB149680EBE\"},{\"id\":\"pates-a-la-salsiccia-et-au-fenouil-mrryzeoscdv\",\"title\":\"Pâtes à la Salsiccia et au fenouil\",\"category\":\"Italie\",\"time\":40,\"servings\":4,\"ingredients\":[[\"oignons\",1,\"\"],[\"d’ail\",1,\"gousses\"],[\"chou-fleur\",400,\"g\"],[\"fenouils\",300,\"g\"],[\"d'olive\",1,\"c. à soupe huile\"],[\"moulues\",50,\"g noisettes\"],[\"beurre\",1,\"c. à soupe\"],[\"lait\",4,\"dl\"],[\"pâtes\",400,\"g\"],[\"porc\",260,\"g saucisses à rôtir de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"graines de fenouil\",\"\",\"\"]],\"steps\":[\"Faire fondre le beurre dans une casserole.\",\"Y faire revenir l'oignon et l'ail pendant 2 min.\",\"Ajouter le chou-fleur, poursuivre brièvement la cuisson.\",\"Ajouter le lait, assaisonner, couvrir et laisser mijoter env. 15 min à petit feu.\",\"Mixer.\",\"Bien pétrir la saucisse et les graines de fenouil, former env. 20 boulettes avec les mains mouillées.\",\"Faire chauffer l'huile dans une poêle antiadhésive.\",\"Faire cuire les boulettes de toutes parts pendant 8 min.\",\"Les retirer de la poêle et les ajouter à la sauce au chou-fleur.\",\"Faire revenir le fenouil dans la même poêle pendant 2 min, saler.\",\"Ajouter les noisettes, mélanger jusqu'à ce qu'elles enrobent le fenouil.\",\"Faire cuire les pâtes al dente dans l'eau salée frémissante, les égoutter, les ajouter à la sauce au chou-fleur et aux boulettes de salsiccia, mélanger.\",\"Dresser les pâtes, répartir le fenouil dessus.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Pâtes\"],\"source\":\"https://fooby.ch/fr/recettes/23578/pates-a-la-salsiccia-et-au-fenouil\",\"notes\":\"\",\"paprikaUid\":\"F16A64DB-65ED-4912-A8CA-05E5BD690ADD\"},{\"id\":\"pates-a-la-feta-et-a-la-courge-au-four-mrryzeor9jj\",\"title\":\"Pâtes à la féta et à la courge au four\",\"category\":\"Italie\",\"time\":60,\"servings\":4,\"ingredients\":[[\"pâtes\",350,\"g\"],[\"d'ail pressées\",2,\"gousses\"],[\"râpé\",1,\"cm gingembre finement\"],[\"curry\",1,\"c. à café\"],[\"poivre\",\"\",\"\"],[\"quartiers\",2,\"oignons rouges coupés en\"],[\"crème\",5,\"dl\"],[\"chaud\",5,\"dl bouillon\"],[\"courge, coupée en dés (1,5-2 cm)\",1,\"kg\"],[\"sel\",\"\",\"\"],[\"féta, év. coupé en deux dans la hauteur\",200,\"g\"]],\"steps\":[\"Mettre les pâtes dans le plat avec l'ail, le gingembre, le curry, le poivre et les oignons, mélanger.\",\"Verser la crème et le bouillon par-dessus.\",\"Répartir les dés de courge par-dessus, saler.\",\"Placer le fromage entre les dés de courge.\",\"Enfourner dans le milieu du four froid et cuire env. 40 min à 180°C chaleur tournante (chaleur traditionnelle: 200°C).\",\"Sortir du four.\",\"Mélanger le tout.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Pâtes\",\"Végétarien\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2024_DIVE_75/pates-a-la-feta-et-a-la-courge-au-four/\",\"notes\":\"\",\"paprikaUid\":\"7B30150E-DB69-4877-9C6C-E401C453D9FF\"},{\"id\":\"pates-a-la-feta-et-aux-tomates-au-four-mrryzeorei8\",\"title\":\"Pâtes à la féta et aux tomates au four\",\"category\":\"Italie\",\"time\":45,\"servings\":4,\"ingredients\":[[\"pâtes\",400,\"g\"],[\"d'ail pressées\",2,\"gousses\"],[\"cerises\",500,\"g tomates\"],[\"féta, év. coupé dans la hauteur\",200,\"g\"],[\"colza\",3,\"c. à soupe huile de\"],[\"citron, zeste râpé\",0.5,\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"crème\",5,\"dl\"],[\"chaud\",5,\"dl bouillon\"],[\"haché\",0.5,\"bouquet basilic\"]],\"steps\":[\"Préchauffer le four à 200°C (air chaud/chaleur tournante: 180°C).\",\"Mettre les pâtes dans le plat à gratin.\",\"Ajouter l'ail et les tomates cerises.\",\"Placer le fromage au centre.\",\"Verser l'huile et répartir les zestes de citron par-dessus.\",\"Assaisonner.\",\"Verser la crème et le bouillon par-dessus.\",\"Cuire env. 35 min au milieu du four chaud.\",\"Sortir du four.\",\"Parsemer de basilic.\",\"Mélanger.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Pâtes\",\"Végétarien\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2021_DIVE_30/pates-a-la-feta-et-aux-tomates-au-four/\",\"notes\":\"\",\"paprikaUid\":\"2D1AEDAE-6C7D-4970-AB7D-55FE476FDCAF\"},{\"id\":\"pates-a-la-creme-de-ricotta-et-aux-tomates-mrryzeoqkpi\",\"title\":\"Pâtes à la crème de ricotta et aux tomates\",\"category\":\"Italie\",\"time\":30,\"servings\":4,\"ingredients\":[[\"oignons\",1,\"\"],[\"basilic\",0.5,\"bouquet\"],[\"plat\",0.5,\"bouquet persil\"],[\"d'olive\",4,\"c. à soupe huile\"],[\"ricotta\",200,\"g\"],[\"râpé\",60,\"g parmesan\"],[\"pâtes\",400,\"g\"],[\"l'huile\",1,\"verre tomates séchées à\"],[\"blanc\",0.5,\"dl vin\"],[\"sel\",\"\",\"\"]],\"steps\":[\"Faire chauffer l'huile dans une poêle.\",\"Y faire suer l'oignon pendant 3 min.\",\"Ajouter les tomates, poursuivre la cuisson pendant 1 min.\",\"Ajouter le vin, laisser frémir brièvement jusqu'à évaporation du vin.\",\"Retirer la poêle du feu, ajouter le basilic et le persil, mélanger.\",\"Prélever la moitié de la sauce, la réserver, laisser le reste dans la poêle.\",\"Faire cuire les pâtes al dente dans l'eau salée frémissante.\",\"Réserver env. 0,5 dl de l'eau de cuisson, égoutter les pâtes.\",\"Ajouter la ricotta et la moitié du parmesan aux tomates dans la casserole, puis l'eau de cuisson réservée, mélanger.\",\"Ajouter les pâtes, mélanger et assaisonner.\",\"Dresser les pâtes, les arroser d'huile, servir avec le reste de sauce tomate et le reste de parmesan.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Pâtes\"],\"source\":\"https://fooby.ch/fr/recettes/26518/pates-a-la-creme-de-ricotta-et-aux-tomates\",\"notes\":\"\",\"paprikaUid\":\"11329B77-E522-4ABF-BDE1-A78339C4C4BD\"},{\"id\":\"pates-a-la-creme-d-aubergine-et-ricotta-salee-mrryzeoppqy\",\"title\":\"Pâtes À La Crème D’aubergine Et Ricotta Salée\",\"category\":\"A\",\"time\":70,\"servings\":4,\"ingredients\":[[\"Petits cheveux 320 g\",\"\",\"\"],[\"Basilic 12 feuilles\",\"\",\"\"],[\"Aubergines 400 g\",\"\",\"\"],[\"Ail 2 gousses\",\"\",\"\"],[\"Eau 100 g\",\"\",\"\"],[\"Huile d'olive extra vierge 20 g\",\"\",\"\"],[\"Sel fin à volonté\",\"\",\"\"],[\"Tomates datterini 300 g\",\"\",\"\"],[\"Huile d'olive extra vierge 20 g\",\"\",\"\"],[\"Sel fin à volonté\",\"\",\"\"],[\"Salade de ricotta 250 g\",\"\",\"\"],[\"Crème fraîche liquide 170 g\",\"\",\"\"]],\"steps\":[\"Pour préparer les pâtes à la crème d'aubergine et à la ricotta salée, commencez par l'aubergine : coupez-la en deux 1 , puis quadrillez la chair 2 . Déposez l'aubergine sur une plaque, face coupée vers le haut, et arrosez d'un filet d'huile 3 .\",\"Salez 4 et glissez les gousses d'ail dans les entailles de la chair 5 . Faites cuire dans un four statique préchauffé à 230°C pendant environ 30 minutes 6 .\",\"Pendant ce temps, occupez-vous des tomates cerises : coupez-les en deux 7 et mettez-les dans une poêle avec un filet d'huile chaude 8 . Faites cuire à feu vif environ 5 minutes, salez à votre goût 9 .\",\"Une fois rôties, réservez les tomates cerises 10 . Passez à la fondue : râpez la ricotta salée avec une râpe à gros trous 11 . Dans une petite casserole, versez la crème et la ricotta salée râpée 12 .\",\"Chauffez à feu doux en mélangeant continuellement avec un fouet 13 jusqu'à obtenir une texture crémeuse 14 . Si vous le souhaitez, vous pouvez la mixer avec un mixeur plongeant pour la rendre plus lisse 15 .\",\"Pendant ce temps, les aubergines seront cuites : sortez-les du four et récupérez la chair 16 . Transférez la chair dans un bol, puis ajoutez l'huile 17 et l'eau 18 .\",\"Mixez avec un mixeur plongeant 19 pour obtenir une sauce homogène 20 . Si nécessaire, rectifiez l'assaisonnement. Versez la crème obtenue dans la poêle où vous avez rôté les tomates cerises 21 .\",\"Pendant ce temps, faites cuire les capellini dans une grande quantité d'eau bouillante salée 22 . Égouttez-les une à deux minutes avant le temps indiqué sur l'emballage et transférez-les dans la poêle avec la sauce 23 . Terminez la cuisson des pâtes en ajoutant une louche d'eau de cuisson si besoin 24 .\",\"Hors du feu 25 , ajoutez un filet d'huile pour lier. Dressez en répartissant la fondue au fond de l'assiette 26 , puis déposez un nid de spaghetti 27 .\",\"Ajoutez les tomates cerises rôties 28 et garnissez de quelques feuilles de basilic 29 . Servez immédiatement vos pâtes à la crème d'aubergine et à la ricotta salée 30 !\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"A\"],\"source\":\"https://www.giallozafferano.fr/recettes/pates-a-la-creme-d-aubergine-et-ricotta-salee.html\",\"notes\":\"\",\"paprikaUid\":\"0A1257DA-DD7F-474F-98AE-8B7992562787\"},{\"id\":\"pates-aux-epinards-et-a-la-feta-mrryzeooljj\",\"title\":\"Pâtes aux épinards et à la féta\",\"category\":\"Italie\",\"time\":0,\"servings\":2,\"ingredients\":[[\"spaghetti\",300,\"g nouille ou\"],[\"féta\",1,\"u\"],[\"feuilles\",200,\"g épinard en\"],[\"cerise\",200,\"g tomate\"],[\"d’ail\",1,\"u gousse\"],[\"2½ dl crème entière\",\"\",\"\"],[\"d'olive\",3,\"tbsp huile\"],[\"origan\",0.5,\"c. à café\"],[\"paprika\",0.5,\"c. à café\"],[\"basilic\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Préchauffer le four à 200°.\",\"Déposer la féta en miettes.\",\"Ajouter les tomates coupées en deux.\",\"Ajouter l'épinard et l'ail pressé.\",\"Saler, poivrer, ajouter les épices et arroser d'huile.\",\"Ajouter la crème.\",\"Mélanger et enfourner pendant 20 minutes.\",\"Cuire les pâtes.\",\"Sortir le plat du four.\",\"Ajouter une louche d'eau de cuisson et mélanger.\",\"Ajouter les pâtes et mélanger.\",\"Parsemer avec le basilic coupé en lanières.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Pâtes\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"D7713B39-E97F-4A9D-BCB4-97BEF1321FAA\"},{\"id\":\"pates-aux-poireaux-pecorino-et-pancetta-mrryzeohqyw\",\"title\":\"Pâtes aux poireaux, pecorino et pancetta\",\"category\":\"Italie\",\"time\":25,\"servings\":4,\"ingredients\":[[\"Rigatoni\",320,\"g\"],[\"poireaux\",30,\"o g\"],[\"fumée\",200,\"g Pancetta\"],[\"romano\",150,\"g Pecorino\"],[\"huile d'olive\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"poivre noir\",\"\",\"\"]],\"steps\":[\"Remplir une grande casserole d'eau salée et porter à ébullition.\",\"Pendant ce temps, dans une grande poêle, verser la pancetta coupée en dés.\",\"Laisser dorer sans ajouter de matières grasses jusqu'à ce qu'elle soit dorée et croustillante.\",\"Égoutter pour enlever l'excès de graisse et transférer dans un petit bol.\",\"Réservez.\",\"Nettoyer les poireaux en enlevant la partie la plus dure, puis émincer finement.\",\"Verser un filet d'huile d'olive dans la même poêle.\",\"Ajouter les poireaux et faire cuire à feu doux pendant environ 10 minutes, jusqu'à ce qu'ils soient tendres.\",\"Faire cuire les pâtes al dente.\",\"Mouiller la pancetta avec une petite louche d'eau de cuisson des pâtes pour faciliter la cuisson.\",\"Égoutter les pâtes directement dans la poêle avec le poireau.\",\"Faire sauter rapidement.\",\"Incorporez le pecorino râpé et un tour de moulin à poivre.\",\"Faire sauter rapidement le tout pour bien amalgamer les saveurs et obtenir une texture crémeuse.\",\"Dresser les assiettes, garnir de la pancetta croustillante et servir.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Pâtes\"],\"source\":\"https://www.giallozafferano.fr/recettes/pates-aux-poireaux-pecorino-et-pancetta.html\",\"notes\":\"\",\"paprikaUid\":\"3AFAED21-2445-45D1-8CCD-B5FC37E75CB2\"},{\"id\":\"pates-aux-courgettes-speck-et-gorgonzola-mrryzeohvj0\",\"title\":\"Pâtes Aux Courgettes, Speck Et Gorgonzola\",\"category\":\"A\",\"time\":25,\"servings\":4,\"ingredients\":[[\"Linguine 320 g\",\"\",\"\"],[\"Courgettes (à nettoyer) 300 g\",\"\",\"\"],[\"Speck 150 g\",\"\",\"\"],[\"Gorgonzola 150 g\",\"\",\"\"],[\"Parmigiano Reggiano AOP à volonté\",\"\",\"\"],[\"Ail 1 gousse\",\"\",\"\"],[\"Huile d'olive extra vierge à volonté\",\"\",\"\"],[\"Sel fin à volonté\",\"\",\"\"]],\"steps\":[\"Pour préparer les pâtes aux courgettes, speck et gorgonzola, commencez par mettre sur le feu une casserole d'eau pour cuire les pâtes. Coupez le speck en fines lanières 1 . Ôtez les extrémités des courgettes et coupez-les en deux dans le sens de la longueur 2 , puis réduisez-les en dés 3 .\",\"Mettez le speck dans une poêle bien chaude 4 et, sans ajouter de matière grasse, faites-le dorer à feu moyen pendant environ 5 minutes, jusqu'à ce qu'il devienne bien croustillant 5 . Retirez le speck de la poêle et réservez-le 6 .\",\"Dans la même poêle, versez un filet d'huile 7 avec une gousse d'ail 8 , puis ajoutez les courgettes 9 .\",\"Salez 10 et faites cuire à feu moyen pendant une dizaine de minutes. Pendant ce temps, plongez les linguine dans l'eau bouillante salée 11 . Une fois les courgettes cuites, retirez l'ail 12 et baissez le feu.\",\"Ajoutez le gorgonzola 13 et une louche d'eau de cuisson des pâtes 14 . Mélangez pour faire fondre doucement le gorgonzola 15 .\",\"Égouttez les pâtes al dente et transférez-les dans la poêle 16 , puis ajoutez le speck croustillant 17 et mélangez bien le tout 18 .\",\"Dressez 19 et terminez avec du fromage râpé selon votre goût 20 . Vos pâtes aux courgettes, speck et gorgonzola sont prêtes à être servies 21 !\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"A\"],\"source\":\"https://www.giallozafferano.fr/recettes/pates-aux-courgettes-speck-et-gorgonzola.html\",\"notes\":\"\",\"paprikaUid\":\"C64E162E-9901-474B-84A9-F82785861EA6\"},{\"id\":\"pates-aux-asperges-et-tomates-mrryzeog5q6\",\"title\":\"Pâtes aux asperges et tomates\",\"category\":\"Asperges\",\"time\":0,\"servings\":4,\"ingredients\":[[\"verte\",1,\"u asperge\"],[\"pâtes\",400,\"g\"],[\"frais\",150,\"g fromage\"],[\"cerise\",200,\"g tomate\"],[\"rouge\",1,\"u oignon\"],[\"d'ail\",1,\"u gousse\"],[\"pignon\",2,\"c. à soupe\"],[\"huile d’olive\",\"\",\"\"],[\"chili\",\"\",\"\"],[\"origan\",1,\"c. à café\"],[\"basilic\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Préchauffer le four à 200°.\",\"Parer les asperges et les couper en morceaux et les déposer dans un plat allant au four.\",\"Couper les tomates en deux.\",\"Ajouter tous les ingrédients et bien mélanger.\",\"Enfourner pendant 15-20 minutes.\",\"Cuire les pâtes.\",\"Sortir le plat du four.\",\"Ajouter une louche d'eau de cuisson et mélanger.\",\"Ajouter les pâtes et mélanger.\",\"Parsemer avec le basilic coupé en lanières.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asperges\",\"Pâtes\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"0B42565D-B458-43D6-83FA-1790AC20EB61\"},{\"id\":\"pates-au-four-a-la-saucisse-et-aux-petits-pois-mrryzeoasxe\",\"title\":\"Pâtes Au Four À La Saucisse Et Aux Petits Pois\",\"category\":\"A\",\"time\":55,\"servings\":6,\"ingredients\":[[\"Rigatoni 500 g\",\"\",\"\"],[\"Sauce béchamel 700 g\",\"\",\"\"],[\"Saucisse fraîche 300 g\",\"\",\"\"],[\"Mozzarella pour pizza 300 g\",\"\",\"\"],[\"Petits pois 150 g\",\"\",\"\"],[\"Jambon cuit 150 g\",\"\",\"\"],[\"Oignons jaunes 60 g\",\"\",\"\"],[\"Parmigiano Reggiano AOP 40 g\",\"\",\"\"],[\"Vin blanc 50 g\",\"\",\"\"],[\"Huile d'olive extra vierge à volonté\",\"\",\"\"],[\"Sel fin à volonté\",\"\",\"\"],[\"Poivre noir à volonté\",\"\",\"\"]],\"steps\":[\"Pour préparer les pâtes au four à la saucisse et aux petits pois, commencez par hacher finement l'oignon 1 , puis faites-le fondre dans une poêle avec un filet d'huile 2 . Retirez la peau de la saucisse, émiettez-la avec les mains et ajoutez-la au mélange 3 .\",\"Faites dorer la saucisse pendant environ 5 minutes en remuant souvent 4 . Pendant ce temps, coupez la mozzarella en dés 5 . Ajoutez les petits pois dans la poêle, mélangez et poursuivez la cuisson 7-8 minutes, jusqu'à ce que la saucisse soit bien dorée et que les petits pois soient tendres.\",\"Déglacez au vin blanc 7 et laissez l'alcool s'évaporer complètement. Salez 8 et poivrez. Pendant ce temps, faites cuire les rigatoni dans une grande quantité d'eau salée 9 .\",\"Pendant ce temps, coupez le jambon cuit en dés 10 . Égouttez les rigatoni al dente et transférez-les dans un grand saladier, assaisonnez-les d'un filet d'huile 11 et mélangez bien pour qu'ils ne collent pas. Ajoutez aux pâtes la saucisse avec les petits pois 12 .\",\"Ajoutez aussi presque toute la béchamel 13 et le jambon cuit en dés 14 . Mélangez bien à l'aide d'une cuillère, jusqu'à répartir la sauce de manière homogène 15 .\",\"Étalez une fine couche de béchamel au fond d'un plat de 34x25 cm, puis ajoutez la moitié des pâtes assaisonnées 16 . Répartissez la mozzarella pour pizza coupée en dés 17 , puis recouvrez avec le reste des pâtes 18 .\",\"Terminez avec du Parmigiano Reggiano râpé 19 et faites cuire dans un four statique préchauffé à 200° pendant environ 30 minutes, jusqu'à ce que la surface soit dorée et légèrement gratinée. Sortez les pâtes au four à la saucisse et aux petits pois du four 20 et laissez-les tiédir 10 minutes avant de servir 21 .\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"A\"],\"source\":\"https://www.giallozafferano.fr/recettes/pates-au-four-a-la-saucisse-et-aux-petits-pois.html\",\"notes\":\"\",\"paprikaUid\":\"1FF750FE-9C6F-415A-B8E4-6725340A4AD2\"},{\"id\":\"pates-au-fenouil-mrryzeo99ei\",\"title\":\"Pâtes au fenouil\",\"category\":\"Italie\",\"time\":20,\"servings\":2,\"ingredients\":[[\"d’ail\",2,\"gousses\"],[\"fenouils\",1,\"\"],[\"citrons\",1,\"\"],[\"d'olive\",3,\"c. à soupe huile\"],[\"(chapelure japonaise)\",4,\"c. à soupe panko\"],[\"fraîches\",300,\"g pâtes\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Faire cuire les pâtes al dente dans l'eau frémissante.\",\"Réserver 1 dl de l'eau de cuisson, égoutter les pâtes.\",\"Faire chauffer l'huile dans une poêle, y faire suer brièvement l'ail.\",\"Ajouter la chapelure, laisser dorer 3 min, réserver.\",\"Faire chauffer l'huile dans la même poêle et y faire revenir le fenouil pendant env. 10 min.\",\"Ajouter le zeste et le jus de citron, assaisonner et laisser mijoter env. 1 min.\",\"Ajouter les pâtes et l'eau de cuisson réservée, mélanger et faire chauffer.\",\"Ajouter la chapelure et mélanger.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Pâtes\"],\"source\":\"https://fooby.ch/fr/recettes/19938/pates-au-fenouil\",\"notes\":\"\",\"paprikaUid\":\"3D2EEAE4-3AC8-42B4-82B9-7DB43D63FA5B\"},{\"id\":\"pates-alfredo-aux-asperges-mrryzeo8095\",\"title\":\"Pâtes Alfredo aux asperges\",\"category\":\"Asperges\",\"time\":30,\"servings\":4,\"ingredients\":[[\"surgelés\",250,\"g petits pois\"],[\"crème\",5,\"dl\"],[\"râpé\",90,\"g fromage\"],[\"vertes\",500,\"g asperges\"],[\"mange-tout\",250,\"g pois\"],[\"d'olive\",1,\"tbsp huile\"],[\"spaghettis\",400,\"g\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Faire chauffer l'huile dans une poêle antiadhésive.\",\"Y faire sauter les asperges et les pois mange-tout pendant env. 5 min.\",\"Baisser le feu, ajouter les petits pois, couvrir et laisser mijoter env. 5 min.\",\"Ajouter la crème, porter à ébullition, laisser frémir pendant 2 min.\",\"Incorporer le fromage.\",\"Mélanger et assaisonner.\",\"Faire cuire les pâtes al dente dans l'eau frémissante salée.\",\"Les égoutter et les mélanger à la sauce.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asperges\",\"Italie\",\"Plat principal\",\"Pâtes\"],\"source\":\"https://fooby.ch/fr/recettes/26864/pates-veganes-alfredo-\",\"notes\":\"\",\"paprikaUid\":\"001FC224-1C66-4833-9342-B7D0CAC60922\"},{\"id\":\"pates-al-limone-mrryzeo7nn2\",\"title\":\"Pâtes al limone\",\"category\":\"Italie\",\"time\":30,\"servings\":4,\"ingredients\":[[\"citrons\",2,\"\"],[\"1¼ dl crème entière\",\"\",\"\"],[\"beurre\",50,\"g\"],[\"pâtes\",500,\"g\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Faire cuire les pâtes al dente dans l'eau salée frémissante.\",\"Réserver 1 dl d'eau de cuisson, égoutter les pâtes.\",\"Dans la même casserole, porter à ébullition l'eau de cuisson réservée, la crème, le beurre, le zeste et le jus de citron (env. 1,5 dl).\",\"Baisser le feu, laisser réduire env. 5 min.\",\"Ajouter les pâtes, mélanger, laisser mijoter pendant 2 min, assaisonner.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Pâtes\"],\"source\":\"https://fooby.ch/fr/recettes/25398/pates-au-citron--pasta-al-limone-\",\"notes\":\"\",\"paprikaUid\":\"8AE7AA37-8B28-475D-A889-A39CE5528255\"},{\"id\":\"pudding-aux-poires-au-gingembre-et-a-la-cannelle-mrryzeo6eqj\",\"title\":\"Pudding aux poires, au gingembre et à la cannelle\",\"category\":\"Cocotte\",\"time\":150,\"servings\":8,\"ingredients\":[[\"Pour les poires pochées :\",\"\",\"\"],[\"moyennes, pas trop mûres, avec leur tige, pelées\",8,\"poires\"],[\"roux\",330,\"g sucre\"],[\"1½ lt eau\",\"\",\"\"],[\"cannelle\",1,\"bâton\"],[\"vanille, graines grattées et gousse réservée\",1,\"gousse de\"],[\"deux\",5,\"cm gingembre frais coupé en\"],[\"citron\",1,\"\"],[\"Pour le pudding :\",\"\",\"\"],[\"fermiers\",12,\"oeufs\"],[\"semoule\",330,\"g sucre\"],[\"d’amande\",360,\"g poudre\"],[\"entier\",400,\"g yaourt nature\"],[\"chimique\",2,\"c. à café levure\"],[\"maïs\",70,\"g farine de\"],[\"moulue\",1,\"c. à café cannelle\"],[\"moulu\",2,\"c. à café gingembre\"],[\"graines d’une gousse de vanille\",\"\",\"\"],[\"Pour servir :\",\"\",\"\"],[\"sucre glace pour saupoudrer\",\"\",\"\"],[\"crème anglaise à la gousse de vanille fraîche\",\"\",\"\"]],\"steps\":[\"Évidez les poires par le bas à l'aide d'une cuillère à melon ou d'un petit couteau bien aiguisé.\",\"Placez-les dans un bol d’eau avec le jus d’un demi-citron pendant que vous préparez le sirop de pochage - cela évite que les poires ne changent de couleur.\",\"Placez l’eau, le sucre, le gingembre, la cannelle, le citron restant et la gousse de vanille dans un faitout de 24 cm.\",\"Placez-le sur feu moyen.\",\"Portez à ébullition puis réduisez sur feux doux.\",\"Immergez complètement les poires dans le sirop et pochez-les pendant 20 minutes.\",\"Retirez-les et placez-les immédiatement dans de l’eau glacée au citron pour arrêter le processus de cuisson et éviter toute décoloration.\",\"Préchauffez le four à 180 °C (chaleur tournante).\",\"Graissez un plat rectangulaire de 26 cm.\",\"Dans un saladier, fouettez les œufs, les graines de vanille réservées et le sucre jusqu’à obtenir un mélange homogène.\",\"Tamisez la farine de maïs, les épices, la levure chimique et la poudre d’amande en vous assurant qu’il n’y a pas de grumeaux.\",\"Fouettez les ingrédients secs jusqu’à ce qu’ils soient bien mélangés.\",\"Incorporez le yaourt et mélangez.\",\"Incorporez les ingrédients secs aux ingrédients humides jusqu'à obtenir un mélange homogène.\",\"Disposez les poires pochées dans le plat rectangulaire.\",\"Versez la pâte sur les poires et faites cuire pendant 1 heure et 10 minutes ou jusqu'à ce qu'un couteau inséré en ressorte propre.\",\"Sortez du four et laissez le pudding refroidir légèrement.\",\"Saupoudrez de sucre glace.\",\"Servez chaud avec une crème anglaise.\",\"Facultatif :\",\"Réduire le sirop de pochage au 3⁄4 pour servir avec le pudding.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Cocotte\",\"Dessert\"],\"source\":\"https://www.lecreuset.ch/fr_CH/pudding-aux-poires--au-gingembre-et-a-la-cannelle/r0000000001880.html\",\"notes\":\"\",\"paprikaUid\":\"E29CF155-A4C2-4409-B8C7-21B00B7A17E3\"},{\"id\":\"poelee-de-spatzli-aux-legumes-mrryzeo39se\",\"title\":\"Poêlée de Spätzli aux légumes\",\"category\":\"Plat principal\",\"time\":45,\"servings\":5,\"ingredients\":[[\"Pâte à spätzli:\",\"\",\"\"],[\"farine\",500,\"g\"],[\"2½ dl lait\",\"\",\"\"],[\"œufs\",5,\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"dorer\",100,\"g beurre pour\"],[\"émincé\",1,\"oignon\"],[\"beurre\",30,\"g\"],[\"courge, coupée en dés\",200,\"g\"],[\"d'autres restes de légumes\",200,\"g carottes coupées en dés ou\"],[\"blanc\",1,\"dl bouillon ou de vin\"],[\"crème\",3,\"dl\"],[\"(chou kale) coupé en lanières\",100,\"g chou frisé non pommé\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"poudre\",1,\"pincée cardamome en\"],[\"curry\",1,\"c. à soupe\"]],\"steps\":[\"Pâte à spätzli:\",\"Dans un saladier, mélanger la farine, le lait et les œufs jusqu'à obtention d'une pâte lisse.\",\"Saler, poivrer.\",\"Faire bouillir une grande quantité d'eau salée et remplir un saladier d'eau froide.\",\"Mettre la pâte à spätzli par portions sur la passoire à spätzli ou la râpe à rösti et faire passer à travers les trous dans l'eau bouillante.\",\"Cuire les spätzli à l'eau frémissante jusqu'à ce qu'ils remontent à la surface.\",\"Les retirer avec l'écumoire, bien les égoutter et les placer dans le saladier d'eau froide.\",\"Dorer les spätzli dans le beurre.\",\"Réserver dans un saladier.\",\"Dans une poêle, faire revenir les oignons dans le beurre.\",\"Ajouter les dés de courge et de carotte, cuire env. 5 min à feu doux.\",\"Mouiller avec le bouillon ou le vin blanc.\",\"Ajouter la crème.\",\"Laisser frémir 5 min.\",\"Ajouter le chou et cuire encore 5 min.\",\"Ajouter les spätzli.\",\"Mélanger et rectifier l'assaisonnement.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Suisse\",\"Végétarien\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2018_CHDO_09/poelee-de-spaetzli-aux-legumes/\",\"notes\":\"\",\"paprikaUid\":\"88539BEE-CE46-46C9-80D9-946839DB540B\"},{\"id\":\"poelee-de-nouilles-asiatiques-avec-uf-au-plat-mrryzeo2lpi\",\"title\":\"Poêlée de nouilles asiatiques avec œuf au plat\",\"category\":\"Asie\",\"time\":35,\"servings\":4,\"ingredients\":[[\"riz\",250,\"g nouilles de\"],[\"mi-forts\",2,\"piments rouges\"],[\"nouveaux\",6,\"oignons\"],[\"grillées, salées\",60,\"g cacahouètes\"],[\"verts\",4,\"citrons\"],[\"d´arachide\",4,\"c. à soupe huile\"],[\"œufs\",6,\"\"],[\"mungo\",150,\"g pousses de haricot\"],[\"brut\",2,\"c. à soupe sucre\"],[\"soja\",8,\"c. à soupe sauce\"],[\"hoisin\",6,\"c. à soupe sauce\"]],\"steps\":[\"Plonger les nouilles dans de l’eau bouillante.\",\"Retirer la casserole du feu.\",\"Laisser gonfler les nouilles durant 8-10 min jusqu’à ce qu’elles soient al dente.\",\"Les rincer sous l’eau froide.\",\"Partager les piments en deux dans le sens de la longueur, les épépiner, puis les tailler en fines lanières.\",\"Couper les oignons nouveaux en deux dans le sens de la longueur, puis en julienne avec le vert.\",\"Hacher grossièrement les cacahouètes.\",\"Couper la moitié des citrons verts en quartiers. Presser les autres.\",\"Chauffer la moitié de l’huile dans un wok.\",\"Battre 2 œufs, les verser dans l’huile et les laisser prendre en remuant de temps en temps.\",\"Ajouter les piments, les oignons nouveaux et les pousses de haricots mungo.\",\"Saisir brièvement à feu vif.\",\"Baisser le feu.\",\"Égoutter les nouilles.\",\"Les ajouter avec le sucre, la sauce soja, la sauce hoisin et le jus de citron et mélanger le tout.\",\"Ajouter les cacahouètes.\",\"Rectifier l’assaisonnement en sauce soja.\",\"Avec le reste des œufs, préparer des œufs au plat dans le reste de l’huile et les dresser sur les nouilles sautées.\",\"Servir avec les quartiers de citrons verts.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Wok\"],\"source\":\"https://migusto.migros.ch/fr/recettes/poelee-de-nouilles-asiatiques-avec-oeuf-au-plat\",\"notes\":\"\",\"paprikaUid\":\"7919762B-4FAB-4F2D-9641-40E2861737BF\"},{\"id\":\"poelee-de-legumes-et-de-poulet-a-l-asiatique-mrryzeo0k8w\",\"title\":\"Poêlée de légumes et de poulet à l'asiatique\",\"category\":\"Asie\",\"time\":15,\"servings\":4,\"ingredients\":[[\"poulet\",400,\"g émincé de\"],[\"sel\",\"\",\"\"],[\"d'arachide\",4,\"c. à soupe huile\"],[\"250 g, surgelé\",1,\"sachet mélange de légumes Asia de\"],[\"1½ c. à café fécule de maïs\",\"\",\"\"],[\"oelek\",2,\"c. à café sambal\"],[\"soja\",3,\"c. à soupe sauce\"],[\"poule\",2,\"dl bouillon de\"],[\"persil\",0.5,\"bouquet\"]],\"steps\":[\"Saler l'émincé de poulet.\",\"Chauffer la moitié de l'huile dans un wok et saisir la viande env. 3 min en deux portions.\",\"Retirer du wok et réserver au chaud.\",\"Faire sauter les légumes env. 2 min dans les sucs de cuisson.\",\"Mélanger la fécule, le sambal oelek et la sauce soja.\",\"Ajouter le bouillon.\",\"Verser le tout sur les légumes et faire mijoter jusqu'à liaison.\",\"Incorporer la viande et la faire chauffer.\",\"Agrémenter de quelques feuilles de persil et servir idéalement avec du riz.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Poulet\",\"Wok\"],\"source\":\"https://migusto.migros.ch/fr/recettes/poelee-de-legumes-et-de-poulet-a-lasiatique\",\"notes\":\"\",\"paprikaUid\":\"3995CA29-B05E-4E99-9EEE-263B11097BDE\"},{\"id\":\"poelee-de-celeri-rave-carotte-et-courge-butternut-au-wok-mrryzenx6f4\",\"title\":\"Poêlée de céléri rave, carotte et courge Butternut au Wok\",\"category\":\"Asie\",\"time\":60,\"servings\":2,\"ingredients\":[[\"échalotes\",2,\"\"],[\"d'ail\",2,\"gousses\"],[\"carottes\",3,\"\"],[\"rave\",0.5,\"céleri\"],[\"Butternut\",1,\"courge\"],[\"oignons\",4,\"\"],[\"légumes\",1,\"cubes bouillon de\"],[\"(soit 1 verre)\",20,\"cl eau\"],[\"d'olive\",2,\"c. à soupe huile\"],[\"(pour le jus)\",1,\"citrons\"],[\"frais\",1,\"bouquets persil plat\"],[\"poudre\",1,\"pincée curry ou curcuma en\"],[\"poivre noir\",\"\",\"\"]],\"steps\":[\"Éplucher les carottes, le demi céleri rave et la courge.\",\"Émincer les échalotes et les gousses d'ail.\",\"Les faire revenir dans l'huile d'olive, dans le wok.\",\"Pendant ce temps, couper les carottes en dés, et les ajouter au wok.\",\"Ajouter un demi-verre d'eau, un demi cube de bouillon et couvrir.\",\"Couper le demi céleri rave et la courge en dés.\",\"Ajouter le tout avec un autre demi verre d'eau et, si nécessaire, l'autre demi cube de bouillon.\",\"Couvrir et faire mijoter 20 minutes en remuant de temps en temps.\",\"Couper les jeunes oignons en rondelles.\",\"Presser le citron.\",\"Ajouter au Wok.\",\"Faire frémir pour laisser évaporer le surplus de liquide.\",\"Ajouter les épices et, en toute fin, le persil plat frais et le poivre.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Végétarien\",\"Wok\"],\"source\":\"https://www.marmiton.org/recettes/recette_poelee-de-celeri-rave-carotte-et-courge_310708.aspx\",\"notes\":\"\",\"paprikaUid\":\"415C37F0-27F8-43C5-9330-E16DCEA05472\"},{\"id\":\"poelee-de-choux-de-bruxelles-aux-marrons-et-au-bacon-mrryzenwsns\",\"title\":\"Poêlée de choux de Bruxelles aux marrons et au bacon\",\"category\":\"Asie\",\"time\":45,\"servings\":4,\"ingredients\":[[\"Bruxelles\",500,\"g choux de\"],[\"marrons\",0.5,\"boîte\"],[\"tranches\",80,\"g bacon en\"],[\"huile\",2,\"c. à soupe\"],[\"balsamique\",2,\"c. à soupe vinaigre\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Portez une grande casserole d’eau salée à ébullition.\",\"Plongez-y les choux de Bruxelles et faites-les blanchir 5 min.\",\"Égouttez-les et laissez-les refroidir.\",\"Pendant ce temps, égouttez les marrons.\",\"Coupez les tranches de bacon en fins morceaux.\",\"Faites chauffer l’huile dans un wok.\",\"Baissez le feu.\",\"Ajoutez les choux de Bruxelles, les marrons et les morceaux de bacon.\",\"Salez et poivrez.\",\"Couvrez et faites cuire 20 min. à feu doux en remuant régulièrement.\",\"En fin de cuisson, arrosez de vinaigre balsamique.\",\"Mélangez et servez.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Wok\"],\"source\":\"https://www.cuisineaz.com/recettes/poelee-de-choux-de-bruxelles-aux-marrons-et-au-bacon-83907.aspx\",\"notes\":\"\",\"paprikaUid\":\"562BF780-6C33-4E27-9180-88210896EA05\"},{\"id\":\"poelee-de-champignons-et-puree-de-pommes-de-terre-a-l-ail-des-ours-mrryzenuoi5\",\"title\":\"Poêlée de champignons et purée de pommes de terre à l'ail des ours\",\"category\":\"Saison Printemps\",\"time\":50,\"servings\":4,\"ingredients\":[[\"Purée de pommes de terre:\",\"\",\"\"],[\"terre, pelées et coupées en morceaux\",1,\"kg pommes de\"],[\"lait\",2,\"dl\"],[\"beurre\",40,\"g\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"noix de muscade\",\"\",\"\"],[\"ours, finement haché\",2,\"c. à soupe ail des\"],[\"Champignons:\",\"\",\"\"],[\"mélangés, coupés en morceaux\",400,\"g champignons\"],[\"20 g de morilles séchées, trempées et égouttées\",200,\"g morilles fraîches ou\"],[\"Paris, finement hachés\",100,\"g champignons de\"],[\"crème à rôtir\",\"\",\"\"],[\"échalotes, finement hachées\",2,\"\"],[\"alcool\",1,\"dl vin blanc ou de cidre sans\"],[\"alcool\",1,\"dl porto blanc oude cidre sans\"],[\"légumes, corsé\",1,\"dl bouillon de\"],[\"sauces\",2,\"dl crème pour\"],[\"surgelés\",150,\"g petits pois\"],[\"sel\",\"\",\"\"],[\"poivre du moulin\",\"\",\"\"],[\"ail des ours pour décorer\",\"\",\"\"]],\"steps\":[\"Purée:\",\"Cuire les pommes de terre 20 à 25 minutes à l'eau salée frémissante ou à la vapeur.\",\"Egoutter.\",\"Champignons:\",\"Faire revenir tous les champignons dans le beurre ou la crème à rôtir, par petites quantités.\",\"Réserver.\",\"Faire revenir les échalotes dans le beurre ou la crème à rôtir.\",\"Déglacer avec le vin et le porto ou le cidre.\",\"Incorporer le bouillon et la crème.\",\"Porter à ébullition.\",\"Ajouter les champignons et les petits pois et laisser mijoter env. 5 minutes.\",\"Rectifier l'assaisonnement.\",\"Purée:\",\"Chauffer le lait et le beurre.\",\"Passer les pomes de terre au passe-vite, directement dans le lait.\",\"Aissaisonner.\",\"Mélanger jusqu'à ce que la purée soit chaude et onctueuse.\",\"Rectifier l'assaisonnement.\",\"Incorporer l'ail des ours.\",\"Dresser les champignons et la purée de pommes de terre sur des assiettes préchauffées.\",\"Décorer.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Saison Printemps\",\"Végétarien\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM200203_37_a/poelee-de-champignons-et-puree-de-pommes-de-terre-a-lail-des-ours/\",\"notes\":\"\",\"paprikaUid\":\"C1E258BE-321B-4DBB-A281-C58E9A1F1869\"},{\"id\":\"poulet-a-l-ail-des-ours-sur-feuillete-mrryzent8ep\",\"title\":\"Poulet à l’ail des ours sur feuilleté\",\"category\":\"Poulet\",\"time\":45,\"servings\":4,\"ingredients\":[[\"rectangulaire\",1,\"u pâte feuilletée\"],[\"nature\",125,\"g fromage frais\"],[\"poulet\",4,\"u blancs de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"ours\",50,\"g ail des\"],[\"pignons\",3,\"c. à soupe\"],[\"d’olive\",1,\"dl huile\"]],\"steps\":[],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Poulet\",\"Saison Printemps\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/poulet-a-lail-des-ours-sur-feuillete-10006063/\",\"notes\":\"\",\"paprikaUid\":\"44747BE8-BC7C-4B5F-A8BA-FBAFB02291D5\"},{\"id\":\"poulet-a-la-gremolata-de-citrons-mrryzenr5w7\",\"title\":\"Poulet à la gremolata de citrons\",\"category\":\"Italie\",\"time\":40,\"servings\":4,\"ingredients\":[[\"citrons\",2,\"\"],[\"plat\",1,\"bouquet persil\"],[\"d'olive\",2,\"c. à soupe huile\"],[\"dénoyautées\",30,\"g olives vertes\"],[\"poulet\",4,\"cuisses de\"],[\"tranches\",80,\"g lard à rôtir en\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Badigeonner les cuisses de poulet d'huile, les saler.\",\"Faire griller le poulet couvercle fermé et à braise/température moyenne (env. 200 °C) pendant env. 15 min de chaque côté.\",\"En fin de cuisson, ajouter le lard et le citron pendant 2 min.\",\"Couper le lard finement et le mélanger avec les rondelles de citrons grillées, le zeste de citron et les autres ingrédients.\",\"Répartir la Gremolata sur les cuisses de poulet.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Poulet\"],\"source\":\"https://fooby.ch/fr/recettes/28154/poulet-a-la-gremolata-de-citrons\",\"notes\":\"\",\"paprikaUid\":\"523B0B2D-7FC4-4C3A-9FB1-74E88F631C8B\"},{\"id\":\"poulet-stroganov-mrryzenrijp\",\"title\":\"Poulet Stroganov\",\"category\":\"A\",\"time\":25,\"servings\":4,\"ingredients\":[[\"bio\",2,\"oranges\"],[\"oignons\",1,\"\"],[\"½ cs de paprika\",1,\"\"],[\"beurre à rôtir\",\"\",\"\"],[\"demi-crème pour sauces\",2,\"dl de\"],[\"poule\",1,\"dl de bouillon de\"],[\"ketchup\",2,\"cs de\"],[\"d’émincé de poulet\",600,\"g\"],[\"sel\",1,\"de cc de\"]],\"steps\":[\"Râper un peu de zeste des oranges. Décalotter aux deux extrémités les oranges et les peler à vif. Les couper en six, en tranches d'env. 1 cm. Récupérer le jus, réserver avec le zeste et les tranches. Chauffer le beurre à rôtir dans une poêle antiadhésive. Saisir la viande par portions env. 3 min, retirer, saler. Eponger la graisse de cuisson.\",\"Porter à ébullition bouillon, crème et ketchup dans la même poêle, baisser le feu, ajouter les oignons, laisser mijoter la sauce env. 4 min à couvert, assaisonner. Ajouter les tranches d'orange, le zeste et le jus réservés, ajouter la viande, réchauffer.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"A\"],\"source\":\"https://fooby.ch/fr/recettes/9261/poulet-stroganov\",\"notes\":\"\",\"paprikaUid\":\"9A971AF8-0128-4A03-895A-C83607D59135\"},{\"id\":\"poulet-roti-aux-herbes-de-provence-mrryzenq454\",\"title\":\"Poulet rôti aux herbes de Provence\",\"category\":\"Plat principal\",\"time\":0,\"servings\":4,\"ingredients\":[[\"entier\",1,\"u poulet\"],[\"Provence\",2,\"tbsp herbes de\"],[\"d'ail\",3,\"u gousses\"],[\"d'olive\",2,\"tbsp huile\"],[\"jus d'un citron\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"poivre noir\",\"\",\"\"],[\"oignon\",1,\"u\"],[\"citron\",1,\"u\"],[\"thym\",\"\",\"\"],[\"romarin\",\"\",\"\"],[\"terre\",4,\"u pommes de\"],[\"poulet\",2,\"dl bouillon de\"]],\"steps\":[\"Préchauffer le four à 200°C.\",\"Couper l'oignon et le citron en quartiers.\",\"Éplucher les pommes de terre et les couper en quartiers.\",\"Rincer le poulet à l'eau froide et le sécher avec du papier absorbant.\",\"Dans un petit bol, mélanger les herbes de Provence, l'ail haché, l'huile d'olive et le jus de citron.\",\"Ajoutez du sel et du poivre selon goût.\",\"Mélanger bien pour obtenir une pâte aromatique.\",\"Badigeonner généreusement le poulet avec le mélange, en assurant de bien couvrir toute la surface du poulet, à l'intérieur et à l'extérieur.\",\"Placer les quartiers d'oignon, de citron, le thym et le romarin à l'intérieur du poulet.\",\"Dans un plat allant au four, disposer le poulet et les quartiers de pommes de terre autour.\",\"Arroser le tout d'un filet d'huile d'olive et saupoudrer d'une pincée de sel et de poivre.\",\"Placer le poulet au four et faire cuire pendant environ 1h30 à 1h45, ou jusqu'à ce que le poulet soit bien doré et que le jus qui s'écoule de la cuisse soit clair (ou jusqu'à ce que la température interne du poulet atteigne 75°C).\",\"Préparer le bouillon.\",\"Arroser le poulet toutes les 30 minutes avec le bouillon chaud pour le garder juteux et savoureux.\",\"Retirer le poulet du four, couvrir d'alu et laisser reposer pendant 10 à 15 minutes avant de le découper.\",\"Servir accompagné de légumes de saison.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Poulet\"],\"source\":\"https://www.poivre.ch/recette/poulet-roti-aux-herbes-de-provence/\",\"notes\":\"\",\"paprikaUid\":\"1C90F0F7-9327-491F-8E23-9E5B58F17F61\"},{\"id\":\"poulet-pizzaiola-mrryzenpjf8\",\"title\":\"Poulet Pizzaiola\",\"category\":\"A\",\"time\":20,\"servings\":2,\"ingredients\":[[\"½ dl de Naturaplan Bio Betty Bossi Napoli Sauce\",1,\"\"],[\"basilic\",3,\"brin de\"],[\"d’huile\",0.5,\"cs\"],[\"mozzarella\",150,\"g de\"],[\"charbonnade\",4,\"escalopes de poulet pour\"],[\"sel\",0.5,\"de cc de\"],[\"un peu de poivre\",\"\",\"\"],[\"un peu de sel\",\"\",\"\"]],\"steps\":[\"Faire chauffer l'huile dans une poêle antiadhésive. Y faire revenir le poulet par portions à feu moyen pendant env. 2 min. de chaque côté, assaisonner et mettre dans le plat à gratin. Garnir de sauce tomate, de basilic et de mozzarella, saler.\",\"Faire gratiner env. 10 min. dans le haut du four préchauffé à 220 °C. Sortir du four, ajouter le basilic.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"A\"],\"source\":\"https://fooby.ch/fr/recettes/13392/poulet-pizzaiola\",\"notes\":\"\",\"paprikaUid\":\"E54CF6FF-9EDB-4C70-96CE-DA34EA2E7987\"},{\"id\":\"poulet-parmigiana-mrryzenopxq\",\"title\":\"Poulet Parmigiana\",\"category\":\"Italie\",\"time\":40,\"servings\":4,\"ingredients\":[[\"basilic\",4,\"brin\"],[\"blanche\",50,\"g farine\"],[\"œufs\",2,\"\"],[\"rôtir\",3,\"c. à soupe beurre à\"],[\"râpé\",150,\"g mozzarella\"],[\"râpé\",40,\"g parmesan\"],[\"chapelure\",80,\"g\"],[\"tomate\",300,\"g sauce\"],[\"poulet\",4,\"blancs de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Mettre la farine et la chapelure dans deux assiettes plates séparées.\",\"Battre les œufs dans une assiette creuse.\",\"Assaisonner les blancs de poulet, les passer dans la farine, les secouer pour faire tomber le surplus, puis les passer dans les œufs et enfin dans la chapelure en appuyant bien.\",\"Faire fondre le beurre à rôtir dans une poêle antiadhésive.\",\"Baisser le feu et faire dorer les blancs de poulet à feu moyen pendant 6 min de chaque côté.\",\"Poser les blancs de poulet sur une plaque recouverte de papier cuisson.\",\"Les badigeonner de sauce tomate, ajouter par-dessus la mozzarella et le parmesan.\",\"Faire dorer les blancs de poulet pendant 7 min dans le haut du four préchauffé à 220 °C.\",\"Les sortir du four.\",\"Parsemer de basilic.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Poulet\"],\"source\":\"https://fooby.ch/fr/recettes/26323/poulet-parmigiana\",\"notes\":\"\",\"paprikaUid\":\"39078A18-DF55-4A70-ABBE-AFC0DE705679\"},{\"id\":\"poulet-jalfrezi-mrryzenncf5\",\"title\":\"Poulet Jalfrezi\",\"category\":\"Asie\",\"time\":30,\"servings\":4,\"ingredients\":[[\"poulet\",200,\"g filet de\"],[\"oignons\",2,\"u\"],[\"jaune\",1,\"u poivron rouge ou\"],[\"courgette\",1,\"u\"],[\"concassées\",1,\"u boîte tomates\"],[\"Madras\",2,\"tbsp curry\"],[\"farine\",1,\"c. à soupe\"],[\"plat\",2,\"tsp persil\"],[\"huile d'olive\",\"\",\"\"]],\"steps\":[\"Couper le poulet en morceaux.\",\"Hacher l'oignon et le persil.\",\"Couper les légumes en morceaux.\",\"Mélanger les morceaux de poulet avec 1 cs de curry et la farine.\",\"Les faire revenir rapidement dans une sauteuse ou wok et les réserver.\",\"Faire chauffer 1 cs d’huile dans la sauteuse ou wok et y faire revenir les oignons.\",\"Ajouter l’ail, les poivrons et continuer la cuisson pendant 5 minutes.\",\"Mélanger bien.\",\"Ajouter la deuxième cuillère de curry et continuer la cuisson encore 1 minute.\",\"Ajouter les tomates en mélangeant.\",\"Baisser le feu et faites cuire 5 minutes.\",\"Ajouter la courgette et laisser cuire à découvert encore 5 min.\",\"Remettre le poulet dans la préparation et finir la cuisson environ 3 minutes.\",\"Saupoudrer du persil haché.\",\"Servir chaud avec un riz basmati.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Plat principal\",\"Poulet\"],\"source\":\"https://www.poivre.ch/recette/poulet-jalfrezi/\",\"notes\":\"\",\"paprikaUid\":\"10CA3AD6-B56A-442F-B7D0-C74915483F3A\"},{\"id\":\"poulet-frit-crispy-a-la-coreenne-mrryzenmskf\",\"title\":\"Poulet frit crispy à la coréenne\",\"category\":\"Corée\",\"time\":65,\"servings\":4,\"ingredients\":[[\"(un mélange de pilons et ailes)\",500,\"g poulet désossé\"],[\"sel\",\"\",\"\"],[\"poivre noir\",\"\",\"\"],[\"frais\",1,\"cm gingembre\"],[\"farine\",40,\"g\"],[\"maïs\",40,\"g fécule de\"],[\"sucre\",20,\"g\"],[\"curry en poudre\",\"\",\"\"],[\"panko\",60,\"g chapelure\"],[\"d'ail\",4,\"gousses\"],[\"miel\",120,\"g\"],[\"rouge\",1,\"c. à soupe pâte de piment\"],[\"soja\",1,\"dl sauce\"],[\"riz\",1,\"c. à soupe vinaigre de\"],[\"cassonade\",1,\"c. à soupe\"],[\"sésame\",1,\"c. à soupe graines de\"],[\"cacahuètes non salées\",\"\",\"\"],[\"basilic thaï\",\"\",\"\"],[\"ciboules\",2,\"\"],[\"kimchi\",\"\",\"\"],[\"huile de friture\",\"\",\"\"]],\"steps\":[\"Épluchez et hachez le gingembre et l’ail.\",\"Dans un bol, mélangez le poulet avec le sel, le poivre, le gingembre.\",\"Dans un saladier, mélangez la farine, la fécule, le sucre et le curry, puis ajoutez 6 cl d’eau.\",\"Enrobez les morceaux de poulet du mélange.\",\"Versez ensuite la chapelure panko et mélangez à nouveau pour recouvrir tous les morceaux de poulet uniformément.\",\"Réservez.\",\"Faites revenir l’ail dans une poêle à feu moyen 2 mn.\",\"Ajoutez ensuite le miel, la pâte de piment rouge, la sauce soja, le vinaigre de riz et la cassonade.\",\"Laissez mijoter et réduire doucement jusqu’à obtenir une sauce nappante légèrement sirupeuse mais suffisamment liquide pour enrober le poulet par la suite.\",\"Mettez de côté quand la sauce est prête.\",\"Faites chauffer l’huile de friture à 170°C.\",\"Au fur et à mesure, plongez les morceaux de poulet dans l’huile chaude une première fois, 4 à 5 mn.\",\"Retirez-les à l’aide d’une écumoire et placez-les sur un papier absorbant.\",\"Laissez chauffer l’huile jusqu’à 180°C.\",\"Plongez une deuxième fois les morceaux de poulet frits pendant 30s à 1 mn pour obtenir une panure très croustillante.\",\"Sortez-les et laissez-les sécher sur du papier absorbant.\",\"Remettez à chauffer la sauce nappante jusqu’à frémissements, puis plongez-y les morceaux de poulet.\",\"Faites en sorte que la sauce recouvre bien tous les morceaux de manière uniforme.\",\"Versez dans un plat, parsemez de sésame, de cacahuètes concassées, de ciboule émincée et de basilic thaï.\",\"Servez avec le kimchi.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Corée\",\"Plat principal\",\"Poulet\"],\"source\":\"https://www.elle.fr/Elle-a-Table/Recettes-de-cuisine/Poulet-frit-crispy-a-la-coreenne-4021873\",\"notes\":\"\",\"paprikaUid\":\"55C3D59F-EC38-4BEB-9822-A2C2F510D337\"},{\"id\":\"poulet-au-miel-facon-wok-mrryzenlukz\",\"title\":\"Poulet au miel façon Wok\",\"category\":\"Asie\",\"time\":50,\"servings\":4,\"ingredients\":[[\"poulet\",500,\"g blanc de\"],[\"poireaux\",1,\"\"],[\"brocolis\",1,\"\"],[\"(liquide de préférence)\",2,\"c. à soupe miel\"],[\"soja\",7,\"cl sauce\"],[\"cannelle\",1,\"pincées\"],[\"moulu\",1,\"pincées gingembre\"],[\"poivre\",\"\",\"\"],[\"piment de Cayenne\",\"\",\"\"]],\"steps\":[\"Découpez le blanc de poulet en lamelles.\",\"Laissez mariner 30 min. le poulet dans un saladier avec la sauce soja.\",\"Coupez le poireau en fines rondelles et le brocolis en petites branches.\",\"Dans un wok à feu vif, faîtes dorer les morceaux de poulet 2 min.\",\"Baisser le feu pour les faire mijoter 10 min.\",\"Ajoutez le brocolis, les rondelles de poireau, la cannelle, le gingembre, un peu de poivre et/ou piment de Cayenne.\",\"Patientez 5 min. et ajouter le miel.\",\"Mélangez bien.\",\"Servez accompagné de riz ou d'une salade gourmande (mâche, roquette, frisée, chicorée rouge).\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Poulet\",\"Wok\"],\"source\":\"https://www.marmiton.org/recettes/recette_poulet-au-miel-facon-wok_55367.aspx\",\"notes\":\"\",\"paprikaUid\":\"58F4E47C-8517-4E58-959A-BF55B681E5C9\"},{\"id\":\"potee-cremeuse-a-l-orge-perle-et-aux-champignons-mrryzenky5p\",\"title\":\"Potée crémeuse à l'orge perlé et aux champignons\",\"category\":\"Cocotte\",\"time\":105,\"servings\":4,\"ingredients\":[[\"séchés\",30,\"g bolets\"],[\"champignons\",350,\"g mélange de\"],[\"oignons\",1,\"\"],[\"d’ail\",2,\"gousses\"],[\"céleri-rave\",200,\"g\"],[\"sauge\",2,\"bouquet\"],[\"citrons\",1,\"\"],[\"d'olive\",2,\"c. à soupe huile\"],[\"d'olive\",1,\"dl huile\"],[\"demi-crème acidulée\",200,\"g\"],[\"perlé\",150,\"g orge\"],[\"blanc\",1,\"dl vin\"],[\"sel\",\"\",\"\"],[\"bolets\",1,\"l bouillon de\"],[\"laurier\",1,\"feuilles\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"fleur de sel\",\"\",\"\"]],\"steps\":[\"Mettre les bolets dans un récipient.\",\"Recouvrir d'eau et laisser tremper env. 15 min.\",\"Égoutter les champignons.\",\"Récupérer l'eau.\",\"Faire chauffer l'huile dans une cocotte.\",\"Faire revenir la mélange de champignons par portions pendant 3 min.\",\"Les sortir et les saler.\",\"Baisser le feu.\",\"Ajouter l'oignon et l'ail, les faire suer pendant 3 min.\",\"Ajouter le céleri et l'orge perlé et faire revenir le tout 3 min. de plus.\",\"Mouiller avec le vin, laisser réduire presque entièrement.\",\"Ajouter le bouillon et l'eau des champignons réservée, porter à ébullition.\",\"Ajouter les champignos égouttés et le laurier.\",\"Couvrir et laisser mijoter pendant env. 30 min.\",\"Retirer le couvercle et poursuivre la cuisson env. 30 min.\",\"Incorporer la demi-crème acidulée.\",\"Laisser mijoter env. 5 min.\",\"Assaisonner.\",\"Mixer la sauge et l'huile.\",\"Ajouter le zeste de citron.\",\"Mélanger puis assaisonner.\",\"Répartir la garniture sur la potée.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Cocotte\",\"Plat principal\"],\"source\":\"https://fooby.ch/fr/recettes/21439/potee-cremeuse-a-l-orge-perle-et-aux-champignons\",\"notes\":\"\",\"paprikaUid\":\"7761FFA7-4D9E-467F-8CF1-B185579C3B29\"},{\"id\":\"pot-au-feu-de-canard-en-cocotte-mrryzenj0gp\",\"title\":\"Pot au feu de canard en cocotte\",\"category\":\"Cocotte\",\"time\":145,\"servings\":4,\"ingredients\":[[\"morceaux\",1,\"canard coupé en\"],[\"vert\",1,\"chou\"],[\"carottes\",4,\"\"],[\"poireaux\",2,\"\"],[\"céleri\",1,\"branche de\"],[\"de\",1,\"oignon piqué\"],[\"girofle\",4,\"clous de\"],[\"ail\",2,\"gousses\"],[\"garni\",1,\"bouquet\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Nettoyez tous les légumes et coupez-les en tronçons.\",\"Coupez le chou en lanières.\",\"Dans une grande cocotte, portez 2 l d'eau à ébullition avec le bouquet garni, l'oignon piqué de clous de girofle, les gousses d'ail en chemise.\",\"Salez et poivrez.\",\"Incorporez les morceaux de canard.\",\"Couvez la cocotte et laissez mijoter 1 h 30.\",\"Incorporez les légumes et poursuivez la cuisson 30 min.\",\"Servez le pot-au-feu de canard très chaud.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Cocotte\",\"Plat principal\"],\"source\":\"https://www.cuisineactuelle.fr/recettes/pot-au-feu-en-cocotte-202969?_gl=1*60ad80*_gcl_aw*R0NMLjE3NjY4NjcyOTQuRUFJYUlRb2JDaE1JeXNDMzM4emVrUU1WS1pPREJ4MTNCeUY2RUFBWUFTQUFFZ0l0V19EX0J3RQ..*_ga*MTAyNDA0ODM1MS4xNzY2ODY3MDc4*_ga_5NSPQRQDQY*czE3NjY4NjcwNzgkbzEkZzEkdDE3NjY4NjcyOTUkajEkbDAkaDA.\",\"notes\":\"\",\"paprikaUid\":\"3134C96B-4773-4862-B437-D2CBB3003398\"},{\"id\":\"porc-a-la-coreenne-mrryzenifco\",\"title\":\"Porc à la coréenne\",\"category\":\"Corée\",\"time\":0,\"servings\":4,\"ingredients\":[[\"poitrine de porc\",500,\"g\"],[\"🥚\",2,\"oeufs\"],[\"échalotes\",4,\"\"],[\"d’ail\",2,\"gousses\"],[\"tiges de ciboules\",\"\",\"\"],[\"sauce soja\",3,\"c. à soupe\"],[\"sauce huître\",1,\"c. à soupe\"],[\"vin Shaoxing\",1,\"c. à soupe\"],[\"cinq épices\",1,\"c. à café\"],[\"huile d’arachide ou pépin de raisin\",\"\",\"\"]],\"steps\":[\"Couper en lamelles fines les échalotes.\",\"Écraser et découper finement l’ail.\",\"Faire revenir les échalotes dans 3 CS d’huile chaude jusqu’à ce qu’elles aient une belle coloration brune puis égoutter.\",\"Faire cuire 2 œufs durs.\",\"Découper la viande en forme de lardons d’environ 1 cm de large sur 2 cm de long, en gardant la couenne.\",\"Dans 1 CS d’huile (on peut utiliser celle des échalotes), faire revenir la viande pendant 7/8 minutes.\",\"A mi-cuisson, rajouter l’ail.\",\"Ajouter à la viande la sauce soja, sauce huître, le vin Shaoxing, la poudre 5 parfums, les échalotes grillés et bien incorporer le tout.\",\"Ajouter les œufs durs entiers, puis remplir d’eau à hauteur.\",\"Laisser mijoter à feu doux pendant 45 minutes à couvert.\",\"Retirer les œufs et monter le feu sous la casserole pour faire réduire le jus de moitié.\",\"La sauce va s’epaissir.\",\"Servir en assiette avec du riz blanc parfumé.\",\"Parsemé de ciboule ciselé.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Corée\",\"Plat principal\"],\"source\":\"https://cookpad.com/fr/recettes/15775601?ref=search&search_term=cor%C3%A9enne\",\"notes\":\"\",\"paprikaUid\":\"42FD1DC8-4C61-4DD1-9BA2-5592ED4A2872\"},{\"id\":\"porc-croustillant-a-l-aigre-doux-mrryzenh0ul\",\"title\":\"Porc croustillant à l'aigre-doux\",\"category\":\"Asie\",\"time\":30,\"servings\":4,\"ingredients\":[[\"porc\",450,\"g filet mignon de\"],[\"soja\",4,\"c. à soupe sauce\"],[\"eau\",3,\"c. à soupe\"],[\"maïs\",60,\"g fécule de\"],[\"brut\",120,\"g sucre\"],[\"riz\",0.5,\"dl vinaigre de\"],[\"sésame\",2,\"c. à café huile de\"],[\"gingembre\",20,\"g\"],[\"d'ail\",3,\"gousses\"],[\"poivrons\",2,\"\"],[\"nouveaux\",4,\"oignons\"],[\"colza\",1,\"dl huile de\"],[\"plat\",0.5,\"bouquet de persil\"]],\"steps\":[\"Couper le filet en tranches d'env. 5 mm d'épaisseur.\",\"Mélanger la moitié de la sauce soja et l'eau.\",\"Y délayer la moitié de la fécule.\",\"Ajouter cette marinade à la viande et laisser brièvement reposer.\",\"Entre-temps, mélanger le reste de la sauce soja avec le sucre, le vinaigre et l'huile de sésame.\",\"Réserver.\",\"Hacher finement le gingembre et l'ail.\",\"Épépiner les poivrons puis les tailler en lanières ainsi que les oignons nouveaux.\",\"Retirer la viande de la marinade.\",\"L'égoutter brièvement.\",\"La tourner dans le reste de la fécule.\",\"Chauffer l'huile de colza dans un wok et y faire croustiller la viande par portions.\",\"La retirer du wok et l'égoutter sur du papier absorbant.\",\"Ne conserver qu'env. 1 cs de l'huile dans le wok.\",\"Y saisir l'ail et le gingembre.\",\"Mouiller avec le mélange sucre-vinaigre et faire mijoter env. 3 min.\",\"Ajouter les poivrons ainsi que la viande et faire sauter.\",\"Incorporer les oignons.\",\"Dresser avec le persil.\",\"Idéal avec du riz parfumé.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Wok\"],\"source\":\"https://migusto.migros.ch/fr/recettes/porc-croustillant-a-laigre-doux\",\"notes\":\"\",\"paprikaUid\":\"FD5B4C69-1B11-4448-BA35-C394E475D6DB\"},{\"id\":\"pommes-de-terre-nouvelles-a-la-viande-hachee-et-aux-champignons-mrryzenhxar\",\"title\":\"Pommes de terre nouvelles à la viande hachée et aux champignons\",\"category\":\"Asie\",\"time\":50,\"servings\":4,\"ingredients\":[[\"nouvelles\",600,\"g pomme de terre\"],[\"nouveaux\",6,\"oignons\"],[\"champignons\",100,\"g\"],[\"tournesol\",2,\"c. à soupe huile de\"],[\"bœuf\",400,\"g viande hachée de\"],[\"noix de muscade\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Cuire les pommes de terre en les gardant bien fermes. Les partager en deux.\",\"Couper les oignons nouveaux en deux dans la longueur puis en menues bouchées.\",\"Partager les champignons suivant leur taille en deux ou en quatre.\",\"Chauffer l'huile dans un wok et saisir la viande hachée avec les pommes de terre en remuant de temps en temps.\",\"Relever de noix de muscade, de sel et de poivre.\",\"Ajouter les champignons ainsi que les oignons nouveaux et faire revenir brièvement.\",\"Rectifier l'assaisonnement en sel et servir chaud.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Wok\"],\"source\":\"https://migusto.migros.ch/fr/recettes/petites-pommes-de-terre-a-la-viande-hachee-et-aux-champignons\",\"notes\":\"\",\"paprikaUid\":\"DACC530D-FD2D-44B1-9178-E8E9FD8385EB\"},{\"id\":\"pommes-de-terre-nouvelles-et-radis-sur-creme-de-feta-mrryzeng80w\",\"title\":\"Pommes de terre nouvelles et radis sur crème de feta\",\"category\":\"Plat principal\",\"time\":40,\"servings\":4,\"ingredients\":[[\"feta\",250,\"g\"],[\"grec\",150,\"g yogourt\"],[\"colza\",2,\"c. à soupe huile de\"],[\"d’ail\",1,\"petite gousse\"],[\"citron, zeste\",0.5,\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"nouvelles\",800,\"g pommes de terre\"],[\"colza\",2,\"c. à soupe huile de\"],[\"radis\",2,\"bottes\"],[\"aneth, finement ciselé\",0.5,\"botte\"],[\"printemps, en fines rondelles\",1,\"oignon de\"],[\"citron, zeste\",0.5,\"\"]],\"steps\":[\"Préparation de la crème de feta:\",\"Placer tous les ingrédients nécessaires pour la crème de feta ainsi que le zeste de citron dans un mixeur.\",\"Mixer jusqu’à l'obtention d’une crème homogène et assaisonner de sel et de poivre.\",\"Réserver au réfrigérateur jusqu’au moment de servir.\",\"Préparation des pommes de terre nouvelles:\",\"Préchauffer le four à 200 °C.\",\"Laver les pommes de terre et les sécher.\",\"Mélanger avec l’huile.\",\"Saler et poivrer.\",\"Répartir sur une plaque recouverte de papier cuisson.\",\"Faire griller au four env. 35 à 40 minutes (selon la taille des pommes de terre).\",\"Ajouter les radis aux pommes de terre pour les 10 dernières minutes de cuisson.\",\"Étaler la crème de feta en cercle sur les assiettes.\",\"Disposer les pommes de terre nouvelles et les radis dessus.\",\"Avant de servir, parsemer d’aneth, d’oignons de printemps et de zeste de citron.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Végétarien\"],\"source\":\"https://www.patate.ch/fr/recettes/plat-principal/pommes-de-terre-et-radis-1.html\",\"notes\":\"\",\"paprikaUid\":\"482542E8-87B3-4F28-BB5B-96C596133D62\"},{\"id\":\"pommes-de-terre-en-eventail-mrryzenf48g\",\"title\":\"Pommes de terre en éventail\",\"category\":\"Saison Été\",\"time\":45,\"servings\":2,\"ingredients\":[[\"terre\",2,\"pomme de\"],[\"beurre\",50,\"g\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"d'ail\",1,\"gousse\"],[\"moulu\",0.5,\"tsp ail\"],[\"paprika\",0.5,\"c. à café\"],[\"Dip :\",\"\",\"\"],[\"séré\",150,\"g\"],[\"fraîche\",50,\"g crème\"],[\"oignon\",1,\"\"],[\"ciboulette\",1,\"u\"],[\"citron\",1,\"c. à soupe\"],[\"d'ail\",1,\"gousse\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Couper les pommes de terre en éventail.\",\"Fondre le beurre dans une bol.\",\"Ajouter l'ail pressé et tous les épices.\",\"Bien mélanger et bien imbiber les pommes de terre  à l'aide d'un pinceau.\",\"Cuire pendant 15 min dans le fryer.\",\"Les sortir et les mettre pendant 5 min à la micro-onde.\",\"Les badigeonner avec le reste du beurre épicé.\",\"Les remettre 15-20 min dans le fryer.\",\"Pendant ce temps, presser l'ail et mélanger avec tous les ingrédients du dip.\",\"Servir les pommes de terre avec 1-2 cuillères de dip.\",\"Accompagner par une salade verte.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Saison Été\",\"Végétarien\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"5F9220C0-DAA2-4009-B6FC-EA209A48DADC\"},{\"id\":\"pommes-de-terre-au-citron-en-papillote-avec-feta-mrryzen9l5t\",\"title\":\"Pommes de terre au citron en papillote avec feta\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"ferme\",1,\"kg pommes de terre à chair\"],[\"d’ail\",2,\"gousses\"],[\"rouge\",1,\"oignon\"],[\"colza\",2,\"c. à soupe huile de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"citron\",1,\"\"],[\"feta\",150,\"g\"],[\"menthe\",0.5,\"botte\"],[\"persil\",0.5,\"botte\"],[\"oignons de printemps, en rondelles\",\"\",\"\"]],\"steps\":[\"Couper les pommes de terre en cubes d’environ 3 cm.\",\"Hacher finement l’ail et émincer les oignons.\",\"Verser le tout dans un saladier, agrémenter d’huile de colza et mélanger.\",\"Ajouter du sel et du poivre.\",\"Découper une feuille d’aluminium d’environ 30 x 30 cm.\",\"Disposer un quart des pommes de terre au centre de celle-ci.\",\"Couper le citron en deux dans le sens de la longueur et couper à nouveau chaque moitié en deux.\",\"Déposer un quartier sur les pommes de terre.\",\"Fermer la feuille d’aluminium en papillote.\",\"Procéder de même avec le reste des ingrédients.\",\"Placer les papillotes de pommes de terre sur le gril bien chaud.\",\"Les tourner de temps en temps.\",\"Selon la chaleur, laisser sur le gril env. 30 à 35 minutes jusqu’à ce que les pommes de terre soient cuites.\",\"Emietter la feta.\",\"Hacher grossièrement la menthe et le persil.\",\"Garnir les pommes de terre.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Végétarien\"],\"source\":\"https://www.patate.ch/fr/recettes/plat-principal/pommes-de-terre-au-citron.html\",\"notes\":\"\",\"paprikaUid\":\"69718273-8981-4CB7-B8C8-4191683B3482\"},{\"id\":\"polpette-in-sugo-mrryzen8qtr\",\"title\":\"Polpette in sugo\",\"category\":\"Italie\",\"time\":65,\"servings\":4,\"ingredients\":[[\"pin\",4,\"c. à soupe pignons de\"],[\"1½ oignons\",\"\",\"\"],[\"d’ail\",2,\"gousses\"],[\"plat\",3,\"c. à soupe persil\"],[\"fort\",1,\"c. à café paprika\"],[\"huile d'olive\",\"\",\"\"],[\"d'olive\",0.5,\"c. à soupe huile\"],[\"sucre\",2,\"pincée\"],[\"ricotta\",100,\"g\"],[\"frais\",1,\"œufs\"],[\"chapelure\",2,\"c. à soupe\"],[\"concassées\",1,\"boîte tomates\"],[\"tomates\",1,\"c. à soupe concentré de\"],[\"(bœuf et porc)\",500,\"g viande hachée\"],[\"anis\",1,\"c. à soupe\"],[\"2¼ c. à café sel\",\"\",\"\"],[\"d'herbes italiennes séchées\",1,\"c. à soupe mélange\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Faire griller les pignons de pin dans une poêle antiadhésive sur feu moyen.\",\"Ajouter l’anis, faire griller un instant.\",\"Ajouter l’oignon et l’ail, faire revenir un court instant.\",\"Laisser refroidir dans un récipient.\",\"Mélanger dans un bol la viande hachée et tous les ingrédients, y compris le paprika.\",\"Bien pétrir le tout, jusqu’à obtention d’une masse compacte qui ne colle plus aux mains.\",\"Réserver au frais à couvert env. 15 minutes.\",\"Façonner avec les mains mouillées env. 16 boulettes.\",\"Chauffer l’huile dans la même poêle.\",\"Faire cuire les polpette par portions sur toutes les faces env. 10 min sur feu moyen.\",\"Cauffer l’huile, y faire revenir l’oignon.\",\"Ajouter les tomates et le reste des ingrédients.\",\"Laisser mijoter env. 30 min à découvert, assaisonner.\",\"Servir la sauce avec les polpette.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\"],\"source\":\"https://fooby.ch/fr/recettes/6986/polpette-in-sugo\",\"notes\":\"\",\"paprikaUid\":\"ACBD3528-AB92-43CC-A708-F774D6862BAF\"},{\"id\":\"polpette-mrryzen7s08\",\"title\":\"Polpette\",\"category\":\"Italie\",\"time\":60,\"servings\":18,\"ingredients\":[[\"courgettes\",200,\"g\"],[\"oignons\",1,\"\"],[\"d’ail\",1,\"gousses\"],[\"huile\",\"\",\"\"],[\"Gorgonzola\",80,\"g\"],[\"chapelure\",3,\"c. à soupe\"],[\"(bœuf et porc)\",600,\"g viande hachée\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Saler les courgettes, les réserver env. 30 min. dans une passoire puis bien les presser.\",\"Mélanger les courgettes avec la viande hachée, l'oignon, l'ail et la chapelure, assaisonner.\",\"Bien pétrir à la main jusqu'à ce que la masse devienne compacte.\",\"Former 18 boulettes et faire un creux dans chacune d'elles.\",\"Insérer le gorgonzola dans chacun des creux et refermer pour former des boulettes.\",\"Faire chauffer l'huile dans une poêle antiadhésive.\",\"Faire revenir les boulettes de toutes parts pendant env. 4 min. à feu moyen.\",\"Les retirer de la poêle et les placer sur une plaque chemisée de papier sulfurisé.\",\"Env. 10 min. au milieu du four préchauffé à 160 °C.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\"],\"source\":\"https://fooby.ch/fr/recettes/11245/polpette\",\"notes\":\"\",\"paprikaUid\":\"B19281BB-7431-4B3B-89E8-326B85505EC4\"},{\"id\":\"polenta-bramata-mrryzen6ztl\",\"title\":\"Polenta Bramata\",\"category\":\"Plat principal\",\"time\":40,\"servings\":4,\"ingredients\":[[\"beurre\",1,\"c. à soupe\"],[\"oignon\",1,\"\"],[\"ail\",1,\"gousse\"],[\"blanc\",1,\"dl vin\"],[\"légumes\",8,\"dl bouillon de\"],[\"laurier\",1,\"feuille\"],[\"bramata\",150,\"g polenta\"],[\"crème\",2.5,\"dl\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"beurre\",2,\"c. à soupe\"],[\"Sbrinz\",100,\"g\"]],\"steps\":[\"Hacher finement les oignons et l'ail.\",\"Faire revenir les oignons et l'ail dans le beurre.\",\"Ajouter le vin blanc et le bouillon.\",\"Porter à ébullition.\",\"Ajouter la feuille de laurier et la polenta bramata.\",\"Couvrir et cuire 20-25 min à feu doux.\",\"Remuer régulièrement.\",\"Ajouter la crème.\",\"Rectifier l'assaisonnement et réchauffer la polenta.\",\"Incorporer le beurre et le Sbrinz avant de servir.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2021_OUTD_06/polenta-bramata/\",\"notes\":\"\",\"paprikaUid\":\"BCC99537-2EEA-49AC-81A1-4F6BFAE1AB21\"},{\"id\":\"polenta-au-chou-kale-avec-des-ufs-mrryzen3r9p\",\"title\":\"Polenta au chou kale avec des œufs\",\"category\":\"Italie\",\"time\":60,\"servings\":4,\"ingredients\":[[\"tournesol\",2,\"c. à soupe graines de\"],[\"lavé, prêt à l'emploi\",100,\"g chou kale\"],[\"d'olive\",1,\"c. à soupe huile\"],[\"panko\",3,\"c. à soupe\"],[\"râpé\",80,\"g Gruyère\"],[\"beurre\",2,\"c. à soupe\"],[\"œufs\",4,\"\"],[\"(Bramata)\",250,\"g semoule de maïs à gros grains\"],[\"sel\",\"\",\"\"],[\"romarin\",1,\"c. à soupe\"],[\"sel\",1,\"pincée fleur de\"]],\"steps\":[\"Faire bouillir l'eau et la saler.\",\"Verser en pluie la semoule de maïs, baisser le feu au minimum et laisser réduire env. 35 min. en remuant de temps en temps, jusqu'à obtenir une bouillie épaisse.\",\"Ajouter le chou kale, mélanger et laisser mijoter encore 10 min. à couvert.\",\"Incorporer le fromage et le beurre.\",\"Faire cuire les œufs dans l'eau bouillante pendant env. 7 min., les passer sous l'eau froide, puis les écaler.\",\"Faire chauffer l'huile dans une poêle.\",\"Faire griller le panko, les graines de tournesol et le romarin pendant env. 3 min., saler.\",\"Couper les œufs en deux et les servir avec la garniture croustillante et la polenta.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\"],\"source\":\"https://fooby.ch/fr/recettes/18908/polenta-au-chou-kale-avec-des-ufs\",\"notes\":\"\",\"paprikaUid\":\"96387CEE-BEBC-4582-979E-99227998B0C6\"},{\"id\":\"poivrons-farcis-vegetariens-mrryzen2car\",\"title\":\"Poivrons farcis végétariens\",\"category\":\"Plat principal\",\"time\":70,\"servings\":4,\"ingredients\":[[\"jaunes\",2,\"gros poivrons\"],[\"verts\",2,\"gros poivrons\"],[\"Farce:\",\"\",\"\"],[\"grain, précuit àl'eau salée, égoutté\",150,\"g riz long\"],[\"carottes, finement râpées\",2,\"\"],[\"secs\",4,\"c. à soupe raisins\"],[\"pignons\",2,\"c. à soupe\"],[\"féta, coupé en petits dés\",100,\"g\"],[\"œufs\",2,\"\"],[\"menthe, hachée\",2,\"c. à soupe\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"origan\",\"\",\"\"],[\"carvi, moulu\",\"\",\"\"],[\"beurre à rôtir, fondu\",\"\",\"\"],[\"Sauce:\",\"\",\"\"],[\"tomates, coupées en dés\",4,\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"1½ dl bouillon de légumes\",\"\",\"\"]],\"steps\":[\"Farce:\",\"Mélanger soigneusement tous les ingrédients.\",\"Assaisonner.\",\"Couper un chapeau (2-3 cm) au sommet des poivrons.\",\"Oter les graines et les cloisons intérieures.\",\"Farcir et disposer dans le plat à gratin.\",\"Recouvrir avec les chapeaux.\",\"Badigeonner d'un peu de crème à rôtir.\",\"Disposer les tomates autour des poivrons.\",\"Assaisonner.\",\"Verser le bouillon dans le plat.\",\"Cuire 45-50 min au milieu du four préchauffé à 180°C.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Végétarien\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM200406_54_A/poivrons-farcis-vegetariens-piperies-jemistes/\",\"notes\":\"\",\"paprikaUid\":\"67E25BDF-42E3-4754-B578-644A14D11FEF\"},{\"id\":\"poivrons-farcis-mrryzen1tz3\",\"title\":\"Poivrons farcis\",\"category\":\"Plat principal\",\"time\":75,\"servings\":4,\"ingredients\":[[\"jaunes\",4,\"poivrons\"],[\"oignon, haché\",1,\"\"],[\"rôtir\",4,\"c. à soupe beurre à\"],[\"mélangée, porc/bœuf\",600,\"g viande hachée\"],[\"tomates\",1,\"c. à soupe concentré de\"],[\"1½ dl vin blanc\",\"\",\"\"],[\"pignons, grillés\",2,\"c. à soupe\"],[\"menthe, hachée\",2,\"c. à soupe\"],[\"persil, haché\",2,\"c. à soupe\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Couper le tiers supérieur du poivron et le mettre de côté. Vider le poivron.\",\"Faire revenir l’oignon dans le beurre chaud, ajouter la viande par portions et continuer de faire revenir pendant env. 5 minutes.\",\"Ajouter la purée de tomates, faire brièvement revenir, mouiller avec le vin et laisser réduire pendant env. 5 minutes.\",\"Incorporer les pignons et les herbes et assaisonner.\",\"Remplir les poivrons avec la farce, mettre le capuchon et placer dans le moule à gratin.\",\"Faire cuire pendant env. 40 minutes au milieu du four préchauffé à 180° C (chaleur supérieure et inférieure).\",\"Sortir du four et servir.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Saison Hiver\",\"Saison Été\"],\"source\":\"https://www.gemuese.ch/fr/recettes/poivrons-farcis?_gl=1*1y5cks6*_up*MQ..&gclid=EAIaIQobChMItdK7sbK4kQMVepKDBx0SyAWNEAAYASABEgL9oPD_BwE&gbraid=0AAAAA-NhTE5iAnPHfalM4KcSHGDur_dvT\",\"notes\":\"\",\"paprikaUid\":\"A0796963-F883-41B3-8F12-603D617DFB40\"},{\"id\":\"pizzoccheri-a-la-courge-mrryzen085n\",\"title\":\"Pizzoccheri à la courge\",\"category\":\"Plat principal\",\"time\":75,\"servings\":4,\"ingredients\":[[\"courge\",300,\"g\"],[\"frisé\",200,\"g chou\"],[\"sauge\",3,\"brin\"],[\"sarrasin\",300,\"g farine de\"],[\"blanche\",200,\"g farine\"],[\"beurre\",2,\"c. à soupe\"],[\"lait\",1,\"dl\"],[\"râpé\",40,\"g parmesan\"],[\"montagne\",80,\"g fromage de\"],[\"sel\",\"\",\"\"]],\"steps\":[\"Mélanger les farines et le sel dans un saladier.\",\"Ajouter l'eau, mélanger avec une cuillère en bois jusqu'à ce que la pâte soit compacte.\",\"Sur un peu de farine, pétrir la pâte pendant env. 10 min jusqu'à ce qu'elle soit élastique, couvrir et laisser reposer env. 30 min à température ambiante.\",\"Couper la pâte en quatre, fariner le plan de travail.\",\"Y abaisser les pâtons en rectangles d'env. 2 mm d'épaisseur.\",\"Les couper en lanières.\",\"Faire cuire les pizzoccheri pendant 3 min dans l'eau salée à peine frémissante.\",\"Les égoutter en réservant env. 1 dl d'eau de cuisson.\",\"Faire chauffer le beurre dans une poêle antiadhésive.\",\"Ajouter la courge, faire revenir pendant env. 5 min.\",\"Ajouter le chou frisé et la sauge, saler, couvrir et étuver pendant env. 10 min.\",\"Mélanger le lait avec le parmesan et l'eau de cuisson réservée, ajouter aux légumes avec les pizzoccheris, mélanger.\",\"Parsemer de fromage.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Saison Autumne\",\"Suisse\"],\"source\":\"https://fooby.ch/fr/recettes/26548/pizzoccheri-a-la-courge\",\"notes\":\"\",\"paprikaUid\":\"B5349F43-3AC4-4626-A834-7F7AAD12C34D\"},{\"id\":\"pizza-poires-et-brie-mrryzemzg7h\",\"title\":\"Pizza poires et brie\",\"category\":\"Italie\",\"time\":70,\"servings\":4,\"ingredients\":[[\"farine\",1000,\"g\"],[\"eau\",600,\"g\"],[\"sèche\",1,\"u levure de bière\"],[\"d'olive\",60,\"g huile\"],[\"sel\",20,\"g\"],[\"Williams\",2,\"u poire\"],[\"Brie\",200,\"g\"],[\"mozzarella\",250,\"g\"],[\"parmesan\",30,\"g\"]],\"steps\":[\"Verser la farine dans le bol du mélangeur.\",\"Ajouter la levure et 100 grammes d'eau.\",\"Activer le mélangeur avec le crochet monté à vitesse moyenne-basse.\",\"Continuer en ajoutant l'eau petit à petit, en veillant à ce que la dose précédente soit bien absorbée par la farine.\",\"Une fois les 3/4 de l'eau versée, ajouter le sel et continuer à pétrir.\",\"Ajouter le reste de l'eau en filet et laisser travailler jusqu'à obtenir une pâte lisse et homogène.\",\"Ajouter l'huile progressivement.\",\"Une fois l'huile complètement absorbée, retirer la pâte du mélangeur et façonner à la main pour obtenir une boule.\",\"Placez-la dans un bol spacieux légèrement huilé.\",\"Couvrer avec un film plastique ou un torchon propre et laisser lever 1h30-3h dans le four avec la lumière allumée.\",\"Une fois que la pâte a levé, la transférer sur le plan de travail et diviser en parts égales, selon le nombre de personnes.\",\"Faire une boule avec chacune.\",\"Les couvrir avec un torchon propre et laisser reposer pendant 30 minutes.\",\"Pendant ce temps, huiler légèrement avec un filet d'huile 1 plaques à pizza par personne de 30 cm de diamètre.\",\"Préchauffer le four à 200°.\",\"Après 30 minutes, placer au centre de la plaque une boule de pâte et écraser du centre vers l'extérieur, en tirant légèrement sur les côtés si nécessaire.\",\"Si la pâte est trop élastique et a tendance à revenir à sa forme initiale, mettre de côté la pizza que vous êtes en train d'étaler et continuez avec une autre, permettant ainsi à la précédente de se reposer.\",\"Étendre la pâte sur toute la surface de la plaque.\",\"Verser un filet d'huile sur la pizza et continuer à la garnir.\",\"Couper le brie en carrés d'environ 2,5 cm de côté.\",\"Disposer la mozzarella grossièrement hachée sur la pizza.\",\"Ajoutez le brie.\",\"Saupoudrer de parmesan et enfournez pendant 10 minutes.\",\"Pendant ce temps, laver et éplucher les poires.\",\"Les couper en 4, enlever le trognon et découper des tranches de même épaisseur.\",\"Après 10 minutes, retirer la pizza du four et disposer les poires en étoile sur la pizza et enfourner à nouveau pendant 10/15 minutes.\",\"Sortir du four et servir immédiatement.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Pizza\"],\"source\":\"https://www.giallozafferano.fr/recettes/pizza-poires-et-brie.html\",\"notes\":\"\",\"paprikaUid\":\"93622026-B1F6-47A3-A992-316BDACE2EEC\"},{\"id\":\"pizza-mascarpone-speck-et-noix-mrryzemy6kf\",\"title\":\"Pizza Mascarpone Speck Et Noix\",\"category\":\"A\",\"time\":45,\"servings\":4,\"ingredients\":[[\"Farine type 0 1 kg\",\"\",\"\"],[\"Eau 600 g\",\"\",\"\"],[\"Huile d'olive extra vierge 60 g\",\"\",\"\"],[\"Levure de bière sèche 7 g\",\"\",\"\"],[\"Sel fin 20 g\",\"\",\"\"],[\"Speck en tranches 150 g\",\"\",\"\"],[\"Mascarpone crémeux 150 g\",\"\",\"\"],[\"Cerneaux de noix 40 g\",\"\",\"\"],[\"Huile d'olive extra vierge 10 g\",\"\",\"\"],[\"Origan 10 g\",\"\",\"\"],[\"Mozzarella de bufflonne ou mozzarella 600 g\",\"\",\"\"],[\"Purée de tomates 700 g\",\"\",\"\"],[\"Sel fin à volonté\",\"\",\"\"]],\"steps\":[\"Pour préparer la pâte à pizza, commencez par verser la farine dans le bol du robot pâtissier 1 . Ajoutez la levure 2 et 100 grammes d'eau, puis mettez le robot en marche avec le crochet installé à vitesse moyenne-basse 3 .\",\"Poursuivez en ajoutant l'eau petit à petit, en veillant à ce que la dose précédente soit bien absorbée par la farine 4 . Une fois environ 3/4 de l'eau ajoutée, ajoutez le sel 5 et continuez à pétrir. Ajoutez le reste de l'eau en filet et laissez travailler jusqu'à obtenir un mélange lisse et homogène 6 .\",\"À ce stade, ajoutez l'huile progressivement (comme vous l'avez fait avec l'eau) 7 . Lorsque l'huile est complètement absorbée, retirez la pâte du robot et façonnez-la avec vos mains pour obtenir une boule 8 . Placez-la dans un grand bol légèrement huilé 9 .\",\"Couvrez avec un film plastique ou un torchon propre et laissez lever dans le four avec la lumière allumée 10 . Attendez que la pâte ait au moins doublé de volume (1,5 h), voire triplé (2,5/3 h), puis procédez à l'étalage des pizzas 11 . Une fois que la pâte a levé, transférez-la sur le plan de travail et divisez-la en 4 parts égales 12 .\",\"Formez des boules avec chacune 13 . Couvrez avec un torchon propre et laissez reposer 30 minutes 14 . Huilez légèrement avec un filet d'huile 4 plaques à pizza de 30 cm de diamètre. Placez une boule de pâte au centre de chaque plaque 15 .\",\"et commencez à écraser du centre vers l'extérieur, en tirant légèrement les bords si nécessaire 16 . Si la pâte est trop élastique et tend à reprendre sa forme initiale, mettez de côté la pizza que vous étalez et procédez à en étaler une autre, laissant ainsi reposer la précédente. Essayez d'étaler la pâte sur toute la surface de la plaque 17 . À part, dans un grand bol, versez la sauce tomate et assaisonnez-la avec du sel, de l'huile et de l'origan 18 .\",\"Versez une louche généreuse de sauce tomate sur la base de la pizza 19 et étalez-la en mouvement circulaire, couvrant presque toute la surface, en laissant un bord d'environ 1,5 cm 20 . Hachez grossièrement la mozzarella et placez-la sur la pizza 21 .\",\"Ajoutez maintenant le mascarpone à l'aide d'une cuillère à café 22 . Laissez reposer la pizza garnie pendant une dizaine de minutes 23 et enfournez à 250°C pendant 12/15 minutes dans un four statique (sinon environ dix minutes à 230°C dans un four ventilé). Pendant ce temps, hachez légèrement les noix avec un couteau 24 .\",\"Une fois la pizza sortie du four, ajoutez les noix juste hachées 25 et les tranches de speck 26 . Servez la pizza mascarpone speck et noix bien chaude ! 27\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"A\",\"Pizza\"],\"source\":\"https://www.giallozafferano.fr/recettes/pizza-mascarpone-speck-et-noix.html\",\"notes\":\"\",\"paprikaUid\":\"85400E73-996E-4DB6-BC4C-B6361810B430\"},{\"id\":\"pizza-margherita-express-mrryzemxzdo\",\"title\":\"Pizza Margherita express\",\"category\":\"Italie\",\"time\":30,\"servings\":4,\"ingredients\":[[\"(Ø env. 28 cm)\",2,\"abaisses pâte à pizza\"],[\"(env. 220 g)\",1,\"bocal sauce tomate\"],[\"mozzarella\",200,\"g\"],[\"poivre\",\"\",\"\"],[\"basilic\",\"\",\"\"]],\"steps\":[\"Préchauffer le four à 240°C.\",\"Faire glisser 1 abaisse sur une plaque avec le papier.\",\"Répartir la moitié de la sauce tomate sur la pâte en laissant tout autour un bord d'env. 1½ cm.\",\"Couper la mozzarella en tranches d'env. 3 mm d'épaisseur.\",\"Répartir la moitié sur la pâte, poivrer.\",\"Procéder de même avec la deuxième abaisse.\",\"Cuisson: l'une après l'autre env. 15 min dans la moitié inférieure du four.\",\"Retirer.\",\"Couper grossièrement le basilic, en décorer les deux pizzas.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Pizza\",\"Plat principal\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/pizza-margherita-express-10002831/\",\"notes\":\"\",\"paprikaUid\":\"8AA4F45B-A55A-4F41-9E99-8F2E0B0471A9\"},{\"id\":\"pizza-estivale-mrryzemwty9\",\"title\":\"Pizza estivale\",\"category\":\"Italie\",\"time\":30,\"servings\":4,\"ingredients\":[[\"(env. 25 × 38 cm)\",1,\"abaisse pâte à pizza\"],[\"tomates\",3,\"\"],[\"tomate\",2,\"c. à soupe concentré de\"],[\"d’olive\",1,\"c. à soupe huile\"],[\"d’ail\",2,\"gousses\"],[\"sel\",\"\",\"\"],[\"fanes\",3,\"oignons\"],[\"(env. 250 g)\",1,\"aubergine\"],[\"mozzarella\",300,\"g\"],[\"poivre\",\"\",\"\"],[\"origan\",3,\"c. à soupe\"]],\"steps\":[\"Déposer la pâte sur la plaque avec le papier.\",\"Mixer les tomates avec le concentré de tomate, l’huile, l’ail et le sel.\",\"Répartir la masse sur la pâte.\",\"Couper les oignons, l’aubergine et la mozzarella en tranches, répartir dessus, parsemer d’un peu de sel.\",\"Cuisson: env. 25 min dans la moitié inférieure du four préchauffé à 240° C.\",\"Retirer, poivrer parsemer d’origan.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Pizza\",\"Plat principal\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/pizza-estivale-10004193/\",\"notes\":\"\",\"paprikaUid\":\"6175A49B-075D-40E3-AAF5-178B1F5CE72A\"},{\"id\":\"pizza-bianca-verdure-mrryzemvp1t\",\"title\":\"Pizza bianca verdure\",\"category\":\"Italie\",\"time\":40,\"servings\":4,\"ingredients\":[[\"courgettes\",2,\"\"],[\"brocoli\",500,\"g\"],[\"snack\",250,\"g poivrons\"],[\"huile\",2,\"c. à soupe\"],[\"sel\",\"\",\"\"],[\"(d’env. 28 x 38 cm)\",1,\"abaisse pâte à pizza\"],[\"mascarpone\",250,\"g\"],[\"roquette\",50,\"g\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Préchauffer le four à 240° C.\",\"Couper les courgettes en tranches d’env. 4 mm d’épaisseur et le brocoli en petits bouquets.\",\"Couper les poivrons snack en deux.\",\"Mélanger le tout avec l’huile et le sel.\",\"Dérouler l’abaisse, faire glisser sur une plaque avec le papier.\",\"Répartir le mascarpone sur la pâte, saler.\",\"Disposer les légumes dessus.\",\"Cuisson: env. 25 min tout en bas du four.\",\"Retirer, répartir la roquette sur la pizza, poivrer.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Pizza\",\"Plat principal\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/pizza-bianca-verdure-10006018/\",\"notes\":\"\",\"paprikaUid\":\"75815EFF-A8A0-4A01-95AE-B7067D28AF4A\"},{\"id\":\"pizza-au-chou-fleur-mrryzemuqrl\",\"title\":\"Pizza Au Chou-Fleur\",\"category\":\"A\",\"time\":45,\"servings\":4,\"ingredients\":[[\"chou-fleur\",1,\"kg de\"],[\"tomates\",4,\"\"],[\"rouges\",2,\"oignons\"],[\"maïs\",2,\"épis de\"],[\"quelques feuilles d'origan\",\"\",\"\"],[\"baby\",300,\"g de salades\"],[\"d’huile d'olive\",2,\"cs\"],[\"blanc\",2,\"cs de vinaigre balsamique\"],[\"œufs\",2,\"\"],[\"râpé\",100,\"g de Gruyère\"],[\"mozzarella\",2,\"\"],[\"¼ de cc de sel\",1,\"\"],[\"un peu de poivre\",\"\",\"\"]],\"steps\":[\"Râper le chou-fleur sur une râpe à rösti dans un saladier, incorporer les œufs et le fromage, saler et poivrer. Répartir sur une plaque chemisée de papier cuisson.\",\"Répartir les tomates et tous les ingrédients, mozzarella comprise sur le fond de chou-fleur. Cuisson: env. 25 min dans la moitié inférieure du four préchauffé à 220° C. Retirer, parsemer d'origan.\",\"Mélanger la salade romaine, l'huile et le vinaigre, répartir sur la pizza, saler et poivrer.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"A\"],\"source\":\"https://fooby.ch/fr/recettes/11484/pizza-au-chou-fleur\",\"notes\":\"\",\"paprikaUid\":\"EEB284DA-6EE1-48F9-A4C0-6E01BE8660D3\"},{\"id\":\"pinsas-aux-asperges-mrryzemsx64\",\"title\":\"Pinsas aux asperges\",\"category\":\"Asperges\",\"time\":1475,\"servings\":4,\"ingredients\":[[\"vertes\",500,\"g asperges\"],[\"basilic\",1,\"bouquet\"],[\"noisettes\",50,\"g\"],[\"d’ail\",1,\"gousses\"],[\"roquette\",50,\"g\"],[\"1½ dl huile d'olive\",\"\",\"\"],[\"d'olive\",0.5,\"c. à soupe huile\"],[\"blanche\",400,\"g farine\"],[\"chiches\",100,\"g farine de pois\"],[\"poudre\",1,\"paquet levain en\"],[\"sèche\",1,\"paquet levure\"],[\"râpé\",80,\"g parmesan\"],[\"Mozzarella\",250,\"g\"],[\"2¼ c. à café sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Mettre les farines, le levain en poudre, le sel et la levure dans le bol du robot de cuisine, mélanger.\",\"Ajouter l'eau et l'huile, pétrir env. 5 min. avec le crochet pétrisseur jusqu'à ce que la pâte soit lisse et humide.\",\"Couvrir et laisser lever pendant env. 24 h au réfrigérateur.\",\"Couper les pointes des asperges (env. 6 cm) et les réserver.\",\"Couper le reste des asperges en morceaux (soit env. 250 g) et les mettre dans un verre doseur.\",\"Ajouter le basilic et tous les ingrédients jusqu'au poivre compris, mixer.\",\"Sortir la pâte du réfrigérateur env. 1 h avant de la façonner.\",\"Diviser la pâte en deux.\",\"Aplatir les pâtons sur un peu de farine, les étirer jusqu'à obtenir des ovales puis les poser sur deux plaques recouvertes de papier cuisson.\",\"Faire cuire chaque plaque pendant env. 15 min dans le bas du four préchauffé à 240 °C.\",\"Faire chauffer l'huile dans une poêle antiadhésive.\",\"Y faire revenir les pointes d'asperges pendant env. 5 min. en remuant de temps en temps, saler et poivrer.\",\"Garnir les pinsas de pesto, de roquette, de pointes d'asperges et de la Mozzarella.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asperges\",\"Italie\",\"Saison Printemps\"],\"source\":\"https://fooby.ch/fr/recettes/25207/pinsas-aux-asperges\",\"notes\":\"\",\"paprikaUid\":\"E6BBCCE7-0279-40C2-BAB0-BA3AF3310372\"},{\"id\":\"pinsa-a-la-mortadelle-et-burrata-mrryzemrjxy\",\"title\":\"Pinsa À La Mortadelle Et Burrata\",\"category\":\"A\",\"time\":85,\"servings\":8,\"ingredients\":[[\"Base pour pinsa 4\",\"\",\"\"],[\"Mortadelle en tranches 200 g\",\"\",\"\"],[\"Burrata 150 g\",\"\",\"\"],[\"Thym à volonté\",\"\",\"\"],[\"Poivre noir à volonté\",\"\",\"\"],[\"Pommes Granny Smith (à nettoyer) 250 g\",\"\",\"\"],[\"Sucre de canne 50 g\",\"\",\"\"],[\"Oignons rouges 25 g\",\"\",\"\"],[\"Vinaigre de cidre 70 g\",\"\",\"\"],[\"Raisins secs 10 g\",\"\",\"\"],[\"Gingembre frais 7 g\",\"\",\"\"]],\"steps\":[\"Pour préparer la pinsa à la mortadelle et burrata, commencez par peler les pommes et coupez-les d'abord en quartiers 1 , puis en tranches et enfin en dés d'environ 0,5 cm 2 . Épluchez et hachez l'oignon rouge 3 .\",\"Dans une casserole, versez le sucre de canne et le vinaigre de cidre 4 , puis ajoutez l'oignon 5 et faites cuire à feu moyen jusqu'à ce que le sucre soit dissous 6 .\",\"Ajoutez ensuite le gingembre râpé 7 , les pommes en dés 8 et les raisins secs 9 .\",\"Salez 10 , mélangez bien 11 et poursuivez la cuisson à feu moyen-doux pendant environ une heure. Le chutney doit se déliter et s'assécher 12 . Laissez tiédir.\",\"Maintenant, réchauffez la base de pinsa dans un four ventilé préchauffé à 250° pendant 5 minutes, puis sortez-la et garnissez-la de petites cuillerées de burrata 13 . Disposez la mortadelle en tranches 14 et répartissez le chutney 15 .\",\"Enfin, garnissez de thym 16 et de poivre noir 17 . Votre pinsa à la mortadelle et burrata est prête à être dégustée 18 !\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"A\"],\"source\":\"https://www.giallozafferano.fr/recettes/pinsa-a-la-mortadelle-et-burrata.html\",\"notes\":\"\",\"paprikaUid\":\"71EB18CA-0896-48CA-8895-F94ADAA88232\"},{\"id\":\"piccata-milanaise-mrryzemq1z1\",\"title\":\"Piccata milanaise\",\"category\":\"Italie\",\"time\":40,\"servings\":4,\"ingredients\":[[\"farine\",4,\"c. à soupe\"],[\"frais\",2,\"œufs\"],[\"lait\",2,\"c. à soupe\"],[\"râpé\",50,\"g parmesan\"],[\"paprika\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"(d’env. 20 g, p. ex. faux-filet)\",16,\"escalopes de veau\"],[\"beurre à rôtir\",\"\",\"\"]],\"steps\":[\"Préchauffer le four à 60°C, y glisser un plat et des assiettes.\",\"Mettre la farine dans une assiette plate.\",\"Battre les œufs avec le lait dans une assiette creuse, incorporer le fromage.\",\"Mélanger paprika, sel et poivre, en assaisonner les escalopes.\",\"Bien faire chauffer un peu de beurre à rôtir dans une poêle antiadhésive.\",\"Baisser le feu.\",\"Tourner les escalopes par portions dans la farine, secouer pour faire tomber l’excédent et les tourner dans le mélange œufs-fromage.\",\"Saisir les escalopes par portions sur feu moyen, env. 30 s sur chaque face, retirer, réserver au chaud.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/piccata-milanaise-10000816/\",\"notes\":\"\",\"paprikaUid\":\"1FCCE9BB-2A67-471E-881C-634C48B95A01\"},{\"id\":\"piccata-de-courgettes-et-risotto-aux-poivrons-mrryzempfgm\",\"title\":\"Piccata de courgettes et risotto aux poivrons\",\"category\":\"Plat principal\",\"time\":35,\"servings\":4,\"ingredients\":[[\"Risotto:\",\"\",\"\"],[\"oignon\",1,\"\"],[\"d'ail\",1,\"gousse\"],[\"risotto\",250,\"g riz\"],[\"beurre\",\"\",\"\"],[\"légumes\",7,\"dl bouillon de\"],[\"poivron\",300,\"g\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"crème\",3,\"c. à soupe\"],[\"Piccata:\",\"\",\"\"],[\"œuf\",2,\"\"],[\"Sbrinz\",75,\"g\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"paprika\",\"\",\"\"],[\"jus de citron\",\"\",\"\"],[\"aromatiques\",1,\"c. à soupe herbes\"],[\"courgettes\",500,\"g\"],[\"farine\",3,\"c. à soupe\"],[\"crème à rôtir\",\"\",\"\"],[\"basilic\",\"\",\"\"]],\"steps\":[\"Risotto:\",\"Hacher finement l'oignon et l'ail.\",\"Couper les poivrons en dés.\",\"Couper les courgettes en rondelles d'un cm.\",\"Faire revenir l'oignon, l'ail et le riz dans le beurre.\",\"Mouiller avec un peu de bouillon.\",\"Ajouter le reste du bouillon petit à petit.\",\"Laisser mijoter 10 min à petit feu.\",\"Ajouter les poivrons et terminer la cuisson du riz (encore 10-15 min), en remuant fréquemment.\",\"Rectifier l'assaisonnement et affiner avec la crème.\",\"Piccata:\",\"Battre les œufs, le Sbrinz râpé, les épices, le jus de citron et les herbes à l'aide d'une fourchette.\",\"Passer les courgettes dans la farine, tamponner, puis dans les œufs battus.\",\"Dorer env. 5 min de chaque côté à feu moyen dans le beurre à rôtir.\",\"Dresser le risotto et la piccata dans des assiettes préchauffées et décorer de basilic.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Risotto\",\"Végétarien\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM200507_29/piccata-et-risotto-aux-poivrons/\",\"notes\":\"\",\"paprikaUid\":\"07F6A1BD-D194-4AF0-BD5D-4479D5CD0B63\"},{\"id\":\"piccata-de-courgettes-mrryzemoi4u\",\"title\":\"Piccata de courgettes\",\"category\":\"Plat principal\",\"time\":40,\"servings\":4,\"ingredients\":[[\"Piccata de courgettes:\",\"\",\"\"],[\"courgettes\",250,\"g\"],[\"sel\",\"\",\"\"],[\"œufs\",4,\"u\"],[\"poivre\",\"\",\"\"],[\"Sbrinz\",120,\"g\"],[\"farine\",4,\"c. à soupe\"],[\"beurre à rôtir\",\"\",\"\"],[\"Sauce tomate:\",\"\",\"\"],[\"cerises\",500,\"g tomates\"],[\"d'ail\",1,\"u gousses\"],[\"aromatiques\",0.5,\"u bouquet herbes\"],[\"vinaigre\",2,\"c. à café\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Piccata:\",\"Couper la courgette en tranches d'env. 4 mm d’épaisseur.\",\"Bien saler, taper avec le marteau et réserver.\",\"Râper le fromage.\",\"Préparer la farine dans une assiette plate.\",\"Battre les œufs et le poivre à la fourchette dans une assiette creuse et incorporer le Sbrinz.\",\"Chauffer le beurre dans une poêle haute.\",\"Sécher les courgettes avec du papier ménage.\",\"Passer chaque tranche dans la farine, puis dans les œufs au fromage.\",\"Plonger dans la poêle et faire dorer des deux côtés.\",\"Réserver au chaud.\",\"Sauce:\",\"Couper les tomates en quartiers.\",\"Presser l'ail et hacher les herbes.\",\"Mettre les tomates dans une poêle avec l'ail, les herbes, le vinaigre et les épices.\",\"Cuire 5-10 min à feu moyen.\",\"Selon les goûts, mixer la préparation.\",\"Servir avec la piccata.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Végétarien\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM200809_62/piccata-de-courgettes/\",\"notes\":\"\",\"paprikaUid\":\"EC8A629F-1CA0-47F1-9BBB-8B3C6BEA4DA5\"},{\"id\":\"pho-bo-soupe-asiatique-mrryzemnzov\",\"title\":\"Pho Bo (Soupe asiatique)\",\"category\":\"Asie\",\"time\":30,\"servings\":2,\"ingredients\":[[\"boeuf\",8,\"dl bouillon de\"],[\"oignons\",1,\"\"],[\"gingembre\",1,\"cm\"],[\"fanes\",1,\"oignons botte avec les\"],[\"limettes\",1,\"\"],[\"mungo\",50,\"g germes de haricots\"],[\"coriandre\",2,\"c. à soupe feuilles de\"],[\"poisson\",1,\"c. à soupe sauce de\"],[\"riz\",100,\"g nouilles de\"],[\"bœuf\",150,\"g filet de\"],[\"étoilés\",1,\"anis\"],[\"cannelle\",0.5,\"bâtonnets\"]],\"steps\":[\"Cuire l'oignon et tous les ingrédients, cannelle comprise sur feu moyen env. 30 minutes.\",\"Filtrer le bouillon, remettre en casserole, porter à ébullition.\",\"Préparer les nouilles selon les indications sur l'emballage, égoutter.\",\"Répartir avec la viande de bœuf dans deux grandes assiettes à soupe.\",\"Verser le bouillon chaud dessus, laisser infuser env. 1 minute.\",\"Ajouter l'oignon frais et les pousses.\",\"Parsemer de coriandre.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Plat principal\",\"Soupe\"],\"source\":\"https://fooby.ch/fr/recettes/10562/pho-bo\",\"notes\":\"\",\"paprikaUid\":\"AF238FF4-05B8-4125-9CA9-E6623E2F3125\"},{\"id\":\"petites-focaccias-a-la-poele-mrryzemmbmj\",\"title\":\"Petites Focaccias À La Poêle\",\"category\":\"A\",\"time\":30,\"servings\":10,\"ingredients\":[[\"Farine type 00 350 g\",\"\",\"\"],[\"Eau 205 g\",\"\",\"\"],[\"Levure instantanée pour préparations salées 5 g\",\"\",\"\"],[\"Huile d'olive extra vierge 20 g\",\"\",\"\"],[\"Sel fin 10 g\",\"\",\"\"],[\"Provolone dessert 200 g\",\"\",\"\"],[\"Jambon cuit (en fines tranches) 200 g\",\"\",\"\"]],\"steps\":[\"Pour préparer les focaccias à la poêle, versez d'abord la farine dans un bol. Ajoutez le sel 1 et la levure chimique instantanée 2 . Ajoutez également l'eau 3 .\",\"Commencez à mélanger avec une cuillère en bois 4 et lorsque vous aurez obtenu une préparation homogène, ajoutez l'huile 5 . Mélangez encore, puis commencez à pétrir à la main 6 .\",\"Transférez sur le plan de travail et travaillez jusqu'à obtenir une masse homogène 7 . Formez maintenant un boudin 8 et découpez-le en 10 morceaux d'environ 55-60 g chacun 9 .\",\"Avec chaque portion, formez une boule en relevant les bords de pâte et en les ramenant vers le centre 10 . Retournez-la sur le plan (la fermeture doit être en dessous) et faites rouler chaque boule entre vos mains pour lui donner une forme bien ronde. Procédez de même pour toutes les autres 11 . Couvrez avec un torchon 12 et laissez reposer.\",\"Pendant ce temps, coupez le fromage en petits dés 13 . Prenez une des boulettes et étalez-la au rouleau sur un plan fariné 14 jusqu'à obtenir un disque fin 15 .\",\"Déposez au centre quelques dés de fromage 16 , posez dessus une tranche de jambon 17 et ajoutez encore du fromage 18 .\",\"Refermez les focaccias en relevant les bords de pâte et en les pinçant au centre 19 . Faites de même sur tous les côtés afin d'obtenir un petit paquet 20 , bien scellé. Retournez-le sur le plan et faites-le tourner délicatement 21 .\",\"Placez les focaccias dans une poêle chaude 22 . Attendez quelques secondes, puis aplatissez-les délicatement 23 . Couvrez avec un couvercle et poursuivez la cuisson pendant 5-6 minutes 24 .\",\"Retirez le couvercle, retournez les focaccias 25 et aplatissez-les encore délicatement 26 . Poursuivez la cuisson encore 5-6 minutes. Ainsi, la chaleur pénétrera à l'intérieur et le fromage sera bien fondu. Transférez sur une planche à découper et servez vos focaccias à la poêle 27 .\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"A\",\"Pizza\"],\"source\":\"https://www.giallozafferano.fr/recettes/petites-focaccias-a-la-poele.html\",\"notes\":\"\",\"paprikaUid\":\"C8A677F7-9A29-46C4-AF45-42D6C246094F\"},{\"id\":\"peperonata-et-pommes-de-terre-au-four-mrryzeml3wk\",\"title\":\"Peperonata et pommes de terre au four\",\"category\":\"Saison Été\",\"time\":65,\"servings\":4,\"ingredients\":[[\"nouvelle\",800,\"g pomme de terre\"],[\"crème à rôtir\",\"\",\"\"],[\"poivron\",600,\"g\"],[\"d'ail\",4,\"gousse\"],[\"échalote\",2,\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"tomate\",2,\"\"],[\"mozzarella\",300,\"g\"]],\"steps\":[\"Préchauffer le four à 200°.\",\"Badigeonner les pommes de terre de crème à rôtir.\",\"Disposer sur 1/3 de la plaque, chemisée de papier sulfurisé.\",\"Cuire 10 minutes au milieu du four.\",\"Epépiner les poivrons et les couper en lamelles de 2 cm.\",\"Couper les échalotes en rondelles de 3 mm.\",\"Éplucher les gousses d'ail.\",\"Tourner les poivrons, les gousses d'ail et l'échalote dans la crème à rôtir.\",\"Disposer sur la plaque, à côté des pommes de terre.\",\"Assaisonner.\",\"Cuire encore 30 minutes.\",\"Sortir du four.\",\"Régler la température sur 250 °C.\",\"Couper les tomates épépinées et la mozzarella en tranches.\",\"Garnir les poivrons de tomates et de mozzarella.\",\"Assaisonner.\",\"Gratiner 5-10 minutes au milieu du four.\",\"Assaisonner les pommes de terre.\",\"Dresser sur des assiettes chaudes avec les poivrons.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Saison Été\",\"Végétarien\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM200207_37_a/peperonata-et-pommes-de-terre-au-four/\",\"notes\":\"\",\"paprikaUid\":\"6D296CD2-11C7-4B6D-A18B-4172E375ADF3\"},{\"id\":\"pennes-a-la-vodka-mrryzemkusz\",\"title\":\"Pennes à la Vodka\",\"category\":\"Italie\",\"time\":35,\"servings\":4,\"ingredients\":[[\"échalote\",1,\"u\"],[\"d’ail\",2,\"u gousse\"],[\"origan\",0.5,\"c. à café\"],[\"basilic\",0.5,\"u bouquet\"],[\"entière\",2,\"dl crème\"],[\"râpé\",40,\"g parmesan\"],[\"pâtes\",300,\"g\"],[\"tomate\",350,\"g sauce\"],[\"1½ dl vodka\",\"\",\"\"],[\"tranches\",100,\"g lard à rôtir en\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Faire dorer les lardons lentement à la poêle sans ajouter de matière grasse.\",\"Baisser le feu.\",\"Ajouter l'échalote et l'ail et les faire suer pendant 2 min.\",\"Mouiller avec 1 dl de vodka, laisser réduire de moitié.\",\"Ajouter la sauce tomate, la crème et le reste de vodka, faire bouillir, assaisonner.\",\"Réduire le feu, laisser mijoter pendant 4 min en remuant de temps en temps.\",\"Ajouter le parmesan, mélanger.\",\"Faire cuire les pâtes al dente dans l'eau salée frémissante, les égoutter et les mélanger à la sauce.\",\"Parsemer de basilic.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Pâtes\"],\"source\":\"https://fooby.ch/fr/recettes/27273/pennes-a-la-vodka\",\"notes\":\"\",\"paprikaUid\":\"09068FD5-6653-4DA7-80C8-F069C159DB33\"},{\"id\":\"penne-pomodoro-mrryzemjzjf\",\"title\":\"Penne pomodoro\",\"category\":\"Italie\",\"time\":25,\"servings\":4,\"ingredients\":[[\"cerises\",500,\"g tomates\"],[\"thym\",5,\"u brins de\"],[\"citron\",2,\"tbsp jus de\"],[\"demi-crème\",2,\"dl\"],[\"penne\",400,\"\"],[\"beurre\",\"\",\"\"],[\"oignon\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Cuire les pâtes al dente dans de l’eau salée bouillante.\",\"Egoutter et réserver au chaud.\",\"Faire fondre 1 c.s. de beurre.\",\"Tailler l’oignon en fines lanières.\",\"Faire revenir.\",\"Couper les tomates en quatre.\",\"Effeuiller le thym.\",\"Ajouter les deux et faire revenir un instant.\",\"Mouiller avec le jus de citron et faire revenir un instant.\",\"Ajouter la crème et laisser mijoter env. 3 min.\",\"Assaisonner avec du sel et du poivre.\",\"Mélanger les pâtes avec la sauce.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/penne-pomodoro-10004020/\",\"notes\":\"\",\"paprikaUid\":\"DFC271FA-F167-4CA6-AF57-513D0329B095\"},{\"id\":\"penne-aux-asperges-et-steak-mrryzemijw1\",\"title\":\"Penne aux asperges et steak\",\"category\":\"Asperges\",\"time\":0,\"servings\":4,\"ingredients\":[[\"verte\",1,\"u asperge\"],[\"bœuf\",250,\"g steak de\"],[\"penne\",250,\"g\"],[\"entière\",2,\"dl crème\"],[\"parmesan\",50,\"g\"],[\"cerise\",100,\"g tomate\"],[\"d’ail\",1,\"u gousse\"],[\"huile d’olive\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Parer les asperges et les couper en morceaux.\",\"Couper les tomates en deux.\",\"Assaisonner la viande et la rôtir 2 minutes sur chaque côté.\",\"Sortir et réserver.\",\"Ajouter les asperges et les rôtir.\",\"Ajouter l'ail coupé finement.\",\"Ajouter la crème et le parmesan râpé et bien mélanger.\",\"Ajouter les penne et les tomates et mélanger.\",\"Ajouter la viande coupée en lamelles.\",\"Assaisonner et bien mélanger.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asperges\",\"Pâtes\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"F66C88F4-458E-4FF9-8160-8440478C9088\"},{\"id\":\"penne-all-arrabbiata-mrryzemavli\",\"title\":\"Penne all’arrabbiata\",\"category\":\"Italie\",\"time\":70,\"servings\":4,\"ingredients\":[[\"penne\",500,\"g de\"],[\"eau salée , bouillante\",\"\",\"\"],[\"oignon\",1,\"\"],[\"d’ail\",2,\"gousses\"],[\"mi-forts rouges\",3,\"piments\"],[\"tomates\",750,\"g de\"],[\"plat\",1,\"bouquet de persil\"],[\"d’huile d’olive\",2,\"c.s.\"],[\"d’origan\",1,\"c.s. de feuilles\"],[\"sel\",0.75,\"c.c. de\"],[\"un peu de poivre\",\"\",\"\"],[\"pecorino ou parmesan, râpé\",\"\",\"\"]],\"steps\":[\"Cuire les pâtes al dente dans l’eau salée bouillante, égoutter.\",\"Peler l’oignon et le hacher finement, presser l’ail.\",\"Épépiner les piments et les tailler en fines lanières.\",\"Peler les tomates et les couper en quatre.\",\"Ciseler le persil.\",\"Faire chauffer l’huile dans une casserole.\",\"Faire revenir oignon, ail et piments.\",\"Ajouter les tomates, faire revenir env. 10 minutes.\",\"Ajouter le persil et l’origan.\",\"Saler et poivrer la sauce.\",\"Mélanger avec les penne bien chaudes.\",\"Présenter le fromage à part.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/penne-allarrabbiata-10000600/\",\"notes\":\"\",\"paprikaUid\":\"2DC92DD4-3A41-4226-A199-89E5485BA6EB\"},{\"id\":\"penne-alla-vodka-mrryzem98hl\",\"title\":\"Penne alla Vodka\",\"category\":\"Italie\",\"time\":20,\"servings\":4,\"ingredients\":[[\"penne\",500,\"g\"],[\"sel\",\"\",\"\"],[\"oignon\",1,\"\"],[\"d'ail\",2,\"gousses\"],[\"d'olive\",2,\"c. à soupe huile\"],[\"tomates\",2,\"c. à soupe concentré de\"],[\"vodka\",4,\"cl\"],[\"tomates\",330,\"g coulis de\"],[\"poivre\",\"\",\"\"],[\"crème\",2,\"dl\"],[\"parmesan\",40,\"g\"]],\"steps\":[\"Cuire les pâtes al dente dans un grand volume d'eau salée.\",\"Hacher l'oignon et l'ail.\",\"Les faire suer dans l'huile d'olive dans une grande poêle.\",\"Ajouter le concentré de tomates et faire brièvement revenir.\",\"Mouiller avec la vodka.\",\"Ajouter le coulis et faire mijoter env. 5 min.\",\"Saler et poivrer.\",\"Incorporer la crème et faire réduire un peu.\",\"Égoutter les pâtes en veillant à recueillir env. 1 dl d'eau de cuisson.\",\"Mélanger les pâtes à la sauce.\",\"Incorporer ensuite l'eau de cuisson, peu à peu et en remuant jusqu'à obtention d'une sauce épaisse.\",\"Dresser dans des assiettes.\",\"À l'aide d'un couteau économe, prélever des copeaux de parmesan et en garnir les pâtes.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\"],\"source\":\"https://migusto.migros.ch/fr/recettes/penne-alla-vodka\",\"notes\":\"\",\"paprikaUid\":\"C1E548F1-C47C-4BE1-B3B7-2309F304B986\"},{\"id\":\"paupiettes-de-laitue-tomates-mozzarella-mrryzem8hqu\",\"title\":\"Paupiettes de laitue tomates/mozzarella\",\"category\":\"Végétarien\",\"time\":40,\"servings\":20,\"ingredients\":[[\"pommée\",20,\"grandes feuilles de laitue\"],[\"Farce:\",\"\",\"\"],[\"mozzarella\",300,\"g\"],[\"séchées, conservées dans l'huile\",100,\"g tomates\"],[\"basilic\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"beurre pour garnir\",\"\",\"\"],[\"sbrinz fraîchement râpé\",\"\",\"\"]],\"steps\":[\"Farce:\",\"Couper la mozzarella en petits dés.\",\"Débiter les tomates en morceaux.\",\"Tailler le basilic en julienne.\",\"Mélanger et assaisonner.\",\"Découper les côtes des feuilles de laitue pommée en forme de cône.\",\"Masquer les feuilles de laitue pommée de farce et les façonner en paupiettes.\",\"Déposer dans le plat beurré.\",\"Garnir de flocons de beurre et parsemer de sbrinz.\",\"Gratiner les paupiettes durant 10-15 minutes au milieu du four préchauffé à 200 °C.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Végétarien\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/KB_FT2002_029/paupiettes-de-laitue-tomates-mozzarella/\",\"notes\":\"\",\"paprikaUid\":\"709CCACF-3EDF-44E2-BD19-E97A7B44C5A2\"},{\"id\":\"pasta-quatro-formaggi-svizzeri-mrryzem7go4\",\"title\":\"Pasta quatro formaggi svizzeri\",\"category\":\"Italie\",\"time\":30,\"servings\":4,\"ingredients\":[[\"Appenzeller\",80,\"g fromage\"],[\"frais\",100,\"g fromage\"],[\"crème\",80,\"g fromage à la\"],[\"rebibes\",110,\"g Sbrinz en\"],[\"entier\",2,\"dl lait\"],[\"pâtes\",350,\"g\"]],\"steps\":[\"Faire cuire les pâtes al dente dans l'eau bouillante salée, les égoutter.\",\"Faire chauffer le lait dans une grande casserole.\",\"Ajouter le fromage et laisser frémir en remuant jusqu'à ce que le fromage soit fondu.\",\"Ajouter les pâtes, mélanger et assaisonner.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Pâtes\",\"Suisse\"],\"source\":\"https://fooby.ch/fr/recettes/18134/pasta-4-formaggi-svizzeri\",\"notes\":\"\",\"paprikaUid\":\"A9EF31C5-34AE-42FF-B960-8BC8A76DB8F9\"},{\"id\":\"pasta-e-ceci-mrryzem7ahj\",\"title\":\"Pasta e ceci\",\"category\":\"Italie\",\"time\":70,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"\"],[\"d’ail\",1,\"gousse\"],[\"carottes\",150,\"g\"],[\"céleri-rave\",150,\"g\"],[\"d’olive\",1,\"c. à soupe huile\"],[\"(d'env. 400 g)\",1,\"boîte pois chiches\"],[\"tomate\",2,\"c. à soupe concentré de\"],[\"légumes\",3,\"dl bouillon de\"],[\"eau\",8,\"dl\"],[\"pâtes\",200,\"g\"],[\"romarin\",3,\"brins\"],[\"d’olive\",2,\"c. à soupe huile\"],[\"pecorino, râpé\",40,\"g\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Peler l'oignon et l'ail, hacher finement.\",\"Peler les carottes et le céleri-rave.\",\"Couper les deux en morceaux d'env. 2 cm.\",\"Faire chauffer l'huile dans une casserole.\",\"Faire revenir l'oignon et l'ail env. 2 minutes.\",\"Rincer les pois chiches, égoutter.\",\"Ajouter ¼ avec carottes, céleri-rave et concentré de tomate.\",\"Faire revenir un instant.\",\"Verser le bouillon, porter à ébullition.\",\"Baisser le feu, laisser mijoter env. 10 min à découvert, mixer rapidement.\",\"Verser l'eau, porter à ébullition.\",\"Mettre pâtes, romarin et pois chiches restants dans la sauce, mélanger, faire cuire env. 15 min en remuant de temps en temps, jusqu'à ce que les pâtes soient al dente.\",\"Dresser les pâtes, arroser d'un filet d'huile.\",\"Parsemer de fromage râpé, poivrer.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Pâtes\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/pasta-e-ceci-10010688/\",\"notes\":\"\",\"paprikaUid\":\"7E652E95-B000-4BD9-8CAB-EBABB74A0B4F\"},{\"id\":\"pasta-alla-norma-mrryzem6f3w\",\"title\":\"Pasta alla norma\",\"category\":\"Italie\",\"time\":105,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"\"],[\"d’ail\",1,\"gousse\"],[\"d’olive\",1,\"c. à soupe huile\"],[\"tomate\",2,\"c. à soupe concentré de\"],[\"(d'env. 800 g)\",1,\"grosse boîte tomates pelées\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"aubergines\",800,\"g\"],[\"d’olive\",4,\"c. à soupe huile\"],[\"rigatoni\",250,\"g pâtes\"],[\"eau salée , bouillante\",\"\",\"\"],[\"parmesan\",100,\"g\"]],\"steps\":[\"Peler l'oignon et l'ail, hacher finement les deux.\",\"Faire chauffer l'huile dans une casserole.\",\"Faire revenir l'oignon et l'ail env. 2 minutes.\",\"Ajouter le concentré de tomate, faire revenir un instant.\",\"Ajouter les tomates pelées, saler et poivrer la sauce, laisser bouillonner env. 20 min à découvert.\",\"Couper les aubergines en morceaux d'env. 1½ cm.\",\"Bien faire chauffer l'huile dans une grande poêle antiadhésive.\",\"Faire sauter les aubergines env. 15 min en remuant, saler, poivrer.\",\"Cuire les pâtes al dente dans l'eau salée bouillante.\",\"Égoutter, les incorporer à la sauce avec les aubergines, dresser.\",\"Râper grossièrement le parmesan par-dessus.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Pâtes\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/pasta-alla-norma-10010695/\",\"notes\":\"\",\"paprikaUid\":\"D00DAD0B-06B7-4B43-9A8F-60D4CF809C22\"},{\"id\":\"pasta-5-p-2-mrryzem4oip\",\"title\":\"Pasta 5 P 2\",\"category\":\"Italie\",\"time\":0,\"servings\":4,\"ingredients\":[[\"penne\",500,\"g pâtes\"],[\"charnue\",400,\"g tomate\"],[\"parmesan\",60,\"g\"],[\"entière\",4,\"dl crème\"],[\"frisé\",1,\"u bouquet persil\"],[\"échalote\",1,\"u\"],[\"huile d'olive\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Cuire les pâtes dans de l'eau salée.\",\"Pendant ce temps, couper les tomates en petits dés.\",\"Hacher finement l'échalote.\",\"Hacher le persil.\",\"Râper le parmesan.\",\"Dans une poêle, faire revenir l'échalote.\",\"Ajouter les tomates et brasser.\",\"Ajouter la crème et cuire sur petit feu pendant 8 minutes.\",\"Ajouter le persil et le parmesan et mélanger.\",\"Assaisonner avec sel et généreusement poivre.\",\"Égoutter les pâtes et les ajouter à la sauce.\",\"Mélanger et servir avec une salade.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Pâtes\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"15695C5E-B084-40CC-92A1-D544C4D86D08\"},{\"id\":\"pasta-5-p-1-mrryzelz0d9\",\"title\":\"Pasta 5 P 1\",\"category\":\"Italie\",\"time\":30,\"servings\":4,\"ingredients\":[[\"surgelés\",200,\"g petits pois\"],[\"fanes\",1,\"oignons botte avec les\"],[\"d’ail\",1,\"gousses\"],[\"plat\",0.5,\"bouquet persil\"],[\"blanche\",1,\"c. à soupe farine\"],[\"beurre\",1,\"c. à soupe\"],[\"2½ dl crème\",\"\",\"\"],[\"râpé\",40,\"g parmesan\"],[\"pâtes\",300,\"g\"],[\"jambon\",120,\"g dés de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Faire fondre le beurre dans une grande poêle.\",\"Y faire suer les oignons botte et l'ail pendant env. 5 min.\",\"Ajouter le jambon et la farine, faire revenir brièvement.\",\"Verser la crème, saler, poivrer et faire mijoter env. 5 min.\",\"Faire cuire les pâtes al dente.\",\"Ajouter les petits pois, poursuivre brièvement la cuisson.\",\"Égoutter en réservant env. 1,5 dl d'eau de cuisson.\",\"Ajouter les pâtes, les petits pois, l'eau de cuisson réservée et le persil à la sauce, mélanger.\",\"Dresser les pâtes avec le parmesan.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Pâtes\"],\"source\":\"https://fooby.ch/fr/recettes/27988/pasta-cinque-p\",\"notes\":\"\",\"paprikaUid\":\"C451AC04-775D-4F1A-B8C2-1DBBC31F9EA3\"},{\"id\":\"party-filet-a-la-creme-de-grappa-mrryzelyxv8\",\"title\":\"Party-Filet à la crème de Grappa\",\"category\":\"Plat principal\",\"time\":45,\"servings\":4,\"ingredients\":[[\"mignon\",1,\"u filet\"],[\"paprika\",0.5,\"c. à soupe\"],[\"sel\",\"\",\"\"],[\"tranches\",12,\"u lard en\"],[\"haricot\",200,\"g\"],[\"blanc\",1,\"dl vin\"],[\"Sauce :\",\"\",\"\"],[\"entière\",2,\"dl crème\"],[\"miel\",1,\"c. à soupe\"],[\"Grappa\",2,\"c. à soupe\"],[\"ketchup\",2,\"c. à soupe\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Préchauffer le four à 160°.\",\"Bohnen kurz in kochendem Salzwasser blanchieren.\",\"Abschrecken und in 3-4 cm lange Stücke schneiden.\",\"Fleisch in gleich dicke Medaillons schneiden, würzen.\",\"Kurz von allen Seiten scharf anbraten.\",\"Medaillons und Bohnen mit den Specktranchen umwickeln.\",\"In die Form stellen.\",\"Wein eingiessen.\",\"Braten: ca. 20 Min. in der unteren Hälfte des Ofens.\",\"Rahm steif schlagen.\",\"Restliche Zutaten daruntermischen.\",\"Fleisch und Bohnen aus dem Ofen nehmen und 5-10 Minuten mit Alu zugedeckt ruhen lassen.\",\"Sauce gleichmässig darauf verteilen.\",\"Servir avec des nouilles ou du riz blanc.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Suisse\"],\"source\":\"https://www.bettybossi.ch/de/rezepte/rezept/party-filet-mit-grappa-rahm-10005418/?srsltid=AfmBOori-kcLNOZF6z5xp4r7XE7esxobbf0V3okw8Fo3KFHJAmag6wsR\",\"notes\":\"\",\"paprikaUid\":\"63DD7874-0DC0-4E11-B2BA-A2F5A3284F98\"},{\"id\":\"parmigiana-mrryzelxu2p\",\"title\":\"Parmigiana\",\"category\":\"Italie\",\"time\":80,\"servings\":4,\"ingredients\":[[\"(env. 1 kg)\",4,\"aubergines\"],[\"d’olive\",0.5,\"dl huile\"],[\"d’olive\",0.5,\"c. à soupe huile\"],[\"d’ail\",2,\"gousses\"],[\"(d'env. 800 g)\",1,\"boîte tomates concassées\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"mozzarella\",150,\"g\"],[\", râpé\",100,\"g parmesan\"],[\"basilic\",\"\",\"\"]],\"steps\":[\"Préchauffer le four à 220°C (chaleur tournante).\",\"Couper les aubergines dans la longueur en rondelles d'env. 5 mm d'épaisseur.\",\"Badigeonner d'huile, répartir sur deux plaques chemisées de papier cuisson.\",\"Cuisson au four: env. 20 minutes.\",\"Faire chauffer l'huile dans une casserole.\",\"Ajouter l'ail pressé, faire revenir.\",\"Ajouter les tomates, saler, poivrer, porter à ébullition, laisser bouillonner la sauce env. 20 min sur feu doux en remuant de temps en temps.\",\"Effilocher la mozzarella.\",\"Répartir 3 c.s. de sauce tomate et la moitié des aubergines dans le plat graissé.\",\"Répartir dessus la moitié de la sauce tomate, de la mozzarella et du parmesan.\",\"Répartir ensuite dessus le reste des aubergines, de la sauce tomate, de la mozzarella et du parmesan.\",\"Finition au four: env. 20 minutes.\",\"Retirer, laisser reposer la parmigiana env. 5 minutes.\",\"Parsemer de basilic.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/parmigiana-10004171/\",\"notes\":\"\",\"paprikaUid\":\"FC11C71F-CA8F-4FED-9365-3EA0BA4D736D\"},{\"id\":\"pappardelle-al-ragu-mrryzelwdp4\",\"title\":\"Pappardelle al ragù\",\"category\":\"Italie\",\"time\":150,\"servings\":4,\"ingredients\":[[\"oignons\",1,\"\"],[\"d’ail\",1,\"gousses\"],[\"d'olive\",1,\"c. à soupe huile\"],[\"sucre\",1,\"c. à café\"],[\"nouilles\",2,\"rouleaux pâte à\"],[\"tomates\",1,\"verre coulis de\"],[\"porc\",1,\"steaks cou de\"],[\"porc\",1,\"saucisses à rôtir de\"],[\"veau\",1,\"jarrets de\"],[\"rouge\",1,\"dl vin\"],[\"romarin\",1,\"brin\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Couper la viande en cubes de 2 cm environ.\",\"Entailler la saucisse et vider la chair.\",\"Hacher menu l'oignon et l'ail, ciseler le romarin.\",\"Faire chauffer l'huile dans une cocotte.\",\"Y saisir le steak, la chair à saucisse et le jarret pendant env. 5 min. et les sortir.\",\"Faire suer brièvement l'oignon, l'ail et le romarin dans la même cocotte.\",\"Mouiller avec le vin rouge et laisser réduire presque entièrement.\",\"Ajouter les tomates, l'eau et le sucre, assaisonner, puis remettre la viande.\",\"Laisser mijoter à couvert pendant env. 1 ½ h.\",\"Retirer le jarret, le steak et la chair à saucisse de la sauce, les émietter à l'aide de deux fourchettes.\",\"Les remettre dans la cocotte et les réchauffer.\",\"Dérouler la pâte et la couper en lanières d'env. 2 cm de large.\",\"Mettre les pappardelle sur une plaque ou un linge bien fariné.\",\"Faire blanchir les parpadelle dans l'eau frémissante salée pendant env. 1 min., les égoutter.\",\"Dresser les pappardelle au ragù.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Pâtes\"],\"source\":\"https://fooby.ch/fr/recettes/17512/pappardelle-al-ragu\",\"notes\":\"\",\"paprikaUid\":\"0975669A-1EE5-468B-B286-D2F0D8A4EA2D\"},{\"id\":\"pappa-al-pomodoro-mrryzelv781\",\"title\":\"Pappa al pomodoro\",\"category\":\"Sauce\",\"time\":35,\"servings\":4,\"ingredients\":[[\"d'ail pressée\",1,\"gousse\"],[\"boîte\",700,\"g tomates ou de tomates pelées en\"],[\"haché\",0.5,\"bouquet basilic\"],[\"bouillon\",6,\"dl\"],[\"dés\",100,\"g pain de la veille coupé en\"],[\"sucre\",1,\"c. à café\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"basilic pour décorer\",\"\",\"\"],[\"râpé\",50,\"g Sbrinz\"]],\"steps\":[\"Tomates:\",\"Réaliser une incision en croix sous les tomates.\",\"Recouvrir d'eau bouillante.\",\"Laisser reposer 30 sec.\",\"Passer sous l'eau froide.\",\"Peler et couper en dés.\",\"Ou utiliser des tomates pelées en boîte.\",\"Faire fondre le beurre, ajouter l'ail, faire revenir.\",\"Ajouter les tomates et le basilic, faire revenir.\",\"Mouiller avec le bouillon et porter à ébullition.\",\"Ajouter le pain et le sucre.\",\"Assaisonner et laisser mijoter env. 20 min à couvert.\",\"Servir la pappa al pomodoro.\",\"Décorer avec du basilic.\",\"Servir avec du Sbrinz.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Sauce\",\"Végétarien\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM200104_31_MEN104B031A/pappa-al-pomodoro/\",\"notes\":\"\",\"paprikaUid\":\"DA5BD090-16C9-4B33-9A63-3B905FF3F804\"},{\"id\":\"panzanella-salade-toscane-au-pain-mrryzelsa8t\",\"title\":\"Panzanella (Salade toscane au pain)\",\"category\":\"Italie\",\"time\":45,\"servings\":4,\"ingredients\":[[\"veille\",200,\"g pain blanc de\"],[\"fanes\",2,\"oignons\"],[\"d’ail\",2,\"gousses\"],[\"eau\",3,\"dl\"],[\"herbes\",2,\"c. à soupe vinaigre aux\"],[\"laurier\",1,\"feuille\"],[\"poudre\",1,\"c. à café bouillon de légumes en\"],[\"tomates\",2,\"\"],[\"concombre\",0.5,\"\"],[\"noires\",12,\"olives\"],[\"câpre\",2,\"c. à soupe\"],[\"plat\",2,\"c. à soupe persil\"],[\"basilic\",10,\"feuilles de\"],[\"herbes\",2,\"c. à soupe vinaigre aux\"],[\"d’olive\",4,\"c. à soupe huile\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Couper le pain en tranches d'env. 1½ cm d'épaisseur, mettre dans un grand saladier.\",\"Couper les oignons fanes en rouelles, l'ail en lamelles, ajouter.\",\"Porter à ébullition l'eau avec le vinaigre, la feuille de laurier et le bouillon en poudre, laisser mijoter environ 5 min, laisser tiédir un peu, ôter la feuille de laurier.\",\"Verser le liquide sur le pain, laisser reposer env. 15 min à couvert.\",\"Effilocher le pain en gros morceaux.\",\"Couper les tomates en quartiers.\",\"Peler le concombre, le couper en deux, l'épépiner, le couper en morceaux.\",\"Mélanger les deux et les olives au pain.\",\"Rincer les câpres, les égoutter.\",\"Couper finement le persil et le basilic.\",\"Mélanger le vinaigre et l'huile, incorporer les câpres et les herbes.\",\"Verser la sauce sur la salade, mélanger, saler et poivrer.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Salade\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/panzanella-10010991/\",\"notes\":\"\",\"paprikaUid\":\"C96353DF-8E6F-44F6-8F9C-2CE9BE36FBD1\"},{\"id\":\"panna-cotta-au-chocolat-blanc-et-aux-melons-mrryzelnk5v\",\"title\":\"Panna cotta au chocolat blanc et aux melons\",\"category\":\"Dessert\",\"time\":270,\"servings\":4,\"ingredients\":[[\"blanc\",40,\"g chocolat\"],[\"charentais\",1,\"melons\"],[\"gélatine\",3,\"feuille\"],[\"vanille\",1,\"gousses\"],[\"sucre\",2,\"c. à soupe\"],[\"entière\",4,\"dl crème\"],[\"lait\",1,\"dl\"],[\"liquide\",1,\"c. à soupe miel\"],[\"citron\",1,\"c. à café jus de\"]],\"steps\":[\"Placer la gélatine dans de l’eau froide pendant environ 5 minutes.\",\"Couper la gousse de vanille dans le sens de la longueur, gratter la gousse.\",\"Faire bouillir avec le lait et le sucre, réduire la température.\",\"Faire réduire jusqu’à environ 4 dl.\",\"Retirer la poêle de la plaque.\",\"Couper le chocolat en morceaux.\",\"Verser dans la préparation chaude et le faire fondre dedans.\",\"Égoutter la gélatine, la mélanger dans la préparation chaude.\",\"Verser celle-ci dans un verre doseur à travers une passoire.\",\"Rincer les moules (d’environ 1 ½ dl chacun) à l’eau froide.\",\"Les remplir avec la préparation.\",\"Faire refroidir et durcir à couvert dans le réfrigérateur pendant environ 4 heures.\",\"Couper les melons en deux et enlever les pépins.\",\"Couper une moitié de la chair du melon en tranches et/ou en boules.\",\"Couper le reste de la chair en petits morceaux et le réduire en purée avec le jus du citron et le miel.\",\"Détacher soigneusement la panna cotta des moules avec la pointe d’un couteau.\",\"Plonger rapidement les petits moules dans l’eau chaude.\",\"Renverser la panna cotta sur des assiettes.\",\"Garnir avec la sauce du melon et les morceaux de melon.\",\"Couper des copeaux de chocolat et les répartir sur la préparation.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Dessert\",\"Italie\"],\"source\":\"https://fooby.ch/fr/recettes/11522/panna-cotta-au-chocolat-blanc-et-aux-melons\",\"notes\":\"\",\"paprikaUid\":\"A4DB2A9E-0412-4877-AB27-946922DEAAC3\"},{\"id\":\"pallotte-mrryzelmp8q\",\"title\":\"Pallotte\",\"category\":\"Italie\",\"time\":45,\"servings\":4,\"ingredients\":[[\"veille\",400,\"g pain blanc de la\"],[\"lait\",2,\"dl\"],[\"râpé\",100,\"g fromage\"],[\"œuf\",4,\"u\"],[\"tomate\",8,\"dl sauce\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"plat\",1,\"u bouquet persil\"],[\"d'ail\",1,\"u gousse\"],[\"huile de friture\",\"\",\"\"],[\"́panure\",\"\",\"\"]],\"steps\":[\"Couper le pain en dés et le tremper avec le lait tiède.\",\"Râper le fromage.\",\"Hacher le persil.\",\"Essorer bien le pain et le mettre dans un bol.\",\"Ajouter les œufs, le fromage, le persil et l'ail pressé.\",\"Bien assaisonner et mélanger.\",\"Former avec des mains mouillées des boulettes.\",\"Les tourner dans la panure.\",\"Chauffer l'huile dans une casserole profonde.\",\"Frire les boulettes en portions jusqu'à ce qu'elles sont bien dorées.\",\"Les déposer sur du papier ménage.\",\"Chauffer la sauce tomate.\",\"Ajouter les boulettes et les laisser mijoter pendant 5-10 minutes.\",\"Servir avec salade.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Végétarien\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"17D41596-F0FE-42A8-B880-C556B4AB6111\"},{\"id\":\"pain-perdu-a-la-rhubarbe-mrryzeldbah\",\"title\":\"Pain perdu à la rhubarbe\",\"category\":\"Plat principal\",\"time\":50,\"servings\":4,\"ingredients\":[[\"rhubarbe\",400,\"g\"],[\"sucre\",2,\"c. à soupe\"],[\"brioche\",250,\"g\"],[\"Liaison:\",\"\",\"\"],[\"lait\",3,\"dl\"],[\"demi-crème\",1,\"dl\"],[\"œufs\",3,\"\"],[\"sucre\",3,\"c. à soupe\"],[\"vanillé\",2,\"tsp sucre\"],[\"sucre glace\",\"\",\"\"]],\"steps\":[\"Parer la rhubarbe et la couper en petits dés.\",\"Couper la brioche en tranches d'env. 1 cm d'épaisseur.\",\"Préchauffer le four à 200°.\",\"Dorer la rhubarbe et le sucre dans une poêle.\",\"Mijoter 2 - 3 min.\",\"Laisser refroidir.\",\"Jeter le jus.\",\"Alterner des couches de brioche et de rhubarbe dans le moule préalablement beurré.\",\"Liaison:\",\"Mélanger tous les ingrédients.\",\"Verser sur les brioches dans le plat.\",\"Cuire 30 - 40 min dans la partie inférieure du four préchauffé à 200°C.\",\"Laisser refroidir un peu avant de servir.\",\"Répartir sur des assiettes.\",\"Saupoudrer de sucre glace.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Suisse\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM200505_21/pain-perdu-a-la-rhubarbe/\",\"notes\":\"\",\"paprikaUid\":\"1C304175-5FC3-45CC-97D1-D6BA4D086F5C\"},{\"id\":\"paillard-de-veau-grille-et-salade-de-tomates-mrryzelc6ng\",\"title\":\"Paillard de veau grillé et salade de tomates\",\"category\":\"Plat principal\",\"time\":25,\"servings\":4,\"ingredients\":[[\"pin\",2,\"c. à soupe pignons de\"],[\"basilic\",1,\"bouquet\"],[\"cerises\",600,\"g tomates\"],[\"oignons\",1,\"\"],[\"blanc\",0.5,\"dl vinaigre balsamique\"],[\"d'olive\",0.75,\"dl huile\"],[\"sucre\",0.25,\"c. à café\"],[\"l’ancienne\",1,\"c. à soupe moutarde à\"],[\"veau\",8,\"escalopes de\"],[\"poivre\",\"\",\"\"],[\"sel\",\"\",\"\"]],\"steps\":[\"Bien mélanger la moutarde, le vinaigre et l’huile, saler et sucrer.\",\"Ajouter les tomates cerises, l’oignon et le basilic, mélanger.\",\"Parsemer de pignons de pin.\",\"Au barbecue:\",\"Aplatir la viande, saler et poivrer.\",\"Faire griller la viande à feu vif de chaque côté pendant env. 30 sec.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Saison Été\",\"Suisse\"],\"source\":\"https://fooby.ch/fr/recettes/7792/paillard-de-veau-grille-et-salade-de-tomates\",\"notes\":\"\",\"paprikaUid\":\"22E3453F-4A99-44C3-BAB3-F576B003B691\"},{\"id\":\"osso-buco-et-sa-gremolata-mrryzelbjfb\",\"title\":\"Osso buco et sa Gremolata\",\"category\":\"Italie\",\"time\":150,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"u\"],[\"d’ail\",2,\"u gousse\"],[\"carotte\",1,\"u\"],[\"céleri-branche\",1,\"u\"],[\"cerise\",400,\"g tomate\"],[\"plat\",1,\"u bouquet persil\"],[\"citron\",1,\"u\"],[\"blanche\",1,\"tbsp farine\"],[\"roux\",1,\"tsp sucre\"],[\"beurre à rôtir\",\"\",\"\"],[\"viande\",2,\"dl bouillon de\"],[\"veau\",4,\"u jarret de\"],[\"blanc\",4,\"dl porto\"],[\"concentré de tomates\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"laurier\",\"\",\"\"],[\"romarin\",\"\",\"\"],[\"fleur de sel\",\"\",\"\"]],\"steps\":[\"Inciser la peau des jarrets de toutes parts et les ficeler éventuellement avec de la ficelle de cuisine sans trop serrer.\",\"Couper les légumes en morceaux.\",\"Faire fondre le beurre de cuisson dans une cocotte.\",\"Y saisir la viande préalablement assaisonnée et saupoudrée de farine, pendant env. 2 min de chaque côté.\",\"Sortir et baisser le feu.\",\"Essuyer la graisse de cuisson et rajouter un peu de beurre.\",\"Dans la même cocotte, faire suer l'ail et l'oignon.\",\"Ajouter le sucre roux et laisser caraméliser.\",\"Ajouter la carotte et le céleri et poursuivre brièvement la cuisson.\",\"Ajouter la feuille de laurier et le romarin.\",\"Ajouter le concentré de tomates dilué dans un peu d'eau.\",\"Mouiller avec le vin et laisser réduire presque entièrement.\",\"Ajouter les tomates-cerises, le bouillon et le sel.\",\"Mélanger.\",\"Ajouter la viande et porter à ébullition.\",\"Couvrir et faire cuire 2-5 h dans le bas du four à 90°.\",\"Retirer le couvercle 15 min. avant la fin de la cuisson.\",\"Avant de servir, sortir le romarin et la feuille de laurier, assaisonner.\",\"Dans une petite casserole, chauffer du beurre jusqu'à ce qu'il brunisse.\",\"Ajouter le persil coupé, le zeste de citron, l'ail et le sel.\",\"Répartir ce mélange sur les jarrets de veau.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\"],\"source\":\"https://fooby.ch/fr/recettes/16315/osso-buco-et-sa-gremolata\",\"notes\":\"\",\"paprikaUid\":\"894049A0-55E0-4E60-8414-089CBAEF165D\"},{\"id\":\"osso-buco-et-ratatouille-d-hiver-mrryzelaw10\",\"title\":\"Osso buco et ratatouille d'hiver\",\"category\":\"Italie\",\"time\":105,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"\"],[\"d’ail\",1,\"gousse\"],[\"céleri-rave\",300,\"g\"],[\"carotte\",200,\"g\"],[\"poireau\",200,\"g\"],[\"plat\",1,\"bouquet persil\"],[\"citron\",0.5,\"\"],[\"huile\",\"\",\"\"],[\"farine\",2,\"c. à soupe\"],[\"tomates\",2,\"c. à soupe concentré de\"],[\"viande\",2,\"dl bouillon de\"],[\"veau\",4,\"jarret de\"],[\"blanc\",2,\"dl vin\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"anis\",0.5,\"c. à café\"],[\"cumin\",0.5,\"c. à café\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Entailler la peau des jarrets sur les côtés tout autour.\",\"Assaisonner les deux faces des jarrets.\",\"Tourner dans la farine.\",\"Bien chauffer l’huile dans une cocotte.\",\"Faire saisir les jarrets par portions env. 2 min sur chaque face.\",\"Retirer.\",\"Faire revenir les oignons et tous les ingrédients, y compris le cumin, dans la cocotte.\",\"Ajouter le concentré de tomates.\",\"Faire suer un court instant.\",\"Mouiller avec le vin et le bouillon et porter à ébullition.\",\"Ajouter à nouveau les jarrets.\",\"Faire braiser à couvert et sur feu doux env. 1 h et quart.\",\"Assaisonner.\",\"Mélanger le persil et le zeste de citron, saler.\",\"Parsemer la gremolata sur l’osso buco.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Saison Hiver\"],\"source\":\"https://fooby.ch/fr/recettes/6409/osso-buco-et-ratatouille-d-hiver\",\"notes\":\"\",\"paprikaUid\":\"0BCFFA93-4A58-43C5-A0EC-71F5ED9310DD\"},{\"id\":\"osso-buco-de-porc-a-l-autocuiseur-mrryzel99x5\",\"title\":\"Osso buco de porc à l'autocuiseur\",\"category\":\"Cocotte\",\"time\":105,\"servings\":6,\"ingredients\":[[\"2,5 cm d’épaisseur\",6,\"tranche jarrets de porc de\"],[\"d’olive\",30,\"ml huile\"],[\"oignon, haché finement\",1,\"\"],[\"céleri, hachées\",2,\"branches\"],[\"carottes, hachées\",2,\"\"],[\"d’ail, hachées\",3,\"gousses\"],[\"blanchie\",30,\"ml farine tout usage non\"],[\"vin blanc sec\",125,\"ml\"],[\"fond de veau\",250,\"ml\"],[\"tomates\",60,\"ml concentré de\"],[\"frais\",1,\"branche thym\"],[\"citrons, le zeste râpé finement\",2,\"\"],[\"persil plat ciselé\",10,\"g\"],[\"d’ail, hachée très finement\",1,\"gousse\"]],\"steps\":[\"Osso buco:\",\"Préchauffer le récipient de l’autocuiseur à la fonction sauté 2 minutes.\",\"Y dorer les tranches de jarrets dans l’huile de chaque côté.\",\"Saler et poivrer.\",\"Réserver sur une assiette.\",\"Dans l’autocuiseur, attendrir les légumes.\",\"Ajouter de l’huile au besoin.\",\"Ajouter la farine et poursuivre la cuisson 2 minutes en remuant.\",\"Déglacer avec le vin et cuire 1 minute.\",\"Remettre la viande et ajouter le reste des ingrédients.\",\"Bien mélanger.\",\"Saler et poivrer.\",\"Couvrir et sélectionner la fonction viande .\",\"Régler le temps de cuisson à 45 minutes.\",\"Dépressuriser l’appareil naturellement (environ 15 minutes).\",\"Retirer le couvercle.\",\"Rectifier l’assaisonnement.\",\"Gremolata:\",\"Entre-temps, dans un bol, mélanger tous les ingrédients.\",\"Au moment de servir, parsemer la viande de la gremolata.\",\"Accompagner de nouilles aux œufs au beurre, si désiré.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Cocotte\",\"Plat principal\"],\"source\":\"https://www.ricardocuisine.com/recettes/8551-osso-buco-de-porc-a-l-autocuiseur\",\"notes\":\"\",\"paprikaUid\":\"3B2E3256-1FD5-4954-A972-9DF4A875EB59\"},{\"id\":\"one-pot-pasta-a-la-courge-mrryzel8kbh\",\"title\":\"One pot pasta à la courge\",\"category\":\"Italie\",\"time\":15,\"servings\":4,\"ingredients\":[[\"courge\",400,\"g purée de\"],[\"(macaroni, p. ex.)\",300,\"g pâtes\"],[\"lait\",7,\"dl\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"muscade\",0.25,\"c. à café noix de\"],[\"râpé\",120,\"g Gruyère\"],[\"haché\",0.5,\"bouquet persil\"]],\"steps\":[\"Mettre tous les ingrédients dans une casserole.\",\"Mélanger un coup et porter à ébullition.\",\"Laisser mijoter env. 10 min en remuant jusqu'à ce que les pâtes soient al dente.\",\"Incorporer le persil et servir.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Pâtes\",\"Végétarien\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2022_FAM2_02/mac-and-cheese-a-la-courge-one-pot-pasta/\",\"notes\":\"\",\"paprikaUid\":\"9A02299A-29C9-44D1-9578-C5CB47424943\"},{\"id\":\"one-pot-pasta-a-l-aubergine-mrryzel7215\",\"title\":\"One pot pasta à l'aubergine\",\"category\":\"Italie\",\"time\":25,\"servings\":4,\"ingredients\":[[\"aubergines\",500,\"g\"],[\"penne\",500,\"g\"],[\"cerises\",500,\"g tomates\"],[\"eau\",8,\"dl\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"mozzarella\",300,\"g\"],[\"basilic\",1,\"u bouquet\"]],\"steps\":[\"Éplucher les aubergines et les tailler en petits dés.\",\"Mélanger dans un grand faitout pâtes, aubergines et tomates avec eau, sel et poivre, porter à ébullition.\",\"Cuire env. 12 min à couvert sur feu moyen en remuant de temps en temps jusqu’à ce que les pâtes soient al dente.\",\"Effilocher la mozzarella, ciseler le basilic.\",\"Incorporer les deux aux pâtes.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Pâtes\",\"Végétarien\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/one-pot-pasta-10006226/\",\"notes\":\"\",\"paprikaUid\":\"FB0574A9-C254-4E37-8F00-87DAECB6A50B\"},{\"id\":\"one-pot-pasta-mrryzel6gez\",\"title\":\"One Pot Pasta\",\"category\":\"Plat principal\",\"time\":25,\"servings\":4,\"ingredients\":[[\"aubergine\",500,\"g\"],[\"tomate cerise\",500,\"g\"],[\"poivron rouge\",2,\"u\"],[\"penne\",400,\"g\"],[\"bouillon de légumes\",1,\"cube\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"pecorino\",200,\"g\"],[\"basilic\",1,\"bouquet\"]],\"steps\":[\"Tailler aubergine, poivron et tomate en petits dés.\",\"Mélanger dans une grande casserole pâtes, poivrons et tomates avec le bouillon.\",\"Saler (légèrement) et poivrer.\",\"Porter à ébullition.\",\"Baisser la température et ajouter les aubergines.\",\"Cuire env. 12 min à couvert en remuant de temps en temps jusqu’à ce que les pâtes soient al dente.\",\"Râper le pecorino.\",\"Ciseler le basilic.\",\"Incorporer les deux aux pâtes.\",\"Servir dans des assiette creuses.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Pâtes\",\"modifié\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"one-pot-orzo-aux-asperges-mrryzel54rs\",\"title\":\"One Pot Orzo aux asperges\",\"category\":\"Asperges\",\"time\":0,\"servings\":2,\"ingredients\":[[\"verte\",0.5,\"u asperge\"],[\"orzo\",250,\"g\"],[\"cerise\",10,\"u tomate\"],[\"rouge\",1,\"u oignon\"],[\"frais\",3,\"tbsp fromage\"],[\"légumes\",6,\"dl bouillon de\"],[\"basilic\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Préchauffer le four à 200°.\",\"Parer les asperges et les couper en morceaux.\",\"Couper les tomates en deux.\",\"Couper l'oignon en brunoise.\",\"Le tour déposer dans un plat allant au four.\",\"Ajouter les orzo et le fromage.\",\"Ajouter le bouillon et bien mélanger.\",\"Enfourner pendant 25 minutes.\",\"Sortir et assaisonner.\",\"Parsemer avec le basilic coupé en lanières.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asperges\",\"Italie\",\"Pâtes\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"EF6A19B0-CF02-47B2-BA3B-CB82700205FC\"},{\"id\":\"omelette-aux-asperges-mrryzel29zj\",\"title\":\"Omelette aux asperges\",\"category\":\"Asperges\",\"time\":0,\"servings\":4,\"ingredients\":[[\"INGRÉDIENTS:\",\"\",\"\"],[\"asperges, bouts épluchés, coupées en deux transversalement\",500,\"g\"],[\"cresson\",50,\"g\"],[\"rôtir\",1,\"c. à soupe beurre à\"],[\"oeufs, battus\",8,\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"mélangées, finement coupées\",1,\"bouquet herbes\"],[\"chèvre\",150,\"g fromage frais de\"]],\"steps\":[\"Faire revenir les asperges pendant env. 10 minutes dans le beurre chaud dans une grande poêle antiadhésive.\",\"Battre les œufs avec les épices et les herbes\",\"Verser dans la poêle et faire prendre à petit feu.\",\"Dresser l’omelette avec le fromage frais et le cresson.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asperges\",\"Plat principal\",\"Saison Printemps\"],\"source\":\"https://www.gemuese.ch/fr/recettes/omelette-aux-asperges?_gl=1*1qqf0cl*_up*MQ..&gclid=EAIaIQobChMItdK7sbK4kQMVepKDBx0SyAWNEAAYASABEgL9oPD_BwE&gbraid=0AAAAA-NhTE5iAnPHfalM4KcSHGDur_dvT\",\"notes\":\"\",\"paprikaUid\":\"7CA07D9C-36E8-49C4-A682-C3DC5A46968B\"},{\"id\":\"oeufs-de-caille-sur-paillasson-rosti-au-cresson-mrryzel1qmf\",\"title\":\"Oeufs de caille sur paillasson Rösti au cresson\",\"category\":\"Déjeuner\",\"time\":30,\"servings\":4,\"ingredients\":[[\"ferme\",250,\"g pommes de terre à chair\"],[\"cresson\",50,\"g\"],[\"beurre à rôtir\",\"\",\"\"],[\"eau\",1,\"l\"],[\"blanc\",3,\"tbsp vinaigre de vin\"],[\"caille\",4,\"œuf de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Cuire les pommes de terre la veille, réserver.\",\"Peler les pommes de terre et les passer à la râpe à röstis dans un grand bol.\",\"Réserver 2 cs du cresson, mélanger le reste avec les pommes de terre, saler, poivrer.\",\"Bien faire chauffer le beurre à rôtir dans une poêle antiadhésive.\",\"Diviser la masse de pommes de terre en 4 portions, façonner des paillassons, aplatir un peu.\",\"Faire revenir env. 7 min sur chaque face sur feu moyen.\",\"Porter l’eau et le vinaigre à ébullition dans une casserole, baisser le feu.\",\"Casser séparément chaque œuf dans une tasse, faire glisser délicatement dans l’eau frémissante.\",\"Laisser pocher env. 1 min au seuil de l’ébullition.\",\"Retirer avec une petite passoire et égoutter.\",\"Dresser sur les paillassons et rectifier l’assaisonnement.\",\"Décorer avec le cresson réservé.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Déjeuner\",\"Plat principal\",\"Suisse\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/uf-de-caille-sur-paillasson-au-cresson-10003290/\",\"notes\":\"\",\"paprikaUid\":\"8C928332-CA2C-46B4-B5B9-B02F50A39AB1\"},{\"id\":\"nouilles-udon-sautees-mrryzel0he6\",\"title\":\"Nouilles Udon sautées\",\"category\":\"Asie\",\"time\":20,\"servings\":2,\"ingredients\":[[\"gingembre\",2,\"cm\"],[\"d'ail\",2,\"gousses\"],[\"mi-fort\",1,\"piment fort ou\"],[\"soja\",3,\"c. à soupe sauce\"],[\"bœuf\",120,\"g émincé de\"],[\"pak-choï\",2,\"\"],[\"(de 200 g)\",2,\"paquets nouilles Udon précuites\"],[\"vert\",1,\"citron\"],[\"sésame\",2,\"c. à soupe huile de\"],[\"maïs\",1,\"c. à café fécule de\"],[\"menthe, selon les goûts\",0.5,\"bouquet persil ou\"]],\"steps\":[\"Hacher fin le gingembre, l'ail et le piment.\",\"Mélanger avec la sauce soja.\",\"Faire mariner la viande quelques instants dans la préparation.\",\"Couper le pak-choi en lanières.\",\"Faire cuire les nouilles dans un grand volume d'eau pendant env. 3 min.\",\"Les détacher avec une fourchette.\",\"Jeter l'eau de cuisson et égoutter.\",\"Exprimer le jus du citron vert.\",\"Faire chauffer l'huile dans un wok.\",\"Sortir la viande de la marinade et la saisir 1-2 min à feu vif en remuant.\",\"Ajouter le pak-choï et les nouilles et poursuivre la cuisson 1 min.\",\"Mélanger la marinade de la viande avec la fécule de maïs.\",\"Allonger avec le jus du citron vert et un peu d'eau et incorporer.\",\"Laisser mijoter encore env. 1 min.\",\"Selon les goûts, servir avec le persil ou la menthe.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Wok\"],\"source\":\"https://migusto.migros.ch/fr/recettes/nouilles-udon-sautees\",\"notes\":\"\",\"paprikaUid\":\"B0285EA4-1718-4F1D-BF5A-7D8C117D0165\"},{\"id\":\"nouilles-shirataki-qux-champignons-mrryzekzrm6\",\"title\":\"Nouilles Shirataki qux champignons\",\"category\":\"Asie\",\"time\":20,\"servings\":4,\"ingredients\":[[\"200 g, cuites et égouttées\",2,\"paquets Shirataki Noodles de\"],[\"shiitaké\",500,\"g champignons\"],[\"nouveaux\",2,\"oignons\"],[\"sésame\",4,\"c. à soupe huile de\"],[\"hoisin\",8,\"c. à soupe sauce\"],[\"foncée\",6,\"c. à soupe sauce de soja\"],[\"ciboulette\",2,\"bottes\"]],\"steps\":[\"Bien rincer les vermicelles sous l'eau froide puis les faire cuire 1 min dans de l'eau bouillante.\",\"Les égoutter.\",\"Couper les champignons et les oignons nouveaux en lanières.\",\"Les faire revenir env. 2 min dans l'huile de sésame.\",\"Mélanger la sauce hoisin et la sauce soja.\",\"En arroser les légumes.\",\"Ajouter les vermicelles et réchauffer.\",\"Ciseler la ciboulette sur le mets.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Wok\"],\"source\":\"https://migusto.migros.ch/fr/recettes/nouilles-shirataki-aux-champignons\",\"notes\":\"\",\"paprikaUid\":\"234211E5-E041-4AE8-B015-0BA4F12FB8B6\"},{\"id\":\"nouilles-sautees-avec-poulet-et-poivron-mrryzeky9hp\",\"title\":\"Nouilles sautées avec poulet et poivron\",\"category\":\"Asie\",\"time\":25,\"servings\":4,\"ingredients\":[[\"nouilles\",300,\"g\"],[\"sel\",\"\",\"\"],[\"oignons\",2,\"\"],[\"verts\",4,\"poivrons rouges et\"],[\"d’arachide\",4,\"c. à soupe huile\"],[\"poulet\",300,\"g émincé de\"],[\"curcuma\",1,\"c. à soupe\"],[\"doux\",1,\"c. à soupe curry\"],[\"oelek\",1,\"c. à café sambal\"],[\"réduite\",1,\"c. à soupe sauce soja douce ou à teneur en sel\"],[\"poule\",2,\"dl bouillon de\"]],\"steps\":[\"Cuire les nouilles al dente env. 5 min dans un grand volume d’eau salée.\",\"Les rincer sous l’eau froide et les égoutter.\",\"Hacher les oignons.\",\"Partager en deux les poivrons, les épépiner.\",\"Les couper en menus morceaux.\",\"Chauffer l’huile dans un wok.\",\"Saisir les poivrons.\",\"Ajouter les oignons et le poulet.\",\"Poursuivre brièvement la cuisson à feu vif.\",\"Réduire la chaleur et incorporer le curcuma, le curry, le sambal oelek et la sauce soja.\",\"Verser le bouillon et faire mijoter quelques instants, jusqu’à ce que le poulet soit cuit et les légumes encore fermes.\",\"Ajouter les nouilles et poursuivre un court instant la cuisson.\",\"Assaisonner de sambal oelek.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Poulet\",\"Wok\"],\"source\":\"https://migusto.migros.ch/fr/recettes/nouilles-sautees-avec-poulet-et-poivron\",\"notes\":\"\",\"paprikaUid\":\"C7570A84-6C17-4EF5-87F9-B6A9ED4CE721\"},{\"id\":\"nouilles-aux-boulettes-et-aux-legumes-thai-mrryzekyfnu\",\"title\":\"Nouilles aux boulettes et aux légumes thaï\",\"category\":\"Asie\",\"time\":20,\"servings\":4,\"ingredients\":[[\"boulettes\",300,\"g\"],[\"thaï\",700,\"g légumes\"],[\"oignons\",1,\"botte jeunes\"],[\"riz\",250,\"g nouilles de\"],[\"Curry\",6,\"c. à soupe sauce wok Mild\"],[\"riz\",2,\"c. à soupe huile de\"],[\"sel\",\"\",\"\"]],\"steps\":[\"Faites cuire les nouilles dans de l’eau bouillante légèrement salée.\",\"Égouttez.\",\"Entre-temps, émincez les jeunes oignons.\",\"Faites chauffer la moitié de l’huile de riz dans le wok.\",\"Faites-y revenir les légumes thaï 2 min.\",\"Réservez hors du wok.\",\"Faites chauffer le reste de l’huile dans le wok et faites-y dorer les boulettes 5 min.\",\"Ajoutez les légumes, les nouilles et la sauce wok.\",\"Mélangez bien le tout.\",\"Répartissez la préparation sur les assiettes et décorez de jeunes oignons.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Wok\"],\"source\":\"https://www.colruyt.be/fr/recettes/nouilles-aux-boulettes-vegetales-et-aux-legumes-thai\",\"notes\":\"\",\"paprikaUid\":\"58E5A3CC-8F59-4172-9D18-6EA76C7C49DF\"},{\"id\":\"nouilles-asiatiques-a-l-aigre-doux-mrryzekwzvd\",\"title\":\"Nouilles asiatiques à l'aigre-doux\",\"category\":\"Asie\",\"time\":20,\"servings\":4,\"ingredients\":[[\"noodles\",250,\"g mie\"],[\"sel\",\"\",\"\"],[\"rouge\",1,\"oignon\"],[\"huile\",3,\"c. à soupe\"],[\"200 g\",2,\"sachets mélange de légumes à la chinoise de\"],[\"d'ananas\",200,\"g dés\"],[\"verts\",2,\"citrons\"],[\"piments\",150,\"g sauce douce aux\"],[\"soja\",3,\"c. à soupe sauce\"]],\"steps\":[\"Cuire les nouilles al dente, soit env. 3 min, dans un grand volume d'eau salée.\",\"Les rafraîchir sous l'eau froide et égoutter.\",\"Détailler l'oignon en lamelles.\",\"Chauffer l'huile dans un wok, ou dans une grande poêle.\",\"Y faire sauter les légumes et l'oignon env. 4 min et saler.\",\"Couper les dés d'ananas en deux.\",\"Exprimer le jus de la moitié des citrons verts, couper le reste en quartiers.\",\"Mettre les nouilles et l'ananas dans le wok avec le jus de citron vert et la sauce aux piments.\",\"Bien mélanger et faire chauffer.\",\"Relever de sauce soja.\",\"Servir avec les quartiers de citron vert.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Wok\"],\"source\":\"https://migusto.migros.ch/fr/recettes/nouilles-asiatiques-a-laigre-doux\",\"notes\":\"\",\"paprikaUid\":\"DF9129BF-A0D7-4250-A161-7B8AFD11A0CF\"},{\"id\":\"nasi-goreng-mrryzekwupb\",\"title\":\"Nasi Goreng\",\"category\":\"Asie\",\"time\":45,\"servings\":4,\"ingredients\":[[\"jasmin\",300,\"g riz\"],[\"nouveaux\",1,\"u botte oignons\"],[\"carotte\",1,\"u\"],[\"frais\",2,\"u œuf\"],[\"d'ail\",4,\"u gousse\"],[\"échalote\",4,\"u\"],[\"fort\",2,\"u piment\"],[\"huile\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"hoisin\",1,\"tbsp sauce\"],[\"oignon\",1,\"\"]],\"steps\":[\"Rincer soigneusement le riz sous l’eau courante froide, puis l’égoutter.\",\"Porter l’eau à ébullition.\",\"Ajouter le riz et ramener brièvement à ébullition.\",\"Éteindre le feu et remuer brièvement.\",\"Couvrir et laisser gonfler env. 15 min sur la plaque éteinte.\",\"Défaire le riz à la fourchette.\",\"Détailler les oignons nouveaux en fines rondelles et en réserver un tiers pour la finition.\",\"Couper la carotte en julienne.\",\"Battre les œufs.\",\"Broyer l’ail, les échalotes et les piments dans un robot ménager jusqu’à obtention d’une pâte.\",\"Chauffer l’huile dans un wok et faire revenir la pâte env. 2 min.\",\"La pousser sur un côté de la poêle.\",\"Ajouter les œufs battus et faire prendre en remuant de temps à autre.\",\"Ajouter le riz, les oignons nouveaux et la julienne de carotte.\",\"Rissoler env. 3 min en remuant de temps en temps.\",\"Relever de sel et de sauce hoisin.\",\"Dresser le riz.\",\"Garnir avec des oignons rissolés et les oignons nouveaux réservés.\",\"Idéal avec un œuf au plat.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Végétarien\",\"Wok\"],\"source\":\"https://migusto.migros.ch/fr/recettes/nasi-goreng\",\"notes\":\"\",\"paprikaUid\":\"6C33209F-2570-4DE1-8802-0B7C0F1AA5E6\"},{\"id\":\"medaillons-de-porc-sauce-aux-morilles-mrryzekvfbk\",\"title\":\"Médaillons De Porc, Sauce Aux Morilles\",\"category\":\"A\",\"time\":30,\"servings\":4,\"ingredients\":[[\"séchées\",20,\"g de morilles\"],[\"échalotes\",2,\"\"],[\"plat\",0.5,\"bouquet de persil\"],[\"beurre à rôtir\",\"\",\"\"],[\"entière\",2,\"dl de crème\"],[\"viande\",2,\"dl de bouillon de\"],[\"(p.ex. Noilly Prat)\",0.5,\"dl de vermouth blanc sec\"],[\"porc\",12,\"médaillons de\"],[\"rôtir\",12,\"tranche de lard à\"],[\"sel\",1,\"de cc de\"],[\"un peu de poivre\",\"\",\"\"],[\"sel, poivre, selon le goût\",\"\",\"\"]],\"steps\":[\"Préchauffer le four à 60° C, y glisser un plat et des assiettes. Entourer les médaillons avec le lard, saler, poivrer, saisir par portions env. 21/2 min sur chaque face dans un peu de beurre à rôtir bien chaud, retirer, réserver au chaud. Eponger le fond de la poêle, rajouter évent. un peu de beurre à rôtir.\",\"Bien laver les morilles, égoutter, couper en deux. Hacher finement les échalotes, faire revenir ensemble. Mouiller avec le vermouth, faire réduire presque complètement. Verser le bouillon et 1 dl de crème, laisser bouillonner env. 10 min, saler, poivrer.\",\"Fouetter légèrement le reste de la crème, ajouter, dresser avec la viande, répartir le persil dessus.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"A\"],\"source\":\"https://fooby.ch/fr/recettes/11804/medaillons-de-porc--sauce-aux-morilles\",\"notes\":\"\",\"paprikaUid\":\"72D90428-9D9E-46B2-8DD9-14DB3BEDD1D6\"},{\"id\":\"medaillons-de-porc-en-manteau-de-jambon-cru-mrryzekuwsy\",\"title\":\"Médaillons de porc en manteau de jambon cru\",\"category\":\"Plat principal\",\"time\":45,\"servings\":4,\"ingredients\":[[\"moelleux\",8,\"abricots secs\"],[\"échalotes\",1,\"\"],[\"plat\",0.25,\"bouquet de persil\"],[\"huile\",1,\"c. à soupe\"],[\"tranches\",150,\"g fromage à raclette en\"],[\"demi-crème pour sauces\",2,\"dl\"],[\"beurre\",2,\"c. à soupe\"],[\"tagliatelles\",400,\"g pâtes\"],[\"porc\",500,\"g filets mignons de\"],[\"tranches\",130,\"g jambon cru en\"],[\"blanc\",0.5,\"dl vin\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"cayenne\",2,\"pincée poivre de\"]],\"steps\":[\"Assaisonner la viande.\",\"Replier le jambon cru dans la longueur.\",\"Barder chaque médaillon de deux tranches de jambon.\",\"Faire chauffer l'huile dans une poêle.\",\"Faire revenir les médaillons de toutes parts pendant 4 min.\",\"Les sortir et les mettre dans le moule.\",\"Répartir les abricots et le fromage dessus.\",\"Mettre l'échalote dans la même poêle.\",\"Faire revenir pendant 2 min.\",\"Mouiller avec le vin, laisser réduire de moitié.\",\"Ajouter la demi-crème pour sauces, porter à ébullition.\",\"Ajouter le persil et assaisonner.\",\"Verser la sauce dans le moule.\",\"Faire cuire env. 15 min au milieu du four préchauffé à 180 °C.\",\"Retirer du four.\",\"Faire cuire les pâtes al dente dans l'eau salée, les égoutter.\",\"Ajouter le beurre et mélanger délicatement.\",\"Servir avec les médaillons de porc.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Pâtes\",\"Suisse\"],\"source\":\"https://fooby.ch/fr/recettes/24638/medaillons-de-porc-en-manteau-de-jambon-cru\",\"notes\":\"\",\"paprikaUid\":\"0A2CEA22-82A5-4740-A950-5697A4F34321\"},{\"id\":\"muffins-pommes-et-carottes-mrryzektx1v\",\"title\":\"Muffins pommes et carottes\",\"category\":\"Déjeuner\",\"time\":50,\"servings\":12,\"ingredients\":[[\"multicéréales\",250,\"g farine\"],[\"d'avoine\",100,\"g flocon\"],[\"moulues\",50,\"g noisette\"],[\"sucre\",4,\"c. à soupe\"],[\"lever\",3,\"tsp poudre à\"],[\"sel\",\"\",\"\"],[\"cannelle\",\"\",\"\"],[\"pomme\",100,\"g\"],[\"carotte\",100,\"g\"],[\"lait\",2,\"dl\"],[\"œuf\",2,\"\"],[\"maigre\",250,\"g séré\"],[\"séchées\",50,\"g rondelles de pommes\"],[\"fruits\",50,\"g petits\"]],\"steps\":[\"Préchauffer le four à 180°C (chaleur tournante: 160°C).\",\"Râper finement les pommes et les carottes.\",\"Hâcher grossièrement les pommes séchées et/ou les petits fruits frais.\",\"Mélanger tous les ingrédients jusqu'au séré maigre inclus jusqu'à l'obtention d'une pâte lisse.\",\"Incorporer les pommes séchées et/ou les petits fruits frais.\",\"Verser la pâte dans les moules à muffins.\",\"Cuire les muffins au milieu du four chaud 30-35 min. jusqu'à ce qu'une croûte dorée se forme (petits muffins 20-25 min.).\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Déjeuner\",\"Snack\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2021_EKRE_01/muffins-pommes-carottes-pour-le-petit-dejeuner/\",\"notes\":\"\",\"paprikaUid\":\"C6E33897-A236-4886-8CB6-289E850CA788\"},{\"id\":\"moussaka-vegetarienne-mrryzeks343\",\"title\":\"Moussaka végétarienne\",\"category\":\"Plat principal\",\"time\":70,\"servings\":4,\"ingredients\":[[\"Garniture:\",\"\",\"\"],[\"haché\",1,\"oignon finement\"],[\"d'ail pressée\",1,\"gousse\"],[\"beurre pour faire revenir\",\"\",\"\"],[\"dés\",150,\"g carottes coupées en petits\"],[\"céleri-branche coupé en fines tranches\",100,\"g\"],[\"corail\",100,\"g lentilles\"],[\"2½ dl bouillon de légumes\",\"\",\"\"],[\"pelées\",400,\"g tomates coupées en dés ou de tomates\"],[\"surgelés\",200,\"g petits pois frais ou\"],[\"ciselé\",4,\"c. à soupe basilic finement\"],[\"thym\",1,\"c. à soupe feuilles de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"Sauce:\",\"\",\"\"],[\"lait\",5,\"dl de\"],[\"farine\",3,\"c. à soupe de\"],[\"beurre\",50,\"g de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"noix de muscade\",\"\",\"\"],[\"râpé\",100,\"g de Sbrinz\"],[\"d'aubergines coupées en fines rondelles (3 mm)\",600,\"g\"],[\"grossièrement\",300,\"g de mozzarella coupée\"]],\"steps\":[\"Garniture:\",\"Faire revenir l'oignon et l'ail dans le beurre.\",\"Ajouter les carottes et le céleri.\",\"Ajouter les lentilles.\",\"Mouiller avec le bouillon et laisser mijoter 10-15 min.\",\"Ajouter les tomates, les petits pois, le basilic et le thym.\",\"Porter à ébullition.\",\"Saler, poivrer.\",\"Sauce:\",\"Bien mélanger le lait et la farine au fouet.\",\"Ajouter le beurre.\",\"Porter à ébullition en remuant constamment.\",\"Ajouter le fromage.\",\"Assaisonner.\",\"Former la moussaka:\",\"Commencer par la garniture.\",\"Disposer en couches successives dans le plat la garniture, les aubergines et la mozzarella.\",\"Terminer avec la sauce.\",\"Parsemer de fromage.\",\"Cuire 35-40 min au milieu du four préchauffé à 200°C chaleur tournante (chaleur traditionnelle: 220°C).\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Végétarien\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM20160708_24/moussaka-vegetarienne/\",\"notes\":\"\",\"paprikaUid\":\"65982EE7-2C67-44F1-8B50-D87891A0BB94\"},{\"id\":\"moelleux-au-chocolat-a-l-autocuiseur-mrryzekrxqt\",\"title\":\"Moelleux au chocolat à l'autocuiseur\",\"category\":\"Cocotte\",\"time\":8,\"servings\":4,\"ingredients\":[[\"70% coupé en morceaux\",150,\"g chocolat noir\"],[\"beurre\",125,\"ml\"],[\"(2 entiers + 2 jaunes)\",4,\"oeufs\"],[\"sucre\",125,\"ml\"],[\"café\",30,\"ml liqueur de\"],[\"vanille\",5,\"ml extrait de\"],[\"farine\",80,\"ml\"],[\"sel\",\"\",\"\"]],\"steps\":[\"Dans l’autocuiseur, déposer la grille à cuisson vapeur, puis verser 500 ml (2 tasses) d’eau.\",\"Dans un bain-marie, faire fondre le chocolat avec le beurre.\",\"Remuer jusqu’à l’obtention d’une préparation lisse.\",\"À l’aide du batteur électrique, fouetter les oeufs entiers avec les jaunes d’oeufs, le sucre, la liqueur de café et la vanille dans un bol jusqu’à ce que le mélange pâlisse.\",\"Incorporer la farine et le sel à la préparation aux oeufs en fouettant.\",\"Ajouter le chocolat fondu et remuer jusqu’à l’obtention d’une préparation homogène.\",\"Beurrer quatre ramequins étroits d’une capacité de 250 ml (1 tasse) chacun\",\"Y répartir la pâte.\",\"Couvrir chaque ramequin de papier d’aluminium.\",\"Déposer les ramequins sur la grille.\",\"Fermer hermétiquement l’autocuiseur en tournant le couvercle.\",\"Appuyer sur la touche « Pressure cooking » et cuire 8 minutes à haute pression (« High »).\",\"Une fois la cuisson terminée, évacuer la pression rapidement.\",\"Retirer les ramequins de l’autocuiseur à l’aide de pinces.\",\"Servir aussitôt.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Cocotte\",\"Dessert\"],\"source\":\"https://www.pratico-pratiques.com/galeries-thematiques/moelleux-au-chocolat-a-lautocuiseur/?gallery=pp-9097\",\"notes\":\"\",\"paprikaUid\":\"E5B51F02-FCAB-424C-B85E-06A6DD91605A\"},{\"id\":\"minestrone-aux-legumes-racines-mrryzekq0ol\",\"title\":\"Minestrone aux légumes-racines\",\"category\":\"Saison Printemps\",\"time\":60,\"servings\":4,\"ingredients\":[[\"séché\",15,\"g bolet\"],[\"oignon\",2,\"u\"],[\"d’ail\",2,\"u gousse\"],[\"terre\",200,\"g pomme de\"],[\"carotte\",200,\"g\"],[\"panais\",200,\"g\"],[\"céleri-rave\",200,\"g\"],[\"d'olive\",2,\"tbsp huile\"],[\"cornette\",100,\"g\"],[\"tomates\",2,\"tbsp concentré de\"],[\"1½ l bouillon de légumes\",\"\",\"\"],[\"chiche\",1,\"u boîte pois\"],[\"laurier\",1,\"u feuille\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Peler les légumes et les couper en dés.\",\"Hâcher finement l'oignon et l'ail.\",\"Tremper les bolets.\",\"Faire chauffer l'huile dans une grande casserole.\",\"Faire suer les oignons, l'ail, les pommes de terre, les carottes, les panais et le céleri pendant env. 5 min.\",\"Ajouter le concentré de tomates et les bolets.\",\"Faire revenir brièvement le tout.\",\"Ajouter le bouillon et porter à ébullition, puis baisser le feu.\",\"Ajouter le laurier.\",\"Couvrir et laisser mijoter env. 40 min.\",\"Ajouter les pois chiches et les cornettes.\",\"Poursuivre la cuisson à couvert jusqu'à ce que les cornettes soient al dente.\",\"Assaisonner.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Saison Printemps\",\"Saison Été\",\"Soupe\"],\"source\":\"https://fooby.ch/fr/recettes/21583/minestrone-aux-legumes-racines\",\"notes\":\"\",\"paprikaUid\":\"3FC28BD5-4E2A-406F-A965-0E25A7F1959C\"},{\"id\":\"mijote-de-porc-aux-fruits-secs-mrryzekqkjh\",\"title\":\"Mijoté de porc aux fruits secs\",\"category\":\"Cocotte\",\"time\":35,\"servings\":4,\"ingredients\":[[\"mignon\",600,\"g filet\"],[\"secs\",8,\"abricots\"],[\"mondées\",50,\"g pistaches nature\"],[\"secs\",50,\"g raisins\"],[\"volaille\",60,\"cl bouillon de\"],[\"cannelle\",0.5,\"c. à café\"],[\"cumin\",0.5,\"c. à café\"],[\"oignons\",2,\"\"],[\"miel\",2,\"c. à soupe\"],[\"d’olive\",4,\"c. à soupe huile\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Dans une cocotte, faites revenir 5 min les oignons pelés et émincés avec la moitié de l’huile.\",\"Retirez de la cocotte et faites dorer à la place le filet mignon coupé en morceaux avec le reste d’huile d’olive.\",\"Saupoudrez les épices.\",\"Salez et poivrez.\",\"Remettez les oignons dans la cocotte.\",\"Ajoutez les fruits secs et le miel.\",\"Mouillez avec le bouillon de volaille et faites mijoter 20 min à couvert.\",\"Servez le filet mignon bien chaud accompagné de pommes de terre vapeur ou de pâtes.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Cocotte\",\"Plat principal\"],\"source\":\"https://www.cuisineactuelle.fr/recettes/mijote-de-porc-aux-fruits-secs-245931?_gl=1*1656uqm*_gcl_aw*R0NMLjE3NjY4NjcxNjkuRUFJYUlRb2JDaE1JeXNDMzM4emVrUU1WS1pPREJ4MTNCeUY2RUFBWUFTQUFFZ0l0V19EX0J3RQ..*_ga*MTAyNDA0ODM1MS4xNzY2ODY3MDc4*_ga_5NSPQRQDQY*czE3NjY4NjcwNzgkbzEkZzEkdDE3NjY4NjcxNzEkajU2JGwwJGgw\",\"notes\":\"\",\"paprikaUid\":\"6D0A8741-BC9E-4A79-A333-58074D764BB5\"},{\"id\":\"matafan-a-la-rhubarbe-mrryzekpc55\",\"title\":\"Matafan à la rhubarbe\",\"category\":\"Plat principal\",\"time\":55,\"servings\":4,\"ingredients\":[[\"toast, coupé en tranches de 1 cm d'épaisseur\",220,\"g de pain blanc ou de pain\"],[\"lait\",2,\"dl de\"],[\"Liaison:\",\"\",\"\"],[\"lait\",3,\"dl de\"],[\"farine\",50,\"g de\"],[\"d'œufs\",2,\"jaunes\"],[\"sel\",1,\"pincée de\"],[\"sucre\",3,\"c. à soupe de\"],[\"citron, zeste\",0.5,\"\"],[\"d'œufs, battus en neige\",2,\"blancs\"],[\"beurre, froid, coupés en petits morceaux\",50,\"g de\"],[\"sucre\",\"\",\"\"],[\"Compote à la rhubarbe:\",\"\",\"\"],[\"d'eau\",1,\"dl\"],[\"sucre\",100,\"g de\"],[\"vanille, fendu\",0.5,\"bâton de\"],[\"rhubarbe, coupée en deux dans le sens de la longueur, puis en morceaux\",500,\"g de\"]],\"steps\":[\"Placer les tranches de pain dans un bol.\",\"Verser le lait par dessus.\",\"Laisser pomper 15 minutes.\",\"Egoutter le pain.\",\"Placer dans le plat préalablement beurré.\",\"Liaison:\",\"Mélanger le lait, la farine, les jaunes d'œufs, le sel, le sucre et le citron.\",\"Incorporer délicatement les blancs en neige.\",\"Répartir la liaison sur le pain.\",\"Parsemer de morceaux de beurre.\",\"Dorer 30-40 minutes dans le tiers inférieur du four préchauffé à 180 °C.\",\"Compote:\",\"Porter à ébullition l'eau avec le sucre et le bâton de vanille.\",\"Ajouter la rhubarbe.\",\"Cuire puis laisser refroidir.\",\"Oter le bâton de vanille.\",\"Couper le matafan en tranches alors qu'il est encore chaud.\",\"Servir sur des assiettes à dessert.\",\"Saupoudrer de sucre.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Suisse\",\"Végétarien\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM200002_33_MEN002B032B/matafan/\",\"notes\":\"\",\"paprikaUid\":\"2C884759-2522-4B91-A757-35916B5D9646\"},{\"id\":\"matafan-aux-fraises-mrryzekol4k\",\"title\":\"Matafan aux fraises\",\"category\":\"Dessert\",\"time\":35,\"servings\":4,\"ingredients\":[[\"fraises\",200,\"g\"],[\"sucre\",2,\"c. à soupe\"],[\"mi-blanche\",150,\"g farine\"],[\"lever\",1,\"c. à café poudre à\"],[\"sucre glace\",\"\",\"\"],[\"d'œufs frais\",3,\"jaunes\"],[\"ricotta\",250,\"g\"],[\"2½ dl lait\",\"\",\"\"],[\"d'œufs frais\",3,\"blancs\"],[\"beurre\",1,\"c. à soupe\"],[\"sel\",1,\"pincée\"]],\"steps\":[\"Préchauffer le four et le moule à 220 °C.\",\"Bien mélanger au batteur électrique les jaunes d'œuf, le sucre, la ricotta et le lait.\",\"Mélanger la farine avec la poudre à lever, l'incorporer au mélange précédent.\",\"Monter les blancs en neige ferme avec un peu de sel et les incorporer délicatement au reste avec une spatule en caoutchouc.\",\"Retirer le moule du four, ajouter le beurre, le laisser fondre.\",\"Verser la pâte dans le moule et répartir les fraises dessus.\",\"Faire cuire le matefaim env. 15 min au milieu du four.\",\"Le sortir du four, le laisser refroidir puis le saupoudrer de sucre glace.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Dessert\",\"Suisse\"],\"source\":\"https://fooby.ch/fr/recettes/26834/matefaim-aux-fraises-au-four\",\"notes\":\"\",\"paprikaUid\":\"160AB640-9719-40E3-83BC-90B9E4BD93A1\"},{\"id\":\"mandoo-guk-ravioli-coreens-mrryzeknafa\",\"title\":\"Mandoo-Guk (Ravioli coréens)\",\"category\":\"Corée\",\"time\":55,\"servings\":4,\"ingredients\":[[\"ravioles\",1,\"paquet pâte à\"],[\"volaille\",50,\"cl bouillon de\"],[\"soja\",5,\"cl sauce\"],[\"cébette\",2,\"tiges\"],[\"Farce:\",\"\",\"\"],[\"sautés\",30,\"g shitakés\"],[\"kimchi\",30,\"g\"],[\"nouveaux\",50,\"g oignons\"],[\"tofu\",100,\"g\"],[\"ail\",10,\"g\"],[\"haché\",200,\"g porc\"],[\"soja\",1,\"c. à café sauce\"],[\"oeuf\",0.5,\"\"],[\"gochugaru\",5,\"g\"]],\"steps\":[\"Préparez la farce. Taillez les shitakés, le kimchee et le vert de l’oignon nouveau en petits cubes.\",\"Écrasez le tofu à la fourchette, hachez l’ail, puis mélangez tous les ingrédients de la farce.\",\"Placez une petite boule de farce (15 g) au centre de la pâte à ravioles. Humectez le bord de la pâte avec un peu d’eau. Puis repliez-la sur elle-même en forme de demi-lune, placez votre index au centre de la raviole et repliez-la à nouveau sur elle-même pour former le mandoo. Collez les deux extrémités avec un peu d’eau en exerçant une pression suffisante.\",\"Faites chauffer le bouillon de volaille, assaisonnez-le de sauce soja.\",\"Portez à ébullition un grand volume d’eau dans une casserole. Faites cuire les mandoos jusqu’à ce qu’ils remontent à la surface. Égouttez-les et placez-les ensuite dans une assiette creuse, versez le bouillon assaisonné tout autour. Parsemez de cébette émincée.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Corée\",\"Soupe\"],\"source\":\"https://www.elle.fr/Elle-a-Table/Recettes-de-cuisine/Mandoo-guk-3929805\",\"notes\":\"\",\"paprikaUid\":\"FDC15C1C-4678-44A2-9D53-727A0B2713B6\"},{\"id\":\"mah-mee-mrryzekk0zv\",\"title\":\"Mah Mee\",\"category\":\"Asie\",\"time\":35,\"servings\":4,\"ingredients\":[[\"poulet\",400,\"g émincé de\"],[\"beurre à rôtir\",\"\",\"\"],[\"oignon\",1,\"u\"],[\"vert\",1,\"u poivron\"],[\"rouge\",1,\"u poivron\"],[\"iceberg\",0.5,\"u\"],[\"d'ail\",1,\"u gousse\"],[\"sel\",\"\",\"\"],[\"curry\",\"\",\"\"],[\"soja\",2,\"tbsp sauce\"],[\"bouillon\",1,\"dl\"],[\"fine\",300,\"g nouille\"],[\"jambon\",2,\"u tranche\"]],\"steps\":[\"Cuire les nouilles et réserver.\",\"Saisir le poulet dans le beurre à rôtir et réserver.\",\"Couper le jambon en lamelles, rôtir et réserver.\",\"Hacher l'oignon et l'ail.\",\"Couper les poivrons en dés.\",\"Couper la salade en lamelles.\",\"Dans la même poêle, faire revenir l'oignon et les poivrons.\",\"Ajouter la salade et l'ail, cuire jusqu'à ce que la salade tombe.\",\"Ajouter le poulet.\",\"Assaisonner, mouiller avec le bouillon.\",\"Ajouter les nouilles.\",\"Mélanger, rectifier l'assaisonnement.\",\"Dresser, ajouter le jambon rôti.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Plat principal\",\"Poulet\",\"Wok\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/KO2022_SBLV_41/mah-mee/?collection=267387\",\"notes\":\"\",\"paprikaUid\":\"CB57EB0E-B72D-49B9-B17E-E8ACB58C1A09\"},{\"id\":\"magret-de-canard-facon-hanoi-mrryzekkobs\",\"title\":\"Magret de canard façon Hanoï\",\"category\":\"Asie\",\"time\":0,\"servings\":4,\"ingredients\":[[\"canard\",2,\"u magret de\"],[\"Hanoï\",4,\"tbsp mélange\"],[\"soja\",2,\"tbsp sauce\"],[\"Vermouth\",1,\"tbsp vinaigre Jerez ou\"],[\"blanc\",1,\"dl vin\"],[\"légume de saison\",\"\",\"\"],[\"huile d'olive\",\"\",\"\"],[\"terre\",400,\"g pomme de\"]],\"steps\":[\"Préparer la veille :\",\"Entailler la couche de gras des magrets en losange.\",\"Mélanger les épices Hanoï, la sauce soja et le vinaigre. Badigeonnez généreusement les magrets de cette marinade.\",\"Mettre les magrets marinés sous-vide et laisser tirer au frigo une nuit (3 heures minimum).\",\"Le jour-même :\",\"Éplucher les pommes de terre et les couper en grands cubes.\",\"Les cuire dans de l'eau salée.\",\"Rôtir les magrets dans une poêle à feu doux sur le gras environ 15 minutes.\",\"Préparer les légumes et les couper en diagonale.\",\"Égoutter les pommes de terre et les sécher sur un linge.\",\"Retourner les magrets et finir la cuisson pendant 5 minutes.\",\"Rôtir les pommes de terre dans l'air-fryer.\",\"Sortir les magrets et les laisser reposer 5-10 minutes dans un papier d'aluminium.\",\"Ajouter les légumes et les faire sauter qqes minutes.\",\"Réserver.\",\"Pour la sauce, ajouter le reste de la marinade.\",\"Déglacer au vin blanc et laisser réduire.\",\"Couper les magrets en tranches.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\"],\"source\":\"https://www.poivre.ch/recette/magret-de-canard-au-melange-hanoi/\",\"notes\":\"\",\"paprikaUid\":\"111F0ACE-207E-4C09-B0AB-2D08414E8460\"},{\"id\":\"macaronis-du-chalet-mrryzekj1z1\",\"title\":\"Macaronis du chalet\",\"category\":\"Plat principal\",\"time\":40,\"servings\":4,\"ingredients\":[[\"oignon\",2,\"u\"],[\"farine\",0.5,\"c. à soupe\"],[\"colza\",2,\"tbsp huile de\"],[\"beurre\",1,\"c. à soupe\"],[\"ferme\",250,\"g pomme de terre\"],[\"sel\",\"\",\"\"],[\"macaroni\",350,\"g\"],[\"gruyère\",200,\"g\"],[\"demi-crème\",2,\"dl\"],[\"poivre\",\"\",\"\"],[\"persil\",\"\",\"\"]],\"steps\":[\"Couper les oignons en fines rondelles.\",\"Les saupoudrer de farine et bien mélanger.\",\"Chauffer l’huile et le beurre dans une poêle.\",\"Y faire croustiller les oignons durant env. 10 min à feu moyen.\",\"Les retirer et les laisser égoutter sur du papier absorbant.\",\"Débiter les pommes de terre en gros cubes.\",\"Cuire 5 min dans un grand volume d’eau salée.\",\"Ajouter les macaronis et poursuivre la cuisson 8-10 min jusqu’à ce que le tout soit à peine tendre.\",\"Egoutter et remettre le tout dans la casserole.\",\"Couper le Gruyère en dés et ajouter aux pâtes avec la crème.\",\"Laisser reposer à couvert sur le feu éteint durant env 5 min, jusqu’à ce que le fromage soit fondu.\",\"Relever de poivre.\",\"Parsemer d’oignons et décorer de persil.\",\"Idéal avec la compote de pomme.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Saison Autumne\",\"Suisse\"],\"source\":\"https://migusto.migros.ch/fr/recettes/macaronis-du-chalet\",\"notes\":\"\",\"paprikaUid\":\"3893A6C5-E3F7-4F1E-A08E-D1C80AA8AA2B\"},{\"id\":\"legumes-sautes-au-wok-mrryzeki034\",\"title\":\"Légumes sautés au Wok\",\"category\":\"Asie\",\"time\":0,\"servings\":4,\"ingredients\":[[\"carottes\",2,\"\"],[\"courgettes\",2,\"\"],[\"pleurotes\",200,\"g\"],[\"herbes émincés\",\"\",\"\"],[\"émincé\",0.5,\"oignon\"],[\"huile de sésame\",\"\",\"\"],[\"sauce soja\",\"\",\"\"],[\"curry en poudre\",\"\",\"\"],[\"crème\",1,\"dl\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Couper les carottes et les courgettes en lamelles à l'aide d'un éplucheur Julienne.\",\"Faire chauffer un peu d'huile de sésame dans le wok.\",\"Ajouter l'oignon et les champignons et les faire suer.\",\"Ajouter la julienne de carottes et de courgettes.\",\"Faire tourner le tout et ajouter le reste des ingrédients.\",\"Bien assaissonner.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Wok\"],\"source\":\"https://www.kisag.ch/fr/recettes/legumes-sautes-au-wok\",\"notes\":\"\",\"paprikaUid\":\"27F6BF09-2CD3-450E-92A7-2862A993C914\"},{\"id\":\"legumes-au-wok-mrryzekh1n2\",\"title\":\"Légumes au Wok\",\"category\":\"Asie\",\"time\":20,\"servings\":4,\"ingredients\":[[\"carottes\",300,\"g\"],[\"fanes\",3,\"oignons\"],[\"rouge\",1,\"piment\"],[\"gingembre\",20,\"g\"],[\"grillé\",1,\"c. à soupe huile de sésame\"],[\"mungo\",250,\"g germes de haricots\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"maïzena\",1,\"c. à café\"],[\"soja\",2,\"c. à soupe sauce\"],[\"eau\",2,\"c. à soupe\"],[\"vert\",1,\"c. à soupe jus de citron\"],[\"grillé\",1,\"c. à soupe huile de sésame\"],[\"plat\",1,\"bouquet persil\"],[\"salées\",40,\"g cacahuètes grillées\"]],\"steps\":[\"Peler les carottes et les couper en julienne.\",\"Tailler les oignons fanes en fines rouelles, réserver un peu de fanes.\",\"Épépiner le piment.\",\"Peler le gingembre.\",\"Couper les deux en julienne.\",\"Bien faire chauffer l’huile dans un wok.\",\"Faire sauter les carottes env. 4 min en remuant.\",\"Ajouter oignons fanes, germes de haricots mungo, piment et gingembre et faire sauter env. 2 min en remuant.\",\"Saler et poivrer.\",\"Délayer la maïzena avec la sauce soja.\",\"Ajouter eau, jus de citron vert et huile.\",\"Bien mélanger.\",\"Verser sur les légumes.\",\"Laisser cuire doucement env. 2 minutes.\",\"Effeuiller le persil et parsemer avec les fanes d’oignons réservées et les cacahuètes.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Wok\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/legumes-au-wok-10009756/\",\"notes\":\"\",\"paprikaUid\":\"3E308564-922F-4EFE-9729-AFBEE936D2EC\"},{\"id\":\"linguine-et-sauce-a-la-creme-au-pesto-et-aux-tomates-mrryzekg9pe\",\"title\":\"Linguine et sauce à la crème, au pesto et aux tomates\",\"category\":\"Italie\",\"time\":20,\"servings\":2,\"ingredients\":[[\"basilic\",3,\"c. à soupe pesto au\"],[\"entière\",1,\"dl crème\"],[\"pâtes\",250,\"g\"],[\"tomates\",200,\"g coulis de\"],[\"poivre\",\"\",\"\"],[\"sel\",\"\",\"\"]],\"steps\":[\"Dans une casserole, faire chauffer les tomates, le pesto et la crème en remuant.\",\"Laisser mijoter pendant env. 5 min.\",\"Assaisonner.\",\"Faire cuire les pâtes al dente dans l'eau bouillante salée.\",\"Réserver env. ½ dl d'eau de cuisson.\",\"Egoutter les pâtes, les verser dans la sauce.\",\"Ajouter l'eau de cuisson réservée et mélanger le tout.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Pâtes\"],\"source\":\"https://fooby.ch/fr/recettes/18489/linguine-et-sauce-a-la-creme--au-pesto-et-aux-tomates\",\"notes\":\"\",\"paprikaUid\":\"97E69F4F-D321-4A67-A421-2198D63DB133\"},{\"id\":\"lasagne-alla-verdure-mrryzekfh8w\",\"title\":\"Lasagne alla verdure\",\"category\":\"Italie\",\"time\":60,\"servings\":4,\"ingredients\":[[\"courgettes\",500,\"g\"],[\"d’herbes italiennes\",0.5,\"c. à soupe mélange\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"oignon\",1,\"\"],[\"Paris\",400,\"g champignons de\"],[\"plat\",1,\"bouquet persil\"],[\"huile\",\"\",\"\"],[\"fontina\",200,\"g\"],[\"demi-crème\",5,\"dl crème ou de\"],[\"muscade\",\"\",\"\"],[\"lasagnes\",16,\"feuilles\"],[\"parmesan\",50,\"g\"],[\"beurre\",20,\"g\"]],\"steps\":[\"Préchauffer le four à 220° C.\",\"Partager les courgettes dans la longueur et les couper en lamelles.\",\"Mélanger dans un grand bol avec herbes, sel et poivre.\",\"Peler l’oignon et le hacher finement.\",\"Couper les champignons en lamelles.\",\"Ciseler le persil.\",\"Bien faire chauffer l’huile dans une poêle antiadhésive.\",\"Faire revenir les champignons, ajouter l’oignon et le persil, faire revenir, saler, poivrer.\",\"Râper grossièrement la fontine à la râpe à rösti.\",\"Porter la crème à ébullition dans une casserole, baisser le feu.\",\"Ajouter la fontine et la muscade.\",\"Laisser bouillonner en remuant jusqu’à ce que le fromage soit fondu, saler, poivrer.\",\"Répartir 3 c. s. de sauce au fromage au fond du plat graissé.\",\"Déposer dessus 4 feuilles de lasagnes, répartir la moitié des courgettes.\",\"Déposer dessus 4 feuilles de lasagnes, répartir les champignons et la moitié de la sauce.\",\"Déposer dessus 4 feuilles de lasagnes, répartir le reste des courgettes.\",\"Déposer dessus le reste des feuilles de lasagnes, répartir le reste de la sauce.\",\"Râper le parmesan par-dessus, tailler le beurre en petits dés, répartir sur les lasagnes.\",\"Cuisson:\",\"env. 30 min au milieu du four.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/lasagne-alla-verdure-10000604/\",\"notes\":\"\",\"paprikaUid\":\"11CB36A1-0038-43FE-981C-93CA07F52181\"},{\"id\":\"lasagne-mrryzekenay\",\"title\":\"Lasagne\",\"category\":\"Italie\",\"time\":85,\"servings\":4,\"ingredients\":[[\"carottes\",200,\"g\"],[\"céleri-rave\",200,\"g\"],[\"oignons\",2,\"\"],[\"d’ail\",2,\"gousses\"],[\"marjolaine\",1,\"brin\"],[\"romarin\",1,\"brin\"],[\"huile pour la cuisson\",\"\",\"\"],[\"(bœuf)\",600,\"g viande hachée\"],[\"tomate\",4,\"c. à soupe concentré de\"],[\"rouge\",3,\"dl vin\"],[\"1 boîte de tomates concassées (d’env. 400 g)\",4,\"dl bouillon de bœuf ou\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"beurre\",25,\"g\"],[\"farine\",3,\"c. à soupe\"],[\"lait\",6,\"dl\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"lasagnes\",15,\"feuilles\"],[\"râpé\",70,\"g parmesan\"]],\"steps\":[\"Peler les légumes.\",\"Tailler les carottes et le céleri en petits dés ou les râper grossièrement.\",\"Hacher finement les oignons, presser l'ail.\",\"Ciseler la marjolaine et le romarin.\",\"Bien faire chauffer un peu d'huile dans une cocotte.\",\"Saisir la viande env. 2 min par portion, retirer.\",\"Baisser le feu, éponger la cocotte, rajouter évent. un peu d'huile.\",\"Faire revenir les oignons et l'ail, ajouter le concentré de tomate, mijoter un instant.\",\"Ajouter les carottes et le céleri, mijoter encore un instant.\",\"Verser le vin et les bouillon, porter à ébullition, baisser le feu.\",\"Remettre la viande, mélanger.\",\"Ajouter la marjolaine et le romarin.\",\"Laisser bouillonner env. 30 min à couvert.\",\"Rectifier l'assaisonnement.\",\"Faire fondre le beurre dans une casserole.\",\"Ajouter la farine, faire un roux blanc en remuant au fouet, sans laisser prendre couleur.\",\"Éloigner la casserole du feu.\",\"Verser le lait, porter à ébullition en remuant, baisser le feu, saler, poivrer.\",\"Laisser bouillonner env. 10 min sur feu moyen en remuant de temps en temps jusqu'à ce la sauce soit veloutée.\",\"Préchauffer le four à 200°C.\",\"Répartir 4 c.s. de béchamel dans le plat graissé.\",\"Alterner ensuite dans le plat feuilles de lasagnes, sauce à la viande et béchamel, en terminant par la béchamel.\",\"Parsemer de parmesan.\",\"Cuisson:\",\"env. 35 min dans la moitié inférieure du four.\",\"Retirer, laisser reposer les lasagnes env. 5 minutes.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/lasagne-10002245/\",\"notes\":\"\",\"paprikaUid\":\"9018A020-2245-4D68-BC9C-95F71E6B37D7\"},{\"id\":\"la-galbi-cotes-de-b-uf-grillees-coreennes-mrryzekdvga\",\"title\":\"La Galbi - (Côtes de bœuf grillées coréennes)\",\"category\":\"Corée\",\"time\":30,\"servings\":4,\"ingredients\":[[\"1½ kg côtes de bœuf, tranchées façon galbi\",\"\",\"\"],[\"oignon\",0.25,\"\"],[\"(de 2-3cm)\",1,\"morceau gingembre\"],[\"d’ail\",8,\"gousses\"],[\"Nashi\",0.5,\"poire\"],[\"Mirin\",120,\"ml\"],[\"Saké\",60,\"ml\"],[\"light\",180,\"ml sauce soja\"],[\"brun\",1,\"c. à soupe sucre\"],[\"riz\",1,\"c. à soupe sirop de\"],[\"noir\",2,\"c. à café poivre\"],[\"blanches, moulues\",1,\"c. à soupe graines de sésame\"],[\"grillée\",1,\"c. à soupe huile de sésame\"]],\"steps\":[\"Laver et tremper les côtes dans de l’eau pendant 15 à 20 minutes.\",\"Rincer, sécher au sopalin et mettre de côté.\",\"Mettre dans un blender l’oignon, le gingembre, l’ail, la poire, le mirin et le saké.\",\"Mixer jusqu’à obtenir une texture lisse.\",\"Verser la purée d’oignon et de poire dans un récipient.\",\"Ajouter le reste des assaisonnements et bien mélanger.\",\"Placer les côtes dans la marinade en s’assurant que chaque morceau soit bien enrobé.\",\"Laisser mariner au frigo pendant au moins quelques heures ou toute une nuit.\",\"Cuire dans une poêle, une plancha ou sur un gril.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Corée\",\"Plat principal\"],\"source\":\"https://marcwiner.com/la-galbi/\",\"notes\":\"\",\"paprikaUid\":\"FB87BC87-CECE-4A9F-ADFA-F253BE18D954\"},{\"id\":\"kung-pao-riz-au-chou-fleur-mrryzekbtdu\",\"title\":\"Kung Pao (Riz au chou-fleur)\",\"category\":\"Asie\",\"time\":40,\"servings\":4,\"ingredients\":[[\"Chou-fleur:\",\"\",\"\"],[\"maïs\",2,\"c. à soupe fécule de\"],[\"soja\",2,\"c. à soupe sauce\"],[\"rôtir\",1,\"c. à soupe crème à\"],[\"citron, zeste râpé et jus, réserver un peu de zeste pour décorer\",1,\"\"],[\"acidulée\",100,\"g crème\"],[\"chou-fleur détaillé en rosettes\",1.2,\"kg\"],[\"chapelure\",180,\"g\"],[\"Riz:\",\"\",\"\"],[\"jasmin\",250,\"g riz de\"],[\"eau\",4,\"dl\"],[\"sel\",\"\",\"\"],[\"Sauce Kung Pao:\",\"\",\"\"],[\"eau\",2.5,\"dl\"],[\"soja\",1.5,\"dl sauce\"],[\"balsamique\",6,\"c. à soupe vinaigre\"],[\"2½ c. à soupe sucre\",\"\",\"\"],[\"maïs\",1,\"c. à soupe fécule de\"],[\"rôtir\",2,\"c. à soupe crème à\"],[\"hachés, réserver 3 c. à soupe pour décorer\",3,\"oignons nouveaux\"],[\"d'ail pressées\",2,\"gousses\"],[\"haché\",10,\"g gingembre finement\"],[\"concassé\",2,\"c. à café piment\"],[\"Garniture:\",\"\",\"\"],[\"(facultatif)\",80,\"g crème acidulée\"],[\"zeste de citron râpé\",\"\",\"\"],[\"grillées\",100,\"g cacahouètes salées\"]],\"steps\":[\"Préchauffer le four à 220°C (air chaud/chaleur tournante: 200°C).\",\"Chou-fleur:\",\"Mélanger la fécule de maïs, la sauce soja, la crème à rôtir, le zeste et le jus de citron et la crème acidulée.\",\"Mélanger le chou-fleur avec la marinade, laisser reposer 15 min.\",\"Rouler le chou-fleur dans la chapelure.\",\"Disposer sur la plaque chemisée de papier sulfurisé.\",\"Cuire 15 min au milieu du four chaud.\",\"Riz:\",\"Cuire le riz selon les indications de l'emballage.\",\"Sauce Kung Pao:\",\"Mélanger tous les ingrédients jusqu'à la fécule de maïs incluse.\",\"Porter à ébullition.\",\"Laisser frémir 2 min à feu moyen.\",\"Dans une autre poêle, faire revenir les oignons nouveaux, l'ail, le gingembre et le piment concassé dans la crème à rôtir.\",\"Ajouter la sauce.\",\"Laisser mijoter env. 4 min jusqu'à ce que la sauce commence à épaissir.\",\"Dressage:\",\"Dresser le chou-fleur sur le riz.\",\"Parsemer de cacahouètes et napper de sauce kung pao.\",\"Mélanger la crème acidulée et le zeste de citron mis de côté.\",\"Ajouter.\",\"Garnir avec les oignons nouveaux restants.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Plat principal\",\"Végétarien\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2021_CHDO_22/chou-fleur-kung-pao/\",\"notes\":\"\",\"paprikaUid\":\"F1FE7689-687C-463B-A854-F7C3904B342C\"},{\"id\":\"knopfli-a-la-courge-et-au-fromage-avec-des-ufs-au-plat-mrryzekawf3\",\"title\":\"Knöpfli à la courge et au fromage avec des œufs au plat\",\"category\":\"Plat principal\",\"time\":0,\"servings\":4,\"ingredients\":[[\"PÂTE:\",\"\",\"\"],[\"courge, p. ex. butternut\",300,\"g\"],[\"beurre\",0.5,\"c. à soupe\"],[\"légumes\",1,\"dl bouillon de\"],[\"œufs\",3,\"\"],[\"liquide, moitié lait/moitié eau\",1,\"dl\"],[\"Knöpfli\",300,\"g farine à\"],[\"sel\",\"\",\"\"],[\"beurre\",20,\"g\"],[\"mi-dure, râpé\",200,\"g fromage à pâte\"],[\"ŒUFS:\",\"\",\"\"],[\"rôtir\",2,\"c. à soupe beurre à\"],[\"œufs\",4,\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"persil, haché grossièrement\",2,\"c. à soupe\"]],\"steps\":[\"PÂTE :\",\"Faire revenir la courge dans le beurre chaud et mouiller avec le bouillon.\",\"Recouvrir, faire mijoter jusqu’à ce que la courge soit tendre, et laisser refroidir.\",\"Réduire finement en purée les œufs, le mélange lait/eau et la courge.\",\"Mélanger la farine et le sel.\",\"Former un puits et verser le liquide dedans.\",\"Mélanger avec une louche jusqu’à obtention d’une pâte lisse et battre la pâte jusqu’à ce qu’elle fasse des bulles.\",\"Recouvrir et laisser gonfler pendant 30 minutes à température ambiante.\",\"Passer la pâte par portions à travers la passoire à Knöpfli et faire tomber les Knöpfli dans l’eau salée bouillante.\",\"Laisser cuire jusqu’à ce que les Knöpfli remontent à la surface, les sortir avec une écumoire et bien les faire égoutter.\",\"Placer les Knöpfli, le beurre et le fromage sur une plaque préchauffée et mettre au chaud au four préchauffé à 80 °C\",\"ŒUFS :\",\"Faire chauffer le beurre à rôtir dans une poêle antiadhésive.\",\"Casser les œufs les uns après les autres et les faire cuire pendant env. 5 minutes.\",\"Assaisonner.\",\"Répartir les Knöpfli sur des assiettes préchauffées.\",\"Mettre les œufs au plat dessus et saupoudrer de persil.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Saison Hiver\",\"Suisse\"],\"source\":\"https://www.gemuese.ch/fr/recettes/knoepfli-a-la-courge-et-au-fromage-avec-des-oeufs-au-plat?_gl=1*7oikc*_up*MQ..&gclid=EAIaIQobChMItdK7sbK4kQMVepKDBx0SyAWNEAAYASABEgL9oPD_BwE&gbraid=0AAAAA-NhTE5iAnPHfalM4KcSHGDur_dvT\",\"notes\":\"\",\"paprikaUid\":\"C80791C4-D6DE-4DE2-A942-FC32AEB0EE61\"},{\"id\":\"knopfli-aux-epinards-avec-beurre-brun-mrryzekaa9z\",\"title\":\"Knöpfli aux épinards avec beurre brun\",\"category\":\"Plat principal\",\"time\":60,\"servings\":4,\"ingredients\":[[\"KNÖPFLI:\",\"\",\"\"],[\"oignon, finement haché De saison\",1,\"\"],[\"d’ail, finement hachée\",1,\"gousse\"],[\"beurre\",1,\"c. à soupe\"],[\"épinards\",300,\"g\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"blanche\",300,\"g farine\"],[\"Knöpfli\",300,\"g farine à\"],[\"sel\",\"\",\"\"],[\"2½ dl lait\",\"\",\"\"],[\"œufs, battus\",5,\"\"],[\"GARNITURE:\",\"\",\"\"],[\"beurre\",50,\"g\"],[\"épinards\",100,\"g\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"pignons, grillés\",30,\"g\"],[\"féta, émiettée\",200,\"g\"]],\"steps\":[\"KNÖPFLI :\",\"Faire revenir les oignons et l’ail dans le beurre chaud.\",\"Ajouter les épinards et faire revenir pendant 2 à 3 minutes jusqu’à ce que les épinards aient rétrécis. Assaisonner.\",\"Mettre les épinards dans une passoire, bien presser et hacher très finement.\",\"Mélanger les farines avec du sel.\",\"Mélanger le lait et les œufs et ajouter à la farine.\",\"Mélanger avec une louche jusqu’à obtention d’une pâte et battre jusqu’à ce que la pâte forme des bulles.\",\"Incorporer les épinards.\",\"Recouvrir la pâte et la laisser reposer pendant env. 30 minutes à température ambiante.\",\"Passer la pâte par portions à travers la passoire à Knöpfli et la laisser tomber dans de l’eau tout juste bouillante.\",\"Laisser cuire jusqu’à ce que les Knöpfli remontent à la surface.\",\"Sortir les Knöpfli avec une écumoire et bien les laisser égoutter.\",\"Mettre les Knöpfli dans un saladier et procéder de la même manière avec le reste de pâte.\",\"Placer les Knöpfli au four préchauffé à 80 °C.\",\"GARNITURE :\",\"Faire mijoter le beurre dans une grande poêle jusqu’à ce qu’il devienne brun et ait une légère odeur de noisette.\",\"Ajouter les épinards et faire revenir pendant 1 à 2 minutes en remuant. Assaisonner.\",\"Ajouter les Knöpfli et faire brièvement revenir.\",\"Garnir avec les pignons et la feta.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Saison Hiver\",\"Suisse\"],\"source\":\"https://www.gemuese.ch/fr/recettes/knoepfli-aux-epinards-avec-du-beurre-noisette?_gl=1*5ajthk*_up*MQ..&gclid=EAIaIQobChMItdK7sbK4kQMVepKDBx0SyAWNEAAYASABEgL9oPD_BwE&gbraid=0AAAAA-NhTE5iAnPHfalM4KcSHGDur_dvT\",\"notes\":\"\",\"paprikaUid\":\"9116124C-EBF4-4447-B7DB-AF3D1DEEA305\"},{\"id\":\"knodel-a-la-courge-mrryzek9mno\",\"title\":\"Knödel à la courge\",\"category\":\"Plat principal\",\"time\":90,\"servings\":4,\"ingredients\":[[\"courge, env. 600 g, pelée, épépinée, râpée à la râpe à bircher, bien égouttée\",1,\"\"],[\"champs, pelées, râpées à la râpe à bircher\",300,\"g de pommes de terre en robe des\"],[\"persil, finement haché\",2,\"c. à soupe de\"],[\"d'œufs\",4,\"jaunes\"],[\"farine\",250,\"g de\"],[\"sel\",\"\",\"\"],[\"noix de muscade\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"Liaison:\",\"\",\"\"],[\"demi-crème\",1.8,\"dl de\"],[\"Gruyère, fraîchement râpé\",5,\"c. à soupe de\"],[\"courge\",2,\"c. à soupe de graines de\"]],\"steps\":[\"Bien mélanger la courge, les pommes de terre, le persil et les jaunes d'œufs.\",\"Ajouter autant de farine que nécessaire pour former une masse modelable.\",\"Assaisonner.\",\"Laisser reposer env. 30 minutes à couvert.\",\"A l'aide de 2 cuillères, former des boules de la grosseur d'une noix.\",\"Pocher par portions dans de l'eau salée, jusqu'à ce que les quenelles remontent à la surface.\",\"Retirer du feu, égoutter.\",\"Disposer dans le moule préalablement beurré.\",\"Verser la crème.\",\"Parsemer de fromage et de graines de courge.\",\"Gratiner 20-25 minutes au milieu du four préchauffé à 220 °C.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Végétarien\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM200303_57/quenelles-a-la-courge/\",\"notes\":\"\",\"paprikaUid\":\"4383E90A-0B17-4E9C-B7D1-087ACBF9C214\"},{\"id\":\"knodel-aux-epinards-et-au-beurre-noisette-mrryzek8n1f\",\"title\":\"Knödel aux épinards et au beurre noisette\",\"category\":\"Plat principal\",\"time\":80,\"servings\":4,\"ingredients\":[[\"KNÖDEL:\",\"\",\"\"],[\"beurre\",20,\"g\"],[\"oignon\",1,\"\"],[\"d’ail\",2,\"gousses\"],[\"lait\",1,\"dl\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"muscade\",1,\"pincée noix de\"],[\"veille, en petits cubes\",200,\"g pain de la\"],[\"épinards\",400,\"g\"],[\"salée\",3,\"l eau\"],[\"glaçons\",5,\"\"],[\"œufs\",2,\"\"],[\"maigre\",50,\"g séré\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"muscade\",1,\"pincée noix de\"],[\"salée\",2,\"l eau\"],[\"BEURRE NOISETTE :\",\"\",\"\"],[\"beurre\",80,\"g\"],[\"Sbrinz, râpé\",20,\"g\"]],\"steps\":[\"KNÖDEL:\",\"Faire chauffer le beurre dans une poêle et faire revenir l’oignon et l’ail.\",\"Mouiller avec le lait et assaisonner.\",\"Ajouter le pain et laisser reposer pendant env. 20 min.\",\"Mettre les épinards dans l’eau salée et blanchir pendant env. 30 secondes.\",\"Sortir et tremper dans l’eau glacée.\",\"Sortir les épinards avec un tamis, les poser sur un torchon, bien presser et couper grossièrement.\",\"Verser la masse dans le mixeur.\",\"Ajouter le séré et les œufs.\",\"Assaisonner et réduire finement en purée.\",\"Ajouter la masse d’épinards à la masse de pain.\",\"Incorporer lâchement et laisser reposer pendant env. 15 min.\",\"Former env. 10 boules avec les mains humides.\",\"Faire cuire les Knödel par portion pendant env. 10 minutes dans l’eau presque bouillante.\",\"Sortir et laisser égouter sur du papier de ménage.\",\"BEURRE NOISETTE :\",\"Mettre le beurre dans une poêle, faire chauffer soigneusement jusqu’à ce qu’il devienne mousseux et brun.\",\"Retirer immédiatement la poêle du feu.\",\"Mettre les Knödel sur des assiettes préchauffées.\",\"Verser le beurre dessus et saupoudrer de fromage.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Saison Hiver\",\"Suisse\"],\"source\":\"https://www.gemuese.ch/fr/recettes/knoedel-aux-epinards-et-au-beurre-noisette?_gl=1*1hl55xn*_up*MQ..*_gs*MQ..&gclid=EAIaIQobChMItdK7sbK4kQMVepKDBx0SyAWNEAAYASABEgL9oPD_BwE&gbraid=0AAAAA-NhTE5iAnPHfalM4KcSHGDur_dvT\",\"notes\":\"\",\"paprikaUid\":\"5E9A85E9-EE91-49D9-B207-D2D1309E9F8C\"},{\"id\":\"klassischer-baskischer-kasekuchen-san-sebastian-mrryzek7r6u\",\"title\":\"Klassischer Baskischer Käsekuchen (San Sebastian)\",\"category\":\"Dessert\",\"time\":600,\"servings\":6,\"ingredients\":[[\"Philadelphia double-crème\",800,\"g\"],[\"sucre\",200,\"g\"],[\"sel\",0,\"\"],[\"œuf\",5,\"u\"],[\"crème entière\",400,\"ml\"],[\"farine\",30,\"g\"],[\"extrait de vanille\",2,\"c. à café\"]],\"steps\":[\"Den Ofen auf 210°C Umluft vorheizen.\",\"Eine 20cm Springform leicht einfetten und mit Backpapier auslegen – ein rundes Stück für den Boden und ein langer, breiter Streifen für den Rand (sollte am Rand einige Zentimeter überstehen).\",\"Zur Seite stellen.\",\"Frischkäse (Zimmertemperatur), Zucker und Salz in einer grossen Schüssel verrühren.\",\"Es soll alles gut vermengt sein, aber keine Luft in die Masse eingeschlossen werden.\",\"Die Eier einzeln dazugeben und unterrühren.\",\"Die Sahne leicht anschlagen.\",\"Das Mehl in eine kleinere Schüssel einsieben und mit etwas von der Schlagsahne und dem Vanille Extrakt glatt rühren.\",\"Zusammen mit der restlichen Sahne zur grossen Schüssel dazugeben und unterrühren.\",\"Die Masse in die vorbereitete Form füllen.\",\"Etwas an der Form rütteln, damit Bläschen aufsteigen können und dann für etwa 35 Minuten in der Mitte des Ofens backen.\",\"Die Ränder des Käsekuchens sollten fest geworden sein und dürfen ordentlich Farbe bekommen haben – in der Mitte sollte die Käsekuchenmasse noch leicht wackeln, wenn man an der Form rüttelt.\",\"Den Kuchen aus dem Ofen holen und am Rand mit einem scharfen Messer vom Backpapier lösen, damit sich die Oberfläche ungestört zusammenziehen kann.\",\"In der Form dann komplett abkühlen lassen.\",\"Danach noch einmal über Nacht in den Kühlschrank stellen.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Gâteau\",\"modifié\"],\"source\":\"https://baketotheroots.de/klassischer-baskischer-kaesekuchen-san-sebastian/\",\"notes\":\"\",\"paprikaUid\":\"EDB5DD95-7589-497F-A79F-F37557A928F1\"},{\"id\":\"keftas-de-b-uf-a-la-menthe-et-au-sesame-mrryzek7xwq\",\"title\":\"Keftas de bœuf à la menthe et au sésame\",\"category\":\"Snack\",\"time\":30,\"servings\":6,\"ingredients\":[[\"oignon\",1,\"u\"],[\"bœuf\",350,\"g viande hachée de\"],[\"tomates\",1,\"tbspconcentré de\"],[\"d’acacia\",1,\"tbsp miel\"],[\"harissa\",1,\"c. à café\"],[\"orientales\",1,\"tsp épices\"],[\"menthe\",0.5,\"u bouquet de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"sésame\",2,\"tbsp graines de\"],[\"d’olive\",2,\"tbsp huile\"]],\"steps\":[\"Hacher fin l’oignon et la menthe.\",\"L’incorporer à la viande hachée.\",\"Ajouter le concentré de tomates, le miel, la harissa, les épices orientales et la menthe.\",\"Saler et poivrer.\",\"Pour vérifier l’assaisonnement, prélever un peu de cette préparation et la faire rissoler dans de l’huile.\",\"Goûter et, si nécessaire, assaisonner davantage.\",\"Façonner la préparation en boulettes de la taille d’une noix.\",\"Parsemer de sésame et presser pour bien faire adhérer les graines.\",\"Faire rissoler les boulettes de tous les côtés dans l’huile à feu moyen.\",\"Servir avec du yogourt nature.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Snack\"],\"source\":\"https://migusto.migros.ch/fr/recettes/keftas-de-boeuf-a-la-menthe-et-au-sesame\",\"notes\":\"\",\"paprikaUid\":\"AA274436-43FE-44E6-956B-D21C7D6495E2\"},{\"id\":\"jarrets-de-veau-gremolata-de-fruits-a-la-moutarde-mrryzek6dcb\",\"title\":\"Jarrets de veau, Gremolata de fruits à la moutarde\",\"category\":\"Italie\",\"time\":145,\"servings\":4,\"ingredients\":[[\"citrons\",0.5,\"\"],[\"plat\",0.5,\"bouquet persil\"],[\"d’ail\",1,\"gousses\"],[\"oignons-sauce\",150,\"g\"],[\"huile d'olive\",\"\",\"\"],[\"1½ dl bouillon de viande\",\"\",\"\"],[\"moutarde\",100,\"g fruits à la\"],[\"veau\",4,\"jarrets de\"],[\"poivre\",\"\",\"\"],[\"sel\",\"\",\"\"]],\"steps\":[\"Inciser légèrement de toutes parts la peau des jarrets de veau.\",\"Faire chauffer l’huile dans une cocotte.\",\"Y saisir la viande par portions pendant env. 2 min de chaque côté.\",\"La sortir, la saler et la poivrer.\",\"Ecraser l’ail et couper les oignons en deux.\",\"Remettre un peu d’huile dans la cocotte.\",\"Y faire suer l’ail et l’oignon.\",\"Mouiller avec le bouillon et porter à ébullition.\",\"Remettre la viande dans la cocotte et la laisser mijoter à couvert pendant env. 1 h 3/4 en la retournant de temps en temps.\",\"Sortir la viande et la réserver au chaud.\",\"Faire réduire le liquide env. de moitié.\",\"Egoutter les fruits à la moutarde, les hacher grossièrement et les mélanger avec le persil ciselé et le zeste de citron râpé.\",\"Dresser les jarrets et les oignons, les napper de sauce et les garnir de gremolata.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\"],\"source\":\"https://fooby.ch/fr/recettes/9781/jarrets-de-veau--gremolata-de-fruits-a-la-moutarde\",\"notes\":\"\",\"paprikaUid\":\"698E96F7-4F58-4CEE-BF23-BE79889B3FAB\"},{\"id\":\"jarret-de-veau-a-la-sauce-au-citron-mrryzek5qhq\",\"title\":\"Jarret de veau à la sauce au citron\",\"category\":\"Italie\",\"time\":150,\"servings\":6,\"ingredients\":[[\"(entier)\",2,\"kg jarret de veau\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"oignon\",1,\"u\"],[\"d'olive\",4,\"tbsp huile\"],[\"beurre\",2,\"c. à soupe\"],[\"d’ail\",2,\"u gousse\"],[\"veau\",2.5,\"dl fond de\"],[\"tige\",2,\"u romarin\"],[\"tige\",4,\"u thym\"],[\"d’œuf\",2,\"u jaune\"],[\"citron\",2,\"tbsp jus de\"],[\"persil\",2,\"c. à soupe\"]],\"steps\":[\"Die Kalbshaxe sorgfältig von Sehnen und Fett befreien, salzen und pfeffern.\",\"Die Zwiebel schälen und grob zerteilen.\",\"Den Backofen auf 160° vorheizen.\",\"Öl und Butter in einem großen Bräter erhitzen und die Kalbshaxe darin von allen Seiten braun anbraten.\",\"Die Zwiebeln hinzufügen, den Knoblauch schälen und dazupressen.\",\"Di Hälfte des Kalbsfonds über die Haxe gießen und den Bräter in den heißen Ofen (unten, Umluft 150°) schieben.\",\"Rosmarin und Thymian waschen, trockentupfen und zufügen.\",\"Die Haxe insgesamt 2 ¼-2 ½ Std. schmoren, dabei alle 30 Min. wenden.\",\"Die Kalbshaxe aus der Sauce nehmen, in Alufolie wickeln und warm stellen.\",\"Die Sauce aus dem Bräter durch ein Sieb in einen kleinen Topf gießen und auf die Hälfte einkochen lassen.\",\"Eigelb, Zitronensaft und den restlichen Kalbsfond gut miteinander verquirlen.\",\"Die Petersilie zugeben und die Mischung in den kochenden Bratensaft gießen.\",\"Unter ständigem Rühren zum Sieden (nicht bis zum Kochen!) bringen.\",\"Die Sauce soll sämig werden, darf aber nicht kochen, da sie sonst gerinnt.\",\"Das Fleisch vom Knochen lösen und in Scheiben schneiden, auf einer vorgewärmten Platte anrichten und die Sauce darüber gießen.\",\"Servieren mit Risotto, Polenta oder Kartoffelstock.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\"],\"source\":\"https://www.kuechengoetter.de/rezepte/kalbshaxe-mit-zitronensauce-1507\",\"notes\":\"\",\"paprikaUid\":\"C7EE7CEF-B9C1-4A1E-BF64-08C0C3CD1BFF\"},{\"id\":\"japchae-mrryzek3bz9\",\"title\":\"Japchae\",\"category\":\"Corée\",\"time\":0,\"servings\":4,\"ingredients\":[[\"patate douce (dangmyeon) environ 200g\",4,\"portions nouilles de\"],[\"poivron rouge\",1,\"gros\"],[\"(variété au choix)\",1,\"dizaine champignons\"],[\"mange-tout\",1,\"poignée pois\"],[\"œufs\",4,\"\"],[\"pour la marinade\",\"\",\"\"],[\"sauce soja\",4,\"c. à soupe\"],[\"miel\",2,\"c. à soupe\"],[\"cassonnade\",1,\"c. à soupe\"],[\"sésame\",2,\"c. à soupe huile de\"],[\"d'ail pressées\",5,\"gousses\"],[\"graines de sésame\",1,\"c. à soupe\"]],\"steps\":[\"Casser les œufs en séparant les blancs des jaunes.\",\"Battre les blancs avec un peu de sel et cuire comme une omelette sans faire dorer.\",\"Procéder de la même manière avec les jaunes.\",\"Couper les omelettes ainsi obtenues en lanières (elle peut aussi être roulée et coupée en rondelles).\",\"Mettre de côté.\",\"Couper les poivrons et les champignons en lamelles.\",\"Préparer la marinade en mélangeant tous les ingrédients de la section marinade.\",\"Prélever de cette marinade 3 c.s. et mettre dans les champignons.\",\"Bien mélanger et laisser mariner.\",\"Cuire les nouilles de patate douce (vérifier le temps de cuisson sur l'emballage).\",\"Les rincer à l'eau froide dès la fin de la cuisson et réserver de côté.\",\"Faire sauter chaque légume séparément dans une c.s. d'huile de cuisson jusqu'à obtenir la texture désirée (croquant ou fondant), en finissant par les champignons.\",\"Mettre les nouilles dans un saladier et ajouter les légumes et le restant de sauce.\",\"Bien mélanger (il est conseillé d'utiliser un gant adapté au contact alimentaire).\",\"Le Japchae est prêt si il est consommé froid.\",\"Dans le cas contraire, chauffer une grande poêle ou un wok et y faire sauter les nouilles accompagnées des légumes quelques minutes.\",\"Quand le Japchae est bien chaud, ajouter les lamelles d'omelettes et mélanger avant de servir.\",\"Dresser sur une assiette en ajoutant au choix coriandre ciselée, oignon vert, ciboulle...\",\"Le petit truc en + :\",\"Les légumes choisis pour cette recette peuvent varier selon les préférences de chacun ou en fonction de l'approvisionnement du réfrigérateur.\",\"Selon les goûts et la saison, le Japchae se mange chaud ou froid.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Corée\",\"Plat principal\"],\"source\":\"https://cookpad.com/fr/recettes/16863096?ref=search&search_term=cor%C3%A9enne\",\"notes\":\"\",\"paprikaUid\":\"460103CF-FAAF-4E34-AB17-A8E967E12A50\"},{\"id\":\"jambon-roti-au-cidre-epice-et-au-miel-mrryzek2l65\",\"title\":\"Jambon rôti au cidre épicé et au miel\",\"category\":\"Cocotte\",\"time\":150,\"servings\":6,\"ingredients\":[[\"Pour le jambon rôti :\",\"\",\"\"],[\"rôti\",1.8,\"kg jambon\"],[\"brut\",2,\"lt cidre\"],[\"cannelle\",2,\"bâtonnets\"],[\"étoilés\",4,\"anis\"],[\"thym\",2,\"brins\"],[\"noir\",6,\"grains poivre\"],[\"d’ail, gousses séparées et écrasées\",0.5,\"tête\"],[\"échalotes, coupées en deux\",3,\"\"],[\"Pour le glaçage :\",\"\",\"\"],[\"miel\",6,\"c. à soupe\"],[\"beurre\",2,\"c. à soupe\"],[\"l'ancienne\",2,\"c. à soupe moutarde à\"],[\"cidre\",2,\"c. à soupe vinaigre de\"],[\"thym\",4,\"brins\"],[\"clous de girofle pour décorer\",\"\",\"\"],[\"romarin frais\",\"\",\"\"],[\"thym\",\"\",\"\"],[\"feuilles de laurier pour décorer\",\"\",\"\"],[\"rôtir\",1,\"kg pommes de terre à\"],[\"panais.\",500,\"g carottes et\"]],\"steps\":[\"Pour préparer le Jambon rôti:\",\"Placez-le dans la cocotte ronde et recouvrez de cidre.\",\"Ajoutez les bâtonnets de cannelle, l’anis étoilé, le thym, les grains de poivre noir, l’ail et les échalotes.\",\"Faites mijoter doucement et cuire pendant 1 heure à 45 minutes, en ajoutant de l’eau si nécessaire.\",\"Prenez soin de ne pas faire bouillir le cidre, au risque de durcir la viande.\",\"Placez le couvercle dessus pendant qu’il mijote.\",\"Une fois cuit, laissez le Jambon rôti refroidir dans le liquide de pochage pendant la nuit pour conserver l’humidité et la saveur.\",\"Pour préparer le glaçage :\",\"Dans une petite casserole, faites fondre le beurre à feu doux.\",\"Incorporez le miel, la moutarde, le vinaigre de cidre et le thym.\",\"Faites cuire pendant 1 à 2 minutes jusqu’à ce que le mélange soit homogène.\",\"Retirez le Jambon rôti du liquide de cuisson et épongez-le délicatement.\",\"Jetez le liquide de cuisson.\",\"Préchauffez le gril à feu moyen-élevé.\",\"Incisez la graisse en losange et badigeonnez généreusement avec le glaçage.\",\"Piquez la surface du Jambon rôti avec des clous de girofle.\",\"Faites griller pendant 10 à 15 minutes, en badigeonnant avec du glaçage supplémentaire, jusqu’à ce qu’il soit caramélisé et doré.\",\"Coupez et servez chaud avec des pommes de terre rôties, des carottes et des panais.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Cocotte\",\"Plat principal\"],\"source\":\"https://www.lecreuset.ch/fr_CH/jambon-roti-au-cidre-epice-et-au-miel/r0000000002053.html\",\"notes\":\"\",\"paprikaUid\":\"751B4334-362E-476A-A6BF-338133205A2F\"},{\"id\":\"jajangmyeon-nouilles-coreennes-a-la-pate-de-haricots-noir-mrryzejzttv\",\"title\":\"Jajangmyeon (Nouilles coréennes à la pâte de haricots noir)\",\"category\":\"Corée\",\"time\":50,\"servings\":3,\"ingredients\":[[\"(ou Udon précuites)\",500,\"g nouilles Jajangmyeon\"],[\"moyen, en petits dés\",0.5,\"oignon\"],[\"courgette, en petits dés\",0.5,\"\"],[\"terre, en petits dés\",1,\"pomme de\"],[\"frais, en fines tranches\",4,\"champignons shiitake\"],[\"chinois, coupé en morceaux\",0.25,\"chou\"],[\"lard, non salé, coupé en dés\",300,\"g\"],[\"Shaoxing\",0.5,\"c. à soupe vin\"],[\"2½ pincées sel\",\"\",\"\"],[\"2½ pincées poivre noir moulu\",\"\",\"\"],[\"gingembre\",1,\"pincée poudre de\"],[\"(Chunjang)\",3,\"c. à soupe pâte de haricots noirs coréenne\"],[\"saindoux\",45,\"g\"],[\"brun\",1,\"c. à soupe sucre\"],[\"shaoxing\",2,\"c. à soupe vin\"],[\"poulet\",120,\"ml bouillon de\"],[\"eau\",120,\"ml\"],[\"terre, diluées dans 2 c. à soupe d'eau\",2,\"c. à soupe fécule de pomme de\"],[\"concombre, en julienne\",0.5,\"\"],[\"doux\",1,\"boîte petits pois ou maïs\"],[\"œuf dur (facultatif)\",\"\",\"\"]],\"steps\":[\"Rincez le porc à l'eau froide et séchez-le avec du papier essuie tout.\",\"Ajoutez les ingrédients de la marinade sur le porc.\",\"Mélangez bien et laissez reposer pendant 15 minutes.\",\"Préchauffer le wok jusqu'à ce que le fond soit bien chauffé.\",\"Ajouter le saindoux et le faire fondre dans le wok.\",\"Ajouter la pâte de haricots noirs et remuer constamment à feu moyen pendant 3 à 5 minutes.\",\"Ajouter le sucre brun et remuer 2 à 3 minutes\",\"Retirer la pâte de haricots noirs (sans la graisse) et réserver.\",\"Conserver l'huile dans le wok pour l'étape suivante.\",\"Garder le wok chaud\",\"Ajouter le porc dans le wok et remuer jusqu'à ce qu'il soit à moitié cuit\",\"Ajouter l'oignon, la courgette et la pomme de terre et remuer jusqu'à ce qu'ils soient cuits à 1/3 (pendant 3 à 5 minutes)\",\"Ajouter les champignons et le chou et remuer pendant 2 à 3 minutes\",\"Incorporer la pâte de haricots noirs cuite dans le wok et mélanger avec les légumes.\",\"Remuer pendant 1 à 2 minutes\",\"Ajouter le bouillon de poulet, l'eau et le vin shaoxing.\",\"Laisser mijoter pendant 5 à 7 minutes à feu moyen à couvert.\",\"Parallèlement à l'étape précédente, faire bouillir de l'eau dans une casserole.\",\"Y ajouter les nouilles lorsqu'elle commence à bouillir.\",\"Les faire cuire pendant 3 à 5 minutes\",\"Rincer les nouilles à l'eau froide et égoutter.\",\"Les mettre dans un bol.\",\"Ajouter le mélange de fécule et l’eau dans le wok puis remuer.\",\"Ajouter la sauce aux haricots noirs sur les nouilles.\",\"Servir tel quel ou décorer avec des tranches de concombre, des petits pois, du maïs doux ou un œuf dur\",\"Bien mélanger la sauce et les nouilles avec des baguettes\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Corée\",\"Plat principal\",\"Poulet\"],\"source\":\"https://marcwiner.com/jajangmyeon/\",\"notes\":\"\",\"paprikaUid\":\"3969B472-90B6-47E4-B3B5-85F80C4BE3F5\"},{\"id\":\"involtini-et-peperonata-mrryzejy5s8\",\"title\":\"Involtini et peperonata\",\"category\":\"Italie\",\"time\":50,\"servings\":4,\"ingredients\":[[\"origan\",3,\"c. à soupe\"],[\"oignons\",1,\"\"],[\"d’ail\",2,\"gousses\"],[\"poivrons\",4,\"\"],[\"huile\",\"\",\"\"],[\"chapelure\",2,\"c. à soupe\"],[\"l'huile\",4,\"tomates séchées à\"],[\"tomates\",2,\"c. à soupe concentré de\"],[\"Luganighe\",2,\"\"],[\"fines\",8,\"tranche escalopes de veau\"],[\"blanc\",1,\"dl vin\"],[\"romarin\",2,\"c. à soupe\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"laurier\",1,\"feuilles\"]],\"steps\":[\"Mélanger la chair à saucisse, les tomates, les fines herbes et la chapelure.\",\"Assaisonner les escalopes de veau, répartir la chair à saucisse dessus puis les rouler.\",\"Si nécessaire, ficeler les involtini avec de la ficelle de cuisine ou les fixer avec des cure-dents.\",\"Faire chauffer l'huile dans une poêle antiadhésive.\",\"Y saisir les involtini de toutes parts pendant env. 5 min.\",\"Les sortir, essuyer la graisse de cuisson, verser un peu d'huile dans la poêle.\",\"Faire revenir brièvement l'oignon et l'ail.\",\"Ajouter les poivrons et faire cuire le tout pendant env. 5 min.\",\"Ajouter la purée de tomates, poursuivre brièvement la cuisson.\",\"Mouiller avec le vin et laisser réduire un peu.\",\"Ajouter l'eau et la feuille de laurier, assaisonner et laisser mijoter pendant env. 20 min.\",\"Remettre les involtini dans la poêle.\",\"Terminer la cuisson à petit feu pendant env. 10 min.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\"],\"source\":\"https://fooby.ch/fr/recettes/20055/involtini-et-peperonata\",\"notes\":\"\",\"paprikaUid\":\"4A551439-D07A-44DE-9CBA-773E60626FBD\"},{\"id\":\"involtini-de-veau-aux-epinards-mrryzejwbkg\",\"title\":\"Involtini De Veau Aux Épinards\",\"category\":\"A\",\"time\":65,\"servings\":4,\"ingredients\":[[\"oignons\",2,\"\"],[\"d’ail\",2,\"gousses\"],[\"d’épinards en branches\",400,\"g\"],[\"basilic\",0.5,\"bouquet de\"],[\"d’huile d'olive\",1,\"cs\"],[\"un peu d’huile d'olive\",\"\",\"\"],[\"râpé\",80,\"g de parmesan\"],[\"concassées\",1,\"boîte de tomates\"],[\"fines\",8,\"escalopes de veau\"],[\"jambon\",4,\"tranche de\"],[\"¼ de cc de sel\",1,\"\"],[\"un peu de poivre\",\"\",\"\"]],\"steps\":[\"Faire chauffer l'huile dans une poêle antiadhésive, faire revenir l'oignon et l'ail pendant env. 2 min., ajouter les épinards progressivement, les faire suer jusqu'à ce que toute l'humidité se soit évaporée. Laisser refroidir un peu les épinards, les hacher menu, ajouter le parmesan et mélanger.\",\"Assaisonner les escalopes, les recouvrir de jambon. Répartir 2 cs de farce par-dessus, les rouler et les fixer avec un cure-dents. Faire revenir les involtini de toutes parts à feu moyen dans un peu d'huile chaude pendant env. 4 min.\",\"Faire chauffer l'huile dans une casserole et y faire suer l'oignon et l'ail, ajouter les tomates et l'eau et assaisonner. Laisser mijoter la sauce une vingtaine de minutes en remuant de temps en temps.\",\"Verser un peu de sauce dans le plat, ajouter les involtini, répartir le reste de sauce autour de ces derniers et parsemer de fromage. Faire cuire env. 20 min. au milieu du four préchauffé à 180 °C. Garnir de basilic.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"A\"],\"source\":\"https://fooby.ch/fr/recettes/13223/involtini-de-veau-aux-epinards\",\"notes\":\"\",\"paprikaUid\":\"8C324E8F-7237-41A6-A4A5-EF7635D19FCB\"},{\"id\":\"involtini-d-aubergine-aux-noisettes-mrryzejvnl7\",\"title\":\"Involtini d'aubergine aux noisettes\",\"category\":\"Plat principal\",\"time\":55,\"servings\":4,\"ingredients\":[[\"Farce:\",\"\",\"\"],[\"moulues\",180,\"g noisettes\"],[\"d'ail hachées\",3,\"gousses\"],[\"râpé\",30,\"g Sbrinz\"],[\"lait\",1,\"dl\"],[\"épinards\",30,\"g\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"aubergines, coupées en longues tranches de 4-5 mm\",2,\"\"],[\"crème à rôtir\",\"\",\"\"],[\"Sauce tomate:\",\"\",\"\"],[\"crème à rôtir\",\"\",\"\"],[\"d'ail hachées\",2,\"gousses\"],[\"400 g\",1,\"boîte tomates pelées de\"],[\"sucre\",0.25,\"c. à café\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"râpée\",50,\"g mozzarella\"],[\"feuilles de basilic\",\"\",\"\"]],\"steps\":[\"Préchauffer le four à 170°C (air chaud/chaleur tournante: 150°C).\",\"Farce:\",\"Mixer tous les ingrédients, rectifier l'assaisonnement.\",\"Saler légèrement les tranches d'aubergine sur chaque face.\",\"Laisser dégorger env. 15 min.\",\"Tamponner les aubergines avec du papier ménage.\",\"Faire chauffer la crème à rôtir dans une poêle.\",\"Cuire les tranches d'aubergine 2-3 min sur chaque face.\",\"Réserver.\",\"Sauce tomate:\",\"Faire chauffer la crème à rôtir, faire revenir l'ail.\",\"Ajouter les tomates pelées et le sucre, laisser réduire env. 10 min.\",\"Saler, poivrer.\",\"Répartir la sauce dans le plat à gratin.\",\"Déposer env. 2 cc de farce à l'extrémité de chaque tranche d'aubergine, puis rouler.\",\"Disposer les involtini ainsi formés dans la sauce tomate, ouverture vers le bas.\",\"Parsemer de mozzarella.\",\"Cuire env. 15 min au milieu du four chaud.\",\"Avant de servir, décorer de basilic frais.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Végétarien\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2021_CHDO_28/involtini-daubergine-aux-noisettes/\",\"notes\":\"\",\"paprikaUid\":\"4AF33CB0-094E-4485-A333-446B758454B8\"},{\"id\":\"hwachae-punch-coreen-aux-fruits-mrryzejuifn\",\"title\":\"Hwachae (Punch coréen aux fruits)\",\"category\":\"Boisson\",\"time\":15,\"servings\":4,\"ingredients\":[[\"(environ 3,5 kg)\",1,\"pastèque\"],[\"limonade\",150,\"ml\"],[\"1 cm\",1,\"pomme évidée et coupée en cubes de\"],[\"surgelées\",100,\"g myrtilles\"]],\"steps\":[\"Retirez la peau de la pastèque et coupez la chair en cubes de 2 cm.\",\"Mettez 1/4 de la pastèque dans un robot culinaire.\",\"Mixez jusqu'à obtenir un jus.\",\"Versez dans un saladier et mélangez avec la limonade.\",\"Ajoutez une poignée de glace, les pommes, les myrtilles surgelées et les morceaux de pastèque.\",\"Servez immédiatement dans de petits bols.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Boisson\",\"Corée\"],\"source\":\"https://www.saveurs-magazine.fr/recettes/boissons/hwachae-punch-coreen-aux-fruits/\",\"notes\":\"\",\"paprikaUid\":\"55E50BF2-E730-446D-82B4-BF38FC32A33B\"},{\"id\":\"hot-dog-a-la-carotte-mrryzejt7jh\",\"title\":\"Hot-Dog à la carotte\",\"category\":\"Snack\",\"time\":60,\"servings\":4,\"ingredients\":[[\"fane\",4,\"u carotte\"],[\"d'olive\",2,\"tbsp huile\"],[\"curry\",1,\"c. à café\"],[\"sel\",\"\",\"\"],[\"d'ail\",4,\"u gousses\"],[\"œuf\",2,\"u\"],[\"ciboulette\",1,\"u\"],[\"mayonnaise\",4,\"c. à soupe\"],[\"nature\",2,\"tbsp yogourt\"],[\"poivre\",\"\",\"\"],[\"mous\",4,\"u petits pains\"],[\"oignon\",1,\"u\"]],\"steps\":[\"Préchauffer le four à 190 °C.\",\"Éplucher les carottes et déposer dans un récipient allant au four.\",\"Couper les fanes et réserver.\",\"Mélanger les carottes à l'huile avec le curry.\",\"Relever de sel puis faire cuire env. 45 min au milieu du four.\",\"Les retourner de temps en temps.\",\"min avant la fin de la cuisson, ajouter les gousses d'ail non épluchées.\",\"Entre-temps, hacher grossièrement les œufs durs et ciseler finement la ciboulette.\",\"Mélanger le tout à la mayonnaise avec le yogourt.\",\"Presser l'ail et l'incorporer aux œufs en sauce.\",\"Assaisonner de sel et de poivre.\",\"Couper en deux les petits pains et les faire brièvement griller au four.\",\"Les dresser avec les carottes, les œufs en mayonnaise et la roquette.\",\"Parsemer des fanes ciselées et servir.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Snack\"],\"source\":\"https://migusto.migros.ch/fr/recettes/hot-dog-a-la-carotte\",\"notes\":\"\",\"paprikaUid\":\"D7D89C6A-EA38-4545-9EE9-E2E939A8A9DD\"},{\"id\":\"hot-dog-avec-chipolata-mrryzejqcfs\",\"title\":\"Hot-Dog avec chipolata\",\"category\":\"Snack\",\"time\":20,\"servings\":4,\"ingredients\":[[\"grains\",2,\"tsp moutarde à gros\"],[\"rouge\",1,\"tsp vinaigre de vin\"],[\"d’olive\",2,\"tbsp huile\"],[\"ketchup\",2,\"c. à soupe\"],[\"d´ail\",1,\"u gousse\"],[\"sel\",\"\",\"\"],[\"tabasco\",\"\",\"\"],[\"carottes\",2,\"u\"],[\"pains\",4,\"u petits\"],[\"chipolatas\",4,\"u\"],[\"(tranche)\",4,\"u lard\"],[\"roquette\",50,\"g\"]],\"steps\":[\"Mélanger la moutarde, le vinaigre, l’huile et le ketchup en une sauce.\",\"Presser l’ail par-dessus.\",\"Relever de sel et de tabasco.\",\"Râper grossièrement les carottes et les mélanger à la sauce.\",\"Préchauffer le gril à 220 °C.\",\"Couper en deux les petits pains, sans les trancher complètement.\",\"Griller les chipolatas, enrobées de lard, à feu moyen durant env. 10 min.\",\"Griller les petits pains et les laisser env. 5 min.\",\"Les garnir de carottes et de roquette.\",\"Puis y déposer une chipolata.\",\"Servir avec le reste de la sauce.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Snack\"],\"source\":\"https://migusto.migros.ch/fr/recettes/hot-dog-avec-chipolata-enrobee-de-lard-grille\",\"notes\":\"\",\"paprikaUid\":\"35ECF854-53DA-4F12-846C-09C8B4801D7A\"},{\"id\":\"haricots-blancs-al-limone-mrryzejplml\",\"title\":\"Haricots blancs al limone\",\"category\":\"Italie\",\"time\":30,\"servings\":4,\"ingredients\":[[\"levure\",4,\"c. à soupe flocons de\"],[\"poireau\",400,\"g\"],[\"citrons\",1,\"\"],[\"d'olive\",2,\"c. à soupe huile\"],[\"2½ dl crème entière\",\"\",\"\"],[\"blancs\",2,\"boîte haricots\"],[\"légumes\",1,\"dl bouillon de\"],[\"aneth\",0.5,\"bouquet\"],[\"sel\",\"\",\"\"]],\"steps\":[\"Faire chauffer l'huile dans une grande poêle anti-adhésive.\",\"Y faire revenir le poireau pendant 3 min.\",\"Baisser le feu.\",\"Ajouter les haricots et tous les ingrédients jusqu'à la levure comprise.\",\"Laisser mijoter pendant env. 10 min en remuant de temps en temps.\",\"Ajouter l'aneth, le zeste et le jus de citron.\",\"Mélanger et assaisonner.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Saison Hiver\"],\"source\":\"https://fooby.ch/fr/recettes/26837/haricots-blancs-al-limone\",\"notes\":\"\",\"paprikaUid\":\"E20F1D92-7D90-422E-9173-EB0D3C085D2D\"},{\"id\":\"hamburger-de-veau-by-caminada-mrryzejohgc\",\"title\":\"Hamburger de veau by Caminada\",\"category\":\"Plat principal\",\"time\":0,\"servings\":4,\"ingredients\":[[\"(épaule)\",400,\"g viande de veau\"],[\"(tessinois)\",160,\"g pain blanc\"],[\"crème\",1.5,\"dl\"],[\"beurre\",50,\"g\"],[\"oignon\",1,\"u\"],[\"d’ail\",1,\"u gousse\"],[\"persil\",\"\",\"\"],[\"œuf\",1,\"u\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"moutarde\",\"\",\"\"],[\"panure\",\"\",\"\"],[\"concombre\",2,\"u\"],[\"vinaigre blanc\",\"\",\"\"],[\"huile de colza\",\"\",\"\"],[\"aneth\",\"\",\"\"]],\"steps\":[\"Zwiebeln, Knoblauch und Petersilie fein hacken und in etwas Butter andünsten, würzen.\",\"Das Weissbrot (ohne Rinde) in kleine Würfel schneiden, dazugeben und mit 100 ml Rahm ablöschen und auskühlen lassen.\",\"Das Fleisch durch die feine Scheibe des Wolfes drehen.\",\"Die Weissbrot-Zwiebelmischung ebenfalls durch den Wolf drehen.\",\"(ist kein Wolf vorhanden, kann das Fleisch im Thermomix angemixt, die Brotmischung separat gemixt und dann zusammengemischt werden).\",\"Die Brot- und Fleischmasse zusammen vermengen, abschmecken und mit dem restlichen Rahm zu einer fluffigen Masse verrühren.\",\"Das Ei dazugeben, nochmals abschmecken.\",\"Zu Tätschli formen.\",\"Kurz in Parniermehl wenden und in der Pfanne mit gesottener Butter goldgelb ausbacken.\",\"Gurkensalat :\",\"Gurken schälen, in feine Scheiben schneiden, salzen und mindestens 30 Minuten (am besten aber über Nacht) stehen lassen.\",\"Das Gurkenwasser abschütten.\",\"Die Gurkenscheiben mit Essig und Öl marinieren und mit Salz und Dill abschmecken.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Saison Été\"],\"source\":\"https://www.gaultmillau.ch/rezepte/kalbfleisch-hacktatschli-by-caminada-349063\",\"notes\":\"\",\"paprikaUid\":\"6047EF77-7B93-4950-AF01-6F2BACE0509C\"},{\"id\":\"gateau-fondant-aux-poires-mrryzejnyfg\",\"title\":\"Gâteau fondant aux poires\",\"category\":\"Gâteau\",\"time\":0,\"servings\":4,\"ingredients\":[[\"Poire\",4,\"\"],[\"Farine\",150,\"g\"],[\"poudre\",100,\"g Sucre en\"],[\"Œuf\",2,\"\"],[\"Lait\",1,\"dl\"],[\"Huile\",3,\"c. à soupe\"],[\"chimique\",2,\"tsp Levure\"],[\"Sel\",\"\",\"\"],[\"Beurre\",\"\",\"\"],[\"POUR LA FINITION :\",\"\",\"\"],[\"Beurre\",80,\"g\"],[\"Œuf\",1,\"\"],[\"poudre\",3,\"tbsp Sucre en\"]],\"steps\":[\"Dans un saladier, mettez le sucre, les œufs et 1 pincée de sel.\",\"Fouettez le mélange jusqu'à ce que la préparation mousse et fasse un ruban lorsque vous soulevez le fouet.\",\"Incorporez la farine et le sachet de levure.\",\"Délayez la pâte avec le lait et l'huile.\",\"Préchauffez le four à 180°C.\",\"Versez la moitié de la pâte dans un moule de 24 cm de diamètre, préalablement beurré et fariné.\",\"Pelez les poires, puis coupez-les en lamelles.\",\"Disposez ces dernières sur la pâte au fur et à mesure.\",\"Versez la seconde moitié de la pâte.\",\"Enfournez et faites cuire 30 min.\",\"Faites fondre le beurre à feu doux.\",\"Dans un saladier, fouettez l’œuf avec le sucre et, lorsque le mélange est parfaitement homogène, incorporez le beurre fondu.\",\"Au bout des 30 min de cuisson, sortez le gâteau du four et versez cette préparation à la surface.\",\"Replacez le gâteau au four et poursuivez la cuisson encore 20 min.\",\"Laissez refroidir dans le moule.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Gâteau\"],\"source\":\"https://www.cuisineaz.com/recettes/gateau-fondant-aux-poires-11219.aspx\",\"notes\":\"\",\"paprikaUid\":\"2FF63F10-AC42-4291-A11D-A5DF8E3ECC46\"},{\"id\":\"gateau-des-nonnes-mrryzejmsa3\",\"title\":\"Gâteau des nonnes\",\"category\":\"Gâteau\",\"time\":75,\"servings\":10,\"ingredients\":[[\"ricotta\",750,\"g\"],[\"œuf\",6,\"u\"],[\"sucre\",270,\"g\"],[\"d'amandes\",270,\"g farine\"],[\"citron\",2,\"u\"],[\"sel\",\"\",\"\"],[\"sucre glace\",\"\",\"\"]],\"steps\":[\"Préchauffer le four à 170°.\",\"Casser les œufs dans un grand bol.\",\"Ajouter le sucre et foueter pendant environ 5 minutes, jusqu'à obtenir un mélange clair, gonflé et mousseux.\",\"Parfumer le mélange avec le zeste râpé des citrons, en veillant à ne prélever que la partie jaune.\",\"Continuer à mélanger, puis incorporer la ricotta petit à petit, en en ajoutant une cuillerée à la fois et en attendant qu'elle soit absorbée avant d'ajouter la suivante.\",\"Dans un bol à part, mélanger la farine d'amande avec le sel.\",\"Verser ensuite progressivement dans le bol.\",\"Travailler encore quelques instants, jusqu'à obtenir une pâte homogène, souple et assez crémeuse.\",\"Chemiser un moule de 26 cm de diamètre avec du papier sulfurisé et remplisser avec la préparation.\",\"Niveler délicatement la surface avec une spatule et enfourner pendant environ 60 minutes, en plaçant le moule sur la grille centrale.\",\"Une fois cuit, laisser le gâteau refroidir complètement dans le moule.\",\"Lorsqu'il sera froid, transférer le gâteau des nonnes sur un plat de service et saupoudrer de sucre glace.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Gâteau\"],\"source\":\"https://www.giallozafferano.fr/recettes/gateau-des-nonnes.html\",\"notes\":\"\",\"paprikaUid\":\"E9B5A0BE-F593-48C7-9E0B-C01B608EF789\"},{\"id\":\"gateau-aux-epinards-mrryzejlveu\",\"title\":\"Gâteau aux épinards\",\"category\":\"Gâteau\",\"time\":40,\"servings\":4,\"ingredients\":[[\"brisée\",1,\"pâte\"],[\"épinard\",150,\"g\"],[\"œuf\",2,\"\"],[\"d’œuf\",1,\"jaune\"],[\"beurre\",15,\"g\"],[\"farine\",10,\"g\"],[\"lait\",0.5,\"dl\"],[\"blanc\",0.5,\"dl vin\"],[\"sel\",6,\"g\"],[\"muscade\",5,\"g\"],[\"fromage\",45,\"g\"]],\"steps\":[\"Préchauffer le four à 190°.\",\"Porter de l'eau salée à ébullition.\",\"Ajouter l'épinard et laisser cuire 5 min.\",\"Sortir l'épinard et verser dans de l'eau glacée.\",\"Égoutter et réserver.\",\"Râper le fromage.\",\"Fondre le beurre dans une casserole.\",\"Ajouter la farine.\",\"Brasser à l'aide d'un fouet jusqu'à l'obtention d'un roux.\",\"Ajouter le lait, le sel et le muscade.\",\"Bien mélanger.\",\"Retirer du feu.\",\"Ajouter le vin et le fromage râpé.\",\"Bien mélanger.\",\"Ajouter l'épinard.\",\"Ajouter les œufs et le jaune d'œuf.\",\"Mixer le tout.\",\"Beurrer un plat allant au four.\",\"Dérouler la pâte sans le papier.\",\"Y verser l'appareil à l'épinard.\",\"Mettre au four pendant 20 min.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Gâteau\",\"Végétarien\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"EE5434EF-A654-46AC-A15C-C1D76ED238AA\"},{\"id\":\"gateau-aux-pruneaux-de-maman-mrryzejfloh\",\"title\":\"Gâteau aux pruneaux de maman\",\"category\":\"Dessert\",\"time\":80,\"servings\":8,\"ingredients\":[[\"citrons\",1,\"\"],[\"pruneaux\",750,\"g\"],[\"sucre\",150,\"g\"],[\"blanche\",200,\"g farine\"],[\"lever\",0.75,\"c. à café poudre à\"],[\"effilées\",3,\"c. à soup amandes\"],[\"sucre\",2,\"c. à soupe\"],[\"beurre\",150,\"g\"],[\"œufs\",3,\"\"],[\"crème\",2,\"dl\"],[\"sel\",1,\"pincée\"],[\"cannelle\",0.5,\"c. à café\"]],\"steps\":[\"Dans un saladier, mélanger le beurre, le sucre et le sel.\",\"Ajouter les œufs l'un après l'autre.\",\"Continuer de mélanger jusqu'à ce que la masse blanchisse.\",\"Ajouter le zeste et le jus de citron, mélanger.\",\"Mélanger la farine et la poudre à lever.\",\"Incorporer à la masse.\",\"Foncer le moule avec la pâte ainsi obtenue.\",\"Disposer les moitiés de pruneaux à la verticale dans la pâte.\",\"Parsemer d'amandes effilées.\",\"Faire cuire env. 60 min. dans le bas du four préchauffé à 180 °C.\",\"Sortir du four et laisser refroidir dans le moule.\",\"Fouetter la crème avec le sucre et la cannelle.\",\"Servir avec le gâteau.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Dessert\",\"Gâteau\",\"Suisse\"],\"source\":\"https://fooby.ch/fr/recettes/7641/gateau-aux-pruneaux-de-maman\",\"notes\":\"\",\"paprikaUid\":\"964A4E49-A559-4AA4-9CC2-ED7650FC81A4\"},{\"id\":\"gateau-aux-pommes-a-l-air-fryer-mrryzeje03y\",\"title\":\"Gâteau aux pommes à l'air fryer\",\"category\":\"Gâteau\",\"time\":105,\"servings\":6,\"ingredients\":[[\"pomme\",480,\"g\"],[\"farine\",250,\"g\"],[\"sucre\",120,\"g\"],[\"œuf\",2,\"u\"],[\"beurre\",100,\"g\"],[\"entier\",1,\"dl lait\"],[\"chimique\",1,\"u levure\"],[\"citron\",20,\"g jus de\"],[\"citron\",1,\"u zeste de\"],[\"sel\",\"\",\"\"],[\"sucre\",20,\"g\"],[\"glace\",10,\"g sucre\"]],\"steps\":[\"Eplucher les pommes et couper la moitié en dés et l'autre moitié en fikes tranches.\",\"Transférer les dés et les tranches de pommes dans des bols séparés.\",\"Arroser de jus de citron et réservez.\",\"Faire fondre le beurre et laisser tiédir.\",\"Dans un grand bol, verser les œufs, le sucre et le zeste de citron râpé.\",\"Ajouter le beurre fondu tiède et le lait, en mélangeant bien au fouet pour homogénéiser la préparation.\",\"Incorporez la farine tamisée.\",\"Ajouter la levure chimique tamisée et mélanger.\",\"Incorporer les dés de pomme et mélangez soigneusement avec une spatule.\",\"Verser la pâte dans un moule beurré et égalisez bien.\",\"Disposez les tranches de pomme sur le dessus et saupoudrez de sucre.\",\"Placer-le dans le panier de la friteuse à air et faire cuire à 155 C pendant 40 minutes.\",\"Après 10 minutes, couvrir d'une feuille d'aluminium.\",\"Après les 40 minutes, baisser la température à 150 C et poursuivre la cuisson pendant encore 10 minutes.\",\"Réduir la température à 140 C et faire cuire encore 20 minutes.\",\"Abaisser la température à 135 C et laisser cuire pendant 15 minutes supplémentaires.\",\"Faire le test du cure-dent pour vérifier la cuisson.\",\"Une fois cuit, laisser refroidir avant de saupoudrer de sucre glace.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Gâteau\"],\"source\":\"https://www.giallozafferano.fr/recettes/gateau-aux-pommes-a-la-friteuse-a-air.html\",\"notes\":\"\",\"paprikaUid\":\"FC8D260D-EE31-4473-8B0C-FA7388F0077B\"},{\"id\":\"gateau-aux-poires-mrryzejdnuy\",\"title\":\"Gâteau aux poires\",\"category\":\"Dessert\",\"time\":105,\"servings\":8,\"ingredients\":[[\"poire\",8,\"u\"],[\"citron\",1,\"u\"],[\"sucre\",100,\"g\"],[\"moulues\",100,\"g noisettes\"],[\"blanche\",250,\"g farine\"],[\"lever\",1,\"tsp poudre à\"],[\"1½ tbsp sucre\",\"\",\"\"],[\"beurre\",50,\"g\"],[\"œuf\",2,\"u\"],[\"citron\",2,\"tsp jus de\"],[\"sel\",\"\",\"\"]],\"steps\":[\"Râper le zeste du citron et réserver.\",\"Presser le jus.\",\"Peler la moitié des poires, les épépiner et les couper en morceaux.\",\"Faire cuire les poires et le jus de citron dans un peu d'eau à couvert et à petit feu pendant env. 10 min.\",\"Égoutter et mixer.\",\"Laisser refroidir.\",\"Préchauffer le four à 180° et mettre une grille dans la partie inférieure.\",\"Chemiser de papier sulfurisé le fond d'un moule à charnière de 24 cm de ø.\",\"Graisser les bords.\",\"Couper le beurre en petits morceaux.\",\"Dans un saladier, mélanger le beurre, le sucre et le sel.\",\"Ajouter les œufs.\",\"Bien mélanger jusqu'à ce que la masse blanchisse.\",\"Incorporer le zeste du citron, la purée de poires et les noisettes.\",\"Bien mélanger.\",\"Mélanger la farine et la levure chimique.\",\"Ajouter la farine à la pâte.\",\"Bien mélanger et verser l'appareil dans le moule.\",\"Peler le reste des poires, les épépiner, les couper en deux.\",\"Couper de très fines entailles dans les demi-poires, sans les couper complètement.\",\"Les répartir sur la pâte.\",\"Les saupoudrer de sucre.\",\"Enfourner env. 1 h dans le bas du four.\",\"Retirer du four et laisser refroidir un peu.\",\"Enlever le bord du moule et glisser le gâteau sur une grille.\",\"Laisser refroidir.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Dessert\",\"Gâteau\",\"Suisse\"],\"source\":\"https://fooby.ch/fr/recettes/9282/gateau-aux-poires\",\"notes\":\"\",\"paprikaUid\":\"5436AA51-02CA-45BF-A0EC-65AF2811B079\"},{\"id\":\"gateau-aux-fraises-en-5-minutes-mrryzejc4bw\",\"title\":\"Gâteau aux fraises en 5 minutes\",\"category\":\"Gâteau\",\"time\":50,\"servings\":6,\"ingredients\":[[\"fraise\",350,\"g\"],[\"farine\",250,\"g\"],[\"entier\",125,\"g lait\"],[\"œuf\",3,\"u\"],[\"sucre\",125,\"g\"],[\"beurre\",125,\"g\"],[\"vanille\",1,\"u gousse de\"],[\"chimique\",10,\"g levure\"],[\"sucre glace\",\"\",\"\"]],\"steps\":[\"Préchauffer le four à 200°.\",\"Détacher les petites feuilles des fraises ; réserver quelques-unes.\",\"Les couper en petits dés.\",\"Couper le reste en tranches pour décorer la surface.\",\"Dans un grand bol, verser les œufs entiers avec le sucre.\",\"Mélanger au fouet sans monter.\",\"Incorporer le beurre fondu tiédi et les graines de la gousse de vanille.\",\"Incorporer la farine et la levure chimique tamisées ensemble à travers un tamis pour éliminer les grumeaux et mélanger, en alternant, avec le lait versé en filet.\",\"Lorsque la pâte sera lisse, ajouter délicatement les dés de fraise et mélanger pour bien les répartir.\",\"Verser le tout dans un moule de 20 cm préalablement beurré et fariné.\",\"Terminer le gâteau en disposant sur la surface les fraises en tranches et en le saupoudrant d'un peu de sucre.\",\"Cuire au four pendant environ 45 à 50 minutes.\",\"Une fois cuite, sortir du four et laisser tiédir.\",\"Saupoudrer de sucre glace et servir.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Gâteau\"],\"source\":\"https://www.giallozafferano.fr/recettes/gateau-aux-fraises-en-5-minutes.html\",\"notes\":\"\",\"paprikaUid\":\"231D68C3-2627-464E-B363-3DA1B2121876\"},{\"id\":\"gateau-aux-carottes-mrryzejbub8\",\"title\":\"Gâteau aux carottes\",\"category\":\"Dessert\",\"time\":185,\"servings\":12,\"ingredients\":[[\"Pâte:\",\"\",\"\"],[\"ramolli\",50,\"g beurre\"],[\"d'œufs\",5,\"jaunes\"],[\"sucre\",200,\"g\"],[\"citron, zeste râpé\",0.5,\"\"],[\"amandes, moulues\",200,\"g\"],[\"carottes, finement râpées\",250,\"g\"],[\"farine\",100,\"g\"],[\"lever\",0.5,\"c. à café poudre à\"],[\"poudre\",0.5,\"c. à café cannelle en\"],[\"poudre\",1,\"pincée clou de girofle en\"],[\"œufs\",5,\"blancs\"],[\"sel\",1,\"pincée de\"],[\"d'abricots\",100,\"g confiture\"],[\"Glaçage:\",\"\",\"\"],[\"glace\",250,\"g sucre\"],[\"citron\",3,\"c. à soupe jus de\"],[\"décorer\",12,\"carottes en massepain pour\"]],\"steps\":[\"Préchauffer le four à 160°C chaleur tournante (chaleur traditionnelle: 180°C).\",\"Pâte:\",\"Battre en mousse au batteur électrique le beurre, les jaunes d'œufs, le sucre et le zeste de citron jusqu'à ce que le mélange blanchisse.\",\"Ajouter les amandes et les carottes.\",\"Incorporer les carottes au mélange.\",\"Mélanger la farine, la poudre à lever et les épices, ajouter en tamisant, mélanger.\",\"Monter les blancs d'œufs en neige avec le sel et incorporer délicatement à l'aide d'une spatule.\",\"Verser dans le moule préparé.\",\"Cuire 50-55 min dans le bas du four.\",\"Sortir du four, laisser refroidir brièvement.\",\"Démouler et renverser sur une grille.\",\"Chauffer la confiture, passer au tamis.\",\"Badigeonner la surface et les bords du gâteau encore chaud.\",\"Laisser refroidir entièrement.\",\"Glaçage:\",\"Mélanger le sucre glace avec le jus de citron jusqu'à l'obtention d'une consistance épaisse.\",\"Verser le glaçage au centre du gâteau et répartir de manière uniforme sur toutes les faces en inclinant légèrement le gâteau.\",\"Laisser sécher.\",\"Décorer de carottes en massepain.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Dessert\",\"Suisse\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM201205_60/gateau-aux-carottes/?collection=97824\",\"notes\":\"\",\"paprikaUid\":\"5553C423-110E-478E-B6DC-F30531DE123E\"},{\"id\":\"gateau-aux-asperges-et-la-ricotta-mrryzeja2pa\",\"title\":\"Gâteau aux asperges et la ricotta\",\"category\":\"Asperges\",\"time\":30,\"servings\":4,\"ingredients\":[[\"gâteau\",1,\"u pâte à\"],[\"verte\",500,\"g asperge\"],[\"d'olive\",2,\"tbsp huile\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"sucre\",\"\",\"\"],[\"ricotta\",250,\"g\"],[\"œuf\",3,\"u\"],[\"italiennes\",2,\"tbsp herbes\"],[\"noix de muscade\",\"\",\"\"],[\"cerise\",75,\"g tomate\"]],\"steps\":[\"Den Teig aus dem Kühlschrank nehmen.\",\"Den Spargel waschen, im unteren Drittel schälen, dann schräg in Stücke schneiden.\",\"Das Öl in einer Pfanne leicht erhitzen.\",\"Den Spargel darin 3-4 Min. leicht anbraten.\",\"Mit Salz und Zucker würzen.\",\"Vom Herd nehmen.\",\"Den Backofen auf 200° vorheizen.\",\"Den Teig aus der Packung nehmen, einmal zusammenklappen und etwa in der Größe der Form ausrollen.\",\"Die Form damit auskleiden. Überstehenden Teig wegschneiden.\",\"Den Teigboden mit einer Gabel mehrmals einstechen.\",\"Ricotta mit den Eiern, den Kräutern, Salz, Pfeffer und 1 Prise Muskatnuss verquirlen und auf den Mürbeteigboden geben.\",\"Den Spargel darauf verteilen.\",\"Die Kirschtomaten waschen und halbieren.\",\"Mit den Rundungen nach unten zwischen die Spargelstangen legen.\",\"Nach Belieben noch 3 oder 4 Cocktailtomaten ganz lassen und dazwischenlegen.\",\"Die Tarte im Ofen (Mitte) ca. 30 Min. backen.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asperges\",\"Gâteau\",\"Saison Printemps\",\"Végétarien\"],\"source\":\"https://www.kuechengoetter.de/rezepte/spargeltarte-mit-ricotta-72865\",\"notes\":\"\",\"paprikaUid\":\"8BD26B90-39C4-495E-804E-3B03BD6103D2\"},{\"id\":\"gateau-aux-abricots-by-caminada-mrryzej93t5\",\"title\":\"Gâteau aux abricots by Caminada\",\"category\":\"A\",\"time\":0,\"servings\":4,\"ingredients\":[[\"abricot, grand\",10,\"u\"],[\"Pâte :\",\"\",\"\"],[\"farine\",130,\"g\"],[\"beurre\",50,\"g\"],[\"eau\",40,\"g\"],[\"sucre\",15,\"g\"],[\"sel\",2,\"g\"],[\"Remplissage royal :\",\"\",\"\"],[\"crème\",200,\"ml\"],[\"sucre\",25,\"g\"],[\"Maizena\",10,\"g\"],[\"œuf\",1,\"u\"],[\"d’œuf\",1,\"u jaune\"],[\"cannelle\",1,\"pincée\"],[\"sel\",1,\"pincée\"],[\"vanille\",1,\"u gousse de\"],[\"zeste de citron\",\"\",\"\"],[\"amandes/noisettes moulues\",3,\"c. à soupe\"],[\"Glaçage :\",\"\",\"\"],[\"abricots\",2,\"tbsp confiture aux\"],[\"abricots\",1,\"tbsp liqueur aux\"],[\"fines tranches d'amandes\",\"\",\"\"],[\"sucre glacé\",\"\",\"\"]],\"steps\":[\"Kuchenteig\\t:\",\"Kalte Butter würfeln.\",\"Aus allen Zutaten einen Kuchenteig kneten und 20-30 Minuten kaltstellen.\",\"Den Teig 4 mm dick auswallen.\",\"Aprikosen :\",\"Aprikosen entsteinen und halbieren.\",\"Ofen auf 200° vorheizen.\",\"Royal-Guss :\",\"Vanilleschote auskratzen.\",\"Alle Zutaten miteinander mixen.\",\"Aprikosenwähe\\t :\",\"Die Backform ausbuttern und mehlieren.\",\"Den Teig auswallen und in die Form legen.\",\"Mit einer Gabel den Boden vollständig einstechen.\",\"Den Boden mit gemahlenen Mandeln oder Haselnüssen bestreuen.\",\"Mit Aprikosenhälften belegen und den Royal-Guss zwischen die Aprikosenhälften eingiessen.\",\"Im Ofen bei 200 Grad ca. 30 Minuten backen.\",\"Die Wähe aus dem Ofen nehmen und in der Form abkühlen lassen.\",\"Apricotieren :\",\"Konfitüre und Schnaps zusammen kurz erhitzen und die Oberfläche des Kuchens mit der Flüssigkeit bepinseln.\",\"Fertigstellen :\",\"Nach Belieben den Rand mit gerösteten Mandelblättchen dekorieren und mit Puderzucker bestäuben.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"A\",\"Gâteau\"],\"source\":\"https://www.gaultmillau.ch/rezepte/aprikosenwahe-by-caminada-377579?gad_source=1&gad_campaignid=22650931153&gbraid=0AAAAADuKDKzwdTC4maG3EdL0-qiOsXTxQ&gclid=EAIaIQobChMIrNjRkeC0lQMVvpmDBx1I3CxNEAAYASAAEgJNjPD_BwE\",\"notes\":\"\",\"paprikaUid\":\"9103462E-E3EB-475B-9BFF-BA0DB012ED33\"},{\"id\":\"gateau-au-fromage-corse-mrryzej87q7\",\"title\":\"Gâteau au fromage corsé\",\"category\":\"Gâteau\",\"time\":75,\"servings\":8,\"ingredients\":[[\"verts\",2,\"poivrons\"],[\"rouges\",1,\"piments\"],[\"oignons\",1,\"\"],[\"huile\",1,\"c. à soupe\"],[\"blanche\",250,\"g farine\"],[\"levure\",\"⅓\",\"dé\"],[\"blanche\",1,\"c. à soupe farine\"],[\"beurre\",25,\"g\"],[\"lait\",3,\"dl\"],[\"mi-salé\",250,\"g Tilsiter\"],[\"nature\",180,\"g yogourt\"],[\"œufs\",1,\"\"],[\"sel\",2,\"c. à café\"],[\"noix de muscade\",\"\",\"\"]],\"steps\":[\"Mélanger la farine, le sel et la levure dans un bol.\",\"Ajouter le beurre, du bout des doigts sabler en une masse grumeleuse uniforme.\",\"Verser le lait, rassembler rapidement en pâte sans pétrir.\",\"Abaisser la pâte sur un peu de farine en rond.\",\"Poser sur la plaque, piquer à la fourchette.\",\"Chauffer l'huile dans une poêle.\",\"Saisir les poivrons sur feu moyen env. 10 minutes.\",\"Ajouter le piment, saler, laisser refroidir.\",\"Mélanger le fromage, l'oignon et la farine.\",\"Incorporer le yogourt et le reste des ingrédients.\",\"Verser la masse au fromage sur la pâte.\",\"Répartir les poivrons dessus.\",\"Cuisson:\",\"Env. 40 min dans la moitié inférieure du four pré-chauffé à 200° C.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Gâteau\",\"Plat principal\",\"Suisse\"],\"source\":\"https://fooby.ch/fr/recettes/9514/gateau-au-fromage-corse-\",\"notes\":\"\",\"paprikaUid\":\"0C816F8B-88B5-4488-96DA-AA1FD9BA7CAF\"},{\"id\":\"gratin-de-spatzli-aux-legumes-mrryzej7p6a\",\"title\":\"Gratin de Spätzli aux légumes\",\"category\":\"Gratin\",\"time\":50,\"servings\":4,\"ingredients\":[[\"haché\",1,\"oignon finement\"],[\"saison, p. ex. carottes, céleri, courge, grossièrement râpés ou coupés en petits morceaux\",600,\"g légumes de\"],[\"Spätzli\",500,\"g\"],[\"râpé\",200,\"g fromage\"],[\"Liaison:\",\"\",\"\"],[\"œufs\",3,\"\"],[\"lait\",4,\"dl\"],[\"thym\",2,\"c. à soupe feuilles de\"],[\"sel\",\"\",\"\"],[\"poivre du moulin\",\"\",\"\"],[\"noix de muscade\",\"\",\"\"],[\"thym pour décorer\",\"\",\"\"]],\"steps\":[\"Mélanger les oignons, les légumes, les spätzlis et le fromage.\",\"Mettre dans le plat beurré.\",\"Liaison:\",\"Mélanger tous les ingrédients.\",\"Saler, poivrer.\",\"Ajouter la noix de muscade.\",\"Verser sur les spätzli.\",\"Cuire 35-40 min au milieu du four préchauffé à 200°C.\",\"Décorer.\",\"Servir chaud.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Gratin\",\"Plat principal\",\"Végétarien\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM201101_79/gratin-de-spaetzli-aux-legumes/\",\"notes\":\"\",\"paprikaUid\":\"18B3297C-BCB2-4E4C-BC02-A6AA7FC7D95D\"},{\"id\":\"gratin-de-pommes-de-terre-mrryzej7tut\",\"title\":\"Gratin de pommes de terre\",\"category\":\"Gratin\",\"time\":0,\"servings\":4,\"ingredients\":[[\"farineuse\",800,\"g pomme de terre\"],[\"Sbrinz\",50,\"g\"],[\"lait\",3,\"dl\"],[\"entière\",1,\"dl crème\"],[\"laurier\",1,\"u feuille de\"],[\"romarin\",2,\"c. à soupe\"],[\"d'ail\",1,\"u gousse\"]],\"steps\":[\"Liaison:\",\"Porter à ébullition le lait et la crème avec le laurier et le romarin.\",\"Ajouter l'ail pressé.\",\"Enlever de la plaque et laisser tirer pendant 30 minutes.\",\"Gratin:\",\"Préchauffer le four à 180°.\",\"Râper le fromage.\",\"Éplucher les pommes de terre et couper-les dans le sens de la longueur en tranches de 2 mm.\",\"Placer les tranches enroulées et debout dans un plat à gratin.\",\"Ajouter régulièrement du fromage râpé entre les tranches.\",\"Verser la liaison à travers un tamis sur les tranches.\",\"Enfourner pendant 1 h au milieu du four.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Gratin\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"DFD1F4DB-A7DA-4ED4-B193-49695DEB67F0\"},{\"id\":\"gratin-de-pain-a-la-cote-de-bette-mrryzej1m4v\",\"title\":\"Gratin de pain à la côte de bette\",\"category\":\"Gratin\",\"time\":40,\"servings\":4,\"ingredients\":[[\"complet\",200,\"g pain\"],[\"lait\",2.5,\"dl\"],[\"bette\",700,\"g côte de\"],[\"persil\",1,\"u\"],[\"cumin\",1,\"c. à soupe\"],[\"beurre\",2,\"c. à soupe\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"d'alpage\",150,\"g fromage\"],[\"fraîche\",200,\"g crème\"],[\"œuf\",4,\"u\"]],\"steps\":[\"Das Brot klein würfeln, mit der Milch in einer Schüssel mischen und ziehen lassen.\",\"Den Mangold waschen, die Blätter abschneiden und grob hacken.\",\"Die Stiele in Streifen schneiden.\",\"Die Petersilie waschen und trocken schütteln, die Blättchen abzupfen und fein hacken.\",\"Den Kümmel in einer trockenen Pfanne bei mittlerer Hitze 1 – 2 Min. rösten, dann im Mörser leicht zerstoßen.\",\"Die Butter in der Pfanne schmelzen lassen.\",\"Die Mangoldstiele darin unter Rühren 1 – 2 Min. dünsten. Dann die Blätter dazugeben und dünsten, bis sie zusammenfallen.\",\"Petersilie untermischen. Alles dem Kümmel, Salz und Pfeffer würzen.\",\"Den Backofen auf 180° vorheizen.\",\"Eine feuerfeste Form fetten.\",\"Den Käse fein reiben.\",\"Crème fraîche mit Eiern und Käse verrühren, salzen und pfeffern.\",\"Brot und Mangold locker mit der Eiercreme verrühren und in die Form geben.\",\"Den Auflauf im Backofen (Mitte) etwa 40 Min. backen, bis die Oberfläche schön gebräunt ist.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Gratin\",\"Végétarien\"],\"source\":\"https://www.kuechengoetter.de/rezepte/brotauflauf-mit-mangold-71512\",\"notes\":\"\",\"paprikaUid\":\"252974D3-DAEA-4E5F-BF72-5224CAA4FDC1\"},{\"id\":\"goulasch-a-la-hongroise-mrryzej00ws\",\"title\":\"Goulasch à la hongroise\",\"category\":\"Plat principal\",\"time\":155,\"servings\":4,\"ingredients\":[[\"ferme\",500,\"g pommes de terre à chair\"],[\"jaunes\",1,\"poivrons\"],[\"ail\",2,\"\"],[\"rouges\",1,\"poivrons\"],[\"oignons\",3,\"\"],[\"huile\",1,\"c. à soupe\"],[\"viande\",3,\"dl bouillon de\"],[\"concassées\",1,\"boîte tomates\"],[\"bœuf\",800,\"g ragoût de\"],[\"(cumin)\",1,\"c. à café carvi\"],[\"marjolaine\",1,\"c. à café feuilles de\"],[\"rose\",2,\"c. à café paprika\"],[\"sel\",\"\",\"\"]],\"steps\":[\"Faire chauffer l'huile dans une cocotte.\",\"Y saisir la viande par portions de toutes parts et la remettre dans la cocotte.\",\"Ajouter l'ail et les oignons, étuver pendant env. 3 min et assaisonner.\",\"Mouiller avec le bouillon, porter à ébullition.\",\"Couvrir et laisser mijoter à petit feu pendant env. 1 h 45.\",\"Ajouter les pommes de terre, les poivrons et les tomates.\",\"Couvrir et poursuivre la cuisson pendant env. 30 min.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\"],\"source\":\"https://fooby.ch/fr/recettes/19162/goulasch-a-la-hongroise\",\"notes\":\"\",\"paprikaUid\":\"81B9D46E-FF8B-43B7-91D6-F740D5DC6B27\"},{\"id\":\"gochujang-pasta-pates-coreennes-au-gochujang-mrryzeiz0xn\",\"title\":\"Gochujang Pasta - Pâtes Coréennes Au Gochujang\",\"category\":\"A\",\"time\":20,\"servings\":2,\"ingredients\":[[\"italiennes\",2,\"portions pâtes\"],[\"8 tranches bacon\",4,\"à\"],[\"oignons\",2,\"\"],[\"d'ail\",4,\"gousses\"],[\"d'olive\",1,\"c. à soupe huile\"],[\"beurre\",1,\"noix\"],[\"gochujang\",3,\"c. à soupe\"],[\"soja\",1,\"c. à soupe sauce\"],[\"sucre\",1,\"c. à soupe\"],[\"ketchup\",2,\"c. à soupe\"]],\"steps\":[\"Émincer l'ail, l'oignon et le bacon.\",\"Faire sauter les ingrédients dans une cuillère à soupe d'huile d'olive.\",\"Faire cuire les pâtes\",\"Mélanger les ingrédients de la sauce.\",\"Verser les pâtes cuites avec les ingrédients et faire sauter.\",\"Verser la sauce et mélanger.\",\"Faire sauter encore quelques minutes sur feu vif.\",\"(Optionnel) Ajouter une noix de beurre pour avoir des pâtes plus brillantes.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"A\"],\"source\":\"https://yuns.fr/recette-gochujang-pasta/\",\"notes\":\"\",\"paprikaUid\":\"85220F80-41F7-4E36-BCD5-2DEF76ACC801\"},{\"id\":\"gnudi-a-l-ail-des-ours-et-au-citron-quenelles-mrryzeiyyf8\",\"title\":\"Gnudi à l'ail des ours et au citron (Quenelles)\",\"category\":\"Italie\",\"time\":40,\"servings\":4,\"ingredients\":[[\"ours\",1,\"bouquet ail des\"],[\"basilic\",1,\"bouquet\"],[\"citrons\",1,\"\"],[\"ricotta\",500,\"g\"],[\"parmesan\",110,\"g\"],[\"beurre\",60,\"g\"],[\"pâtes\",4,\"c. à soupe farine à\"],[\"pâtes\",40,\"g farine à\"],[\"sel\",\"\",\"\"]],\"steps\":[\"Mélanger la ricotta, le fromage, la farine et le sel.\",\"Ajouter l'ail des ours, le basilic et le zeste de citron.\",\"Bien mélanger.\",\"A l'aide de 2 cuillères à café, former des petits boulettes ovales.\",\"Mettre la farine dans une assiette creuse.\",\"Y passer les boulettes par portions.\",\"Faire cuire les gnudis par portions dans de l'eau salée frémissante pendant 6 min., jusqu'à ce qu'ils remontent à la surface.\",\"Les sortir avec une écumoire et les égoutter.\",\"Faire fondre le beurre dans une poêle antiadhésive jusqu'à ce qu'il diffuse un léger arôme de noisette.\",\"Ajouter le jus de citron réservé, mélanger.\",\"Ajouter les gnudis, mélanger délicatement et dresser.\",\"Parsemer de basilic et de parmesan.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Saison Printemps\"],\"source\":\"https://fooby.ch/fr/recettes/20962/gnudis-a-l-ail-des-ours-et-au-citron-\",\"notes\":\"\",\"paprikaUid\":\"F7C035B2-B777-47B2-AC20-51D18D934A0D\"},{\"id\":\"gnudi-aux-epinards-et-a-la-ricotta-quenelles-mrryzeixzly\",\"title\":\"Gnudi aux épinards et à la ricotta (Quenelles)\",\"category\":\"Italie\",\"time\":45,\"servings\":4,\"ingredients\":[[\"tomates\",300,\"g de\"],[\"d'épinards\",150,\"g de pousses\"],[\"bio\",1,\"citrons\"],[\"huile\",\"\",\"\"],[\"blanche\",40,\"g de farine\"],[\"ricotta\",250,\"g de\"],[\"râpé\",80,\"g de parmesan\"],[\"œufs\",1,\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"noix de muscade\",\"\",\"\"]],\"steps\":[\"Saler et poivrer les tomates.\",\"Les mixer et les passer au tamis en recueillant le jus.\",\"Faire chauffer l'huile dans une poêle.\",\"Baisser le feu puis ajouter les épinards par portions et les faire suer pendant env. 5 min.\",\"Les égoutter, les laisser refroidir un peu puis les hacher menu.\",\"Mélanger la ricotta avec tous les ingrédients jusqu'à l'œuf compris.\",\"Assaisonner puis ajouter les épinards et mélanger.\",\"A l'aide de 2 cuillères à café, former des petits boulettes ovales.\",\"Les faire cuire dans l'eau frémissante salée pendant env. 10 min.\",\"Les sortir avec une écumoire et les égoutter.\",\"Servir avec la sauce tomate.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\"],\"source\":\"https://fooby.ch/fr/recettes/13707/gnudi-aux-epinards-et-a-la-ricotta\",\"notes\":\"\",\"paprikaUid\":\"3EF38B9D-DEEC-494E-BEE2-48E3EDBC8133\"},{\"id\":\"gnudi-au-beurre-de-sauge-quenelles-mrryzeiw2va\",\"title\":\"Gnudi au beurre de sauge (Quenelles)\",\"category\":\"Italie\",\"time\":35,\"servings\":4,\"ingredients\":[[\"sauge\",1,\"bouquet\"],[\"blanche\",50,\"g farine\"],[\"ricotta\",500,\"g\"],[\"râpé\",130,\"g parmesan\"],[\"beurre\",60,\"g\"],[\"dur\",80,\"g semoule de blé\"],[\"muscade\",0.25,\"c. à café noix de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Mélanger la ricotta et tous les ingrédients jusqu'au poivre compris.\",\"Verser la farine dans une assiette creuse.\",\"À l'aide de deux cuillères à soupe, former des gnudis ovales et les passer dans la farine.\",\"Faire cuire les gnudis en plusieurs fois dans de l'eau salée frémissante pendant 6 min, jusqu'à ce qu'ils remontent à la surface.\",\"Les sortir avec une écumoire, les égoutter et les réserver au chaud.\",\"Faire fondre le beurre dans une poêle antiadhésive.\",\"Ajouter les feuilles de sauge et les faire rissoler pendant 2 min.\",\"Dresser les gnudis et les garnir de beurre de sauge.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\"],\"source\":\"https://fooby.ch/fr/recettes/23497/gnudis-au-beurre-de-sauge\",\"notes\":\"\",\"paprikaUid\":\"A50F1297-5087-4720-BBF4-993D9BC53BCE\"},{\"id\":\"gnocchis-a-l-ail-des-ours-mrryzeivtog\",\"title\":\"Gnocchis à l’ail des ours\",\"category\":\"Plat principal\",\"time\":50,\"servings\":4,\"ingredients\":[[\"pomme de terre farineuse\",800,\"g\"],[\"farine\",200,\"g\"],[\"ail des ours\",3,\"bouquet\"],[\"ricotta\",100,\"g\"],[\"œuf\",1,\"u\"],[\"noix de muscade\",0,\"\"],[\"sel\",0,\"\"],[\"beurre à rôtir\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Cuire les pommes de terre sans les peler env. 20 min à découvert dans l’eau salée bouillante.\",\"Peler les pommes de terre encore chaudes.\",\"Couper en morceaux.\",\"Passer à la moulinette dans un grand bol.\",\"Laisser tiédir un peu.\",\"Incorporer la farine.\",\"Bien laver l’ail des ours. Réserver ¼ pour le décor.\",\"Egoutter et mixer avec la ricotta et l’œuf.\",\"Assaisonner.\",\"Ajouter aux pommes de terre.\",\"Mélanger à la main. Le mélange doit être encore humide, mais ne plus coller aux mains.\",\"Rajouter évt. un peu de farine.\",\"Façonner 4 rouleaux Ø env. 2 cm sur un peu de farine.\",\"Découper en morceaux d’env. 2 cm de long.\",\"Les rouler sur une fourchette en appuyant avec le pouce pour qu’ils gardent l’empreinte des dents de la fourchette.\",\"Déposer les gnocchis sur un linge fariné.\",\"Faire pocher les gnocchis par portions, env. 6 min, dans l’eau salée frémissante jusqu’à ce qu’ils remontent à la surface.\",\"Retirer avec une écumoire, égoutter.\",\"Bien faire chauffer le beurre dans une poêle antiadhésive.\",\"Baisser le feu.\",\"Faire revenir les gnocchis par portions, env. 2 minutes.\",\"Ajouter l'ail des ours réservé et faire revenir un instant.\",\"Saler, poivrer, dresser.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Saison Printemps\",\"modifié\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/gnocchis-a-lail-des-ours-10001236/\",\"notes\":\"\",\"paprikaUid\":\"E8E83380-BE00-4E79-A72B-9935363F74AF\"},{\"id\":\"gnocchis-aux-tomates-cerises-roties-mrryzeiu1lr\",\"title\":\"Gnocchis aux tomates cerises rôties\",\"category\":\"Italie\",\"time\":260,\"servings\":4,\"ingredients\":[[\"terre\",1000,\"g pommes de\"],[\"farine\",300,\"g\"],[\"cerise\",800,\"g tomate\"],[\"huile d'olive\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"poivre noir\",\"\",\"\"],[\"d'ail\",4,\"u gousses\"],[\"Pecorino\",40,\"g\"],[\"zeste de citron\",\"\",\"\"],[\"basilic\",\"\",\"\"]],\"steps\":[\"Préchauffer le four à 120°.\",\"Laver les tomates et les couper en deux.\",\"Disposer sur une plaque recouverte de papier cuisson, face coupée vers le haut.\",\"Assaisonner d’une pincée de sel.\",\"Ajouter du poivre noir, un filet d’huile d’olive et les gousses d’ail entières.\",\"Faire cuire au four pendant environ 3 heures, jusqu’à ce qu’elles soient bien défraîchies et concentrées.\",\"Pendant ce temps, rincer les pommes de terre sous l’eau courante et cuire en commençant à l’eau froide pendant 30–40 minutes.\",\"Disposer la farine sur un plan de travail et créer la classique fontaine en la poussant avec les mains.\",\"Lorslae les pommes de terre seront tendres, égoutter et écraser directement sur la farine.\",\"Ajouter le sel et pétrir rapidement avec les mains jusqu'à l'obtention d'une pâte homogène.\",\"nocchir la pâte en portions et former des boudins d’environ 2 cm d’épaisseur.\",\"Couper les gnocchis en petits morceaux.\",\"Passer chaque gnocco sur les dents d’une fourchette.\",\"Disposer au fur et à mesure sur une plaque farinéee.\",\"Sortir les tomates cerises du four, retirer l’ail et laisser tiédir.\",\"Transférer dans un passe-légumes jusqu’à obtenir une sauce.\",\"Verser cette sauce dans une poêle et réchauffer.\",\"Porter à ébullition une grande casserole d’eau salée et faire cuire les gnocchis; ils sont prêts lorsqu’ils remontent à la surface.\",\"Égoutter et transférer directement dans la poêle avec la sauce.\",\"Ajouter un filet d’huile et faire sauter délicatement pour bien mélanger le tout.\",\"Dresser les gnocchis dans les assiettes.\",\"Parsemer avec du pecorino râpé, quelques feuilles de basilic et du zeste de citron.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Pâtes\"],\"source\":\"https://www.giallozafferano.fr/recettes/gnocchis-aux-tomates-cerises-roties.html\",\"notes\":\"\",\"paprikaUid\":\"5656A158-4045-4EFE-A216-F0793ADC52D2\"},{\"id\":\"gnocchi-a-la-sauce-au-gorgonzola-mrryzeit83e\",\"title\":\"Gnocchi à la sauce au Gorgonzola\",\"category\":\"Italie\",\"time\":30,\"servings\":4,\"ingredients\":[[\"plat\",1,\"bouquet persil\"],[\"oignons\",1,\"\"],[\"d'olive\",1,\"c. à soupe huile\"],[\"Gorgonzola\",200,\"g\"],[\"demi-crème\",2,\"dl\"],[\"gnocchis\",700,\"g\"],[\"blanc\",1,\"dl vin\"],[\"poivre\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"citron\",2,\"c. à café jus de\"]],\"steps\":[\"Faire chauffer l'huile dans une poêle.\",\"Y faire suer l'oignon.\",\"Mouiller avec le vin et faire réduire un peu.\",\"Incorporer la crème et laisser mijoter pendant env. 3 min.\",\"Ajouter le gorgonzola et laisser fondre à petit feu en remuant.\",\"Ajouter le jus de citron, poursuivre la cuisson quelques instants et assaisonner.\",\"Faire cuire les gnocchis dans l'eau salée frémissante jusqu'à ce qu'ils remontent à la surface.\",\"Les égoutter et les ajouter à la sauce.\",\"Ajouter le persil, bien mélanger et assaisonner avec un peu de poivre.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\"],\"source\":\"https://fooby.ch/fr/recettes/17790/gnocchis-a-la-sauce-au-gorgonzola\",\"notes\":\"\",\"paprikaUid\":\"55352F9E-0AA0-4F93-B1E9-E6AB16C13C9A\"},{\"id\":\"gnocchi-a-la-bolognaise-mrryzeisngs\",\"title\":\"Gnocchi à la bolognaise\",\"category\":\"Italie\",\"time\":60,\"servings\":4,\"ingredients\":[[\"oignons\",1,\"\"],[\"d’ail\",1,\"gousses\"],[\"carottes\",1,\"\"],[\"rouges\",1,\"piments\"],[\"huile\",\"\",\"\"],[\"(morceau)\",40,\"g parmesan\"],[\"gnocchis\",500,\"g\"],[\"tomates\",2,\"c. à soupe concentré de\"],[\"concassées\",1,\"boîte tomates\"],[\"viande\",2,\"dl bouillon de\"],[\"(bœuf et porc)\",400,\"g viande hachée\"],[\"rouge\",2,\"dl vin\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"d'herbes à l'italienne\",1,\"c. à café mélange\"]],\"steps\":[\"Faire chauffer l'huile dans une poêle.\",\"Y faire revenir la viande hachée pendant 4 min.\",\"Sortir la viande de la poêle, l'assaisonner.\",\"Baisser le feu et verser un peu d'huile dans la même poêle.\",\"Y faire cuire l'oignon et tous les ingrédients jusqu'à la purée de tomates comprise pendant 3 min.\",\"Remettre la viande et le jus de cuisson dans la poêle.\",\"Mouiller avec le vin et laisser réduire de moitié.\",\"Ajouter les tomates et le bouillon.\",\"Couvrir et laisser mijoter env. 30 min en remuant de temps en temps.\",\"Assaisonner.\",\"Faire cuire les gnocchis dans l'eau salée frémissante en respectant les indications figurant sur l'emballage, les égoutter.\",\"Dresser les gnocchis.\",\"Répartir la sauce bolognaise dessus.\",\"Servir avec le fromage.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\"],\"source\":\"https://fooby.ch/fr/recettes/27430/gnocchis-a-la-bolognaise\",\"notes\":\"\",\"paprikaUid\":\"D3219E5E-7A2F-4419-961E-7CBA8BAC56FC\"},{\"id\":\"gnocchi-aux-epinards-et-a-la-ricotta-mrryzeiro2l\",\"title\":\"Gnocchi aux épinards et à la ricotta\",\"category\":\"Italie\",\"time\":60,\"servings\":4,\"ingredients\":[[\"farineuses\",1,\"kg pommes de terre\"],[\"branches\",150,\"g épinards en\"],[\"rouges\",600,\"g tomates cerises\"],[\"sauge\",0.5,\"bouquet\"],[\"huile\",\"\",\"\"],[\"blanche\",300,\"g farine\"],[\"maïzena\",2,\"c. à soupe\"],[\"ricotta\",250,\"g\"],[\"parmesan\",100,\"g\"],[\"œufs\",1,\"\"],[\"beurre\",50,\"g\"],[\"muscade\",0.25,\"c. à café noix de\"],[\"1¼ c. à café sel\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Faire cuire les pommes de terre env. 20 min dans l'eau frémissante salée sans couvrir.\",\"Les égoutter, les remettre dans la casserole puis laisser l'humidité résiduelle s'évaporer en donnant un mouvement de va-et-vient à la casserole sur la plaque éteinte.\",\"Passer les pommes de terre au passe-vite dans un saladier et laisser tiédir.\",\"Ajouter la farine et tous les ingrédients jusqu'au sel compris aux pommes de terre.\",\"Mélanger et travailler le tout rapidement pour obtenir une pâte.\",\"Diviser la pâte en 4, former des rouleaux d'env. 1,5 cm de Ø chacun sur un peu de maïzena.\",\"Couper les rouleaux en morceaux d'env. 3 cm de long.\",\"Préchauffer le four à 60 °C et y glisser le plat et les assiettes.\",\"Faire cuire les gnocchis en plusieurs fois dans l'eau salée frémissante pendant env. 5 min jusqu'à ce qu'ils remontent à la surface.\",\"Les sortir avec une écumoire, les égoutter et les réserver au chaud.\",\"Faire chauffer l'huile dans une poêle anti-adhésive.\",\"Y faire revenir les gnocchis par portions pendant env. 5 min.\",\"Les réserver au chaud.\",\"Faire fondre le beurre dans la même poêle.\",\"Ajouter les tomates et les faire revenir pendant env. 5 min.\",\"Ajouter la sauge et poursuivre la cuisson pendant env. 5 min.\",\"Dresser les gnocchis, assaisonner.\",\"Pparsemer de fromage.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\"],\"source\":\"https://fooby.ch/fr/recettes/25046/gnocchis-aux-epinards-et-a-la-ricotta\",\"notes\":\"\",\"paprikaUid\":\"EF7D6224-98B0-4C43-83B5-D59F47440A55\"},{\"id\":\"gnocchi-aux-epinards-au-beurre-de-sauge-mrryzeiqrg2\",\"title\":\"Gnocchi aux épinards au beurre de sauge\",\"category\":\"Italie\",\"time\":60,\"servings\":4,\"ingredients\":[[\"(de la veille)\",250,\"g pain blanc\"],[\"lait\",2,\"dl\"],[\"épinard\",150,\"g\"],[\"oignon\",1,\"u\"],[\"d’ail\",1,\"u gousse\"],[\"beurre\",75,\"g\"],[\"œuf\",2,\"u\"],[\"farine\",5,\"c. à soupe\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"noix de muscade\",\"\",\"\"],[\"frais\",3,\"u sauge\"],[\"d'alpage\",50,\"g fromage\"]],\"steps\":[\"Das Weißbrot in kleine Würfel schneiden.\",\"Die Milch leicht erwärmen und über die Brotwürfel träufeln.\",\"Alles vermischen und ca. 30 Min. quellen lassen.\",\"Den Spinat putzen, gründlich waschen und sehr fein hacken.\",\"Die Zwiebel und den Knoblauch schälen und klein würfeln.\",\"In einer Pfanne die Butter erhitzen.\",\"Die Zwiebel und den Knoblauch darin glasig dünsten.\",\"Den Spinat zugeben und kurz trocken dünsten.\",\"Diese Mischung zum Brot geben.\",\"Mit den Eiern und so viel Mehl verkneten, dass die Masse gut bindet.\",\"Mit Salz, Pfeffer und Muskat würzen.\",\"In einem breiten Topf reichlich Wasser aufkochen und salzen.\",\"Vom Teig mit einem nassen Löffel Portionen abstechen und mit angefeuchteten Händen zu länglichen Nocken formen.\",\"Ins siedende Wasser geben und in ca. 5 Min. gar ziehen lassen.\",\"Den Salbei waschen, trocken schütteln und die Blätter abzupfen.\",\"Die restliche Butter aufschäumen lassen.\",\"Die Salbeiblätter kleiner zupfen, dazugeben und kurz in der Butter schwenken.\",\"Die gegarten Nocken mit einem Schaumlöffel aus dem Wasser heben, kurz abtropfen lassen, auf Teller verteilen und mit der Salbeibutter beträufeln.\",\"Die Spinatnocken gleich servieren.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Végétarien\"],\"source\":\"https://www.kuechengoetter.de/rezepte/spinatnocken-mit-salbeibutter-37163\",\"notes\":\"\",\"paprikaUid\":\"80CA3A82-0E1E-4F01-A8C8-D2AE8C53C20E\"},{\"id\":\"gnocchi-aux-tomates-et-a-la-chapelure-mrryzeipnxv\",\"title\":\"Gnocchi aux tomates et à la chapelure\",\"category\":\"Italie\",\"time\":35,\"servings\":4,\"ingredients\":[[\"couleurs\",500,\"g tomates cerises de différentes\"],[\"oignons\",1,\"\"],[\"d'olive\",2,\"c. à soupe huile\"],[\"blanc\",2,\"c. à soupe vinaigre balsamique\"],[\"mascarpone\",100,\"g\"],[\"chapelure\",30,\"g\"],[\"gnocchis\",550,\"g\"],[\"tomates\",2,\"c. à soupe concentré de\"],[\"thym\",6,\"brin\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Couper les tomates cerises en deux.\",\"Éplucher l'oignon,  le couper en rondelles.\",\"Faire chauffer l'huile dans une poêle.\",\"Baisser le feu, ajouter la chapelure, faire griller pendant 4 min.\",\"Retirer du feu, mettre la chapelure dans une coupelle.\",\"Effeuiller le thym, l'ajouter, mélanger.\",\"Faire chauffer l'huile dans la même casserole.\",\"Ajouter l'oignon réservé et le faire revenir pendant 3 min.\",\"Ajouter la purée de tomates et poursuivre la cuisson pendant 1 min.\",\"Ajouter l'eau et le vinaigre balsamique.\",\"Ajouter le thym et les tomates cerises réservées.\",\"Porter à ébullition, assaisonner.\",\"Baisser le feu, couvrir et laisser mijoter env. 10 min en remuant de temps en temps.\",\"Retirer la casserole du feu.\",\"Ajouter le mascarpone et mélanger.\",\"Ajouter les gnocchis, faire chauffer.\",\"Dresser les gnocchis.\",\"Saupoudrer de chapelure.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\"],\"source\":\"https://little.fooby.ch/fr/recettes/28234/gnocchi-aux-tomates-et-a-la-chapelure\",\"notes\":\"\",\"paprikaUid\":\"6062A15B-3DE5-4D3C-BD42-742E7DCA2451\"},{\"id\":\"gnocchi-au-chou-fleur-mrryzeiokga\",\"title\":\"Gnocchi au chou-fleur\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"haché\",1,\"oignon finement\"],[\"d'ail pressée\",1,\"gousse\"],[\"beurre pour faire revenir\",\"\",\"\"],[\"chou-fleur frais ou surgelé, décongelé et haché\",350,\"g\"],[\"légumes\",2,\"dl bouillon de\"],[\"crème\",3,\"dl\"],[\"frais\",600,\"g gnocchi\"],[\"frais\",100,\"g épinards en branches surgelés ou\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"piment (facultatif)\",\"\",\"\"],[\"jus de citron\",\"\",\"\"],[\"haché\",3,\"c. à soupe persil finement\"],[\"hachées, év. grillées\",4,\"c. à soupe noisettes\"],[\"Sbrinz râpé\",\"\",\"\"]],\"steps\":[\"min\",\"Sauce: faire revenir l'oignon et l'ail. Ajouter le chou-fleur, faire revenir brièvement. Mouiller avec le bouillon et la crème, laisser réduire un instant.\",\"Ajouter les gnocchi et les épinards, chauffer brièvement, assaisonner et ajouter le jus de citron.\",\"Parsemer de persil et de noisettes. Servir avec le Sbrinz.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Végétarien\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2024_DIVE_37/gnocchi-au-chou-fleur/\",\"notes\":\"\",\"paprikaUid\":\"272FEB7E-7D64-4248-BCB3-C2508B35F4B3\"},{\"id\":\"gnocchi-alla-sorrentina-mrryzein8d0\",\"title\":\"Gnocchi alla sorrentina\",\"category\":\"Italie\",\"time\":80,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"u\"],[\"d’ail\",1,\"u gousse\"],[\"d’olive\",1,\"tbsp huile\"],[\"cerises\",500,\"g tomates\"],[\"cerises\",1,\"u boîte tomates\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"farineuse\",800,\"g pommes de terre\"],[\"farine\",200,\"g\"],[\"ricotta\",100,\"g\"],[\"frais\",1,\"u œuf\"],[\"muscade\",0.25,\"c. à café\"],[\"sel\",\"\",\"\"],[\"mozzarella\",150,\"g\"],[\"parmesan\",80,\"g\"],[\"basilic\",1,\"u bouquet\"]],\"steps\":[\"Peler l'oignon et l'ail, couper les deux en lanières.\",\"Faire chauffer l'huile dans une casserole.\",\"Faire revenir l'oignon et l'ail env. 2 minutes.\",\"Ajouter les tomates cerises fraîches et les faire revenir un instant.\",\"Ajouter les tomates cerises en boîte.\",\"Porter à ébullition.\",\"Baisser le feu et laisser bouillonner env. 15 min à couvert.\",\"Saler et poivrer et répartir dans le moule graissé.\",\"Cuire les pommes de terre avec la peau env. 20 min à découvert dans l'eau salée bouillante.\",\"Peler les pommes de terre encore chaudes et les couper en morceaux.\",\"Passer à la moulinette dans un grand bol.\",\"Laisser tiédir un peu.\",\"Incorporer la farine.\",\"Préchauffer le four à 200°C.\",\"Mixer la ricotta et l'œuf, assaisonner.\",\"Ajouter à la masse de pommes de terre.\",\"Bien mélanger à la main. La masse doit être encore humide, mais ne plus coller aux mains.\",\"Rajouter évent. un peu de farine.\",\"Façonner 4 rouleaux Ø env. 2 cm sur un peu de farine.\",\"Couper les rouleaux en morceaux d'env. 2 cm.\",\"Faire rouler avec le pouce sur le dos d'une fourchette de façon à imprimer la marque des dents.\",\"Déposer les gnocchis sur un linge fariné.\",\"Faire pocher les gnocchis par portions, env. 5 min, dans l'eau salée frémissante jusqu'à ce qu'ils remontent à la surface.\",\"Retirer avec une écumoire, bien égoutter.\",\"Répartir dans le moule, mélanger avec la sauce.\",\"Effilocher la mozzarella, la répartir sur les gnocchis avec le parmesan râpé.\",\"Cuisson: env. 30 min au milieu du four.\",\"Retirer.\",\"Déchirer grossièrement les feuilles de basilic.\",\"Répartir sur les gnocchis, dresser.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/gnocchi-alla-sorrentina-10010693/\",\"notes\":\"\",\"paprikaUid\":\"3B16F5FA-4825-4381-B0EB-2385507243BC\"},{\"id\":\"gnocchettis-sardi-a-la-sauce-tomate-et-saucisse-mrryzeimh23\",\"title\":\"Gnocchettis sardi à la sauce tomate et saucisse\",\"category\":\"Italie\",\"time\":30,\"servings\":2,\"ingredients\":[[\"safran\",1,\"pochette\"],[\"sardi\",200,\"g gnocchetti\"],[\"oignons\",1,\"\"],[\"ail\",2,\"gousses\"],[\"citrons\",1,\"\"],[\"d'olive\",2,\"c. à soupe huile\"],[\"peccorino\",40,\"g\"],[\"concassées\",1,\"boîte tomates\"],[\"salsiccia\",180,\"g\"],[\"blanc\",1,\"dl vin\"],[\"cannelle\",0.25,\"c. à café\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Faire chauffer l'huile dans une poêle antiadhésive.\",\"Y faire revenir l'oignon, l'ail et la saucisse pendant 2 min.\",\"Ajouter les tomates et tous les ingrédients jusqu'au poivre compris.\",\"Faire cuire à petit feu env. 20 min. en remuant de temps en temps.\",\"Faire cuire les pâtes al dente dans de l'eau salée frémissante.\",\"Les égoutter, les mélanger à la sauce.\",\"Dresser les pâtes.\",\"Arroser d'huile et parsemer de fromage.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\"],\"source\":\"https://fooby.ch/fr/recettes/25565/gnocchettis-a-la-sauce-tomate-et-saucisse\",\"notes\":\"\",\"paprikaUid\":\"F3A5F42C-73EA-4078-9730-C9A0C1D8808B\"},{\"id\":\"gaspacho-a-la-tomate-jaune-et-mais-mrryzeil3n5\",\"title\":\"Gaspacho à la tomate jaune et maïs\",\"category\":\"froid\",\"time\":25,\"servings\":4,\"ingredients\":[[\"maïs\",4,\"u épis de\"],[\"jaune\",600,\"g tomate\"],[\"nouveau\",2,\"u oignon\"],[\"d'ail\",1,\"u gousse\"],[\"d'olive\",5,\"cl huile\"],[\"vin\",4,\"cl vinaigre de\"],[\"d'Espelette\",2,\"u pincée de piment\"]],\"steps\":[\"Préchauffez le four sur la fonction gril.\",\"Égrainez un épi de maïs et saupoudrez les grains d’une pincée de piment d’Espelette et d’une pincée de sel.\",\"Étalez-les sur une plaque tapissée de papier cuisson.\",\"Enfournez 10 à 15 mn.\",\"Réservez.\",\"Rincez et coupez grossièrement les tomates.\",\"Pelez les oignons et l’ail, et coupez-les en quatre.\",\"Placez les grains de maïs prélevés sur le reste des épis dans le bol d’un blender.\",\"Ajoutez les tomates, les oignons, l’ail, l’huile d’olive, le vinaigre, 10 cl d’eau, une pincée de sel et une pincée de piment d’Espelette.\",\"Mixez pour obtenir une texture de soupe très fine.\",\"Réservez au frais 1h minimum.\",\"Servez le gaspacho parsemé de grains de maïs rôtis et arrosé d’un filet d’huile d’olive.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"froid\",\"Soupe\"],\"source\":\"https://www.elle.fr/Elle-a-Table/Recettes-de-cuisine/Gaspacho-tomate-jaune-mais-4028116\",\"notes\":\"\",\"paprikaUid\":\"C0D4CE0C-01AC-423B-9F1F-785610C7977C\"},{\"id\":\"gaspacho-a-la-pasteque-aux-tomates-et-aux-fraises-mrryzeikh3o\",\"title\":\"Gaspacho à la pastèque, aux tomates et aux fraises\",\"category\":\"Soupe\",\"time\":20,\"servings\":4,\"ingredients\":[[\"pastèque\",500,\"g\"],[\"concombre\",250,\"g\"],[\"oignon rouge\",0.5,\"u\"],[\"tomate\",500,\"g\"],[\"piment rouge\",0.5,\"u\"],[\"gin\",60,\"ml\"],[\"fraise\",400,\"g\"],[\"menthe\",8,\"feuille\"],[\"huile d’olive\",3,\"c. à soupe\"],[\"glaçon\",125,\"g\"],[\"sel\",0,\"\"],[\"feta\",70,\"g\"],[\"grenade\",1,\"u\"],[\"radis\",3,\"u\"],[\"feuille de menthe\",0,\"\"],[\"fleur de sel\",0,\"\"]],\"steps\":[\"Pour le gaspacho :\",\"Dans un mélangeur, mettez tous les éléments bien froids du gaspacho et broyez le tout jusqu’à l’obtention d’une texture qui ressemble à celle d’un smoothie.\",\"Pour la finition :\",\"Versez la soupe dans un bol très froid et garnissez le tout de fromage feta, de graines de grenade, de radis et de fraises.\",\"Complétez le plat avec la menthe, un trait d'huile d’olive et la fleur de sel.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"modifié\"],\"source\":\"https://ici.radio-canada.ca/mordu/recettes/6582/gaspacho-melon-eau-tomates-fraises\",\"notes\":\"\",\"paprikaUid\":\"8A2C5501-7D45-42F2-8906-EC0D4B550F32\"},{\"id\":\"gaspacho-de-tomate-ricotta-huile-de-persil-mrryzeijdzj\",\"title\":\"Gaspacho de tomate, ricotta, huile de persil\",\"category\":\"froid\",\"time\":30,\"servings\":4,\"ingredients\":[[\"tomate\",1,\"kg\"],[\"moutarde\",1,\"c. à soupe\"],[\"huile d'olive\",\"\",\"\"],[\"persil\",0.5,\"u botte de\"],[\"nouveau\",4,\"u oignon\"],[\"sucre\",20,\"g\"],[\"vinaigre\",4,\"cl\"],[\"ricotta\",2,\"c. à soupe\"]],\"steps\":[\"Epluchez les petits oignons nouveaux et coupez-les en deux.\",\"Faites-les bouillir avec le sucre, le vinaigre et 6 cl d’eau.\",\"Laissez refroidir à couvert.\",\"Mixez les tomates avec la moutarde, un filet d’huile et un peu de sel.\",\"Mixez la 1/2 botte de persil avec 30 cl d’huile.\",\"Servez le gaspacho dans un bol avec une bonne ricotta italienne, un filet d’huile de persil et les petits oignons en pickles.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"froid\",\"Soupe\"],\"source\":\"https://www.elle.fr/Elle-a-Table/Recettes-de-cuisine/Gaspacho-de-tomate-ricotta-huile-de-persil-3692738\",\"notes\":\"\",\"paprikaUid\":\"21B42BE3-C652-4BCC-BA8D-801FA1044A88\"},{\"id\":\"gaspacho-aux-concombres-et-a-l-aneth-mrryzeiip0b\",\"title\":\"Gaspacho aux concombres et à l'aneth\",\"category\":\"froid\",\"time\":90,\"servings\":4,\"ingredients\":[[\"fumées\",80,\"g amandes\"],[\"concombres\",2,\"u\"],[\"d'épinards\",100,\"g pousses\"],[\"oignons\",1,\"u\"],[\"ail\",1,\"u gousses\"],[\"verts\",1,\"u chilis\"],[\"poivrée\",0.5,\"u bouquet menthe\"],[\"citrons\",1,\"u\"],[\"Greens\",10,\"g Micro\"],[\"d'olive\",2,\"tbsp huile\"],[\"mie\",50,\"g pain de\"],[\"légumes\",3,\"dl bouillon de\"],[\"aneth\",0.5,\"u bouquet\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Couper 100 g de concombre en dés.\",\"Réserver.\",\"Couper le reste en morceaux.\",\"Mixer avec les épinards et tous les ingrédients jusqu'au zeste et le jus du citron y compris.\",\"Assaisonner.\",\"Couvrir et mettre au réfrigérateur pendant env. 1h.\",\"Dresser le gaspacho et le parsemer d'aneth, de micro greens, d'amandes fumées et les dés de concombres réservés.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"froid\",\"Saison Été\",\"Soupe\"],\"source\":\"https://fooby.ch/fr/recettes/24513/gaspacho-aux-concombres-et-a-l-aneth\",\"notes\":\"\",\"paprikaUid\":\"D3A3005D-E4EA-406C-864A-B0EEE4A7C1A9\"},{\"id\":\"gaspacho-mrryzeihfyt\",\"title\":\"Gaspacho\",\"category\":\"froid\",\"time\":160,\"servings\":7,\"ingredients\":[[\"Soupe:\",\"\",\"\"],[\"concombres\",2,\"\"],[\"rouges\",1,\"kg tomates\"],[\"rouges\",2,\"poivrons\"],[\"nouveau\",1,\"oignon\"],[\"plat\",0.5,\"bouquet persil\"],[\"tabasco\",1,\"petit piment ou\"],[\"tranches, sans la croûte\",50,\"g pain blanc en\"],[\"crème à rôtir\",\"\",\"\"],[\"tomate\",2,\"dl jus de\"],[\"rouge\",3,\"c. à soupe vinaigre de vin\"],[\"miel\",1,\"c. à café\"],[\"huile\",3,\"c. à soupe\"],[\"sel\",2,\"c. à café\"],[\"froid\",2,\"dl bouillon\"],[\"Garniture:\",\"\",\"\"],[\"haché\",1,\"œuf dur\"],[\"salées\",50,\"g amandes\"],[\"hachées, p. ex. coriandre, basilic\",6,\"c. à soupe fines herbes\"],[\"hachés\",6,\"c. à soupe oignons\"],[\"nature\",100,\"g féta émietté ou de yogourt\"]],\"steps\":[\"Émincer les concombres.\",\"Couper les tomates en dés.\",\"Partager les poivrons en deux, enlever les graines et les membranes blanches, puis les couper en dés.\",\"Hacher l'oignon et le persil.\",\"Couper le piment en deux et l'épépiner.\",\"Dorer le pain dans le beurre en le retournant plusieurs fois, puis laisser refroidir.\",\"Mixer le concombre, les tomates, les poivrons, les oignons, le persil et le piment.\",\"Ajouter le pain et le jus de tomate.\",\"Mixer le tout.\",\"Assaisonner avec le vinaigre, le miel, l'huile et le sel.\",\"Couvrir et réserver 2 h au réfrigérateur.\",\"Si besoin, diluer la soupe avec le bouillon et rectifier l'assaisonnement.\",\"Pour servir, verser la soupe dans des verres.\",\"Accompagner d'œuf dur, d'amandes salées, de fines herbes, d'oignons et de fromage frais ou de yogourt présentés dans des petits bols – à chacun de garnir et de compléter sa soupe selon ses envies.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"froid\",\"Saison Été\",\"Soupe\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/KB_SP2004_096/gaspacho/\",\"notes\":\"\",\"paprikaUid\":\"59B9F724-2409-47CF-803B-386104D4D265\"},{\"id\":\"galettes-de-poireaux-et-pommes-de-terre-mrryzeigedv\",\"title\":\"Galettes de poireaux et pommes de terre\",\"category\":\"Plat principal\",\"time\":45,\"servings\":4,\"ingredients\":[[\"GALETTES:\",\"\",\"\"],[\"poireau\",200,\"g\"],[\"farineuse\",200,\"g pomme de terre\"],[\"beurre\",2,\"c. à soupe\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"muscade\",1,\"prise noix de\"],[\"oeuf\",4,\"\"],[\"farine\",4,\"c. à soupe\"],[\"rôtir\",4,\"c. à soupe beurre à\"],[\"SAUCE À LA CRÈME ACIDULÉE:\",\"\",\"\"],[\"demi-crème acidulée\",200,\"g\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"mélangées\",0.5,\"bouquet herbes\"],[\"ail\",1,\"gousse\"]],\"steps\":[\"La veille, cuire les pommes de terre et les poireaux.\",\"Éplucher et râper les pommes de terre avec la râpe à Rösti.\",\"Effilocher les poireaux et ajouter aux pommes de terre.\",\"Battre les œufs et les verser sur les légumes.\",\"Mélanger le tout.\",\"Ajouter la farine et bien mélanger.\",\"Ajouter sel, poivre et noix de muscade et bien mélanger.\",\"Chauffer le beurre dans une grande poêle.\",\"Déposer l'appareil en petite portions à l'aide d'une petite louche.\",\"Laisser dorer à petit feu sur les deux côtés.\",\"Pendant ce temps, hacher finement les herbes.\",\"Verser la crème dans un bol, ajouter les herbes et l'ail pressé.\",\"Saler et poivrer et bien mélanger.\",\"Servir les galettes, drapées d'une cuillère de sauce.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Saison Hiver\"],\"source\":\"https://www.gemuese.ch/fr/recettes/galettes-de-poireau-et-pommes-de-terre?_gl=1*1mfrnbc*_up*MQ..&gclid=EAIaIQobChMItdK7sbK4kQMVepKDBx0SyAWNEAAYASABEgL9oPD_BwE&gbraid=0AAAAA-NhTE5iAnPHfalM4KcSHGDur_dvT\",\"notes\":\"\",\"paprikaUid\":\"9A6DF0C0-A273-477B-A3E4-2B7D35F9497D\"},{\"id\":\"galettes-de-courgettes-mrryzeifvxu\",\"title\":\"Galettes de courgettes\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"Galettes:\",\"\",\"\"],[\"râpées\",900,\"g courgettes\"],[\"sel\",\"\",\"\"],[\"farine\",75,\"g\"],[\"râpé\",75,\"g Sbrinz\"],[\"poivre, paprika\",\"\",\"\"],[\"œufs\",6,\"\"],[\"crème à rôtir\",\"\",\"\"],[\"Yogourt à l'ail:\",\"\",\"\"],[\"crème\",360,\"g yogourt nature à la\"],[\"mayonnaise\",2,\"c. à soupe\"],[\"pressées\",2,\"gousses ail\"],[\"ciselée\",0.5,\"botte aneth finement\"],[\"ciselé\",0.5,\"botte persil finement\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"aneth ou persil pour décorer\",\"\",\"\"]],\"steps\":[\"Galettes:\",\"Mélanger les courgettes avec le sel.\",\"Laisser dégorger 10-15 min.\",\"Passer au chinois, presser le jus.\",\"Mélanger tous les ingrédients jusqu'aux œufs inclus.\",\"Chauffer le beurre dans une grande poêle.\",\"Ajouter le mélange à l'aide de deux cuillères à soupe, aplatir légèrement.\",\"Dorer 4-6 min sur les deux faces à feu moyen.\",\"Réserver au chaud.\",\"Yogourt:\",\"Mélanger tous les ingrédients.\",\"Dresser les galettes avec la sauce au yogourt à part.\",\"Décorer.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Végétarien\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM201505_72_A/galettes-de-courgettes/\",\"notes\":\"\",\"paprikaUid\":\"2DAFFA9F-7140-4ECC-8A6C-E1B0F4ACEF9A\"},{\"id\":\"feta-fouettee-mrryzeiehc3\",\"title\":\"Féta fouettée\",\"category\":\"Déjeuner\",\"time\":10,\"servings\":4,\"ingredients\":[[\"Féta\",200,\"g\"],[\"crème\",100,\"g fromage frais double\"],[\"citron\",2,\"tsp jus de\"],[\"eau\",2,\"c. à soupe\"],[\"colza\",1,\"tbsp huile de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Mettre tous les ingrédients dans un bol haut et mixer. Éventuellement ajouter un peu d'eau.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Déjeuner\",\"Sauce\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2021_DIVE_38/feta-fouettee/\",\"notes\":\"\",\"paprikaUid\":\"488B424B-99E1-4F88-9588-458AA57921D9\"},{\"id\":\"focaccia-primavera-mrryzeiei79\",\"title\":\"Focaccia primavera\",\"category\":\"Italie\",\"time\":75,\"servings\":8,\"ingredients\":[[\"farine\",300,\"g\"],[\"Manitoba\",200,\"g farine\"],[\"fraîche\",10,\"g levure\"],[\"eau\",300,\"g\"],[\"sel\",20,\"g\"],[\"d'olive\",25,\"g huile\"],[\"marjolaine sèche\",\"\",\"\"],[\"thym sec\",\"\",\"\"],[\"origan sec\",\"\",\"\"],[\"fleur de sel\",\"\",\"\"],[\"verte\",300,\"g asperge\"],[\"Stracchino\",250,\"g\"]],\"steps\":[\"Dans un bol, mélanger les farines, la levure émiettée et toute l'eau.\",\"Transférer la pâte sur le plan de travail et pétrir énergiquement jusqu'à ce qu'elle soit homogène.\",\"Ajouter l'huile en trois fois, en ajoutant à nouveau seulement lorsque la première dose sera absorbée par la pâte.\",\"Une fois toute l'huile absorbée, ajouter le sel et pétrir jusqu'à ce qu'il soit bien incorporé.\",\"Ajouter également les 3 herbes aromatiques sèches et pétrir encore environ 5 min, jusqu'à ce que la pâte soit lisse et homogène.\",\"Mettre dans un bol et couvrir d'un film plastique.\",\"Laissez lever à température ambiante pendant environ 2 heures, jusqu'à ce qu'elle double de volume.\",\"Transférer la pâte sur le plan de travail et aplatir légèrement avec les mains.\",\"Transférer dans un plat préalablement huilé de 25x18 cm. Étaler la focaccia en élargissant la pâte avec les doigts et en la tirant délicatement jusqu'à couvrir toute la surface.\",\"Couvrir d'un film plastique et laisser lever encore environ 30 minutes à température ambiante.\",\"Préchauffer le four à 190°.\",\"Pendant ce temps, préparer les asperges.\",\"Verser un filet d'huile dans une poêle et ajouter les asperges.\",\"Faire sauter environ 5 minutes et assaisonner de sel et de poivre.\",\"Transférer dans un récipient et laisser refroidir.\",\"Avec les mains huilées, réaliser les trous classiques dans la pâte, en appuyant délicatement.\",\"Saupoudrer d'huile et de fleur de sel.\",\"Enfourner la pâte pendant 20 minutes.\",\"En attendant, couper les asperges en deux dans le sens de la longueur.\",\"Sortir la focaccia du four et recouvrir de Stracchino déchirerée avec les mains.\",\"Disposer les asperges.\",\"Enfourner à nouveau pendant 25 minutes.\",\"Dès que la focaccia sera bien dorée, sortir du four et saupoudrer de thym et de marjolaine frais.\",\"Servir la focaccia primavera tiède ou froide.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Pain\",\"Pizza\"],\"source\":\"https://www.giallozafferano.fr/recettes/focaccia-primavera.html\",\"notes\":\"\",\"paprikaUid\":\"06457CAE-BC52-4495-8FA6-0A35B16D14C4\"},{\"id\":\"focaccia-jardiniere-mrryzeidbvd\",\"title\":\"Focaccia jardinière\",\"category\":\"Italie\",\"time\":140,\"servings\":6,\"ingredients\":[[\"rouges\",2,\"oignons\"],[\"olives\",50,\"g tomates\"],[\"fanes\",2,\"oignons botte avec les\"],[\"d'olive\",5,\"c. à soupe huile\"],[\"mi-blanche\",500,\"g farine\"],[\"levure\",0.5,\"dé\"],[\"sel\",\"\",\"\"],[\"aromatiques\",0.5,\"bouquet herbes\"],[\"gros sel marin\",\"\",\"\"]],\"steps\":[\"Mélanger la farine, le sel et la levure dans un saladier, ajouter l'eau et l'huile.\",\"Pétrir le tout en une pâte souple et lisse.\",\"Couvrir et laisser lever env. 1 h à température ambiante jusqu'à ce que la pâte ait doublé de volume.\",\"Fariner le plan de travail, abaisser la pâte en une galette d'env. 1 cm d'épaisseur.\",\"La déposer sur une plaque chemisée de papier cuisson.\",\"Couvrir et laisser lever une deuxième fois pendant env. 30 min.\",\"Délayer l'huile dans l'eau et badigeonner la pâte avec la moitié de ce mélange.\",\"Décorer la pâte avec les légumes et les herbes aromatiques de manière à former des fleurs.\",\"Appuyer légèrement sur le tout.\",\"Badigeonner du reste du mélange eau-huile et saler.\",\"Faire cuire la focaccia env. 30 min. dans le bas du four préchauffé à 180 °C.\",\"La sortir du four et la laisser refroidir un peu sur une grille.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Pain\",\"Pizza\",\"Plat principal\"],\"source\":\"https://fooby.ch/fr/recettes/20455/garden-focaccia\",\"notes\":\"\",\"paprikaUid\":\"7B214AE7-5C18-4466-9DA9-58421D605ED1\"},{\"id\":\"focaccia-di-recco-focaccia-fourree-mrryzeictdr\",\"title\":\"Focaccia di Recco (Focaccia fourrée)\",\"category\":\"Italie\",\"time\":175,\"servings\":6,\"ingredients\":[[\"4½ c. à soupe huile d'olive\",\"\",\"\"],[\"blanche\",400,\"g farine\"],[\"ricotta\",250,\"g\"],[\"mascarpone\",250,\"g\"],[\"sel\",\"\",\"\"],[\"fleur de sel\",\"\",\"\"]],\"steps\":[\"Mélanger la farine et le sel dans le bol du robot de cuisine.\",\"Ajouter l'eau et l'huile, mélanger, pétrir avec le crochet pétrisseur du robot de cuisine pendant env. 10 min pour obtenir une pâte lisse.\",\"Couvrir et mettre au réfrigérateur pendant env. 2 h.\",\"Couper la pâte en 2 portions, badigeonner une portion de 1 cs d'huile.\",\"Aplatir la pâte depuis le centre, puis l'étirer délicatement jusqu'à ce qu'elle soit bien fine.\",\"Poser la pâte sur la plaque préparée.\",\"Mettre la ricotta et le mascarpone dans un récipient, mélanger, répartir sur la pâte.\",\"Badigeonner d’huile le reste de la pâte, étirer la pâte de sorte qu’elle soit aussi fine que la précédente, la poser sur la farce, piquer la pâte avec une fourchette.\",\"Répartir le reste d'huile et parsemer de fleur de sel.\",\"Faire cuire env. 20 min dans le bas du four préchauffé à 240 °C.\",\"Sortir du four, laisser refroidir un peu, couper en morceaux, servir tiède.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Pain\",\"Pizza\",\"Saison Hiver\"],\"source\":\"https://fooby.ch/fr/recettes/28211/focaccia-fourree--focaccia-di-recco-\",\"notes\":\"\",\"paprikaUid\":\"D9A9DB80-9736-43AC-8DA6-5E8B3A697300\"},{\"id\":\"focaccia-aux-poires-et-aux-figues-mrryzeibc5z\",\"title\":\"Focaccia aux poires et aux figues\",\"category\":\"Italie\",\"time\":185,\"servings\":8,\"ingredients\":[[\"poires\",1,\"\"],[\"figues\",1,\"\"],[\"d'olive\",0.5,\"dl huile\"],[\"sèche\",1,\"c. à café levure\"],[\"dure\",150,\"g mozzarella à pâte\"],[\"d'épeautre\",1,\"kg farine\"],[\"sel\",3,\"c. à café\"],[\"romarin\",6,\"brin\"],[\"sel\",0.5,\"c. à café fleur de\"]],\"steps\":[\"Verser la farine et le sel dans le bol du robot de cuisine.\",\"Ajouter la levure, le romarin et l'eau.\",\"Pétrir le tout env. 5 min. en une pâte lisse avec le crochet pétrisseur.\",\"Couvrir et laisser lever pendant env. 2 h à température ambiante.\",\"S'enduire les mains d'huile.\",\"Poser la pâte sur une plaque recouverte de papier cuisson, l'étirer à la main et y faire des creux.\",\"Répartir l'huile et le sel sur la pâte.\",\"La garnir avec le fromage, les poires, les figues et le romarin.\",\"Faire cuire pendant env. 35 min. dans le bas du four préchauffé à 220°C.\",\"Retirer la plaque du four.\",\"Sortir la focaccia et la laisser reposer env. 5 min.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Pain\",\"Pizza\",\"Plat principal\"],\"source\":\"https://fooby.ch/fr/recettes/20136/focaccia-aux-poires-et-aux-figues\",\"notes\":\"\",\"paprikaUid\":\"81A32F6A-907B-41D9-B8E1-831DFA850BEA\"},{\"id\":\"focaccia-au-kimchi-et-au-gochujang-mrryzeiasmo\",\"title\":\"Focaccia au Kimchi et au Gochujang\",\"category\":\"Corée\",\"time\":240,\"servings\":8,\"ingredients\":[[\"tournesol\",4,\"c. à soupe huile de\"],[\"blanche\",500,\"g farine\"],[\"levure\",0.5,\"dé\"],[\"Kimchi\",120,\"g\"],[\"(pâte de chili)\",80,\"g Gochujang\"],[\"sel\",\"\",\"\"],[\"noir\",1,\"c. à soupe graines de sésame\"],[\"sel\",0.5,\"c. à café fleur de\"]],\"steps\":[\"Égoutter le kimchi, récupérer 3 cs de jus.\",\"Hacher fin le kimchi, le couvrir et le réserver au frais.\",\"Dans un récipient, mélanger la farine et le sel.\",\"Ajouter la levure, mélanger.\",\"Ajouter l'eau, le gochujang, l'huile et le jus de kimchi.\",\"Mélanger avec une spatule en caoutchouc jusqu'à obtenir une pâte humide.\",\"Couvrir et laisser lever env. 30 min à température ambiante.\",\"Utiliser une corne pour détacher la pâte à quatre endroits différents du récipient, la soulever et la faire retomber au milieu.\",\"Couvrir à nouveau et laisser lever env. 30 min à température ambiante.\",\"Répéter cette opération une nouvelle fois.\",\"Badigeonner le papier cuisson d'un peu d'huile dans le moule préparé.\",\"Mettre la pâte dans le moule.\",\"La plier au milieu une fois de haut en bas, puis une fois de bas en haut.\",\"Retourner la pâte, couvrir et laisser lever encore environ 1h30.\",\"Bien mélanger l'huile et l'eau, en arroser la pâte.\",\"Former des petites cavités dans la pâte avec les doigts huilés.\",\"Parsemer de kimchi réservé, de sésame et de fleur de sel.\",\"Faire cuire env. 30 min dans le bas du four préchauffé à 220 °C.\",\"Laisser refroidir sur une grille hors du four.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Corée\",\"Italie\",\"Pain\",\"Pizza\",\"Plat principal\"],\"source\":\"https://fooby.ch/fr/recettes/27850/focaccia-au-kimchi-et-au-gochujang\",\"notes\":\"\",\"paprikaUid\":\"0D8EEEEB-4237-401E-A541-48D5B4BAD38E\"},{\"id\":\"focaccia-aromatica-mrryzei9dcp\",\"title\":\"Focaccia aromatica\",\"category\":\"Italie\",\"time\":160,\"servings\":8,\"ingredients\":[[\"tomates\",500,\"g\"],[\"d’ail\",2,\"gousses\"],[\"roquette\",50,\"g\"],[\"d'olive\",6,\"tbsp huile\"],[\"blanche\",500,\"g farine\"],[\"sucre\",0.5,\"c. à café\"],[\"levure\",0.5,\"dé\"],[\"parmesan\",75,\"g\"],[\"sel\",2,\"c. à café\"],[\"romarin\",1,\"c. à soupe\"],[\"poivre\",\"\",\"\"],[\"fleur de sel\",\"\",\"\"]],\"steps\":[\"Mélanger la farine, le sel, le sucre et la levure dans un récipient.\",\"Ajouter le romarin, l’eau et l’huile, pétrir en une pâte souple et lisse.\",\"Laisser lever à couvert et à température ambiante du double de volume env. 1 heure.\",\"Mélanger les tomates et tous les ingrédients jusqu’au poivre compris.\",\"Laisser reposer à couvert env. 30 minutes.\",\"Façonnage:\",\"Mettre la pâte sur une plaque chemisée de papier cuisson, aplatir sur env. 1 cm d’épaisseur.\",\"A l’aide des doigts, imprimer des creux dans la pâte.\",\"Badigeonner la pâte d’huile.\",\"Répartir le mélange aux tomates dessus.\",\"Parsemer de fleur de sel.\",\"Cuisson:\",\"Enfourner env. 30 min dans la moitié inférieure du four préchauffé à 220° C.\",\"Parsemer de copeaux de parmesan.\",\"Mélanger la roquette avec un peu d’huile et répartir dessus.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Pain\",\"Pizza\",\"Plat principal\"],\"source\":\"https://fooby.ch/fr/recettes/8188/focaccia-aromatica\",\"notes\":\"\",\"paprikaUid\":\"399B28CA-61C0-4352-AB89-CF0AE94D719F\"},{\"id\":\"flammkuche-estivale-mrryzei6n93\",\"title\":\"Flammkuche éstivale\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"Flammkuche\",1,\"pâte\"],[\"pêche\",3,\"\"],[\"rouge\",1,\"piment\"],[\"noix\",80,\"g cerneaux de\"],[\"fraîche\",200,\"g crème\"],[\"sel\",\"\",\"\"],[\"roquette\",40,\"g\"],[\"cru\",160,\"g jambon\"]],\"steps\":[\"Préchauffer le four à 240°.\",\"Dérouler la pâte et la faire glisser sur une plaque avec le papier cuisson.\",\"Couper les pêches en quartiers.\",\"Épépiner le piment et le hacher finement.\",\"Hacher grossièrement les noix.\",\"Mélanger la crème fraîche avec le piment et le sel.\",\"Etaler sur la pâte.\",\"Répartir dessus les pêches et les noix.\",\"Enfourner env. 20 min tout en bas du four.\",\"Retirer, répartir la roquette et le jambon cru sur la tarte flambée.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Saison Été\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/tarte-flambee-estivale-10008036/\",\"notes\":\"\",\"paprikaUid\":\"C61EDB1B-76D4-4493-AA3D-71AF091FC3BF\"},{\"id\":\"flammkuche-hivernale-mrryzei335e\",\"title\":\"Flammkuche hivernale\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"(d’env. 25 x 38 cm)\",1,\"pâte tarte flambée\"],[\"poires\",3,\"\"],[\"mi-fort rouge\",1,\"piment\"],[\"noix\",80,\"g cerneaux de\"],[\"fraîche\",200,\"g crème\"],[\"sel\",\"\",\"\"],[\"roquette\",40,\"g\"],[\"cru\",160,\"g tranches de jambon\"]],\"steps\":[\"Préchauffer le four à 240° C.\",\"Dérouler l’abaisse, faire glisser sur une plaque avec le papier cuisson.\",\"Couper les poires en quartiers.\",\"Épépiner le piment et le hacher finement, hacher grossièrement les noix.\",\"Mélanger la crème fraîche avec le piment et le sel, étaler sur la pâte.\",\"Répartir dessus les pêches et les noix.\",\"Cuisson: env. 20 min tout en bas du four.\",\"Retirer, répartir la roquette et le jambon cru sur la tarte flambée.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Saison Hiver\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/tarte-flambee-estivale-10008036/\",\"notes\":\"\",\"paprikaUid\":\"44ECE329-AE08-47DF-AFA0-A6070CD2953B\"},{\"id\":\"filets-de-poulet-sauce-coreenne-mrryzei13f7\",\"title\":\"Filets de poulet sauce coréenne\",\"category\":\"Corée\",\"time\":0,\"servings\":4,\"ingredients\":[[\"Pour la viande :\",\"\",\"\"],[\"poulet\",4,\"blanc de\"],[\"d'ail\",5,\"gousses\"],[\"gingembre\",3,\"cm\"],[\"Gochujang (pâte de piment coréenne)\",1,\"c. à soupe\"],[\"sauce soja\",40,\"ml\"],[\"sésame\",2,\"c. à soupe huile de\"],[\"vinaigre de riz\",2,\"c. à soupe\"],[\"sauce mirin\",2,\"c. à soupe\"],[\"miel\",2,\"c. à soupe\"],[\"fécule de maïs (à diluer dans 2 c. à soupe d'eau)\",10,\"g\"],[\"huile de cuisson\",\"\",\"\"],[\"Pour servir :\",\"\",\"\"],[\"chinoise\",3,\"tiges ciboule\"],[\"graines de sésame\",\"\",\"\"],[\"riz cuit\",4,\"portions\"]],\"steps\":[\"Dans saladier,\",\"- presser les gousses d'ail,\",\"- râper le gingembre,\",\"- ajouter le gochujang,\",\"- la sauce soja,\",\"- l'huile de sésame,\",\"- le vinaigre,\",\"- le mirin,\",\"- le miel.\",\"Bien mélanger.\",\"Découper les blancs de poulet en cubes.\",\"Les ajouter dans le saladier.\",\"Laisser mariner au moins 2 h.\",\"Chauffer une poêle avec un fond d'huile de cuisson.\",\"Mettre à cuire les morceaux de poulet en laissant le surplus de marinade dans le saladier.\",\"Saisir quelques minutes en retournant les morceaux de viande.\",\"Ajouter la fécule diluée afin d'obtenir une sauce nappante.\",\"Ajouter la marinade restante et baisser le feu.\",\"Laisser mijoter quelques minutes supplémentaires.\",\"Servir la viande en la parsemant de graines de sésame et de ciboule ciselée.\",\"Accompagner d'une portion de riz.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Corée\",\"Plat principal\",\"Poulet\"],\"source\":\"https://cookpad.com/fr/recettes/16798014?ref=search&search_term=cor%C3%A9enne\",\"notes\":\"\",\"paprikaUid\":\"B59C5ABD-1675-472C-B1E0-6EBA066E471F\"},{\"id\":\"filet-mignon-larde-mrryzei0ttr\",\"title\":\"Filet mignon lardé\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"porc, coupé en médaillons de 3 cm d'épaisseur\",1,\"filet mignon de\"],[\"tranches\",150,\"g lard en\"],[\"Sauce:\",\"\",\"\"],[\"crème, légèrement fouettée\",2.5,\"dl\"],[\"ketchup\",3,\"c. à soupe\"],[\"(facultatif)\",1,\"c. à soupe cognac\"],[\"paprika\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Préchauffer le four à 220°C (chaleur tournante: 200°C).\",\"Assaisonner les médaillons de chaque côté avec le paprika, le sel et le poivre.\",\"Envelopper chaque médaillon d'une tranche de lard.\",\"Disposer dans le plat à gratin.\",\"Cuire 20-25 min au milieu du four chaud.\",\"Sauce:\",\"Mélanger tous les ingrédients.\",\"Rectifier l'assaisonnement.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Suisse\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2021_DIVE_14/filet-mignon-larde/?collection=97824\",\"notes\":\"\",\"paprikaUid\":\"EC27E04F-71D1-4729-AB72-28DBD39401F7\"},{\"id\":\"filet-mignon-de-porc-fondant-en-cocotte-mrryzei019c\",\"title\":\"Filet mignon de porc fondant en cocotte\",\"category\":\"Cocotte\",\"time\":50,\"servings\":6,\"ingredients\":[[\"porc\",2,\"Filets de mignon de\"],[\"Grenaille\",500,\"g Pommes de terre\"],[\"Golden\",3,\"Pommes\"],[\"moutarde\",1,\"cuil. à café Graines de\"],[\"l’ancienne\",1,\"cuil. à soupe Moutarde à\"],[\"liquide\",15,\"cl Crème fraîche\"],[\"Huile\",3,\"cuil. à soupe\"],[\"Sel\",\"\",\"\"]],\"steps\":[\"Lavez et séchez les pommes et les pommes de terre.\",\"Dans une cocotte avec l’huile, faites dorer les filets mignons.\",\"Retirez-les de la cocotte.\",\"Déglacez-la cocotte avec 10 cl d’eau.\",\"Portez à ébullition et laissez réduire de moitié.\",\"Versez la moutarde et la crème en fouettant.\",\"Remettez ensuite les filets mignons.\",\"Ajoutez les pommes de terre, du sel et du poivre.\",\"Laissez mijoter 20 minutes.\",\"Pendant ce temps, épépinez et coupez les pommes en tranches fines.\",\"Ajoutez-les dans la cocotte et poursuivez la cuisson 10 minutes.\",\"Retirez les filets et coupez-les en tranches.\",\"Disposez les pommes de terre, les tranches de filet mignon et les tranches de pomme dans 6 mini-cocottes.\",\"Arrosez-les de sauce de cuisson et parsemez de graines de moutarde.\",\"Servez immédiatement.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Cocotte\",\"Plat principal\"],\"source\":\"https://www.cuisineactuelle.fr/recettes/filet-mignon-de-porc-fondant-en-cocotte-209729?_gl=1*zqubd4*_gcl_aw*R0NMLjE3NjY4Njc0NzEuRUFJYUlRb2JDaE1JeXNDMzM4emVrUU1WS1pPREJ4MTNCeUY2RUFBWUFTQUFFZ0l0V19EX0J3RQ..*_ga*MTAyNDA0ODM1MS4xNzY2ODY3MDc4*_ga_5NSPQRQDQY*czE3NjY4NjcwNzgkbzEkZzEkdDE3NjY4Njc0ODAkajckbDAkaDA.\",\"notes\":\"\",\"paprikaUid\":\"73BFB721-41B6-4086-9FCA-809BBF090810\"},{\"id\":\"filet-mignon-de-porc-en-croute-de-fromage-frais-et-de-lard-mrryzehzzfx\",\"title\":\"Filet mignon de porc en croûte de fromage frais et de lard\",\"category\":\"Plat principal\",\"time\":60,\"servings\":4,\"ingredients\":[[\"porc\",500,\"g filet mignon de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"colza\",2,\"c. à soupe huile de\"],[\"mondées\",100,\"g pistaches salées\"],[\"persil\",1,\"bouquet\"],[\"nature\",100,\"g fromage frais\"],[\"œuf\",1,\"\"],[\"rectangulaire\",1,\"pâte feuilletée\"],[\"fin\",80,\"g lard à griller coupé\"]],\"steps\":[\"Saler et poivrer le filet mignon.\",\"Le saisir dans l’huile de tous les côtés durant env. 5 min.\",\"Laisser refroidir.\",\"À l’aide d’un robot ménager, moudre pas trop fin les pistaches.\",\"Hacher le persil.\",\"Parsemer les deux sur du film alimentaire.\",\"Badigeonner tout le filet de fromage frais.\",\"Le déposer sur le mélange pistaches-persil et l’envelopper.\",\"Appuyer légèrement pour faire adhérer le mélange.\",\"Préchauffer le four à 200 °C.\",\"Battre l’œuf.\",\"Dérouler la pâte et badigeonner les bords d’œuf.\",\"Tapisser de tranches de lard en les faisant se chevaucher légèrement.\",\"Retirer le film alimentaire du filet mignon.\",\"Disposer sur le lard et l’enrouler dans la pâte.\",\"Sceller soigneusement les bords et le poser sur une plaque chemisée de papier sulfurisé.\",\"Selon les goûts, décorer avec les restes de pâte.\",\"Badigeonner d’œuf deux fois.\",\"Faire cuire 25-30 min au milieu du four.\",\"Laisser reposer env. 10 min dans le four éteint et ouvert.\",\"Trancher le filet mignon en croûte.\",\"Idéal avec du riz et des légumes.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Suisse\"],\"source\":\"https://migusto.migros.ch/fr/recettes/filet-mignon-de-porc-en-croute-enrobe-de-fromage-frais-et-de-lard\",\"notes\":\"\",\"paprikaUid\":\"DDFC9DD5-0947-4720-8486-580600B2FA75\"},{\"id\":\"filet-de-b-uf-wellington-mrryzehywpp\",\"title\":\"Filet de bœuf Wellington\",\"category\":\"Plat principal\",\"time\":155,\"servings\":4,\"ingredients\":[[\"bœuf\",900,\"g filet de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"colza\",2,\"c. à soupe huile de\"],[\"feuilletée, rectangulaire\",1,\"pâte\"],[\"campagne\",150,\"g jambon fumé de\"],[\"œuf\",1,\"\"],[\"séchées\",20,\"g morilles\"],[\"échalotes\",2,\"\"],[\"Paris\",250,\"g champignons de\"],[\"persil\",1,\"bouquet\"],[\"d'olive\",1,\"c. à soupe huile\"],[\"veau\",150,\"g chair à saucisse de\"],[\"œuf\",1,\"\"],[\"cognac\",2,\"c. à soupe\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"doux\",1,\"c. à café paprika\"]],\"steps\":[\"Assaisonner le filet de sel et de poivre.\",\"Chauffer l'huile dans une poêle.\",\"Saisir le filet de toutes parts.\",\"Le déposer ensuite sur une grille et le laisser refroidir.\",\"Mettre la poêle de côté.\",\"Pour la farce, faire tremper les morilles dans de l'eau tiède.\",\"Émincer les échalotes.\",\"Hacher très finement les champignons de Paris.\",\"Couper fin le persil.\",\"Retirer les morilles de l'eau, les essorer en pressant puis les tailler finement.\",\"Chauffer l'huile dans la poêle réservée.\",\"Yfaire suer les échalotes.\",\"Ajouter les champignons de Paris ainsi que les morilles et faire cuire jusqu'à réduction complète du liquide.\",\"Incorporer le persil.\",\"Laisser refroidir.\",\"Ajouter la chair à saucisse, l'œuf et le cognac.\",\"Bien mélanger.\",\"Relever la farce de sel, de poivre et de paprika.\",\"Dérouler l'abaisse.\",\"Couper un ruban d'env. 5 cm de large sur l'un des côtés courts de la pâte.\",\"Y découper des formes à l'emporte-pièce pour la décoration ou le tailler en lanières.\",\"Réserver au réfrigérateur.\",\"Disposer les tranches de jambon fumé au centre de l'abaisse en les faisant se chevaucher légèrement sur toute la longueur.\",\"Y étaler un peu de farce.\",\"Poser le filet sur un côté court de la pâte.\",\"Le garnir du reste de farce.\",\"Badigeonner les bords de la pâte d'un peu de jaune d'œuf.\",\"Rouler fermement le filet dans la pâte et sceller les extrémités.\",\"Déposer le filet enrobé de pâte, ligne de fermeture vers le bas, sur une plaque chemisée de papier sulfurisé.\",\"Le badigeonner entièrement de jaune d’œuf.\",\"Décorer avec les formes ou les lanières de pâte réservées.\",\"Également badigeonner celles-ci de jaune d'œuf.\",\"Mettre env. 30 min au réfrigérateur.\",\"Préchauffer le four à 200 °C.\",\"Piquer le thermomètre à viande à l'endroit le plus épais du filet.\",\"Glisser au milieu du four et faire cuire 30-35 min.\",\"Lorsque la température à cœur atteint 50-55 °C, le filet est cuit.\",\"Le sortir du four et laisser reposer env. 5 min.\",\"Le trancher et dresser.\",\"Se sert idéalement avec des légumes.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\"],\"source\":\"https://migusto.migros.ch/fr/recettes/boeuf-wellington\",\"notes\":\"\",\"paprikaUid\":\"2F5A2727-9578-4D60-A609-437559994D03\"},{\"id\":\"filet-de-b-uf-en-croute-mrryzehysgd\",\"title\":\"Filet de bœuf en croûte\",\"category\":\"Plat principal\",\"time\":220,\"servings\":5,\"ingredients\":[[\"Pâte au séré:\",\"\",\"\"],[\"farine\",300,\"g\"],[\"sel\",\"\",\"\"],[\"beurre, froid, coupé en morceaux\",150,\"g\"],[\"séré\",300,\"g\"],[\"Viande:\",\"\",\"\"],[\"bœuf, partie du milieu\",1,\"kg filet de\"],[\"forte\",2,\"c. à soupe moutarde\"],[\"sel\",\"\",\"\"],[\"cru\",10,\"tranches jambon\"],[\"Farce:\",\"\",\"\"],[\"séchées, trempées, finement hachées\",20,\"g morilles\"],[\"oignon, finement haché\",1,\"\"],[\"d'ail, pressée\",1,\"gousse\"],[\"romarin, finement haché\",1,\"brin\"],[\"crème à rôtir\",\"\",\"\"],[\"mascarpone\",125,\"g\"],[\"amandes, moulues\",75,\"g\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"d'œuf, battu avec\",1,\"jaune\"],[\"lait, pour badigeonner\",1,\"c. à soupe\"]],\"steps\":[\"Pâte:\",\"Mélanger la farine et le sel.\",\"Ajouter le beurre et travailler du bout des doigts jusqu'à obtention d'une masse grumeleuse.\",\"Former un puits, y verser le séré.\",\"Former une boule de pâte sans pétrir.\",\"Envelopper dans du film alimentaire et réfrigérer au moins 1 heure.\",\"Abaisser la pâte sur un peu de farine en un rectangle de 40x20 cm.\",\"Enlever le surplus de farine à l'aide d'un pinceau.\",\"Replier les côtés courts vers le milieu de façon à obtenir 3 couches.\",\"Réserver 30 min au frais à couvert.\",\"Répéter l'opération décrite au point 2 et réserver 30 min ou toute une nuit au frais à couvert.\",\"Badigeonner le filet de moutarde, assaisonner.\",\"Saisir uniformément dans le beurre à rôtir, laisser refroidir.\",\"Farce:\",\"Faire revenir les morilles, l'oignon, l'ail et le romarin dans le beurre à rôtir, laisser refroidir.\",\"Incorporer le mascarpone et les amandes.\",\"Assaisonner.\",\"Abaisser la pâte en un rectangle de 50x40 cm env.\",\"Réserver un peu de pâte au frais pour la décoration.\",\"Badigeonner le filet de farce, entourer de jambon cru.\",\"Placer la viande au centre de la pâte.\",\"Badigeonner de jaune d'œuf les bords de la pâte.\",\"Replier les côtés courts sur la viande, puis rouler dans le sens de la longueur.\",\"Découper des formes (étoiles) à l'emporte-pièce dans le reste de pâte.\",\"Badigeonner la pâte de jaune d'œuf, décorer d'étoiles.\",\"Piquer plusieurs fois à l'aide d'une fourchette.\",\"Cuire 35-45 min au milieu du four préchauffé à 200°C.\",\"La température à cœur doit être de 60-65°C.\",\"Laisser le four ouvert 5-10 min.\",\"Couper en tranches et servir.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Suisse\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM200512_13/filet-de-boeuf-en-croute/?collection=97824\",\"notes\":\"\",\"paprikaUid\":\"7FE4767A-CA2E-48F2-A97B-72F8DAC66C21\"},{\"id\":\"feuilletee-aux-asperges-au-lard-mrryzehxd2h\",\"title\":\"Feuilletée aux asperges au lard\",\"category\":\"Asperges\",\"time\":40,\"servings\":4,\"ingredients\":[[\"verte\",400,\"g asperge\"],[\"griller\",150,\"g lard à\"],[\"rectangulaire\",1,\"u pâte feuilletée\"],[\"beurre\",175,\"g\"],[\"fraîche\",2,\"tbsp crème\"],[\"d'œuf\",2,\"u jaune\"],[\"citron\",2,\"tbsp jus de\"],[\"herbes\",1,\"u bouquet de fines\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Préchauffer le four à 200 °C.\",\"Peler le tiers inférieur des asperges et coupe la base.\",\"Enrober chaque asperge d'une tranche de lard.\",\"Couper la pâte en lanières d'env. 1 cm de large et les enrouler autour du lard.\",\"Espacer les asperges sur une plaque chemisée de papier sulfurisé.\",\"Faire fondre le beurre dans une petite casserole, en badigeonner les spirales de pâte et réserver le reste au chaud.\",\"Glisser les asperges au milieu du four et cuire 15-20 min, jusqu'à ce que la pâte soit légèrement dorée.\",\"Entre-temps, mélanger la crème fraîche, les jaunes d'œuf et le jus de citron dans un récipient profond et mixer à l'aide d'un mixeur plongeur.\",\"Incorporer le reste du beurre chaud lentement, en un filet, sans cesser de remuer jusqu'à obtention d'une sauce épaisse.\",\"Émincer les fines herbes.\",\"Les ajouter à la sauce puis saler et poivrer.\",\"Servir avec les asperges.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asperges\",\"Saison Printemps\",\"Snack\"],\"source\":\"https://migusto.migros.ch/fr/recettes/asperges-au-lard-en-spirale-feuilletee-avec-sauce-hollandaise-aux-herbes-express\",\"notes\":\"\",\"paprikaUid\":\"CF65BA33-FEAD-4342-8329-F07DE0C70DC3\"},{\"id\":\"feuillete-de-poulet-mrryzehwgup\",\"title\":\"Feuilleté de poulet\",\"category\":\"Plat principal\",\"time\":60,\"servings\":4,\"ingredients\":[[\"huile\",\"\",\"\"],[\"poulet\",4,\"u blanc de\"],[\"sel\",\"\",\"\"],[\"oignon\",1,\"u\"],[\"d’ail\",1,\"u gousse\"],[\"d’origan\",2,\"u brin\"],[\"thym\",2,\"u brin de\"],[\"sauge\",5,\"u feuille de\"],[\"séré\",150,\"g\"],[\"paprika\",\"\",\"\"],[\"rectangulaire\",1,\"u pâte feuilletée\"],[\"cru\",8,\"u jambon\"],[\"œuf\",1,\"u\"]],\"steps\":[\"Bien faire chauffer l’huile dans une poêle antiadhésive.\",\"Saisir les blancs de poulet env. 2 min sur chaque face.\",\"Retirer, saler, réserver.\",\"Préchauffer le four à 220°C.\",\"Pour la farce, peler l’oignon et l’ail, hacher finement l’oignon, presser l’ail.\",\"Effeuiller l’origan et le thym, les ciseler avec la sauge.\",\"Mélanger le tout avec séré, paprika et sel.\",\"Dérouler la pâte feuilletée, la partager dans la longueur et dans la largeur, abaisser évent. pour élargir un peu.\",\"Déposer une tranche de jambon au centre de chaque morceau de pâte.\",\"Égoutter les blancs de poulet, déposer dessus.\",\"Répartir un quart de la farce sur chacun.\",\"Couvrir avec une tranche de jambon.\",\"Rabattre les coins de la pâte en croix, bien appuyer pour faire adhérer.\",\"Poser les petits paquets sur une plaque chemisée de papier cuisson, fermeture vers le bas.\",\"Battre l’œuf.\",\"En dorer les petits paquets, piquer à la fourchette.\",\"Cuisson: env. 25 min dans la moitié inférieure du four.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Poulet\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/feuillete-de-poulet-10002509/\",\"notes\":\"\",\"paprikaUid\":\"57E448DC-CA75-472A-B463-1CB67813D940\"},{\"id\":\"espresso-tonic-mrryzehvkph\",\"title\":\"Espresso tonic\",\"category\":\"Boisson\",\"time\":10,\"servings\":4,\"ingredients\":[[\"soluble\",3,\"c. à soupe café instantané\"],[\"semoule\",3,\"c. à soupe sucre brut en\"],[\"bouillante\",4,\"c. à soupe eau\"],[\"glaçons\",\"\",\"\"],[\"tonique\",5,\"dl eau\"],[\"d’espresso\",4,\"tasses\"],[\"biscuits\",4,\"\"]],\"steps\":[\"Mettre le café instantané, le sucre et l'eau dans une jatte et travailler env. 2 min au fouet électrique en une mousse ferme.\",\"Répartir quelques glaçons dans des verres et ajouter l'eau tonique.\",\"Verser un espresso dans chaque verre et recouvrir de mousse de café.\",\"Piquer un biscuit dans la mousse et servir aussitôt.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Boisson\",\"Saison Été\"],\"source\":\"https://migusto.migros.ch/fr/recettes/espresso-tonic\",\"notes\":\"\",\"paprikaUid\":\"0F36375F-DF60-4729-9A3B-2576F20FC2A1\"},{\"id\":\"escalope-de-veau-sauce-au-marsala-avec-du-risotto-mrryzehuxjo\",\"title\":\"Escalope de veau sauce au Marsala avec du risotto\",\"category\":\"Italie\",\"time\":45,\"servings\":4,\"ingredients\":[[\"oignons\",1,\"\"],[\"persil\",1,\"bouquet\"],[\"sauge\",0.25,\"bouquet\"],[\"sauge\",2,\"brin\"],[\"½ c. à soupe huile d'olive\",1,\"\"],[\"blanche\",2,\"c. à soupe farine\"],[\"beurre\",2,\"c. à soupe\"],[\"parmesan, râpé\",80,\"g\"],[\"risotto\",250,\"g riz pour\"],[\"½ dl Marsala\",2,\"\"],[\"bœuf\",9,\"dl bouillon de\"],[\"veau\",8,\"escalopes de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Faire fondre le beurre dans une casserole.\",\"Y faire suer l'oignon.\",\"Ajouter le riz et le faire cuire en remuant jusqu'à ce qu'il devienne translucide.\",\"Ajouter le marsala et laisser réduire presque entièrement.\",\"Verser le bouillon au fur et à mesure de la cuisson, en remuant souvent et en veillant à ce que le riz soit toujours recouvert de liquide.\",\"Laisser mijoter pendant env. 20 min jusqu'à ce que le riz soit crémeux et al dente.\",\"Incorporer le fromage, les fines herbes et le beurre.\",\"Assaisonner.\",\"Assaisonner les escalopes.\",\"Mettre la farine dans une assiette creuse et y passer les escalopes.\",\"Faire chauffer l'huile dans une grande poêle.\",\"Y faire dorer les escalopes pendant 1 min. de chaque côté, les sortir.\",\"Verser le Marsala et le bouillon dans la poêle, déglacer.\",\"Ajouter la sauge, porter à ébullition, faire mijoter 3 min jusqu'à obtenir une sauce crémeuse.\",\"Dresser les escalopes de veau avec la sauce au marsala et le risotto.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Risotto\"],\"source\":\"https://fooby.ch/fr/recettes/26905/escalopes-de-veau-sauce-au-marsala-avec-du-risotto-\",\"notes\":\"\",\"paprikaUid\":\"3661ABF3-5ACE-4CBA-AECE-39FD063C580E\"},{\"id\":\"endives-rouges-au-four-mrryzehtlwk\",\"title\":\"Endives rouges au four\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"SAUCE:\",\"\",\"\"],[\"orange, zeste râpé, jus pressé\",1,\"\"],[\"bianco\",3,\"c. à soupe balsamico\"],[\"d’olive\",4,\"c. à soupe huile\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"SALADE:\",\"\",\"\"],[\"rouges, en quartiers\",300,\"g endives\"],[\"d’olive\",1,\"c. à soupe huile\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"orange, filetée\",1,\"\"],[\"pignons, grillés\",30,\"g\"],[\"ricotta, en morceaux\",100,\"g\"]],\"steps\":[\"SAUCE :\",\"Mélanger le zeste d’orange avec les autres ingrédients et assaisonner.\",\"SALADE :\",\"Répartir les endives sur la plaque préparée.\",\"Verser l’huile d’olive dessus et assaisonner.\",\"CUISSON :\",\"Faire cuire pendant 15 à 20 minutes au milieu du four préchauffé à 200 °C.\",\"Sortir et dresser avec les filets d’orange, les pignons et la ricotta.\",\"Verser la sauce dessus et servir.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Saison Hiver\",\"Saison Été\"],\"source\":\"https://www.gemuese.ch/fr/recettes/endives-rouges-au-four?_gl=1*109yged*_up*MQ..*_gs*MQ..&gclid=EAIaIQobChMItdK7sbK4kQMVepKDBx0SyAWNEAAYASABEgL9oPD_BwE&gbraid=0AAAAA-NhTE5iAnPHfalM4KcSHGDur_dvT\",\"notes\":\"\",\"paprikaUid\":\"F0203BB2-4152-4AD1-8230-8E55F3BC2374\"},{\"id\":\"endives-au-jambon-avec-bechamel-aux-fines-herbes-mrryzehroce\",\"title\":\"Endives au jambon avec béchamel aux fines herbes\",\"category\":\"Plat principal\",\"time\":55,\"servings\":4,\"ingredients\":[[\"endives\",8,\"\"],[\"sel\",\"\",\"\"],[\"beurre pour le plat\",\"\",\"\"],[\"cuit\",16,\"tranches de jambon\"],[\"chapelure\",3,\"c. à soupe\"],[\"Gruyère\",30,\"g\"],[\"beurre\",2,\"c. à soupe\"],[\"farine\",2,\"c. à soupe\"],[\"lait\",6,\"dl\"],[\"herbes\",1,\"bouquet fines\"],[\"citron\",0.5,\"c. à café jus de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"noix de muscade\",\"\",\"\"]],\"steps\":[\"Préchauffer le four à 200 °C.\",\"Éliminer les feuilles extérieures des endives et inciser une croix à la base.\",\"Porter de l'eau salée à ébullition.\",\"Y plonger les endives 2-3 min.\",\"Egoutter.\",\"Beurrer légèrement le plat.\",\"Enrober chaque endive de deux tranches de jambon et les déposer dans le plat.\",\"Pour la sauce, faire fondre le beurre dans une casserole.\",\"Ajouter la farine et travailler en mousse avec un fouet.\",\"Verser le lait en remuant vigoureusement et porter à ébullition en fouettant.\",\"Faire mijoter la sauce env. 10 min à petit feu.\",\"Effeuiller les fines herbes puis les émincer et les ajouter à la sauce.\",\"Assaisonner avec le jus de citron, du sel, du poivre et de la muscade fraîchement râpée.\",\"Faire griller la chapelure à feu moyen dans une poêle antiadhésive.\",\"Laisser refroidir.\",\"Râper le fromage.\",\"Napper les endives au jambon de sauce.\",\"Mélanger le fromage râpé avec la chapelure grillée et en parsemer le plat.\",\"Glisser au milieu du four et faire gratiner env. 25min.\",\"Idéal avec des pommes de terre vapeur.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Suisse\"],\"source\":\"https://migusto.migros.ch/fr/recettes/endives-au-jambon-avec-bechamel-aux-fines-herbes\",\"notes\":\"\",\"paprikaUid\":\"E50CE540-1444-48D8-AEA1-336A10669FF2\"},{\"id\":\"endives-au-four-mrryzehroj3\",\"title\":\"Endives au four\",\"category\":\"Gratin\",\"time\":35,\"servings\":4,\"ingredients\":[[\"GRATIN:\",\"\",\"\"],[\"endives\",6,\"u\"],[\"Gruyère\",120,\"g\"],[\"SAUCE:\",\"\",\"\"],[\"d'ail\",2,\"u gousses\"],[\"oignon\",1,\"u\"],[\"colza\",1,\"tbsp huile de\"],[\"tomate\",1,\"tbsp concentré de\"],[\"concassées\",300,\"g tomates\"],[\"sucre\",1,\"c. à soupe\"],[\"légumes\",1,\"dl bouillon de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"SAUCE:\",\"Faire revenir l’ail et les oignons dans l’huile.\",\"Ajouter la purée de tomates et faire revenir.\",\"Ajouter les tomates, le sucre et le bouillon.\",\"Recouvrir et laisser mijoter pendant env. 10 minutes en remuant de temps en temps.\",\"GRATIN:\",\"Répartir les moitiés d’endive dans le moule.\",\"Verser la sauce et répartir le fromage dessus.\",\"CUISSON AU FOUR\",\"Faire gratiner pendant env. 20 minutes au milieu du four préchauffé à 220°C.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Gratin\",\"Plat principal\",\"Saison Hiver\",\"Saison Été\"],\"source\":\"https://www.gemuese.ch/fr/recettes/endives-au-four-a-la-sauce-tomate-et-au-fromage?_gl=1*17sh8e8*_up*MQ..&gclid=EAIaIQobChMItdK7sbK4kQMVepKDBx0SyAWNEAAYASABEgL9oPD_BwE&gbraid=0AAAAA-NhTE5iAnPHfalM4KcSHGDur_dvT\",\"notes\":\"\",\"paprikaUid\":\"C3FAF094-01DC-4BBF-9D08-88BAB7249B9D\"},{\"id\":\"emince-de-veau-zurichoise-mrryzehqw4e\",\"title\":\"Emincé de veau zurichoise\",\"category\":\"Plat principal\",\"time\":50,\"servings\":4,\"ingredients\":[[\"lamelles\",600,\"g viande de veau coupée en fines\"],[\"crème à rôtir\",\"\",\"\"],[\"haché\",1,\"oignon finement\"],[\"lamelles\",250,\"g champignons de Paris coupés en fines\"],[\"farine\",1,\"c. à soupe\"],[\"bouillon\",2,\"dl vin blanc ou de\"],[\"bouillon\",1,\"dl\"],[\"crème\",2,\"dl\"],[\"zeste de citron râpé\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"ciselé\",1,\"c. à soupe persil\"]],\"steps\":[\"Saisir brièvement la viande à feu vif dans le beurre.\",\"Retirer la poêle avant que la viande rende son jus, réserver au chaud.\",\"Réduire légèrement le feu.\",\"Ajouter l'oignon dans la poêle, faire revenir un instant.\",\"Ajouter les champignons, faire revenir brièvement, saupoudrer de farine, bien mélanger.\",\"Mouiller avec le vin et le bouillon.\",\"Réduire de moitié.\",\"Ajouter la crème, réduire légèrement.\",\"Incorporer le zeste de citron, saler, poivrer.\",\"Mélanger la sauce et la viande, réchauffer brièvement (ne plus cuire), parsemer de persil et servir aussitôt.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Suisse\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM201401_83/emince-de-veau-a-la-zurichoise/?collection=97824\",\"notes\":\"\",\"paprikaUid\":\"A7C98615-D54A-4CEE-BC02-B28858F4765E\"},{\"id\":\"emince-au-sesame-mrryzehp97n\",\"title\":\"Emincé Au Sésame\",\"category\":\"A\",\"time\":30,\"servings\":4,\"ingredients\":[[\"fanes\",3,\"oignons botte avec les\"],[\"rouges\",1,\"piments\"],[\"mungo\",200,\"g de germes de haricots\"],[\"huile\",\"\",\"\"],[\"d’émincé de porc\",600,\"g\"],[\"sel\",0.5,\"de cc de\"],[\"un peu de poivre\",\"\",\"\"],[\"soja\",3,\"cs de sauce au\"],[\"sésame\",20,\"g de\"]],\"steps\":[\"Faire chauffer l'huile dans un wok ou une sauteuse. Y faire revenir la viande par portions pendant env. 2 min., la retirer et l'assaisonner.\",\"Hacher menu les oignons botte, couper les feuilles en fines rondelles et les réserver. Epépiner les piments et les couper en rondelles. Faire chauffer un peu d'huile dans la même poêle et y faire revenir les oignons botte et les piments pendant env. 2 min. Ajouter la sauce au soja et l'eau, couvrir puis laisser mijoter pendant env. 4 min.\",\"Faire griller le sésame, ajouter les feuilles réservées et la viande, mélanger et faire chauffer le tout. Servir avec: du riz basmati ou parfumé\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"A\"],\"source\":\"https://fooby.ch/fr/recettes/11645/emince-au-sesame\",\"notes\":\"\",\"paprikaUid\":\"BB8B7BEB-14CC-456B-8845-E1880E3F118B\"},{\"id\":\"eingelegte-radieschen-mrryzehosbx\",\"title\":\"Eingelegte Radieschen\",\"category\":\"A\",\"time\":120,\"servings\":2,\"ingredients\":[[\"rouge\",2,\"u botte radis\"],[\"d'ail\",2,\"u gousse\"],[\"aneth\",0.5,\"u botte\"],[\"blanc\",1,\"tbsp vinaigre\"],[\"sucre\",1,\"c. à soupe\"],[\"sel\",0.5,\"c. à soupe\"],[\"chili\",1,\"c. à café\"],[\"poivre\",\"\",\"\"],[\"eau minérale gazeuse\",\"\",\"\"]],\"steps\":[\"Weck-Glas heiss auswaschen und auskühlen lassen.\",\"Radieschen säubern, Wurzel und Blätter abschneiden, mit einem Nudeholz zerdrücken und dann in das Glas geben.\",\"Dill abzupfen, die Spitzen hacken und diese ebenfalls ins Glas geben.\",\"Knoblauch schälen, feinhacken und zu den Radieschen geben.\",\"Zucker, Essig, Salz und Pfeffer ebenso hinzufügen und mit dem Mineralwasser aufgießen, bis alles bedeckt ist.\",\"Deckel schließen und alles gut durchschütteln.\",\"Für 2 Stunden im Kühlschrank durchziehen lassen.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"A\",\"Salade\",\"Snack\"],\"source\":\"https://julchen-kocht.de/eingelegte-radieschen-perfekt-im-sommer/\",\"notes\":\"\",\"paprikaUid\":\"0632E1E8-2F70-46AA-9044-C594F8102BEC\"},{\"id\":\"eau-fruitee-aux-fraises-et-au-basilic-mrryzehnzq6\",\"title\":\"Eau fruitée aux fraises et au basilic\",\"category\":\"Boisson\",\"time\":10,\"servings\":1,\"ingredients\":[[\"eau\",500,\"ml\"],[\"glaçon\",\"\",\"\"],[\"fraise\",1,\"barquette\"],[\"frais\",1,\"bouquet basilic\"]],\"steps\":[\"Porter l’eau à ébullition.\",\"Déposer les queues de fraises dans un pot d’une capacité de 500 ml.\",\"Verser l’eau bouillante dans le pot pour recouvrir les queues de fraises.\",\"Refermer et laisser reposer quelques minutes.\",\"Remplisser la moitié d’un pichet de glaçons.\",\"Couper les fraises en demi/quart et déposez-les dans le pichet.\",\"Ajouter les feuilles de basilic.\",\"À l’aide d’un tamis, filtrer l’infusion de queues de fraises directement au-dessus du pichet.\",\"Compléter avec de l’eau froide au besoin.\",\"Mélanger et servez.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Boisson\",\"Saison Été\"],\"source\":\"https://ici.radio-canada.ca/mordu/recettes/294/eau-fruitee-fraises-basilic\",\"notes\":\"\",\"paprikaUid\":\"3E221A72-9A46-4442-8451-B69EEA19D1C8\"},{\"id\":\"eau-aromatisee-mrryzehmzft\",\"title\":\"Eau aromatisée\",\"category\":\"Boisson\",\"time\":65,\"servings\":1,\"ingredients\":[[\"concombres\",0.5,\"\"],[\"grass\",2,\"tige lemon\"]],\"steps\":[\"Mettre les rondelles de concombre et le lemon grass dans une carafe.\",\"Remplir d'eau.\",\"Couvrir et la mettre au réfrigérateur pendant env. 1 h.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Boisson\",\"Saison Été\"],\"source\":\"https://fooby.ch/fr/recettes/13473/eau-aromatisee\",\"notes\":\"\",\"paprikaUid\":\"75536A92-750C-433C-971D-0EBDCE3E694C\"},{\"id\":\"dry-london-spirit-avec-mangue-et-eau-tonique-mrryzehlx1k\",\"title\":\"Dry London Spirit avec mangue et eau tonique\",\"category\":\"Boisson\",\"time\":5,\"servings\":1,\"ingredients\":[[\"vert\",1,\"tsp jus de citron\"],[\"mangue, pesée parée\",40,\"g\"],[\"(gin sans alcool)\",2,\"cl Dry London Spirit\"],[\"glaçons\",6,\"\"],[\"menthe\",1,\"\"],[\"tonique, réfrigérée\",1,\"dl eau\"],[\"poivre rose\",\"\",\"\"]],\"steps\":[\"Réduire la mangue en purée avec le jus de citron vert.\",\"Verser dans un verre longdrink avec le Dry London Spirit.\",\"Remuer.\",\"Ajouter les glaçons.\",\"Y effeuiller la menthe.\",\"Compléter avec l'eau tonique.\",\"Moudre grossièrement le poivre rose, en parsemer le drink et servir aussitôt.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Boisson\"],\"source\":\"https://migusto.migros.ch/fr/recettes/dry-london-spirit-avec-mangue-et-eau-tonique\",\"notes\":\"\",\"paprikaUid\":\"096B43FA-CD2D-4BAF-9D8B-ABC2FAEF4D13\"},{\"id\":\"dakgangjeong-poulet-frit-a-la-coreenne-mrryzehlmpu\",\"title\":\"Dakgangjeong (Poulet frit à la coréenne)\",\"category\":\"Corée\",\"time\":0,\"servings\":4,\"ingredients\":[[\"Pour la viande :\",\"\",\"\"],[\"poulet émincé\",600,\"g\"],[\"haché\",1,\"c. à soupe ail\"],[\"gingembre frais râpé\",1,\"c. à soupe\"],[\"sel\",\"\",\"\"],[\"mirin (ou vin de cuisine)\",2,\"c. à soupe\"],[\"maïs\",1,\"tasse fécule de\"],[\"Pour la sauce :\",\"\",\"\"],[\"soja\",3,\"c. à soupe sauce\"],[\"mirin\",5,\"c. à soupe\"],[\"vinaigre de riz\",4,\"c. à soupe\"],[\"(pâte de piment coréen)\",2,\"c. à soupe gochujang\"],[\"miel (ou sirop de maïs)\",5,\"c. à soupe\"],[\"cassonade\",4,\"c. à soupe\"],[\"râpé\",2,\"c. à café gingembre\"],[\"ail haché\",2,\"c. à café\"],[\"huile de sésame\",4,\"c. à soupe\"],[\"Pour servir :\",\"\",\"\"],[\"graines de sésame\",\"\",\"\"],[\"cacahuètes pilées (optionnel)\",\"\",\"\"]],\"steps\":[\"Commencer par émincer le poulet s'il est en filet, de la taille d'une bouchée.\",\"Enlever le gras.\",\"Le rincer sous l'eau froide et bien l'égoutter.\",\"Mélanger les ingrédients prévus pour la viande sauf la fécule qui est gardée de côté.\",\"Laisser mariner 30 minutes minimum.\",\"Mettre tous les éléments de la sauce dans une poêle ou une casserole et porter à ébullition.\",\"Laisser bouillir quelques minutes à feu moyen pour que la sauce épaississe un peu.\",\"Réserver.\",\"Quand le temps de marinade est terminé, recouvrir chaque morceau de poulet avec la fécule.\",\"Pour plus de facilité, on peut utiliser un sac de congélation, y mettre la fécule, la viande marinée, refermer le sac et bien mélanger le tout.\",\"Faire chauffer une bonne quantité d'huile dans une poêle.\",\"La cuisson peut également se faire à la friteuse.\",\"Une fois bien chaude, faire frire les morceaux de poulet (ne pas mettre trop de morceaux en même temps dans la poêle).\",\"Les retirer de l'huile, les déposer sur du papier absorbant.\",\"Refaire chauffer l'huile afin de faire frire le poulet une seconde fois jusqu'à ce que les morceaux soient bien dorés.\",\"Une fois tous les morceaux cuits et dorés, faire réchauffer la sauce et napper les morceaux de poulet.\",\"Décorer avec des graines de sésame et de la ciboule ciselée.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Corée\",\"Plat principal\",\"Poulet\"],\"source\":\"https://cookpad.com/fr/recettes/16741873?ref=search&search_term=cor%C3%A9enne\",\"notes\":\"\",\"paprikaUid\":\"021FEAA7-9730-4BEE-837B-B4FDCC29FB36\"},{\"id\":\"cotelettes-d-agneau-et-puree-de-pain-a-la-tomate-mrryzehkfd5\",\"title\":\"Côtelettes d'agneau et purée de pain à la tomate\",\"category\":\"Italie\",\"time\":50,\"servings\":4,\"ingredients\":[[\"d’ail\",1,\"u gousses\"],[\"oignon\",1,\"u\"],[\"d'olive\",1,\"tbsp huile\"],[\"sucre\",1,\"c. à café\"],[\"beurre\",2,\"c. à soupe\"],[\"beurre à rôtir\",\"\",\"\"],[\"blanc\",75,\"g pain\"],[\"feta\",70,\"g\"],[\"concassées\",1,\"u tomates\"],[\"légumes\",2,\"dl bouillon de\"],[\"1½ tbsp fond de veau\",\"\",\"\"],[\"d'agneau\",2,\"u carrés\"],[\"rouge\",2,\"dl vin\"],[\"poivre\",\"\",\"\"],[\"laurier\",1,\"u feuilles\"],[\"romarin\",1,\"u brin\"],[\"basilic\",2,\"u brin\"],[\"fleur de sel\",\"\",\"\"],[\"sel\",\"\",\"\"]],\"steps\":[\"Couper le pain en tranches fines et les poser sur une plaque.\",\"Les faire griller quelques minutes dans le four préchauffé à 200 °C.\",\"Couper les gousses d'ail en deux et les frotter sur le pain.\",\"Empiler les tranches de pain dans une casserole.\",\"Ajouter les tomates, le sucre et le bouillon.\",\"Faire réduire à petit feu pendant env. 15 min. en remuant de temps en temps jusqu'à obtention d'une bouillie.\",\"Si nécessaire, ajouter un peu de bouillon.\",\"Rectifier l'assaisonnement et ajouter l'huile.\",\"Dans une petite casserole, porter à ébullition le vin, la feuille de laurier, le romarin et le fond de veau.\",\"Laisser réduire de moitié.\",\"Retirer les épices.\",\"Incorporer le beurre coupé en morceaux, saler.\",\"Couper les carrés d'agneau en côtelettes.\",\"Assaisonner et les faire revenir dans le beurre pendant env. 2 min. de chaque côté.\",\"Émincer les oignons.\",\"Couper la feta en morceaux.\",\"Dresser la purée de pain à la tomate sur les assiettes.\",\"Disposer les côtelettes par-dessus.\",\"Les arroser d'un peu de sauce.\",\"Décorer d'oignons, de feta et de basilic.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\"],\"source\":\"https://fooby.ch/fr/recettes/11901/cotelettes-d-agneau-et-puree-de-pain-a-la-tomate\",\"notes\":\"\",\"paprikaUid\":\"915262E6-C8E9-4FF5-82D6-8CE9FE5E7C93\"},{\"id\":\"cotelettes-aux-poires-aigres-douces-mrryzehjw20\",\"title\":\"Côtelettes aux poires aigres-douces\",\"category\":\"Plat principal\",\"time\":70,\"servings\":4,\"ingredients\":[[\"oignons\",0.5,\"\"],[\"poires\",600,\"g\"],[\"céleri-branche\",100,\"g\"],[\"pomme\",3,\"c. à soupe vinaigre de\"],[\"d'arachide\",1,\"c. à soupe huile\"],[\"beurre\",1,\"c. à café\"],[\"beurre à rôtir\",\"\",\"\"],[\"l’ancienne\",1,\"c. à café moutarde à\"],[\"miel\",3,\"c. à soupe\"],[\"porc\",4,\"côtelettes de\"],[\"romarin\",1,\"brin\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"citron\",1,\"c. à soupe jus de\"]],\"steps\":[\"Chauffer le beurre dans une poêle.\",\"Faire suer l’oignon.\",\"Ajouter les poires et le céleri.\",\"Faire revenir brièvement.\",\"Mélanger le miel et le reste des ingrédients.\",\"Mélanger délicatement et porter à ébullition.\",\"Baisser le feu, couvrir et laisser mijoter sur feu moyen env. 15 minutes.\",\"Laisser refroidir les poires aigres-douces quelques instants.\",\"Pour la marinade, mélanger le jus de citron, l’huile, la moutarde et le poivre.\",\"Badigeonner les côtelettes avec ce mélange des deux côtés.\",\"Couvrir et laisser mariner env. 30 minutes.\",\"Saler la viande.\",\"Chauffer le beurre à rôtir dans une poêle.\",\"Y saisir les côtelettes env. 2 min de chaque côté.\",\"Tourner uniquement lorsqu’une croûte s’est formée.\",\"Servir les poires aigres-douces en accompagnement.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Suisse\"],\"source\":\"https://fooby.ch/fr/recettes/7622/cotelettes-aux-poires-aigres-douces\",\"notes\":\"\",\"paprikaUid\":\"9391F770-B4C8-4CD3-AFE3-530953F7BA94\"},{\"id\":\"cotelettes-al-limone-mrryzehi423\",\"title\":\"Côtelettes al limone\",\"category\":\"Italie\",\"time\":110,\"servings\":4,\"ingredients\":[[\"l’ancienne\",4,\"tbsp moutarde à\"],[\"citron\",3,\"u\"],[\"d’olive\",5,\"tbsp huile\"],[\"d’ail\",2,\"u gousse\"],[\"d'agneau\",8,\"u côtelette\"],[\"1½ tsp fleur de sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Mettre la moutarde dans un grand bol.\",\"Ajouter le zeste râpé d'un citron et le jus.\",\"Verser l'huile.\",\"Ajouter l'ail pressé.\",\"Remuer la marinade.\",\"Mettre les côtelettes dans la marinade.\",\"Mélanger, laisser mariner env. 1 h à couvert.\",\"Racler la marinade, réserver.\",\"Couper le reste des citrons en rondelles d'env. 2 cm d'épaisseur.\",\"Gril à charbon de bois ou électrique: faire griller les côtes à couvert sur chaque face au-dessus de braises moyennes ou à chaleur moyenne (env. 200° C).\",\"Badigeonner de temps en temps avec la marinade réservée.\",\"Faire griller les rondelles de citrons env. 5 min sur chaque face.\",\"Avant de servir, saler et poivrer les côtes.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Saison Été\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/costine-al-limone-10004178/\",\"notes\":\"\",\"paprikaUid\":\"CA10C749-C351-4969-B249-9424511E8126\"},{\"id\":\"cotelette-de-porc-aux-champignons-mrryzehherz\",\"title\":\"Côtelette de porc aux champignons\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"\"],[\"d’ail\",2,\"gousse\"],[\"blancs\",200,\"g champignons de Paris\"],[\"bruns\",200,\"g champignons de Paris\"],[\"persil\",0.5,\"bouquet\"],[\"huile d'olive\",\"\",\"\"],[\"porc\",4,\"côtelette de\"],[\"blanc\",1,\"dl vin\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Préchauffer le four à 60 °C.\",\"Y mettre le plat et les assiettes.\",\"Faire chauffer l'huile dans une poêle antiadhésive.\",\"Saler les côtelettes et les saisir pendant env. 5 min de chaque côté.\",\"Réserver au chaud.\",\"Faire chauffer un peu d'huile dans la même poêle.\",\"Y faire suer l'ail et l'oignon.\",\"Couper les champignons en quarts ou en tranches et les ajouter à la poêle.\",\"Assaisonner et faire revenir pendant env. 5 min.\",\"Mouiller avec le vin et faire réduire un peu.\",\"Remettre les côtelettes dans la poêle pour les réchauffer.\",\"Dresser les côtelettes et les champignons sur des assiettes.\",\"Parsemer de persil.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\"],\"source\":\"https://fooby.ch/fr/recettes/23499/cotelette-de-porc-aux-champignons\",\"notes\":\"\",\"paprikaUid\":\"CFBC2D98-B997-49C4-AD32-A5858E62E013\"},{\"id\":\"cotelette-alla-milanese-mrryzehgkvh\",\"title\":\"Côtelette alla milanese\",\"category\":\"Italie\",\"time\":60,\"servings\":4,\"ingredients\":[[\"terre\",800,\"g pomme de\"],[\"d’ail\",2,\"u gousse\"],[\"d'olive\",2,\"tbsp huile\"],[\"huile\",\"\",\"\"],[\"blanche\",2,\"tbsp farine\"],[\"œuf\",1,\"u\"],[\"chapelure\",60,\"g\"],[\"veau\",4,\"u côtelette de\"],[\"poivre\",\"\",\"\"],[\"romarin\",3,\"u brin\"],[\"sel\",\"\",\"\"]],\"steps\":[\"Faire chauffer l'huile dans une poêle antiadhésive.\",\"Faire revenir brièvement les pommes de terre, couvrir et faire cuire à feu moyen pendant env. 15 min. en remuant de temps en temps.\",\"Enlever le couvercle et augmenter le feu.\",\"Ajouter l'huile, l'ail et le romarin, puis faire dorer les pommes de terre pendant env. 15 min. en les retournant souvent, assaisonner.\",\"Poser les côtelettes dans un sachet en plastique découpé sur les côtés et les aplatir (jusqu'à une épaisseur d'env. 1 cm).\",\"Assaisonner la viande.\",\"Verser la farine dans une assiette plate, la chapelure dans une autre et mettre l'œuf dans une assiette creuse.\",\"Passer la viande dans la farine (enlever le surplus) puis dans l'œuf et enfin dans la chapelure en appuyant bien.\",\"Faire chauffer l'huile dans une poêle antiadhésive.\",\"Faire dorer les côtelettes pendant env. 2 ½ min. de chaque côté.\",\"Servir les côtelettes avec les pommes de terre au romarin.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\"],\"source\":\"https://fooby.ch/fr/recettes/18275/cotoletta-alla-milanese-\",\"notes\":\"\",\"paprikaUid\":\"4045C327-252B-445D-875F-0FF1C86CE614\"},{\"id\":\"curry-de-pommes-de-terre-aux-epices-douces-mrryzehfak6\",\"title\":\"Curry de pommes de terre aux épices douces\",\"category\":\"Asie\",\"time\":0,\"servings\":4,\"ingredients\":[[\"terre\",1,\"kg pommes de\"],[\"oignon\",1,\"u\"],[\"d'ail\",2,\"u gousse\"],[\"d'olive\",1,\"tbsp huile\"],[\"Madras\",2,\"tbsp curry\"],[\"moulu\",1,\"tbsp cumin\"],[\"persil\",1,\"c. à soupe\"],[\"moulu\",0.5,\"tbsp curcuma\"],[\"coco\",4,\"dl lait de\"],[\"sel\",\"\",\"\"],[\"poivre noir\",\"\",\"\"],[\"persil plat frais\",\"\",\"\"]],\"steps\":[\"Éplucher les pommes de terre et les couper en cubes.\",\"Hacher l'oignon, l'ail et le persil (réserver qqes feuilles pour la garniture).\",\"Dans une grande casserole, faire chauffer l'huile d'olive à feu moyen et ajoutez l'oignon haché.\",\"Faire revenir l'oignon jusqu'à ce qu'il soit tendre et translucide.\",\"Ajouter l'ail haché et faire cuire pendant une minute de plus.\",\"Ajouter les épices (curry, cumin, persil et curcuma) et faire cuire pendant 2 à 3 minutes, en remuant constamment pour éviter que les épices ne brûlent.\",\"Ajouter les pommes de terre coupées en cubes et mélangez bien pour les enrober d'épices.\",\"Ajouter le lait de coco et portez à ébullition.\",\"Réduisez le feu et laisser mijoter doucement pendant 20 à 25 minutes, ou jusqu'à ce que les pommes de terre soient tendres.\",\"Assaisonner le curry avec du sel et du poivre noir moulu selon goût.\",\"Servir le curry chaud, garni de persil plat frais hachée, avec du riz.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Plat principal\"],\"source\":\"https://www.poivre.ch/recette/curry-de-pommes-de-terre-aux-epices-douces/\",\"notes\":\"\",\"paprikaUid\":\"24B97E6B-B744-454D-873B-3848B3207B83\"},{\"id\":\"curry-de-lentilles-recette-swissmilk-mrryzeheutk\",\"title\":\"Curry De Lentilles - Recette | Swissmilk\",\"category\":\"A\",\"time\":30,\"servings\":4,\"ingredients\":[[\"portions\",4,\"\"],[\"Quantité Ingrédients\",\"\",\"\"],[\"d'ail hachée\",1,\"gousse\"],[\"- 2 cs de gingembre haché\",1,\"\"],[\"nouveaux, tiges coupées en rondelles et oignon haché\",3,\"petits oignons ou oignons\"],[\"dés\",400,\"g de carottes coupées en\"],[\"beurre pour faire revenir\",\"\",\"\"],[\"curry\",1,\"cs de\"],[\"entier\",0.5,\"cc de cumin moulu ou\"],[\"écrasées\",0.5,\"cc de cardamome moulue ou en graines\"],[\"bouillon\",4,\"dl de\"],[\"coco\",50,\"g de flocons de noix de\"],[\"corail\",200,\"g de lentilles\"],[\"lait\",5,\"dl de\"],[\"sel\",\"\",\"\"],[\"jus de citron vert ou jaune\",\"\",\"\"],[\"yogourt, selon les goûts\",180,\"g de\"]],\"steps\":[\"min\",\"Faire revenir l'ail, le gingembre, les oignons et les carottes avec le curry, le cumin et la cardamome. Mouiller avec le bouillon.\",\"Ajouter les flocons de noix de coco, les lentilles et le lait. Laisser mijoter 15-20 min en remuant de temps en temps. Assaisonner de jus de citron vert ou jaune.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"A\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2023_DIVE_115/curry-de-lentilles/?collection=17\",\"notes\":\"\",\"paprikaUid\":\"B42B8B1C-67F3-4D07-8744-268BC0CF2D79\"},{\"id\":\"cuisses-de-poulet-au-limoncello-mrryzehdk4f\",\"title\":\"Cuisses de poulet au Limoncello\",\"category\":\"Italie\",\"time\":140,\"servings\":4,\"ingredients\":[[\"d’ail\",1,\"u gousses\"],[\"ferme\",600,\"g pommes de terre à chair\"],[\"citrons\",1,\"u\"],[\"d'olive\",2,\"tbsp huile\"],[\"huile\",1,\"\"],[\"poule\",1,\"dl bouillon de\"],[\"câpres\",40,\"g\"],[\"concassées\",1,\"u boîte tomates\"],[\"Limoncello\",2,\"c. à soupe\"],[\"poulet\",4,\"u cuisses\"],[\"blanc\",1,\"dl vin\"],[\"frais\",1,\"tsp romarin\"],[\"poivre\",\"\",\"\"],[\"sel\",\"\",\"\"]],\"steps\":[\"Hacher menu le romarin et presser l'ail.\",\"Mélanger avec le Limoncello, l'huile et le poivre.\",\"Séparer les hauts de cuisse des pilons de poulet et les passer dans la marinade.\",\"Couvrir et laisser mariner pendant env. 1 h au réfrigérateur.\",\"Sortir le poulet, le sécher avec de l'essuie-tout et le saler.\",\"Faire chauffer l'huile dans une cocotte.\",\"Y faire dorer le poulet pendant env. 5 min de chaque côté.\",\"Le sortir de la poêle.\",\"Essuyer la graisse.\",\"Verser le vin et le bouillon, les porter à ébullition.\",\"Y ajouter le poulet.\",\"Couvrir et laisser mijoter à petit feu pendant env. 25 minutes.\",\"Couper les pommes de terre en quartiers.\",\"Râper le zeste du citron.\",\"Les ajouter au poulet avec les câpres rincés et égouttés ainsi que les tomates.\",\"Rectifier l'assaisonnement.\",\"Couvrir et poursuivre la cuisson pendant env. 25 minutes.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Poulet\"],\"source\":\"https://fooby.ch/fr/recettes/9946/cuisses-de-poulet-au-limoncello\",\"notes\":\"\",\"paprikaUid\":\"78E0A77B-C5CE-4D9A-87D4-AD1EB60BF32C\"},{\"id\":\"creme-a-l-orange-maison-a-la-cocotte-mrryzehcr7b\",\"title\":\"Crème à l'orange maison à la cocotte\",\"category\":\"Cocotte\",\"time\":30,\"servings\":6,\"ingredients\":[[\"œufs\",3,\"\"],[\"sucre\",100,\"gr\"],[\"d'orange\",50,\"cl jus\"],[\"zeste d'une orange\",\"\",\"\"],[\"liquide\",90,\"gr caramel\"],[\"maïzena\",20,\"gr\"]],\"steps\":[\"Zester une orange avec un zesteur d'agrume\",\"Presser les oranges pour obtenir 50 cl de jus\",\"Casser les œufs dans un saladier.\",\"Les battre énergiquement avec un fouet.\",\"Rajouter le zeste et le jus d'orange.\",\"Fouetter ensuite.\",\"Compléter avec le sucre et la maïzena\",\"Mélanger de nouveau l'appareil à crème d'orange\",\"Mettre dans chaque verrine une cuillère à soupe de caramel liquide (15 gr).\",\"Répartir l'appareil dans les verrines.\",\"Les couvrir ensuite d'un morceau de papier aluminium.\",\"Verser 75 cl d'eau dans la cocotte-minute.\",\"Mettre le panier au fond avec le trépied (les verrines ne doivent pas toucher l'eau).\",\"Disposer les ramequins dans le panier vapeur.\",\"Fermer en position cuisson vapeur et faire chauffer à feu vif.\",\"Dès que la vapeur s'échappe, réduire la source de chauffe (feu moyen) et laisser cuire 10 minutes.\",\"Dépressuriser l'autocuiseur et sortir les verrines de crème à l'orange.\",\"Mettre au frais plusieurs heures et servir bien frais !\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Cocotte\",\"Dessert\"],\"source\":\"https://www.the-best-recipes.com/creme-orange-maison/\",\"notes\":\"\",\"paprikaUid\":\"CE61AB3E-3242-4E3F-B6D6-3B8B3DA0C8EE\"},{\"id\":\"creme-renversee-a-la-cocotte-mrryzehcmuy\",\"title\":\"Crème renversée à la cocotte\",\"category\":\"Cocotte\",\"time\":12,\"servings\":6,\"ingredients\":[[\"lait\",0.5,\"l\"],[\"oeufs\",3,\"\"],[\"sucre\",100,\"g\"],[\"vanillé\",1,\"gousse vanille ou un sachet de sucre\"],[\"sel\",\"\",\"\"]],\"steps\":[\"Faites bouillir le lait avec le sucre, le sel et la vanille.\",\"Hors du feu, ajoutez le lait peu à peu aux œufs battus en fouettant sans arrêt.\",\"Versez dans un moule à soufflé caramélisé.\",\"Versez 2 cm d'eau dans la cocotte minute.\",\"Déposez-y le moule à soufflé.\",\"Couvrez-le d'une assiette.\",\"Fermez la cocotte minute.\",\"Mettez à feu vif.\",\"Dès chuchotement, réduisez le feu.\",\"Laissez cuire 7 minutes.\",\"Aussitôt la cuisson terminée, ôtez la soupape.\",\"Quand la vapeur s'est échappée ouvrez la cocotte minute.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Cocotte\",\"Dessert\"],\"source\":\"https://www.ptitchef.com/recettes/dessert/creme-renversee-a-la-cocotte-minute-fid-93789\",\"notes\":\"\",\"paprikaUid\":\"113598AA-5170-42D5-BBD4-D52DBB59DFF1\"},{\"id\":\"croute-au-fromage-du-haut-valais-mrryzehb2oz\",\"title\":\"Croûte au fromage du Haut-Valais\",\"category\":\"Plat principal\",\"time\":20,\"servings\":4,\"ingredients\":[[\"toast\",4,\"u tranches pain\"],[\"rôtir\",2,\"tbsp beurre à\"],[\"blanc\",1,\"dl vin\"],[\"terre\",300,\"g pommes de\"],[\"tomates\",2,\"u\"],[\"Raclette\",300,\"g fromage\"],[\"ail\",1,\"u gousse\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"paprika\",\"\",\"\"]],\"steps\":[\"La veille :\",\"Cuire les pommes de terre en robe des champs.\",\"Les couper en fines tranches.\",\"Le jour-même:\",\"Préchauffer le four à 200°C.\",\"Couper les tomates en petits dés.\",\"Presser l'ail.\",\"Mélanger les tomates et l'ail.\",\"Rectifier l'assaisonnement.\",\"Dorer les tranches de pain des deux côtés dans le beurre chaud.\",\"Disposer les sur la plaque chemisée de papier sulfurisé.\",\"Arroser de vin.\",\"Couvrir de pommes de terre.\",\"Répartir le mélange de tomates sur les pommes de terre.\",\"Poser le fromage par-dessus.\",\"Cuire 10-15 min dans la partie supérieure du four chaud.\",\"Avant de servir, ajouter paprika et poivre.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Suisse\",\"Végétarien\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2020_KAES_06/croute-au-fromage-du-haut-valais/\",\"notes\":\"\",\"paprikaUid\":\"97C7A2DE-149D-4076-8693-525B72663131\"},{\"id\":\"croquettes-au-jambon-serrano-mrryzeha9fp\",\"title\":\"Croquettes au jambon Serrano\",\"category\":\"Snack\",\"time\":155,\"servings\":20,\"ingredients\":[[\"beurre\",70,\"g\"],[\"fleur\",80,\"g farine\"],[\"lait\",5,\"dl\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"noix de muscade\",\"\",\"\"],[\"Serrano\",150,\"g jambon\"],[\"œufs\",3,\"u\"],[\"chapelure\",150,\"g\"],[\"friture\",4,\"dl huile de\"]],\"steps\":[\"Faire fondre le beurre à feu doux.\",\"Ajouter la farine, bien mélanger.\",\"Y verser le lait et faire mijoter jusqu'à liaison, soit env. 5 min, sans cesser de remuer à l'aide d'un fouet.\",\"Relever de sel, de poivre et de noix de muscade.\",\"Couper le jambon en morceaux d'env. 5 mm et les incorporer au mélange farine-lait.\",\"Verser la préparation dans un récipient, couvrir d'un film alimentaire et mettre au frigo au moins 2 h.\",\"Battre les œufs dans une assiette creuse.\",\"Verser la chapelure dans une autre.\",\"Sortir la pâte du frigo, la démouler et la couper en cubes.\",\"Modeler chaque cube de façon à leur donner la forme d'une croquette.\",\"Les tourner dans la chapelure, les passer dans l'œuf puis les tourner une nouvelle fois dans la chapelure.\",\"Chauffer l'huile à env. 160 °C.\",\"Y faire dorer les croquettes env. 2 min.\",\"Procéder par portions.\",\"À servir idéalement avec une sauce de tomates.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Snack\"],\"source\":\"https://migusto.migros.ch/fr/recettes/croquettes-au-jambon-serrano\",\"notes\":\"\",\"paprikaUid\":\"1F526FF0-1524-4D36-8EF6-2F3B7FD1BC66\"},{\"id\":\"cornettes-a-la-viande-hachee-et-compote-de-pommes-mrryzehaony\",\"title\":\"Cornettes à la viande hachée et compote de pommes\",\"category\":\"Plat principal\",\"time\":90,\"servings\":4,\"ingredients\":[[\"Compote de pommes:\",\"\",\"\"],[\"1½ dl jus de pomme\",\"\",\"\"],[\"citron\",2,\"c. à soupe jus de\"],[\"sucre\",2,\"c. à soupe\"],[\"(facultatif)\",0.5,\"bâton cannelle\"],[\"(Boskop, p. ex.) pelées, évidées, coupées en morceaux\",800,\"g pommes\"],[\"Viande hachée:\",\"\",\"\"],[\"hachée\",600,\"g viande de bœuf\"],[\"crème à rôtir\",\"\",\"\"],[\"haché\",1,\"oignon\"],[\"d'ail pressée\",1,\"gousse\"],[\"marjolaine\",3,\"brins\"],[\"thym\",5,\"brins\"],[\"tomates\",1,\"c. à soupe concentré de\"],[\"1½ c. à soupe farine\",\"\",\"\"],[\"bouillon\",1,\"dl vin rouge ou de\"],[\"bouillon\",2,\"dl\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"paprika\",\"\",\"\"],[\"cornettes\",400,\"g\"],[\"râpé\",100,\"g fromage\"],[\"marjolaine pour décorer\",\"\",\"\"]],\"steps\":[\"Compote: porter tous les ingrédients à ébullition, cuire à cœur 10-15 min.\",\"Retirer la cannelle, réduire les pommes en purée avec le liquide, laisser refroidir.\",\"Saisir la viande dans le beurre à rôtir.\",\"Réduire le feu.\",\"Ajouter l'oignon, l'ail, les herbes et le concentré de tomates, étuver.\",\"Saupoudrer de farine, mélanger.\",\"Mouiller avec le vin et/ou le bouillon, assaisonner.\",\"Mijoter 15- 20 min à couvert.\",\"Retirer les brins d'herbes.\",\"Cuire les cornettes al dente dans de l'eau bien salée, égoutter.\",\"Répartir la compote dans des bols.\",\"Dresser les cornettes et la viande dans des assiettes, parsemer de fromage, décorer.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Suisse\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM200903_89/cornettes-a-la-viande-hachee-et-compote-de-pommes/?collection=97824\",\"notes\":\"\",\"paprikaUid\":\"2D402501-2147-4221-A4CA-0CE4486EE50C\"},{\"id\":\"cornettes-a-la-fondue-et-aux-epinards-mrryzeh9vmr\",\"title\":\"Cornettes à la Fondue et aux épinards\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"cornette\",400,\"g\"],[\"rôtir\",1,\"c. à soupe crème à\"],[\"d'ail\",2,\"gousses\"],[\"fondue\",400,\"g mélange à\"],[\"1½ dl demi-crème\",\"\",\"\"],[\"blanc\",1,\"dl vin\"],[\"maïzena\",3,\"c. à soupe\"],[\"épinard\",200,\"g\"],[\"nouveau\",2,\"oignon\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"noix de muscade\",\"\",\"\"],[\"épice à fondue\",\"\",\"\"],[\"ciboulette\",1,\"bouquet\"]],\"steps\":[\"Cuire les cornettes al dente.\",\"Couper l'ail en fines tranches.\",\"Couper les oignons nouveaux en fines rondelles.\",\"Cuire les épinards dans de l'eau frémissante pendant 5 min.\",\"Verser dans de l'eau glacée.\",\"Égoutter et réserver.\",\"Chauffer la crème à rôtir dans une grande casserole.\",\"Faire revenir l'ail.\",\"Ajouter le vin blanc, le mélange à fondue et la crème.\",\"Bien mélanger.\",\"Ajouter la maïzena diluée dans du Kirsch.\",\"Chauffer à feu doux tout en remuant jusqu'à ce que la sauce soit bien crémeuse.\",\"Ajouter les cornettes.\",\"Incorporer les épinards et l'oignon nouveau.\",\"Rectifier l'assaisonnement.\",\"Dresser et décorer avec la ciboulette ciselée.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Suisse\",\"Végétarien\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2021_CHDO_57/cornettes-a-la-fondue-et-aux-epinards/\",\"notes\":\"\",\"paprikaUid\":\"781483E1-2DB9-40DB-B9FD-73AD3E8E3E94\"},{\"id\":\"cordon-bleu-classique-mrryzeh84q5\",\"title\":\"Cordon-bleu classique\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"veau, d'env. 160 g, à faire découper en porte-feuille par le boucher\",4,\"escalopes de\"],[\"paysan\",8,\"tranches jambon\"],[\"fromage\",250,\"g\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"œufs\",2,\"\"],[\"farine\",3,\"c. à soupe\"],[\"chapelure\",150,\"g\"],[\"rôtir\",150,\"g beurre à\"],[\"citron\",1,\"\"]],\"steps\":[\"Déposer les escalopes ouvertes sur le plan de travail.\",\"Les garnir chacune de 2 tranches de jambon.\",\"Détailler le fromage en tranches et les répartir sur le jambon.\",\"Refermer les escalopes et tasser soigneusement les bords.\",\"Fixer avec des cure-dents si souhaité.\",\"Saler et poivrer la viande.\",\"Battre les œufs dans une assiette creuse.\",\"Verser la farine dans une deuxième assiette creuse et la chapelure dans une autre.\",\"Tourner les escalopes dans la farine, les tapoter légèrement pour éliminer l'excédent, puis les passer dans l'œuf et finalement dans la chapelure.\",\"Bien appuyer.\",\"Faire fondre le beurre dans une poêle antiadhésive.\",\"Y faire dorer les cordons-bleus env. 10 min à feu moyen.\",\"Couper le citron en quartiers et servir avec la viande.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Suisse\"],\"source\":\"https://migusto.migros.ch/fr/recettes/cordon-bleu-classique\",\"notes\":\"\",\"paprikaUid\":\"4169073D-D259-4456-826D-602EE645E1C9\"},{\"id\":\"coq-au-vin-mrryzeh7985\",\"title\":\"Coq au vin\",\"category\":\"Cocotte\",\"time\":95,\"servings\":4,\"ingredients\":[[\"morceaux\",1,\"poulet coupé en\"],[\"oignons\",2,\"\"],[\"Paris\",200,\"g champignons de\"],[\"ail\",1,\"gousse\"],[\"carotte\",1,\"\"],[\"garni\",1,\"bouquet\"],[\"rouge\",1,\"bouteille vin\"],[\"lardons\",80,\"g\"],[\"volaille\",20,\"cl bouillon de\"],[\"beurre\",20,\"g\"],[\"huile\",1,\"c. à soupe\"],[\"persil\",1,\"bouquet\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Épluchez les oignons et l’ail puis émincez-les.\",\"Pelez la carotte et coupez-la en rondelles.\",\"Faites chauffer l’huile dans une cocotte.\",\"Y faites revenir les morceaux de coq sur toutes les faces.\",\"Réservez.\",\"A leur place, faites suer les oignons et les lardons pendant 2 min en remuant.\",\"Remettez les morceaux de coq dans la cocotte.\",\"Ajoutez les rondelles de carotte.\",\"Versez le vin rouge et le bouillon.\",\"Ajoutez l’ail et le bouquet garni.\",\"Salez, poivrez et laissez mijoter tout doucement pendant 1 h.\",\"Pendant ce temps, nettoyez et émincez les champignons.\",\"Faites-les revenir dans une poêle chaude avec le beurre.\",\"Incorporez-les dans la cocotte.\",\"Poursuivez la cuisson 5 min.\",\"Parsemez de persil et servez.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Cocotte\",\"Plat principal\",\"Poulet\"],\"source\":\"https://www.cuisineactuelle.fr/recettes/coq-au-vin-194147?_gl=1*blq60c*_gcl_aw*R0NMLjE3NjY4NjcyMTQuRUFJYUlRb2JDaE1JeXNDMzM4emVrUU1WS1pPREJ4MTNCeUY2RUFBWUFTQUFFZ0l0V19EX0J3RQ..*_ga*MTAyNDA0ODM1MS4xNzY2ODY3MDc4*_ga_5NSPQRQDQY*czE3NjY4NjcwNzgkbzEkZzEkdDE3NjY4NjcyMjYkajEkbDAkaDA.\",\"notes\":\"\",\"paprikaUid\":\"4550E47B-4095-47CD-990D-DB4320D115C3\"},{\"id\":\"congyou-luobosi-rettichsalat-mrryzeh69dj\",\"title\":\"Congyou Luobosi – Rettichsalat\",\"category\":\"Asie\",\"time\":0,\"servings\":4,\"ingredients\":[[\"blanc\",500,\"g radis\"],[\"fraîche\",10,\"g ciboulette\"],[\"nouveau\",2,\"u oignon\"],[\"échalotte\",1,\"u\"],[\"d'ail\",1,\"u gousse\"],[\"gingembre\",1,\"cm\"],[\"sel\",\"\",\"\"],[\"sucre\",\"\",\"\"],[\"colza\",5,\"tbsp huile de\"]],\"steps\":[\"Das Grün des Rettichs entfernen, dann waschen und schälen.\",\"Den Rettich mit einem Messer oder Streifenschneider in feine Streifen schneiden.\",\"Die Rettichstreifen in einer Schüssel mit Salz und Zucker mischen.\",\"Danach die Schüssel mit Frischhaltfolie bedecken und die Rettichstreifen mindestens 2 Stunden, besser über Nacht im Kühlschrank entwässern lassen.\",\"Ca. 2 Stunden vor dem Servieren die Rettichstreifen gründlich mit den Händen ausdrücken, je trockner, desto besser.\",\"Die ausgedrückten Rettichstreifen in eine saubere Schüssel geben und auflockern.\",\"Den Schnittlauch in Ringe schneiden und mittig auf den Rettichstreifen häufen.\",\"Wer auch Chiliflocken, geröstete Sesamkörner oder schwarzen Pfeffer aus der Mühle hinzufügen möchte, kann diese ebenso mittig zu den Schnittlauchringen platzieren.\",\"Das Pflanzenöl in eine kalte Pfanne geben.\",\"Die Frühlingszwiebel schräg in lange, grobe Streifen schneiden.\",\"Die Schalotte in Ringe schneiden.\",\"Die Knoblauchzehe und Ingwerscheibe auf ein Küchenbrett legen und mit der breiten Seite eines Messers darauf schlagen.\",\"Alle Zutaten zu dem Öl hinzufügen.\",\"Nun den Herd einschalten und das Ganze bei mittlerer Hitze und ständigem Rühren braten, bis es leicht goldbraun ist und das Öl intensiv nach gerösteter Zwiebel riecht.\",\"Jetzt die gerösteten Zutaten aus dem Öl holen.\",\"Das Öl erneut heiß erhitzen, über das Schnittlauchhäufchen gießen und brutzeln lassen.\",\"Dann die Rettichstreifen mit den anderen Zutaten gut durchmischen.\",\"Je nach Geschmack jeweils eine kräftige Prise Salz und Zucker hinzufügen.\",\"Danach die Schüssel mit Frischhaltfolie bedecken und die Rettichstreifen ca. 2 Stunden bei Zimmertemperatur in dem Lauchöl durchziehen lassen.\",\"Dann sind sie zum Genießen bereit.\",\"Tipp: Im Kühlschrank ist der Rettichsalat ca. drei Tage haltbar.\",\"Die gebratenen Frühlingszwiebelstreifen kann man als leckeres Topping, z. B. für Reis oder Nudeln benutzen.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Salade\"],\"source\":\"https://bukechi.com/congyou-luobosi-rettichsalat-mit-lauchoel/\",\"notes\":\"\",\"paprikaUid\":\"2C8E5E98-A81A-4277-853D-B168D08E1726\"},{\"id\":\"comme-un-waterzoi-avec-du-veau-mrryzeh5ikt\",\"title\":\"Comme Un Waterzoï Avec Du Veau\",\"category\":\"Plat principal\",\"time\":170,\"servings\":6,\"ingredients\":[[\"veau\",1,\"kg de sauté de\"],[\"carottes\",3,\"\"],[\"poireaux\",2,\"blancs de\"],[\"navets\",3,\"\"],[\"4 clous de girofle\",2,\"oignons piqués de\"],[\"d'ail\",2,\"gousses\"],[\"thym\",3,\"brins de\"],[\"laurier\",2,\"feuilles de\"],[\"huile végétale\",\"\",\"\"],[\"beurre\",\"\",\"\"],[\"poivre du moulin et en grains\",\"\",\"\"],[\"épaisse\",200,\"g de crème\"],[\"d'oeuf\",2,\"jaunes\"]],\"steps\":[\"Faites dorer les morceaux de viande dans une cocotte avec un peu d’huile et de beurre, ajoutez l’ail haché et tous les légumes pelés et coupés en petits morceaux. Gardez les oignons entiers et faites revenir quelques minutes.\",\"Ajoutez le laurier et le thym, un peu de sel, du poivre en grains, recouvrez largement d’eau ou de bouillon de volaille, mettez un couvercle et laissez frémir tout doucement pendant 2 h.\",\"Au dernier moment, mélangez les jaunes d’œufs et la crème, salez, poivrez, puis versez dans la cocotte et mélangez bien. La crème doit être chaude mais ne doit pas bouillir. Servez aussitôt.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Saison Autumne\"],\"source\":\"https://www.elle.fr/Elle-a-Table/Recettes-de-cuisine/Comme-un-waterzoi-avec-du-veau-2643276\",\"notes\":\"\",\"paprikaUid\":\"D7DCF99A-CB5D-4E28-BFAD-5E6897B6579D\"},{\"id\":\"coleslaw-mrryzeh4sjg\",\"title\":\"Coleslaw\",\"category\":\"Salade\",\"time\":20,\"servings\":4,\"ingredients\":[[\"Sauce:\",\"\",\"\"],[\"forte\",1,\"c. à soupe moutarde\"],[\"citron\",3,\"c. à soupe jus de\"],[\"mayonnaise\",3,\"c. à soupe\"],[\"grecque\",150,\"g yogourt\"],[\"sucre\",0.5,\"c. à café miel ou\"],[\"haché\",1,\"oignon finement\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"blanc\",600,\"g chou\"],[\"carotte, râpée à la râpe à rösti ou à bircher\",1,\"\"]],\"steps\":[\"Sauce:\",\"Mélanger tous les ingrédients dans un saladier.\",\"Couper le chou blanc en deux, retirer le tronc.\",\"Couper les feuilles en fines lamelles ou les râper.\",\"Bien les malaxer pour les attendrir.\",\"Ajouter le chou et la carotte à la sauce.\",\"Mélanger.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Salade\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2018_DIVE_45/coleslaw/\",\"notes\":\"\",\"paprikaUid\":\"0763B7FF-E0DE-4865-A8B4-BDDFE848E00A\"},{\"id\":\"cocotte-de-poulet-aux-morilles-a-la-creme-mrryzeh3xj4\",\"title\":\"Cocotte de poulet aux morilles à la crème\",\"category\":\"Cocotte\",\"time\":70,\"servings\":6,\"ingredients\":[[\"boucher\",1,\"poulet découpé en morceaux par votre\"],[\"échalotes\",2,\"\"],[\"blanc\",25,\"cl vin\"],[\"liquide\",25,\"cl crème\"],[\"volaille\",15,\"cl bouillon de\"],[\"morilles\",250,\"g\"],[\"maïs\",2,\"c. à café fécule de\"],[\"huile\",4,\"c. à soupe\"],[\"plat\",1,\"branche persil\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Ôtez la première peau de vos échalotes et ciselez-les.\",\"Lavez très soigneusement vos morilles.\",\"Salez et poivrez vos morceaux de poulet.\",\"Dans une cocotte chaude sur feu vif, colorez sur toutes leurs faces vos morceaux de poulet dans l’huile pendant 10 minutes.\",\"Réservez-les.\",\"Dégraissez légèrement votre cocotte sans la nettoyer.\",\"Faites-y revenir vos échalotes avec un peu de sel sur feu moyen pendant 5 minutes en prenant soin de remuer régulièrement.\",\"Ajoutez le vin jaune et grattez le fond de votre cocotte avec une cuillère en bois pour décoller l’ensemble des sucs de cuisson.\",\"Faites réduire des 2/3.\",\"Ajoutez le bouillon de volaille, la crème liquide et les morceaux de poulet.\",\"Poursuivez la cuisson à feu doux pendant 30 minutes.\",\"Ajoutez les morilles et poursuivez la cuisson 15 minutes.\",\"Ajoutez la fécule de maïs et mélangez jusqu’à ce que votre sauce épaississe.\",\"Au dernier moment, ajoutez 5 cl de vin jaune et mélangez.\",\"Salez et poivrez.\",\"Agrémentez votre plat de persil effeuillé et haché.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Cocotte\",\"Plat principal\",\"Poulet\"],\"source\":\"https://www.cuisineactuelle.fr/recettes/cocotte-de-poulet-aux-morilles-a-la-creme-192592?_gl=1*cj6o50*_gcl_aw*R0NMLjE3NjY4NjczMTUuRUFJYUlRb2JDaE1JeXNDMzM4emVrUU1WS1pPREJ4MTNCeUY2RUFBWUFTQUFFZ0l0V19EX0J3RQ..*_ga*MTAyNDA0ODM1MS4xNzY2ODY3MDc4*_ga_5NSPQRQDQY*czE3NjY4NjcwNzgkbzEkZzEkdDE3NjY4NjczMzckajI2JGwwJGgw\",\"notes\":\"\",\"paprikaUid\":\"6D73D021-1CCB-4E2E-BE0C-63BA52CFE112\"},{\"id\":\"cocotte-de-potee-au-chou-vert-mrryzeh2zrz\",\"title\":\"Cocotte de potée au chou vert\",\"category\":\"Cocotte\",\"time\":120,\"servings\":4,\"ingredients\":[[\"fumé\",500,\"g lard\"],[\"vert\",0.5,\"chou\"],[\"terre\",500,\"g pommes de\"],[\"poireaux\",4,\"\"],[\"carottes\",6,\"\"],[\"navets\",4,\"\"],[\"oignon\",1,\"\"],[\"boeuf\",1,\"cube bouillon de\"],[\"garni\",1,\"bouquet\"]],\"steps\":[\"Epluchez tous vos légumes et coupez-les en rondelles.\",\"Dans un grand faitout, faites bouillir 2 l d’eau.\",\"Ajoutez le cube de bouillon.\",\"Ajoutez le lard coupé en dés puis écumez pour retirer les impuretés.\",\"Ajoutez ensuite les légumes et le bouquet garni.\",\"Laissez mijoter pendant 2h.\",\"Salez, poivrez.\",\"Dégustez bien chaud.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Cocotte\",\"Plat principal\"],\"source\":\"https://www.cuisineactuelle.fr/recettes/cocotte-de-potee-au-chou-vert-234948?_gl=1*4abk81*_gcl_aw*R0NMLjE3NjY4NjcwODAuRUFJYUlRb2JDaE1JeXNDMzM4emVrUU1WS1pPREJ4MTNCeUY2RUFBWUFTQUFFZ0l0V19EX0J3RQ..*_ga*MTAyNDA0ODM1MS4xNzY2ODY3MDc4*_ga_5NSPQRQDQY*czE3NjY4NjcwNzgkbzEkZzEkdDE3NjY4NjcxMTMkajI1JGwwJGgw#\",\"notes\":\"\",\"paprikaUid\":\"8C1898C2-63B2-43E7-9564-6F3DF72760AC\"},{\"id\":\"cocotte-de-legumes-fanes-au-jambon-mrryzeh28qn\",\"title\":\"Cocotte de légumes-fanes au jambon\",\"category\":\"Cocotte\",\"time\":30,\"servings\":4,\"ingredients\":[[\"fanes\",1,\"botte carottes\"],[\"fanes\",1,\"botte navets\"],[\"branche\",1,\"céleri\"],[\"nouveaux\",1,\"botte oignons\"],[\"poireaux, petits\",300,\"g\"],[\"copeaux\",300,\"g jambon de Bayonne en\"],[\"d’épinard\",100,\"g pousses\"],[\"poulet\",1,\"l bouillon de\"],[\"d’olive\",1,\"c. à soupe huile\"],[\"cerfeuil\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Lavez et pelez tous les petits légumes.\",\"Versez l’huile d’olive dans une cocotte.\",\"Ajoutez les légumes.\",\"Salez, poivrez et mélangez.\",\"Verser 1/4 du bouillon de poule dans la cocotte et faites cuire à couvert, en remuant et en rajoutant du bouillon régulièrement jusqu’à ce que les légumes soient bien tendres.\",\"Ajoutez le jambon et les pousses d’épinards.\",\"Laissez cuire encore 5 min.\",\"Servez bien chaud parsemé d’herbes ciselées.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Cocotte\",\"Plat principal\",\"Poulet\"],\"source\":\"https://www.cuisineactuelle.fr/recettes/cocotte-de-legumes-fanes-au-jambon-106793?_gl=1*yxpc7r*_gcl_aw*R0NMLjE3NjY4NjczODkuRUFJYUlRb2JDaE1JeXNDMzM4emVrUU1WS1pPREJ4MTNCeUY2RUFBWUFTQUFFZ0l0V19EX0J3RQ..*_ga*MTAyNDA0ODM1MS4xNzY2ODY3MDc4*_ga_5NSPQRQDQY*czE3NjY4NjcwNzgkbzEkZzEkdDE3NjY4Njc0NTAkajM3JGwwJGgw\",\"notes\":\"\",\"paprikaUid\":\"C224767D-3330-4838-A569-E7524938AF6A\"},{\"id\":\"cocotte-de-coq-au-vin-et-champignons-forestiers-mrryzeh1x3m\",\"title\":\"Cocotte de coq au vin et champignons forestiers\",\"category\":\"Cocotte\",\"time\":160,\"servings\":4,\"ingredients\":[[\"poulet\",1,\"u\"],[\"rouge\",75,\"cl vin\"],[\"cognac\",4,\"c. à soupe\"],[\"champignon\",250,\"g\"],[\"carotte\",200,\"g\"],[\"oignon\",100,\"g\"],[\"échalote\",40,\"g\"],[\"d'ail\",3,\"u gousse\"],[\"tomates\",30,\"g concentré de\"],[\"garnis\",2,\"u bouquet\"],[\"beurre\",40,\"g\"],[\"d'olive\",3,\"cl huile\"],[\"farine\",40,\"g\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"La veille, faites mariner le coq coupé en morceaux dans un plat creux avec le vin rouge et un bouquet garni.\",\"Couvrez le plat et laissez mariner toute la nuit en le plaçant au réfrigérateur.\",\"Le lendemain, égouttez les morceaux de coq.\",\"Épongez-les à l’aide de papier absorbant.\",\"Réservez la marinade.\",\"Faites revenir les morceaux de coq dans une cocotte avec l'huile d'olive et le beurre.\",\"Puis retirez-les et réservez.\",\"Dans cette même cocotte, faites fondre à feu doux pendant 10 min les carottes épluchées et coupées en rondelles, les oignons, les gousses d'ail et les échalotes.\",\"Saupoudrez de farine.\",\"Mélangez et ajoutez le cognac et le concentré de tomates.\",\"Replacez ensuite les morceaux de coq.\",\"Arrosez avec le vin de la marinade.\",\"Ajoutez le bouquet garni restant.\",\"Salez et poivrez.\",\"Faites mijoter doucement le coq au vin à couvert pendant 1 heure 30 à 2 heures.\",\"Pendant ce temps, lavez les champignons et coupez-les en 4 ou en 6, selon leur grosseur.\",\"Séchez-les dans du papier absorbant.\",\"Faites-les sauter dans une poêle avec 1 cuil. à soupe d'huile.\",\"Disposez les morceaux de coq dans un plat de service.\",\"Nappez avec une partie de la sauce.\",\"Garnissez avec les champignons.\",\"Servez bien chaud.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Cocotte\",\"Plat principal\",\"Poulet\"],\"source\":\"https://www.cuisineactuelle.fr/recettes/cocotte-de-coq-au-vin-et-champignons-forestiers-212988?_gl=1*17m0cxj*_gcl_aw*R0NMLjE3NjY4NjcxOTAuRUFJYUlRb2JDaE1JeXNDMzM4emVrUU1WS1pPREJ4MTNCeUY2RUFBWUFTQUFFZ0l0V19EX0J3RQ..*_ga*MTAyNDA0ODM1MS4xNzY2ODY3MDc4*_ga_5NSPQRQDQY*czE3NjY4NjcwNzgkbzEkZzEkdDE3NjY4NjcxOTEkajM2JGwwJGgw\",\"notes\":\"\",\"paprikaUid\":\"A04F59BA-C862-4230-B0CC-2153D6BEE41D\"},{\"id\":\"cocotte-de-b-uf-bourguignon-mrryzeh0ez3\",\"title\":\"Cocotte de bœuf bourguignon\",\"category\":\"Cocotte\",\"time\":200,\"servings\":6,\"ingredients\":[[\"braiser\",1,\"kg boeuf à\"],[\"carottes\",2,\"\"],[\"grelot\",12,\"oignons\"],[\"ail\",1,\"gousse\"],[\"1½ l vin de bourgogne\",\"\",\"\"],[\"veau\",40,\"cl fond de\"],[\"farine\",2,\"c. à soupe\"],[\"lardons\",150,\"g\"],[\"Paris\",200,\"g champignons de\"],[\"lauriers\",2,\"feuilles de\"],[\"moyennes\",6,\"pommes de terre\"],[\"neutre\",6,\"c. à soupe huile\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"La veille, coupez la viande en morceaux.\",\"Pelez les carottes, éliminez les extrémités et coupez-les en petits morceaux.\",\"Otez la première peau de vos oignons grelot.\",\"Passez votre gousse d’ail au presse-ail pour en récupérer la pulpe.\",\"Mettez l’ensemble des ingrédients dans un saladier.\",\"Recouvrez-les de vin rouge.\",\"Ajoutez les feuilles de laurier.\",\"Filmez et entreposez 12 h au réfrigérateur.\",\"Versez le contenu de votre saladier dans une passoire.\",\"Conservez le vin.\",\"Séparez la viande de la garniture aromatique.\",\"Dans une cocotte chaude, colorez votre viande dans l’huile sur toutes ses faces sur feu vif pendant 5 minutes.\",\"Réservez la viande.\",\"Dégraissez légèrement votre cocotte sans la nettoyer.\",\"Faites-y revenir votre garniture aromatique avec un peu de sel pendant 5 minutes en prenant soin de remuer régulièrement.\",\"Ajoutez les morceaux de viande et la farine.\",\"Faites revenir l’ensemble 1 minute tout en mélangeant.\",\"Mouillez avec le vin de votre marinade et le fond de veau.\",\"Faites bouillir puis baissez le feu.\",\"Couvrez et faites cuire 2 h 30 minutes.\",\"Pendant ce temps pelez les pommes de terre puis faites-les cuire dans une casserole remplie d’eau froide pendant 30 minutes.\",\"Vérifiez la cuisson à l’aide de la pointe d’un couteau.\",\"Coupez-les en morceaux.\",\"Nettoyez les champignons.\",\"Eliminez la base des pieds puis coupez-les en morceaux.\",\"Au bout de 2 h 15 de cuisson, ajoutez les champignons, les pommes de terre et les lardons dans votre cocotte.\",\"Poursuivez la cuisson 10 minutes supplémentaires.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Cocotte\",\"Plat principal\"],\"source\":\"https://www.cuisineactuelle.fr/recettes/cocotte-de-boeuf-bourguignon-191931?_gl=1*1o9h8kn*_gcl_aw*R0NMLjE3NjY4NjcyNDguRUFJYUlRb2JDaE1JeXNDMzM4emVrUU1WS1pPREJ4MTNCeUY2RUFBWUFTQUFFZ0l0V19EX0J3RQ..*_ga*MTAyNDA0ODM1MS4xNzY2ODY3MDc4*_ga_5NSPQRQDQY*czE3NjY4NjcwNzgkbzEkZzEkdDE3NjY4NjcyNTMkajQzJGwwJGgw\",\"notes\":\"\",\"paprikaUid\":\"DA9BF147-5712-4E13-8056-A3C5A629920B\"},{\"id\":\"cocktail-aigre-doux-mrryzegz166\",\"title\":\"Cocktail aigre-doux\",\"category\":\"Boisson\",\"time\":5,\"servings\":4,\"ingredients\":[[\"glaçons\",\"\",\"\"],[\"citrons, soit 16 rondelles d’env. 3 mm\",2,\"\"],[\"(Spritz italien)\",4,\"dl Crodino\"],[\"1½ l moscato ou de Rimuss\",\"\",\"\"]],\"steps\":[\"Mettre 2 glaçons dans chaque verre rafraîchi.\",\"Couvrir d’une rondelle de citron\",\"Verser le Crodino.\",\"Ajouter 2 glaçons.\",\"Couvrir d’une rondelle de citron.\",\"Remplir de Moscato.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Boisson\",\"Saison Été\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/cocktail-sweet-bitter-10002016/\",\"notes\":\"\",\"paprikaUid\":\"E639511D-E9DC-4BD9-B71F-AACDCD607E22\"},{\"id\":\"clafoutis-aux-abricots-mrryzegyfi0\",\"title\":\"Clafoutis aux abricots\",\"category\":\"Cocotte\",\"time\":48,\"servings\":2,\"ingredients\":[[\"abricots\",2,\"\"],[\"demi-écrémé\",5,\"cl lait\"],[\"1½ œufs\",\"\",\"\"],[\"farine\",40,\"g\"],[\"sucre\",25,\"g\"],[\"beurre\",15,\"g\"],[\"sel\",\"\",\"\"]],\"steps\":[\"Dans un saladier, mélangez la farine, le sel, le sucre.\",\"Ajoutez les œufs battus en remuant.\",\"Versez le lait et le beurre fondu.\",\"Fouettez bien.\",\"Beurrez un moule à manqué de 16 cm de diamètre.\",\"Lavez et dénoyautez les abricots.\",\"Coupez-les en 4.\",\"Répartissez-les dans le moule.\",\"Versez la pâte.\",\"Dans l'autocuiseur, versez l'eau.\",\"Mettez le moule dans le panier vapeur.\",\"Placer le panier dans la cuve.\",\"Fermer l'autocuiseur.\",\"Dès que la vapeur s'échappe, baisser le feu.\",\"Laisser cuire selon le temps indiqué.\",\"Veillez, au cours de la cuisson, à ce que la soupape chuchote.\",\"Ouvrez l'autocuiseur.\",\"Démoulez le clafoutis tiède.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Cocotte\",\"Dessert\"],\"source\":\"https://www.tefal.fr/recette/detail/PRO/Clafoutis-aux-abricots/12086\",\"notes\":\"\",\"paprikaUid\":\"32E18DA1-75CD-44A3-80AF-12C75521BD4A\"},{\"id\":\"chou-frise-farci-mrryzegxpxm\",\"title\":\"Chou frisé farci\",\"category\":\"Plat principal\",\"time\":140,\"servings\":4,\"ingredients\":[[\"frisé\",1,\"u chou\"],[\"sel\",\"\",\"\"],[\"vertes\",150,\"g lentilles\"],[\"échalotes\",2,\"u\"],[\"herbes\",2,\"u fines\"],[\"lardon\",60,\"g\"],[\"poivre\",\"\",\"\"],[\"légumes\",1,\"dl bouillon de\"],[\"demi-crème\",2,\"dl\"]],\"steps\":[\"Poser le chou sur la tête et, à l'aide d'un couteau, retirer délicatement le tronc de façon à ce que les feuilles tiennent toujours ensemble.\",\"Recouvrir le chou d'une grande quantité d'eau salée.\",\"Le faire cuire env. 15 min.\",\"Laisser égoutter sur un torchon.\",\"Pour la farce, cuire les lentilles à couvert dans de l'eau jusqu'à tendreté, soit env. 25 min.\",\"Les égoutter.\",\"Hacher les échalotes et les fines herbes.\",\"Saisir les lardons à sec dans une poêle.\",\"Ajouter les échalotes et faire brièvement revenir.\",\"Retirer du feu.\",\"Ajouter les lentilles et les fines herbes.\",\"Relever de sel et de poivre.\",\"Laisser tiédir.\",\"Placer le chou frisé, base vers le bas, sur le plan de travail.\",\"Ecarter délicatement les feuilles.\",\"Découper soigneusement le «cœur» du chou, le hacher et l'ajouter à la farce aux lentilles.\",\"Remplir le trou créé avec un peu de farce puis rabattre progressivement les feuilles en déposant de la farce entre chacune d'elles.\",\"Ne pas farcir les deux dernières couches de feuilles, simplement les rabattre pour fermer le chou.\",\"Lier le chou farci avec une ficelle.\",\"Déposer le chou dans une cocotte.\",\"Y verser le bouillon et la demi-crème.\",\"Assaisonner de sel et de poivre.\",\"Couvrir et glisser dans la moitié inférieure du four froid.\",\"Faire cuire 55-60 min à 180 °C.\",\"Retirer le couvercle après 45 min.\",\"Servir le chou avec la sauce.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Saison Autumne\",\"Saison Hiver\"],\"source\":\"https://migusto.migros.ch/fr/recettes/chou-frise-farci\",\"notes\":\"\",\"paprikaUid\":\"B7A0FBC6-6FE9-47E4-A099-BA0EB6CE203B\"},{\"id\":\"chop-suey-mrryzegwnh1\",\"title\":\"Chop Suey\",\"category\":\"Asie\",\"time\":0,\"servings\":4,\"ingredients\":[[\"eau\",6,\"c. à soupe\"],[\"sucre\",1,\"c. à café\"],[\"claire\",6,\"c. à soupe sauce soja\"],[\"poulet\",400,\"g filets de\"],[\"maïs\",2,\"c. à soupe fécule de\"],[\"oignon\",1,\"\"],[\"carottes\",2,\"\"],[\"champignons\",200,\"g\"],[\"d'ail\",2,\"gousses\"],[\"sésame\",2,\"c. à soupe huile de\"],[\"poireau\",1,\"\"],[\"mungo\",150,\"g germes de haricot\"],[\"gourmands\",100,\"g pois\"],[\"eau\",1,\"dl\"],[\"claire\",1,\"dl sauce soja\"],[\"Sambal Oelek\",\"\",\"\"],[\"maïzena\",1,\"c. à soupe\"],[\"sucre\",1,\"c. à café\"]],\"steps\":[\"Mettre la sauce soja, le sucre, la maïzena et l’eau dans un bol.\",\"Ajouter le poulet coupé en fines lamelles.\",\"Bien mélanger le tout et laisser mariner pendant environ 2 heures.\",\"Couper l’oignon, le poireau, les carottes et les champignons en fines rondelles.\",\"Éplucher les gousses d’ail et les hacher finement.\",\"Chauffer l’huile de sésame dans un wok.\",\"Y faire cuire le poulet mariné à feu vif jusqu’à ce qu’il soit bien cuit.\",\"Ajouter les légumes.\",\"Bien mélanger et faire revenir le tout un court instant.\",\"Réduire ensuite la température.\",\"Ajouter les pois mange-tout ainsi que les germes de haricot mungo.\",\"Laisser cuire l’ensemble quelques minutes à feu moyen.\",\"Pour la sauce, mélanger l’eau, le sucre, le sambal oelek et la sauce soja.\",\"Verser la sauce dans le wok et ajouter une pincée de maïzena.\",\"Porter le chop suey à ébullition quelques instants.\",\"Assaisonner avec du sel et un peu de sucre.\",\"Comme accompagnement, le riz basmati ou le riz jasmin convient très bien, tout comme les nouilles de verre.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Poulet\",\"Wok\"],\"source\":\"https://www.kisag.ch/fr/recettes/chop-suey\",\"notes\":\"\",\"paprikaUid\":\"688C1CF7-D2EB-4782-A0DC-9B4BCA2D6B44\"},{\"id\":\"chinesischer-kartoffelsalat-mrryzegvtyg\",\"title\":\"Chinesischer Kartoffelsalat\",\"category\":\"Asie\",\"time\":0,\"servings\":4,\"ingredients\":[[\"ferme\",300,\"g pomme de terre\"],[\"nouveau\",1,\"u oignon\"],[\"rouge\",0.5,\"u poivron pointu\"],[\"vert\",0.5,\"u poivron pointu\"],[\"d'ail\",3,\"u gousse\"],[\"chili\",4,\"u\"],[\"poivre\",0.5,\"c. à café\"],[\"sel\",0.25,\"c. à café\"],[\"½ tbsp vinaigre de riz\",1,\"\"],[\"soja\",2,\"tbsp sauce\"],[\"colza\",4,\"tbsp huile de\"]],\"steps\":[\"Die Kartoffeln schälen, abwaschen.\",\"Entlang der langen Seite in dünne Streifen schneiden (etwa so dick wie Streichhölzer). Schneller geht es mit einem Gemüseschneider für feine Streifen.\",\"Eine Schüssel mit kaltem Wasser füllen, dann die Kartoffelstreifen hineingeben und 5 Minuten wässern, um die Stärke der Kartoffeln auszuwaschen.\",\"Nach 5 Minuten die Kartoffelstreifen zwei bis drei Mal spülen.\",\"Dann abtropfen lassen.\",\"Die roten und grünen Spitzpaprika abwaschen.\",\"Die weißen Wände und die Kerne entfernen.\",\"Dann in feine Streifen schneiden.\",\"Die Frühlingszwiebel abwaschen und ebenso in feine Streifen schneiden.\",\"Jetzt die Sauce mischen.\",\"Salz, Glutamat/Aromat, Reisessig und helle Sojasauce in einer kleinen Schüssel mischen und breitstellen.\",\"Eine große Schüssel mit kaltem Wasser füllen.\",\"In einem Topf reichlich Wasser aufkochen.\",\"Reisessig hinzugeben, danach die Kartoffelstreifen hineingeben, bei hoher Hitze ca. ½ Minute blanchieren.\",\"Dann die Kartoffelstreifen sofort rausholen und in das kalte Wasser geben, um sie abzukühlen.\",\"Danach die Kartoffelstreifen in ein Sieb geben und unter fließendem Wasser abspülen.\",\"Gut abtropfen lassen.\",\"Knoblauchzehen fein hacken.\",\"Chilischoten in Stücke schneiden und zusammen mit den Sichuanpfefferkörnern in eine hitzebeständige tiefe Schüssel geben.\",\"In einer Pfanne Rapsöl erhitzen, bis es leicht raucht. Dann das Öl vorsichtig zu dem Knoblauch-Chili-Sichuanpfeffer-Gemisch gießen und umrühren.\",\"Die abgetropften Kartoffel-, Spitzpaprika- und Frühlingszwiebelstreifen in eine große Schüssel geben.\",\"Die Sauce und das Öl mit dem Inhalt hineingeben und vermischen.\",\"Fertig.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Salade\"],\"source\":\"https://bukechi.com/chinesischer-kartoffelsalat/\",\"notes\":\"\",\"paprikaUid\":\"208C7139-03F4-4189-9A2F-35EF00A63E1A\"},{\"id\":\"chili-con-carne-l-authentique-tex-mex-mrryzeguqdp\",\"title\":\"Chili-Con Carne l'Authentique Tex-Mex\",\"category\":\"Plat principal\",\"time\":0,\"servings\":4,\"ingredients\":[[\"viande\",500,\"g\"],[\"oignon\",1,\"u\"],[\"d'ail\",2,\"u gousse\"],[\"rouge, vert ou jaune\",1,\"u poivron\"],[\"concassées\",400,\"g tomates\"],[\"rouges\",400,\"g haricots\"],[\"maïs\",400,\"g\"],[\"chili-con-carne\",2,\"tbsp mélange barbecue\"]],\"steps\":[\"Égoutter et rincer les haricots et le maïs.\",\"Hacher l'oignon et l'ail.\",\"Couper le poivron en petits dés.\",\"Dans une grande cocotte ou une sauteuse, faire revenir la viande hachée jusqu'à ce qu'elle soit bien dorée.\",\"Égoutter l'excédent de graisse.\",\"Ajouter l'oignon et l'ail, ainsi que le poivron.\",\"Faire revenir quelques minutes jusqu'à ce que les légumes soient tendres.\",\"Ajouter les tomates concassées, les haricots rouges, le maïs et le mélange barbecue chili-con-carne.\",\"Mélanger bien.\",\"Baisser le feu, couvrir et laisser mijoter pendant au moins 30 minutes, voire plus pour un goût plus intense.\",\"Ajuster l'assaisonnement si nécessaire.\",\"Servir avec riz ou purée de pommes de terre.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\"],\"source\":\"https://www.poivre.ch/recette/chili-con-carne-authentique-tex-mex/\",\"notes\":\"\",\"paprikaUid\":\"73ED14EE-8AAE-453F-93C7-20E7E5E81A0E\"},{\"id\":\"chicken-sweet-and-sour-mrryzegtixl\",\"title\":\"Chicken sweet and sour\",\"category\":\"Asie\",\"time\":0,\"servings\":4,\"ingredients\":[[\"poulet\",500,\"g blanc de\"],[\"ananas\",0.5,\"\"],[\"huile, idéalement de l'huile végétale\",3,\"c. à soupe\"],[\"rouge\",1,\"poivron\"],[\"printemps\",2,\"oignons de\"],[\"ketchup\",3,\"c. à soupe\"],[\"tomates\",1,\"c. à soupe concentré de\"],[\"d'ananas\",150,\"ml jus\"],[\"soja\",2,\"c. à soupe sauce\"],[\"d'eau\",1,\"dl\"],[\"vinaigre\",2,\"c. à soupe\"],[\"sucre\",2,\"c. à soupe\"],[\"sel\",\"\",\"\"],[\"maizena\",1,\"c. à soupe\"],[\"oeuf\",1,\"\"],[\"maizena\",4,\"c. à soupe\"],[\"paprika\",0.5,\"c. à café\"],[\"soja\",1,\"c. à soupe sauce\"]],\"steps\":[\"Couper les blancs de poulet en petits dés ou en lamelles selon les goûts.\",\"Mélanger avec l'œuf, le sel, le paprika et la sauce soja.\",\"Saupoudrer de maïzena.\",\"Bien mélanger.\",\"Couper l'ananas et les légumes en morceaux.\",\"Chauffer l'huile dans un wok.\",\"Rôtir le poulet et réserver.\",\"Faire revenir le poivron, les oignons nouveaux et l'ananas.\",\"Ajouter le concentré de tomates.\",\"Faire revenir brièvement.\",\"Ajouter le reste des ingrédients, sauf la maïzena et l'eau.\",\"Mélanger la maïzena avec l'eau et ajouter à la sauce.\",\"Porter à nouveau brièvement à ébullition.\",\"Incorporer les morceaux de poulet à la sauce et servir immédiatement.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Poulet\",\"Wok\"],\"source\":\"https://www.kisag.ch/fr/recettes/chicken-sweet-and-sour\",\"notes\":\"\",\"paprikaUid\":\"43F51617-99CF-41FC-A7DA-7E1A1855922E\"},{\"id\":\"chaussons-a-la-mozzarella-et-a-la-tomate-mrryzegso2k\",\"title\":\"Chaussons à la mozzarella et à la tomate\",\"category\":\"Snack\",\"time\":45,\"servings\":4,\"ingredients\":[[\"concassée\",1,\"u tomate\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"pizza\",1,\"tsp épice\"],[\"mozzarella\",40,\"g\"],[\"rectangulaire\",1,\"u pâte feuilletée\"],[\"œuf\",1,\"u\"]],\"steps\":[\"Égoutter les tomates dans une passoire fine.\",\"Les relever d'un peu de sel, de poivre et du mélange d'épices.\",\"Couper la mozzarella en dés.\",\"Préchauffer le four à 200 °C.\",\"Dérouler la pâte et découper 16 disques de pâte de 8 cm de Ø.\",\"Répartir une cuillère à café bombée de tomates ainsi qu'un peu de mozzarella sur la moitié d'entre eux.\",\"Battre l'œuf et en badigeonner finement le bord des disques.\",\"Couvrir avec le reste des ronds de pâte et sceller les bords en appuyant fermement.\",\"Déposer les chaussons sur une plaque chemisée de papier sulfurisé et les badigeonner avec le reste de l'œuf.\",\"Faire dorer env. 20 min au milieu du four.\",\"Servir chaud ou froid.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Snack\"],\"source\":\"https://migusto.migros.ch/fr/recettes/chaussons-a-la-mozzarella-et-a-la-tomate\",\"notes\":\"\",\"paprikaUid\":\"A150C170-AB6F-4DE3-8C7A-CFBE03E7101F\"},{\"id\":\"chaussons-au-jambon-et-aux-legumes-mrryzegrrih\",\"title\":\"Chaussons au jambon et aux légumes\",\"category\":\"Snack\",\"time\":40,\"servings\":8,\"ingredients\":[[\"poivron\",0.5,\"u\"],[\"surgelés\",100,\"g petis pois\"],[\"d'arachide\",2,\"tbsp huile\"],[\"terre\",150,\"g pommes de\"],[\"jambon\",2,\"u tranche\"],[\"paprika\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"ronde\",1,\"u pâte à gâteau\"],[\"œuf\",1,\"u\"],[\"huile\",\"\",\"\"],[\"sésame\",1,\"tsp graine de\"]],\"steps\":[\"Préchauffer le four à 180 °C.\",\"Peler les pommes de terre et les cuire dans l'eau salée.\",\"Égoutter et laisser refroidir.\",\"Couper le poivron en morceaux et les étuver quelques minutes dans l'huile d'arachide avec les petits pois.\",\"Couper également les pommes de terre et le jambon en petits morceaux.\",\"Les mélanger au poivron et aux petits pois.\",\"Relever de paprika et de sel.\",\"Partager la pâte en huit triangles.\",\"Badigeonner les coins avec l'œuf.\",\"Déposer un peu de farce sur chacun d'eux.\",\"Rabattre les pointes des triangles l'une après l'autre sur la farce et appuyer un peu pour les sceller.\",\"Espacer les chaussons sur une plaque chemisée de papier sulfurisé.\",\"Selon les goûts, les badigeonner d'huile.\",\"Les saupoudrer de paprika et parsemer de graines de sésame.\",\"Cuire env. 20 min au milieu du four.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Snack\"],\"source\":\"https://migusto.migros.ch/fr/recettes/chaussons-au-jambon-et-aux-legumes\",\"notes\":\"\",\"paprikaUid\":\"B975C18C-C244-476F-9C26-3809603551EC\"},{\"id\":\"champignons-aux-3-farces-mrryzegq7nm\",\"title\":\"Champignons aux 3 farces\",\"category\":\"Plat principal\",\"time\":40,\"servings\":4,\"ingredients\":[[\"Farce aux champignons:\",\"\",\"\"],[\"nouveau, avec le vert\",1,\"oignon\"],[\"émietté\",50,\"g féta\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"poudre\",0.5,\"tsp paprika en\"],[\"poudre\",1,\"piment concassé ou de piment en\"],[\"rôtir\",0.5,\"tbsp crème à\"],[\"Farce au chou kale:\",\"\",\"\"],[\"nouveau, sans le vert\",1,\"oignon\"],[\"crème à rôtir pour faire revenir\",\"\",\"\"],[\"(chou kale) finement coupé\",50,\"g chou frisé non pommé\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"Farce courge-fromage:\",\"\",\"\"],[\"(potimarron, butternut ou courge musquée), coupée en petits dés\",50,\"g courge\"],[\"râpé\",50,\"g Gruyère\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"Paris, grands\",500,\"g champignons de\"]],\"steps\":[\"Farce oignon-fromage frais:\",\"Mélanger les oignons, le fromage frais, le paprika, le piment, le sel, le poivre et la crème à rôtir.\",\"Farce au chou kale:\",\"Dans une poêle, faire revenir l'oignon 1-2 min dans un peu de beurre ou de crème à rôtir.\",\"Ajouter le chou et étuver 1-2 min. Saler, poivrer.\",\"Farce courge-fromage:\",\"Mélanger la courge et le Gruyère, saler, poivrer.\",\"Préchauffer le four à 180°C (air chaud/chaleur tournante: 160°C).\",\"Retirer le pied et l'intérieur des champignons de Paris à l'aide d'une cuillère.\",\"Remplir les champignons des différentes farces et les disposer sur une plaque chemisée de papier sulfurisé.\",\"Cuire les champignons 10-12 min au milieu du four chaud.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Végétarien\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2018_CHDO_03/trio-de-champignons-farcis/\",\"notes\":\"\",\"paprikaUid\":\"551FD3C6-84A6-491F-AD46-00AE89571AE2\"},{\"id\":\"cassoulet-mrryzegpb2n\",\"title\":\"Cassoulet\",\"category\":\"Plat principal\",\"time\":90,\"servings\":4,\"ingredients\":[[\"oignons\",1,\"\"],[\"d’ail\",1,\"gousses\"],[\"carottes\",300,\"g\"],[\"huile\",1,\"c. à soupe\"],[\"tomates\",1,\"c. à soupe concentré de\"],[\"viande\",3,\"dl bouillon de\"],[\"haricots\",1,\"boîte\"],[\"blancs\",1,\"boîte haricots\"],[\"poulet\",4,\"ailes de\"],[\"fumé\",250,\"g lard\"],[\"vaudois\",250,\"g saucissons\"],[\"rouge\",1,\"dl vin\"],[\"séché\",1,\"c. à café thym\"],[\"cayenne\",0.25,\"c. à café poivre de\"],[\"laurier\",1,\"feuilles de\"],[\"girofle\",1,\"clous de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Faire chauffer l'huile dans une cocotte, baisser le feu, saisir le poulet pendant 4 min, le sortir.\",\"Ajouter l'oignon, l'ail et les carottes, faire revenir env. 5 min.\",\"Ajouter la purée de tomates et faire cuire brièvement.\",\"Mouiller avec le vin rouge et le bouillon, porter à ébullition.\",\"Baisser le feu.\",\"Ajouter les haricots, le thym et le poivre de Cayenne, mélanger.\",\"Ajouter le lard et le saucisson avec le poulet.\",\"Ajouter la feuille de laurier et le clou de girofle, saler et poivrer.\",\"Faire cuire env. 50 min à couvert au milieu du four préchauffé à 180 °C.\",\"Sortir le plat du four, couper le lard en petits morceaux de 2 cm de large, les remettre dans le plat.\",\"Enlever la feuille de laurier et le clou de girofle, dresser le cassoulet.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Poulet\"],\"source\":\"https://fooby.ch/fr/recettes/24643/cassoulet\",\"notes\":\"\",\"paprikaUid\":\"094C41A8-95B7-448A-B8F0-4B93C45DEC91\"},{\"id\":\"casse-croute-des-aventuriers-mrryzegotf3\",\"title\":\"Casse-croûte des aventuriers\",\"category\":\"Plat principal\",\"time\":40,\"servings\":4,\"ingredients\":[[\"carottes\",400,\"g\"],[\"230 g\",1,\"boîte tomates pelées concassées de\"],[\"1½ dl lait de coco\",\"\",\"\"],[\"crunchy\",1,\"c. à soupe beurre de cacahouètes\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"séché\",0.5,\"c. à café origan\"],[\"hachée\",300,\"g boulettes de viande\"],[\"persil pour décorer\",\"\",\"\"]],\"steps\":[\"Débiter les carottes en tranches épaisses.\",\"Mélanger les tomates, le lait de coco et le beurre de cacahouètes.\",\"Saler, poivrer et parfumer d’origan.\",\"Transférer la préparation dans un plat réfractaire.\",\"Ajouter les carottes et les boulettes de viande.\",\"Couvrir et réserver au frais.\",\"Retirer du réfrigérateur env. 30 min avant la cuisson.\",\"Préchauffer le four à 180 °C.\",\"Glisser le plat dans la moitié inférieure du four et cuire env. 30 min.\",\"Idéal avec du pain pita.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\"],\"source\":\"https://migusto.migros.ch/fr/recettes/le-casse-croute-des-aventuriers\",\"notes\":\"\",\"paprikaUid\":\"9B2036A2-CC62-4342-95E3-D1A6A119DDAA\"},{\"id\":\"carre-d-agneau-sur-epinards-mrryzegn6n4\",\"title\":\"Carré d’agneau sur épinards\",\"category\":\"Plat principal\",\"time\":45,\"servings\":4,\"ingredients\":[[\"moutarde\",1,\"c. à soupe\"],[\"liquide\",4,\"tbsp miel\"],[\"d’ail\",2,\"gousses\"],[\"d’agneau\",400,\"g carrés\"],[\"surgelés\",800,\"g épinards branches\"],[\"beurre\",3,\"c. à soupe\"],[\"muscade\",2,\"noix de\"],[\"fleur de sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"colza\",2,\"tsp huile de\"],[\"claire\",2,\"dl sauce pour rôti\"]],\"steps\":[\"Mélanger la moutarde avec le miel.\",\"Presser l’ail.\",\"Badigeonner les carrés d’agneau de cette marinade.\",\"Laisser reposer au moins 30 min.\",\"Etuver les épinards dans le beurre.\",\"Relever de noix de muscade, sel et poivre.\",\"Saler et poivrer les carrés d’agneau.\",\"Chauffer l’huile dans une poêle.\",\"Y faire rissoler la viande de tous les côtés durant env. 10 min, à feu moyen à vif; elle doit rester bien rose à cœur.\",\"Retirer la viande de la poêle et la laisser reposer brièvement à couvert.\",\"Déglacer les sucs de cuisson avec la sauce pour rôti.\",\"Saler et poivrer.\",\"Trancher les carrés d’agneau entre les os.\",\"Les dresser sur les épinards.\",\"Les entourer d’un cordon de sauce.\",\"Idéal avec un gratin dauphinois.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\"],\"source\":\"https://migusto.migros.ch/fr/recettes/carre-d-agneau-sur-epinards\",\"notes\":\"\",\"paprikaUid\":\"6CEF93AD-0A74-4433-8C36-76E1D3AF3B6C\"},{\"id\":\"carre-d-agneau-au-risotto-au-roquefort-mrryzegn86o\",\"title\":\"Carré d'agneau au risotto au Roquefort\",\"category\":\"Italie\",\"time\":95,\"servings\":4,\"ingredients\":[[\"oignons\",1,\"\"],[\"balsamique\",1,\"c. à soupe vinaigre\"],[\"d'olive\",4,\"c. à soupe huile\"],[\"râpé\",80,\"g parmesan\"],[\"Roquefort\",100,\"g\"],[\"risotto\",200,\"g riz pour\"],[\"légumes\",8,\"dl bouillon de\"],[\"d'agneau\",2,\"carrés\"],[\"blanc\",1,\"dl vin\"],[\"grains de poivre\",\"\",\"\"],[\"thym\",1,\"c. à café\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Mélanger le vinaigre, l’huile et le poivre.\",\"En badigeonner la viande.\",\"Laisser mariner à couvert env. 30 min.\",\"Chauffer l’huile dans une poêle.\",\"Saler la viande.\",\"Saisir env. 8 min sur toutes les faces sur feu moyen.\",\"Retirer, poser sur une plaque chemisée de papier cuisson.\",\"Enfourner env. 10 min au milieu du four préchauffé à 150° C.\",\"Éteindre le four et laisser reposer les carrés d’agneau au four env. 10 min.\",\"Chauffer l’huile dans une poêle.\",\"Y faire revenir l'oignon.\",\"Ajouter le riz, faire revenir jusqu’à ce qu’il soit nacré.\",\"Verser le vin, laisser réduire complètement.\",\"Ajouter le bouillon petit à petit en remuant souvent, de sorte que le riz soit toujours recouvert de liquide.\",\"Laisser mijoter env. 20 min, jusqu’à ce que le riz soit crémeux et al dente.\",\"Incorporer le parmesan et le thym.\",\"Ajouter le roquefort et mélanger, assaisonner.\",\"Couper la viande en tranches.\",\"Dresser avec le risotto.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Risotto\"],\"source\":\"https://fooby.ch/fr/recettes/8248/carre-d-agneau-au-risotto-au-roquefort\",\"notes\":\"\",\"paprikaUid\":\"5BB37A4D-C5C4-4017-8AF1-A734FA09E261\"},{\"id\":\"carpaccio-rosolato-mrryzegm4mf\",\"title\":\"Carpaccio rosolato\",\"category\":\"Italie\",\"time\":70,\"servings\":4,\"ingredients\":[[\"bœuf\",400,\"g filet de\"],[\"d’olive\",1,\"c. à soupe huile\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"huile d’olive\",\"\",\"\"],[\", pelé, en lanières\",1,\"poivron rouge\"],[\", en rouelles\",3,\"oignons fanes\"],[\"d’épinards\",50,\"g pousses\"],[\"basilic, effeuillé\",1,\"bouquet\"],[\"citron, zeste râpé\",1,\"\"],[\"citron\",2,\"c. à soupe jus de\"],[\"d’olive\",1,\"c. à soupe huile\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"pecorino\",50,\"g\"]],\"steps\":[\"Badigeonner la viande avec l’huile, saler, poivrer.\",\"Bien faire chauffer la poêle.\",\"Saisir le filet sur toutes les faces env. 5 min, laisser tiédir un peu, couper en tranches fines.\",\"Bien faire chauffer l’huile dans la même poêle, faire sauter le poivron env. 2 min en remuant, retirer, laisser refroidir.\",\"Mélanger les oignons fanes et tous les ingrédients jusqu’à l’huile comprise, ajouter le poivron, saler et poivrer la salade.\",\"Répartir viande et salade sur des assiettes.\",\"Emincer par-dessus le pecorino avec l’économe.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Saison Été\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/carpaccio-rosolato-carpaccio-pole-10004198/\",\"notes\":\"\",\"paprikaUid\":\"1AF91228-D040-4183-B94C-B63B9D216C9D\"},{\"id\":\"carpaccio-de-veau-au-pecorino-mrryzegleal\",\"title\":\"Carpaccio de veau au Pecorino\",\"category\":\"Italie\",\"time\":30,\"servings\":4,\"ingredients\":[[\"couleurs\",250,\"g tomates cerises de différentes\"],[\"échalotes\",1,\"\"],[\"longs\",150,\"g radis\"],[\"pousses\",100,\"g salade de jeunes\"],[\"plat\",0.5,\"bouquet persil\"],[\"basilic\",0.5,\"bouquet\"],[\"d'olive\",3,\"c. à soupe huile\"],[\"pecorino\",70,\"g\"],[\"veau\",400,\"g filets de\"],[\"2½ c. à soupe jus de citron\",\"\",\"\"],[\"sel\",\"\",\"\"]],\"steps\":[\"Poser les tranches de viande par petites quantités dans un sachet en plastique découpé sur les côtés et les aplatir soigneusement.\",\"Les dresser sur des assiettes.\",\"Mélanger le jus de citron et l'huile, rectifier l'assaisonnement.\",\"Réserver 1 ½ cs de sauce.\",\"Bien mélanger les tomates cerises avec tous les ingrédients jusqu'au basilic compris.\",\"Ajouter la sauce.\",\"Arroser la viande avec la sauce réservée.\",\"Répartir la salade sur la viande, garnir de pecorino.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Saison Été\",\"Salade\"],\"source\":\"https://fooby.ch/fr/recettes/13724/carpaccio-de-veau-au-pecorino\",\"notes\":\"\",\"paprikaUid\":\"208CC67A-788F-419B-B77D-CA5B7ED15118\"},{\"id\":\"carpaccio-de-jambon-au-mascarpone-mrryzegkd88\",\"title\":\"Carpaccio de jambon au Mascarpone\",\"category\":\"Italie\",\"time\":15,\"servings\":4,\"ingredients\":[[\"pistaches\",40,\"g\"],[\"roquette\",25,\"g\"],[\"mascarpone\",100,\"g\"],[\"tranches\",200,\"g jambon arrière en\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Mixer le mascarpone avec l'eau.\",\"Assaisonner.\",\"Dresser le jambon sur une assiette.\",\"Arroser de sauce.\",\"Répartir les pistaches et la roquette dessus.\",\"Assaisonner.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Saison Été\",\"Salade\"],\"source\":\"https://fooby.ch/fr/recettes/25909/carpaccio-de-jambon-au-mascarpone\",\"notes\":\"\",\"paprikaUid\":\"66E99EB7-A519-4E49-AD23-76CF2DF8F673\"},{\"id\":\"carpaccio-de-figues-au-jambon-de-parme-mrryzegj4h9\",\"title\":\"Carpaccio de figues au jambon de Parme\",\"category\":\"Italie\",\"time\":0,\"servings\":1,\"ingredients\":[[\"fraîche\",5,\"u figue\"],[\"cru\",5,\"u jambon\"],[\"rucola\",\"\",\"\"],[\"parmesan\",\"\",\"\"],[\"huile d’olive\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"ciabatta\",1,\"u\"]],\"steps\":[\"Enlever la peau extérieure des figues et les couper en deux sur leur hauteur.\",\"Les déposer sur l'assiette, côté coupé vers le haut.\",\"A l'aide d'un verre, les aplatir.\",\"Disposer le jambon cru et poivrer.\",\"Parsemer avec des copeaux de parmesan.\",\"Disposer la rucola.\",\"Arroser d'huile d'olive.\",\"Servir avec la ciabatta fraîche, chauffée à l'air fryer.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Saison Été\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"5376BC49-70EB-48DF-AB93-9F97EE651C9B\"},{\"id\":\"carpaccio-de-concombre-mrryzegd151\",\"title\":\"Carpaccio de concombre\",\"category\":\"Saison Été\",\"time\":15,\"servings\":2,\"ingredients\":[[\"concombre\",1,\"u\"],[\"zeste de citron\",\"\",\"\"],[\"citron\",2,\"tbsp jus de\"],[\"colza\",2,\"tbsp huile de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"Garniture:\",\"\",\"\"],[\"crème\",100,\"g fromage frais double\"],[\"entier\",1,\"tbsp lait\"],[\"basilic\",10,\"u feuilles\"],[\"grains de poivre\",\"\",\"\"]],\"steps\":[\"Entailler le concombre à l'aide d'un couteau à lame cannelée.\",\"Réserver les bandes de peau ainsi obtenues.\",\"Emincer le concombre en très fines lamelles et disposer sur des assiettes.\",\"Parsemer de zeste de citron.\",\"Arroser de jus de citron et d'huile.\",\"Assaisonner.\",\"Laisser mariner.\",\"Garniture:\",\"Mélanger le fromage et le lait.\",\"Incorporer le basilic.\",\"A l'aide de deux cuillères, former des barquettes et en garnir le concombre.\",\"Disposer harmonieusement les bandes de peau de concombre.\",\"Décorer de basilic et de poivre rose écrasé.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Saison Été\",\"Salade\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM200207_46/carpaccio-de-concombre/\",\"notes\":\"\",\"paprikaUid\":\"6C1BF154-9F32-4F9F-82B5-251CA7A0FD72\"},{\"id\":\"carpaccio-de-betteraves-rouges-a-la-feta-mrryzegc6pw\",\"title\":\"Carpaccio de betteraves rouges à la féta\",\"category\":\"Salade\",\"time\":70,\"servings\":4,\"ingredients\":[[\"poires\",2,\"u\"],[\"beurre\",1,\"c. à soupe\"],[\"cuite\",500,\"g betterave rouge\"],[\"rampon\",200,\"g\"],[\"féta\",200,\"g\"],[\"Sauce:\",\"\",\"\"],[\"oignons\",2,\"u\"],[\"herbes\",3,\"tbsp vinaigre aux\"],[\"moutarde\",1,\"c. à café\"],[\"miel\",1,\"c. à café\"],[\"colza\",5,\"tbsp huile de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"graines de courge, grillées\",\"\",\"\"]],\"steps\":[\"Couper les poires en quatre et les faire revenir dans le beurre.\",\"Couper finement l'oignon.\",\"Couper les betteraves rouges en fines rondelles.\",\"Sauce:\",\"Faire revenir les oignons.\",\"Les mélanger dans un saladier avec le vinaigre, la moutarde et le miel.\",\"Ajouter l'huile, rectifier l'assaisonnement.\",\"Ajouter les betteraves.\",\"Mélanger et laisser reposer env. 20 min.\",\"Dressage:\",\"Garnir l'assiette de rondelles de betterave. Commencer par l'extérieur, puis garnir en rond vers l'intérieur.\",\"Ajouter les poires.\",\"Disposer la salade par-dessus.\",\"Arroser avec la sauce restante.\",\"Émietter le fromage sur le carpaccio de betteraves.\",\"Parsemer de graines de courge.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Salade\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/KO2023_SBLV_19/carpaccio-de-betteraves-a-la-feta/\",\"notes\":\"\",\"paprikaUid\":\"32AB967E-8D8E-4534-B80A-59D33CE741F4\"},{\"id\":\"carottes-a-l-orientale-mrryzegc6is\",\"title\":\"Carottes à l'orientale\",\"category\":\"Asie\",\"time\":0,\"servings\":4,\"ingredients\":[[\"LÉGUMES:\",\"\",\"\"],[\"botte\",1,\"kg carottes\"],[\"hanout\",1,\"tbsp ras el\"],[\"gorgonzola\",2,\"c. à soupe\"],[\"1½ tbsp beurre, liquide\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"DIP:\",\"\",\"\"],[\"demi-crème acidulée\",100,\"g\"],[\"maigre\",100,\"g séré\"],[\"citron, jus\",0.5,\"\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Préchauffer le four à 210°.\",\"LÉGUMES:\",\"Laver les carottes et éliminer sommairement les fanes.\",\"Mélanger l’épices ras el hanout, le gorgonzola et le beurre.\",\"Assaisonner.\",\"Répartir les carottes sur la plaque habillée de papier sulfurisé.\",\"Disperser le mélange d'épices sur les carottes.\",\"CUISSON:\",\"Faire cuire pendant 20 à 25 minutes au milieu du four.\",\"DIP:\",\"Mélanger tous les ingrédients et servir avec les légumes.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Saison Été\",\"Végétarien\"],\"source\":\"https://www.gemuese.ch/fr/recettes/carottes-a-l-orientale?_gl=1*1c9qo1y*_up*MQ..*_gs*MQ..&gclid=EAIaIQobChMIidDR5aLUkQMVqIKDBx3jfDtyEAAYASAAEgJamvD_BwE&gbraid=0AAAAA-NhTE6ZgQqRSKGIn7vgxklFlEwi-\",\"notes\":\"\",\"paprikaUid\":\"37A1D9A4-189B-44FD-AE94-D1A32A9ABD10\"},{\"id\":\"carottes-roties-et-riz-aux-fines-herbes-mrryzegbo77\",\"title\":\"Carottes rôties et riz aux fines herbes\",\"category\":\"Italie\",\"time\":60,\"servings\":2,\"ingredients\":[[\"précuit\",250,\"g riz basmati\"],[\"carottes\",600,\"g\"],[\"oignons\",2,\"\"],[\"d'olive\",4,\"c. à soupe huile\"],[\"herbes\",140,\"g fromage frais aux fines\"],[\"blancs\",70,\"g petits oignons\"],[\"sel\",\"\",\"\"],[\"séchées\",1,\"c. à soupe herbes italiennes\"],[\"citron\",1,\"c. à soupe jus de\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Mélanger les carottes, les petits oignons blancs et les oignons avec l'huile et le sel et les mettre sur une plaque recouverte de papier cuisson.\",\"Faire cuire env. 40 min. dans le bas du four préchauffé à 220 °C.\",\"Mélanger l'eau, le fromage frais et les fines herbes et faire chauffer.\",\"Ajouter le riz, mélanger et réchauffer à couvert pendant env. 3 min.\",\"Mélanger le jus de citron, l'huile, le fromage frais et l'eau, assaisonner.\",\"Dresser le riz dans les assiettes, déposer les carottes dessus, arroser de sauce.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\"],\"source\":\"https://fooby.ch/fr/recettes/20514/carottes-roties-et-riz-aux-fines-herbes\",\"notes\":\"\",\"paprikaUid\":\"35338BED-5D7E-4E12-88B0-F434D11FD1CD\"},{\"id\":\"carottes-roties-au-miel-chevre-et-sauce-verte-mrryzeg99yq\",\"title\":\"Carottes rôties au miel, chèvre et sauce verte\",\"category\":\"Végétarien\",\"time\":50,\"servings\":4,\"ingredients\":[[\"fane\",500,\"g carotte\"],[\"sel\",\"\",\"\"],[\"poivre noir\",\"\",\"\"],[\"thym\",\"\",\"\"],[\"miel\",25,\"g\"],[\"noix\",50,\"g cerneaux de\"],[\"huile d'olive\",\"\",\"\"],[\"frais\",200,\"g chèvre\"],[\"persil\",45,\"g\"],[\"cidre\",25,\"g vinaigre de\"]],\"steps\":[\"Préchauffer le four à 200°.\",\"Laver les carottes nouvelles.\",\"Disposer dans un plat allant au four.\",\"Dans un bol, mettre du sel, du poivre et du thym.\",\"Ajouter le miel, un filet d'huile d'olive et les noix.\",\"Mélanger bien et répartir sur les carottes.\",\"Enfourner le plat pendant 25 à 30 minutes, en les retournant à mi-cuisson, jusqu'à ce qu'elles soient tendres mais encore légèrement croquantes.\",\"Préparer la sauce verte :\",\"Mettre dans le bol d'un mixeur uniquement les feuilles de persil.\",\"Ajouter le thym et le vinaigre de cidre.\",\"Ajouter une pincée de sel, l'huile, un tour de moulin à poivre.\",\"Mixer jusqu'à obtenir une sauce lisse, homogène et bien émulsionnée.\",\"Verser dans un petit bol.\",\"Préparer la crème de chèvre :\",\"Mettre le fromage dans un saladier.\",\"Ajouter de l'eau et fouetter jusqu'à obtenir une crème.\",\"Si nécessaire, ajouter un filet d'huile d'olive pour obtenir une texture plus crémeuse et tartinable.\",\"Lorsque les carottes seront cuites, sortir du four.\",\"Préparer le dressage :\",\"Étaler au fond des assiettes la crème de chèvre et déposer dessus les carottes rôties.\",\"Compléter avec le jus de cuisson, les noix et la sauce verte.\",\"Garnir selon goût avec quelques feuilles de thym frais et servir immédiatement.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Végétarien\"],\"source\":\"https://www.giallozafferano.fr/recettes/carottes-roties-au-miel-chevre-et-sauce-verte.html\",\"notes\":\"\",\"paprikaUid\":\"1065724C-8DB6-4818-B827-D1C476215BE7\"},{\"id\":\"carottes-au-beurre-et-yaourt-au-curry-fume-mrryzeg84w2\",\"title\":\"Carottes au beurre et yaourt au curry fumé\",\"category\":\"Végétarien\",\"time\":25,\"servings\":6,\"ingredients\":[[\"carotte\",1000,\"g\"],[\"fumé\",1,\"tsp curry\"],[\"graine de sésame blanche\",\"\",\"\"],[\"graine de sésame noir\",\"\",\"\"],[\"beurre\",60,\"g\"],[\"persil\",\"\",\"\"],[\"nature\",150,\"g yaourt\"],[\"d'acacia\",20,\"g miel\"],[\"d'olive\",10,\"g huile\"],[\"sel\",\"\",\"\"],[\"poivre noir\",\"\",\"\"]],\"steps\":[\"Équeuter les carottes, les peler et les couper en biais en rondelles d'environ un demi-centimètre d'épaisseur.\",\"Dans une grande poêle, faire fondre le beurre.\",\"Ajoutez les carottes.\",\"Saler, poivrer et aromatiser avec le curry fumé.\",\"Faire cuire à feu moyen‑vif pendant 10–15 minutes, en remuant souvent.\",\"Réserver et garder les jus de cuisson.\",\"Pendant ce temps, torréfier les graines de sésame blanches et noires dans une poêle antiadhésive pendant environ 3 minutes.\",\"Préparer la sauce au yaourt :\",\"Mettre le yaourt et le miel dans un petit bol.\",\"Assaisonnez avec l'huile, le sel et le poivre.\",\"Mélanger bien pour homogénéiser.\",\"Répartir la sauce au yaourt dans le fond du plat de service.\",\"Ajoutez les carottes.\",\"Terminer avec les graines de sésame torréfiées et le jus de cuisson des carottes.\",\"Garnir de quelques feuilles de persil et servir.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Végétarien\"],\"source\":\"https://www.giallozafferano.fr/recettes/carottes-au-beurre-et-yaourt-au-curry-fume.html\",\"notes\":\"\",\"paprikaUid\":\"64B60023-9F02-4CAC-831B-DE8C94765E90\"},{\"id\":\"capuns-mrryzeg3n3w\",\"title\":\"Capuns\",\"category\":\"Plat principal\",\"time\":65,\"servings\":4,\"ingredients\":[[\"Farce:\",\"\",\"\"],[\"dés\",1,\"salsiz pelé et coupé en\"],[\"dés\",75,\"g pain blanc sans la croûte et coupé en\"],[\"haché\",1,\"oignon finement\"],[\"haché\",0.5,\"bouquet persil finement\"],[\"ciselée\",0.5,\"bouquet ciboulette finement\"],[\"maigres\",75,\"g lardons\"],[\"beurre pour faire revenir\",\"\",\"\"],[\"blanche\",200,\"g farine\"],[\"sel\",\"\",\"\"],[\"lait\",0.5,\"dl\"],[\"eau\",0.5,\"dl\"],[\"œufs\",2,\"\"],[\"deux, sans la côte\",24,\"feuilles de côte de bette coupées en\"],[\"légumes\",5,\"dl bouillon de\"],[\"beurre\",50,\"g\"],[\"d'alpage râpé\",100,\"g fromage\"]],\"steps\":[\"Farce: faire revenir le salsiz, les lardons, le pain et l'oignon dans le beurre durant 3 min à feu moyen.\",\"Retirer la poêle du feu et incorporer les fines herbes.\",\"Mélanger la farine et le sel dans un bol.\",\"Former un puits et y verser les œufs battus avec le lait et l'eau.\",\"Mélanger avec une cuillère en bois de façon à obtenir une pâte homogène.\",\"Battre la pâte jusqu'à ce qu'elle soit lisse et que des bulles se forment.\",\"Incorporer à la pâte le mélange de salsiz, de lardons, de pain, d'oignon et de fines herbes.\",\"Feuilles de bette à tondre ou de côte de bette: blanchir les feuilles de bette 1-2 min dans de l'eau salée frémissante.\",\"Rincer à l'eau froide, égoutter et étaler sur un linge de cuisine.\",\"Déposer 1 cs de farce au milieu des feuilles, rabattre les parties longitudinales des feuilles sur la farce et enrouler.\",\"Déposer les capuns dans une casserole large.\",\"Arroser de bouillon.\",\"Couvrir et pocher 15-20 min (l'eau doit frémir mais pas bouillir).\",\"Sortir les capuns de la casserole à l'aide d'une écumoire et les réserver au chaud sur un plat.\",\"Faire fondre le beurre dans une petite casserole.\",\"Dès qu'il commence à mousser, le retirer du feu.\",\"Parsemer les capuns de fromage et les napper de beurre.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Suisse\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/HWL_CHKL2003_08/capuns/?collection=97824\",\"notes\":\"\",\"paprikaUid\":\"88A88BAB-80B7-4D89-9613-5260FE80937B\"},{\"id\":\"caponata-a-la-burrata-mrryzeg2in0\",\"title\":\"Caponata à la Burrata\",\"category\":\"Italie\",\"time\":50,\"servings\":4,\"ingredients\":[[\"aubergine\",300,\"g\"],[\"tomates\",4,\"\"],[\"céleri-branche\",200,\"g\"],[\"rouge\",1,\"poivron\"],[\"d’olive\",2,\"c. à soupe huile\"],[\"sel\",\"\",\"\"],[\"dénoyautées\",100,\"g olives vertes\"],[\"câpres\",40,\"g\"],[\"poivre\",\"\",\"\"],[\"citron\",1,\"\"],[\"(d’env. 150 g)\",4,\"burrata\"],[\"blanc\",1,\"c. à soupe vinaigre balsamique\"],[\"d’olive\",2,\"c. à soupe huile\"],[\"basilic\",0.5,\"bouquet\"],[\"fleur de sel\",\"\",\"\"]],\"steps\":[\"Tailler en petits dés aubergine, tomates, céleri-branche et poivron.\",\"Faire chauffer l’huile dans une casserole.\",\"Ajouter les légumes, saler, laisser mijoter env. 8 min à couvert.\",\"Couper les olives en rouelles, supprimer la queue des fruits du câprier et les couper en deux.\",\"Incorporer les deux aux légumes, poivrer, répartir sur des assiettes.\",\"Râper le zeste du citron par-dessus, dresser la burrata.\",\"Mélanger le vinaigre balsamique et l’huile, arroser en filet.\",\"Effeuiller le basilic, répartir dessus, saler, poivrer.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Saison Été\"],\"source\":\"https://www.bettybossi.ch/fr/recettes/recette/caponata-a-la-burrata-10006640/\",\"notes\":\"\",\"paprikaUid\":\"FD3D1D19-7487-48ED-AADD-E6E7A33DE5E4\"},{\"id\":\"b-uf-stroganov-a-l-autocuiseur-mrryzeg1423\",\"title\":\"Bœuf Stroganov à l’autocuiseur\",\"category\":\"Cocotte\",\"time\":70,\"servings\":6,\"ingredients\":[[\"bœuf, coupée en lanières\",675,\"g\"],[\"huile\",30,\"ml\"],[\"oignons, émincés\",2,\"\"],[\"d’ail, hachées\",3,\"gousses\"],[\"blancs, petits\",450,\"g champignons\"],[\"beurre\",30,\"ml\"],[\"blanchie\",30,\"g farine tout usage non\"],[\"rouge\",125,\"ml vin\"],[\"bœuf\",250,\"ml bouillon de\"],[\"l’ancienne\",30,\"ml moutarde à\"],[\"doux\",5,\"ml paprika\"],[\"œufs\",225,\"g nouilles aux\"],[\"nature\",180,\"ml yogourt\"],[\"ciselée\",10,\"g ciboulette\"]],\"steps\":[\"Dans une grande poêle antiadhésive à feu moyen-élevé, dorer le tiers de la viande à la fois dans l’huile.\",\"Saler et poivrer.\",\"Entre-temps, préchauffer l’autocuiseur 2 minutes.\",\"Y cuire les oignons, l’ail et les champignons dans le beurre jusqu’à ce que les légumes commencent à dorer.\",\"Saupoudrer de la farine et cuire 1 minute en remuant.\",\"Saler et poivrer.\",\"Déglacer avec le vin.\",\"Ajouter le bouillon, la moutarde, le paprika et la viande.\",\"Bien mélanger.\",\"Couvrir et sélectionner la fonction Viande.\",\"Régler le temps de cuisson à 25 minutes.\",\"Dans une casserole d’eau bouillante salée, cuire les nouilles al dente.\",\"Égoutter.\",\"Huiler les nouilles.\",\"Laisser dépressuriser l’appareil naturellement (environ 15 minutes).\",\"Retirer le couvercle.\",\"Incorporer le yogourt.\",\"Rectifier l’assaisonnement.\",\"Parsemer de la ciboulette.\",\"Servir avec les nouilles aux œufs.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Cocotte\",\"Plat principal\"],\"source\":\"https://www.ricardocuisine.com/recettes/8320-b-uf-stroganov-a-l-autocuiseur\",\"notes\":\"\",\"paprikaUid\":\"04025D39-80AB-47CB-8822-B410580A310A\"},{\"id\":\"b-uf-saute-coreen-au-sesame-mrryzefzwkj\",\"title\":\"Bœuf sauté coréen au sésame\",\"category\":\"Corée\",\"time\":90,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"\"],[\"sauter, p. ex. rumsteck ou filet\",800,\"g bœuf à\"],[\"(condiment coréen)\",4,\"c. à soupe sauce BBQ bulgogi\"],[\"nouveaux\",1,\"botte oignons\"],[\"cuisson\",2,\"c. à soupe huile pour la\"],[\"sésame\",1,\"c. à soupe huile de\"],[\"(pâte de soja coréenne, condiment)\",1,\"c. à soupe Ssamjang\"],[\"grillées\",1,\"c. à café graines de sésame\"]],\"steps\":[\"Hacher grossièrement l'oignon.\",\"Couper la viande perpendiculairement aux fibres en fines lanières.\",\"Les mélanger soigneusement avec l'oignon et la sauce bulgogi.\",\"Couvrir et laisser mariner au moins 1 h au réfrigérateur.\",\"Détailler les oignons nouveaux en menus morceaux.\",\"Chauffer l'huile dans une grande poêle et saisir la viande env. 1 min avec l'oignon - procéder par portions.\",\"Remettre le tout dans la poêle et réchauffer brièvement à feu moyen.\",\"Incorporer l'huile de sésame, relever de ssamjang et parsemer de graines de sésame.\",\"À servir idéalement avec du riz.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Corée\",\"Plat principal\",\"Pâtes\"],\"source\":\"https://migusto.migros.ch/fr/recettes/boeuf-saute-coreen-au-sesame\",\"notes\":\"\",\"paprikaUid\":\"9C97483E-88E2-49CF-821D-B2B4877437FB\"},{\"id\":\"b-uf-braise-au-barolo-mrryzefy95y\",\"title\":\"Bœuf braisé au Barolo\",\"category\":\"Italie\",\"time\":930,\"servings\":4,\"ingredients\":[[\"carottes\",1,\"\"],[\"céleri-rave\",100,\"g\"],[\"poireau\",1,\"\"],[\"oignons\",1,\"\"],[\"d’ail\",3,\"gousses\"],[\"huile\",\"\",\"\"],[\"tomates\",2,\"c. à soupe concentré de\"],[\"1⅕ kg rôti de bœuf\",\"\",\"\"],[\"rouge\",7,\"dl vin\"],[\"poivre\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"laurier\",1,\"feuilles de\"],[\"girofle\",1,\"clous de\"]],\"steps\":[\"Mettre la viande dans un grand saladier, y ajouter les légumes, poivrer, verser le vin.\",\"Couvrir et faire mariner au réfrigérateur pendant env. 12 h en retournant la viande une fois.\",\"Sortir la viande de la marinade, la sécher avec de l'essuie-tout et la saler.\",\"Filtrer la marinade au tamis.\",\"Réserver la marinade et les légumes séparément.\",\"Dans une cocotte, saisir la viande dans l'huile env. 10 min, la retirer.\",\"Faire suer les légumes dans la même cocotte, ajouter la purée de tomates, poursuivre brièvement la cuisson.\",\"Ajouter la feuille de laurier, le clou de girofle et la moitié de la marinade, laisser réduire presque entièrement.\",\"Remettre la viande dans la cocotte et y verser le reste de marinade.\",\"Couvrir et braiser env. 2 h 1/2 dans le bas du four préchauffé à 150 °C en retournant la viande une fois.\",\"Sortir la cocotte du four. La viande doit reposer env. 10 min à couvert avant d'être tranchée.\",\"Sortir la viande de la cocotte, retirer la feuille de laurier et le clou de girofle.\",\"Mixer la moitié de la sauce dans un bol mixeur, la reverser dans la cocotte, mélanger, assaisonner.\",\"Couper la viande en tranches et la servir avec la sauce.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\"],\"source\":\"https://fooby.ch/fr/recettes/12560/buf-braise-au-barolo\",\"notes\":\"\",\"paprikaUid\":\"8166C69D-9EE0-44A1-846C-E370DE00A424\"},{\"id\":\"borek-aux-epinards-avec-feta-mrryzefxy0a\",\"title\":\"Börek aux épinards avec feta\",\"category\":\"Saison Autumne\",\"time\":125,\"servings\":8,\"ingredients\":[[\"Pâte:\",\"\",\"\"],[\"farine\",500,\"g\"],[\"sucre\",\"\",\"\"],[\"sèche\",0.5,\"tsp levure\"],[\"sel\",\"\",\"\"],[\"tiède\",1.5,\"dl eau\"],[\"lait\",1.5,\"dl\"],[\"huile\",2,\"c. à soupe\"],[\"oignon\",1,\"u\"],[\"d'ail\",2,\"u gousses\"],[\"feta\",300,\"g\"],[\"huile\",1,\"c. à soupe\"],[\"épinards\",500,\"g\"],[\"cumin\",0.5,\"c. à soupe\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"huile\",\"\",\"\"],[\"nature\",3,\"tbsp yogourt\"],[\"sésame\",4,\"tbsp graines de\"]],\"steps\":[\"Pour la pâte, mélanger tous les ingrédients puis, à l'aide d'un robot ménager, pétrir env. 10 min à vitesse maximale jusqu'à obtention d'une pâte souple.\",\"Laisser lever env. 30 min dans un endroit chaud.\",\"Entre-temps, hacher grossièrement l'oignon et l'ail.\",\"Couper la feta en petits dés.\",\"Chauffer l'huile dans une poêle et faire suer l'ail et l'oignon env. 5 min à feu moyen.\",\"Ajouter les épinards par portions.\",\"Couvrir et poursuivre la cuisson jusqu'à ce qu'ils tombent.\",\"Laisser refroidir.\",\"Bien presser la masse pour éliminer le liquide.\",\"La mélanger à la feta.\",\"Relever avec le cumin.\",\"Saler et poivrer.\",\"Préchauffer le four à 200 °C.\",\"Chemiser le moule de papier sulfurisé.\",\"Huiler le rouleau à pâtisserie ainsi qu'un plan de travail lisse.\",\"Abaisser la pâte aussi finement que possible en un rectangle (on doit pouvoir apercevoir la paume des mains au travers).\",\"Y répartir la farce en laissant un bord d'env. 1 cm libre.\",\"Rouler serré puis former une spirale et déposer au centre du moule.\",\"Badigeonner avec le yogourt.\",\"Parsemer de sésame.\",\"Faire cuire 40-50 min au milieu du four.\",\"Diviser en 8 parts et servir chaud.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Saison Autumne\",\"Snack\"],\"source\":\"https://migusto.migros.ch/fr/recettes/boerek-aux-epinards-avec-feta\",\"notes\":\"\",\"paprikaUid\":\"4E2BFF9B-A90D-4529-8F46-564ABF875BCC\"},{\"id\":\"burratas-aux-tomates-braisees-mrryzefx3x3\",\"title\":\"Burratas aux tomates braisées\",\"category\":\"Italie\",\"time\":40,\"servings\":4,\"ingredients\":[[\"tomates\",700,\"g\"],[\"d’ail\",0.5,\"gousses\"],[\"d'olive\",4,\"c. à soupe huile\"],[\"rouge\",2,\"c. à soupe vinaigre de vin\"],[\"sucre\",2,\"c. à soupe\"],[\"burratas\",300,\"g\"],[\"sel\",\"\",\"\"],[\"fenouil\",2,\"c. à soupe graines de\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Poser les tomates sur une plaque chemisée de papier cuisson, les arroser d'huile, les saler.\",\"Faire cuire env. 20 min dans le haut du four préchauffé à 220 °C. Sortir et laisser tiédir.\",\"Dans une petite casserole, porter l'eau à ébullition avec le sucre sans remuer.\",\"Baisser le feu et laisser cuire pendant 3 min jusqu'à ce que des bulles se forment à la surface.\",\"Ajouter les graines de fenouil, laisser frémir en remuant jusqu'à ce que l'eau se soit évaporée et que les graines de fenouil soient sèches et blanchâtres.\",\"Retirer la casserole du feu, continuer de remuer brièvement, répartir les graines de fenouil sur une feuille de papier cuisson, laisser refroidir.\",\"Égoutter les Burratas, récupérer 3 cs du liquide et le verser dans le blender.\",\"Ajouter le vinaigre, l'huile, l'ail et 2 moitiés de tomates braisées (env. 150 g), mixer et assaisonner.\",\"Verser le dressing sur un plat.\",\"Poser les Burratas et les tomates dessus.\",\"Parsemer de graines de fenouil.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Saison Été\"],\"source\":\"https://fooby.ch/fr/recettes/25393/burratas-aux-tomates-braisees\",\"notes\":\"\",\"paprikaUid\":\"AA29B62C-3D1E-42E8-97ED-8ADF0DCD6E1C\"},{\"id\":\"burrata-a-la-pepperonata-mrryzefwiyp\",\"title\":\"Burrata à la pepperonata\",\"category\":\"froid\",\"time\":50,\"servings\":2,\"ingredients\":[[\"pin\",2,\"tbsp pignon de\"],[\"jaune\",1,\"u poivron\"],[\"rouge\",1,\"u poivron\"],[\"roquette\",30,\"g\"],[\"balsamique\",1,\"tbsp vinaigre\"],[\"d'olive\",1,\"tbsp huile\"],[\"burrata\",150,\"g\"],[\"fleur de sel\",\"\",\"\"]],\"steps\":[\"Préchauffer le four à 240°.\",\"Poser les poivrons sur une plaque chemisée de papier cuisson.\",\"Enfourner env. 20 min au milieu du four.\",\"Retirer et laisser reposer recouverts d'un linge humide env. 10 minutes.\",\"Peler les poivrons, les épépiner.\",\"Couper dans le sens de la longueur en 4 morceaux.\",\"Répartir sur les assiettes en alternant en former un cercle.\",\"Façonner deux petits nids de roquette.\",\"Poser sur les poivrons.\",\"Arroser d'huile et de vinaigre.\",\"Poser la burrata sur la roquette.\",\"Assaisonner avec la fleur de sel et le poivre.\",\"Parsemer de pignons de pin.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"froid\",\"Italie\",\"Saison Été\",\"Salade\"],\"source\":\"https://fooby.ch/fr/recettes/9003/burrata-a-la-pepperonata\",\"notes\":\"\",\"paprikaUid\":\"1415400D-8E23-4385-AACA-85BF57886796\"},{\"id\":\"bulgogi-de-porc-sur-feuille-de-laitue-mrryzefv05q\",\"title\":\"Bulgogi de porc sur feuille de laitue\",\"category\":\"Asie\",\"time\":70,\"servings\":4,\"ingredients\":[[\"mignon\",600,\"g filet\"],[\"Bulgogi\",1,\"dl sauce\"],[\"sésame\",4,\"tbsp huile de\"],[\"Gochujang\",2,\"c. à soupe\"],[\"soja\",2,\"tbsp sauce\"],[\"mélangés\",400,\"g légumes\"],[\"grillées\",4,\"tbsp graines de sésame\"],[\"sel\",\"\",\"\"],[\"jasmin\",250,\"g riz\"],[\"eau\",5,\"dl\"],[\"nouveau\",2,\"u oignon\"],[\"mini-laitues romaines\",250,\"g\"],[\"colza\",2,\"tbsp huile de\"],[\"Kimchi\",160,\"g\"]],\"steps\":[\"Débiter la viande en fines lanières.\",\"Les mélanger à la sauce Bulgogi et laisser mariner au moins 30 min à couvert au réfrigérateur.\",\"Mélanger l'huile de sésame à la pâte gochujang avec la sauce soja.\",\"Couper les carottes en fins bâtonnets.\",\"Emincer finement le chou.\",\"Mélanger séparément chaque légume avec la moitié de la sauce et un peu de graines de sésame.\",\"Selon les goûts, relever d'un peu de sel.\",\"Amener l'eau à ébullition avec le riz.\",\"Faire cuire 1 min.\",\"Réduire le feu au minimum et laisser gonfler env. 15 min. à couvert sans remuer.\",\"Retirer la casserole du feu.\",\"Tailler les oignons nouveaux en rouelles.\",\"Détacher les feuilles des laitues.\",\"Chauffer l'huile de colza dans un wok.\",\"Retirer la viande de la marinade et la saisir 2-3 min à feu vif.\",\"Ajouter l'oignon nouveau puis la marinade et faire revenir le tout.\",\"Parsemer d'un peu de graines de sésame au dressage.\",\"Servir la viande, les carottes, le chou et le riz avec les feuilles de laitue et, selon les goûts, du kimchi.\",\"Traditionnellement, les feuilles de laitue sont servies déjà farcies.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Corée\",\"Wok\"],\"source\":\"https://migusto.migros.ch/fr/recettes/bulgogi-de-porc-sur-feuille-de-laitue\",\"notes\":\"\",\"paprikaUid\":\"DEFEC7E5-2C3F-420E-8A53-FA8DD4ACB712\"},{\"id\":\"brochettes-de-viande-et-ketchup-jaune-mrryzefuf2c\",\"title\":\"Brochettes de viande et ketchup jaune\",\"category\":\"Plat principal\",\"time\":60,\"servings\":4,\"ingredients\":[[\"brochette en bois\",8,\"u\"],[\"tomate cerise jaune\",200,\"g\"],[\"poivron jaune\",1,\"u\"],[\"chili rouge\",1,\"u\"],[\"oignon\",1,\"u\"],[\"vinaigre balsamique\",1,\"c. à café\"],[\"huile d'olive\",2,\"c. à soupe\"],[\"vinaigre de vin blanc\",1,\"c. à soupe\"],[\"sucre\",1,\"c. à soupe\"],[\"steak de cou de porc\",4,\"u\"],[\"romarin\",3,\"brin\"],[\"sel\",1,\"c. à café\"]],\"steps\":[\"Chauffer l'huile dans une casserole.\",\"Y faire revenir l'oignon et le piment env. 1 minute.\",\"Ajouter le sucre, verser l'eau et le vinaigre.\",\"Ajouter le poivron et les tomates, saler, porter à ébullition.\",\"Baisser le feu, laisser mijoter à feu doux env. 15 minutes.\",\"Mixer la masse, laisser tiédir, mettre au frais env. 30 minutes.\",\"Piquer les lanières de viande en accordéon sur les brochettes.\",\"Chauffer l'huile dans une poêle.\",\"Y faire dorer les brochettes par portions env. 4 min de chaque côté.\",\"Mélanger le vinaigre balsamique, le romarin et le sel, en assaisonner les brochettes, retirer.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"Porc\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/11241/brochettes-de-viande-et-ketchup-jaune\",\"notes\":\"\",\"paprikaUid\":\"F964E06F-0A08-42DA-8D61-5EB40F3074C5\"},{\"id\":\"brochettes-de-b-uf-a-la-coreenne-au-kiwi-mrryzeftncv\",\"title\":\"Brochettes de bœuf à la coréenne au kiwi\",\"category\":\"Corée\",\"time\":25,\"servings\":4,\"ingredients\":[[\"kiwi, pelé\",0.5,\"\"],[\"soya\",45,\"ml sauce\"],[\"mirin\",30,\"ml\"],[\"cassonade\",15,\"ml\"],[\"grillé\",5,\"ml huile de sésame\"],[\"d'ail, hachées finement\",2,\"gousses\"],[\"goût\",1,\"ml sambal oelek ou au\"],[\"boeuf, coupé en fines tranches\",675,\"g\"],[\"kiwis, pelés et coupés en brunoise\",3,\"\"],[\"d'olive\",15,\"ml huile\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"bois, trempées dans l'eau 30 minutes, ou métalliques\",8,\"brochettes de\"]],\"steps\":[\"Marinade:\",\"Dans un plat en verre, réduire le kiwi en purée à l'aide d'une fourchette.\",\"Ajouter le reste des ingrédients et bien mélanger.\",\"Réserver.\",\"Préchauffer le barbecue à puissance élevée.\",\"Huiler la grille.\",\"Brochettes:\",\"Enfiler la viande sur les brochettes.\",\"Déposer les brochettes dans la marinade et bien les enrober.\",\"Laisser macérer maximum 10 minutes.\",\"Dans un bol, mélanger la brunoise de kiwi dans l'huile d'olive.\",\"Saler et poivrer.\",\"Réserver.\",\"Griller les brochettes environ 2 minutes de chaque côté.\",\"Saler et poivrer.\",\"Servir du riz vapeur et accompagner de la brunoise de kiwi.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Corée\",\"Plat principal\"],\"source\":\"https://www.ricardocuisine.com/recettes/4719-brochettes-de-boeuf-a-la-coreenne-au-kiwi\",\"notes\":\"\",\"paprikaUid\":\"275CCFE9-ACCC-439F-B06E-C89B16022872\"},{\"id\":\"brochettes-de-bulgogi-avec-salade-de-mangue-mrryzefs789\",\"title\":\"Brochettes de Bulgogi avec salade de mangue\",\"category\":\"Corée\",\"time\":45,\"servings\":4,\"ingredients\":[[\"gingembre\",4,\"cm\"],[\"soja\",3,\"c. à soupe sauce\"],[\"sésame\",2,\"c. à soupe huile de\"],[\"brun\",1,\"c. à café sucre\"],[\"Cayenne\",1,\"c. à café poivre de\"],[\"d'ail\",2,\"gousses\"],[\"bœuf\",600,\"g rumsteck de\"],[\"vert\",1,\"citron\"],[\"mangue\",1,\"\"],[\"nouveaux\",2,\"oignons\"],[\"mi-fort\",1,\"piment\"],[\"grillées, salées\",2,\"c. à soupe cacahouètes\"],[\"coriandre\",1,\"bouquet\"],[\"d'olive\",2,\"c. à soupe huile\"]],\"steps\":[\"Pour la marinade, hacher fin le gingembre.\",\"Le mélanger avec la sauce soja, l'huile de sésame, le sucre et le poivre de Cayenne.\",\"Presser l'ail par-dessus.\",\"Couper le rumsteak d'abord en tranches épaisses puis en dés d’env. 2 cm.\",\"Les mélanger avec la marinade et laisser reposer env. 30 min.\",\"Pour la salade, peler la mangue, détacher la pulpe du noyau et la détailler en lanières.\",\"Couper les oignons nouveaux ainsi que le piment en fines lanières biseautées.\",\"Hacher les cacahouètes et effeuiller la coriandre.\",\"Mélanger le tout avec l’huile d'olive.\",\"Préchauffer le gril à 200 °C.\",\"Piquer les dés de viande sur les brochettes et les griller env. 4 min à feu direct (ils doivent être roses à cœur).\",\"Les badigeonner de temps à autre avec le reste de marinade.\",\"Couper le citron en quartiers et les faire griller brièvement.\",\"Servir les bulgogi avec la salade de mangue.\",\"Arroser de jus de citron.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Corée\",\"Plat principal\"],\"source\":\"https://migusto.migros.ch/fr/recettes/brochettes-de-bulgogi-avec-salade-de-mangue\",\"notes\":\"\",\"paprikaUid\":\"6668D27A-6FEB-4FB9-954F-5A9FA3EC906E\"},{\"id\":\"brioche-au-jambon-et-aux-epinards-mrryzefri9l\",\"title\":\"Brioche au jambon et aux épinards\",\"category\":\"Snack\",\"time\":200,\"servings\":12,\"ingredients\":[[\"jambon\",200,\"g\"],[\"noix\",170,\"g\"],[\"vert\",1,\"u citron\"],[\"épinards\",500,\"g\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"fleur\",500,\"g farine\"],[\"fraîche\",0.5,\"u levure\"],[\"sucre\",2,\"c. à soupe\"],[\"lait\",2,\"dl\"],[\"beurre\",160,\"g\"],[\"sel\",2,\"c. à café\"],[\"d'œuf\",3,\"jaunes\"]],\"steps\":[\"Pour le levain, verser la farine dans un bol un laissant un creux au milieu.\",\"Émietter la levure et la mélanger avec le sucre et le lait puis la verser dans le creux.\",\"Ramener un peu de farine par-dessus et laisser reposer env. 30 min.\",\"Couper le beurre en noisettes et l'ajouter au levain avec le sel et ⅔ des jaunes d'œuf.\",\"Mélanger le tout et pétrir jusqu'à obtention d'une pâte souple et lisse.\",\"Couvrir et laisser doubler de volume env. 1 h à température ambiante.\",\"Entre-temps, couper le jambon en dés.\",\"Hacher fin les noix.\",\"Râper finement le zeste du citron vert sur les épinards puis les réduire grossièrement en purée.\",\"Ajouter le jambon et les noix.\",\"Mélanger le tout.\",\"Saler et poivrer.\",\"Beurrer les moules de muffins.\",\"Saupoudrer un peu de farine sur le plan de travail.\",\"Abaisser la pâte à env. 4 mm d'épaisseur, en un rectangle d'env. 40 x 30 cm.\",\"Répartir dessus la préparation aux épinards et au jambon en laissant 1/2 cm de libre dans les bords.\",\"Enrouler la pâte en partant d'un long côté.\",\"Couper 12 morceaux et les placer chacun dans un moule.\",\"Laisser lever env. 30 min.\",\"Préchauffer le four à 200 °C.\",\"Brasser le reste des jaunes d'œuf avec un peu d'eau et en badigeonner les brioches.\",\"Glisser au milieu du four et faire cuire 30-35 min.\",\"Sortir du four et laisser refroidir sur une grille à pâtisserie.\",\"Démouler et servir.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Snack\"],\"source\":\"https://migusto.migros.ch/fr/recettes/brioche-au-jambon-et-aux-epinards\",\"notes\":\"\",\"paprikaUid\":\"3809753D-B24A-409C-923A-234A371ADB41\"},{\"id\":\"boulettes-de-viande-a-l-asiatique-a-l-autocuiseur-mrryzefr4vl\",\"title\":\"Boulettes de viande à l’asiatique à l'autocuiseur\",\"category\":\"Cocotte\",\"time\":251,\"servings\":4,\"ingredients\":[[\"maigre\",450,\"g de boeuf haché\"],[\"nature\",125,\"ml de chapelure\"],[\"d’échalotes sèches (françaises) hachées\",80,\"ml\"],[\"haché\",15,\"ml de gingembre\"],[\"d’ail haché\",10,\"ml\"],[\"oeuf\",1,\"\"],[\"d’huile de colza\",15,\"ml\"],[\"soya\",125,\"ml de sauce\"],[\"poulet\",80,\"ml de bouillon de\"],[\"cassonade\",60,\"ml de\"],[\"maïs\",15,\"ml de fécule de\"]],\"steps\":[\"Dans un grand bol, mélanger le boeuf haché avec la chapelure, les échalotes, le gingembre, l’ail et l’oeuf.\",\"Façonner 20 boulettes en utilisant environ 30 ml (2 c. à soupe) de préparation pour chacune d’elles.\",\"Chauffer l’huile dans l’autocuiseur.\",\"Faire dorer les boulettes sur toutes les faces de 4 à 5 minutes.\",\"Dans un bol, mélanger la sauce soya avec le bouillon de poulet et la cassonade.\",\"Verser la sauce sur les boulettes, en s’assurant de ne pas remplir l’autocuiseur plus qu’aux deux tiers.\",\"Remuer.\",\"Fermer hermétiquement l’autocuiseur en tournant le couvercle.\",\"Cuire 5 minutes à haute pression.\",\"Une fois la cuisson terminée, évacuer la pression rapidement.\",\"Délayer la fécule de maïs dans un peu d’eau froide.\",\"Verser la fécule délayée dans l’autocuiseur.\",\"Remuer délicatement.\",\"Porter à ébullition, puis cuire de 2 à 3 minutes, jusqu’à ce que la sauce ait épaissi.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Cocotte\",\"Plat principal\",\"Poulet\"],\"source\":\"https://www.pratico-pratiques.com/galeries-thematiques/boulettes-de-viande-a-lasiatique-a-lautocuiseur/?gallery=pp-9097\",\"notes\":\"\",\"paprikaUid\":\"D520DE39-CB03-4CAD-B983-93635E052DE1\"},{\"id\":\"boulettes-de-viande-gratinees-mrryzefqjm9\",\"title\":\"Boulettes de viande gratinées\",\"category\":\"Gratin\",\"time\":75,\"servings\":4,\"ingredients\":[[\"basilic\",1,\"u bouquet de\"],[\"d’ail\",2,\"u gousses\"],[\"oignons\",1,\"u\"],[\"huile\",\"\",\"\"],[\"sucre\",1,\"c. à café\"],[\"râpé\",40,\"g parmesan\"],[\"lait\",1,\"dl\"],[\"mozzarella\",125,\"g\"],[\"veille\",50,\"g pain blanc de la\"],[\"pelées\",2,\"u boîte tomates cerises\"],[\"hachée\",400,\"g viande\"],[\"poivre\",\"\",\"\"],[\"sel\",\"\",\"\"]],\"steps\":[\"Préchauffer le four à 220°.\",\"Faire tremper le pain dans le lait pendant env. 30 min.\",\"Ajouter la viande, mélanger et assaisonner.\",\"Bien pétrir à la main jusqu'à obtenir une pâte compacte.\",\"Façonner 12 boulettes.\",\"Faire chauffer l'huile dans une poêle, saisir les boulettes de toutes parts pendant env. 8 min.\",\"Les déposer dans le plat à gratin.\",\"Faire chauffer l'huile dans la même poêle.\",\"Faire revenir l'oignon et l'ail pendant env. 5 min.\",\"Ajouter les tomates, un peu d'eau et le basilic (réserver qqes feuilles).\",\"Assaisonner et laisser réduire pendant env. 15 min.\",\"Verser la sauce dans le plat à gratin.\",\"Répartir la mozzarella, le parmesan et les feuilles de basilic réservées sur les boulettes de viande.\",\"Arroser d'huile, assaisonner.\",\"Faire gratiner env. 15 min. dans le haut du four.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Gratin\",\"Italie\",\"Plat principal\"],\"source\":\"https://fooby.ch/fr/recettes/18975/boulettes-de-viande-gratinees\",\"notes\":\"\",\"paprikaUid\":\"971DBEA0-1D3D-4CA5-92E7-82A47716562E\"},{\"id\":\"boulettes-de-pommes-de-terre-et-pois-chiches-en-salade-mrryzefohib\",\"title\":\"Boulettes de pommes de terre et pois chiches en salade\",\"category\":\"Salade\",\"time\":85,\"servings\":6,\"ingredients\":[[\"nouvelle\",300,\"g pomme de terre\"],[\"précuit\",300,\"g pois chiche\"],[\"chapelure\",50,\"g\"],[\"Padano\",120,\"g Grana\"],[\"d'ail\",1,\"u gousse\"],[\"œuf\",1,\"u\"],[\"paprika doux\",\"\",\"\"],[\"persil\",\"\",\"\"],[\"sel\",\"\",\"\"],[\"salade\",200,\"g\"],[\"cerise\",250,\"g tomate\"],[\"radis\",100,\"g\"],[\"d'olive\",30,\"g huile\"],[\"citron\",20,\"g jus de\"],[\"moutarde\",1,\"c. à café\"],[\"miel\",1,\"c. à café\"]],\"steps\":[\"Cuire les pommes de terre dans une casserole en partant d'eau froide environ 30 minutes.\",\"Peler et passer au presse-purée pour les réduire en purée.\",\"Verser les pois chiches égouttés dans le mixeur avec l'ail, le paprika et le sel.\",\"Aromatiser avec le persil.\",\"Mixer le tout.\",\"Verser le mélange dans le bol contenant la purée de pommes de terre et mélanger.\",\"Incorporez la chapelure, le Grana Padano râpé et un œuf.\",\"Mélanger bien jusqu'à obtenir une pâte homogène.\",\"Former des boulettes d'environ 25 grammes chacune et disposer sur une plaque recouverte de papier cuisson.\",\"Préparer la vinaigrette :\",\"Dans un bol verser l'huile et le jus de citron, saler et ajouter le miel.\",\"Ajouter la moutarde, mélanger et réserver.\",\"Préparer la salade :\",\"Laver et couper les tomates cerises en quartiers.\",\"Laver et émincer finement les radis.\",\"Dans un saladier, rassembler la salade verte, les radis et les tomates cerises.\",\"Assaisonner avec la vinaigrette au citron et réserver.\",\"Cuisson des boulettes :\",\"Faire chauffer une poêle légèrement huilée.\",\"Déposer les boulettes et cuire à feu moyen pendant environ 15 minutes, en veillant à les tourner souvent pour qu'elles dorent uniformément.\",\"Une fois dorées, éteindre le feu et laisser tiédir légèrement.\",\"Transférer la salade dans une assiette, ajouter les boulettes et les copeaux de Grana Padano.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Salade\"],\"source\":\"https://www.giallozafferano.fr/recettes/boulettes-de-pommes-de-terre-et-pois-chiches-en-salade.html\",\"notes\":\"\",\"paprikaUid\":\"8D8FDAE2-CDF7-4FCF-BAAA-89E8565A06CC\"},{\"id\":\"boulettes-au-fromage-et-salade-verte-mrryzefn3gd\",\"title\":\"Boulettes au fromage et salade verte\",\"category\":\"Plat principal\",\"time\":25,\"servings\":4,\"ingredients\":[[\"crème\",200,\"g fromage à la\"],[\"poivre\",\"\",\"\"],[\"noix\",2,\"c. à soupe\"],[\"persil\",1,\"c. à soupe\"],[\"ciboulette\",1,\"c. à soupe\"],[\"verte\",250,\"g salade\"],[\"Vinaigrette:\",\"\",\"\"],[\"blanc\",2,\"tbsp vinaigre balsamique\"],[\"colza\",3,\"tbsp huile de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Hacher finement les noix, la ciboulette et le persil.\",\"Couper la salade en morceaux.\",\"Couper le fromage en petits morceaux.\",\"Assaisonner et former une masse.\",\"Former à la main des boulettes de la grosseur d'une noix.\",\"Rouler les boulettes dans les noix et les herbes.\",\"Vinaigrette:\",\"Mélanger le vinaigre et l'huile.\",\"Assaisonner.\",\"Répartir la salade sur des assiettes.\",\"Ajouter quelques gouttes de vinaigrette.\",\"Disposer les boulettes de fromage à côté de la salade.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Saison Été\",\"Suisse\",\"Végétarien\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM200001_52_MEN001B052A/boulettes-au-fromage-et-salade-verte/\",\"notes\":\"\",\"paprikaUid\":\"5DB5D0FB-9866-49D8-A2CC-BB05DFE9539C\"},{\"id\":\"bouilli-a-la-salsa-verde-aux-micro-greens-mrryzefle8z\",\"title\":\"Bouilli à la salsa verde aux micro greens\",\"category\":\"Italie\",\"time\":285,\"servings\":4,\"ingredients\":[[\"bouilli\",800,\"g viande de bœuf pour\"],[\"blanc\",3,\"dl vin\"],[\"laurier\",1,\"u feuilles de\"],[\"amandes\",4,\"c. à soupe\"],[\"1¼ tbsp sel\",\"\",\"\"],[\"Sauce :\",\"\",\"\"],[\"basilic\",2,\"c. à soupe\"],[\"citrons\",1,\"u\"],[\"plat\",2,\"u brin persil\"],[\"d'olive\",1,\"dl huile\"],[\"moutarde\",1,\"c. à soupe\"],[\"dénoyautées\",2,\"tbsp olives vertes\"],[\"Greens\",2,\"tbsp Micro\"]],\"steps\":[\"La veille :\",\"Dans une casserole, porter à ébullition l'eau et le vin avec tous les ingrédients jusqu'à la feuille de laurier comprise, saler puis baisser le feu.\",\"Ajouter la viande et laisser frémir à couvert pendant env. 2 h en évitant l'ébullition.\",\"Retirer la casserole du feu et laisser refroidir la viande dans le bouillon.\",\"Le jour même :\",\"Couper la viande en fines tranches contre le sens des fibres et les dresser sur des assiettes.\",\"Dans un récipient, mixer la moutarde et tous les ingrédients jusqu'au sel compris et en napper la viande.\",\"Parsemer la viande de microgreens.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\",\"Saison Autumne\",\"Salade\"],\"source\":\"https://fooby.ch/fr/recettes/15607/bouilli-a-la-salsa-verde-aux-micro-greens\",\"notes\":\"\",\"paprikaUid\":\"7093466D-6B3F-4D79-8899-FD4D86AE2E8C\"},{\"id\":\"bolognaise-aux-lentilles-mrryzefkzk0\",\"title\":\"Bolognaise aux lentilles\",\"category\":\"Sauce\",\"time\":60,\"servings\":4,\"ingredients\":[[\"haché\",1,\"oignon finement\"],[\"beurre à rôtir\",\"\",\"\"],[\"dés\",200,\"g carottes coupées en petits\"],[\"céleri-rave coupé en petits dés\",150,\"g\"],[\"d'ail pressées\",2,\"gousses\"],[\"sucre\",1,\"c. à café\"],[\"tomates\",2,\"c. à soupe concentré de\"],[\"bouillon\",0.5,\"dl vin rouge ou de\"],[\"pelées\",400,\"g tomates\"],[\"vertes\",230,\"g lentilles\"],[\"flocons\",2,\"c. à soupe champignons séchés ou en\"],[\"champignons\",4,\"c. à soupe eau pour réhydrater les\"],[\"bouillon\",3,\"dl\"],[\"laurier\",1,\"feuille de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Faire revenir l'oignon dans le beurre à rôtir chaud.\",\"Ajouter les carottes, le céleri, l'ail et le sucre.\",\"Cuire à feu moyen.\",\"Ajouter le concentré de tomates.\",\"Chauffer brièvement.\",\"Mouiller avec le vin rouge ou le bouillon.\",\"Ajouter les tomates pelées, les lentilles, les champignons avec l'eau de trempage, le bouillon restant et la feuille de laurier.\",\"Porter à ébullition.\",\"Assaisonner.\",\"Couvrir et laisser mijoter 40-50 min à feu doux jusqu'à ce que les lentilles soient cuites.\",\"Retirer la feuille de laurier.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Sauce\",\"Végétarien\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/SM2021_DIVE_08/bolognaise-aux-lentilles/\",\"notes\":\"\",\"paprikaUid\":\"F7080140-784A-465F-B381-453F08E4B84D\"},{\"id\":\"boisson-rafraichissante-a-la-pasteque-mrryzefjmjn\",\"title\":\"Boisson rafraîchissante à la pastèque\",\"category\":\"Boisson\",\"time\":160,\"servings\":4,\"ingredients\":[[\"gazeuse\",5,\"dl eau minérale\"],[\"pastèques\",600,\"g\"],[\"poivrée\",5,\"brin menthe\"],[\"limettes\",2,\"\"],[\"sucre\",200,\"g\"]],\"steps\":[\"Couper la pastèque en dés.\",\"Effeuiller la menthe.\",\"Déposer la pastèque et les feuilles de menthe dans un bac.\",\"Ajouter les glaçons.\",\"Remplir d'eau.\",\"Couvrir et mettre au congélateur pendant env. 2 heures.\",\"Rincer la limette à l'eau chaude.\",\"La couper en deux puis en rondelles.\",\"Ajouter 3 glaçons par verre.\",\"Verser la boisson.\",\"Décorer avec de la limette et de la menthe.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Boisson\",\"Saison Été\"],\"source\":\"https://fooby.ch/fr/recettes/13774/boisson-rafraichissante-a-la-pasteque\",\"notes\":\"\",\"paprikaUid\":\"EE8F8E05-9FFF-42C2-B05E-4948A6525D90\"},{\"id\":\"boeuf-stroganov-mrryzefirzj\",\"title\":\"Boeuf Stroganov\",\"category\":\"A\",\"time\":30,\"servings\":4,\"ingredients\":[[\"oignons\",2,\"\"],[\"rouges\",2,\"poivrons\"],[\"Paris\",250,\"g de champignons de\"],[\"vinaigre\",100,\"g de concombres au\"],[\"d’huile d'arachide\",2,\"cs\"],[\"½ cc de Maïzena\",1,\"\"],[\"entière\",1,\"dl de crème\"],[\"viande\",2,\"dl de bouillon de\"],[\"rumsteck\",500,\"g de\"],[\"sel\",1,\"cc de\"],[\"un peu de poivre\",\"\",\"\"],[\"½ cc de paprika doux\",1,\"\"]],\"steps\":[\"Découper la viande en gros cubes d‘env. 1,5 cm, faire chauffer l‘huile dans une poêle et y faire revenir la viande de toutes parts pendant env. 2 min., la retirer de la poêle et l‘assaisonner.\",\"Hacher menu les oignons, couper les poivrons en lamelles et émincer les champignons de Paris. Dans la même poêle, faire chauffer l‘huile et y étuver les légumes avec le paprika pendant env. 5 min. Mouiller avec le bouillon, porter à ébullition.\",\"Mélanger la maïzena avec la crème, verser le tout dans la poêle et laisser mijoter à feu moyen pendant env. 5 min. Couper les concombres au vinaigre en fines lamelles, les ajouter à la viande, faire chauffer.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"A\"],\"source\":\"https://fooby.ch/fr/recettes/9940/boeuf-stroganov\",\"notes\":\"\",\"paprikaUid\":\"8771F3E6-A404-4352-BE1F-8A74B881F0C0\"},{\"id\":\"boeuf-braise-et-polenta-mrryzefglf4\",\"title\":\"Boeuf braisé et polenta\",\"category\":\"Italie\",\"time\":90,\"servings\":4,\"ingredients\":[[\"oignons\",1,\"\"],[\"d’ail\",2,\"gousses\"],[\"sauge\",1,\"brin\"],[\"d'arachide\",1,\"c. à soupe huile\"],[\"blanche\",0.5,\"c. à soupe farine\"],[\"beurre\",1,\"c. à soupe\"],[\"(Bramata)\",250,\"g semoule de maïs à gros grains\"],[\"tomates\",1,\"c. à soupe purée de\"],[\"concassées\",1,\"boîte tomates\"],[\"bœuf\",450,\"g ragoût de\"],[\"cru\",100,\"g lard\"],[\"rouge\",1,\"dl vin\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"thym\",1,\"brin\"]],\"steps\":[\"Chauffer l’huile fortement dans une cocotte, saisir la viande par portions env. 3 min, retirer.\",\"Dans la même cocotte, faire revenir env. 2 min les lanières de lard, l’oignon et l’ail, ajouter à nouveau la viande, la saupoudrer de farine, assaisonner.\",\"Incorporer le concentré de tomates.\",\"Mouiller avec le vin, laisser réduire complètement.\",\"Ajouter l’eau et les tomates, porter à ébullition.\",\"Baisser le feu, ajouter les brins d’herbes aromatiques, couvrir et braiser env. 1 h à couvert, retirer les herbes, assaisonner.\",\"Porter l’eau à ébullition avec le beurre, assaisonner.\",\"Incorporer le maïs, baisser la chaleur, laisser épaissir doucement env. 40 min à couvert en remuant de temps en temps sur tout petit feu.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Italie\",\"Plat principal\"],\"source\":\"https://fooby.ch/fr/recettes/6429/boeuf-braise-et-polenta\",\"notes\":\"\",\"paprikaUid\":\"5CF79EEA-1AEA-4AEA-BE94-ACA4FDFB46EA\"},{\"id\":\"biscuits-aperitifs-au-fromage-mrryzeff637\",\"title\":\"Biscuits apéritifs au fromage\",\"category\":\"Snack\",\"time\":60,\"servings\":4,\"ingredients\":[[\"d'œuf\",3,\"u blanc\"],[\"farine\",60,\"g de\"],[\"chimique\",1,\"tsp levure\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"],[\"d'alpage\",60,\"g fromage\"],[\"aromatique\",1,\"u herbe\"],[\"persil\",1,\"u\"]],\"steps\":[\"Préchauffer le four à 180°.\",\"Sortir une grille et la couvrir avec du papier sulfurisé.\",\"Râper le fromage et ciseler les herbes.\",\"Dans un récipient, battre les blancs d'oeufs au fouet, jusqu'à ce qu'ils moussent sans être totalement montés.\",\"Ajouter la farine, la levure, le sel et le poivre.\",\"Mélanger.\",\"Ajouter le fromage et les herbes.\",\"Mélanger à nouveau.\",\"A l'aide de deux cuillères, déposer la pâte sur le papier sulfurisé.\",\"Enfourner pour 15 min en surveillant la fin de la cuisson de façon à avoir une jolie couleur dorée.\",\"Laisser refroidir sur la grille.\",\"Servir avec un dip corsé.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Snack\"],\"source\":\"https://lacuisinedannie.20minutes.fr/recette-biscuits-aperitifs-au-fromage-facile-1609.html\",\"notes\":\"\",\"paprikaUid\":\"0B8D4D68-54D3-4280-BCEF-A97A7D0907C0\"},{\"id\":\"birchermuesli-mrryzefd0rw\",\"title\":\"Birchermüesli\",\"category\":\"Déjeuner\",\"time\":30,\"servings\":4,\"ingredients\":[[\"d'avoine\",6,\"tbsp flocons\"],[\"lait\",1,\"dl\"],[\"secs\",2,\"c. à soupe raisins\"],[\"yogourt\",500,\"g\"],[\"citron\",0.5,\"\"],[\"cannelle\",1,\"c. à café\"],[\"pommes\",3,\"\"],[\"fruits\",500,\"g\"],[\"moulues\",3,\"tbsp noisettes\"],[\"crème\",1,\"dl\"]],\"steps\":[\"Mélanger les flocons d'avoine et les raisins secs avec le lait.\",\"Laisser reposer une demi-heure.\",\"Incorporer le yogourt, le zeste et le jus de citron ainsi que la cannelle.\",\"Râper les pommes avec la râpe à bircher de manière à laisser la peau, mélanger aussitôt.\",\"Parer les autres fruits et les couper en morceaux.\",\"Ajouter les noisettes et les fruits.\",\"Diluer avec un peu de lait si besoin.\",\"Foueter la crème et l'incorporer.\",\"Dresser le bircher dans des coupelles, décorer.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Déjeuner\",\"Suisse\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM200806_89/bircher/\",\"notes\":\"\",\"paprikaUid\":\"B9DCF791-09B4-49DB-B64B-112475EC865C\"},{\"id\":\"bibimbap-mrryzefcujq\",\"title\":\"Bibimbap\",\"category\":\"Corée\",\"time\":30,\"servings\":4,\"ingredients\":[[\"jasmin\",300,\"g riz de\"],[\"froide\",6,\"dl eau\"],[\"bœuf\",400,\"g escalopes de\"],[\"maïs\",1,\"c. à soupe fécule de\"],[\"d'ail\",2,\"gousses\"],[\"concombre\",0.5,\"\"],[\"carotte\",1,\"\"],[\"chinois\",250,\"g chou\"],[\"nouveaux\",3,\"oignons\"],[\"shiitaké\",150,\"g champignons\"],[\"colza\",5,\"c. à soupe huile de\"],[\"mungo\",100,\"g pousses de haricot\"],[\"œufs\",4,\"\"],[\"sésame\",2,\"c. à soupe graines de\"],[\"d'ail\",2,\"gousses\"],[\"sésame\",2,\"c. à soupe huile de\"],[\"(sauce thaïlandaise piquante)\",2,\"c. à soupe sauce sriracha\"],[\"riz\",1,\"c. à soupe vinaigre de\"],[\"sucre\",1,\"c. à soupe\"],[\"soja\",6,\"c. à soupe sauce\"]],\"steps\":[\"Rincer le riz sous l'eau courante froide.\",\"Le verser dans l'eau, amener le tout à ébullition puis faire mijoter 1 min.\",\"Réduire le feu au minimum.\",\"Couvrir le riz et le laisser gonfler env. 20 min, ne pas remuer.\",\"Retirer et défaire le riz avec une fourchette.\",\"Pour la sauce bibimbap, faire légèrement griller le sésame.\",\"Presser l'ail et le mélanger au sésame avec le reste des ingrédients.\",\"Tailler les escalopes de bœuf en lanières.\",\"Bien les mélanger avec 2 cs de la sauce préparée et la fécule de maïs.\",\"Hacher finement l'ail.\",\"Partager le concombre en deux, dans la longueur, l'épépiner puis le tailler en fins bâtonnets ainsi que la carotte.\",\"Débiter le chou chinois en lanières, les oignons nouveaux en rouelles et les champignons en tranches.\",\"Chauffer un peu d'huile dans une poêle.\",\"Faire brièvement revenir les légumes, les champignons et les pousses, et ce séparément.\",\"Ajouter à chaque fois un peu de sauce et de l'ail haché puis réserver au chaud.\",\"Saisir la viande env. 3 min à feu vif avec la marinade et également la réserver au chaud.\",\"Faire cuire les œufs au plat avec le reste d'huile.\",\"Dresser le riz dans des bols et les garnir avec les ingrédients préparés.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Corée\",\"Plat principal\"],\"source\":\"https://migusto.migros.ch/fr/recettes/bibimbap\",\"notes\":\"\",\"paprikaUid\":\"C46157FC-82E4-45EC-BCB5-4E1A93B831CA\"},{\"id\":\"berner-platte-plat-bernois-mrryzefbb6s\",\"title\":\"Berner Platte (Plat bernois)\",\"category\":\"Plat principal\",\"time\":595,\"servings\":6,\"ingredients\":[[\"porc\",400,\"g jarret de\"],[\"oignon\",1,\"u\"],[\"genièvre\",1,\"c. à soupe\"],[\"beurre\",\"\",\"\"],[\"choucroute\",1,\"kg\"],[\"blanc\",2,\"dl vin\"],[\"poivre\",\"\",\"\"],[\"fumée\",600,\"g viande\"],[\"lard\",300,\"g\"],[\"saucisson\",1,\"\"],[\"secs\",100,\"g haricots\"],[\"d'ail\",2,\"u gousses\"],[\"lardon\",50,\"g\"],[\"crème à rôtir\",\"\",\"\"],[\"légumes\",2,\"dl bouillon de\"],[\"sarriette\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Cuire le jarret 1,5-2 h dans de l'eau salée frémissante.\",\"Choucroute: faire revenir les oignons et le genièvre dans le beurre.\",\"Ajouter la choucroute, faire revenir brièvement.\",\"Mouiller avec le vin ou le jus de pomme.\",\"Ajouter le carré de porc et le lard.\",\"Laisser mijoter 1h-1,5.\",\"Ajouter la saucisse de langue 30 min avant la fin de la cuisson.\",\"Égoutter les haricots secs.\",\"Faire revenir le lard et l'ail dans le beurre ou la crème à rôtir.\",\"Ajouter les haricots, faire revenir brièvement.\",\"Mouiller avec le bouillon.\",\"Ajouter la sarriette et le poivre.\",\"Laisser mijoter 45-60 min à couvert.\",\"Trancher la viande juste avant de servir.\",\"Disposer la choucroute et les haricots sur un grand plat.\",\"Répartir la viande par-dessus, décorer de sarriette.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Plat principal\",\"Saison Autumne\",\"Saison Hiver\",\"Suisse\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM200311_57_A/plat-bernois/?collection=97824\",\"notes\":\"Tremper les haricots secs la veille:\",\"paprikaUid\":\"015BDB10-148C-4763-9D34-20B5013A0327\"},{\"id\":\"basler-mehlsuppe-soupe-balois-a-la-farine-mrryzef935o\",\"title\":\"Basler Mehlsuppe (Soupe bâlois à la farine)\",\"category\":\"Saison Autumne\",\"time\":80,\"servings\":4,\"ingredients\":[[\"oignon\",1,\"\"],[\"farine\",5,\"c. à soupe\"],[\"beurre\",50,\"g\"],[\"Gruyère\",100,\"g\"],[\"bœuf\",1,\"l bouillon de\"],[\"blanc\",1,\"dl vin\"],[\"muscade\",0.25,\"c. à café noix de\"],[\"sel\",\"\",\"\"],[\"poivre\",\"\",\"\"]],\"steps\":[\"Faire griller la farine dans une casserole à feu moyen jusqu'à ce qu'elle prenne une belle couleur noisette.\",\"La sortir et la laisser refroidir.\",\"Baisser le feu et faire fondre le beurre dans la même poêle.\",\"Y faire suer l'oignon env. 3 min.\",\"Mouiller avec le vin, laisser réduire entièrement.\",\"Remettre la farine.\",\"Mouiller avec le bouillon et porter à ébullition tout en remuant au fouet.\",\"Baisser le feu et laisser mijoter env. 1 h en remuant de temps en temps.\",\"Assaisonner.\",\"Servir la soupe dans des assiettes préchauffées.\",\"Parsemer de Gruyère râpé ou servir celui-ci à part.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Saison Autumne\",\"Saison Hiver\",\"Soupe\",\"Suisse\"],\"source\":\"https://fooby.ch/fr/recettes/14129/potage-balois-a-la-farine\",\"notes\":\"\",\"paprikaUid\":\"5C0B0F6A-AD68-4B38-AEBF-A9135967DCFC\"},{\"id\":\"bami-goreng-vegane-mrryzef8qbw\",\"title\":\"Bami Goreng végane\",\"category\":\"Asie\",\"time\":60,\"servings\":4,\"ingredients\":[[\"gingembre\",10,\"g\"],[\"soja\",6,\"c. à soupe sauce\"],[\"sésame\",3,\"c. à soupe huile de\"],[\"d'ail\",1,\"gousse\"],[\"canne\",1,\"c. à soupe sucre de\"],[\"concassé\",1,\"c. à café poivre de Cayenne\"],[\"végan\",175,\"g émincé de poulet\"],[\"nouveaux\",2,\"oignons\"],[\"carottes\",150,\"g\"],[\"blanc\",150,\"g chou\"],[\"chinoises\",200,\"g nouilles\"],[\"sel\",\"\",\"\"],[\"chinoise, p. ex. sauce hoisin\",2,\"c. à soupe sauce épicée\"],[\"mangue\",1,\"c. à soupe chutney de\"],[\"curry\",1,\"c. à café\"],[\"persil\",0.5,\"bouquet\"]],\"steps\":[\"Pour la marinade, râper finement le gingembre et le mélanger à la sauce soja avec 1 cs d'huile de sésame.\",\"Y presser l'ail puis incorporer le sucre et le poivre de Cayenne.\",\"Ajouter le planted chicken.\",\"Bien mélanger et mettre env. 30 min au réfrigérateur.\",\"Couper les oignons nouveaux en anneaux.\",\"Détailler les carottes en fines lanières à l'aide d'un couteau à julienne.\",\"Également débiter le chou en fines lanières.\",\"Cuire les nouilles al dente dans de l'eau salée puis les égoutter en veillant à recueillir un peu d'eau de cuisson.\",\"Saisir le planted chicken dans un peu d'huile et le réserver au chaud.\",\"Faire revenir les légumes dans le reste de l'huile.\",\"Ajouter les nouilles et l'eau de cuisson, puis la sauce épicée et le chutney de mangue.\",\"Relever de curry et de sel.\",\"Ajouter le planted chicken.\",\"Mélanger et décorer de persil.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"Asie\",\"Végétarien\",\"Wok\"],\"source\":\"https://migusto.migros.ch/fr/recettes/bami-goreng-vegan\",\"notes\":\"\",\"paprikaUid\":\"A9ACF81B-0700-4D22-8301-565DE5A37382\"},{\"id\":\"asperges-a-la-sauce-rucola-mrryzef5b5e\",\"title\":\"Asperges à la sauce rucola\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"asperge\",1,\"kg\"],[\"sucre\",1,\"c. à café\"],[\"beurre\",1,\"c. à café\"],[\"oignon frais\",1,\"u\"],[\"rucola\",0.5,\"u\"],[\"beurre\",1,\"c. à soupe\"],[\"légumes\",1,\"dl fond de\"],[\"Mascarpone\",3,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"noix de muskat\",0,\"\"]],\"steps\":[\"Spargel waschen, schälen und holzige Enden abschneiden.\",\"Inzwischen reichlich Wasser aufkochen lassen.\",\"Das sprudelnd kochende Wasser mit 1 TL Salz, Zucker und Butter würzen.\",\"Spargel darin je nach Dicke 10-15 Min. kochen lassen.\",\"Inzwischen für die Sauce die Frühlingszwiebel putzen, waschen und mit dem Grün sehr fein hacken.\",\"Rucola waschen, trockenschütteln und ohne die groben Stiele fein schneiden.\",\"Butter heiß werden lassen.\",\"Frühlingszwiebel darin 3-4 Min. andünsten.\",\"Gemüsefond und etwas Spargelwasser dazugeben und um ein Drittel einkochen lassen.\",\"Mascarpone einrühren und die Sauce sämig einköcheln lassen, eventuell noch etwas Mascarpone unterrühren.\",\"Rucola dazugeben.\",\"Die Sauce kräftig mit Salz, Pfeffer und Muskat abschmecken.\",\"Spargel abgießen und mit der Mascarponesauce servieren.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Asperges\",\"Saison Printemps\",\"modifié\"],\"source\":\"https://www.kuechengoetter.de/rezepte/spargel-mit-mascarpone-rucola-sauce-3204\",\"notes\":\"\",\"paprikaUid\":\"661CED7C-E6E0-4268-B2A8-74A6A34DB6CC\"},{\"id\":\"asperges-a-la-poele-a-la-vinaigrette-mrryzef3ae2\",\"title\":\"Asperges à la poêle à la vinaigrette\",\"category\":\"Plat principal\",\"time\":45,\"servings\":2,\"ingredients\":[[\"asperge blanche\",700,\"g\"],[\"huile d’olive\",0,\"\"],[\"beurre\",0,\"\"],[\"bouillon de légumes\",2,\"dl\"],[\"citron\",1,\"u\"],[\"ail des ours\",0,\"\"],[\"fleur comestible\",0,\"\"],[\"oignon nouveau\",2,\"u\"],[\"persil plat\",0,\"\"],[\"ciboulette\",0,\"\"],[\"radis\",0,\"\"],[\"huile d'olive\",6,\"c. à soupe\"],[\"sauce soja épaisse\",1,\"c. à soupe\"],[\"balsamique blanc\",2,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Préparer les asperges.\",\"Dans une poêle bien chaude, les faire revenir avec du beurre et/ou de l'huile 10 à 15 minutes à feu moyen-vif, jusqu'à ce qu'elles soient dorées et tendres.\",\"Hacher finement tous les ingrédients pour la vinaigrette.\",\"Puis ajouter 1/2 verre de bouillon\",\"Couvrir et laisser cuire 5 à 10 minutes supplémentaires.\",\"Pendant ce temps, mélanger vigoureusement à l'aide d'un fouet, tous les ingrédients pour la vinaigrette.\",\"Ajouter les zestes du citron.\",\"Dresser les asperges sur les assiettes.\",\"Verser la vinaigrette dessus.\",\"Parsemer avec les fleurs et l'ail des ours.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Asperges\",\"Saison Printemps\",\"modifié\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"B19098B8-EA85-45E8-A90D-A1E4AA343097\"},{\"id\":\"asperges-vertes-a-la-milanaise-mrryzeenltt\",\"title\":\"Asperges vertes à la milanaise\",\"category\":\"Plat principal\",\"time\":45,\"servings\":4,\"ingredients\":[[\"asperge verte\",1,\"kg\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"sucre\",0,\"\"],[\"beurre\",3,\"c. à soupe\"],[\"Parmesan\",40,\"g\"],[\"œuf\",4,\"u\"]],\"steps\":[\"Den Spargel waschen, im unteren Drittel mit einem Sparschäler schälen und die Enden abschneiden.\",\"In einen weiten Topf, in dem die Stangen liegend Platz haben, ca. 5 cm hoch Wasser füllen.\",\"Je 1 TL Salz, Zucker und Butter dazugeben und das Wasser aufkochen lassen.\",\"Den Spargel ins kochende Wasser geben und bei mittlerer Hitze (das Wasser soll nur leise köcheln) 8-10 Min. garen.\",\"Inzwischen vom Parmesan mit dem Sparschäler feine Späne abhobeln.\",\"Die übrige Butter (2 TL) in einer Pfanne bei mittlerer Hitze zerlassen.\",\"Die Pfanne vom Herd nehmen und die Eier zu Spiegeleiern braten.\",\"Den Spargel mit einem Pfannenwender aus dem Sud heben, kurz abtropfen lassen und auf vier Teller verteilen.\",\"Die Spiegeleier leicht salzen und pfeffern und je 1 Spiegelei auf jede Spargelportion legen.\",\"Die Parmesanspäne darüberstreuen.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Asperges\",\"Italie\",\"Saison Printemps\",\"modifié\"],\"source\":\"https://www.kuechengoetter.de/rezepte/gruener-spargel-mailaender-art-58677\",\"notes\":\"\",\"paprikaUid\":\"FC0D7695-9E8D-4C74-865C-F3214E5E4CBB\"},{\"id\":\"asperges-vertes-avec-tomates-cerises-mrryzeemlc2\",\"title\":\"Asperges vertes avec tomates cerises\",\"category\":\"Plat principal\",\"time\":30,\"servings\":2,\"ingredients\":[[\"asperge verte\",1,\"u\"],[\"tomate cerise\",200,\"g\"],[\"pignon\",25,\"g\"],[\"Burrata\",2,\"u\"],[\"huile d’olive\",0,\"\"],[\"parmesan\",0,\"\"],[\"basilic frais\",0,\"\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Préchauffer le four à 200°.\",\"Parer les asperges.\",\"Les déposer dans un plat allant au four.\",\"Ajouter les tomates coupées en deux.\",\"Saler, poivrer et arroser avec l'huile.\",\"Enfourner pendant 15-20 minutes.\",\"Dresser sur les assiettes.\",\"Parsemer avec du parmesan râpé.\",\"Ajouter les Burratas ouvertes.\",\"Saler, poivrer et arroser d'huile d'olive.\",\"Parsemer avec le basilic coupé en lanières.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Asperges\",\"Saison Printemps\",\"Italie\",\"modifié\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"84245D11-7AAF-4650-9D3D-BF33730A7BEE\"},{\"id\":\"asperges-sur-lit-de-pommes-de-terre-mrryzee90um\",\"title\":\"Asperges sur lit de pommes de terre\",\"category\":\"Plat principal\",\"time\":15,\"servings\":4,\"ingredients\":[[\"pomme de terre ferme\",600,\"g\"],[\"bouillon\",3,\"dl\"],[\"asperge blanche\",800,\"g\"],[\"laitue romaine\",1,\"u\"],[\"fromage frais\",120,\"g\"],[\"jaune d'œuf\",1,\"u\"],[\"gruyère\",75,\"g\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"noix de muscade\",0,\"\"]],\"steps\":[\"Préchauffer le four à 200°.\",\"Préparer le bouillon de légumes.\",\"Éplucher les pommes de terre et les couper en fines rondelles.\",\"Les répartir dans un plat à gratin.\",\"Ajouter le bouillon et faire cuire pendant 30 à 35 minutes au four.\",\"Parer les asperges et les couper en deux dans le sens de la longueur.\",\"Les faire cuire dans de l'eau salée jusqu'à ce qu'elles soient à peine tendres.\",\"Blanchir brièvement les feuilles de laitue dans de l'eau salée bouillante, mais seulement jusqu'à ce qu'elles se recroquevillent.\",\"Les sortir de l'eau et bien les faire égoutter.\",\"Poser deux feuilles de laitue l'une sur l'autre et enrouler environ quatre asperges dedans.\",\"Préparer deux paquets par personne.\",\"Bien mélanger le fromage frais, le jaune d'œuf et le Gruyère râpé.\",\"Incorporer environ 1 dl de bouillon du plat à gratin et assaisonner.\",\"Poser les petits paquets d'asperges sur les pommes de terre et répartir la sauce dessus.\",\"Faire gratiner pendant environ 15 minutes dans le four à 220 °C.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Asperges\",\"Saison Printemps\",\"modifié\"],\"source\":\"https://www.patate.ch/fr/recettes/plat-principal/petits-paquets-d-asperges.html\",\"notes\":\"\",\"paprikaUid\":\"3E208DAA-D349-48CB-82B5-03983954552B\"},{\"id\":\"asperges-sur-burrata-mrryzee64l1\",\"title\":\"Asperges sur Burrata\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"asperge verte\",1,\"kg\"],[\"citron\",0.5,\"u\"],[\"gousse d'ail\",1,\"u\"],[\"panure\",3,\"c. à soupe\"],[\"parmesan\",3,\"c. à soupe\"],[\"Burrata\",2,\"u\"],[\"huile d’olive\",0,\"\"],[\"basilic frais\",0,\"\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Préchauffer le four à 200°.\",\"Parer les asperges\",\"Les déposer dans un plat allant au four.\",\"Arroser avec l'huile.\",\"Mélanger avec l'ail pressé, les zestes du citron et la panure.\",\"Arroser avec le jus de citron.\",\"Enfourner pendant 15-20 minutes.\",\"Dresser les Burratas sur les assiettes.\",\"Déposer les asperges.\",\"Parsemer avec le basilic coupé en lanières.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Asperges\",\"Saison Printemps\",\"modifié\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"70CECD27-3617-4A63-BF70-B27FA239B7C8\"},{\"id\":\"asperges-roties-aux-baies-tilfda-mrryzedv7a7\",\"title\":\"Asperges rôties aux baies Tilfda\",\"category\":\"Plat principal\",\"time\":20,\"servings\":4,\"ingredients\":[[\"asperge verte\",500,\"g\"],[\"huile d'olive\",1,\"c. à soupe\"],[\"baies Tilfda\",1,\"c. à café\"],[\"pamplemousse rose\",1,\"u\"],[\"fleur de sel\",0,\"\"]],\"steps\":[\"Préchauffez votre four à 200 °C.\",\"Préparer les asperges.\",\"Séchez-les bien avec un linge propre, car l'humidité empêche la caramélisation au four.\",\"Disposez les asperges en une seule couche sur une plaque.\",\"Arrosez d'huile d'olive, roulez-les pour bien les enrober.\",\"Enfournez 12 à 15 minutes. Elles doivent rester croquantes au coeur, avec des pointes légèrement dorées.\",\"Concasser les baies Tilfda directement sur les asperges brûlantes, à la sortie du four.\",\"Râpez finement le zeste du pamplemousse rose au-dessus du plat, puis pressez un filet de jus.\",\"Avant de servir, ajoutez une pincée de fleur de sel.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Asperges\",\"Saison Printemps\",\"modifié\"],\"source\":\"https://www.poivre.ch/recette/asperges-du-valais-roties-aux-baies-tilfda/\",\"notes\":\"\",\"paprikaUid\":\"E4B4C3A1-08B9-4B9B-B7EC-2554BE11C03F\"},{\"id\":\"asperges-grillees-mrryzeduwkn\",\"title\":\"Asperges grillées\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"asperge verte,\",1,\"kg\"],[\"huile de colza\",3,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"Gruyère,\",80,\"g\"],[\"jambon cru\",100,\"g\"],[\"huile de colza\",1,\"c. à soupe\"],[\"citron\",1,\"u\"]],\"steps\":[\"Parer les asperges.\",\"Râper le fromage.\",\"Râper le zeste de citron.\",\"ASPERGES\",\"Mélanger les asperges avec l’huile.\",\"Assaisonner et placer sur la plaque préparée.\",\"CUISSON AU FOUR\",\"Faire griller pendant 25 à 35 minutes au milieu du four préchauffé à 200 °C.\",\"GARNITURE\",\"Saupoudrer les asperges avec le fromage râpé.\",\"Répartir le jambon dessus, verser quelques gouttes d’huile.\",\"Assaisonner et finir de cuire pendant env. 10 minutes.\",\"Sortir du four.\",\"Râper le zeste de citron dessus et servir immédiatement.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Asperges\",\"Saison Printemps\",\"modifié\"],\"source\":\"https://www.gemuese.ch/fr/recettes/asperges-grillees?_gl=1*xvo8pq*_up*MQ..*_gs*MQ..&gclid=EAIaIQobChMIidDR5aLUkQMVqIKDBx3jfDtyEAAYASAAEgJamvD_BwE&gbraid=0AAAAA-NhTE6ZgQqRSKGIn7vgxklFlEwi-\",\"notes\":\"\",\"paprikaUid\":\"3419F7BF-9267-4236-BFFE-1841DE5F3F33\"},{\"id\":\"asperges-croustillantes-sur-creme-de-betterave-et-uf-poche-mrryzedt5wc\",\"title\":\"Asperges croustillantes sur crème de betterave et œuf poché\",\"category\":\"Plat principal\",\"time\":55,\"servings\":4,\"ingredients\":[[\"asperge\",500,\"g\"],[\"huile d'olive\",0,\"\"],[\"betterave cuite\",440,\"g\"],[\"yaourt grec\",400,\"g\"],[\"jus de citron\",0,\"\"],[\"œuf\",4,\"u\"],[\"vinaigre de vin blanc\",20,\"g\"],[\"parmesan\",40,\"g\"],[\"ciboulette\",0,\"\"],[\"sel\",0,\"\"],[\"poivre noir\",0,\"\"]],\"steps\":[\"Nettoyer les asperges.\",\"Blanchir 3 minutes et plonger dans l'eau glacée.\",\"Chauffer bien une plaque huilée avec un filet d'huile et déposer les asperges.\",\"Faire griller pendant environ 5-7 minutes en les tournant pour cuire tous les côtés.\",\"Saler et réserver.\",\"Pendant que les asperges cuisent, préparer les sauces:\",\"Couper la betterave en dés et mettre dans un mixeur. Assaisonnez avec du sel et de l'huile.\",\"Mixer jusqu'à obtenir une texture crémeuse.\",\"Si nécessaire, ajouter un peu d'eau.\",\"Pour obtenir une crème plus lisse et soyeuse, passer au tamis.\",\"Transférer 200 g de crème de betterave dans un bol.\",\"Assaisonner la crème restante avec de l'huile, du jus de citron et du poivre.\",\"Ajouter aux 200 g de betterave environ 100 g de yaourt grec, juste ce qu'il faut pour obtenir une teinte rosée. Assaisonnez également cette sauce avec l'huile.\",\"Rectifier l'assaisonnement en sel et poivre, puis parfumer avec le jus de citron.\",\"Enfin, assaisonner le yaourt grec restant avec du jus de citron.\",\"Ajouter aussi l'huile, le sel et le poivre.\",\"Mélangez pour homogénéiser.\",\"Enfin, préparer les œufs pochés:\",\"Porter à ébullition une petite casserole d'eau avec le vinaigre.\",\"Quand l'eau bout, remuer avec une cuillère pour créer un tourbillon, puis laisser glisser délicatement un œuf au centre.\",\"Laisser cuire l'œuf environ 3 minutes sans y toucher.\",\"Égoutter avec une écumoire et déposer sur un plateau.\",\"Procéder ainsi pour cuire les autres œufs.\",\"Prêt à dresser:\",\"Disposer les 3 sauces à la base d'une assiette de service en alternant les couleurs.\",\"Former une sorte d'échiquier.\",\"Disposer les asperges par-dessus et aromatiser avec de la ciboulette ciselée.\",\"Terminer avec l'œuf poché et des copeaux de parmesan.\",\"Rectifier en sel et poivre.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Asperges\",\"modifié\"],\"source\":\"https://www.giallozafferano.fr/recettes/asperges-croustillantes-sur-creme-de-betterave-et-oeuf-poche.html\",\"notes\":\"\",\"paprikaUid\":\"0807AB0A-0415-4485-A9DB-E588DE5FC6B1\"},{\"id\":\"asperges-au-four-avec-burrata-mrryzedsjdb\",\"title\":\"Asperges au four avec Burrata\",\"category\":\"Plat principal\",\"time\":35,\"servings\":4,\"ingredients\":[[\"asperge verte\",1,\"kg\"],[\"huile d’olive\",6,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"],[\"burrata\",4,\"u\"],[\"mélange de noix\",50,\"g\"],[\"beurre\",40,\"g\"],[\"chapelure\",5,\"c. à soupe\"],[\"pois chiche cuit\",230,\"g\"],[\"poivre rose\",1,\"c. à café\"]],\"steps\":[\"Préchauffer le four à 200 °C.\",\"Peler le tiers inférieur des asperges, trancher la base.\",\"Mélanger les asperges avec la moitié de l'huile d'olive.\",\"Les disposer sur une plaque chemisée de papier sulfurisé.\",\"Assaisonner de sel et de poivre.\",\"Partager les burratas en deux.\",\"Prélever le cœur liquide et crémeux avec une cuillère et le réserver dans un petit bol.\",\"Couper le reste en morceaux et les mettre de côté.\",\"Hacher grossièrement le mélange de noix.\",\"Faire fondre le beurre et le mélanger aux noix avec le panko.\",\"Répartir le cœur crémeux des burratas sur les asperges.\",\"Parsemer le tout de noix et de pois chiches.\",\"Glisser au milieu du four et cuire env. 15 min.\",\"Arroser les morceaux de burrata mis de côté avec le reste de l'huile d'olive.\",\"Relever de sel et de poivre rose.\",\"Servir avec les asperges.\",\"Délicieux avec une salade verte.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Asperges\",\"Saison Printemps\",\"modifié\"],\"source\":\"https://migusto.migros.ch/fr/recettes/asperges-au-four-avec-burrata\",\"notes\":\"\",\"paprikaUid\":\"7DDAF844-BCDC-4B97-8D5E-496B3F6865C2\"},{\"id\":\"asperges-au-four-mrryzedrtwz\",\"title\":\"Asperges au four\",\"category\":\"Plat principal\",\"time\":40,\"servings\":5,\"ingredients\":[[\"asperge verte\",1,\"kg\"],[\"asperge blanche\",1,\"kg\"],[\"tomate cerise\",250,\"g\"],[\"mozzarelline\",150,\"g\"],[\"beurre\",50,\"g\"],[\"sel,\",0,\"\"],[\"poivre\",0,\"\"],[\"vin blanc\",1,\"dl\"],[\"bouillon de légumes\",5,\"dl\"],[\"persil\",0.5,\"bouquet\"]],\"steps\":[\"Parer les asperges.\",\"Couper grossièrement le persil.\",\"Disposer les asperges sur la plaque préalablement beurrée.\",\"Répartir par-dessus les tomates, la mozzarella et le beurre coupé en dés.\",\"Assaisonner.\",\"Ajouter le vin et le bouillon.\",\"Cuire 25-35 min au milieu du four préchauffé à 200°C.\",\"Retourner délicatement les asperges à plusieurs reprises à l'aide de deux fourchettes.\",\"Sortir la plaque du four.\",\"Parsemer de fines herbes.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Asperges\",\"Saison Printemps\",\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/LM200405_17/asperges-au-four/\",\"notes\":\"\",\"paprikaUid\":\"54CD7995-0DC4-4C49-9639-9C1DFEE34B59\"},{\"id\":\"asperges-au-beurre-mrryzedq7pr\",\"title\":\"Asperges au beurre\",\"category\":\"Plat principal\",\"time\":30,\"servings\":2,\"ingredients\":[[\"asperge blanche\",12,\"u\"],[\"lard fumé\",70,\"g\"],[\"œuf\",2,\"u\"],[\"beurre\",50,\"g\"],[\"persil\",0,\"\"],[\"crème entière\",2,\"dl\"],[\"parmesan\",80,\"g\"],[\"moutarde\",2,\"c. à café\"],[\"poivre\",0,\"\"]],\"steps\":[\"Préchauffer le four à 200°.\",\"Éplucher les asperges et garder les bouts et les épluchures.\",\"Couper le lard en bâtonnets.\",\"Cuire pendant 5 minutes les asperges et les épluchures dans peu d'eau salée et sucrée.\",\"Chauffer le beurre dans une poêle.\",\"Ôter les asperges et les déposer sur une grille sur un récipient.\",\"Continuer à cuire le reste.\",\"Mettre les asperges au four.\",\"Verser le beurre fondu dessus.\",\"Arroser régulièrement.\",\"Dans la même poêle, dorer les bâtonnets de lard.\",\"Réserver.\",\"Dans la même poêle chauffer la crème.\",\"Assaisonner.\",\"Ajouter les épluchures et le persil.\",\"Verser le tout dans un récipient et mixer finement.\",\"Remettre dans la poêle.\",\"Préparer les œufs plats.\",\"Dresser les asperges, arroser avec la sauce et couvrir avec l'œuf.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Asperges\",\"Saison Printemps\",\"modifié\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"78C97D44-1213-448F-8951-FA1C71060DF9\"},{\"id\":\"asperges-aigres-douces-a-la-mozzarella-mrryzedgrkm\",\"title\":\"Asperges aigres-douces à la mozzarella\",\"category\":\"Salade\",\"time\":50,\"servings\":4,\"ingredients\":[[\"eau\",6,\"dl\"],[\"vinaigre de vin blanc\",1.5,\"dl\"],[\"vin blanc\",2.5,\"dl\"],[\"sucre\",4,\"c. à soupe\"],[\"sel\",0,\"\"],[\"grains de poivre blanc\",0,\"\"],[\"beurre\",1,\"c. à soupe\"],[\"asperge blanche\",1,\"u botte\"],[\"salade printanière\",100,\"g\"],[\"mozzarelline\",160,\"g\"],[\"huile\",6,\"c. à soupe\"],[\"balsamique blanc\",3,\"c. à soupe\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Pour le court-bouillon, porter à ébullition tous les ingrédients prévus et laisser frémir durant 15 minutes.\",\"Parer les asperges.\",\"Ajouter les asperges au court-bouillon et cuire pendant 10-15 minutes.\",\"Réserver un peu de bouillon pour la sauce.\",\"Dresser la salade sur des assiettes.\",\"Ajouter les asperges.\",\"Parsemer de mozzarelline.\",\"Pour la sauce, mélanger tous les ingrédients prévus avec le bouillon réservé et en arroser le tout.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Asperges\",\"Saison Printemps\",\"Salade\",\"modifié\"],\"source\":\"https://www.swissmilk.ch/fr/recettes-idees/recettes/KB_AFT1999_013/asperges-aigres-douces-a-la-mozzarella/\",\"notes\":\"\",\"paprikaUid\":\"911D91EB-FBDB-4417-A5FE-13B5FCB5E0EE\"},{\"id\":\"asparagi-al-gorgonzola-mrryzedfod0\",\"title\":\"Asparagi al Gorgonzola\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"asperge blanche\",1,\"kg\"],[\"Gorgonzola\",1,\"u\"],[\"citron\",1,\"u\"],[\"beurre\",0,\"\"],[\"sel\",0,\"\"],[\"sucre\",0,\"\"]],\"steps\":[\"Chauffer l'eau de cuisson salée et sucrée pour les asperges.\",\"Parer les asperges.\",\"Ajouter la découpe à l'eau de cuisson.\",\"Préchauffer le four à 200°.\",\"Râper les zestes de citron et presser le jus.\",\"Ajouter un peu à l'eau de cuisson.\",\"Cuire les asperges 5-10 minutes avec un peu de beurre.\",\"Préparer un plat allant au four.\",\"Y déposer les asperges.\",\"Arroser d'huile d'olive.\",\"Saler, poivrer et déposer dessus la Gorgonzola couper en tranches.\",\"Arroser du reste du jus de citron\",\"Enfourner pendant 10 minutes.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Asperges\",\"modifié\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"0CEC8135-218E-4817-A83E-F10E9216804F\"},{\"id\":\"ajo-blanco-mrryzedb8bo\",\"title\":\"Ajo blanco\",\"category\":\"Soupe\",\"time\":20,\"servings\":6,\"ingredients\":[[\"amande mondée\",250,\"g\"],[\"mie de pain blanc sec\",100,\"g\"],[\"gousse d'ail\",2,\"u\"],[\"huile d'olive\",2,\"dl\"],[\"vinaigre de Xérès\",1,\"dl\"],[\"sel\",0,\"\"],[\"piment doux ou fort\",0,\"\"],[\"raisin blanc\",0,\"\"]],\"steps\":[\"Mettez les amandes dans un saladier.\",\"Ajoutez le pain en l’émiettant, les gousses d’ail pelées, l’huile et le vinaigre.\",\"Salez.\",\"Laissez reposer 6 h au moins, afin que le pain s’imbibe d’huile et de vinaigre.\",\"Versez la préparation dans le bol d’un blender et mixez-la, en la diluant selon votre goût avec de l’eau froide, jusqu’à obtention d’une soupe lisse et veloutée.\",\"Réservez au réfrigérateur 2 h ou plus.\",\"Hachez grossièrement les amandes qui serviront à la garniture de la soupe et faites-les dorer dans un filet d’huile d’olive.\",\"Retirez du feu et saupoudrez de piment.\",\"Laissez refroidir.\",\"Pelez les grains de raisin et retirez-en les pépins.\",\"Servez la soupe bien froide dans des bols et garnissez d’amandes et de raisin.\",\"Ajoutez quelques gouttes d’huile et servez aussitôt.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Italie\",\"modifié\"],\"source\":\"https://www.elle.fr/Elle-a-Table/Recettes-de-cuisine/Ajo-blanco-2464576\",\"notes\":\"\",\"paprikaUid\":\"9DCD41CA-520F-4860-A4B8-5D6F259FDA6E\"},{\"id\":\"agua-fresca-a-la-pasteque-mrryzedam06\",\"title\":\"Agua fresca à la pastèque\",\"category\":\"Boisson\",\"time\":10,\"servings\":2,\"ingredients\":[[\"pastèque moyenne\",1,\"u\"],[\"eau\",500,\"ml\"],[\"lime, jus\",0.5,\"\"],[\"sirop simple\",0,\"\"],[\"feuille menthe\",0,\"\"]],\"steps\":[\"Mettez tous les ingrédients dans un mélangeur et broyez le tout jusqu’à ce que le mélange soit homogène.\",\"Faites refroidir l’agua fresca et servez-la sur glace.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Saison Été\",\"modifié\"],\"source\":\"https://ici.radio-canada.ca/mordu/recettes/6381/agua-fresca-melon-eau\",\"notes\":\"\",\"paprikaUid\":\"CAC6D636-45CB-494E-BCF5-5CA30308F642\"},{\"id\":\"agnolotti-au-chevre-et-a-l-orange-mrryzed8liv\",\"title\":\"Agnolotti au chèvre et à l'orange\",\"category\":\"Plat principal\",\"time\":60,\"servings\":4,\"ingredients\":[[\"pignons de pin\",2,\"c. à soupe\"],[\"orange\",2,\"u\"],[\"poireau\",300,\"g\"],[\"sauge\",1,\"c. à soupe\"],[\"fromage de chèvre frais\",300,\"g\"],[\"blanc d'œuf\",1,\"u\"],[\"beurre\",3,\"c. à soupe\"],[\"pâte à nouilles\",2,\"rouleau\"],[\"vin blanc\",0.5,\"dl\"],[\"grain de poivre\",0.5,\"c. à café\"],[\"sel\",0,\"\"],[\"poivre\",0,\"\"]],\"steps\":[\"Râper au mortier le zeste d'orange, avec les grains de poivre et les pignons de pin.\",\"Mélanger avec le fromage râpé et saler.\",\"Verser la farce dans une poche à douille non cannelée (env. 1 cm de Ø).\",\"Dérouler une des pâtes et la couper en deux dans la longueur.\",\"Sur l'une des bandes de pâte, garnir un bord longitudinal ¼ de la farce en gardant un bord d'env. 1 cm.\",\"Badigeonner les bords de blanc d'œuf.\",\"Replier la bande sur elle-même en chassant l'air.\",\"Avec le tranchant de la main, délimiter des agnolotti à des intervalles d'environ 4 cm.\",\"Les découper avec une roulette de pâtissier.\",\"Répéter l'opération 3 fois.\",\"Faire cuire les agnolotti dans une grande casserole d'eau salée frémissante pendant env. 5 min.\",\"Egoutter et réserver au chaud.\",\"Pendant ça, couper le poireau en deux dans la longueur, puis en morceaux de 6 cm.\",\"Faire fondre un peu de beurre dans une poêle.\",\"Ajouter le poireau et le faire suer pendant env. 5 min.\",\"Mouiller avec le vin.\",\"Ajouter le bouillon et laisser mijoter à couvert env. 5 min..\",\"Saler et poivrer.\",\"Couper le zeste dl'orange en fines lamelles.\",\"Faire fondre le beurre.\",\"Ajouter les feuilles de sauge et les faire rissoler pendant env. 2 min.\",\"Ajouter le zeste d'orange.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"Italie\",\"Pâtes\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/6494/agnolotti-au-chevre-et-a-l-orange\",\"notes\":\"\",\"paprikaUid\":\"2093FC9D-1573-4990-9A9C-9CDD35B52950\"},{\"id\":\"abricots-au-gorgonzola-mrryzed590n\",\"title\":\"Abricots au Gorgonzola\",\"category\":\"Dessert\",\"time\":20,\"servings\":4,\"ingredients\":[[\"pignons de pin\",25,\"g\"],[\"abricots\",4,\"u\"],[\"basilic\",0.5,\"bouquet\"],[\"huile d'olive\",1,\"c. à soupe\"],[\"Gorgonzola\",100,\"g\"],[\"ricotta\",125,\"g\"],[\"poivre\",0,\"\"]],\"steps\":[\"Dans un saladier, écraser le gorgonzola avec une fourchette.\",\"Ajouter la ricotta et bien mélanger.\",\"Mettre de côté.\",\"Faire chauffer l'huile dans une poêle à revêtement antiadhésif.\",\"Ajouter les moitiés d'abricots.\",\"Faire griller pendant env. 5 min de chaque côté.\",\"Laisser tiédir hors du feu.\",\"Répartir le gorgonzola sur un plat.\",\"Disposer les abricots dessus.\",\"Garnir avec le basilic et les pignons de pin.\",\"Assaisonner.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"Dessert\",\"Italie\",\"modifié\"],\"source\":\"https://fooby.ch/fr/recettes/28148/abricots-au-gorgonzola\",\"notes\":\"\",\"paprikaUid\":\"923104AE-0582-44F5-B42F-E2A3FC3FF8DB\"},{\"id\":\"poulet-thym\",\"title\":\"Poulet rôti au thym et citron\",\"category\":\"Volaille\",\"time\":75,\"servings\":4,\"ingredients\":[[\"Poulet\",1,\"pièce\"],[\"Pommes de terre\",1000,\"g\"],[\"Citron\",1,\"pièce\"],[\"Ail\",4,\"gousses\"],[\"Thym\",2,\"c. à café\"]],\"steps\":[\"Préchauffer le four à 200 °C.\",\"Ajouter pommes de terre, ail, thym et citron autour du poulet.\",\"Cuire 60 à 75 minutes en arrosant.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"boeuf-champi\",\"title\":\"Émincé de bœuf aux champignons\",\"category\":\"Bœuf\",\"time\":30,\"servings\":4,\"ingredients\":[[\"Émincé de bœuf\",500,\"g\"],[\"Champignons\",400,\"g\"],[\"Oignon\",1,\"pièce\"],[\"Crème\",200,\"ml\"],[\"Paprika fumé\",1,\"c. à café\"],[\"Tagliatelles\",400,\"g\"]],\"steps\":[\"Cuire les pâtes.\",\"Saisir le bœuf puis réserver.\",\"Cuire oignon et champignons, ajouter crème et paprika, puis remettre la viande.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"gratin-courgettes\",\"title\":\"Gratin de courgettes au romarin\",\"category\":\"Végétarien\",\"time\":45,\"servings\":4,\"ingredients\":[[\"Courgettes\",4,\"pièces\"],[\"Oignon\",1,\"pièce\"],[\"Ail\",2,\"gousses\"],[\"Gruyère\",150,\"g\"],[\"Crème\",150,\"ml\"],[\"Romarin\",1,\"c. à café\"]],\"steps\":[\"Faire revenir les légumes.\",\"Ajouter crème, romarin et fromage.\",\"Gratiner 25 minutes à 190 °C.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"porc-moutarde\",\"title\":\"Filet mignon de porc à la moutarde ancienne\",\"category\":\"Porc\",\"time\":35,\"servings\":4,\"ingredients\":[[\"Filet mignon\",600,\"g\"],[\"Échalotes\",2,\"pièces\"],[\"Crème\",200,\"ml\"],[\"Moutarde à l’ancienne\",2,\"c. à soupe\"],[\"Estragon\",1,\"c. à café\"],[\"Riz\",300,\"g\"]],\"steps\":[\"Cuire le riz.\",\"Dorer le porc.\",\"Ajouter échalotes, crème, moutarde et estragon.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"chili\",\"title\":\"Chili con carne doux\",\"category\":\"Bœuf\",\"time\":40,\"servings\":4,\"ingredients\":[[\"Bœuf haché\",500,\"g\"],[\"Haricots rouges\",400,\"g\"],[\"Tomates concassées\",400,\"g\"],[\"Oignon\",1,\"pièce\"],[\"Ail\",2,\"gousses\"],[\"Cumin\",1,\"c. à café\"],[\"Paprika\",1,\"c. à café\"],[\"Riz\",300,\"g\"]],\"steps\":[\"Faire revenir oignon, ail et bœuf.\",\"Ajouter tomates, haricots et épices.\",\"Mijoter 20 minutes et servir avec le riz.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"agneau\",\"title\":\"Gigot d’agneau au romarin\",\"category\":\"Agneau\",\"time\":90,\"servings\":4,\"ingredients\":[[\"Gigot d’agneau\",1200,\"g\"],[\"Pommes grenaille\",800,\"g\"],[\"Haricots verts\",500,\"g\"],[\"Ail\",4,\"gousses\"],[\"Romarin\",2,\"c. à café\"]],\"steps\":[\"Frotter le gigot avec ail et romarin.\",\"Ajouter les pommes grenaille.\",\"Cuire au four selon la cuisson souhaitée.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"poulet-creme\",\"title\":\"Poulet à la crème et aux champignons\",\"category\":\"Volaille\",\"time\":40,\"servings\":4,\"ingredients\":[[\"Blancs de poulet\",600,\"g\"],[\"Champignons\",400,\"g\"],[\"Crème\",250,\"ml\"],[\"Moutarde\",1,\"c. à soupe\"],[\"Persil\",2,\"c. à soupe\"],[\"Nouilles\",400,\"g\"]],\"steps\":[\"Cuire les nouilles.\",\"Dorer le poulet.\",\"Ajouter champignons, crème et moutarde, puis le persil.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"boulettes\",\"title\":\"Boulettes de bœuf, tomate et basilic\",\"category\":\"Bœuf\",\"time\":35,\"servings\":4,\"ingredients\":[[\"Bœuf haché\",500,\"g\"],[\"Tomates concassées\",500,\"g\"],[\"Oignon\",1,\"pièce\"],[\"Basilic\",2,\"c. à soupe\"],[\"Spaghetti\",400,\"g\"]],\"steps\":[\"Former et dorer les boulettes.\",\"Préparer la sauce tomate.\",\"Mijoter 15 minutes avec le basilic.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"omelette\",\"title\":\"Omelette forestière au persil\",\"category\":\"Œufs\",\"time\":20,\"servings\":2,\"ingredients\":[[\"Œufs\",6,\"pièces\"],[\"Champignons\",250,\"g\"],[\"Échalote\",1,\"pièce\"],[\"Persil\",2,\"c. à soupe\"]],\"steps\":[\"Faire revenir échalote et champignons.\",\"Ajouter les œufs battus.\",\"Cuire doucement et parsemer de persil.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"curry\",\"title\":\"Poulet au curry doux et lait de coco\",\"category\":\"Volaille\",\"time\":30,\"servings\":4,\"ingredients\":[[\"Blancs de poulet\",600,\"g\"],[\"Lait de coco\",400,\"ml\"],[\"Oignon\",1,\"pièce\"],[\"Curry doux\",2,\"c. à café\"],[\"Carottes\",3,\"pièces\"],[\"Riz\",300,\"g\"]],\"steps\":[\"Cuire le riz.\",\"Faire revenir poulet, oignon et carottes.\",\"Ajouter curry et lait de coco, mijoter 15 minutes.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"risotto\",\"title\":\"Risotto aux champignons et parmesan\",\"category\":\"Végétarien\",\"time\":35,\"servings\":4,\"ingredients\":[[\"Riz à risotto\",320,\"g\"],[\"Champignons\",400,\"g\"],[\"Bouillon\",1000,\"ml\"],[\"Oignon\",1,\"pièce\"],[\"Parmesan\",80,\"g\"]],\"steps\":[\"Faire revenir oignon et champignons.\",\"Ajouter le riz.\",\"Verser progressivement le bouillon et terminer avec le parmesan.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"hachis\",\"title\":\"Hachis parmentier maison\",\"category\":\"Bœuf\",\"time\":55,\"servings\":4,\"ingredients\":[[\"Bœuf haché\",500,\"g\"],[\"Pommes de terre\",1000,\"g\"],[\"Carottes\",2,\"pièces\"],[\"Oignon\",1,\"pièce\"],[\"Lait\",200,\"ml\"],[\"Beurre\",40,\"g\"]],\"steps\":[\"Préparer la purée.\",\"Cuire bœuf, carottes et oignon.\",\"Monter le plat et gratiner 20 minutes.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"quiche\",\"title\":\"Quiche aux poireaux et fromage\",\"category\":\"Végétarien\",\"time\":50,\"servings\":4,\"ingredients\":[[\"Pâte brisée\",1,\"pièce\"],[\"Poireaux\",3,\"pièces\"],[\"Œufs\",3,\"pièces\"],[\"Crème\",200,\"ml\"],[\"Gruyère\",120,\"g\"],[\"Muscade\",1,\"pincée\"]],\"steps\":[\"Faire fondre les poireaux.\",\"Mélanger œufs, crème et fromage.\",\"Garnir la pâte et cuire 35 minutes.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"dinde\",\"title\":\"Escalopes de dinde au paprika\",\"category\":\"Volaille\",\"time\":25,\"servings\":4,\"ingredients\":[[\"Escalopes de dinde\",600,\"g\"],[\"Paprika\",2,\"c. à café\"],[\"Crème\",150,\"ml\"],[\"Oignon\",1,\"pièce\"],[\"Semoule\",300,\"g\"]],\"steps\":[\"Préparer la semoule.\",\"Dorer les escalopes.\",\"Ajouter oignon, paprika et crème.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"salade-lentilles-feta\",\"title\":\"Salade de lentilles, carottes et feta\",\"category\":\"Salade\",\"time\":30,\"servings\":4,\"ingredients\":[[\"lentilles verte\",300,\"g\"],[\"carottes\",3,\"u\"],[\"Feta\",180,\"g\"],[\"Échalote\",1,\"u\"],[\"persil\",2,\"c. à soupe\"],[\"moutarde\",1,\"c. à soupe\"],[\"huile d’olive\",3,\"c. à soupe\"]],\"steps\":[\"Cuire les lentilles puis les laisser tiédir.\",\"Couper les carottes finement.\",\"Mélanger avec la feta, l’échalote et le persil.\",\"Assaisonner avec la moutarde et l’huile.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"modifié\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"salade-pommes-terre-herbes\",\"title\":\"Salade de pommes de terre aux herbes\",\"category\":\"Œufs\",\"time\":35,\"servings\":4,\"ingredients\":[[\"Pommes de terre\",900,\"g\"],[\"Œufs\",4,\"pièces\"],[\"Cornichons\",100,\"g\"],[\"Ciboulette\",2,\"c. à soupe\"],[\"Persil\",2,\"c. à soupe\"],[\"Moutarde\",1,\"c. à soupe\"],[\"Yaourt nature\",180,\"g\"]],\"steps\":[\"Cuire les pommes de terre et les œufs, puis laisser refroidir.\",\"Couper les ingrédients.\",\"Mélanger yaourt, moutarde et herbes.\",\"Assembler et réserver au frais.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"froid\",\"sans viande\",\"familial\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"taboule-herbes\",\"title\":\"Taboulé aux herbes et légumes croquants\",\"category\":\"Végétarien\",\"time\":20,\"servings\":4,\"ingredients\":[[\"Semoule\",300,\"g\"],[\"Tomates\",4,\"pièces\"],[\"Concombre\",1,\"pièce\"],[\"Citron\",1,\"pièce\"],[\"Persil\",3,\"c. à soupe\"],[\"Menthe\",2,\"c. à soupe\"],[\"Huile d’olive\",3,\"c. à soupe\"]],\"steps\":[\"Préparer la semoule et la laisser refroidir.\",\"Couper les légumes.\",\"Ajouter les herbes, le citron et l’huile.\",\"Laisser reposer au frais.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"froid\",\"rapide\",\"été\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"salade-pates-pesto\",\"title\":\"Salade de pâtes au pesto et mozzarella\",\"category\":\"Végétarien\",\"time\":25,\"servings\":4,\"ingredients\":[[\"Pâtes courtes\",400,\"g\"],[\"Tomates cerises\",300,\"g\"],[\"Mozzarella\",250,\"g\"],[\"Basilic\",2,\"c. à soupe\"],[\"Pesto\",3,\"c. à soupe\"],[\"Roquette\",100,\"g\"]],\"steps\":[\"Cuire les pâtes et les refroidir.\",\"Couper tomates et mozzarella.\",\"Mélanger avec pesto, basilic et roquette.\",\"Servir frais.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"froid\",\"rapide\",\"été\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"gaspacho-tomate\",\"title\":\"Gaspacho tomate, concombre et basilic\",\"category\":\"Végétarien\",\"time\":15,\"servings\":4,\"ingredients\":[[\"Tomates\",800,\"g\"],[\"Concombre\",1,\"pièce\"],[\"Poivron rouge\",1,\"pièce\"],[\"Ail\",1,\"gousse\"],[\"Basilic\",2,\"c. à soupe\"],[\"Huile d’olive\",2,\"c. à soupe\"]],\"steps\":[\"Couper les légumes.\",\"Mixer avec l’ail, le basilic et l’huile.\",\"Assaisonner.\",\"Réserver au frais avant de servir.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"froid\",\"très rapide\",\"été\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"wraps-legumes-houmous\",\"title\":\"Wraps aux légumes et houmous\",\"category\":\"Végétarien\",\"time\":15,\"servings\":4,\"ingredients\":[[\"Tortillas\",8,\"pièces\"],[\"Houmous\",250,\"g\"],[\"Carottes\",3,\"pièces\"],[\"Concombre\",1,\"pièce\"],[\"Salade verte\",1,\"pièce\"],[\"Menthe\",2,\"c. à soupe\"]],\"steps\":[\"Tailler les légumes en bâtonnets.\",\"Tartiner les tortillas de houmous.\",\"Ajouter légumes, salade et menthe.\",\"Rouler et servir frais.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"froid\",\"rapide\",\"sans viande\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-veloute-de-courgettes-au-basilic\",\"title\":\"Velouté de courgettes au basilic\",\"category\":\"Soupe\",\"time\":30,\"servings\":4,\"ingredients\":[[\"Courgettes\",800,\"g\"],[\"Oignon\",1,\"pièce\"],[\"Bouillon de légumes\",750,\"ml\"],[\"Basilic\",12,\"feuilles\"],[\"Crème\",100,\"ml\"]],\"steps\":[\"Faire revenir l’oignon émincé.\",\"Ajouter les courgettes et le bouillon, puis cuire 20 minutes.\",\"Mixer avec le basilic et la crème.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\",\"été\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-soupe-de-lentilles-corail-au-cumin\",\"title\":\"Soupe de lentilles corail au cumin\",\"category\":\"Soupe\",\"time\":35,\"servings\":4,\"ingredients\":[[\"Lentilles corail\",250,\"g\"],[\"Carottes\",2,\"pièces\"],[\"Oignon\",1,\"pièce\"],[\"Bouillon de légumes\",900,\"ml\"],[\"Cumin\",1,\"c. à café\"]],\"steps\":[\"Faire revenir l’oignon et les carottes.\",\"Ajouter lentilles, cumin et bouillon.\",\"Cuire 25 minutes puis mixer légèrement.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-salade-de-pois-chiches-tomate-et-persil\",\"title\":\"Salade de pois chiches, tomate et persil\",\"category\":\"Salade\",\"time\":20,\"servings\":4,\"ingredients\":[[\"Pois chiches cuits\",500,\"g\"],[\"Tomates\",4,\"pièces\"],[\"Concombre\",1,\"pièce\"],[\"Persil\",1,\"bouquet\"],[\"Citron\",1,\"pièce\"]],\"steps\":[\"Égoutter les pois chiches.\",\"Couper les légumes.\",\"Mélanger avec le persil, le citron et un filet d’huile.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"végétarien\",\"rapide\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-salade-tiede-de-pommes-de-terre-et-haricots-verts\",\"title\":\"Salade tiède de pommes de terre et haricots verts\",\"category\":\"Salade\",\"time\":35,\"servings\":4,\"ingredients\":[[\"Pommes de terre\",800,\"g\"],[\"Haricots verts\",500,\"g\"],[\"Échalote\",1,\"pièce\"],[\"Moutarde\",1,\"c. à soupe\"],[\"Vinaigre\",2,\"c. à soupe\"]],\"steps\":[\"Cuire les pommes de terre et les haricots verts.\",\"Préparer une vinaigrette à la moutarde.\",\"Mélanger encore tiède.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"végétarien\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-taboule-de-quinoa-aux-herbes\",\"title\":\"Taboulé de quinoa aux herbes\",\"category\":\"Salade\",\"time\":25,\"servings\":4,\"ingredients\":[[\"Quinoa\",250,\"g\"],[\"Tomates\",3,\"pièces\"],[\"Concombre\",1,\"pièce\"],[\"Menthe\",12,\"feuilles\"],[\"Persil\",1,\"bouquet\"]],\"steps\":[\"Cuire puis refroidir le quinoa.\",\"Couper les légumes.\",\"Mélanger avec les herbes et assaisonner.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"végétarien\",\"sans gluten\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-gratin-de-chou-fleur-a-la-muscade\",\"title\":\"Gratin de chou-fleur à la muscade\",\"category\":\"Gratins\",\"time\":50,\"servings\":4,\"ingredients\":[[\"Chou-fleur\",1,\"pièce\"],[\"Lait\",500,\"ml\"],[\"Farine\",40,\"g\"],[\"Beurre\",40,\"g\"],[\"Fromage râpé\",120,\"g\"]],\"steps\":[\"Cuire le chou-fleur à la vapeur.\",\"Préparer une béchamel à la muscade.\",\"Napper, parsemer de fromage et gratiner 20 minutes.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-gratin-de-courge-et-chevre\",\"title\":\"Gratin de courge et chèvre\",\"category\":\"Gratins\",\"time\":55,\"servings\":4,\"ingredients\":[[\"Courge\",1000,\"g\"],[\"Fromage de chèvre\",180,\"g\"],[\"Crème\",200,\"ml\"],[\"Thym\",1,\"c. à café\"],[\"Noix\",60,\"g\"]],\"steps\":[\"Précuire la courge en cubes.\",\"Disposer avec chèvre, crème et thym.\",\"Cuire 30 minutes et ajouter les noix.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\",\"automne\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-lasagnes-aux-epinards-et-ricotta\",\"title\":\"Lasagnes aux épinards et ricotta\",\"category\":\"Pâtes\",\"time\":60,\"servings\":4,\"ingredients\":[[\"Feuilles de lasagnes\",12,\"pièces\"],[\"Épinards\",700,\"g\"],[\"Ricotta\",400,\"g\"],[\"Sauce tomate\",500,\"ml\"],[\"Parmesan\",80,\"g\"]],\"steps\":[\"Faire tomber les épinards.\",\"Monter les couches avec ricotta et sauce tomate.\",\"Cuire 35 minutes à 190 °C.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-penne-aux-tomates-roties-et-feta\",\"title\":\"Penne aux tomates rôties et feta\",\"category\":\"Plat principal\",\"time\":35,\"servings\":4,\"ingredients\":[[\"penne\",350,\"g\"],[\"tomate cerise\",500,\"g\"],[\"feta\",200,\"g\"],[\"ail\",2,\"gousse\"],[\"origan\",1,\"c. à café\"]],\"steps\":[\"Rôtir tomates, ail et feta 25 minutes.\",\"Cuire les pâtes.\",\"Mélanger avec la sauce rôtie.\"