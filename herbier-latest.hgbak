,\"title\":\"Cabillaud au four, tomate et olives\",\"category\":\"Poissons\",\"time\":35,\"servings\":4,\"ingredients\":[[\"Filets de cabillaud\",4,\"pièces\"],[\"Tomates\",4,\"pièces\"],[\"Olives\",80,\"g\"],[\"Citron\",1,\"pièce\"],[\"Thym\",1,\"c. à café\"]],\"steps\":[\"Déposer le poisson dans un plat.\",\"Ajouter tomates, olives, citron et thym.\",\"Cuire 20 minutes à 190 °C.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"poisson\"]},{\"id\":\"terrain-saumon-a-l-aneth-et-pommes-vapeur\",\"title\":\"Saumon à l’aneth et pommes vapeur\",\"category\":\"Poissons\",\"time\":35,\"servings\":4,\"ingredients\":[[\"Pavés de saumon\",4,\"pièces\"],[\"Pommes de terre\",800,\"g\"],[\"Aneth\",0.5,\"bouquet\"],[\"Citron\",1,\"pièce\"],[\"Yaourt\",150,\"g\"]],\"steps\":[\"Cuire les pommes de terre à la vapeur.\",\"Cuire le saumon au four 15 minutes.\",\"Servir avec une sauce yaourt, citron et aneth.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"poisson\"]},{\"id\":\"terrain-truite-poelee-aux-amandes\",\"title\":\"Truite poêlée aux amandes\",\"category\":\"Poissons\",\"time\":30,\"servings\":4,\"ingredients\":[[\"Filets de truite\",4,\"pièces\"],[\"Amandes effilées\",60,\"g\"],[\"Citron\",1,\"pièce\"],[\"Beurre\",30,\"g\"],[\"Persil\",0.5,\"bouquet\"]],\"steps\":[\"Dorer les amandes.\",\"Poêler la truite au beurre.\",\"Ajouter citron, persil et amandes.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"poisson\",\"rapide\"]},{\"id\":\"terrain-poulet-aux-legumes-racines\",\"title\":\"Poulet aux légumes racines\",\"category\":\"Volaille\",\"time\":60,\"servings\":4,\"ingredients\":[[\"Cuisses de poulet\",4,\"pièces\"],[\"Carottes\",4,\"pièces\"],[\"Panais\",3,\"pièces\"],[\"Oignon\",2,\"pièces\"],[\"Romarin\",2,\"branches\"]],\"steps\":[\"Couper les légumes.\",\"Disposer avec le poulet et le romarin.\",\"Rôtir 45 minutes à 200 °C.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"viande\"]},{\"id\":\"terrain-emince-de-dinde-a-