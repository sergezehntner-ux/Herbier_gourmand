    "hg-recipes-v26": "[{\"id\":\"poulet-thym\",\"title\":\"Poulet rôti au thym et citron\",\"category\":\"Volaille\",\"time\":75,\"servings\":4,\"temperature\":\"chaud\",\"avecViande\":true,\"ingredients\":[[\"Poulet\",1,\"pièce\"],[\"Pommes de terre\",1000,\"g\"],[\"Citron\",1,\"pièce\"],[\"Ail\",4,\"gousses\"],[\"Thym\",2,\"c. à café\"]],\"steps\":[\"Préchauffer le four à 200 °C.\",\"Ajouter pommes de terre, ail, thym et citron autour du poulet.\",\"Cuire 60 à 75 minutes en arrosant.\"],\"tags\":[\"Poulet\"]},{\"id\":\"boeuf-champi\",\"title\":\"Émincé de bœuf aux champignons\",\"category\":\"Bœuf\",\"time\":30,\"servings\":4,\"ingredients\":[[\"Émincé de bœuf\",500,\"g\"],[\"Champignons\",400,\"g\"],[\"Oignon\",1,\"pièce\"],[\"Crème\",200,\"ml\"],[\"Paprika fumé\",1,\"c. à café\"],[\"Tagliatelles\",400,\"g\"]],\"steps\":[\"Cuire les pâtes.\",\"Saisir le bœuf puis réserver.\",\"Cuire oignon et champignons, ajouter crème et paprika, puis remettre la viande.\"],\"avecViande\":true,\"temperature\":\"chaud\"},{\"id\":\"gratin-courgettes\",\"title\":\"Gratin de courgettes au romarin\",\"category\":\"Végétarien\",\"time\":45,\"servings\":4,\"ingredients\":[[\"Courgettes\",4,\"pièces\"],[\"Oignon\",1,\"pièce\"],[\"Ail\",2,\"gousses\"],[\"Gruyère\",150,\"g\"],[\"Crème\",150,\"ml\"],[\"Romarin\",1,\"c. à café\"]],\"steps\":[\"Faire revenir les légumes.\",\"Ajouter crème, romarin et fromage.\",\"Gratiner 25 minutes à 190 °C.\"],\"avecViande\":false,\"temperature\":\"les-deux\"},{\"id\":\"porc-moutarde\",\"title\":\"Filet mignon de porc à la moutarde ancienne\",\"category\":\"Porc\",\"time\":35,\"servings\":4,\"ingredients\":[[\"Filet mignon\",600,\"g\"],[\"Échalotes\",2,\"pièces\"],[\"Crème\",200,\"ml\"],[\"Moutarde à l’ancienne\",2,\"c. à soupe\"],[\"Estragon\",1,\"c. à café\"],[\"Riz\",300,\"g\"]],\"steps\":[\"Cuire le riz.\",\"Dorer le porc.\",\"Ajouter échalotes, crème, moutarde et estragon.\"],\"avecViande\":true,\"temperature\":\"chaud\"},{\"id\":\"chili\",\"title\":\"Chili con carne doux\",\"category\":\"Bœuf\",\"time\":40,\"servings\":4,\"ingredients\":[[\"Bœuf haché\",500,\"g\"],[\"Haricots rouges\",400,\"g\"],[\"Tomates concassées\",400,\"g\"],[\"Oignon\",1,\"pièce\"],[\"Ail\",2,\"gousses\"],[\"Cumin\",1,\"c. à café\"],[\"Paprika\",1,\"c. à café\"],[\"Riz\",300,\"g\"]],\"steps\":[\"Faire revenir oignon, ail et bœuf.\",\"Ajouter tomates, haricots et épices.\",\"Mijoter 20 minutes et servir avec le riz.\"],\"avecViande\":true,\"temperature\":\"chaud\"},{\"id\":\"agneau\",\"title\":\"Gigot d’agneau au romarin\",\"category\":\"Agneau\",\"time\":90,\"servings\":4,\"ingredients\":[[\"Gigot d’agneau\",1200,\"g\"],[\"Pommes grenaille\",800,\"g\"],[\"Haricots verts\",500,\"g\"],[\"Ail\",4,\"gousses\"],[\"Romarin\",2,\"c. à café\"]],\"steps\":[\"Frotter le gigot avec ail et romarin.\",\"Ajouter les pommes grenaille.\",\"Cuire au four selon la cuisson souhaitée.\"],\"avecViande\":true,\"temperature\":\"chaud\"},{\"id\":\"poulet-creme\",\"title\":\"Poulet à la crème et aux champignons\",\"category\":\"Volaille\",\"time\":40,\"servings\":4,\"ingredients\":[[\"Blancs de poulet\",600,\"g\"],[\"Champignons\",400,\"g\"],[\"Crème\",250,\"ml\"],[\"Moutarde\",1,\"c. à soupe\"],[\"Persil\",2,\"c. à soupe\"],[\"Nouilles\",400,\"g\"]],\"steps\":[\"Cuire les nouilles.\",\"Dorer le poulet.\",\"Ajouter champignons, crème et moutarde, puis le persil.\"],\"avecViande\":true,\"temperature\":\"chaud\"},{\"id\":\"boulettes\",\"title\":\"Boulettes de bœuf, tomate et basilic\",\"category\":\"Bœuf\",\"time\":35,\"servings\":4,\"ingredients\":[[\"Bœuf haché\",500,\"g\"],[\"Tomates concassées\",500,\"g\"],[\"Oignon\",1,\"pièce\"],[\"Basilic\",2,\"c. à soupe\"],[\"Spaghetti\",400,\"g\"]],\"steps\":[\"Former et dorer les boulettes.\",\"Préparer la sauce tomate.\",\"Mijoter 15 minutes avec le basilic.\"],\"avecViande\":true,\"temperature\":\"chaud\"},{\"id\":\"omelette\",\"title\":\"Omelette forestière au persil\",\"category\":\"Œufs\",\"time\":20,\"servings\":2,\"ingredients\":[[\"Œufs\",6,\"pièces\"],[\"Champignons\",250,\"g\"],[\"Échalote\",1,\"pièce\"],[\"Persil\",2,\"c. à soupe\"]],\"steps\":[\"Faire revenir échalote et champignons.\",\"Ajouter les œufs battus.\",\"Cuire doucement et parsemer de persil.\"],\"avecViande\":false,\"temperature\":\"chaud\"},{\"id\":\"curry\",\"title\":\"Poulet au curry doux et lait de coco\",\"category\":\"Volaille\",\"time\":30,\"servings\":4,\"ingredients\":[[\"Blancs de poulet\",600,\"g\"],[\"Lait de coco\",400,\"ml\"],[\"Oignon\",1,\"pièce\"],[\"Curry doux\",2,\"c. à café\"],[\"Carottes\",3,\"pièces\"],[\"Riz\",300,\"g\"]],\"steps\":[\"Cuire le riz.\",\"Faire revenir poulet, oignon et carottes.\",\"Ajouter curry et lait de coco, mijoter 15 minutes.\"],\"avecViande\":true,\"temperature\":\"chaud\"},{\"id\":\"risotto\",\"title\":\"Risotto aux champignons et parmesan\",\"category\":\"Végétarien\",\"time\":35,\"servings\":4,\"ingredients\":[[\"Riz à risotto\",320,\"g\"],[\"Champignons\",400,\"g\"],[\"Bouillon\",1000,\"ml\"],[\"Oignon\",1,\"pièce\"],[\"Parmesan\",80,\"g\"]],\"steps\":[\"Faire revenir oignon et champignons.\",\"Ajouter le riz.\",\"Verser progressivement le bouillon et terminer avec le parmesan.\"],\"avecViande\":false,\"temperature\":\"chaud\"},{\"id\":\"hachis\",\"title\":\"Hachis parmentier maison\",\"category\":\"Bœuf\",\"time\":55,\"servings\":4,\"ingredients\":[[\"Bœuf haché\",500,\"g\"],[\"Pommes de terre\",1000,\"g\"],[\"Carottes\",2,\"pièces\"],[\"Oignon\",1,\"pièce\"],[\"Lait\",200,\"ml\"],[\"Beurre\",40,\"g\"]],\"steps\":[\"Préparer la purée.\",\"Cuire bœuf, carottes et oignon.\",\"Monter le plat et gratiner 20 minutes.\"],\"avecViande\":true,\"temperature\":\"chaud\"},{\"id\":\"quiche\",\"title\":\"Quiche aux poireaux et fromage\",\"category\":\"Végétarien\",\"time\":50,\"servings\":4,\"ingredients\":[[\"Pâte brisée\",1,\"pièce\"],[\"Poireaux\",3,\"pièces\"],[\"Œufs\",3,\"pièces\"],[\"Crème\",200,\"ml\"],[\"Gruyère\",120,\"g\"],[\"Muscade\",1,\"pincée\"]],\"steps\":[\"Faire fondre les poireaux.\",\"Mélanger œufs, crème et fromage.\",\"Garnir la pâte et cuire 35 minutes.\"],\"avecViande\":false,\"temperature\":\"chaud\"},{\"id\":\"dinde\",\"title\":\"Escalopes de dinde au paprika\",\"category\":\"Volaille\",\"time\":25,\"servings\":4,\"ingredients\":[[\"Escalopes de dinde\",600,\"g\"],[\"Paprika\",2,\"c. à café\"],[\"Crème\",150,\"ml\"],[\"Oignon\",1,\"pièce\"],[\"Semoule\",300,\"g\"]],\"steps\":[\"Préparer la semoule.\",\"Dorer les escalopes.\",\"Ajouter oignon, paprika et crème.\"],\"avecViande\":true,\"temperature\":\"chaud\"},{\"id\":\"salade-lentilles-feta\",\"title\":\"Salade de lentilles, carottes et feta\",\"category\":\"Végétarien\",\"time\":30,\"servings\":4,\"ingredients\":[[\"Lentilles vertes\",300,\"g\"],[\"Carottes\",3,\"pièces\"],[\"Feta\",180,\"g\"],[\"Échalote\",1,\"pièce\"],[\"Persil\",2,\"c. à soupe\"],[\"Moutarde\",1,\"c. à soupe\"],[\"Huile d’olive\",3,\"c. à soupe\"]],\"steps\":[\"Cuire les lentilles puis les laisser tiédir.\",\"Couper les carottes finement.\",\"Mélanger avec la feta, l’échalote et le persil.\",\"Assaisonner avec la moutarde et l’huile.\"],\"tags\":[\"froid\",\"végétarien\",\"été\"],\"temperature\":\"froid\",\"avecViande\":false},{\"id\":\"salade-pommes-terre-herbes\",\"title\":\"Salade de pommes de terre aux herbes\",\"category\":\"Œufs\",\"time\":35,\"servings\":4,\"ingredients\":[[\"Pommes de terre\",900,\"g\"],[\"Œufs\",4,\"pièces\"],[\"Cornichons\",100,\"g\"],[\"Ciboulette\",2,\"c. à soupe\"],[\"Persil\",2,\"c. à soupe\"],[\"Moutarde\",1,\"c. à soupe\"],[\"Yaourt nature\",180,\"g\"]],\"steps\":[\"Cuire les pommes de terre et les œufs, puis laisser refroidir.\",\"Couper les ingrédients.\",\"Mélanger yaourt, moutarde et herbes.\",\"Assembler et réserver au frais.\"],\"tags\":[\"froid\",\"sans viande\",\"familial\"],\"temperature\":\"froid\",\"avecViande\":false},{\"id\":\"taboule-herbes\",\"title\":\"Taboulé aux herbes et légumes croquants\",\"category\":\"Végétarien\",\"time\":20,\"servings\":4,\"ingredients\":[[\"Semoule\",300,\"g\"],[\"Tomates\",4,\"pièces\"],[\"Concombre\",1,\"pièce\"],[\"Citron\",1,\"pièce\"],[\"Persil\",3,\"c. à soupe\"],[\"Menthe\",2,\"c. à soupe\"],[\"Huile d’olive\",3,\"c. à soupe\"]],\"steps\":[\"Préparer la semoule et la laisser refroidir.\",\"Couper les légumes.\",\"Ajouter les herbes, le citron et l’huile.\",\"Laisser reposer au frais.\"],\"tags\":[\"froid\",\"rapide\",\"été\"],\"temperature\":\"froid\",\"avecViande\":false},{\"id\":\"salade-pates-pesto\",\"title\":\"Salade de pâtes au pesto et mozzarella\",\"category\":\"Végétarien\",\"time\":25,\"servings\":4,\"ingredients\":[[\"Pâtes courtes\",400,\"g\"],[\"Tomates cerises\",300,\"g\"],[\"Mozzarella\",250,\"g\"],[\"Basilic\",2,\"c. à soupe\"],[\"Pesto\",3,\"c. à soupe\"],[\"Roquette\",100,\"g\"]],\"steps\":[\"Cuire les pâtes et les refroidir.\",\"Couper tomates et mozzarella.\",\"Mélanger avec pesto, basilic et roquette.\",\"Servir frais.\"],\"tags\":[\"froid\",\"rapide\",\"été\"],\"temperature\":\"froid\",\"avecViande\":false},{\"id\":\"gaspacho-tomate\",\"title\":\"Gaspacho tomate, concombre et basilic\",\"category\":\"Végétarien\",\"time\":15,\"servings\":4,\"ingredients\":[[\"Tomates\",800,\"g\"],[\"Concombre\",1,\"pièce\"],[\"Poivron rouge\",1,\"pièce\"],[\"Ail\",1,\"gousse\"],[\"Basilic\",2,\"c. à soupe\"],[\"Huile d’olive\",2,\"c. à soupe\"]],\"steps\":[\"Couper les légumes.\",\"Mixer avec l’ail, le basilic et l’huile.\",\"Assaisonner.\",\"Réserver au frais avant de servir.\"],\"tags\":[\"froid\",\"très rapide\",\"été\"],\"temperature\":\"froid\",\"avecViande\":false},{\"id\":\"wraps-legumes-houmous\",\"title\":\"Wraps aux légumes et houmous\",\"category\":\"Végétarien\",\"time\":15,\"servings\":4,\"ingredients\":[[\"Tortillas\",8,\"pièces\"],[\"Houmous\",250,\"g\"],[\"Carottes\",3,\"pièces\"],[\"Concombre\",1,\"pièce\"],[\"Salade verte\",1,\"pièce\"],[\"Menthe\",2,\"c. à soupe\"]],\"steps\":[\"Tailler les légumes en bâtonnets.\",\"Tartiner les tortillas de houmous.\",\"Ajouter légumes, salade et menthe.\",\"Rouler et servir frais.\"],\"tags\":[\"froid\",\"rapide\",\"sans viande\"],\"temperature\":\"froid\",\"avecViande\":false},{\"id\":\"terrain-veloute-de-courgettes-au-basilic\",\"title\":\"Velouté de courgettes au basilic\",\"category\":\"Soupes\",\"time\":30,\"servings\":4,\"ingredients\":[[\"Courgettes\",800,\"g\"],[\"Oignon\",1,\"pièce\"],[\"Bouillon de légumes\",750,\"ml\"],[\"Basilic\",12,\"feuilles\"],[\"Crème\",100,\"ml\"]],\"steps\":[\"Faire revenir l’oignon émincé.\",\"Ajouter les courgettes et le bouillon, puis cuire 20 minutes.\",\"Mixer avec le basilic et la crème.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\",\"été\"]},{\"id\":\"terrain-soupe-de-lentilles-corail-au-cumin\",\"title\":\"Soupe de lentilles corail au cumin\",\"category\":\"Soupes\",\"time\":35,\"servings\":4,\"ingredients\":[[\"Lentilles corail\",250,\"g\"],[\"Carottes\",2,\"pièces\"],[\"Oignon\",1,\"pièce\"],[\"Bouillon de légumes\",900,\"ml\"],[\"Cumin\",1,\"c. à café\"]],\"steps\":[\"Faire revenir l’oignon et les carottes.\",\"Ajouter lentilles, cumin et bouillon.\",\"Cuire 25 minutes puis mixer légèrement.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"]},{\"id\":\"terrain-salade-de-pois-chiches-tomate-et-persil\",\"title\":\"Salade de pois chiches, tomate et persil\",\"category\":\"Salades\",\"time\":20,\"servings\":4,\"ingredients\":[[\"Pois chiches cuits\",500,\"g\"],[\"Tomates\",4,\"pièces\"],[\"Concombre\",1,\"pièce\"],[\"Persil\",1,\"bouquet\"],[\"Citron\",1,\"pièce\"]],\"steps\":[\"Égoutter les pois chiches.\",\"Couper les légumes.\",\"Mélanger avec le persil, le citron et un filet d’huile.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"végétarien\",\"rapide\"]},{\"id\":\"terrain-salade-tiede-de-pommes-de-terre-et-haricots-verts\",\"title\":\"Salade tiède de pommes de terre et haricots verts\",\"category\":\"Salades\",\"time\":35,\"servings\":4,\"ingredients\":[[\"Pommes de terre\",800,\"g\"],[\"Haricots verts\",500,\"g\"],[\"Échalote\",1,\"pièce\"],[\"Moutarde\",1,\"c. à soupe\"],[\"Vinaigre\",2,\"c. à soupe\"]],\"steps\":[\"Cuire les pommes de terre et les haricots verts.\",\"Préparer une vinaigrette à la moutarde.\",\"Mélanger encore tiède.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"végétarien\"]},{\"id\":\"terrain-taboule-de-quinoa-aux-herbes\",\"title\":\"Taboulé de quinoa aux herbes\",\"category\":\"Salades\",\"time\":25,\"servings\":4,\"ingredients\":[[\"Quinoa\",250,\"g\"],[\"Tomates\",3,\"pièces\"],[\"Concombre\",1,\"pièce\"],[\"Menthe\",12,\"feuilles\"],[\"Persil\",1,\"bouquet\"]],\"steps\":[\"Cuire puis refroidir le quinoa.\",\"Couper les légumes.\",\"Mélanger avec les herbes et assaisonner.\"],\"avecViande\":false,\"temperature\":\"froid\",\"tags\":[\"végétarien\",\"sans gluten\"]},{\"id\":\"terrain-gratin-de-chou-fleur-a-la-muscade\",\"title\":\"Gratin de chou-fleur à la muscade\",\"category\":\"Gratins\",\"time\":50,\"servings\":4,\"ingredients\":[[\"Chou-fleur\",1,\"pièce\"],[\"Lait\",500,\"ml\"],[\"Farine\",40,\"g\"],[\"Beurre\",40,\"g\"],[\"Fromage râpé\",120,\"g\"]],\"steps\":[\"Cuire le chou-fleur à la vapeur.\",\"Préparer une béchamel à la muscade.\",\"Napper, parsemer de fromage et gratiner 20 minutes.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"]},{\"id\":\"terrain-gratin-de-courge-et-chevre\",\"title\":\"Gratin de courge et chèvre\",\"category\":\"Gratins\",\"time\":55,\"servings\":4,\"ingredients\":[[\"Courge\",1000,\"g\"],[\"Fromage de chèvre\",180,\"g\"],[\"Crème\",200,\"ml\"],[\"Thym\",1,\"c. à café\"],[\"Noix\",60,\"g\"]],\"steps\":[\"Précuire la courge en cubes.\",\"Disposer avec chèvre, crème et thym.\",\"Cuire 30 minutes et ajouter les noix.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\",\"automne\"]},{\"id\":\"terrain-lasagnes-aux-epinards-et-ricotta\",\"title\":\"Lasagnes aux épinards et ricotta\",\"category\":\"Pâtes\",\"time\":60,\"servings\":4,\"ingredients\":[[\"Feuilles de lasagnes\",12,\"pièces\"],[\"Épinards\",700,\"g\"],[\"Ricotta\",400,\"g\"],[\"Sauce tomate\",500,\"ml\"],[\"Parmesan\",80,\"g\"]],\"steps\":[\"Faire tomber les épinards.\",\"Monter les couches avec ricotta et sauce tomate.\",\"Cuire 35 minutes à 190 °C.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"]},{\"id\":\"terrain-penne-aux-tomates-roties-et-feta\",\"title\":\"Penne aux tomates rôties et feta\",\"category\":\"Pâtes\",\"time\":35,\"servings\":4,\"ingredients\":[[\"Penne\",350,\"g\"],[\"Tomates cerises\",500,\"g\"],[\"Feta\",200,\"g\"],[\"Ail\",2,\"gousses\"],[\"Origan\",1,\"c. à café\"]],\"steps\":[\"Rôtir tomates, ail et feta 25 minutes.\",\"Cuire les pâtes.\",\"Mélanger avec la sauce rôtie.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\",\"rapide\"]},{\"id\":\"terrain-spaghetti-aux-poireaux-et-citron\",\"title\":\"Spaghetti aux poireaux et citron\",\"category\":\"Pâtes\",\"time\":30,\"servings\":4,\"ingredients\":[[\"Spaghetti\",350,\"g\"],[\"Poireaux\",3,\"pièces\"],[\"Citron\",1,\"pièce\"],[\"Crème\",150,\"ml\"],[\"Parmesan\",60,\"g\"]],\"steps\":[\"Faire fondre les poireaux.\",\"Cuire les spaghetti.\",\"Ajouter crème, zeste de citron et parmesan.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"]},{\"id\":\"terrain-risotto-aux-champignons\",\"title\":\"Risotto aux champignons\",\"category\":\"Riz\",\"time\":40,\"servings\":4,\"ingredients\":[[\"Riz arborio\",320,\"g\"],[\"Champignons\",500,\"g\"],[\"Bouillon de légumes\",1000,\"ml\"],[\"Oignon\",1,\"pièce\"],[\"Parmesan\",80,\"g\"]],\"steps\":[\"Faire revenir oignon et champignons.\",\"Ajouter le riz puis le bouillon progressivement.\",\"Terminer avec le parmesan.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"]},{\"id\":\"terrain-riz-saute-aux-legumes-et-ufs\",\"title\":\"Riz sauté aux légumes et œufs\",\"category\":\"Riz\",\"time\":25,\"servings\":4,\"ingredients\":[[\"Riz cuit\",600,\"g\"],[\"Carottes\",2,\"pièces\"],[\"Petits pois\",200,\"g\"],[\"Œufs\",4,\"pièces\"],[\"Sauce soja\",2,\"c. à soupe\"]],\"steps\":[\"Faire sauter les légumes.\",\"Ajouter le riz et la sauce soja.\",\"Pousser sur le côté et brouiller les œufs avant de mélanger.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"rapide\"]},{\"id\":\"terrain-curry-de-pois-chiches-et-epinards\",\"title\":\"Curry de pois chiches et épinards\",\"category\":\"Currys\",\"time\":35,\"servings\":4,\"ingredients\":[[\"Pois chiches cuits\",500,\"g\"],[\"Épinards\",400,\"g\"],[\"Lait de coco\",400,\"ml\"],[\"Tomates concassées\",400,\"g\"],[\"Curry\",2,\"c. à café\"]],\"steps\":[\"Faire revenir les épices.\",\"Ajouter tomates, pois chiches et lait de coco.\",\"Mijoter 20 minutes puis incorporer les épinards.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"]},{\"id\":\"terrain-curry-de-patate-douce-et-lentilles\",\"title\":\"Curry de patate douce et lentilles\",\"category\":\"Currys\",\"time\":40,\"servings\":4,\"ingredients\":[[\"Patates douces\",700,\"g\"],[\"Lentilles corail\",220,\"g\"],[\"Lait de coco\",400,\"ml\"],[\"Bouillon de légumes\",500,\"ml\"],[\"Curry\",2,\"c. à café\"]],\"steps\":[\"Faire revenir le curry.\",\"Ajouter tous les ingrédients.\",\"Mijoter 30 minutes.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"]},{\"id\":\"terrain-dahl-de-lentilles-au-gingembre\",\"title\":\"Dahl de lentilles au gingembre\",\"category\":\"Currys\",\"time\":35,\"servings\":4,\"ingredients\":[[\"Lentilles corail\",300,\"g\"],[\"Tomates concassées\",400,\"g\"],[\"Lait de coco\",300,\"ml\"],[\"Gingembre\",20,\"g\"],[\"Curcuma\",1,\"c. à café\"]],\"steps\":[\"Faire revenir gingembre et épices.\",\"Ajouter lentilles, tomates et lait de coco.\",\"Cuire doucement 25 minutes.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"]},{\"id\":\"terrain-galettes-de-courge