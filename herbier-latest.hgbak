    "hg-herbs-spices-v28": "[{\"id\":\"persil-plat\",\"name\":\"Persil plat\",\"family\":\"Herbe aromatique\",\"origin\":\"Europe, Méditerranée ou Asie\",\"forms\":\"fraîche ou séchée\",\"whereToBuy\":\"supermarchés\",\"season\":\"printemps\",\"flavor\":\"frais, végétal, légèrement poivré\",\"intensity\":\"douce\",\"uses\":\"taboulé, persillade, sauces froides\",\"idealFoods\":\"poisson, pommes de terre, œufs, lentilles\",\"recommendedPairings\":\"ail, citron, huile d'olive\",\"cookingBehavior\":\"ajouter en fin de cuisson\",\"preparation\":\"haché, ciselé ou pesto\",\"quantity\":\"1–3 c. à soupe fraîche ou 1 c. à café sèche\",\"worldCuisines\":\"méditerranéenne, européenne, asiatique\",\"substitution\":\"coriandre fraîche ou cerfeuil\",\"avoid\":\"cuisson excessive qui détruit le parfum\",\"recipeIdeas\":\"persillade, taboulé, sauce verte\",\"dishTypes\":\"salé\",\"infusion\":\"oui\",\"marinade\":\"oui\",\"conservation\":\"réfrigérateur, congélation ou séchage\",\"chefTip\":\"goûter progressivement et ajuster l’intensité en fin de préparation\"},{\"id\":\"persil-frise\",\"name\":\"Persil frisé\",\"family\":\"Herbe aromatique\",\"origin\":\"Europe, Méditerranée ou Asie\",\"forms\":\"fraîche ou séchée\",\"whereToBuy\":\"magasins bio\",\"season\":\"été\",\"flavor\":\"frais, herbacé\",\"intensity\":\"moyenne\",\"uses\":\"salades, sauces, garnitures\",\"idealFoods\":\"légumes, œufs, poisson\",\"recommendedPairings\":\"citron, huile d'olive, ail\",\"cookingBehavior\":\"ajouter plutôt en fin de cuisson\",\"preparation\":\"ciselé, haché, pesto ou infusion\",\"quantity\":\"1–3 c. à soupe fraîche ou 1 c. à café sèche\",\"worldCuisines\":\"méditerranéenne, européenne, asiatique\",\"substitution\":\"persil, basilic ou herbe voisine\",\"avoid\":\"cuisson excessive qui détruit le parfum\",\"recipeIdeas\":\"sauce verte, salade, beurre composé\",\"dishTypes\":\"salé\",\"infusion\":\"oui\",\"marinade\":\"oui\",\"conservation\":\"réfrigérateur, congélation ou séchage\",\"chefTip\":\