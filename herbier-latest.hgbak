ings\":4,\"ingredients\":[[\"Haricots blancs cuits\",600,\"g\"],[\"Tomates concassées\",500,\"g\"],[\"Oignon\",1,\"pièce\"],[\"Sauge\",8,\"feuilles\"],[\"Ail\",2,\"gousses\"]],\"steps\":[\"Faire revenir oignon, ail et sauge.\",\"Ajouter tomates et haricots.\",\"Mijoter 25 minutes.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"]},{\"id\":\"terrain-chili-sin-carne\",\"title\":\"Chili sin carne\",\"category\":\"Légumineuses\",\"time\":40,\"servings\":4,\"ingredients\":[[\"Haricots rouges cuits\",500,\"g\"],[\"Maïs\",200,\"g\"],[\"Tomates concassées\",500,\"g\"],[\"Poivron\",1,\"pièce\"],[\"Cumin\",1,\"c. à café\"]],\"steps\":[\"Faire revenir oignon et poivron.\",\"Ajouter tomates, haricots, maïs et épices.\",\"Mijoter 25 minutes.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"]},{\"id\":\"terrain-lentilles-vertes-aux-carottes\",\"title\":\"Lentilles vertes aux carottes\",\"category\":\"Légumineuses\",\"time\":45,\"servings\":4,\"ingredients\":[[\"Lentilles vertes\",320,\"g\"],[\"Carottes\",4,\"pièces\"],[\"Poireau\",1,\"pièce\"],[\"Oignon\",1,\"pièce\"],[\"Laurier\",2,\"feuilles\"]],\"steps\":[\"Faire revenir les légumes.\",\"Ajouter lentilles, laurier et eau.\",\"Cuire 35 minutes.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"]},{\"id\":\"terrain-croque-monsieur-aux-epinards\",\"title\":\"Croque-monsieur aux épinards\",\"category\":\"Repas rapides\",\"time\":20,\"servings\":4,\"ingredients\":[[\"Pain de mie\",8,\"tranches\"],[\"Épinards\",250,\"g\"],[\"Fromage\",160,\"g\"],[\"Moutarde\",2,\"c. à soupe\"],[\"Beurre\",20,\"g\"]],\"steps\":[\"Faire tomber les épinards.\",\"Monter les croques avec moutarde et fromage.\",\"Dorer à la poêle ou au four.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\",\"rapide\"]},{\"id\":\"terrain-bruschettas-tomates-et-mozzarella\",\"title\":\"Bruschettas tomates et mozzarella\",\"category\":\"Repas rapides\",\"time\":20,\"servings\":4,\"ingredients\":[[\"Pain de campagne\",8,\"tranches\"],[\"Tomates\",5,\"pièces\"],[\"Mozzarella\",250,\"g\"],[\"Basilic\",12,\"feuilles\"],[\"Ail\",1,\"gousse\"]],\"steps\":[\"Griller le pain et le frotter à l’ail.\",\"Ajouter tomates et mozzarella.\",\"Passer 5 minutes au four et parsemer de basilic.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\",\"rapide\"]},{\"id\":\"terrain-wraps-de-legumes-grilles\",\"title\":\"Wraps de légumes grillés\",\"category\":\"Repas rapides\",\"time\":30,\"servings\":4,\"ingredients\":[[\"Tortillas\",8,\"pièces\"],[\"Courgette\",1,\"pièce\"],[\"Poivron\",1,\"pièce\"],[\"Houmous\",250,\"g\"],[\"Salade\",150,\"g\"]],\"steps\":[\"Griller les légumes.\",\"Tartiner les tortillas de houmous.\",\"Ajouter légumes et salade puis rouler.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"végétarien\"]},{\"id\":\"terrain-pommes-de-terre-au-four-fromage-blanc-et-ciboulette\",\"title\":\"Pommes de terre au four, fromage blanc et ciboulette\",\"category\":\"Repas rapides\",\"time\":50,\"servings\":4,\"ingredients\":[[\"Pommes de terre\",4,\"grosses\"],[\"Fromage blanc\",300,\"g\"],[\"Ciboulette\",0.5,\"bouquet\"],[\"Ail\",1,\"gousse\"],[\"Salade verte\",1,\"pièce\"]],\"steps\":[\"Cuire les pommes de terre 45 minutes au four.\",\"Mélanger fromage blanc, ail et ciboulette.\",\"Ouvrir les pommes de terre et garnir.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"]},{\"id\":\"terrain-gnocchis-poeles-aux-petits-pois\",\"title\":\"Gnocchis poêlés aux petits pois\",\"category\":\"Pâtes\",\"time\":25,\"servings\":4,\"ingredients\":[[\"Gnocchis\",600,\"g\"],[\"Petits pois\",250,\"g\"],[\"Crème\",150,\"ml\"],[\"Parmesan\",60,\"g\"],[\"Menthe\",8,\"feuilles\"]],\"steps\":[\"Dorer les gnocchis.\",\"Ajouter petits pois et crème.\",\"Terminer avec parmesan et menthe.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\",\"rapide\"]},{\"id\":\"terrain-orge-perle-aux-poirea