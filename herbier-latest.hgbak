\"]},{\"id\":\"terrain-ratatouille-au-four\",\"title\":\"Ratatouille au four\",\"category\":\"Légumes\",\"time\":55,\"servings\":4,\"ingredients\":[[\"Aubergines\",2,\"pièces\"],[\"Courgettes\",2,\"pièces\"],[\"Poivrons\",2,\"pièces\"],[\"Tomates\",5,\"pièces\"],[\"Herbes de Provence\",2,\"c. à café\"]],\"steps\":[\"Couper tous les légumes.\",\"Mélanger avec huile et herbes.\",\"Rôtir 45 minutes en remuant une fois.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\",\"été\"]},{\"id\":\"terrain-courge-rotie-lentilles-et-feta\",\"title\":\"Courge rôtie, lentilles et feta\",\"category\":\"Légumineuses\",\"time\":50,\"servings\":4,\"ingredients\":[[\"Courge\",900,\"g\"],[\"Lentilles vertes\",250,\"g\"],[\"Feta\",180,\"g\"],[\"Roquette\",120,\"g\"],[\"Cumin\",1,\"c. à café\"]],\"steps\":[\"Rôtir la courge au cumin.\",\"Cuire les lentilles.\",\"Assembler avec feta et roquette.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"végétarien\"]},{\"id\":\"terrain-minestrone-de-saison\",\"title\":\"Minestrone de saison\",\"category\":\"Soupes\",\"time\":45,\"servings\":4,\"ingredients\":[[\"Haricots blancs cuits\",300,\"g\"],[\"Carottes\",3,\"pièces\"],[\"Courgette\",1,\"pièce\"],[\"Tomates concassées\",400,\"g\"],[\"Petites pâtes\",120,\"g\"]],\"steps\":[\"Faire revenir les légumes.\",\"Ajouter tomates, eau et haricots.\",\"Cuire 25 minutes puis ajouter les pâtes.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"]}]",
