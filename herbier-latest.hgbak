:[\"modifié\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-fenouil-braise-a-l-orange\",\"title\":\"Fenouil braisé à l’orange\",\"category\":\"Légumes\",\"time\":40,\"servings\":4,\"ingredients\":[[\"Fenouils\",4,\"pièces\"],[\"Orange\",2,\"pièces\"],[\"Bouillon de légumes\",200,\"ml\"],[\"Thym\",1,\"c. à café\"],[\"Olives\",60,\"g\"]],\"steps\":[\"Dorer le fenouil.\",\"Ajouter jus d’orange et bouillon.\",\"Braiser 25 minutes puis ajouter les olives.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-poireaux-vinaigrette-et-ufs-mollets\",\"title\":\"Poireaux vinaigrette et œufs mollets\",\"category\":\"Salade\",\"time\":30,\"servings\":4,\"ingredients\":[[\"Poireaux\",6,\"pièces\"],[\"Œufs\",4,\"pièces\"],[\"Moutarde\",1,\"c. à soupe\"],[\"Vinaigre\",2,\"c. à soupe\"],[\"Ciboulette\",0.5,\"bouquet\"]],\"steps\":[\"Cuire les poireaux à la vapeur.\",\"Cuire les œufs mollets 6 minutes.\",\"Servir avec vinaigrette et ciboulette.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"végétarien\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-ratatouille-au-four\",\"title\":\"Ratatouille au four\",\"category\":\"Légumes\",\"time\":55,\"servings\":4,\"ingredients\":[[\"Aubergines\",2,\"pièces\"],[\"Courgettes\",2,\"pièces\"],[\"Poivrons\",2,\"pièces\"],[\"Tomates\",5,\"pièces\"],[\"Herbes de Provence\",2,\"c. à café\"]],\"steps\":[\"Couper tous les légumes.\",\"Mélanger avec huile et herbes.\",\"Rôtir 45 minutes en remuant une fois.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\",\"été\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-courge-rotie-lentilles-et-feta\",\"title\":\"Courge rôtie, lentilles et feta\",\"category\":\"Légumineuses\",\"time\":50,\"servings\":4,\"ingredients\":[[\"Courge\",900,\"g\"],[\"Lentilles vertes\",250,\"g\"],[\"Feta\",180,\"g\"],[\"Roquette\",120,\"g\"],[\"Cumin\",1,\"c. à café\"]],\"steps\":[\"Rôtir la courge au cumin.\",\"Cuire les lentilles.\",\"Assembler avec feta et roquette.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"végétarien\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-minestrone-de-saison\",\"title\":\"Minestrone de saison\",\"category\":\"Soupe\",\"time\":45,\"servings\":4,\"ingredients\":[[\"Haricots blancs cuits\",300,\"g\"],[\"Carottes\",3,\"pièces\"],[\"Courgette\",1,\"pièce\"],[\"Tomates concassées\",400,\"g\"],[\"Petites pâtes\",120,\"g\"]],\"steps\":[\"Faire revenir les légumes.\",\"Ajouter tomates, eau et haricots.\",\"Cuire 25 minutes puis ajouter les pâtes.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"}]",
