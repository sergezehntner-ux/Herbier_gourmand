"Épinards\",400,\"g\"],[\"Lait de coco\",400,\"ml\"],[\"Tomates concassées\",400,\"g\"],[\"Curry\",2,\"c. à café\"]],\"steps\":[\"Faire revenir les épices.\",\"Ajouter tomates, pois chiches et lait de coco.\",\"Mijoter 20 minutes puis incorporer les épinards.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-curry-de-patate-douce-et-lentilles\",\"title\":\"Curry de patate douce et lentilles\",\"category\":\"Currys\",\"time\":40,\"servings\":4,\"ingredients\":[[\"Patates douces\",700,\"g\"],[\"Lentilles corail\",220,\"g\"],[\"Lait de coco\",400,\"ml\"],[\"Bouillon de légumes\",500,\"ml\"],[\"Curry\",2,\"c. à café\"]],\"steps\":[\"Faire revenir le curry.\",\"Ajouter tous les ingrédients.\",\"Mijoter 30 minutes.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-dahl-de-lentilles-au-gingembre\",\"title\":\"Dahl de lentilles au gingembre\",\"category\":\"Currys\",\"time\":35,\"servings\":4,\"ingredients\":[[\"Lentilles corail\",300,\"g\"],[\"Tomates concassées\",400,\"g\"],[\"Lait de coco\",300,\"ml\"],[\"Gingembre\",20,\"g\"],[\"Curcuma\",1,\"c. à café\"]],\"steps\":[\"Faire revenir gingembre et épices.\",\"Ajouter lentilles, tomates et lait de coco.\",\"Cuire doucement 25 minutes.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-galettes-de-courgettes-au-fromage\",\"title\":\"Galettes de courgettes au fromage\",\"category\":\"Plat principal\",\"time\":30,\"servings\":4,\"ingredients\":[[\"courgette\",700,\"g\"],[\"œuf\",2,\"u\"],[\"farine\",80,\"g\"],[\"fromage râpé\",100,\"g\"],[\"persil\",0.5,\"bouquet\"]],\"steps\":[\"Râper et essorer les courgettes.\",\"Mélanger tous les ingrédients.\",\"Cuire les galettes à la poêle.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"modifié\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-aubergines-roties-au-yaourt-citronne\",\"title\":\"Aubergines rôties au yaourt citronné\",\"category\":\"Plat principal\",\"time\":45,\"servings\":4,\"ingredients\":[[\"aubergine\",3,\"u\"],[\"yaourt grec\",250,\"g\"],[\"citron\",1,\"u\"],[\"ail\",1,\"gousse\"],[\"persil plat\",0.5,\"bouquet\"]],\"steps\":[\"Rôtir les aubergines 35 minutes.\",\"Mélanger yaourt, citron et ail.\",\"Servir avec le persil plat grossièrement haché.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"modifié\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-poivrons-farcis-au-quinoa\",\"title\":\"Poivrons farcis au quinoa\",\"category\":\"Légumes\",\"time\":55,\"servings\":4,\"ingredients\":[[\"Poivrons\",4,\"pièces\"],[\"Quinoa\",220,\"g\"],[\"Tomates concassées\",300,\"g\"],[\"Maïs\",150,\"g\"],[\"Fromage râpé\",100,\"g\"]],\"steps\":[\"Cuire le quinoa.\",\"Mélanger avec tomates et maïs.\",\"Farcir les poivrons et cuire 35 minutes.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-tarte-aux-poireaux-et-moutarde\",\"title\":\"Tarte aux poireaux et moutarde\",\"category\":\"Tartes\",\"time\":50,\"servings\":4,\"ingredients\":[[\"Pâte brisée\",1,\"pièce\"],[\"Poireaux\",4,\"pièces\"],[\"Œufs\",3,\"pièces\"],[\"Crème\",200,\"ml\"],[\"Moutarde\",2,\"c. à soupe\"]],\"steps\":[\"Faire fondre les poireaux.\",\"Étaler la moutarde sur la pâte.\",\"Ajouter l’appareil et cuire 35 minutes.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-quiche-aux-courgettes-et-chevre\",\"title\":\"Quiche aux courgettes et chèvre\",\"category\":\"Tartes\",\"time\":50,\"servings\":4,\"ingredients\":[[\"Pâte brisée\",1,\"pièce\"],[\"Courgettes\",2,\"pièces\"],[\"Fromage de chèvre\",180,\"g\"],[\"Œufs\",3,\"pièces\"],[\"Crème\",200,\"ml\"]],\"steps\":[\"Poêler les courgettes.\",\"Répartir sur la pâte avec le chèvre.\",\"Verser l’appareil et cuire 35 minutes.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-omelette-aux-fines-herbes\",\"title\":\"Omelette aux fines herbes\",\"category\":\"Œufs\",\"time\":15,\"servings\":4,\"ingredients\":[[\"Œufs\",8,\"pièces\"],[\"Ciboulette\",0.5,\"bouquet\"],[\"Persil\",0.5,\"bouquet\"],[\"Beurre\",20,\"g\"],[\"Fromage râpé\",60,\"g\"]],\"steps\":[\"Battre les œufs avec les herbes.\",\"Cuire doucement au beurre.\",\"Ajouter le fromage et plier.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"rapide\",\"végétarien\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-frittata-aux-pommes-de-terre-et-epinards\",\"title\":\"Frittata aux pommes de terre et épinards\",\"category\":\"Œufs\",\"time\":35,\"servings\":4,\"ingredients\":[[\"Œufs\",8,\"pièces\"],[\"Pommes de terre\",500,\"g\"],[\"Épinards\",250,\"g\"],[\"Oignon\",1,\"pièce\"],[\"Feta\",100,\"g\"]],\"steps\":[\"Cuire les pommes de terre en dés.\",\"Ajouter oignon et épinards.\",\"Verser les œufs et finir au four.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-ufs-cocotte-aux-champignons\",\"title\":\"Œufs cocotte aux champignons\",\"category\":\"Œufs\",\"time\":25,\"servings\":4,\"ingredients\":[[\"Œufs\",4,\"pièces\"],[\"Champignons\",300,\"g\"],[\"Crème\",160,\"ml\"],[\"Échalote\",1,\"pièce\"],[\"Ciboulette\",0.5,\"bouquet\"]],\"steps\":[\"Poêler champignons et échalote.\",\"Répartir dans des ramequins avec la crème.\",\"Ajouter les œufs et cuire au bain-marie.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-cabillaud-au-four-tomate-et-olives\",\"title\":\"Cabillaud au four, tomate et olives\",\"category\":\"Poissons\",\"time\":35,\"servings\":4,\"ingredients\":[[\"Filets de cabillaud\",4,\"pièces\"],[\"Tomates\",4,\"pièces\"],[\"Olives\",80,\"g\"],[\"Citron\",1,\"pièce\"],[\"Thym\",1,\"c. à café\"]],\"steps\":[\"Déposer le poisson dans un plat.\",\"Ajouter tomates, olives, citron et thym.\",\"Cuire 20 minutes à 190 °C.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"poisson\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-saumon-a-l-aneth-et-pommes-vapeur\",\"title\":\"Saumon à l’aneth et pommes vapeur\",\"category\":\"Poissons\",\"time\":35,\"servings\":4,\"ingredients\":[[\"Pavés de saumon\",4,\"pièces\"],[\"Pommes de terre\",800,\"g\"],[\"Aneth\",0.5,\"bouquet\"],[\"Citron\",1,\"pièce\"],[\"Yaourt\",150,\"g\"]],\"steps\":[\"Cuire les pommes de terre à la vapeur.\",\"Cuire le saumon au four 15 minutes.\",\"Servir avec une sauce yaourt, citron et aneth.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"poisson\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-truite-poelee-aux-amandes\",\"title\":\"Truite poêlée aux amandes\",\"category\":\"Poissons\",\"time\":30,\"servings\":4,\"ingredients\":[[\"Filets de truite\",4,\"pièces\"],[\"Amandes effilées\",60,\"g\"],[\"Citron\",1,\"pièce\"],[\"Beurre\",30,\"g\"],[\"Persil\",0.5,\"bouquet\"]],\"steps\":[\"Dorer les amandes.\",\"Poêler la truite au beurre.\",\"Ajouter citron, persil et amandes.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"poisson\",\"rapide\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-poulet-aux-legumes-racines\",\"title\":\"Poulet aux légumes racines\",\"category\":\"Volaille\",\"time\":60,\"servings\":4,\"ingredients\":[[\"Cuisses de poulet\",4,\"pièces\"],[\"Carottes\",4,\"pièces\"],[\"Panais\",3,\"pièces\"],[\"Oignon\",2,\"pièces\"],[\"Romarin\",2,\"branches\"]],\"steps\":[\"Couper les légumes.\",\"Disposer avec le poulet et le romarin.\",\"Rôtir 45 minutes à 200 °C.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"viande\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-emince-de-dinde-a-la-moutarde\",\"title\":\"Émincé de dinde à la moutarde\",\"category\":\"Volaille\",\"time\":30,\"servings\":4,\"ingredients\":[[\"Escalopes de dinde\",600,\"g\"],[\"Champignons\",300,\"g\"],[\"Crème\",200,\"ml\"],[\"Moutarde\",2,\"c. à soupe\"],[\"Échalote\",1,\"pièce\"]],\"steps\":[\"Saisir la dinde en lanières.\",\"Ajouter échalote et champignons.\",\"Incorporer crème et moutarde puis mijoter 10 minutes.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"viande\",\"rapide\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-poulet-basquaise-simplifie\",\"title\":\"Poulet basquaise simplifié\",\"category\":\"Volaille\",\"time\":50,\"servings\":4,\"ingredients\":[[\"Poulet\",800,\"g\"],[\"Poivrons\",3,\"pièces\"],[\"Tomates concassées\",500,\"g\"],[\"Oignon\",1,\"pièce\"],[\"Paprika\",1,\"c. à café\"]],\"steps\":[\"Dorer le poulet.\",\"Ajouter oignon et poivrons.\",\"Verser les tomates et mijoter 35 minutes.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"viande\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-boulettes-de-b-uf-a-la-tomate\",\"title\":\"Boulettes de bœuf à la tomate\",\"category\":\"Viandes\",\"time\":45,\"servings\":4,\"ingredients\":[[\"Bœuf haché\",600,\"g\"],[\"Œuf\",1,\"pièce\"],[\"Chapelure\",60,\"g\"],[\"Sauce tomate\",600,\"ml\"],[\"Persil\",0.5,\"bouquet\"]],\"steps\":[\"Former les boulettes.\",\"Les dorer à la poêle.\",\"Ajouter la sauce tomate et mijoter 25 minutes.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"viande\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-saute-de-porc-aux-pommes\",\"title\":\"Sauté de porc aux pommes\",\"category\":\"Viandes\",\"time\":45,\"servings\":4,\"ingredients\":[[\"Échine de porc\",700,\"g\"],[\"Pommes\",3,\"pièces\"],[\"Oignon\",1,\"pièce\"],[\"Cidre\",250,\"ml\"],[\"Thym\",1,\"c. à café\"]],\"steps\":[\"Dorer le porc.\",\"Ajouter oignon et pommes.\",\"Verser le cidre et mijoter 30 minutes.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"viande\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-b-uf-aux-carottes-rapide\",\"title\":\"Bœuf aux carottes rapide\",\"category\":\"Viandes\",\"time\":60,\"servings\":4,\"ingredients\":[[\"Bœuf à mijoter\",800,\"g\"],[\"Carottes\",700,\"g\"],[\"Oignon\",2,\"pièces\"],[\"Bouillon\",500,\"ml\"],[\"Thym\",2,\"branches\"]],\"steps\":[\"Dorer le bœuf.\",\"Ajouter oignons et carottes.\",\"Verser le bouillon et mijoter 45 minutes.\"],\"avecViande\":true,\"temperature\":\"chaud\",\"tags\":[\"viande\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-couscous-de-legumes\",\"title\":\"Couscous de légumes\",\"category\":\"Semoule\",\"time\":50,\"servings\":4,\"ingredients\":[[\"Semoule\",320,\"g\"],[\"Courgettes\",2,\"pièces\"],[\"Carottes\",4,\"pièces\"],[\"Pois chiches cuits\",400,\"g\"],[\"Bouillon de légumes\",700,\"ml\"]],\"steps\":[\"Faire mijoter les légumes dans le bouillon épicé.\",\"Ajouter les pois chiches.\",\"Préparer la semoule et servir ensemble.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-boulgour-aux-legumes-rotis\",\"title\":\"Boulgour aux légumes rôtis\",\"category\":\"Céréales\",\"time\":40,\"servings\":4,\"ingredients\":[[\"Boulgour\",300,\"g\"],[\"Courgettes\",2,\"pièces\"],[\"Poivrons\",2,\"pièces\"],[\"Oignon rouge\",1,\"pièce\"],[\"Feta\",150,\"g\"]],\"steps\":[\"Rôtir les légumes 30 minutes.\",\"Cuire le boulgour.\",\"Mélanger avec la feta.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-polenta-cremeuse-aux-champignons\",\"title\":\"Polenta crémeuse aux champignons\",\"category\":\"Céréales\",\"time\":35,\"servings\":4,\"ingredients\":[[\"Polenta\",250,\"g\"],[\"Lait\",700,\"ml\"],[\"Champignons\",500,\"g\"],[\"Parmesan\",80,\"g\"],[\"Ail\",1,\"gousse\"]],\"steps\":[\"Cuire la polenta dans le lait.\",\"Poêler les champignons avec l’ail.\",\"Ajouter le parmesan et servir.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-haricots-blancs-a-la-tomate-et-sauge\",\"title\":\"Haricots blancs à la tomate et sauge\",\"category\":\"Légumineuses\",\"time\":40,\"servings\":4,\"ingredients\":[[\"Haricots blancs cuits\",600,\"g\"],[\"Tomates concassées\",500,\"g\"],[\"Oignon\",1,\"pièce\"],[\"Sauge\",8,\"feuilles\"],[\"Ail\",2,\"gousses\"]],\"steps\":[\"Faire revenir oignon, ail et sauge.\",\"Ajouter tomates et haricots.\",\"Mijoter 25 minutes.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-chili-sin-carne\",\"title\":\"Chili sin carne\",\"category\":\"Légumineuses\",\"time\":40,\"servings\":4,\"ingredients\":[[\"Haricots rouges cuits\",500,\"g\"],[\"Maïs\",200,\"g\"],[\"Tomates concassées\",500,\"g\"],[\"Poivron\",1,\"pièce\"],[\"Cumin\",1,\"c. à café\"]],\"steps\":[\"Faire revenir oignon et poivron.\",\"Ajouter tomates, haricots, maïs et épices.\",\"Mijoter 25 minutes.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-lentilles-vertes-aux-carottes\",\"title\":\"Lentilles vertes aux carottes\",\"category\":\"Légumineuses\",\"time\":45,\"servings\":4,\"ingredients\":[[\"Lentilles vertes\",320,\"g\"],[\"Carottes\",4,\"pièces\"],[\"Poireau\",1,\"pièce\"],[\"Oignon\",1,\"pièce\"],[\"Laurier\",2,\"feuilles\"]],\"steps\":[\"Faire revenir les légumes.\",\"Ajouter lentilles, laurier et eau.\",\"Cuire 35 minutes.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-croque-monsieur-aux-epinards\",\"title\":\"Croque-monsieur aux épinards\",\"category\":\"Snack\",\"time\":20,\"servings\":4,\"ingredients\":[[\"pain de mie\",8,\"tranche\"],[\"épinards\",250,\"g\"],[\"fromage\",160,\"g\"],[\"moutarde\",2,\"c. à soupe\"],[\"beurre\",20,\"g\"]],\"steps\":[\"Faire tomber les épinards.\",\"Monter les croques avec moutarde et fromage.\",\"Dorer à la poêle ou au four.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"rapide\",\"modifié\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-bruschettas-tomates-et-mozzarella\",\"title\":\"Bruschettas tomates et mozzarella\",\"category\":\"Repas rapides\",\"time\":20,\"servings\":4,\"ingredients\":[[\"Pain de campagne\",8,\"tranches\"],[\"Tomates\",5,\"pièces\"],[\"Mozzarella\",250,\"g\"],[\"Basilic\",12,\"feuilles\"],[\"Ail\",1,\"gousse\"]],\"steps\":[\"Griller le pain et le frotter à l’ail.\",\"Ajouter tomates et mozzarella.\",\"Passer 5 minutes au four et parsemer de basilic.\"],\"avecViande\":false,\"temperature\":\"chaud\",\"tags\":[\"végétarien\",\"rapide\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-wraps-de-legumes-grilles\",\"title\":\"Wraps de légumes grillés\",\"category\":\"Repas rapides\",\"time\":30,\"servings\":4,\"ingredients\":[[\"Tortillas\",8,\"pièces\"],[\"Courgette\",1,\"pièce\"],[\"Poivron\",1,\"pièce\"],[\"Houmous\",250,\"g\"],[\"Salade\",150,\"g\"]],\"steps\":[\"Griller les légumes.\",\"Tartiner les tortillas de houmous.\",\"Ajouter légumes et salade puis rouler.\"],\"avecViande\":false,\"temperature\":\"les-deux\",\"tags\":[\"végétarien\"],\"source\":\"\",\"notes\":\"\",\"paprikaUid\":\"\"},{\"id\":\"terrain-pommes-de-terre-au-four-fromage-blanc-et-ciboulette\",\"title\":\"Pommes de terre au four, fromage blanc et ciboulette\",\"category\":\"Repas rapides\",\"time\":50,\"servings\":4,\"ingredients\":[[\"Pommes de terre\",4,